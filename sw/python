then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.14.7

# Built straight from Fluffy's branch (our commits on upstream's v3.14.7
# tag): swctl fetches the pinned commit with git.  The HTML
# documentation stays on the release's tarball.
