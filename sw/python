MAKE() {
    patch -Z -Np1 -i Python-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i Python-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/python \
        --enable-shared \
        --with-system-expat \
        --without-static-libpython
    make SHELL=/sw/bash/bin/bash
}

CHECK() {
    unset SOURCE_DATE_EPOCH
    make test TESTOPTS="--timeout 120 -x test_urllib2 -x test_urllibnet"
}

INSTALL() {
    make SHELL=/sw/bash/bin/bash install

    cat > $DESTDIR/sw/python/pip.conf << 'EOF'
[global]
root-user-action = ignore
disable-pip-version-check = true
EOF

    install -v -dm755 $DESTDIR/sw/python/share/doc/python-$VERSION/html
    if [ -d ../python-$VERSION-docs-html/python-$VERSION-docs-html ]; then
        cp -a ../python-$VERSION-docs-html/python-$VERSION-docs-html/* $DESTDIR/sw/python/share/doc/python-$VERSION/html/
    elif [ -d ../python-$VERSION-docs-html ]; then
        cp -a ../python-$VERSION-docs-html/* $DESTDIR/sw/python/share/doc/python-$VERSION/html/
    fi
}
