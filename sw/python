    7ce248af148e74dcab04dfc17ded24922ed2ddca https://github.com/fluffy-linux/cpython.git#refs/heads/fluffy/v$VERSION
    d484b784ec35c5776c5ff55f81fa984b5251a38b532b24bb00e43148bd73ffe9 https://github.com/fluffy-linux/cpython/releases/download/v$VERSION/python-$VERSION-docs-html.tar.bz2
