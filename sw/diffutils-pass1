ON=host-build

VERSION=3.12

ARCHIVES=(
    7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd https://ftpmirror.gnu.org/diffutils/diffutils-$VERSION.tar.xz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/diffutils \
        --host=$FLUFFY_TGT \
        gl_cv_func_strcasecmp_works=yes \
        --build=$(./build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
