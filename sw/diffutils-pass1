ON=host-build

VERSION=3.12

# Built straight from Fluffy's branch, as diffutils is: the host's autotools
# build the ones diffutils's release tarball was made with, and bootstrap
# runs the host's autopoint.
ARCHIVES=(
    ccbabc3eef9e170ac2176764dc7a12aa0e33a1ba https://github.com/fluffy-linux/diffutils.git#refs/heads/fluffy/v$VERSION
    18bfebd5367050afd0f2f5b8eb1c2acc93c26c3a https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    a88a8c2541f3fcb0137de63799a80e31e5435ae4 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/diffutils \
        --host=$FLUFFY_TGT \
        gl_cv_func_strcasecmp_works=yes \
        --build=$(./build-aux/config.guess)
    # The translations as make dist merges them.
    make -C po update-po
    make
}

INSTALL() {
    make install
}
