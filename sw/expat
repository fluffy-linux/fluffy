if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.8.3

HAS_LDFLAGS=-lexpat

ARCHIVES=(
    f6256df90c906773d344da084402b7d3e4f22ed41b1a59c989098a83d3ea0c85 https://github.com/fluffy-linux/libexpat/releases/download/R_${VERSION//./_}/expat-$VERSION.tar.xz
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/expat \
        --disable-static \
        --docdir=/sw/expat/share/doc/expat-$VERSION
    make
}

CHECK() {
    make LOG_DRIVER='$(SHELL) $(top_srcdir)/conftools/test-driver' check
}

INSTALL() {
    make install
    install -v -m644 doc/*.{html,css} $DESTDIR/sw/expat/share/doc/expat-$VERSION
}
