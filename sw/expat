if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.8.3

# Built straight from Fluffy's branch (our commits on upstream's R_2_8_3
# tag): swctl fetches the pinned commit with git.  The sources are in the
# repository's expat directory, so each phase starts there.  The tag has
# no configure or Makefile.in, so MAKE regenerates them with the
# autoconf, automake and libtool the release tarball was made with (2.72,
# 1.18.1, 2.5.4), from their Fluffy branches.  The tag has no
# doc/xmlwf.1 either, so this installs no xmlwf man page (the user's
# decision, 2026-11-23): making it needs the DocBook tools, which need
# expat, a cycle.
ARCHIVES=(
    58df5f0cbd1e640d39f0c95fb6fc448a2b681d02 https://github.com/fluffy-linux/libexpat.git#refs/heads/fluffy/R_${VERSION//./_}
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
    2b62947fd566e11dedf3c2c7e252f05a8937d54c https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.5.4
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        sed
        tar
        xz
    )
fi

# Regenerated with the autotools expat's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    cd expat
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/expat \
        --disable-static \
        --docdir=/sw/expat/share/doc/expat-$VERSION
    make
}

CHECK() {
    cd expat
    make LOG_DRIVER='$(SHELL) $(top_srcdir)/conftools/test-driver' check
}

INSTALL() {
    cd expat
    make install
    install -v -m644 doc/*.{html,css} $DESTDIR/sw/expat/share/doc/expat-$VERSION
}
