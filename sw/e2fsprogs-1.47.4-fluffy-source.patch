+static const char *
+profile_scan_bracket_end(const char *p)
+{
+	p++;
+	if (*p == '!' || *p == '^')
+		p++;
+	if (*p == ']')
+		p++;
+	while (*p != '\0' && *p != '/') {
+		if (*p == ']')
+			return p;
+		if (*p == '[' && (p[1] == ':' || p[1] == '.' || p[1] == '=')) {
+			char ctype = p[1];
+			const char *q = p + 2;
+			while (*q != '\0' && *q != '/' && (ctype == '.' || *q != ']')) {
+				if (*q == ctype && q[1] == ']') {
+					p = q + 2;
+					goto next_ch;
+				}
+				q++;
+			}
+		}
+		p++;
+	next_ch:;
+	}
+	return NULL;
+}
+
+static const char *
+profile_next_colon(const char *s)
+{
+	while (*s != '\0') {
+		if (*s == ':')
+			return s;
+		if (*s == '[') {
+			const char *end = profile_scan_bracket_end(s);
+			if (end != NULL) {
+				s = end + 1;
+				continue;
+			}
+		}
+		s++;
+	}
+	return NULL;
+}
