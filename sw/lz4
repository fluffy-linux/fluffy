if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.10.0

# Built straight from Fluffy's branch (our commits on upstream's v1.10.0
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    11d32745ed45f0ff4d48901b00356c7a3dc2a7dc https://github.com/fluffy-linux/lz4.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        sed
        tar
    )
fi

MAKE() {
    make BUILD_STATIC=no PREFIX=/sw/lz4
}

CHECK() {
    make -j1 check
}

INSTALL() {
    make BUILD_STATIC=no PREFIX=/sw/lz4 install
}
