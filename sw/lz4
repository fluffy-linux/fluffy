ON=cross-build

VERSION=1.10.0

HAS_LDFLAGS=-llz4

ARCHIVES=(
    537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b https://github.com/lz4/lz4/releases/download/v$VERSION/lz4-$VERSION.tar.gz
    31046072217f8f540b7a493d9bf1407865eeaa310399c913f71714d608ef143e file://lz4-$VERSION-fluffy-shell.patch
    65c03362297ef58fdec56cce67b39d99784775c90a22cf76abe5107cec325195 file://lz4-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    gcc-pass2
    glibc
    grep-pass1
    gzip-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
)

MAKE() {
    patch -Z -Np1 -i lz4-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i lz4-$VERSION-fluffy-test.patch
    make BUILD_STATIC=no PREFIX=/sw/lz4
}

CHECK() {
    make -j1 check
}

INSTALL() {
    make BUILD_STATIC=no PREFIX=/sw/lz4 install
}
