+static PyObject *
+_create_tuple_for_attribute(_sslmodulestate *state,
+                            ASN1_OBJECT *name, ASN1_STRING *value)
+{
+    Py_ssize_t buflen;
+    PyObject *pyattr;
+    PyObject *pyname = _asn1obj2py(state, name, 0);
+
+    if (pyname == NULL) {
+        _setSSLError(state, NULL, 0, __FILE__, __LINE__);
+        return NULL;
