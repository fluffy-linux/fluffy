if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=0.48.0

# Built straight from Fluffy's branch (upstream's 0.48.0 tag; Fluffy has no
# commits on it): swctl fetches the pinned commit with git.
ARCHIVES=(
    21c4da4c54c3b354cc22dc7f6f6374ffcd560e84 https://github.com/fluffy-linux/wheel.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    packaging
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils-pass1
        flit-core
        packaging
        python
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        packaging
        python
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/wheel wheel
}
