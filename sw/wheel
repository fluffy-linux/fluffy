if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=0.48.0

ARCHIVES=(
    94800765601e9171bf5d58d066e640662842bcedcbab982b2c90787a2c987322 https://pypi.org/packages/source/w/wheel/wheel-$VERSION.tar.gz
)

NEEDS=(
    packaging
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils-pass1
        flit-core
        packaging
        python
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        packaging
        python
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/wheel wheel
}
