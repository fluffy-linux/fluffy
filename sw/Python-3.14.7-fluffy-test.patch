+            finally:
+                locale.setlocale(locale.LC_CTYPE, saved_loc)
+
+            # Surrogateescape patterns ('\udcc3*') must never match valid UTF-8
+            # ('\xe9.txt'), and filenames mixing valid multi-byte UTF-8 with an
