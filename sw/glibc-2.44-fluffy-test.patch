+#ifndef SQUASHFS_MAGIC
+# define SQUASHFS_MAGIC 0x73717368
+#endif
+
+/* Host-independent live SquashFS prefix discovery via /proc/self/mountinfo
+   (with FSWC_TEST_PREFIX override, or synthetic fallback when zero SquashFS
+   mounts exist on the host, e.g. on an ephemeral CI runner).  */
+static const char *
+pick_prefix (char *fallback_dir, char *disc_buf, size_t disc_sz)
+{
+  const char *env_p = getenv ("FSWC_TEST_PREFIX");
+  if (env_p != NULL)
+    {
+      if (strcmp (env_p, "none") == 0)
+        return fallback_dir;
+      if (env_p[0] == '/')
+        return env_p;
+    }
+
+  FILE *fp = fopen ("/proc/self/mountinfo", "r");
+  if (fp == NULL)
+    return fallback_dir;
+
+  char best[512] = "";
+  size_t best_cnt = 0;
+  char line[2048];
+  while (fgets (line, sizeof (line), fp) != NULL)
+    {
+      const char *sep = strstr (line, " - ");
+      if (sep == NULL)
+        continue;
+      const char *fstype = sep + 3;
+      if (strncmp (fstype, "squashfs ", 9) != 0
+          && strncmp (fstype, "squashfs\t", 9) != 0)
+        continue;
+      const char *p = line;
+      for (int f = 0; f < 4 && p < sep; ++f)
+        {
+          while (p < sep && *p != ' ')
+            ++p;
+          while (p < sep && *p == ' ')
+            ++p;
+        }
+      const char *mp_end = p;
+      while (mp_end < sep && *mp_end != ' ')
+        ++mp_end;
+      size_t mp_len = (size_t) (mp_end - p);
+      if (mp_len < 3 || mp_len >= sizeof (best) || p[0] != '/'
+          || memchr (p, '\\', mp_len) != NULL)
+        continue;
+      const char *last_slash = NULL;
+      size_t slashes = 0;
+      for (size_t i = 0; i < mp_len; ++i)
+        if (p[i] == '/')
+          {
+            last_slash = p + i;
+            ++slashes;
+          }
+      if (last_slash == NULL || last_slash == p || slashes >= 15)
+        continue;
+      size_t par_len = (size_t) (last_slash - p);
+      char par[512];
+      memcpy (par, p, par_len);
+      par[par_len] = '\0';
+      if (strcmp (par, best) == 0)
+        continue;
+      DIR *d = opendir (par);
+      if (d == NULL)
+        continue;
+      size_t sq_cnt = 0;
+      struct dirent *de;
+      while ((de = readdir (d)) != NULL)
+        {
+          if (de->d_name[0] == '.')
+            continue;
+          char sub[768];
+          snprintf (sub, sizeof (sub), "%s/%s", par, de->d_name);
+          struct stat st;
+          struct statfs sfs;
+          if (lstat (sub, &st) == 0 && S_ISDIR (st.st_mode)
+              && statfs (sub, &sfs) == 0 && sfs.f_type == SQUASHFS_MAGIC)
+            ++sq_cnt;
+        }
+      closedir (d);
+      if (sq_cnt > best_cnt)
+        {
+          best_cnt = sq_cnt;
+          memcpy (best, par, par_len + 1);
+        }
+    }
+  fclose (fp);
+  if (best_cnt == 0)
+    return fallback_dir;
+  snprintf (disc_buf, disc_sz, "%s", best);
+  return disc_buf;
+}
