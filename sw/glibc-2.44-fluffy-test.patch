diff --no-dereference -Naur glibc-2.44/posix/tst-fswc-startup.c glibc-2.44.test/posix/tst-fswc-startup.c
--- glibc-2.44/posix/tst-fswc-startup.c	1970-01-01 00:00:00.000000000 +0000
+++ glibc-2.44.test/posix/tst-fswc-startup.c	2026-11-17 22:38:48.264998379 +0000
@@ -0,0 +1,362 @@
+/* FSWC's startup builder.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+/* __libc_early_init builds the index of each configured prefix (/sw)
+   when there is no valid one: in a dynamically linked program only, and
+   never under AT_SECURE.  This test runs in a user and mount namespace
+   of its own with a tmpfs mounted over /sw, so it needs /sw to exist,
+   and checks that
+
+   - a statically linked program starts without building;
+   - a dynamically linked program builds, publishing a regular file of
+     mode 0400 owned by its euid, in a directory of its own;
+   - an index left by a mount namespace that no longer exists is swept
+     away by the next build of a process with CAP_SYS_ADMIN, which is
+     the only one listmount tells apart a dead namespace from a live one
+     it may not see;
+   - an unprivileged build never sweeps the index of a live namespace
+     (to it, every other namespace looks dead), and sweeps one that only
+     may be dead once it is more than a day old;
+   - a change to /sw makes the next start rebuild (a new file is renamed
+     over the old one);
+   - with /dev/shm read-only, or too small for the index, a start builds
+     nothing, leaves no temporary file behind, and runs normally.
+
+   AT_SECURE cannot be tested without privileges (a set-user-ID program
+   owned by another user); the builder returns at once when
+   __libc_enable_secure is set.  */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glob.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <linux/securebits.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <support/check.h>
+#include <support/subprocess.h>
+#include <support/support.h>
+#include <support/xunistd.h>
+
+#define PREFIX "/sw"
+
+/* The indexes of PREFIX for this euid, in any mount namespace.  */
+static size_t
+indexes (glob_t *g)
+{
+  struct stat st;
+  xstat (PREFIX, &st);
+  char *pat = xasprintf ("/dev/shm/.fswc-%u-*/idx-*-%llu-%llu",
+                         (unsigned int) geteuid (),
+                         ((unsigned long long) major (st.st_dev) << 32)
+                         | minor (st.st_dev),
+                         (unsigned long long) st.st_ino);
+  int r = glob (pat, 0, NULL, g);
+  free (pat);
+  if (r == GLOB_NOMATCH)
+    {
+      g->gl_pathc = 0;
+      return 0;
+    }
+  TEST_COMPARE (r, 0);
+  return g->gl_pathc;
+}
+
+static size_t
+count_indexes (void)
+{
+  glob_t g;
+  size_t n = indexes (&g);
+  if (n > 0)
+    globfree (&g);
+  return n;
+}
+
+/* Print what this euid's FSWC directories hold, after STEP.  */
+static void
+show (const char *step)
+{
+  glob_t g;
+  char *pat = xasprintf ("/dev/shm/.fswc-%u-*/*", (unsigned int) geteuid ());
+  printf ("info: after %s:", step);
+  if (glob (pat, GLOB_PERIOD, NULL, &g) == 0)
+    {
+      for (size_t i = 0; i < g.gl_pathc; ++i)
+        printf (" %s", strrchr (g.gl_pathv[i], '/') + 1);
+      globfree (&g);
+    }
+  puts ("");
+  free (pat);
+}
+
+/* Run PATH with ARGV and wait for it to exit successfully.  */
+static void
+run (const char *path, char *const argv[])
+{
+  pid_t pid = xfork ();
+  if (pid == 0)
+    {
+      int null = xopen ("/dev/null", O_WRONLY, 0);
+      xdup2 (null, STDOUT_FILENO);
+      execv (path, argv);
+      _exit (127);
+    }
+  int status;
+  xwaitpid (pid, &status, 0);
+  TEST_VERIFY (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+}
+
+/* Start a fresh dynamically linked process (this test, as a probe that
+   only exits) through the loader invocation the harness used.  With
+   NEWNS, in a mount namespace of its own, which dies with it.  Without
+   PRIVILEGED, it runs with no capabilities: still uid 0, but with
+   SECBIT_NOROOT, so execve grants it none.  */
+static void
+start_dynamic (char *self, bool newns, bool privileged)
+{
+  pid_t pid = xfork ();
+  if (pid == 0)
+    {
+      if (newns && unshare (CLONE_NEWNS) != 0)
+        _exit (126);
+      if (!privileged
+          && prctl (PR_SET_SECUREBITS, SECBIT_NOROOT | SECBIT_NOROOT_LOCKED)
+             != 0)
+        _exit (125);
+      setenv ("FSWC_STARTUP_PROBE", "1", 1);
+      char *argv[] = { self, (char *) "--direct", NULL };
+      struct support_spawn_wrapped *w = support_spawn_wrap (self, argv,
+                                                            NULL, 0);
+      execve (w->path, w->argv, w->envp);
+      _exit (127);
+    }
+  int status;
+  xwaitpid (pid, &status, 0);
+  TEST_VERIFY (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+}
+
+/* Enter a user namespace as uid 0 (not, as support_become_root does, as
+   our own uid), so that the processes we start keep their capabilities
+   across execve, and a mount namespace with private propagation.  */
+static bool
+become_root (void)
+{
+  char map[64];
+  uid_t uid = getuid ();
+  gid_t gid = getgid ();
+  if (unshare (CLONE_NEWUSER | CLONE_NEWNS) != 0)
+    return false;
+  int fd = xopen ("/proc/self/uid_map", O_WRONLY, 0);
+  int len = snprintf (map, sizeof map, "0 %u 1\n", (unsigned int) uid);
+  xwrite (fd, map, len);
+  xclose (fd);
+  fd = xopen ("/proc/self/setgroups", O_WRONLY, 0);
+  xwrite (fd, "deny", 4);
+  xclose (fd);
+  fd = xopen ("/proc/self/gid_map", O_WRONLY, 0);
+  len = snprintf (map, sizeof map, "0 %u 1\n", (unsigned int) gid);
+  xwrite (fd, map, len);
+  xclose (fd);
+  return mount ("none", "/", NULL, MS_REC | MS_PRIVATE, NULL) == 0;
+}
+
+/* The index in G other than OURS.  */
+static char *
+other_index (const char *ours)
+{
+  glob_t g;
+  char *r = NULL;
+  indexes (&g);
+  for (size_t i = 0; i < g.gl_pathc; ++i)
+    if (strcmp (g.gl_pathv[i], ours) != 0)
+      r = xstrdup (g.gl_pathv[i]);
+  if (g.gl_pathc > 0)
+    globfree (&g);
+  TEST_VERIFY_EXIT (r != NULL);
+  return r;
+}
+
+/* Make PATH look two days old.  */
+static void
+age (const char *path)
+{
+  struct timespec ts[2];
+  TEST_COMPARE (clock_gettime (CLOCK_REALTIME, &ts[0]), 0);
+  ts[0].tv_sec -= 2 * 24 * 60 * 60;
+  ts[1] = ts[0];
+  TEST_COMPARE (utimensat (AT_FDCWD, path, ts, 0), 0);
+}
+
+/* Let a coarse-clock tick pass, so that the builder does not decline
+   because PREFIX changed in the current one.  */
+static void
+next_tick (void)
+{
+  struct timespec ts = { 0, 100 * 1000 * 1000 };
+  nanosleep (&ts, NULL);
+}
+
+static int
+do_test (int argc, char *argv[])
+{
+  if (getenv ("FSWC_STARTUP_PROBE") != NULL)
+    return 0;                   /* Startup has done the work.  */
+
+  struct stat st;
+  if (stat (PREFIX, &st) != 0 || !S_ISDIR (st.st_mode))
+    FAIL_UNSUPPORTED ("no " PREFIX " directory to mount over");
+  if (!become_root ())
+    FAIL_UNSUPPORTED ("cannot enter a user and mount namespace");
+  if (mount ("tmpfs", PREFIX, "tmpfs", 0, "mode=0755") != 0)
+    FAIL_UNSUPPORTED ("cannot mount over " PREFIX ": %m");
+  xmkdirp (PREFIX "/pkg/bin", 0755);
+  xclose (xopen (PREFIX "/pkg/bin/cmd", O_WRONLY | O_CREAT, 0755));
+  xclose (xopen (PREFIX "/pkg-1.0.squashfs", O_WRONLY | O_CREAT, 0644));
+  next_tick ();
+
+  /* This process started before the mount, so there is nothing yet.  */
+  TEST_COMPARE (count_indexes (), 0);
+
+  /* A static program never builds.  */
+  char *helper = xasprintf ("%s/posix/tst-fswc-oracle-exec",
+                            support_objdir_root);
+  char *hargv[] = { helper, NULL };
+  run (helper, hargv);
+  TEST_COMPARE (count_indexes (), 0);
+
+  /* A dynamic one does.  */
+  start_dynamic (argv[0], false, true);
+  show ("a dynamic start");
+  glob_t g;
+  TEST_COMPARE (indexes (&g), 1);
+  char *ours = xstrdup (g.gl_pathv[0]);
+  globfree (&g);
+  struct stat ist;
+  TEST_COMPARE (lstat (ours, &ist), 0);
+  TEST_VERIFY (S_ISREG (ist.st_mode));
+  TEST_COMPARE (ist.st_mode & 07777, 0400);
+  TEST_COMPARE (ist.st_uid, geteuid ());
+  char *dir = xstrdup (ours);
+  *strrchr (dir, '/') = '\0';
+  struct stat dst;
+  xstat (dir, &dst);
+  TEST_COMPARE (dst.st_uid, geteuid ());
+  TEST_COMPARE (dst.st_mode & 0077, 0);
+  free (dir);
+
+  /* A second start finds the index valid and leaves it alone.  */
+  start_dynamic (argv[0], false, true);
+  struct stat again;
+  TEST_COMPARE (lstat (ours, &again), 0);
+  TEST_COMPARE (again.st_ino, ist.st_ino);
+
+  /* A start in a mount namespace of its own builds that namespace's
+     index and keeps ours, whose namespace is alive.  Once that namespace
+     is gone, the next privileged build sweeps its index.  */
+  start_dynamic (argv[0], true, true);
+  show ("a privileged start in a new mount namespace");
+  TEST_COMPARE (count_indexes (), 2);
+  TEST_COMPARE (unlink (ours), 0);
+  start_dynamic (argv[0], false, true);
+  show ("removing ours and a privileged start");
+  TEST_COMPARE (indexes (&g), 1);
+  TEST_COMPARE_STRING (g.gl_pathv[0], ours);
+  globfree (&g);
+
+  /* An unprivileged build in a namespace of its own cannot see ours, but
+     must not take it for dead.  */
+  start_dynamic (argv[0], true, false);
+  show ("an unprivileged start in a new mount namespace");
+  TEST_COMPARE (count_indexes (), 2);
+  char *dead = other_index (ours);
+
+  /* That namespace is gone now, but an unprivileged build cannot tell, so
+     its index stays while it is young...  */
+  TEST_COMPARE (unlink (ours), 0);
+  start_dynamic (argv[0], false, false);
+  show ("removing ours and an unprivileged start");
+  TEST_COMPARE (count_indexes (), 2);
+  TEST_VERIFY (access (dead, F_OK) == 0);
+
+  /* ... and goes once it is more than a day old.  */
+  age (dead);
+  TEST_COMPARE (unlink (ours), 0);
+  start_dynamic (argv[0], false, false);
+  show ("aging it, removing ours and an unprivileged start");
+  TEST_COMPARE (indexes (&g), 1);
+  TEST_COMPARE_STRING (g.gl_pathv[0], ours);
+  globfree (&g);
+  free (dead);
+
+  /* A change to the prefix makes the next start rebuild.  */
+  TEST_COMPARE (lstat (ours, &ist), 0);
+  xmkdir (PREFIX "/newpkg", 0755);
+  next_tick ();
+  start_dynamic (argv[0], false, true);
+  TEST_COMPARE (lstat (ours, &again), 0);
+  TEST_VERIFY (again.st_ino != ist.st_ino);
+
+  /* /dev/shm read-only, then too small: no index, nothing left over.
+     A thousand more names make the index larger than the small one.  */
+  TEST_COMPARE (unlink (ours), 0);
+  for (int i = 0; i < 1000; ++i)
+    {
+      char *f = xasprintf (PREFIX "/fill-%04d", i);
+      xclose (xopen (f, O_WRONLY | O_CREAT, 0644));
+      free (f);
+    }
+  next_tick ();
+  if (mount ("tmpfs", "/dev/shm", "tmpfs", MS_RDONLY, "mode=1777") != 0)
+    FAIL_EXIT1 ("mount read-only tmpfs on /dev/shm: %m");
+  start_dynamic (argv[0], false, true);
+  TEST_COMPARE (count_indexes (), 0);
+  TEST_COMPARE (umount2 ("/dev/shm", MNT_DETACH), 0);
+  if (mount ("tmpfs", "/dev/shm", "tmpfs", 0, "mode=1777,size=8k") != 0)
+    FAIL_EXIT1 ("mount small tmpfs on /dev/shm: %m");
+  start_dynamic (argv[0], false, true);
+  show ("a start with a full /dev/shm");
+  TEST_COMPARE (count_indexes (), 0);
+  glob_t left;
+  char *pat = xasprintf ("/dev/shm/.fswc-%u-*/.tmp-*",
+                         (unsigned int) geteuid ());
+  TEST_COMPARE (glob (pat, GLOB_PERIOD, NULL, &left), GLOB_NOMATCH);
+  free (pat);
+  TEST_COMPARE (umount2 ("/dev/shm", MNT_DETACH), 0);
+
+  /* With room again, the index is built, and it is bigger than the small
+     /dev/shm was, so that case really ran out of space.  */
+  start_dynamic (argv[0], false, true);
+  TEST_COMPARE (lstat (ours, &ist), 0);
+  TEST_VERIFY (ist.st_size > 8192);
+
+  free (ours);
+  free (helper);
+  return 0;
+}
+
+#define TEST_FUNCTION_ARGV do_test
+#include <support/test-driver.c>
diff --no-dereference -Naur glibc-2.44/posix/tst-fswc-real.c glibc-2.44.test/posix/tst-fswc-real.c
--- glibc-2.44/posix/tst-fswc-real.c	1970-01-01 00:00:00.000000000 +0000
+++ glibc-2.44.test/posix/tst-fswc-real.c	2026-11-17 22:34:14.306814038 +0000
@@ -0,0 +1,345 @@
+/* FSWC on the real package prefix.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+/* What no synthetic prefix can show, checked where /sw holds SquashFS
+   package mounts (a Fluffy system, or swctl's build sandbox), and
+   UNSUPPORTED elsewhere:
+
+   - a fresh dynamically linked process leaves an index for /sw;
+   - the index lists every entry of /sw, and seals exactly the packages
+     the rules allow (the root of a SquashFS mount, nothing mounted
+     beneath, every directory world-readable, no POSIX ACL), worked out
+     here independently of the builder;
+   - at least one package is sealed, so lookups do use the index (a
+     correct but always-unsealed index would pass every other test while
+     costing the plain walk);
+   - searches over the real /sw, with its image files beside the
+     packages, give the plain walk's answers: a missing command fails
+     with ENOENT in execvp and posix_spawnp, a missing library with "No
+     such file or directory", and glob matches the reference walk.  */
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <ftw.h>
+#include <glob.h>
+#include <spawn.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/sysmacros.h>
+#include <sys/wait.h>
+#include <sys/xattr.h>
+#include <time.h>
+#include <unistd.h>
+
+/* The index format; its declarations of internal functions need this.  */
+#ifndef attribute_hidden
+# define attribute_hidden
+#endif
+#include <fswc-index.h>
+#include <support/check.h>
+#include <support/subprocess.h>
+#include <support/support.h>
+#include <support/xunistd.h>
+
+#define PREFIX "/sw"
+#ifndef SQUASHFS_MAGIC
+# define SQUASHFS_MAGIC 0x73717368
+#endif
+#ifndef STATX_ATTR_MOUNT_ROOT
+# define STATX_ATTR_MOUNT_ROOT 0x2000
+#endif
+#ifndef NS_GET_MNTNS_ID
+# define NS_GET_MNTNS_ID _IOR (0xb7, 0x5, uint64_t)
+#endif
+
+/* Is every directory beneath the current nftw walk world-listable and
+   searchable, and free of POSIX ACLs?  */
+static bool tree_ok;
+
+static int
+check_dir (const char *path, const struct stat *st, int type,
+           struct FTW *ftw)
+{
+  if (type == FTW_D || type == FTW_DNR)
+    {
+      if ((st->st_mode & 0005) != 0005 || type == FTW_DNR)
+        tree_ok = false;
+      else if (lgetxattr (path, "system.posix_acl_access", NULL, 0) >= 0)
+        tree_ok = false;
+    }
+  return tree_ok ? 0 : 1;
+}
+
+/* Is anything mounted beneath /sw/NAME?  */
+static bool
+mounted_beneath (const char *name)
+{
+  FILE *fp = fopen ("/proc/self/mountinfo", "re");
+  TEST_VERIFY_EXIT (fp != NULL);
+  char *below = xasprintf (PREFIX "/%s/", name);
+  size_t below_len = strlen (below);
+  char line[4096];
+  bool found = false;
+  while (!found && fgets (line, sizeof line, fp) != NULL)
+    {
+      char mp[4096];
+      if (sscanf (line, "%*u %*u %*s %*s %4095s", mp) == 1
+          && strncmp (mp, below, below_len) == 0)
+        found = true;
+    }
+  fclose (fp);
+  free (below);
+  return found;
+}
+
+/* Would the builder seal /sw/NAME?  Also counts the SquashFS mount roots
+   in *SQUASH.  */
+static bool
+should_seal (const char *name, int *squash)
+{
+  char *path = xasprintf (PREFIX "/%s", name);
+  struct statx stx;
+  bool seal = false;
+  if (statx (AT_FDCWD, path, AT_SYMLINK_NOFOLLOW, STATX_TYPE, &stx) == 0
+      && S_ISDIR (stx.stx_mode)
+      && (stx.stx_attributes & STATX_ATTR_MOUNT_ROOT))
+    {
+      struct statfs sfs;
+      if (statfs (path, &sfs) == 0 && sfs.f_type == SQUASHFS_MAGIC)
+        {
+          ++*squash;
+          tree_ok = true;
+          seal = !mounted_beneath (name)
+                 && nftw (path, check_dir, 16, FTW_PHYS) == 0 && tree_ok;
+        }
+    }
+  free (path);
+  return seal;
+}
+
+/* This process's index of /sw, or NULL.  */
+static char *
+find_index (void)
+{
+  struct stat st;
+  xstat (PREFIX, &st);
+  uint64_t mntns = 0;
+  int ns = open ("/proc/self/ns/mnt", O_RDONLY | O_CLOEXEC);
+  bool have_ns = ns >= 0 && ioctl (ns, NS_GET_MNTNS_ID, &mntns) == 0;
+  if (ns >= 0)
+    xclose (ns);
+  char *pat = xasprintf ("/dev/shm/.fswc-%u-*/idx-%s-%llu-%llu",
+                         (unsigned int) geteuid (), "*",
+                         ((unsigned long long) major (st.st_dev) << 32)
+                         | minor (st.st_dev),
+                         (unsigned long long) st.st_ino);
+  glob_t g;
+  char *found = NULL;
+  if (glob (pat, 0, NULL, &g) == 0)
+    {
+      char *want = xasprintf ("/idx-%llu-", (unsigned long long) mntns);
+      for (size_t i = 0; found == NULL && i < g.gl_pathc; ++i)
+        if (have_ns ? strstr (g.gl_pathv[i], want) != NULL
+                    : g.gl_pathc == 1)
+          found = xstrdup (g.gl_pathv[i]);
+      free (want);
+      globfree (&g);
+    }
+  free (pat);
+  return found;
+}
+
+/* Start a fresh dynamically linked process, whose startup builds the
+   index when there is none.  */
+static void
+start_dynamic (char *self)
+{
+  pid_t pid = xfork ();
+  if (pid == 0)
+    {
+      setenv ("FSWC_REAL_PROBE", "1", 1);
+      char *argv[] = { self, (char *) "--direct", NULL };
+      struct support_spawn_wrapped *w = support_spawn_wrap (self, argv,
+                                                            NULL, 0);
+      execve (w->path, w->argv, w->envp);
+      _exit (127);
+    }
+  int status;
+  xwaitpid (pid, &status, 0);
+  TEST_VERIFY (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+}
+
+/* glob with caller hooks bypasses FSWC: the reference walk.  */
+static void
+check_glob (const char *pattern)
+{
+  glob_t got, want;
+  memset (&want, 0, sizeof want);
+  want.gl_opendir = (void *(*) (const char *)) opendir;
+  want.gl_readdir = (struct dirent *(*) (void *)) readdir;
+  want.gl_closedir = (void (*) (void *)) closedir;
+  want.gl_stat = stat;
+  want.gl_lstat = lstat;
+  int rg = glob (pattern, 0, NULL, &got);
+  int rw = glob (pattern, GLOB_ALTDIRFUNC, NULL, &want);
+  TEST_COMPARE (rg, rw);
+  if (rg == 0 && rw == 0)
+    {
+      TEST_COMPARE (got.gl_pathc, want.gl_pathc);
+      for (size_t i = 0; i < got.gl_pathc && i < want.gl_pathc; ++i)
+        TEST_COMPARE_STRING (got.gl_pathv[i], want.gl_pathv[i]);
+    }
+  if (rg == 0)
+    globfree (&got);
+  if (rw == 0)
+    globfree (&want);
+}
+
+static int
+do_test (int argc, char *argv[])
+{
+  if (getenv ("FSWC_REAL_PROBE") != NULL)
+    return 0;
+
+  DIR *d = opendir (PREFIX);
+  if (d == NULL)
+    FAIL_UNSUPPORTED ("no " PREFIX);
+  char **names = NULL;
+  bool *seal = NULL;
+  size_t n = 0;
+  int squash = 0;
+  for (struct dirent *e; (e = readdir (d)) != NULL; )
+    {
+      if (e->d_name[0] == '.')
+        continue;
+      names = xrealloc (names, (n + 1) * sizeof *names);
+      seal = xrealloc (seal, (n + 1) * sizeof *seal);
+      names[n] = xstrdup (e->d_name);
+      seal[n] = should_seal (e->d_name, &squash);
+      ++n;
+    }
+  closedir (d);
+  if (squash == 0)
+    FAIL_UNSUPPORTED ("no SquashFS package mounts in " PREFIX);
+  if (access ("/dev/shm", W_OK | X_OK) != 0)
+    FAIL_UNSUPPORTED ("/dev/shm is not writable, so FSWC cannot work here");
+  printf ("info: %zu entries in " PREFIX ", %d SquashFS mounts\n", n, squash);
+
+  /* A build declines while /sw changed within the current coarse-clock
+     tick, so retry for a while.  */
+  char *idx = NULL;
+  for (int i = 0; i < 50 && (idx = find_index ()) == NULL; ++i)
+    {
+      start_dynamic (argv[0]);
+      struct timespec ts = { 0, 20 * 1000 * 1000 };
+      nanosleep (&ts, NULL);
+    }
+  if (idx == NULL)
+    FAIL_EXIT1 ("no FSWC index for " PREFIX " after 50 fresh processes: "
+                "every lookup takes the plain walk");
+  printf ("info: index %s\n", idx);
+
+  int fd = xopen (idx, O_RDONLY, 0);
+  struct stat ist;
+  xfstat (fd, &ist);
+  TEST_COMPARE (ist.st_mode & 07777, 0400);
+  TEST_COMPARE (ist.st_uid, geteuid ());
+  const char *map = xmmap (NULL, ist.st_size, PROT_READ, MAP_PRIVATE, fd);
+  xclose (fd);
+  const struct fswc_idx_header *h = (const void *) map;
+  TEST_VERIFY_EXIT ((size_t) ist.st_size >= sizeof *h);
+  TEST_VERIFY_EXIT (h->top_off + (uint64_t) h->num_top
+                    * sizeof (struct fswc_top) <= (uint64_t) ist.st_size);
+  const struct fswc_top *tops = (const void *) (map + h->top_off);
+  const char *strtab = map + h->strtab_off;
+
+  int sealed = 0;
+  for (size_t i = 0; i < n; ++i)
+    {
+      const struct fswc_top *t = NULL;
+      for (uint32_t j = 0; t == NULL && j < h->num_top; ++j)
+        if (tops[j].name_len == strlen (names[i])
+            && memcmp (strtab + tops[j].name_off, names[i],
+                       tops[j].name_len) == 0)
+          t = &tops[j];
+      if (t == NULL)
+        {
+          support_record_failure ();
+          printf ("error: " PREFIX "/%s is missing from the index\n",
+                  names[i]);
+          continue;
+        }
+      sealed += t->sealed != 0;
+      if ((t->sealed != 0) != seal[i])
+        {
+          support_record_failure ();
+          printf ("error: " PREFIX "/%s: sealed %d, should be %d\n",
+                  names[i], t->sealed, seal[i]);
+        }
+    }
+  printf ("info: %d packages sealed\n", sealed);
+  TEST_VERIFY (sealed > 0);
+  xmunmap ((void *) map, ist.st_size);
+
+  /* The plain walk's answers over the real prefix.  */
+  TEST_COMPARE (setenv ("PATH", PREFIX "/*/bin", 1), 0);
+  char *cargv[] = { (char *) "fswc-real-no-such-command", NULL };
+  pid_t pid;
+  errno = EXDEV;
+  TEST_COMPARE (posix_spawnp (&pid, cargv[0], NULL, NULL, cargv, environ),
+                ENOENT);
+  pid = xfork ();
+  if (pid == 0)
+    {
+      errno = EXDEV;
+      execvp (cargv[0], cargv);
+      _exit (errno == ENOENT ? 0 : 1);
+    }
+  int status;
+  xwaitpid (pid, &status, 0);
+  TEST_VERIFY (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+  TEST_VERIFY (dlopen ("libfswc-real-no-such-library.so", RTLD_NOW) == NULL);
+  const char *err = dlerror ();
+  TEST_VERIFY (err != NULL
+               && strstr (err, "No such file or directory") != NULL);
+  if (err != NULL)
+    printf ("info: dlopen: %s\n", err);
+  check_glob (PREFIX "/*/bin/sh");
+  check_glob (PREFIX "/*/lib/libc.so*");
+  check_glob (PREFIX "/*/bin/fswc-real-no-such-command");
+  check_glob (PREFIX "/*");
+
+  for (size_t i = 0; i < n; ++i)
+    free (names[i]);
+  free (names);
+  free (seal);
+  free (idx);
+  return 0;
+}
+
+#define TEST_FUNCTION_ARGV do_test
+#include <support/test-driver.c>
