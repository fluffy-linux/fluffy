+/* 16-thread post-RELRO prefix stampede + pthread_cancel open() point test.
+   Copyright (C) 2026 Free Software Foundation, Inc.  */
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <ftw.h>
+#include <glob.h>
+#include <pthread.h>
+#include <stdbool.h>
