+static void
+run_glob_probe (FILE *out, const char *pat, int flags)
+{
+  /* Run twice per process (cold + warm).  */
+  glob_t g1, g2;
+  memset (&g1, 0, sizeof (g1));
+  memset (&g2, 0, sizeof (g2));
+  int r1 = glob (pat, flags, NULL, &g1);
+  int r2 = glob (pat, flags, NULL, &g2);
+  TEST_COMPARE (r1, r2);
+  fprintf (out, "GLOB|%s|0x%x|ret=%d|fl=0x%x|cnt=%zu\n", pat, flags, r1,
+           r1 == 0 ? g1.gl_flags : 0, r1 == 0 ? g1.gl_pathc : 0);
+  if (r1 == 0)
+    {
+      TEST_COMPARE (g1.gl_flags, g2.gl_flags);
+      TEST_COMPARE (g1.gl_pathc, g2.gl_pathc);
+      for (size_t i = 0; i < g1.gl_pathc; ++i)
+        {
+          TEST_COMPARE_STRING (g1.gl_pathv[i], g2.gl_pathv[i]);
+          fprintf (out, "  [%zu]=%s\n", i, g1.gl_pathv[i]);
+        }
+      globfree (&g1);
+      globfree (&g2);
+    }
+}
+
+static void
+run_vfs_probe (FILE *out, const char *path)
+{
+  for (int pass = 0; pass < 2; ++pass)
+    {
+      errno = 0;
+      int fd = openat (AT_FDCWD, path, O_RDONLY | O_CLOEXEC);
+      int open_err = fd < 0 ? errno : 0;
+      if (fd >= 0)
+        xclose (fd);
+
+      errno = 0;
+      int dfd = openat (AT_FDCWD, path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+      int dopen_err = dfd < 0 ? errno : 0;
+      if (dfd >= 0)
+        xclose (dfd);
+
+      struct stat st;
+      errno = 0;
+      int sr = stat (path, &st);
+      int st_err = sr < 0 ? errno : 0;
+
+      struct stat lst;
+      errno = 0;
+      int lsr = lstat (path, &lst);
+      int lst_err = lsr < 0 ? errno : 0;
+
+      struct statx stx;
+      memset (&stx, 0, sizeof (stx));
+      errno = 0;
+      int xr = statx (AT_FDCWD, path, AT_NO_AUTOMOUNT, STATX_BASIC_STATS, &stx);
+      int x_err = xr < 0 ? errno : 0;
+
+      errno = 0;
+      int ar = access (path, F_OK);
+      int a_err = ar < 0 ? errno : 0;
+
+      errno = 0;
+      int far = faccessat (AT_FDCWD, path, R_OK, AT_EACCESS);
+      int fa_err = far < 0 ? errno : 0;
+
+      if (pass == 1)
+        fprintf (out,
+                 "VFS|%s|open=%d/%d|dopen=%d/%d|stat=%d/%d:%lu:0%o|lstat=%d/%d:0%o|statx=%d/%d:%llu|acc=%d/%d|facc=%d/%d\n",
+                 path,
+                 fd >= 0 ? 0 : -1, open_err,
+                 dfd >= 0 ? 0 : -1, dopen_err,
+                 sr, st_err, sr == 0 ? (unsigned long) st.st_ino : 0UL,
+                 sr == 0 ? (unsigned) st.st_mode : 0U,
+                 lsr, lst_err, lsr == 0 ? (unsigned) lst.st_mode : 0U,
+                 xr, x_err, xr == 0 ? (unsigned long long) stx.stx_ino : 0ULL,
+                 ar, a_err, far, fa_err);
+    }
+}
+
+static int
+worker_main (const char *prefix, const char *out_path)
+{
+  FILE *out = fopen (out_path, "wb");
+  TEST_VERIFY_EXIT (out != NULL);
+
+  static const struct { const char *suf; int flags; } gpats[] =
+    {
+      { "/*", 0 },
+      { "/*", GLOB_ONLYDIR },
+      { "/*", GLOB_MARK },
+      { "/*", GLOB_ONLYDIR | GLOB_MARK },
+      { "/*", GLOB_PERIOD | GLOB_SKIPDOTS },
+      { "/*/bin", 0 },
+      { "/*/bin", GLOB_ONLYDIR | GLOB_MARK },
+      { "/*/usr/bin", GLOB_ONLYDIR },
+      { "/*/lib", GLOB_ONLYDIR },
+      { "/*/bin/bash", 0 },
+      { "/*/usr/bin/bash", 0 },
+      { "/*/bin/nonexistent_fswc_oracle", 0 },
+      { "/*/bin/nonexistent_fswc_oracle", GLOB_NOCHECK },
+      { "/*/bin/nonexistent_fswc_oracle", GLOB_NOMAGIC },
+      { "/*/lib/libc.so*", 0 },
+      { "/*/usr/lib/*", GLOB_ONLYDIR },
+      { "/*/@(bin|lib)", GLOB_EXTMATCH | GLOB_ONLYDIR },
+      { "/*/BIN", GLOB_CASEFOLD | GLOB_ONLYDIR },
+      { "/*/BIN/BASH", GLOB_CASEFOLD },
+      { "/NONEXISTENT_FSWC_LIT", GLOB_NOMAGIC | GLOB_CASEFOLD },
+      { "/*/bin/*", GLOB_PERIOD },
+      { "/*/bin/*", GLOB_PERIOD | GLOB_SKIPDOTS },
+      { "/*/bin/**", GLOB_GLOBSTAR },
+      { "/*/usr/bin/**", GLOB_GLOBSTAR },
+      { "/*/include/ncursesw/**/*.h", GLOB_GLOBSTAR },
+      { "/*/*/bash", 0 },
+    };
+
+  char pat[1024];
+  for (size_t i = 0; i < sizeof (gpats) / sizeof (gpats[0]); ++i)
+    {
+      snprintf (pat, sizeof (pat), "%s%s", prefix, gpats[i].suf);
+      run_glob_probe (out, pat, gpats[i].flags);
+    }
+
+  snprintf (pat, sizeof (pat), ":%s/*/bin:%s/*/usr/bin:", prefix, prefix);
+  run_glob_probe (out, pat, GLOB_PATHS | GLOB_NOESCAPE | GLOB_ONLYDIR);
+
+  /* Probe exact paths harvested from prefix children plus negative paths.  */
+  glob_t gl;
+  snprintf (pat, sizeof (pat), "%s/*", prefix);
+  if (glob (pat, 0, NULL, &gl) == 0)
+    {
+      size_t limit = gl.gl_pathc < 6 ? gl.gl_pathc : 6;
+      for (size_t i = 0; i < limit; ++i)
+        {
+          const char *pkg_dir = gl.gl_pathv[i];
+          run_vfs_probe (out, pkg_dir);
+
+          static const char *const subs[] =
+            {
+              "bin",
+              "bin/bash",
+              "bin/bash/",
+              "bin/bash/not_a_dir",
+              "bin/nonexistent_fswc_xyz",
+              "usr/bin/bash",
+              "usr/bin/bash/not_a_dir",
+              "usr/bin/nonexistent_fswc_xyz",
+              "lib/libc.so.6",
+              "lib/../bin/bash",
+              "usr/lib/../bin/bash",
+              "nonexistent_dir/nonexistent_leaf",
+            };
+          for (size_t j = 0; j < sizeof (subs) / sizeof (subs[0]); ++j)
+            {
+              char pbuf[1024];
+              snprintf (pbuf, sizeof (pbuf), "%s/%s", pkg_dir, subs[j]);
+              run_vfs_probe (out, pbuf);
+            }
+        }
+      globfree (&gl);
+    }
+
+  /* execvpe negative lookup with wildcard PATH.  */
+  char wpath_val[1000];
+  snprintf (wpath_val, sizeof (wpath_val), "%s/*/bin:%s/*/usr/bin",
+            prefix, prefix);
+  TEST_COMPARE (setenv ("PATH", wpath_val, 1), 0);
+  char wpath[1024];
+  snprintf (wpath, sizeof (wpath), "PATH=%s", wpath_val);
+  char *const envp[] = { wpath, NULL };
+  char *const argv_miss[] = { (char *) "nonexistent_fswc_exec_target", NULL };
+  errno = 0;
+  int er = execvpe (argv_miss[0], argv_miss, envp);
+  fprintf (out, "EXECVPE_MISS|ret=%d|err=%d\n", er, errno);
+
+  /* dlopen negative lookup.  */
+  void *dlh = dlopen ("libnonexistent_fswc_oracle.so.99", RTLD_LAZY);
+  fprintf (out, "DLOPEN_MISS|null=%d\n", dlh == NULL ? 1 : 0);
+  if (dlh != NULL)
+    dlclose (dlh);
+
+  TEST_COMPARE (fclose (out), 0);
+  return 0;
+}
+
+static int
+rm_child_cb (const char *fpath, const struct stat *sb, int tflag,
+             struct FTW *ftwbuf)
+{
+  (void) sb;
+  (void) tflag;
+  if (ftwbuf->level > 0)
+    remove (fpath);
+  return 0;
+}
+
+static char *
+slurp_file (const char *path, size_t *out_len)
+{
+  FILE *fp = fopen (path, "rb");
+  TEST_VERIFY_EXIT (fp != NULL);
+  TEST_COMPARE (fseek (fp, 0, SEEK_END), 0);
+  long sz = ftell (fp);
+  TEST_VERIFY_EXIT (sz >= 0);
+  rewind (fp);
+  char *buf = xmalloc ((size_t) sz + 1);
+  if (sz > 0)
+    TEST_COMPARE (fread (buf, 1, (size_t) sz, fp), (size_t) sz);
+  buf[sz] = '\0';
+  TEST_COMPARE (fclose (fp), 0);
+  *out_len = (size_t) sz;
+  return buf;
+}
+
+static void
+exec_self_direct (char *argv[])
+{
+  char *const child_argv[] = { argv[0], (char *) "--direct", NULL };
+  struct support_spawn_wrapped *w
+    = support_spawn_wrap (argv[0], child_argv, NULL, 0);
+  const char *extra_llp = getenv ("LD_LIBRARY_PATH");
+  if (extra_llp != NULL && extra_llp[0] != '\0')
+    {
+      for (size_t i = 0; w->argv[i] != NULL; ++i)
+        {
+          if (strcmp (w->argv[i], "--library-path") == 0
+              && w->argv[i + 1] != NULL)
+            {
+              ((char **) w->argv)[i + 1]
+                = xasprintf ("%s:%s", w->argv[i + 1], extra_llp);
+              break;
+            }
+        }
+    }
+  execve (w->path, w->argv, w->envp);
+  _exit (127);
+}
+
+static int
+do_test (int argc, char *argv[])
+{
+  (void) argc;
+  const char *w_pfx = getenv ("FSWC_ORACLE_PREFIX");
+  const char *w_out = getenv ("FSWC_ORACLE_OUT");
+  if (w_pfx != NULL && w_out != NULL)
+    return worker_main (w_pfx, w_out);
+
+  char *tmp = support_create_temp_directory ("tst-fswc-oracle-");
+  char *fb = xasprintf ("%s/fallback_sw", tmp);
+  char *fb_pkg = xasprintf ("%s/pkgA/bin", fb);
+  char *fb_lib = xasprintf ("%s/pkgA/lib", fb);
+  char *fb_inc = xasprintf ("%s/pkgA/include", fb);
+  char *fb_ub = xasprintf ("%s/pkgB/usr/bin", fb);
+  char *fb_ul = xasprintf ("%s/pkgB/usr/lib/sub", fb);
+  char *fb_hid = xasprintf ("%s/.hidden_pkg/bin", fb);
+  xmkdirp (fb_pkg, 0755);
+  xmkdirp (fb_lib, 0755);
+  xmkdirp (fb_inc, 0755);
+  xmkdirp (fb_ub, 0755);
+  xmkdirp (fb_ul, 0755);
+  xmkdirp (fb_hid, 0755);
+
+  char *fb_sh = xasprintf ("%s/bash", fb_pkg);
+  xclose (xopen (fb_sh, O_WRONLY | O_CREAT | O_TRUNC, 0755));
+  char *fb_dot = xasprintf ("%s/.dotbin", fb_pkg);
+  xclose (xopen (fb_dot, O_WRONLY | O_CREAT | O_TRUNC, 0644));
+  char *fb_so = xasprintf ("%s/libc.so.6", fb_lib);
+  xclose (xopen (fb_so, O_WRONLY | O_CREAT | O_TRUNC, 0644));
+  char *fb_hdr = xasprintf ("%s/curses.h", fb_inc);
+  xclose (xopen (fb_hdr, O_WRONLY | O_CREAT | O_TRUNC, 0644));
+  char *fb_ncw = xasprintf ("%s/ncursesw", fb_inc);
+  xsymlink (".", fb_ncw);
+  char *fb_ubsh = xasprintf ("%s/bash", fb_ub);
+  xclose (xopen (fb_ubsh, O_WRONLY | O_CREAT | O_TRUNC, 0755));
+  char *fb_hsh = xasprintf ("%s/bash", fb_hid);
+  xclose (xopen (fb_hsh, O_WRONLY | O_CREAT | O_TRUNC, 0755));
+
+  char disc_buf[512] = "";
+  const char *prefix = pick_prefix (fb, disc_buf, sizeof (disc_buf));
+  printf ("info: running FSWC differential oracle against prefix: %s\n", prefix);
+
+  char *outs[2];
+  for (int mode = 0; mode <= 1; ++mode)
+    {
+      outs[mode] = xasprintf ("%s/out_mode_%d.txt", tmp, mode);
+      pid_t pid = xfork ();
+      if (pid == 0)
+        {
+          char tun[64];
+          snprintf (tun, sizeof (tun), "glibc.fswc.mode=%d", mode);
+          setenv ("GLIBC_TUNABLES", tun, 1);
+          setenv ("FSWC_ORACLE_PREFIX", prefix, 1);
+          setenv ("FSWC_ORACLE_OUT", outs[mode], 1);
+          exec_self_direct (argv);
+        }
+      int status = 0;
+      xwaitpid (pid, &status, 0);
+      TEST_VERIFY_EXIT (WIFEXITED (status) && WEXITSTATUS (status) == 0);
+    }
+
+  size_t len0 = 0, len1 = 0;
+  char *b0 = slurp_file (outs[0], &len0);
+  char *b1 = slurp_file (outs[1], &len1);
+
+  if (len0 != len1 || memcmp (b0, b1, len0) != 0)
+    FAIL_EXIT1 ("mode=0 vs mode=1 mismatch!\n--- mode=0 ---\n%s\n--- mode=1 ---\n%s",
+                b0, b1);
+
+  free (b0);
+  free (b1);
+  for (int mode = 0; mode <= 1; ++mode)
+    free (outs[mode]);
+  nftw (tmp, rm_child_cb, 32, FTW_DEPTH | FTW_PHYS);
+  free (fb_hsh);
+  free (fb_ubsh);
+  free (fb_ncw);
+  free (fb_hdr);
+  free (fb_so);
+  free (fb_dot);
+  free (fb_sh);
+  free (fb_hid);
+  free (fb_ul);
+  free (fb_ub);
+  free (fb_inc);
+  free (fb_lib);
+  free (fb_pkg);
+  free (fb);
+  free (tmp);
+  return 0;
+}
