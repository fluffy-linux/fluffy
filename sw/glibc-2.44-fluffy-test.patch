@@ -17,6 +17,9 @@
    <https://www.gnu.org/licenses/>.  */
 
 #include <glob.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <unistd.h>
 #include <string.h>
 #include <support/test-driver.h>
 #include <support/support.h>
@@ -43,12 +46,56 @@
   TEST_VERIFY (glob (pattern, 0, NULL, &g) == 0);
   globfree (&g);
 
-  /* Test based on BZ #33537.  "/*/////sh".  */
+  /* Test based on BZ #33537.  "/*/////bash".  */
   pattern[1] = '*';
+  pattern[SIZE - 5] = 'b';
+  pattern[SIZE - 4] = 'a';
   pattern[SIZE - 3] = 's';
   pattern[SIZE - 2] = 'h';
   TEST_VERIFY (glob (pattern, 0, NULL, &g) == 0);
   globfree (&g);
+  free (pattern);
+
+  /* Verify Fluffy SquashFS cache and literal-suffix fast paths match the
+     uncached slow path across cold and warm runs.  */
+  int dummy_err (const char *epath, int eerrno) { return 0; }
+  static const char *const sw_pats[] =
+    {
+      "/sw/*/bin/bash",
+      "/sw/*/bin/nonexistent_fluffy_test_binary",
+      "/sw/*/bin",
+      "/sw/*/bin/",
+      "/sw/*/lib/libc.so*",
+      "/sw/*/include/*.h",
+      "/sw/*/include/sys/types.h",
+      "/sw/*/include/sys/nonexistent_fluffy_test.h",
+      "/sw/*/include/c++/backward"
+    };
+  for (size_t i = 0; i < sizeof (sw_pats) / sizeof (sw_pats[0]); ++i)
+    for (int pass = 0; pass < 2; ++pass)
+      {
+        glob_t g_fast, g_slow;
+        int r_fast = glob (sw_pats[i], 0, NULL, &g_fast);
+        int r_slow = glob (sw_pats[i], 0, dummy_err, &g_slow);
+        TEST_COMPARE (r_fast, r_slow);
+        if (r_fast == 0)
+          {
+            TEST_COMPARE (g_fast.gl_pathc, g_slow.gl_pathc);
+            for (size_t j = 0; j < g_fast.gl_pathc; ++j)
+              TEST_COMPARE_STRING (g_fast.gl_pathv[j], g_slow.gl_pathv[j]);
+            globfree (&g_fast);
+            globfree (&g_slow);
+          }
+      }
+
+  /* Verify execvp sets errno = ENOENT when Fluffy SquashFS cache misses.  */
+  for (int pass = 0; pass < 2; ++pass)
+    {
+      char *const argv[] = { (char *) "nonexistent_fluffy_test_binary", NULL };
+      errno = 0;
+      TEST_COMPARE (execvp (argv[0], argv), -1);
+      TEST_COMPARE (errno, ENOENT);
+    }
 
   return 0;
 }
