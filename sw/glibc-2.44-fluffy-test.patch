+static int
+shm_corrupt_worker (const char *prefix)
+{
+  char pat[512];
+  snprintf (pat, sizeof (pat), "%s/*", prefix);
+  glob_t g;
+  memset (&g, 0, sizeof (g));
+  int r = glob (pat, 0, NULL, &g);
+  TEST_VERIFY_EXIT (r == 0 && g.gl_pathc >= 1);
+  globfree (&g);
+  return 0;
+}
