+static int
+rm_child_cb (const char *fpath, const struct stat *sb, int tflag,
+             struct FTW *ftwbuf)
+{
+  (void) sb;
+  (void) tflag;
+  if (ftwbuf->level > 0)
+    remove (fpath);
+  return 0;
+}
