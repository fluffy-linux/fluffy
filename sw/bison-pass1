ON=host-build

VERSION=3.8.2

# Built straight from Fluffy's branch (our commits on upstream's v3.8.2
# tag): swctl fetches the pinned commit, and the gnulib, autoconf and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in, gnulib files or built manuals, so MAKE runs
# bootstrap with the autoconf and automake the release tarball was made
# with (2.71, 1.16.4).  Beyond LFS, which builds bison from its release
# tarball: in host-build, with the host's autopoint, perl, flex, gperf,
# help2man and makeinfo, because gettext-pass1, which would give
# autopoint in cross-build, needs bison-pass1 for its own grammars.  It
# is cross-built for Fluffy, as the other host-build pass1s are, and
# runs in the root.
ARCHIVES=(
    6ee6e6ca82eb25239d917b278534f01c94f71e34 https://github.com/fluffy-linux/bison.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    7aa69820bf6aab0bd99093422df79349986460dc https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.4
)

NEEDS=(
    glibc-pass1
    m4-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    # Configured as a native build: the bison it builds runs here (the
    # root's glibc-pass1 is mounted), and make runs it for doc/bison.help,
    # the man page and the manual's option tables, which configure leaves
    # out when cross compiling.  The m4 that bison runs is the root's:
    # configure, here on the host, would find and try the host's.  Nor
    # does configure ask the host's bison where its catalogs are (YACC):
    # it would turn on translated parser messages (YYENABLE_NLS), which
    # bison has only where a bison is installed already.
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/bison \
        --docdir=/sw/bison/share/doc/bison-$VERSION \
        --host=$FLUFFY_TGT \
        --build=$FLUFFY_TGT \
        ac_cv_path_M4=/sw/m4/bin/m4 \
        ac_cv_prog_gnu_m4_gnu=yes \
        YACC=false
    # The translations as make dist merges them with the templates.
    make -C po update-po
    make -C runtime-po update-po
    make -C gnulib-po update-po
    make
    # bison's parser as make dist ships it (its gen-synclines step): the
    # branch's src/parse-gram.c was made by bison 3.8.1 without #line
    # marks, and the release's by this bison, with them.  make then
    # builds bison again with it.  Here on the host that bison runs the
    # host's m4 ($M4 overrides the configured one; given on make's
    # command line, so the Makefile's doesn't).
    make gen-synclines distdir=. M4="$(command -v m4)"
    make
    # The installed examples without the #line marks extexi leaves in
    # them, as make dist ships them (its examples-unline step).
    make examples-unline distdir=.
}

INSTALL() {
    make install
}
