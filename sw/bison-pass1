ON=cross-build

VERSION=3.8.2

ARCHIVES=(
    9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2 https://ftpmirror.gnu.org/bison/bison-$VERSION.tar.xz
    10b3c52bcffc7b4c3ca8bcb8c43070232c098a33d90e034179ff6763e643a969 file://bison-$VERSION-fluffy-shell.patch
    2d66c392b5ea54ecccd46ad01d20238b087d165b4ad7d46fd2af1ae1a0e6d51c file://bison-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc-pass1
    m4-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    linux-headers
    m4-pass1
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i bison-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i bison-$VERSION-fluffy-test.patch
    CONFIG_SITE=/sw/glibc/share/config.site CONFIG_SHELL=/sw/bash/bin/bash ./configure \
        --prefix=/sw/bison \
        --docdir=/sw/bison/share/doc/bison-$VERSION
    make
}

INSTALL() {
    make install
}
