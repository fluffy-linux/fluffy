ON=cross-build

VERSION=3.8.2

ARCHIVES=(
    9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2 https://ftpmirror.gnu.org/bison/bison-$VERSION.tar.xz
    31b682bdab096da1a26d951f96f03d3702518152ea545f41910283677c999a8e file://bison-$VERSION-fluffy.patch
)

NEEDS=(glibc-pass1 m4-pass1)
MAKE_NEEDS=(bash-pass1 binutils-pass2 coreutils-pass1 diffutils-pass1 findutils-pass1 gawk-pass1 gcc-pass2 glibc-pass1 grep-pass1 gzip-pass1 linux-headers m4-pass1 make-pass1 patch-pass1 sed-pass1 tar-pass1 xz-pass1)

MAKE() {
    patch -Np1 -i bison-$VERSION-fluffy.patch
    CONFIG_SHELL=/sw/bash/bin/bash ./configure \
        --prefix=/sw/bison \
        --docdir=/sw/bison/share/doc/bison-$VERSION
    make
}

INSTALL_NEEDS=(bash-pass1 binutils-pass2 coreutils-pass1 diffutils-pass1 gawk-pass1 grep-pass1 m4-pass1 make-pass1 sed-pass1)

INSTALL() {
    make install
}
