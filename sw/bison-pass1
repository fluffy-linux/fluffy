ON=cross-build

VERSION=3.8.2

ARCHIVES=(
    9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2 https://github.com/fluffy-linux/bison/releases/download/v$VERSION/bison-$VERSION.tar.xz
    12fddada7b0fb9d9374a2e7fff40b23de5ea354946a095b356afc0b9f18b3380 file://bison-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
    m4-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    linux-headers
    m4-pass1
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i bison-$VERSION-fluffy-source.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bison \
        --docdir=/sw/bison/share/doc/bison-$VERSION
    make
}

INSTALL() {
    make install
}
