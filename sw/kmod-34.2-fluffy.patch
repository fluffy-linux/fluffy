diff --no-dereference -Naur kmod-34.2.orig/testsuite/test-blacklist.c kmod-34.2/testsuite/test-blacklist.c
--- kmod-34.2.orig/testsuite/test-blacklist.c	2025-03-28 04:01:47.000000000 +0000
+++ kmod-34.2/testsuite/test-blacklist.c	2025-03-28 04:01:47.000000000 +0000
@@ -86,4 +86,69 @@
 		    [TC_ROOTFS] = TESTSUITE_ROOTFS "test-blacklist/",
 	    });
 
+
+static int blacklist_fluffy_glob(const struct test *t)
+{
+	struct kmod_ctx *ctx;
+	struct kmod_list *list = NULL, *l, *filtered;
+	struct kmod_module *mod;
+	int err;
+	size_t len = 0;
+
+	const char *names[] = { "fluffy_etc", "fluffy_lib", "ext4", NULL };
+	const char **name;
+
+	ctx = kmod_new(NULL, NULL);
+	if (ctx == NULL)
+		exit(EXIT_FAILURE);
+
+	for (name = names; *name; name++) {
+		err = kmod_module_new_from_name(ctx, *name, &mod);
+		if (err < 0)
+			goto fail_lookup;
+		list = kmod_list_append(list, mod);
+	}
+
+	err = kmod_module_apply_filter(ctx, KMOD_FILTER_BLACKLIST, list, &filtered);
+	if (err < 0) {
+		ERR("Could not filter: %s\n", strerror(-err));
+		goto fail;
+	}
+	if (filtered == NULL) {
+		ERR("All modules were filtered out!\n");
+		goto fail;
+	}
+
+	kmod_list_foreach(l, filtered) {
+		const char *modname;
+		mod = kmod_module_get_module(l);
+		modname = kmod_module_get_name(mod);
+		if (streq("fluffy_etc", modname) || streq("fluffy_lib", modname))
+			goto fail;
+		len++;
+		kmod_module_unref(mod);
+	}
+
+	if (len != 1)
+		goto fail;
+
+	kmod_module_unref_list(filtered);
+	kmod_module_unref_list(list);
+	kmod_unref(ctx);
+
+	return EXIT_SUCCESS;
+
+fail:
+	kmod_module_unref_list(list);
+fail_lookup:
+	kmod_unref(ctx);
+	return EXIT_FAILURE;
+}
+
+DEFINE_TEST(blacklist_fluffy_glob,
+	    .description = "check if modules in /sw/*/{etc,lib}/modprobe.d are blacklisted",
+	    .config = {
+		    [TC_ROOTFS] = TESTSUITE_ROOTFS "test-blacklist/",
+	    });
+
 TESTSUITE_MAIN();
