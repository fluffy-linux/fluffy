+
+static bool config_path_exists(const struct kmod_list *path_list, const char *path)
+{
+	const struct kmod_list *l;
+
+	kmod_list_foreach(l, path_list) {
+		const struct kmod_config_path *cf = l->data;
+
+		if (streq(cf->path, path))
+			return true;
+	}
+	return false;
+}
+
+static int kmod_config_add_path(struct kmod_ctx *ctx, struct kmod_list **list,
+				struct kmod_list **path_list, const char *path)
+{
+	unsigned long long path_stamp = 0;
+	size_t pathlen;
+	struct kmod_list *tmp;
+	struct kmod_config_path *cf;
+
+	if (config_path_exists(*path_list, path))
+		return 0;
+
+	pathlen = strlen(path) + 1;
+	cf = malloc(sizeof(*cf) + pathlen);
+	if (cf == NULL)
+		return -ENOMEM;
+
+	memcpy(cf->path, path, pathlen);
+
+	if (conf_files_list(ctx, list, cf->path, &path_stamp) < 0) {
+		free(cf);
+		return 0;
+	}
+
+	cf->stamp = path_stamp;
+
+	tmp = kmod_list_append(*path_list, cf);
+	if (tmp == NULL) {
+		free(cf);
+		return -ENOMEM;
+	}
+	*path_list = tmp;
+	return 0;
+}
