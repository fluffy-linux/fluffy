--- kmod-34.2.orig/testsuite/path.c	2025-03-28 04:01:47.000000000 +0000
+++ kmod-34.2/testsuite/path.c	2025-03-28 04:01:47.000000000 +0000
@@ -13,6 +13,7 @@
 #include <dlfcn.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <glob.h>
 #include <limits.h>
 #include <stdarg.h>
 #include <stdio.h>
@@ -207,3 +208,81 @@
 WRAP_VERSTAT(__x, );
 WRAP_VERSTAT(__x, 64);
 #endif
+
+#define WRAP_GLOB(suffix, glob_type)                                          \
+	TS_EXPORT int glob##suffix(const char *pattern, int flags,            \
+				   int (*errfunc)(const char *, int),         \
+				   glob_type *pglob)                          \
+	{                                                                     \
+		const char *p = pattern;                                      \
+		char buf[PATH_MAX * 4];                                       \
+		size_t rplen = 0, erplen = 0, offs, start, i;                 \
+		int rc;                                                       \
+		static int (*_fn)(const char *, int,                          \
+				  int (*)(const char *, int), glob_type *);   \
+                                                                              \
+		if (!get_rootpath(__func__))                                  \
+			return GLOB_ABORTED;                                  \
+		_fn = get_libc_func("glob" #suffix);                          \
+		if (need_trap(pattern)) {                                     \
+			size_t plen = strlen(pattern);                        \
+			size_t ri, di = 0;                                    \
+			rplen = rootpathlen;                                  \
+			while (rplen > 0 && rootpath[rplen - 1] == '/')       \
+				rplen--;                                      \
+			for (ri = 0; ri < rplen; ri++) {                      \
+				char c = rootpath[ri];                        \
+				if (di + 4 >= sizeof(buf)) {                  \
+					errno = ENAMETOOLONG;                 \
+					return GLOB_ABORTED;                  \
+				}                                             \
+				if (flags & GLOB_NOESCAPE) {                  \
+					if (c == '*' || c == '?' ||           \
+					    c == '[') {                       \
+						buf[di++] = '[';              \
+						buf[di++] = c;                \
+						buf[di++] = ']';              \
+						continue;                     \
+					}                                     \
+				} else if (c == '\\' || c == '*' ||           \
+					   c == '?' || c == '[' ||            \
+					   c == '{' || c == '}' ||            \
+					   c == '(' || c == ')') {            \
+					buf[di++] = '\\';                     \
+				}                                             \
+				buf[di++] = c;                                \
+			}                                                     \
+			erplen = di;                                          \
+			if (plen + erplen >= sizeof(buf)) {                   \
+				errno = ENAMETOOLONG;                         \
+				return GLOB_ABORTED;                          \
+			}                                                     \
+			memcpy(buf + erplen, pattern, plen + 1);              \
+			p = buf;                                              \
+		}                                                             \
+		offs = (flags & GLOB_DOOFFS) ? pglob->gl_offs : 0;            \
+		start = offs + ((flags & GLOB_APPEND) ? pglob->gl_pathc : 0); \
+		rc = _fn(p, flags, errfunc, pglob);                           \
+		if (p != pattern && (rc == 0 || rc == GLOB_NOMATCH)) {        \
+			for (i = start; i < offs + pglob->gl_pathc; i++) {    \
+				char *s = pglob->gl_pathv[i];                 \
+				if (s == NULL)                                \
+					continue;                             \
+				if (strncmp(s, rootpath, rplen) == 0 &&       \
+				    s[rplen] == '/')                          \
+					memmove(s, s + rplen,                 \
+						strlen(s + rplen) + 1);       \
+				else if (erplen != rplen &&                   \
+					 strncmp(s, buf, erplen) == 0 &&      \
+					 s[erplen] == '/')                    \
+					memmove(s, s + erplen,                \
+						strlen(s + erplen) + 1);      \
+			}                                                     \
+		}                                                             \
+		return rc;                                                    \
+	}
+
+WRAP_GLOB(, glob_t);
+#ifdef HAVE_GLOB64
+WRAP_GLOB(64, glob64_t);
+#endif
