ON=cross-build

VERSION=1.24.1

# groff for gettext.  gettext's man pages are not in git: its build
# writes them with help2man and renders each as HTML with groff -Thtml,
# as the release did.  The final groff is built with the final texinfo,
# bison and perl, and texinfo needs gettext: this pass breaks that
# cycle, built with the temporary tools.  Beyond LFS, which builds
# gettext from its release tarball.
ARCHIVES=(
    74e2819795b6aff431aeac983d63a9c8968eeaba2a2eba7df8ba4c7b41e7cfd8 https://github.com/fluffy-linux/groff/releases/download/$VERSION/groff-$VERSION.tar.gz
    7b2160654b45f201501b6240c5c912fb91323fccacb2b97dd2287e8b44c152c5 file://groff-$VERSION-fluffy-shell.patch
    d0df217d5e68e13aed942a8646837a66e1cc9a72b0c1773b7c71636518b6ca49 file://groff-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
    perl-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    bison-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
    make-pass1
    patch-pass1
    perl-pass1
    sed-pass1
    tar-pass1
    texinfo-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i ../groff-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i ../groff-$VERSION-fluffy-source.patch

    PAGE=letter ./configure \
        --prefix=/sw/groff
    make -j1
}

INSTALL() {
    make install
}
