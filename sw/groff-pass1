ON=cross-build

VERSION=1.24.1

# groff for gettext.  gettext's man pages are not in git: its build
# writes them with help2man and renders each as HTML with groff -Thtml,
# as the release did.  The final groff is built with the final texinfo,
# bison and perl, and texinfo needs gettext: this pass breaks that
# cycle, built with the temporary tools.  Beyond LFS, which builds
# gettext from its release tarball.  Built straight from Fluffy's
# branch, as groff is.
ARCHIVES=(
    e50939decf593b1a898144bc447b63b4024a1b36 https://github.com/fluffy-linux/groff.git#refs/heads/fluffy/$VERSION
    48eccc1ad68d408db760ce345e08eda16b694c52 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.69
    9d78c9a5e6180fb86ad77f3e6b4e82403bc86da6 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.3
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
    perl-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    bison-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
    make-pass1
    patch-pass1
    perl-pass1
    pkgconf-pass1
    sed-pass1
    tar-pass1
    texinfo-pass1
    xz-pass1
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    PAGE=letter $CONFIG_SHELL ./configure \
        --prefix=/sw/groff
    make -j1
}

INSTALL() {
    make install
}
