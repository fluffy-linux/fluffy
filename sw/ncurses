if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.6

# Built straight from Fluffy's branch (our commits on upstream's v6_6
# snapshot tag, which equals the release tarball, LFS's curses.h edit
# among them): swctl fetches the pinned commit with git.
ARCHIVES=(
    6ad2db4a4fcf810e9b797b55a7e1af0903579f6c https://github.com/fluffy-linux/ncurses-snapshots.git#refs/heads/fluffy/v${VERSION//./_}
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        sed
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/ncurses \
        --mandir=/sw/ncurses/share/man \
        --with-manpage-format=normal \
        --with-terminfo-dirs="/etc/terminfo:/sw/*/share/terminfo" \
        --with-shared \
        --without-debug \
        --without-normal \
        --with-cxx-shared \
        --enable-pc-files \
        --with-pkg-config-libdir=/sw/ncurses/lib/pkgconfig \
        --enable-widec \
        --enable-overwrite \
        AWK=gawk
    make
}

CHECK() {
    # Only progs/: the top-level check also builds ncurses/ test drivers
    # (hardscroll, hashmap) that need --with-trace and fail to compile here.
    make -C progs check
}

INSTALL() {
    make install

    for lib in ncurses form panel menu ncurses++; do
        ln -sfv lib${lib}w.so $DESTDIR/sw/ncurses/lib/lib${lib}.so
        ln -sfv ${lib}w.pc    $DESTDIR/sw/ncurses/lib/pkgconfig/${lib}.pc
    done
    ln -sfv libncursesw.so $DESTDIR/sw/ncurses/lib/libcurses.so

    ln -sfv . $DESTDIR/sw/ncurses/include/ncursesw

    mkdir -pv $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
    cp -v -R doc/* $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
}
