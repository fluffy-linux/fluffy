if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.6

ARCHIVES=(
    355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11 https://github.com/fluffy-linux/ncurses-snapshots/releases/download/v${VERSION//./_}/ncurses-$VERSION.tar.gz
    cdefcbf2a3aba49744668c4c69d994422f48576a20b1f7ff200efe378d39e8a7 file://ncurses-$VERSION-fluffy-source.patch
    23809e31fc4c2284f4e160c4cbf1aad631b421c3cbd077dd3c31ac9749f17413 file://ncurses-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i ../ncurses-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ../ncurses-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/ncurses \
        --mandir=/sw/ncurses/share/man \
        --with-manpage-format=normal \
        --with-terminfo-dirs="/etc/terminfo:/sw/*/share/terminfo" \
        --with-shared \
        --without-debug \
        --without-normal \
        --with-cxx-shared \
        --enable-pc-files \
        --with-pkg-config-libdir=/sw/ncurses/lib/pkgconfig \
        --enable-widec \
        --enable-overwrite \
        AWK=gawk
    make
}

CHECK() {
    # Only progs/: the top-level check also builds ncurses/ test drivers
    # (hardscroll, hashmap) that need --with-trace and fail to compile here.
    make -C progs check
}

INSTALL() {
    make install

    sed -e 's/^#if.*XOPEN.*$/#if 1/' \
        -i $DESTDIR/sw/ncurses/include/curses.h

    for lib in ncurses form panel menu ncurses++; do
        ln -sfv lib${lib}w.so $DESTDIR/sw/ncurses/lib/lib${lib}.so
        ln -sfv ${lib}w.pc    $DESTDIR/sw/ncurses/lib/pkgconfig/${lib}.pc
    done
    ln -sfv libncursesw.so $DESTDIR/sw/ncurses/lib/libcurses.so

    ln -sfv . $DESTDIR/sw/ncurses/include/ncursesw

    mkdir -pv $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
    cp -v -R doc/* $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
}
