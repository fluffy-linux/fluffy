if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.6

HAS_LDFLAGS=-lncursesw

ARCHIVES=(
    355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11 https://github.com/fluffy-linux/ncurses-snapshots/releases/download/v${VERSION//./_}/ncurses-$VERSION.tar.gz
    cdefcbf2a3aba49744668c4c69d994422f48576a20b1f7ff200efe378d39e8a7 file://ncurses-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i ncurses-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/ncurses \
        --mandir=/sw/ncurses/share/man \
        --with-manpage-format=normal \
        --with-terminfo-dirs="/etc/terminfo:/sw/*/share/terminfo" \
        --with-shared \
        --without-debug \
        --without-normal \
        --with-cxx-shared \
        --enable-widec \
        --enable-overwrite \
        AWK=gawk
    make
}

CHECK() {
    local td
    td=$(mktemp -d)
    mkdir -p "$td/default" "$td/sw/pkgA/share/terminfo" "$td/sw/1:colon/share/terminfo" "$td/etc/terminfo" "$td/cwd"

    LD_LIBRARY_PATH="$PWD/lib" ./progs/tic -x -o "$td/default" -e xterm-256color misc/terminfo.src
    LD_LIBRARY_PATH="$PWD/lib" TERMINFO="$td/default" ./progs/infocmp xterm-256color >/dev/null

    printf 'custom-fluffy-term|fluffy vendor term,\n\tcols#111, lines#24,\n' > "$td/vendor.ti"
    printf 'colon-fluffy-term|fluffy colon vendor term,\n\tcols#123, lines#25,\n' > "$td/colon.ti"
    printf 'custom-fluffy-term|fluffy etc override,\n\tcols#199, lines#42,\n' > "$td/etc.ti"
    printf 'cwd-evil-term|evil cwd term,\n\tcols#666, lines#13,\n' > "$td/cwd.ti"

    LD_LIBRARY_PATH="$PWD/lib" ./progs/tic -o "$td/sw/pkgA/share/terminfo" "$td/vendor.ti"
    LD_LIBRARY_PATH="$PWD/lib" ./progs/tic -o "$td/sw/1:colon/share/terminfo" "$td/colon.ti"
    LD_LIBRARY_PATH="$PWD/lib" ./progs/tic -o "$td/etc/terminfo" "$td/etc.ti"
    LD_LIBRARY_PATH="$PWD/lib" ./progs/tic -o "$td/cwd" "$td/cwd.ti"

    LD_LIBRARY_PATH="$PWD/lib" TERMINFO="$td/nonexistent" \
        TERMINFO_DIRS="$td/missing_etc:$td/sw/[[:alpha:]]*/share/terminfo:$td/sw/1[a:]colon/share/terminfo" \
        ./progs/infocmp custom-fluffy-term | grep -q 'cols#111'

    LD_LIBRARY_PATH="$PWD/lib" TERMINFO="$td/nonexistent" \
        TERMINFO_DIRS="$td/missing_etc:$td/sw/[[:alpha:]]*/share/terminfo:$td/sw/1[a:]colon/share/terminfo" \
        ./progs/infocmp colon-fluffy-term | grep -q 'cols#123'

    LD_LIBRARY_PATH="$PWD/lib" TERMINFO="$td/nonexistent" \
        TERMINFO_DIRS="$td/etc/terminfo:$td/sw/*/share/terminfo" \
        ./progs/infocmp custom-fluffy-term | grep -q 'cols#199'

    (
        cd "$td/cwd"
        LD_LIBRARY_PATH="$OLDPWD/lib" TERMINFO="$td/nonexistent" \
            TERMINFO_DIRS=":$td/sw/*/share/terminfo" \
            "$OLDPWD/progs/infocmp" custom-fluffy-term | grep -q 'cols#111'
        ! LD_LIBRARY_PATH="$OLDPWD/lib" TERMINFO="$td/nonexistent" \
            TERMINFO_DIRS=":$td/sw/*/share/terminfo" \
            "$OLDPWD/progs/infocmp" cwd-evil-term >/dev/null 2>&1
    )

    rm -rf "$td"
}

INSTALL() {
    make install

    sed -e 's/^#if.*XOPEN.*$/#if 1/' \
        -i $DESTDIR/sw/ncurses/include/curses.h

    for lib in ncurses form panel menu ncurses++; do
        ln -sfv lib${lib}w.so $DESTDIR/sw/ncurses/lib/lib${lib}.so
    done
    ln -sfv libncursesw.so $DESTDIR/sw/ncurses/lib/libcurses.so

    ln -sfv . $DESTDIR/sw/ncurses/include/ncursesw

    mkdir -pv $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
    cp -v -R doc/* $DESTDIR/sw/ncurses/share/doc/ncurses-$VERSION
}
