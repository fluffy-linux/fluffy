if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.35

# Built straight from Fluffy's branch (our commits on upstream's
# v1.35 tag, LFS's acl fix among them): swctl fetches the pinned
# commit, and the gnulib, paxutils and translationproject commits it
# pins, with git.  The tag has no configure, Makefile.in or gnulib
# files, so MAKE bootstraps it, and its translations come from the
# Translation Project's files, merged as the release's make dist did.
ARCHIVES=(
    027b8bbc8df681b3a30c7fe93a6c027794767e6e https://github.com/fluffy-linux/tar.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
)

NEEDS=(
    acl
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        bash
        binutils
        bison
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar-pass1
        texinfo
        xz
        zstd
    )
else
    BUILD_NEEDS=(
        acl
        bash
        binutils
        bison
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar
        texinfo
        xz
        zstd
    )
fi

# Bootstrapped with the autotools tar's release tarball was made with
# (autoconf 2.71, automake 1.16.5).  gettext gives bootstrap autopoint,
# and the build xgettext, msgmerge and msgfmt; bison writes gnulib's
# parse-datetime.c, which the release tarball ships made.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    FORCE_UNSAFE_CONFIGURE=1 $CONFIG_SHELL ./configure \
        --prefix=/sw/tar
    # The translations as make dist merges them with tar.pot.
    make -C po update-po
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
