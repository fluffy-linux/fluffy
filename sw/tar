if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.35

ARCHIVES=(
    4d62ff37342ec7aed748535323930c7cf94acf71c3591882b26a7ea50f3edc16 https://github.com/fluffy-linux/tar/releases/download/v$VERSION/tar-$VERSION.tar.xz
    51cadccfcb2f29cfdb4ec18015360100aa167179a72ece040a6a8612aeec5081 file://tar-$VERSION-acl_fix-1.patch
    0aaadf6e82861c9b77ee14a4ff413062d7edb33edf9138d62605cd3177b68515 file://tar-$VERSION-fluffy-source.patch
)

NEEDS=(
    acl
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar-pass1
        xz
        zstd
    )
else
    BUILD_NEEDS=(
        acl
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
        zstd
    )
fi

MAKE() {
    patch -Z -Np1 -i tar-$VERSION-acl_fix-1.patch
    patch -Z -Np1 -i tar-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    FORCE_UNSAFE_CONFIGURE=1 $CONFIG_SHELL ./configure \
        --prefix=/sw/tar
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
