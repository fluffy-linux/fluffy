ON=cross-build

VERSION=8.3

ARCHIVES=(
    fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc https://ftpmirror.gnu.org/readline/readline-$VERSION.tar.gz
    90cc647d032e2b0a5e1656fefa02c58e50c445f976949beef15ad76b3d6d0e96 file://readline-$VERSION-fluffy-shell.patch
    687c2f6e8e5077e1738bf20a81693e811492b141f632158c1d2c462c85b2ebae file://readline-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    ncurses-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc
    grep-pass1
    linux-headers
    make-pass1
    ncurses-pass1
    patch-pass1
    sed-pass1
    tar-pass1
)

MAKE() {
    patch -Z -Np1 -i readline-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i readline-$VERSION-fluffy-source.patch
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION
    make SHLIB_LIBS="-lncursesw"
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} $DESTDIR/sw/readline/share/doc/readline-$VERSION
}
