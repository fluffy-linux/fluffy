if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.3

# Built straight from Fluffy's branch (our commits on upstream's
# readline-8.3 tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    53376d2fa3912ba45a9137ea7acefe395b10ea23 https://github.com/fluffy-linux/readline.git#refs/heads/fluffy/readline-$VERSION
)

if test -v CROSS
then
    NEEDS=(
        glibc
        ncurses-pass1
    )
else
    NEEDS=(
        glibc
        ncurses
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        patch-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        tar
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION \
        CPPFLAGS='-DSYS_INPUTRC="\"/sw/*/etc/inputrc:/etc/inputrc\""'
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} $DESTDIR/sw/readline/share/doc/readline-$VERSION

    install -dm755 $DESTDIR/sw/readline/etc
    cat > $DESTDIR/sw/readline/etc/inputrc << "EOF"
# Begin /sw/readline/etc/inputrc

set horizontal-scroll-mode Off
set meta-flag On
set input-meta On
set convert-meta Off
set output-meta On
set bell-style none

"\eOd": backward-word
"\eOc": forward-word
"\e[1;5D": backward-word
"\e[1;5C": forward-word
"\e[1;3D": backward-word
"\e[1;3C": forward-word

"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[5~": beginning-of-history
"\e[6~": end-of-history
"\e[3~": delete-char
"\e[2~": quoted-insert

"\eOH": beginning-of-line
"\eOF": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line

# End /sw/readline/etc/inputrc
EOF
}
