if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.3

# Built straight from Fluffy's branch (our commits on upstream's
# readline-8.3 tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    d10cb036a45cacc36233664e02e67af71836a7a7 https://github.com/fluffy-linux/readline.git#refs/heads/fluffy/readline-$VERSION
)

if test -v CROSS
then
    NEEDS=(
        glibc
        ncurses-pass1
    )
else
    NEEDS=(
        glibc
        ncurses
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        sed
        tar
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION \
        CPPFLAGS='-DSYS_INPUTRC="\"/sw/*/etc/inputrc:/etc/inputrc\""'
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} $DESTDIR/sw/readline/share/doc/readline-$VERSION
}
