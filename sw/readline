if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.3

HAS_LDFLAGS=-lreadline

ARCHIVES=(
    fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc https://github.com/fluffy-linux/readline/releases/download/readline-$VERSION/readline-$VERSION.tar.gz
    ad168a38184511c918dd3390d208dca6044b24bcbb9fd1cc87a7571d0e873234 file://readline-$VERSION-fluffy-source.patch
)

if test -v CROSS
then
    NEEDS=(
        glibc
        ncurses-pass1
    )
else
    NEEDS=(
        glibc
        ncurses
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        patch-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i readline-$VERSION-fluffy-source.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION
    make
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} $DESTDIR/sw/readline/share/doc/readline-$VERSION
}
