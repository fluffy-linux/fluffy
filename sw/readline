if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.3

HAS_LDFLAGS=-lreadline

ARCHIVES=(
    fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc https://github.com/fluffy-linux/readline/releases/download/readline-$VERSION/readline-$VERSION.tar.gz
    1e7bfa1a4b47d35f816c85676b76dec8784e20fb7a148ab6d212c18fd57febbe file://readline-$VERSION-fluffy-source.patch
)

if test -v CROSS
then
    NEEDS=(
        glibc
        ncurses-pass1
    )
else
    NEEDS=(
        glibc
        ncurses
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        patch-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i readline-$VERSION-fluffy-source.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION \
        CPPFLAGS='-DSYS_INPUTRC="\"/sw/*/etc/inputrc:/etc/inputrc\""'
    make
}

CHECK() {
    local td
    td=$(mktemp -d)
    ln -snf "$PWD" "$td/readline"
    ln -snf "libreadline.so.$VERSION" shlib/libreadline.so
    ln -snf "libreadline.so.$VERSION" "shlib/libreadline.so.${VERSION%%.*}"
    mkdir -p "$td/sw/pkgA/etc" "$td/sw/pkgB/etc" "$td/etc" "$td/home"
    printf 'set bell-style none\nset editing-mode emacs\n' > "$td/sw/pkgA/etc/inputrc"
    printf 'set completion-ignore-case on\n' > "$td/sw/pkgB/etc/inputrc"
    printf 'set bell-style audible\nset editing-mode vi\n' > "$td/my:inputrc"
    printf 'set bell-style visible\n' > "$td/home/.inputrc"

    cat > "$td/test_rl.c" << 'EOF'
#include <stdio.h>
#include <string.h>
#include <readline/readline.h>

int main(int argc, char **argv) {
    int r;
    rl_initialize();
    r = rl_read_init_file(argv[1]);
    if (r != 0) {
        printf("ERR:%d\n", r);
        return 1;
    }
    printf("%s|%s|%s\n",
           rl_variable_value("bell-style") ?: "",
           rl_variable_value("editing-mode") ?: "",
           rl_variable_value("completion-ignore-case") ?: "");
    return 0;
}
EOF
    gcc -I"$td" -L./shlib -Wl,-rpath,"$PWD/shlib" "$td/test_rl.c" -lreadline -o "$td/test_rl"

    test "$(INPUTRC=/dev/null "$td/test_rl" "$td/sw/*/etc/inputrc:$td/etc/inputrc")" = "none|emacs|on"
    test "$(INPUTRC=/dev/null "$td/test_rl" ":$td/sw/*/etc/inputrc:")" = "none|emacs|on"
    test "$(INPUTRC=/dev/null "$td/test_rl" "$td/my:inputrc")" = "audible|vi|off"
    test "$(HOME="$td/home" INPUTRC=/dev/null "$td/test_rl" "$td/sw/*/etc/inputrc:~/.inputrc")" = "visible|emacs|on"
    test "$(HOME="$td/home" INPUTRC=/dev/null "$td/test_rl" "~/.inputrc:$td/sw/*/etc/inputrc")" = "none|emacs|on"
    test "$(INPUTRC=/dev/null "$td/test_rl" ":" || true)" = "ERR:2"

    printf 'set bell-style visible\n' > "$td/etc/inputrc"
    test "$(INPUTRC=/dev/null "$td/test_rl" "$td/sw/*/etc/inputrc:$td/etc/inputrc")" = "visible|emacs|on"
    rm -f shlib/libreadline.so "shlib/libreadline.so.${VERSION%%.*}"
    rm -rf "$td"
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} $DESTDIR/sw/readline/share/doc/readline-$VERSION

    install -dm755 $DESTDIR/sw/readline/etc
    cat > $DESTDIR/sw/readline/etc/inputrc << "EOF"
# Begin /sw/readline/etc/inputrc

set horizontal-scroll-mode Off
set meta-flag On
set input-meta On
set convert-meta Off
set output-meta On
set bell-style none

"\eOd": backward-word
"\eOc": forward-word
"\e[1;5D": backward-word
"\e[1;5C": forward-word
"\e[1;3D": backward-word
"\e[1;3C": forward-word

"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[5~": beginning-of-history
"\e[6~": end-of-history
"\e[3~": delete-char
"\e[2~": quoted-insert

"\eOH": beginning-of-line
"\eOF": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line

# End /sw/readline/etc/inputrc
EOF
}
