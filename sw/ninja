if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.13.2

# Built straight from Fluffy's branch (our commits on upstream's v1.13.2
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    7ca08d87a7659fcf660add79a232cb7b78b7a73f https://github.com/fluffy-linux/ninja.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    bash-pass1
    glibc
    libgcc
    libstdcpp-pass1
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        gcc-pass2
        glibc
        libgcc
        libstdcpp-pass1
        linux-headers
        python-pass1
        sed-pass1
        util-linux-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        libstdcpp
        linux-headers
        python-pass1
        sed
        util-linux-pass1
    )
fi

MAKE() {

    sed -i '/int Guess/a \
  int   j = 0;\
  char* jobs = getenv( "NINJAJOBS" );\
  if ( jobs != NULL ) j = atoi( jobs );\
  if ( j > 0 ) return j;\
' src/ninja.cc

    python3 configure.py --bootstrap --verbose
}

CHECK() {
    unset MAKEFLAGS
    python3 misc/ninja_syntax_test.py
    python3 misc/jobserver_pool_test.py
    python3 misc/jobserver_test.py
}

INSTALL() {
    install -vm755 -D ninja $DESTDIR/sw/ninja/bin/ninja
    install -vDm644 misc/bash-completion $DESTDIR/sw/ninja/share/bash-completion/completions/ninja
    install -vDm644 misc/zsh-completion  $DESTDIR/sw/ninja/share/zsh/site-functions/_ninja
}
