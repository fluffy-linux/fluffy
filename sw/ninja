if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.13.2

ARCHIVES=(
    974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17 https://github.com/fluffy-linux/ninja/releases/download/v$VERSION/ninja-$VERSION.tar.gz
    e7208618eb196cd1d01a69d81f4cee608ced14b94a9b4db8618901e520318188 file://ninja-$VERSION-fluffy-source.patch
    106abac771d2ca5187cfef6889bdf6ee10143c3bf47caab324e99e637ee70ef3 file://ninja-$VERSION-fluffy-test.patch
)

NEEDS=(
    bash
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        gcc
        glibc
        libgcc
        libstdcpp
        linux-headers
        patch-pass1
        python
        sed
        util-linux-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        libstdcpp
        linux-headers
        patch
        python
        sed
        util-linux
    )
fi

MAKE() {
    patch -Z -Np1 -i ninja-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ninja-$VERSION-fluffy-test.patch

    sed -i '/int Guess/a \
  int   j = 0;\
  char* jobs = getenv( "NINJAJOBS" );\
  if ( jobs != NULL ) j = atoi( jobs );\
  if ( j > 0 ) return j;\
' src/ninja.cc

    python3 configure.py --bootstrap --verbose
}

CHECK() {
    unset MAKEFLAGS
    python3 misc/ninja_syntax_test.py
    python3 misc/jobserver_pool_test.py
    python3 misc/jobserver_test.py
}

INSTALL() {
    install -vm755 -D ninja $DESTDIR/sw/ninja/bin/ninja
    install -vDm644 misc/bash-completion $DESTDIR/sw/ninja/share/bash-completion/completions/ninja
    install -vDm644 misc/zsh-completion  $DESTDIR/sw/ninja/share/zsh/site-functions/_ninja
}
