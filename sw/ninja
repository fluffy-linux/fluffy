if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.13.2

ARCHIVES=(
    974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17 https://github.com/fluffy-linux/ninja/releases/download/v$VERSION/ninja-$VERSION.tar.gz
    ff4060421cd7fb940f8ec19a1b96db43e9b55dbd19ab2ebe391c5663ce627a61 file://ninja-$VERSION-fluffy-source.patch
    01a41f7c67d1423242948e896f5c8623c42f65c23bbeea9c44b55b119ca0cc9e file://ninja-$VERSION-fluffy-test.patch
)

NEEDS=(
    bash-pass1
    glibc
    libgcc
    libstdcpp-pass1
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        gcc-pass2
        glibc
        libgcc
        libstdcpp-pass1
        linux-headers
        patch-pass1
        python-pass1
        sed-pass1
        util-linux-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        libstdcpp
        linux-headers
        patch
        python-pass1
        sed
        util-linux-pass1
    )
fi

MAKE() {
    patch -Z -Np1 -i ../ninja-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ../ninja-$VERSION-fluffy-test.patch

    sed -i '/int Guess/a \
  int   j = 0;\
  char* jobs = getenv( "NINJAJOBS" );\
  if ( jobs != NULL ) j = atoi( jobs );\
  if ( j > 0 ) return j;\
' src/ninja.cc

    python3 configure.py --bootstrap --verbose
}

CHECK() {
    unset MAKEFLAGS
    python3 misc/ninja_syntax_test.py
    python3 misc/jobserver_pool_test.py
    python3 misc/jobserver_test.py
}

INSTALL() {
    install -vm755 -D ninja $DESTDIR/sw/ninja/bin/ninja
    install -vDm644 misc/bash-completion $DESTDIR/sw/ninja/share/bash-completion/completions/ninja
    install -vDm644 misc/zsh-completion  $DESTDIR/sw/ninja/share/zsh/site-functions/_ninja
}
