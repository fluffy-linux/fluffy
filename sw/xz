if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.8.3

HAS_LDFLAGS=-llzma

ARCHIVES=(
    fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6 https://github.com/fluffy-linux/xz/releases/download/v$VERSION/xz-$VERSION.tar.xz
    526f289fe73f03d3e96f92709b0859e989738e4d9974968fb94c7375d0fa3092 file://xz-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i xz-$VERSION-fluffy-test.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/xz \
        --disable-static \
        --docdir=/sw/xz/share/doc/xz-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/xz/lib/liblzma.la
}
