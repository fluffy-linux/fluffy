ON=cross-build

VERSION=5.8.3

ARCHIVES=(
    fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6 https://github.com/tukaani-project/xz/releases/download/v$VERSION/xz-$VERSION.tar.xz
    e3b881e891a9611614dd4a4f40eb2aeac91d35d443006ac4637b7a4c6e690717 file://xz-$VERSION-fluffy-shell.patch
    526f289fe73f03d3e96f92709b0859e989738e4d9974968fb94c7375d0fa3092 file://xz-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc
    grep-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i xz-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i xz-$VERSION-fluffy-test.patch
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/xz \
        --disable-static \
        --docdir=/sw/xz/share/doc/xz-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/xz/lib/liblzma.la
}
