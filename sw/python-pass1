ON=cross-build

VERSION=3.14.7

HAS_CFLAGS=-I/sw/python/include/python3.14
HAS_LDFLAGS=-lpython3.14

ARCHIVES=(
    3b48dac8fb59f62eaa67ac83c1eb12bda1b7a08406dd286e252c11a66be27f81 https://github.com/fluffy-linux/cpython/releases/download/v$VERSION/Python-$VERSION.tar.xz
    6d21c5bcbbd11264782241fb382fda389e5af30d2227530ea61548ba59e2d4cf file://Python-$VERSION-fluffy-source.patch
)

NEEDS=(
    bzip2-pass1
    glibc-pass1
    libffi-pass1
    mpdecimal-pass1
    ncurses-pass1
    util-linux-pass1
    xz-pass1
    zlib-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    bash-pass1
    bzip2-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libffi-pass1
    linux-headers
    make-pass1
    mpdecimal-pass1
    ncurses-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    util-linux-pass1
    xz-pass1
    zlib-pass1
    zstd-pass1
)

MAKE() {
    patch -Z -Np1 -i Python-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/python \
        --enable-shared \
        --without-ensurepip \
        --without-static-libpython
    make SHELL=/sw/bash/bin/bash
}

INSTALL() {
    make SHELL=/sw/bash/bin/bash install
}
