ON=cross-build

VERSION=3.14.7

# Built straight from Fluffy's branch (our commits on upstream's v3.14.7
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    7ce248af148e74dcab04dfc17ded24922ed2ddca https://github.com/fluffy-linux/cpython.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    bzip2-pass1
    glibc-pass1
    libffi-pass1
    mpdecimal-pass1
    ncurses-pass1
    util-linux-pass1
    xz-pass1
    zlib-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    bash-pass1
    bzip2-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libffi-pass1
    linux-headers
    make-pass1
    mpdecimal-pass1
    ncurses-pass1
    pkgconf-pass1
    sed-pass1
    tar-pass1
    util-linux-pass1
    xz-pass1
    zlib-pass1
    zstd-pass1
)

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/python \
        --enable-shared \
        --without-ensurepip \
        --without-static-libpython
    make SHELL=/sw/bash/bin/bash
}

INSTALL() {
    make SHELL=/sw/bash/bin/bash install
}
