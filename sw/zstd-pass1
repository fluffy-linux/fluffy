ON=host-build

VERSION=1.5.7

ARCHIVES=(
    eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3 https://github.com/facebook/zstd/releases/download/v$VERSION/zstd-$VERSION.tar.gz
)

NEEDS=(
    glibc-pass1
)

MAKE_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    make CC=$FLUFFY_TGT-gcc prefix=/sw/zstd
}

INSTALL_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

INSTALL() {
    make CC=$FLUFFY_TGT-gcc prefix=/sw/zstd install
    rm -v $DESTDIR/sw/zstd/lib/libzstd.a
}
