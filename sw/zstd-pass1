ON=host-build

VERSION=1.5.7

# Built straight from Fluffy's branch (our commits on upstream's v1.5.7
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    23dc26fc4634599cc30ac7b0b047926da4dc4da3 https://github.com/fluffy-linux/zstd.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    make CC=$FLUFFY_TGT-gcc prefix=/sw/zstd
}

INSTALL() {
    make CC=$FLUFFY_TGT-gcc prefix=/sw/zstd install
    rm -v $DESTDIR/sw/zstd/lib/libzstd.a
}
