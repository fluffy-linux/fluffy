diff -uNr binutils-2.47.orig/ld/genscripts.sh binutils-2.47/ld/genscripts.sh
--- binutils-2.47.orig/ld/genscripts.sh	2026-07-25 19:00:00.000000000 -0400
+++ binutils-2.47/ld/genscripts.sh	2026-10-26 20:09:24.503162895 -0400
@@ -286,6 +286,7 @@
   *) LIB_PATH=${lib_path1}:${lib_path2} ;;
 esac
 
+LIB_PATH=/sw/*/lib
 LIB_SEARCH_DIRS=`echo ${LIB_PATH} | sed -e 's/:/ /g' -e 's/\([^ ][^ ]*\)/SEARCH_DIR(\\"\1\\");/g'`
 
 # We need it for testsuite.
diff -uNr binutils-2.47.orig/ld/ldfile.c binutils-2.47/ld/ldfile.c
--- binutils-2.47.orig/ld/ldfile.c	2026-07-25 19:00:00.000000000 -0400
+++ binutils-2.47/ld/ldfile.c	2026-10-26 20:09:24.503295436 -0400
@@ -312,6 +312,31 @@
   if (!cmdline && config.only_cmd_line_lib_dirs)
     return;
 
+  if (strcmp (name, "/sw/*/lib") == 0)
+    {
+      struct dirent **namelist;
+      int n = scandir ("/sw", &namelist, NULL, alphasort);
+      if (n >= 0)
+	{
+	  int i;
+	  for (i = 0; i < n; i++)
+	    {
+	      if (namelist[i]->d_name[0] != '.')
+		{
+		  char *p = concat ("/sw/", namelist[i]->d_name, "/lib",
+				    (const char *) NULL);
+		  struct stat st;
+		  if (stat (p, &st) == 0 && S_ISDIR (st.st_mode))
+		    ldfile_add_library_path (p, cmdline);
+		  free (p);
+		}
+	      free (namelist[i]);
+	    }
+	  free (namelist);
+	}
+      return;
+    }
+
   new_dirs = (search_dirs_type *) xmalloc (sizeof (search_dirs_type));
   new_dirs->next = NULL;
   new_dirs->cmdline = cmdline;
diff -uNr binutils-2.47.orig/ld/sysdep.h binutils-2.47/ld/sysdep.h
--- binutils-2.47.orig/ld/sysdep.h	2026-07-25 19:00:00.000000000 -0400
+++ binutils-2.47/ld/sysdep.h	2026-10-26 20:09:24.502987221 -0400
@@ -34,6 +34,7 @@
 #ifdef HAVE_SYS_STAT_H
 #include <sys/stat.h>
 #endif
+#include <dirent.h>
 #include <stdlib.h>
 #include <string.h>
 #include <stdarg.h>
