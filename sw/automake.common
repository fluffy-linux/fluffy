# Automake at the version a package's release tarball was generated with,
# built from git inside the package's own build to regenerate its
# Makefile.in files.  The recipe lists that version's Fluffy branch in its
# own ARCHIVES, so it is placed as ../automake.tar:
#
#     <commit> https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v<version>
#
# and sources this file; MAKE calls automake_build after autoconf_build
# (its bootstrap runs that autoconf) and before autoreconf.
#
# Building automake from git takes only that autoconf and perl: the
# host's perl in host-build, perl-pass1 in cross-build (a recipe naming
# the final perl gets that instead), the final perl in fluffy-build.  Its
# aclocal searches its own macros, then, through a dirlist, every
# package's /sw/*/share/aclocal.  The man pages, the manual and the
# example tarball are not built.
# It installs into the build's own prefix, never into a package's DESTDIR.

case "$ON" in
    cross-build)
        BUILD_NEEDS+=(
            perl-pass1
            # The helper unpacks its sources with tar.
            tar-pass1
        )
        ;;
    fluffy-build)
        BUILD_NEEDS+=(
            perl
            tar
        )
        ;;
esac

automake_build() {
    local prefix="$PWD/.autotools"
    mkdir -p .autotools-build
    tar -xf ../automake.tar -C .autotools-build
    (
        cd .autotools-build/automake
        ${CONFIG_SHELL:-/bin/sh} ./bootstrap
        ${CONFIG_SHELL:-/bin/sh} ./configure --prefix="$prefix"
        make man1_MANS= INFO_DEPS= dist_doc_DATA=
        make man1_MANS= INFO_DEPS= dist_doc_DATA= DESTDIR= install
    )
    mkdir -p "$prefix/share/aclocal"
    echo '/sw/*/share/aclocal' > "$prefix/share/aclocal/dirlist"
}
