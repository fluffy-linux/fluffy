if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.4.1

# Built straight from Fluffy's branch (our commits on upstream's 4.4.1
# tag): swctl fetches the pinned commit, and the gnulib and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it with the
# autotools make's release tarball was made with, and its translations
# come from the Translation Project's files, merged as the release's
# make dist did.
ARCHIVES=(
    95a4535ef305c0351ee7f6a76a853940229a1fd3 https://github.com/fluffy-linux/make.git#refs/heads/fluffy/$VERSION
    ba484d1863d991a16e8acc5b414bb73eb0ef73bd https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    dc8bbd04db8f65af58d764d70f1c4a168621ffb1 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl
        pkgconf
        sed
        tar-pass1
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        pkgconf
        sed
        tar
        texinfo
    )
fi

# Bootstrapped with the autotools make's release tarball was made with.
# bootstrap runs autopoint, the build xgettext, msgmerge and msgfmt (the
# translations) and makeinfo (the manual), which the release tarball
# ships made.  texinfo comes after make and needs it, so in cross-build
# texinfo-pass1 stands in.  configure.ac checks for guile with
# pkg-config's macros: aclocal takes pkg.m4 from pkgconf.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    # maintMakefile, which git has and the release tarball does not, is
    # the maintainer's: configure would add its -Werror and checks.
    rm maintMakefile
    $CONFIG_SHELL ./configure \
        --prefix=/sw/make
    # The translations as make dist merges them with make.pot.
    make -C po update-po
    # The manual is dated by make.texi's time, as the release's is (git
    # gives every file the commit's).
    touch -d '2023-02-26 12:00 UTC' doc/make.texi
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
