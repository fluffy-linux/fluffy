 static int
+CanUseNativeMultiGlob(
+    const char *pattern,
+    int *hasBracePtr)
+{
+    const char *s;
+    int atStart = 1;
+    int inBrace = 0;
+    int inBracket = 0;
+    int braceAltStart = 0;
+    int braceCommas = 0;
+
+    *hasBracePtr = 0;
+    if (*pattern == '\0') {
+	return 0;
+    }
+    for (s = pattern; *s != '\0'; s++) {
+	if ((unsigned char)*s >= 0x80) {
+	    return 0;
+	}
+	if (atStart) {
+	    if (*s == '.' || *s == '~'
+		    || (*s == '\\' && (s[1] == '.' || s[1] == '~'))) {
+		return 0;
+	    }
+	    if (*s != '{') {
+		atStart = 0;
+	    }
+	}
+	if (braceAltStart) {
+	    if (*s == '}' || *s == ',' || *s == '/'
+		    || *s == '.' || *s == '~'
+		    || (*s == '\\' && (s[1] == '.' || s[1] == '~'))) {
+		return 0;
+	    }
+	    braceAltStart = 0;
+	}
+	if (*s == '\\') {
+	    if (inBracket || s[1] == '\0' || s[1] == '/') {
+		return 0;
+	    }
+	    atStart = 0;
+	    s++;
+	    continue;
+	}
+	if (inBracket) {
+	    if (*s == '{' || *s == '}' || *s == '/' || *s == '-') {
+		return 0;
+	    }
+	    if (*s == '[' && (s[1] == ':' || s[1] == '.' || s[1] == '=')) {
+		return 0;
+	    }
+	    if (*s == ']') {
+		inBracket = 0;
+	    }
+	    continue;
+	}
+	if (*s == '[') {
+	    if (inBrace) {
+		return 0;
+	    }
+	    if (s[1] == '!' || s[1] == '^' || s[1] == ']') {
+		return 0;
+	    }
+	    inBracket = 1;
+	    continue;
+	}
+	if (*s == '{') {
+	    if (inBrace) {
+		return 0;
+	    }
+	    inBrace = 1;
+	    braceAltStart = 1;
+	    braceCommas = 0;
+	    *hasBracePtr = 1;
+	    continue;
+	}
+	if (*s == ',') {
+	    if (inBrace) {
+		braceCommas++;
+		braceAltStart = 1;
+	    }
+	    continue;
+	}
+	if (*s == '}') {
+	    if (!inBrace || braceCommas == 0) {
+		return 0;
+	    }
+	    inBrace = 0;
+	    atStart = 0;
+	    continue;
+	}
+	if (*s == '/') {
+	    if (s[1] == '\0' || s[1] == '/'
+		    || (inBrace && (s[1] == ',' || s[1] == '}'))) {
+		return 0;
+	    }
+	    atStart = 1;
+	}
+    }
+    if (inBrace || inBracket) {
+	return 0;
+    }
+    return 1;
+}
