diff -Naur tcl8.6.18.orig/library/init.tcl tcl8.6.18/library/init.tcl
--- tcl8.6.18.orig/library/init.tcl	2026-07-25 23:00:00.000000000 +0000
+++ tcl8.6.18/library/init.tcl	2026-07-25 23:00:00.000000000 +0000
@@ -66,9 +66,17 @@
 	    lappend ::auto_path $Dir
 	}
 	if {[info exists ::tcl_pkgPath]} { catch {
-	    foreach Dir $::tcl_pkgPath {
-		if {$Dir ni $::auto_path} {
-		    lappend ::auto_path $Dir
+	    foreach Pattern $::tcl_pkgPath {
+		if {[string match {*[[\*\?]*} $Pattern]} {
+		    foreach Dir [glob -nocomplain -types d $Pattern] {
+			if {$Dir ni $::auto_path} {
