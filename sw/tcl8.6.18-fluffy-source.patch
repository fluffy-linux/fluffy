--- tcl8.6.18.orig/generic/tclFileName.c	2026-04-17 18:51:36.000000000 +0000
+++ tcl8.6.18/generic/tclFileName.c	2026-04-17 18:51:36.000000000 +0000
@@ -2064,6 +2064,43 @@
  */
 
 static int
+CanUseNativeMultiGlob(
+    const char *pattern)
+{
+    const char *s;
+    int atStart = 1;
+
+    if (*pattern == '\0') {
+	return 0;
+    }
+    for (s = pattern; *s != '\0'; s++) {
+	if (atStart) {
+	    if (*s == '.' || (*s == '\\' && s[1] == '.')) {
+		return 0;
+	    }
+	    atStart = 0;
+	}
+	if (*s == '\\') {
+	    if (s[1] == '\0' || s[1] == '/') {
+		return 0;
+	    }
+	    s++;
+	    continue;
+	}
+	if (*s == '{' || *s == '}') {
+	    return 0;
+	}
+	if (*s == '/') {
+	    if (s[1] == '\0' || s[1] == '/') {
+		return 0;
+	    }
+	    atStart = 1;
+	}
+    }
+    return 1;
+}
+
+static int
 SkipToChar(
     char **stringPtr,		/* Pointer string to check. */
     int match)			/* Character to find. */
@@ -2306,7 +2343,10 @@
