+static const char *
+scan_path_sep_elem (const char *p)
+{
+  const char *q = p;
+  while (*q != '\0' && *q != PATH_SEPARATOR)
+    {
+      if (PATH_SEPARATOR == ':'
+	  && *q == '\\' && q[1] != '\0' && q[1] != PATH_SEPARATOR
+	  && !IS_DIR_SEPARATOR (q[1]))
+	{
+	  q += 2;
+	  continue;
+	}
+      if (PATH_SEPARATOR == ':' && *q == '[')
+	{
+	  const char *r = q + 1;
+	  if (*r == '!' || *r == '^')
+	    r++;
+	  if (*r == ']')
+	    r++;
+	  bool closed = false;
+	  while (*r != '\0' && !IS_DIR_SEPARATOR (*r))
+	    {
+	      if (*r == '\\' && r[1] != '\0' && !IS_DIR_SEPARATOR (r[1]))
+		{
+		  r += 2;
+		  continue;
+		}
+	      if (*r == '[' && (r[1] == ':' || r[1] == '.' || r[1] == '='))
+		{
+		  char ctype = r[1];
+		  const char *s = r + 2;
+		  while (*s != '\0' && !IS_DIR_SEPARATOR (*s)
+			 && (ctype == '.' || *s != ']')
+			 && !(*s == ctype && s[1] == ']'))
+		    s++;
+		  if (*s == ctype && s[1] == ']')
