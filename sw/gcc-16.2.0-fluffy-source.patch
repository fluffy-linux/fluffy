diff -uNr gcc-16.2.0.orig/gcc/gcc.cc gcc-16.2.0/gcc/gcc.cc
--- gcc-16.2.0.orig/gcc/gcc.cc	2026-08-07 03:46:06.189690306 -0400
+++ gcc-16.2.0/gcc/gcc.cc	2026-10-27 17:38:27.516002711 -0400
@@ -1641,12 +1641,10 @@
 
 /* Default prefixes to attach to command names.  */
 
-#ifndef STANDARD_STARTFILE_PREFIX_1
-#define STANDARD_STARTFILE_PREFIX_1 "/lib/"
-#endif
-#ifndef STANDARD_STARTFILE_PREFIX_2
-#define STANDARD_STARTFILE_PREFIX_2 "/usr/lib/"
-#endif
+#undef STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 ""
+#undef STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 ""
 
 #ifdef CROSS_DIRECTORY_STRUCTURE  /* Don't use these prefixes for a cross compiler.  */
 #undef MD_EXEC_PREFIX
@@ -8658,6 +8656,47 @@
 			      PREFIX_PRIORITY_LAST, 0, 1);
     }
 
+  {
+    struct dirent **namelist;
+    int n = scandir ("/sw", &namelist, NULL, alphasort);
+    if (n >= 0)
+      {
+	for (int i = 0; i < n; i++)
+	  {
+	    if (namelist[i]->d_name[0] != '.')
+	      {
+		struct stat st;
+		char *tbin = concat ("/sw/", namelist[i]->d_name,
+				     dir_separator_str, spec_machine,
+				     "/bin/", NULL);
+		if (stat (tbin, &st) == 0 && S_ISDIR (st.st_mode))
+		  add_prefix (&exec_prefixes, tbin, "BINUTILS",
+			      PREFIX_PRIORITY_LAST, 0, 0);
+		free (tbin);
+
+		if (*cross_compile == '0')
+		  {
+		    char *bin = concat ("/sw/", namelist[i]->d_name,
+					"/bin/", NULL);
+		    if (stat (bin, &st) == 0 && S_ISDIR (st.st_mode))
+		      add_prefix (&exec_prefixes, bin, "BINUTILS",
+				  PREFIX_PRIORITY_LAST, 0, 0);
+		    free (bin);
+		  }
+
+		char *lib = concat ("/sw/", namelist[i]->d_name,
+				    "/lib/", NULL);
+		if (stat (lib, &st) == 0 && S_ISDIR (st.st_mode))
+		  add_prefix (&startfile_prefixes, lib, "BINUTILS",
+			      PREFIX_PRIORITY_LAST, 0, 0);
+		free (lib);
+	      }
+	    free (namelist[i]);
+	  }
+	free (namelist);
+      }
+  }
+
   /* Process any user specified specs in the order given on the command
      line.  */
   for (struct user_specs *uptr = user_specs_head; uptr; uptr = uptr->next)
diff -uNr gcc-16.2.0.orig/gcc/incpath.cc gcc-16.2.0/gcc/incpath.cc
--- gcc-16.2.0.orig/gcc/incpath.cc	2026-08-07 03:46:06.226690881 -0400
+++ gcc-16.2.0/gcc/incpath.cc	2026-10-27 17:38:56.400000000 -0400
@@ -233,8 +233,60 @@
 	    }
 
 	  add_path (str, INC_SYSTEM, p->cxx_aware, false);
+
+	  const char *cxx_suffix = (p->cplusplus
+				    ? strstr (p->fname, "/include/c++/")
+				    : NULL);
+	  if (cxx_suffix != NULL)
+	    {
+	      struct dirent **namelist;
+	      int n = scandir ("/sw", &namelist, NULL, alphasort);
+	      if (n >= 0)
+		{
+		  for (int i = 0; i < n; i++)
+		    {
+		      if (namelist[i]->d_name[0] != '.')
+			{
+			  char *cstr = concat ("/sw/", namelist[i]->d_name,
+					       cxx_suffix, NULL);
+			  if (p->multilib == 1 && imultilib)
+			    cstr = reconcat (cstr, cstr, dir_separator_str,
+					     imultilib, NULL);
+			  struct HOST_STAT_FOR_64BIT_INODES st;
+			  if (HOST_STAT_FOR_64BIT_INODES (cstr, &st) == 0
+			      && S_ISDIR (st.st_mode))
+			    add_path (cstr, INC_SYSTEM, p->cxx_aware, false);
+			  else
+			    free (cstr);
+			}
+		      free (namelist[i]);
+		    }
+		  free (namelist);
+		}
+	    }
 	}
     }
+
+  struct dirent **namelist;
+  int n = scandir ("/sw", &namelist, NULL, alphasort);
+  if (n >= 0)
+    {
+      for (int i = 0; i < n; i++)
+	{
+	  if (namelist[i]->d_name[0] != '.')
+	    {
+	      char *str = concat ("/sw/", namelist[i]->d_name, "/include", NULL);
+	      struct HOST_STAT_FOR_64BIT_INODES st;
+	      if (HOST_STAT_FOR_64BIT_INODES (str, &st) == 0
+		  && S_ISDIR (st.st_mode))
+		add_path (str, INC_SYSTEM, 0, false);
+	      else
+		free (str);
+	    }
+	  free (namelist[i]);
+	}
+      free (namelist);
+    }
 }
 
