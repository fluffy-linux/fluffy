diff -uNr gcc-16.2.0.orig/gcc/configure gcc-16.2.0/gcc/configure
--- gcc-16.2.0.orig/gcc/configure	2026-08-07 07:47:29.994988106 +0000
+++ gcc-16.2.0/gcc/configure	2026-08-07 07:47:29.994988106 +0000
@@ -15282,7 +15282,7 @@
 
 if test x$host != x$target || test "x$TARGET_SYSTEM_ROOT" != x ||
    test x$build != x$host || test "x$with_build_sysroot" != x; then
-  if test "x$with_build_sysroot" != x; then
+  if test "x$with_build_sysroot" != x || test "x$configured_native_system_header_dir" != x; then
     BUILD_SYSTEM_HEADER_DIR=$with_build_sysroot'$${sysroot_headers_suffix}$(NATIVE_SYSTEM_HEADER_DIR)'
   else
     BUILD_SYSTEM_HEADER_DIR='$(CROSS_SYSTEM_HEADER_DIR)'
@@ -15297,7 +15297,7 @@
     SYSTEM_HEADER_DIR='$(CROSS_SYSTEM_HEADER_DIR)'
   fi
 
-  if test "x$with_build_sysroot" != "x"; then
+  if test "x$with_build_sysroot" != "x" || test "x$configured_native_system_header_dir" != x; then
     target_header_dir="${with_build_sysroot}${native_system_header_dir}"
   elif test "x$with_sysroot" = x; then
     target_header_dir="${test_exec_prefix}/${target_noncanonical}/sys-include"
@@ -15319,9 +15319,16 @@
 # This prevents libgcc2 from containing any code which requires libc
 # support.
 : ${inhibit_libc=false}
+inhibit_libc_found_stdio=no
+for f in $target_header_dir/stdio.h; do
+  if test -f "$f"; then
+    inhibit_libc_found_stdio=yes
+    break
+  fi
+done
 if { { test x$host != x$target && test "x$with_sysroot" = x ; } ||
        test x$with_newlib = xyes ; } &&
-     { test "x$with_headers" = xno || test ! -f "$target_header_dir/stdio.h"; } ; then
+     { test "x$with_headers" = xno || test "$inhibit_libc_found_stdio" = no; } ; then
        inhibit_libc=true
 fi
 
