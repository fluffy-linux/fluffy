+/* Add an entry for PREFIX to prefix list PREFIX.
+   Add at beginning if FIRST is true.  */
+
+void
+do_add_prefix (struct path_prefix *pprefix, const char *prefix, bool first)
+{
+  struct stat st;
+  if (stat (prefix, &st) == 0 && S_ISDIR (st.st_mode))
+    {
+      do_add_literal_prefix (pprefix, prefix, first);
+      return;
+    }
+
+  if (strpbrk (prefix, "*?[") != NULL)
+    {
+      glob_t gbuf = {};
+      int gr = glob (prefix, GLOB_ONLYDIR, NULL, &gbuf);
+      if (gr == 0)
+	{
+	  const char sep[2] = { DIR_SEPARATOR, 0 };
+	  for (size_t gi = 0; gi < gbuf.gl_pathc; gi++)
+	    {
+	      size_t idx = first ? (gbuf.gl_pathc - 1 - gi) : gi;
+	      size_t glen = strlen (gbuf.gl_pathv[idx]);
+	      char *dir = (glen > 0
+			   && IS_DIR_SEPARATOR (gbuf.gl_pathv[idx][glen - 1]))
+			  ? xstrdup (gbuf.gl_pathv[idx])
+			  : concat (gbuf.gl_pathv[idx], sep, NULL);
+	      do_add_literal_prefix (pprefix, dir, first);
+	      free (dir);
+	    }
+	}
+      else if (gr == GLOB_NOMATCH)
+	do_add_literal_prefix (pprefix, prefix, first);
+      globfree (&gbuf);
+      return;
+    }
+
+  do_add_literal_prefix (pprefix, prefix, first);
+}
