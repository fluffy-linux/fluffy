diff -uNr gcc-16.2.0.orig/gcc/incpath.cc gcc-16.2.0/gcc/incpath.cc
--- gcc-16.2.0.orig/gcc/incpath.cc	2026-08-07 07:46:06.226690881 +0000
+++ gcc-16.2.0/gcc/incpath.cc	2026-08-07 07:46:06.226690881 +0000
@@ -449,6 +449,25 @@
 void
 add_path (char *path, incpath_kind chain, int cxx_aware, bool user_supplied_p)
 {
+  if (strpbrk (path, "*?[") != NULL)
+    {
+      glob_t gbuf;
+      if (glob (path, 0, NULL, &gbuf) == 0)
+	{
+	  for (size_t gi = 0; gi < gbuf.gl_pathc; gi++)
+	    {
+	      struct HOST_STAT_FOR_64BIT_INODES st;
+	      if (HOST_STAT_FOR_64BIT_INODES (gbuf.gl_pathv[gi], &st) == 0
+		  && S_ISDIR (st.st_mode))
+		add_path (xstrdup (gbuf.gl_pathv[gi]), chain, cxx_aware,
+			  user_supplied_p);
+	    }
+	  globfree (&gbuf);
+	}
+      free (path);
+      return;
+    }
+
   cpp_dir *p;
   size_t pathlen = strlen (path);
 
diff -uNr gcc-16.2.0.orig/gcc/Makefile.in gcc-16.2.0/gcc/Makefile.in
