+#if defined(GLOB_PATHS) && NCURSES_USE_DATABASE
+static const char *
+nc_scan_bracket_end(const char *p)
+{
+    ++p;
+    if (*p == '!' || *p == '^')
+	++p;
+    if (*p == ']')
+	++p;
+    while (*p != '\0' && *p != '/') {
+	if (*p == ']')
+	    return p;
+	if (*p == '[' && (p[1] == ':' || p[1] == '.' || p[1] == '=')) {
+	    char ctype = p[1];
+	    const char *q = p + 2;
+	    while (*q != '\0' && *q != '/' && (ctype == '.' || *q != ']')) {
+		if (*q == ctype && q[1] == ']') {
+		    p = q + 2;
+		    goto next_ch;
+		}
+		++q;
+	    }
+	}
+	++p;
+      next_ch:;
+    }
+    return NULL;
+}
+
+static bool
+append_nul_entry(char **buf, size_t *len, size_t *cap, size_t *count,
+		 const char *src, size_t slen)
+{
+    while (*len + slen + 1 > *cap) {
+	size_t ncap = (*cap == 0) ? 256 : (*cap * 2);
+	char *tmp = realloc(*buf, ncap);
+	if (tmp == NULL)
+	    return FALSE;
+	*buf = tmp;
+	*cap = ncap;
+    }
+    if (slen > 0)
+	memcpy(*buf + *len, src, slen);
+    (*buf)[*len + slen] = '\0';
+    *len += slen + 1;
+    ++(*count);
+    return TRUE;
+}
+
+static char *
+build_db_blob(const char *const values[dbdLAST], size_t *out_blobsize)
+{
+    char *buf = NULL;
+    size_t len = 0;
+    size_t cap = 0;
+    size_t count = 0;
+    int j;
+#ifdef TERMINFO
+    const char *empty_fallback = TERMINFO;
+#else
+    const char *empty_fallback = "";
+#endif
+
+    for (j = 0; j < dbdLAST; ++j) {
+	const char *val = values[j];
+	const char *seg;
+	const char *p;
+	bool do_glob = (j == dbdCfgList || j == dbdEnvList);
+
+	if (val == NULL || *val == '\0')
+	    continue;
+
+	seg = val;
+	p = val;
+	for (;;) {
+	    if (*p == NCURSES_PATHSEP || *p == '\0') {
+		size_t slen = (size_t) (p - seg);
+
+		if (*p == NCURSES_PATHSEP && slen == 3 && quick_prefix(seg)) {
+		    ++p;
+		    continue;
+		}
+
+		if (slen == 0) {
+		    if (!append_nul_entry(&buf, &len, &cap, &count,
+					  empty_fallback,
+					  strlen(empty_fallback))) {
+			free(buf);
+			return NULL;
+		    }
+		} else if (do_glob
+			   && !(slen >= 4 && quick_prefix(seg))
+			   && (memchr(seg, '*', slen) != NULL
+			       || memchr(seg, '?', slen) != NULL
+			       || memchr(seg, '[', slen) != NULL)) {
+		    char *pat = malloc(slen + 1);
+		    glob_t gbuf;
+
+		    if (pat == NULL) {
+			free(buf);
+			return NULL;
+		    }
+		    memcpy(pat, seg, slen);
+		    pat[slen] = '\0';
+		    trim_formatting(pat);
+		    memset(&gbuf, 0, sizeof(gbuf));
+		    if (pat[0] != '\0'
+			&& !quick_prefix(pat)
+			&& strpbrk(pat, "*?[") != NULL
+			&& glob(pat, GLOB_NOESCAPE | GLOB_ONLYDIR | GLOB_NOCHECK,
+				NULL, &gbuf) == 0) {
+			size_t gi;
+			for (gi = 0; gi < gbuf.gl_pathc; ++gi) {
+			    if (!append_nul_entry(&buf, &len, &cap, &count,
+						  gbuf.gl_pathv[gi],
+						  strlen(gbuf.gl_pathv[gi]))) {
+				globfree(&gbuf);
+				free(pat);
+				free(buf);
+				return NULL;
+			    }
+			}
+			globfree(&gbuf);
+			free(pat);
+		    } else {
+			globfree(&gbuf);
+			free(pat);
+			if (!append_nul_entry(&buf, &len, &cap, &count,
+					      seg, slen)) {
+			    free(buf);
+			    return NULL;
+			}
+		    }
+		} else {
+		    if (!append_nul_entry(&buf, &len, &cap, &count,
+					  seg, slen)) {
+			free(buf);
+			return NULL;
+		    }
+		}
+
+		if (*p == '\0')
+		    break;
+		seg = ++p;
+		continue;
+	    }
+
+	    if (do_glob && *p == '['
+		&& !((size_t) (p - seg) >= 4 && quick_prefix(seg))) {
+		const char *bend = nc_scan_bracket_end(p);
+		if (bend != NULL) {
+		    p = bend + 1;
+		    continue;
+		}
+	    }
+
+	    ++p;
+	}
+    }
+
+    if (count == 0) {
+	if (!append_nul_entry(&buf, &len, &cap, &count,
+			      empty_fallback, strlen(empty_fallback))) {
+	    free(buf);
+	    return NULL;
+	}
+    }
+
+    *out_blobsize = count + 1;
+    return buf;
+}
