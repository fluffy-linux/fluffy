diff --no-dereference -Naur which-2.25.orig/tests/which-glob-path.sh which-2.25/tests/which-glob-path.sh
--- which-2.25.orig/tests/which-glob-path.sh	1970-01-01 00:00:00.000000000 +0000
+++ which-2.25/tests/which-glob-path.sh	2026-05-21 16:00:12.000000000 +0000
@@ -0,0 +1,93 @@
+#! /bin/sh
+# Test which's wildcard, bracket-aware, escape-aware and tilde-aware PATH
+# handling.  Every fixture lives under a temporary directory; nothing here
+# depends on the host's own PATH layout.
+#
+# Usage: WHICH=path/to/which $(SHELL) tests/which-glob-path.sh
+
+: "${WHICH:=./which}"
+case $WHICH in /*) ;; *) WHICH="$(pwd)/$WHICH" ;; esac
+td="$(mktemp -d)" || exit 99
+trap 'rm -rf "$td"' EXIT
+fail=0
+
+check () {
+	if test "$2" = "$3"; then
+		echo "PASS: $1"
+	else
+		echo "FAIL: $1: expected '$2', got '$3'"
+		fail=1
+	fi
+}
+
+check_rc () {
+	if test "$2" = "$3"; then
+		echo "PASS: $1"
+	else
+		echo "FAIL: $1: expected exit $2, got $3"
+		fail=1
+	fi
+}
+
+mkexe () {
+	mkdir -p "${1%/*}" && printf 'exit 0\n' >"$1" && chmod 755 "$1"
+}
+
+mkexe "$td/pkg1/bin/fluffytest"
+mkexe "$td/pkg2/bin/fluffytest"
+mkexe "$td/colon:dir/coloncmd"
+mkexe "$td/home[1]/bin/homecmd"
+mkexe "$td/home[1]/pkgs/p1/bin/homewild"
+mkexe "$td/cwd/~pkg/bin/tildestar_cmd"
+mkexe "$td/cwd/localcmd"
+mkdir -p "$td/pkg1/bin" && printf 'exit 0\n' >"$td/pkg1/bin/nonexec"
+mkexe "$td/pkg2/bin/nonexec"
+
+check 'wildcard PATH element' "$td/pkg1/bin/fluffytest" \
+	"$(PATH="$td/*/bin" "$WHICH" fluffytest)"
+check 'POSIX class with ":" is not split' "$td/pkg1/bin/fluffytest" \
+	"$(PATH="$td/[[:alpha:]]*/bin" "$WHICH" fluffytest)"
+check 'bracket expression in PATH element' "$td/pkg1/bin/fluffytest" \
+	"$(PATH="$td/pk[g]1/bin" "$WHICH" fluffytest)"
+check 'unclosed class stays one element' "$td/pkg1/bin/fluffytest" \
+	"$(PATH="[[:alpha]:$td/pkg1/bin" "$WHICH" fluffytest)"
+check '-a lists every match of every element' 4 \
+	"$(PATH="$td/*/bin:$td/*/bin" "$WHICH" -a fluffytest | wc -l | tr -d ' ')"
+check 'non-executable match is skipped' "$td/pkg2/bin/nonexec" \
+	"$(PATH="$td/*/bin" "$WHICH" nonexec)"
+check 'escaped ":" inside an element' "$td/colon:dir/coloncmd" \
+	"$(PATH="$td/colon\\:dir:$td/*/bin" "$WHICH" coloncmd)"
+
+cd "$td/cwd" || exit 99
+check 'empty PATH means the current directory' ./localcmd \
+	"$(PATH='' "$WHICH" --show-dot localcmd)"
+check 'escaped "." element' ./localcmd \
+	"$(PATH="\\.:$td/*/bin" "$WHICH" --show-dot localcmd)"
+check 'leading empty element' ./localcmd \
+	"$(PATH=":$td/*/bin" "$WHICH" --show-dot localcmd)"
+check 'middle empty element' ./localcmd \
+	"$(PATH="$td/*/bin::$td/pkg2/bin" "$WHICH" --show-dot localcmd)"
+check 'trailing empty element' ./localcmd \
+	"$(PATH="$td/*/bin:" "$WHICH" --show-dot localcmd)"
+check 'unexpanded "~*" element is a glob, not a tilde' \
+	"$td/cwd/~pkg/bin/tildestar_cmd" \
+	"$(PATH='~*/bin' "$WHICH" tildestar_cmd)"
+cd "$td" || exit 99
+
+check 'tilde with metacharacters in HOME' "$td/home[1]/bin/homecmd" \
+	"$(HOME="$td/home[1]" PATH="~/bin:$td/*/bin" "$WHICH" homecmd)"
+check 'wildcard after an expanded tilde' "$td/home[1]/pkgs/p1/bin/homewild" \
+	"$(HOME="$td/home[1]" PATH="~/*/p1/bin" "$WHICH" homewild)"
+
+rc=0
+HOME="$td/home[1]" PATH="~/bin:$td/*/bin" "$WHICH" --skip-tilde homecmd \
+	>/dev/null 2>&1 || rc=$?
+check_rc '--skip-tilde ignores tilde elements' 1 "$rc"
+rc=0
+PATH="$td/*/bin" "$WHICH" definitely_missing_cmd >/dev/null 2>&1 || rc=$?
+check_rc 'missing command' 1 "$rc"
+rc=0
+env -u PATH "$WHICH" "$WHICH" definitely_missing_cmd >/dev/null 2>&1 || rc=$?
+check_rc 'unset PATH still reports the missing command' 1 "$rc"
+
+exit $fail
