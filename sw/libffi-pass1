ON=host-build

VERSION=3.8.0

HAS_LDFLAGS=-lffi

ARCHIVES=(
    7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4 https://github.com/fluffy-linux/libffi/releases/download/v$VERSION/libffi-$VERSION.tar.gz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/libffi \
        --host=$FLUFFY_TGT \
        --build=$(./config.guess) \
        --disable-static \
        --disable-multi-os-directory
    make
}

INSTALL() {
    make install
    rm -v $DESTDIR/sw/libffi/lib/libffi.la
}
