if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.0.3

ARCHIVES=(
    91eb74caed0ee6655b669711a4f350c25579778694df248e28363318e03c7fc4 https://github.com/gavinhoward/bc/releases/download/$VERSION/bc-$VERSION.tar.xz
    08b81ba97528fc70ef02a3afc7a07f551180ac0a3e3839e1ca557ebdfe766eb5 file://bc-$VERSION-fluffy-shell.patch
    fd4efad468a1d66ab2ae8b31fed9c8c012743c8d698e8e9aa17b038059522dd8 file://bc-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        patch-pass1
        readline
        sed-pass1
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        patch
        readline
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i bc-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i bc-$VERSION-fluffy-test.patch
    CC='gcc -std=c99' \
    ./configure \
        --prefix=/sw/bc \
        -G \
        -O3 \
        -r
    make
}

CHECK() {
    make test
}

INSTALL() {
    make install
}
