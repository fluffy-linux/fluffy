if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.0.3

# Built straight from Fluffy's branch (our commits on upstream's 7.0.3
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    bcf67880b211a93629ce28972efd2b60d6295d90 https://github.com/fluffy-linux/bc.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses-pass1
        readline
        sed-pass1
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        readline
        sed
        tar
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CC='gcc -std=c99' \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/bc \
        -G \
        -O3 \
        -r
    make
}

CHECK() {
    make test
}

INSTALL() {
    make install
}
