ON=host-build

VERSION=2.44

ARCHIVES=(
    37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667 https://ftpmirror.gnu.org/glibc/glibc-$VERSION.tar.xz
    643552db030e2f2d7ffde4f558e0f5f83d3fabf34a2e0e56ebdb49750ac27b0d https://www.linuxfromscratch.org/patches/lfs/13.1/glibc-fhs-1.patch
    aa7dc37d87cd1c3cd5edd70755415c3cc50c0165752cd519a58df225e9f66bdc file://glibc-$VERSION-fluffy-shell.patch
    0cdf93afa2e8a393267bf69bdd32228ccac6b27398c38f7103cd1653e6f71524 file://glibc-$VERSION-fluffy-source.patch
    00c0f87b819b43ae62316ad847bbec8e437133a74e6c8f7730a327508c0af5ba file://glibc-$VERSION-fluffy-test.patch
)

MAKE_NEEDS=(
    gcc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i glibc-fhs-1.patch
    patch -Z -Np1 -i glibc-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i glibc-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i glibc-$VERSION-fluffy-test.patch

    mkdir -v build
    cd build
    echo "rootsbindir=/sw/glibc/bin" > configparms

    ../configure \
        --prefix=/sw/glibc \
        --host=$FLUFFY_TGT \
        --build=$(../scripts/config.guess) \
        --disable-nscd \
        libc_cv_slibdir=/sw/glibc/lib \
        --enable-kernel=5.4
    make
}

INSTALL_NEEDS=(
    gcc-pass1
    linux-headers
)

INSTALL() {
    cd build
    make install
    sed '/RTLDLIST/s@/usr@@g' -i $DESTDIR/sw/glibc/bin/ldd
}
