ON=host-build

VERSION=2.44

ARCHIVES=(
    37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667 https://ftpmirror.gnu.org/glibc/glibc-$VERSION.tar.xz
    643552db030e2f2d7ffde4f558e0f5f83d3fabf34a2e0e56ebdb49750ac27b0d https://www.linuxfromscratch.org/patches/lfs/13.1/glibc-fhs-1.patch
    4b63488e050692d873aa99ceda2c36e902f2feebff0cbea4d9ab938ffcdc9d6e file://glibc-$VERSION-fluffy.patch
)

MAKE_NEEDS=(gcc-pass1 linux-headers)

MAKE() {
    patch -Np1 -i glibc-fhs-1.patch
    patch -Np1 -i glibc-$VERSION-fluffy.patch

    mkdir -v build
    cd build
    echo "rootsbindir=/sw/glibc/bin" > configparms

    ../configure \
        --prefix=/sw/glibc \
        --host=$FLUFFY_TGT \
        --build=$(../scripts/config.guess) \
        --disable-nscd \
        libc_cv_slibdir=/sw/glibc/lib \
        --enable-kernel=5.4
    make
}

INSTALL_NEEDS=(gcc-pass1 linux-headers)

INSTALL() {
    cd build
    make install
    sed '/RTLDLIST/s@/usr@@g' -i $DESTDIR/sw/glibc/bin/ldd
}
