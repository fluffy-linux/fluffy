if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=32

# Built straight from Fluffy's branch (our commit on upstream's v32
# tag): swctl fetches the pinned commit, and the libwaive commit it pins,
# with git.  The tag is the release, apart from git's own files.
ARCHIVES=(
    367a783d000e14bb1400662bf9ac0b2c8dfd40c3 https://github.com/fluffy-linux/signify.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        gcc
        glibc
        libgcc
        linux-headers
        make-pass1
        sed
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        make
        sed
    )
fi

# Not in LFS or BLFS.  Fluffy signs nothing yet; it will sign and check
# published fstabs once there are downloads, so no cross build needs it.
MAKE() {
    make CC=gcc BUNDLED_LIBBSD=1 EXTRA_CFLAGS="-D_GNU_SOURCE" VERIFY_ONLY=0
}

INSTALL() {
    mkdir -pv $DESTDIR/sw/signify/bin
    cp -v signify $DESTDIR/sw/signify/bin/signify
}
