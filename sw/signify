if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=32

ARCHIVES=(
    6dd1b97fd9273d268b70c1be3c2592cbbe1488bca5e45c12c58f8c74362758d5 https://github.com/fluffy-linux/signify/releases/download/v$VERSION/signify-$VERSION.tar.xz
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        gcc
        glibc
        libgcc
        linux-headers
        make-pass1
        sed
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        make
        sed
    )
fi

# Not in LFS or BLFS.  Fluffy signs nothing yet; it will sign and check
# published fstabs once there are downloads, so no cross build needs it.
MAKE() {
    make CC=gcc BUNDLED_LIBBSD=1 EXTRA_CFLAGS="-D_GNU_SOURCE" VERIFY_ONLY=0
}

INSTALL() {
    mkdir -pv $DESTDIR/sw/signify/bin
    cp -v signify $DESTDIR/sw/signify/bin/signify
}
