ON=cross-build

VERSION=4.0.1

# Built straight from Fluffy's branch (our commits on upstream's 4.0.1
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    c89925960a9606d9322fcc90b42b5addc3e9ec5b https://github.com/fluffy-linux/mpdecimal.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
    make-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make SHELL=/sw/bash/bin/bash
}

INSTALL() {
    make SHELL=/sw/bash/bin/bash install
}
