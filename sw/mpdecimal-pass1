ON=cross-build

VERSION=4.0.1

HAS_LDFLAGS=-lmpdec

ARCHIVES=(
    96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8 https://github.com/fluffy-linux/mpdecimal/releases/download/$VERSION/mpdecimal-$VERSION.tar.gz
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make SHELL=/sw/bash/bin/bash
}

INSTALL() {
    make SHELL=/sw/bash/bin/bash install
}
