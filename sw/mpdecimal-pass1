VERSION=4.0.1

ARCHIVES=(
    96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8 https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$VERSION.tar.gz
    62f965f3da3a3c257a4a4c4c34c75951294dcec5682041caab397feb4ba0166c file://mpdecimal-$VERSION-fluffy.patch
)

NEEDS=(glibc-pass1)
MAKE_NEEDS=(bash-pass1 binutils-pass2 coreutils-pass1 diffutils-pass1 findutils-pass1 gawk-pass1 gcc-pass2 glibc-pass1 grep-pass1 gzip-pass1 linux-headers make-pass1 patch-pass1 sed-pass1 tar-pass1 xz-pass1)

MAKE() {
    patch -Np1 -i mpdecimal-$VERSION-fluffy.patch
    CONFIG_SHELL=/sw/bash/bin/bash ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make SHELL=/sw/bash/bin/bash
}

INSTALL_NEEDS=(bash-pass1 binutils-pass2 coreutils-pass1 make-pass1 sed-pass1)

INSTALL() {
    make SHELL=/sw/bash/bin/bash install
}
