if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.0.3

ARCHIVES=(
    722695808f4b6457b320fdc131280796bdceb04ab50fe1795cd540799ebe1698 https://pypi.org/packages/source/M/MarkupSafe/markupsafe-$VERSION.tar.gz
)

NEEDS=(
    glibc
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        python
        setuptools
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        python
        setuptools
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/markupsafe markupsafe
}
