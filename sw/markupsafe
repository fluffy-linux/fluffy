if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.0.3

# Built straight from Fluffy's branch (upstream's 3.0.3 tag; Fluffy has no
# commits on it): swctl fetches the pinned commit with git.
ARCHIVES=(
    297fc8e356e6836a62087949245d09a28e9f1b13 https://github.com/fluffy-linux/markupsafe.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        python
        setuptools
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        python
        setuptools
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/markupsafe markupsafe
}
