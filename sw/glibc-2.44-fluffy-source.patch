+/* Scan from CP up to END looking for the next top-level ':' (outside
+   brackets, extglob parens, and balanced braces under GLOB_BRACE).
+   Returns pointer to ':' or END.  */
+static const char *
+next_colon_sub (const char *cp, const char *end, int flags)
+{
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+
+  while (cp < end && *cp != '\0')
+    {
+      if (quote && *cp == '\\')
+        {
+          ++cp;
+          if (cp < end && *cp != '\0')
+            ++cp;
+        }
+      else if (*cp == '[')
+        {
+          const char *p = cp + 1;
+          if (p < end && (*p == '!' || *p == '^'))
+            ++p;
+          if (p < end && *p == ']')
+            ++p;
+          while (p < end && *p != '\0' && *p != '/' && *p != ']')
+            {
+              if (quote && *p == '\\' && p + 1 < end && p[1] != '/')
+                ++p;
+              else if (p[0] == '['
+                       && (p[1] == ':' || p[1] == '.' || p[1] == '='))
+                {
+                  char type = p[1];
+                  const char *t = p + 2;
+                  while (t < end && *t != '\0' && *t != '/'
+                         && (type == '.' || *t != ']'))
+                    {
+                      if (*t == type && t + 1 < end && t[1] == ']')
+                        {
+                          p = t + 1;
+                          break;
+                        }
+                      ++t;
+                    }
+                }
+              ++p;
+            }
+          if (p < end && *p == ']')
+            cp = p + 1;
+          else
+            ++cp;
+        }
