+/* Recognize an absolute "<prefix>/<star>/<subpath>" directory pattern (where
+   CP has length LEN >= 3 and ends with '/') with no secondary wildcards.  */
+static bool
+dl_parse_pkg_wildcard (const char *cp, size_t len,
+		       uint16_t *out_parent_len,
+		       uint16_t *out_prefix_slash_len,
+		       uint16_t *out_suffix_off)
+{
+  if (len < 3 || len >= PATH_MAX || cp[0] != '/' || cp[len - 1] != '/')
+    return false;
+  const char *star = memchr (cp, '*', len);
+  if (star == NULL || star == cp || star[-1] != '/'
+      || star + 1 >= cp + len || star[1] != '/')
+    return false;
+  size_t suffix_off = (size_t) ((star + 1) - cp);
+  if (memchr (cp + suffix_off, '*', len - suffix_off) != NULL
+      || memchr (cp, '?', len) != NULL
+      || memchr (cp, '[', len) != NULL)
+    return false;
+
+  size_t parent_len = (star - 1 == cp) ? 1 : (size_t) ((star - 1) - cp);
+  size_t prefix_slash_len = (size_t) (star - cp);
+  *out_parent_len = (uint16_t) parent_len;
+  *out_prefix_slash_len = (uint16_t) prefix_slash_len;
+  *out_suffix_off = (uint16_t) suffix_off;
+  return true;
+}
