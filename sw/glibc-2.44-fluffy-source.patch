+	    {
+	      for (ssize_t bpos = 0; bpos < nread; )
+		{
+		  struct dirent64 *d = (struct dirent64 *) (dent_buf + bpos);
+		  bpos += d->d_reclen;
+		  if (d->d_name[0] == '.')
+		    continue;
+		  if (d->d_type != DT_DIR && d->d_type != DT_LNK
+		      && d->d_type != DT_UNKNOWN)
+		    continue;
+		  size_t namelen = strlen (d->d_name);
+		  if (namelen == 0 || namelen > NAME_MAX)
+		    continue;
+		  size_t full_len = prefix_slash_len + namelen + suffix_len;
+		  size_t prev_pool = pool_ar->used;
+		  char *p = dl_arena_alloc (pool_ar, full_len + 1, 1);
+		  if (p == NULL)
+		    continue;
+		  memcpy (p, pat, prefix_slash_len);
+		  memcpy (p + prefix_slash_len, d->d_name, namelen);
+		  memcpy (p + prefix_slash_len + namelen, suffix, suffix_len);
+		  p[full_len] = '\0';
+
+		  struct __stat64_t64 st;
+		  if (__stat64_time64 (p, &st) == 0 && S_ISDIR (st.st_mode))
+		    {
+		      struct dl_str_slice *sl
+			= dl_arena_alloc (refs_ar, sizeof (*sl),
+					  _Alignof (struct dl_str_slice));
+		      if (sl == NULL)
+			{
+			  pool_ar->used = prev_pool;
+			  continue;
+			}
+		      sl->off = (uint32_t) prev_pool;
+		      sl->len = (uint32_t) full_len;
+
+		      struct dl_str_slice *arr
+			= (struct dl_str_slice *) (void *) refs_ar->base;
+		      size_t pos
+			= (refs_ar->used / sizeof (struct dl_str_slice)) - 1;
+		      const char *pool = (const char *) pool_ar->base;
+		      while (pos > batch_start
+			     && strcmp (pool + arr[pos - 1].off,
+					pool + arr[pos].off) > 0)
+			{
+			  struct dl_str_slice tmp = arr[pos];
+			  arr[pos] = arr[pos - 1];
+			  arr[pos - 1] = tmp;
+			  --pos;
+			}
+		    }
+		  else
+		    pool_ar->used = prev_pool;
+		}
+	    }
+	  __close_nocancel_nostatus (dir_fd);
+	}
+      dl_arena_free (&tmp_ar);
+    }
+}
