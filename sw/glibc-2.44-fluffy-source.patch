+/* Open candidate "<DIR_PREFIX[0..DIR_LEN)><capstr[CNT]><NAME>" via open_verify,
+   applying __RTLD_SECURE SUID checks and recording fatal errors on existing
+   directories.  */
+static int
+open_verify_in_dir (char *buf, const char *dir_prefix, size_t dir_len,
+		    size_t cnt, const char *name, size_t namelen,
+		    int mode, struct filebuf *fbp, struct link_map *loader,
+		    int whatcode, bool *found_other_class,
+		    size_t *out_buflen, bool *out_fatal_err)
+{
+  char *edp = (char *) __mempcpy (buf, dir_prefix, dir_len);
+  size_t buflen;
+#ifdef SHARED
+  buflen = ((char *) __mempcpy (__mempcpy (edp, capstr[cnt].str,
+					   capstr[cnt].len),
+				name, namelen)
+	    - buf);
+#else
+  (void) cnt;
+  buflen = (char *) __mempcpy (edp, name, namelen) - buf;
+#endif
+
+  if (__glibc_unlikely (GLRO(dl_debug_mask) & DL_DEBUG_LIBS))
+    _dl_debug_printf ("  trying file=%s\n", buf);
