+  uint16_t name_len;
+  uint8_t d_type;
+  uint8_t child_dir_flags;
+  uint32_t child_dir_idx;
+};
+
+/* Anonymous mmap dynamic buffer (never touches malloc/free).  */
+struct fswc_arena
+{
+  uint8_t *base;
+  size_t used;
+  size_t cap;
+};
+
+static inline uint64_t
+fswc_align8 (uint64_t v)
+{
+  return (v + 7ULL) & ~7ULL;
+}
+
+static inline uint64_t
+fswc_pack_dev (uint32_t maj, uint32_t min)
+{
+  return ((uint64_t) maj << 32) | (uint64_t) min;
+}
+
+static void *
+fswc_sys_mmap_anon (size_t sz)
+{
+  size_t aligned = (sz + 4095ULL) & ~4095ULL;
+  if (aligned == 0)
+    aligned = 4096;
+#ifdef __NR_mmap2
+  long r = INTERNAL_SYSCALL_CALL (mmap2, NULL, aligned,
+                                  PROT_READ | PROT_WRITE,
+                                  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+#else
+  long r = INTERNAL_SYSCALL_CALL (mmap, NULL, aligned,
+                                  PROT_READ | PROT_WRITE,
+                                  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+#endif
+  if (INTERNAL_SYSCALL_ERROR_P (r))
+    return NULL;
+  return (void *) r;
+}
+
+static void *
+fswc_sys_mmap_fd (int fd, size_t sz)
+{
+  if (sz == 0)
+    return NULL;
+#ifdef __NR_mmap2
+  long r = INTERNAL_SYSCALL_CALL (mmap2, NULL, sz, PROT_READ,
+                                  MAP_SHARED, fd, 0);
+#else
+  long r = INTERNAL_SYSCALL_CALL (mmap, NULL, sz, PROT_READ,
+                                  MAP_SHARED, fd, 0);
+#endif
+  if (INTERNAL_SYSCALL_ERROR_P (r))
+    return NULL;
+  return (void *) r;
+}
+
+static void
+fswc_sys_munmap (void *p, size_t sz)
+{
+  if (p != NULL && sz > 0)
+    {
+      size_t aligned = (sz + 4095ULL) & ~4095ULL;
+      INTERNAL_SYSCALL_CALL (munmap, p, aligned);
+    }
+}
+
+static void
+fswc_arena_init (struct fswc_arena *a)
+{
+  a->base = NULL;
+  a->used = 0;
+  a->cap = 0;
+}
+
+static void
+fswc_arena_free (struct fswc_arena *a)
+{
+  if (a->base != NULL)
+    fswc_sys_munmap (a->base, a->cap);
+  a->base = NULL;
+  a->used = 0;
+  a->cap = 0;
+}
+
+static void *
+fswc_arena_alloc (struct fswc_arena *a, size_t len, size_t align)
+{
+  size_t mask = align > 1 ? align - 1 : 0;
+  size_t off = (a->used + mask) & ~mask;
+  size_t end;
+  if (__builtin_add_overflow (off, len, &end))
+    return NULL;
+  if (end > a->cap)
+    {
+      size_t new_cap = a->cap == 0 ? 65536 : a->cap;
+      while (new_cap < end)
+        {
+          if (new_cap > (SIZE_MAX >> 1))
+            return NULL;
+          new_cap <<= 1;
+        }
+      new_cap = (new_cap + 4095ULL) & ~4095ULL;
+      uint8_t *nb = fswc_sys_mmap_anon (new_cap);
+      if (nb == NULL)
+        return NULL;
+      if (a->used > 0)
+        memcpy (nb, a->base, a->used);
+      if (a->base != NULL)
+        fswc_sys_munmap (a->base, a->cap);
+      a->base = nb;
+      a->cap = new_cap;
+    }
+  a->used = end;
+  return a->base + off;
+}
+
+/* Persistent bump allocator protected by GL(dl_fswc_state).lock for
+   immortal struct fswc_slot_snap & canonical prefix strings.  */
+static void *
+fswc_perm_alloc_locked (size_t len, size_t align)
+{
+  struct fswc_state *st = &GL (dl_fswc_state);
+  size_t mask = align > 1 ? align - 1 : 0;
+  uintptr_t cur = (uintptr_t) st->perm_cur;
+  uintptr_t aligned = (cur + mask) & ~(uintptr_t) mask;
+  size_t pad = (size_t) (aligned - cur);
+  if (st->perm_rem < pad || st->perm_rem - pad < len)
+    {
+      size_t alloc_sz = len + align < 16384 ? 16384 : ((len + align + 4095ULL) & ~4095ULL);
+      uint8_t *page = fswc_sys_mmap_anon (alloc_sz);
+      if (page == NULL)
+        return NULL;
+      st->perm_cur = page;
+      st->perm_rem = alloc_sz;
+      cur = (uintptr_t) st->perm_cur;
+      aligned = (cur + mask) & ~(uintptr_t) mask;
+      pad = (size_t) (aligned - cur);
+    }
+  st->perm_cur += pad + len;
+  st->perm_rem -= pad + len;
+  return (void *) aligned;
+}
+
+/* Fast 64-bit / 128-bit mixing & hashing.  */
+static inline uint64_t
+fswc_mix64 (uint64_t x)
+{
+  x ^= x >> 30;
+  x *= 0xbf58476d1ce4e5b9ULL;
+  x ^= x >> 27;
+  x *= 0x94d049bb133111ebULL;
+  x ^= x >> 31;
+  return x;
+}
+
+#define FSWC_HASH_INIT_LO 0x243f6a8885a308d3ULL
+#define FSWC_HASH_INIT_HI 0x13198a2e03707344ULL
+
+static void
+fswc_hash128_update (uint64_t *lo, uint64_t *hi, const void *data, size_t len)
+{
+  const uint8_t *p = (const uint8_t *) data;
+  uint64_t h1 = *lo;
+  uint64_t h2 = *hi;
+  while (len >= 8)
+    {
+      uint64_t w;
+      memcpy (&w, p, 8);
+      h1 = fswc_mix64 (h1 ^ w);
+      h2 = fswc_mix64 (h2 + h1 + 0x9e3779b97f4a7c15ULL);
+      p += 8;
+      len -= 8;
+    }
+  if (len > 0)
+    {
+      uint64_t tail = (uint64_t) len << 56;
+      for (size_t i = 0; i < len; ++i)
+        tail |= (uint64_t) p[i] << (i * 8);
+      h1 = fswc_mix64 (h1 ^ tail);
+      h2 = fswc_mix64 (h2 + h1 + 0x517cc1b727220a95ULL);
+    }
+  *lo = h1;
+  *hi = h2;
+}
+
+static inline uint64_t
+fswc_key_hash (uint32_t parent_vdir_id, const char *name, size_t name_len)
+{
+  uint64_t h = fswc_mix64 (0x9e3779b97f4a7c15ULL
+                           ^ ((uint64_t) parent_vdir_id << 32)
+                           ^ (uint64_t) name_len);
+  const uint8_t *p = (const uint8_t *) name;
+  size_t rem = name_len;
+  while (rem >= 8)
+    {
+      uint64_t w;
+      memcpy (&w, p, 8);
+      h = fswc_mix64 (h ^ w);
+      p += 8;
+      rem -= 8;
+    }
+  if (rem > 0)
+    {
+      uint64_t tail = 0;
+      for (size_t i = 0; i < rem; ++i)
+        tail |= (uint64_t) p[i] << (i * 8);
+      h = fswc_mix64 (h ^ tail);
+    }
+  return h == 0 ? 1ULL : h;
+}
+
+/* Format unsigned integers & hex without stdio/PLT.  */
+static char *
+fswc_fmt_u64_dec (char *dst, uint64_t v)
+{
+  char tmp[24];
+  size_t n = 0;
+  do
+    {
+      tmp[n++] = (char) ('0' + (v % 10));
+      v /= 10;
+    }
+  while (v != 0);
+  while (n > 0)
+    *dst++ = tmp[--n];
+  *dst = '\0';
+  return dst;
+}
+
+static char *
+fswc_fmt_hex16 (char *dst, uint64_t v)
+{
+  static const char hex[16] = "0123456789abcdef";
+  for (int i = 15; i >= 0; --i)
+    {
+      dst[i] = hex[v & 0xf];
+      v >>= 4;
+    }
+  dst[16] = '\0';
+  return dst + 16;
+}
+
+static inline uint32_t
+fswc_clamp_ms32 (uint64_t sec, uint64_t nsec)
+{
+  uint32_t ms = (uint32_t) (sec * 1000ULL + (nsec / 1000000ULL));
+  return ms == 0 ? 1u : ms;
+}
+
+static uint32_t
+fswc_now_coarse_ms (void)
+{
+#ifdef HAVE_CLOCK_GETTIME64_VSYSCALL
+  int (*vdso_time64) (clockid_t, struct __timespec64 *)
+    = GLRO (dl_vdso_clock_gettime64);
+  if (vdso_time64 != NULL)
+    {
+      struct __timespec64 ts64;
+      if (INTERNAL_VSYSCALL_CALL (vdso_time64, 2, CLOCK_MONOTONIC_COARSE,
+                                  &ts64) == 0)
+        return fswc_clamp_ms32 ((uint64_t) ts64.tv_sec,
+                                (uint64_t) ts64.tv_nsec);
+    }
+#endif
+#ifdef HAVE_CLOCK_GETTIME_VSYSCALL
+  int (*vdso_time) (clockid_t, struct timespec *)
+    = GLRO (dl_vdso_clock_gettime);
+  if (vdso_time != NULL)
+    {
+      struct timespec ts;
+      if (INTERNAL_VSYSCALL_CALL (vdso_time, 2, CLOCK_MONOTONIC_COARSE,
+                                  &ts) == 0)
+        return fswc_clamp_ms32 ((uint64_t) ts.tv_sec, (uint64_t) ts.tv_nsec);
+    }
+#endif
+#ifdef __NR_clock_gettime64
+  {
+    struct __timespec64 ts64;
+    if (INTERNAL_SYSCALL_CALL (clock_gettime64, CLOCK_MONOTONIC_COARSE,
+                               &ts64) == 0)
+      return fswc_clamp_ms32 ((uint64_t) ts64.tv_sec, (uint64_t) ts64.tv_nsec);
+  }
+#endif
+  {
+    struct timespec ts;
+    if (INTERNAL_SYSCALL_CALL (clock_gettime, CLOCK_MONOTONIC_COARSE,
+                               &ts) == 0)
+      return fswc_clamp_ms32 ((uint64_t) ts.tv_sec, (uint64_t) ts.tv_nsec);
+  }
+  return 1u;
+}
+
+/* Cross-DSO futex lock in GL(dl_fswc_state).lock.  */
+static void
+fswc_lock_acquire (void)
+{
+  uint32_t *lp = &GL (dl_fswc_state).lock;
+  uint32_t c = 0;
+  if (atomic_compare_exchange_acquire (lp, &c, 1))
+    return;
+  if (c != 2)
+    c = atomic_exchange_acquire (lp, 2);
+  while (c != 0)
+    {
+      lll_futex_wait (lp, 2, LLL_PRIVATE);
+      c = atomic_exchange_acquire (lp, 2);
+    }
+}
+
+static void
+fswc_lock_release (void)
+{
+  uint32_t *lp = &GL (dl_fswc_state).lock;
+  if (atomic_exchange_release (lp, 0) == 2)
+    lll_futex_wake (lp, 1, LLL_PRIVATE);
+}
+
+void
+__fswc_fork_lock_parent (void)
+{
+  fswc_lock_acquire ();
+}
+
+void
+__fswc_fork_unlock_parent (void)
+{
+  fswc_lock_release ();
+}
+
+void
+__fswc_fork_child (void)
+{
+  atomic_store_relaxed (&GL (dl_fswc_state).lock, 0);
+}
+
+void
+__fswc_invalidate (void)
+{
+  atomic_fetch_add_release (&GL (dl_fswc_state).inval_gen, 1);
+}
+
+void
+__fswc_init (void)
+{
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (atomic_load_acquire (&st->init_state) != 0)
+    return;
+
+  int32_t mode = TUNABLE_GET_FULL (glibc, fswc, mode, int32_t, NULL);
+  size_t max_inodes = TUNABLE_GET_FULL (glibc, fswc, max_inodes, size_t, NULL);
+
+  uint32_t euid = (uint32_t) INTERNAL_SYSCALL_CALL (geteuid);
+  uint32_t ruid = (uint32_t) INTERNAL_SYSCALL_CALL (getuid);
+  if (__libc_enable_secure && !(euid == 0 && ruid == 0))
+    mode = 0;
+  if (mode < 0 || mode > 2)
+    mode = 1;
+
+  st->mode = mode;
+  st->max_inodes = max_inodes;
+  st->init_euid = euid;
+  st->init_ruid = ruid;
+  atomic_store_release (&st->init_state, 1);
+
+#ifndef SHARED
+  /* In static binaries, pre-warm any <prefix>/<star>/<subpath> in _PATH_DEFPATH
+     if present so mode=2 negative filtering and vfork+execvp work immediately. */
+  if (mode > 0)
+    {
+      const char *dp = _PATH_DEFPATH;
+      while (*dp != '\0')
+        {
+          const char *end = dp;
+          while (*end != '\0' && *end != ':')
+            ++end;
+          if (end - dp >= 4 && dp[0] == '/')
+            {
+              for (const char *s = dp + 1; s + 2 <= end; ++s)
+                if (s[0] == '/' && s[1] == '*' && (s + 2 == end || s[2] == '/'))
+                  {
+                    uint16_t sidx;
+                    struct fswc_slot_snap *snap;
+                    __fswc_acquire_slot (dp, (size_t) (s - dp), &sidx, &snap);
+                    break;
+                  }
+            }
+          dp = (*end == ':') ? end + 1 : end;
+        }
+    }
+#endif
+}
+
+/* Validate blob bounds with 64-bit overflow-checked arithmetic.  */
+static bool
+fswc_check_section (uint64_t total_size, uint32_t off, uint64_t count,
+                    uint64_t elem_sz)
+{
+  if ((off & 7u) != 0 || (uint64_t) off > total_size)
+    return false;
+  uint64_t bytes;
+  if (__builtin_mul_overflow (count, elem_sz, &bytes))
+    return false;
+  return bytes <= total_size - (uint64_t) off;
+}
+
+static inline bool
+fswc_valid_str_ent (const char *strtab, uint32_t strtab_size,
+                    uint32_t name_off, uint16_t name_len)
+{
+  if (name_len == 0 || name_len > NAME_MAX
+      || (uint64_t) name_off + name_len >= strtab_size
+      || strtab[name_off + name_len] != '\0')
+    return false;
+  const char *s = strtab + name_off;
+  if ((name_len == 1 && s[0] == '.')
+      || (name_len == 2 && s[0] == '.' && s[1] == '.'))
+    return false;
+  for (uint16_t i = 0; i < name_len; ++i)
+    if (s[i] == '\0' || s[i] == '/')
+      return false;
+  return true;
+}
+
+static bool
+fswc_validate_blob (const void *map, size_t map_size, struct fswc_view *out)
+{
+  if (map == NULL || map_size < sizeof (struct fswc_header)
+      || map_size > FSWC_BLOB_MAX_SIZE)
+    return false;
+
+  const struct fswc_header *hdr = (const struct fswc_header *) map;
+  if (hdr->magic != FSWC_BLOB_MAGIC
+      || hdr->version != FSWC_BLOB_VERSION
+      || hdr->total_size != (uint64_t) map_size
+      || hdr->num_pkgs == 0
+      || hdr->num_pkgs > FSWC_MAX_PKGS
+      || hdr->num_vdirs == 0
+      || hdr->ht_mask < 15u
+      || ((hdr->ht_mask + 1u) & hdr->ht_mask) != 0
+      || hdr->strtab_size < 1u)
+    return false;
+
+  uint64_t ht_cap = (uint64_t) hdr->ht_mask + 1ULL;
+  if (!fswc_check_section (hdr->total_size, hdr->pkgs_off, hdr->num_pkgs,
+                           sizeof (struct fswc_pkg))
+      || !fswc_check_section (hdr->total_size, hdr->vdirs_off, hdr->num_vdirs,
+                              sizeof (struct fswc_vdir))
+      || !fswc_check_section (hdr->total_size, hdr->ht_off, ht_cap,
+                              sizeof (struct fswc_ht_entry))
+      || !fswc_check_section (hdr->total_size, hdr->postings_off,
+                              hdr->num_postings, sizeof (uint32_t))
+      || !fswc_check_section (hdr->total_size, hdr->vchildren_off,
+                              hdr->num_vchildren, sizeof (struct fswc_vchild))
+      || !fswc_check_section (hdr->total_size, hdr->strtab_off,
+                              hdr->strtab_size, 1u))
+    return false;
+
+  const uint8_t *base = (const uint8_t *) map;
+  const char *strtab = (const char *) (base + hdr->strtab_off);
+  if (strtab[hdr->strtab_size - 1] != '\0')
+    return false;
+
+  const struct fswc_pkg *pkgs
+    = (const struct fswc_pkg *) (base + hdr->pkgs_off);
+  const struct fswc_vdir *vdirs
+    = (const struct fswc_vdir *) (base + hdr->vdirs_off);
+  const struct fswc_ht_entry *ht
+    = (const struct fswc_ht_entry *) (base + hdr->ht_off);
+  const uint32_t *postings
+    = (const uint32_t *) (base + hdr->postings_off);
+  const struct fswc_vchild *vchildren
+    = (const struct fswc_vchild *) (base + hdr->vchildren_off);
+
+  for (uint32_t i = 0; i < hdr->num_pkgs; ++i)
+    {
+      if (!fswc_valid_str_ent (strtab, hdr->strtab_size,
+                               pkgs[i].name_off, pkgs[i].name_len))
+        return false;
+      if (i > 0
+          && strcmp (strtab + pkgs[i - 1].name_off,
+                     strtab + pkgs[i].name_off) >= 0)
+        return false;
+    }
+
+  for (uint32_t i = 0; i < hdr->num_postings; ++i)
+    if (FSWC_POSTING_PKG (postings[i]) >= hdr->num_pkgs)
+      return false;
+
+  for (uint64_t s = 0; s < ht_cap; ++s)
+    {
+      const struct fswc_ht_entry *e = &ht[s];
+      if (e->hash == 0)
+        continue;
+      if ((e->parent_vdir_id >= hdr->num_vdirs
+           && e->parent_vdir_id != FSWC_VDIR_PKGS)
+          || !fswc_valid_str_ent (strtab, hdr->strtab_size,
+                                  e->name_off, e->name_len)
+          || (e->child_vdir_id != FSWC_NONE
+              && e->child_vdir_id >= hdr->num_vdirs)
+          || e->all_cnt == 0)
+        return false;
+      if (e->all_cnt == 1)
+        {
+          if (FSWC_POSTING_PKG (e->all_ref) >= hdr->num_pkgs)
+            return false;
+        }
+      else if ((uint64_t) e->all_ref + e->all_cnt > hdr->num_postings)
+        return false;
+    }
+
+  for (uint32_t i = 0; i < hdr->num_vdirs; ++i)
+    {
+      const struct fswc_vdir *vd = &vdirs[i];
+      if ((uint64_t) vd->children_start + vd->children_count
+          > hdr->num_vchildren)
+        return false;
+      if (vd->dir_postings_cnt == 1)
+        {
+          if (FSWC_POSTING_PKG (vd->dir_postings_ref) >= hdr->num_pkgs)
+            return false;
+        }
+      else if (vd->dir_postings_cnt > 1
+               && (uint64_t) vd->dir_postings_ref + vd->dir_postings_cnt
+                  > hdr->num_postings)
+        return false;
+    }
+
+  for (uint32_t i = 0; i < hdr->num_vchildren; ++i)
+    {
+      uint32_t slot = vchildren[i].ht_slot;
+      if (slot > hdr->ht_mask || ht[slot].hash == 0)
+        return false;
+    }
+
+  out->hdr = hdr;
+  out->pkgs = pkgs;
+  out->vdirs = vdirs;
+  out->ht = ht;
+  out->postings = postings;
+  out->vchildren = vchildren;
+  out->strtab = strtab;
+  out->map_size = map_size;
+  return true;
+}
+
+const struct fswc_ht_entry *
+__fswc_ht_lookup (const struct fswc_view *v, uint32_t parent_vdir_id,
+                  const char *name, size_t name_len)
+{
+  if (v == NULL || v->hdr == NULL || name_len == 0 || name_len > NAME_MAX)
+    return NULL;
+  uint64_t h = fswc_key_hash (parent_vdir_id, name, name_len);
+  uint32_t mask = v->hdr->ht_mask;
+  uint32_t slot = (uint32_t) h & mask;
+  uint32_t strtab_sz = v->hdr->strtab_size;
+
+  for (uint32_t step = 0; step <= mask; ++step)
+    {
+      const struct fswc_ht_entry *e = &v->ht[slot];
+      if (e->hash == 0)
+        return NULL;
+      if (e->hash == h
+          && e->parent_vdir_id == parent_vdir_id
+          && e->name_len == name_len
+          && (uint64_t) e->name_off + name_len < strtab_sz
+          && memcmp (v->strtab + e->name_off, name, name_len) == 0)
+        return e;
+      slot = (slot + 1u) & mask;
+    }
+  return NULL;
+}
+
+const uint32_t *
+__fswc_posting_slice (const struct fswc_view *v, uint16_t cnt, uint32_t ref,
+                      uint32_t *inline_buf, uint32_t *out_n)
+{
+  if (cnt == 0)
+    {
+      *out_n = 0;
+      return NULL;
+    }
+  if (cnt == 1)
+    {
+      *inline_buf = ref;
+      *out_n = 1;
+      return inline_buf;
+    }
+  if ((uint64_t) ref + cnt > v->hdr->num_postings)
+    {
+      *out_n = 0;
+      return NULL;
+    }
+  *out_n = cnt;
+  return v->postings + ref;
+}
+
+int
+__fswc_posting_find_pkg (const struct fswc_view *v, uint16_t cnt, uint32_t ref,
+                         uint32_t pkg_idx)
+{
+  if (cnt == 0)
+    return -1;
+  if (cnt == 1)
+    return FSWC_POSTING_PKG (ref) == pkg_idx
+           ? (int) FSWC_POSTING_DTYPE (ref) : -1;
+  if ((uint64_t) ref + cnt > v->hdr->num_postings)
+    return -1;
+  const uint32_t *arr = v->postings + ref;
+  if (cnt <= 8)
+    {
+      for (uint16_t i = 0; i < cnt; ++i)
+        {
+          uint32_t p = FSWC_POSTING_PKG (arr[i]);
+          if (p == pkg_idx)
+            return (int) FSWC_POSTING_DTYPE (arr[i]);
+          if (p > pkg_idx)
+            break;
+        }
+      return -1;
+    }
+  uint32_t lo = 0;
+  uint32_t hi = cnt;
+  while (lo < hi)
+    {
+      uint32_t mid = (lo + hi) >> 1;
+      uint32_t p = FSWC_POSTING_PKG (arr[mid]);
+      if (p == pkg_idx)
+        return (int) FSWC_POSTING_DTYPE (arr[mid]);
+      if (p < pkg_idx)
+        lo = mid + 1;
+      else
+        hi = mid;
+    }
+  return -1;
+}
+
+bool
+__fswc_resolve_pkg_wild_relpath (const struct fswc_slot_snap *snap,
+                                 const char *relpath, size_t rel_len,
+                                 struct fswc_relpath_result *out)
+{
+  out->leaf_ent = NULL;
+  out->target_vdir_id = FSWC_NONE;
+  out->num_lnk_ents = 0;
+  out->lnk_overflow = false;
+  out->restricted_search = false;
+
+  if (snap == NULL
+      || (snap->snap_flags & FSWC_SNAP_NO_SQUASHFS) != 0
+      || (snap->snap_flags
+          & (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+         != (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+    return false;
+
+  const struct fswc_view *v = &snap->view;
+
+  while (rel_len > 0 && *relpath == '/')
+    {
+      ++relpath;
+      --rel_len;
+    }
+  while (rel_len > 0 && relpath[rel_len - 1] == '/')
+    --rel_len;
+  if (rel_len == 0)
+    {
+      out->target_vdir_id = FSWC_VDIR_ROOT;
+      out->restricted_search
+        = (FSWC_VDIR_ROOT >= v->hdr->num_vdirs
+           || !(v->vdirs[FSWC_VDIR_ROOT].flags & FSWC_VDIR_ALL_WORLD_SEARCH));
+      return true;
+    }
+
+  uint32_t cur_vdir = FSWC_VDIR_ROOT;
+  const char *p = relpath;
+  const char *end = relpath + rel_len;
+
+  while (p < end)
+    {
+      if (cur_vdir >= v->hdr->num_vdirs
+          || !(v->vdirs[cur_vdir].flags & FSWC_VDIR_ALL_WORLD_SEARCH))
+        out->restricted_search = true;
+
+      const char *slash = memchr (p, '/', (size_t) (end - p));
+      size_t clen = slash != NULL ? (size_t) (slash - p) : (size_t) (end - p);
+      if (clen == 0
+          || (clen == 1 && p[0] == '.')
+          || (clen == 2 && p[0] == '.' && p[1] == '.')
+          || clen > NAME_MAX)
+        return false;
+
+      const struct fswc_ht_entry *ent
+        = __fswc_ht_lookup (v, cur_vdir, p, clen);
+      if (slash == NULL)
+        {
+          out->leaf_ent = ent;
+          out->target_vdir_id = ent != NULL ? ent->child_vdir_id : FSWC_NONE;
+          return true;
+        }
+      if (ent == NULL)
+        return true;
+      if (ent->flags & FSWC_ENT_RESTRICTED_SEARCH)
+        out->restricted_search = true;
+      if (ent->flags & FSWC_ENT_HAS_LNK)
+        {
+          if (out->num_lnk_ents < FSWC_MAX_LNK_STEPS)
+            out->lnk_ents[out->num_lnk_ents++] = ent;
+          else
+            out->lnk_overflow = true;
+        }
+      if (ent->child_vdir_id == FSWC_NONE
+          || ent->child_vdir_id >= v->hdr->num_vdirs)
+        return true;
+      cur_vdir = ent->child_vdir_id;
+      p = slash + 1;
+    }
+  return true;
+}
+
+bool
+__fswc_pkg_in_lnk_steps (const struct fswc_view *v,
+                         const struct fswc_relpath_result *res,
+                         uint32_t pkg_idx)
+{
+  if (res->lnk_overflow)
+    return true;
+  for (uint32_t i = 0; i < res->num_lnk_ents; ++i)
+    if (__fswc_posting_find_pkg (v, res->lnk_ents[i]->all_cnt,
+                                 res->lnk_ents[i]->all_ref, pkg_idx) == DT_LNK)
+      return true;
+  return false;
+}
+
+/* Canonicalize raw prefix: must start with '/', strip trailing '/',
+   reject "/" itself, internal "//", "/.", or "/..".  */
+static bool
+fswc_canonicalize_prefix (const char *raw, size_t raw_len, size_t *out_len)
+{
+  if (raw == NULL || raw_len < 2 || raw[0] != '/')
+    return false;
+  while (raw_len > 1 && raw[raw_len - 1] == '/')
+    --raw_len;
+  if (raw_len < 2 || raw_len >= PATH_MAX - 260)
+    return false;
+
+  size_t slashes = 0;
+  const char *p = raw + 1;
+  const char *end = raw + raw_len;
+  while (p < end)
+    {
+      ++slashes;
+      if (slashes >= FSWC_MAX_ANCESTORS)
+        return false;
+      const char *slash = memchr (p, '/', (size_t) (end - p));
+      size_t clen = slash != NULL ? (size_t) (slash - p) : (size_t) (end - p);
+      if (clen == 0 || clen > NAME_MAX
+          || (clen == 1 && p[0] == '.')
+          || (clen == 2 && p[0] == '.' && p[1] == '.'))
+        return false;
+      if (slash == NULL)
+        break;
+      p = slash + 1;
+    }
+  *out_len = raw_len;
+  return true;
+}
+
+/* Paginated listmount(LSMT_ROOT) + statmount(MNT_BASIC | MNT_ROOT | MNT_POINT)
+   mount-tree hash.  Hashes mount IDs, parent IDs, mount attributes, mnt_root,
+   and mnt_point so intra-namespace move_mount(2) / MS_MOVE relocations
+   invalidate immediately even when the set of mnt_id_unique values is
+   unchanged, while tolerating ancestor mounts outside a chroot subdirectory
+   where Linux omits STATMOUNT_MNT_POINT via SEQ_SKIP.  Optionally appends
+   raw mnt_ids to OPT_IDS_AR.  */
+static int
+fswc_hash_mount_tree (uint64_t *out_lo, uint64_t *out_hi,
+                      struct fswc_arena *opt_ids_ar)
+{
+#if defined __NR_listmount && defined __NR_statmount
+  _Alignas (struct fswc_statmount) uint8_t sm_stack[2048];
+  uint8_t *sm_dyn = NULL;
+  size_t sm_dyn_sz = 0;
+  size_t orig_ar_used = opt_ids_ar != NULL ? opt_ids_ar->used : 0;
+  int rc = 0;
+
+  for (int attempt = 0; attempt < 3; ++attempt)
+    {
+      if (opt_ids_ar != NULL)
+        opt_ids_ar->used = orig_ar_used;
+
+      struct fswc_mnt_id_req req =
+        {
+          .size = FSWC_MNT_ID_REQ_SIZE,
+          .spare = 0,
+          .mnt_id = FSWC_LSMT_ROOT,
+          .param = 0
+        };
+      uint64_t ids[256];
+      uint64_t lo = FSWC_HASH_INIT_LO;
+      uint64_t hi = FSWC_HASH_INIT_HI;
+      bool retry_unmount_race = false;
+
+      for (;;)
+        {
+          long n = INTERNAL_SYSCALL_CALL (listmount, &req, ids, 256, 0);
+          if (INTERNAL_SYSCALL_ERROR_P (n))
+            {
+              rc = (int) n;
+              goto out;
+            }
+          if (n == 0)
+            break;
+
+          if (opt_ids_ar != NULL)
+            {
+              uint64_t *dst
+                = fswc_arena_alloc (opt_ids_ar,
+                                    (size_t) n * sizeof (uint64_t),
+                                    _Alignof (uint64_t));
+              if (dst == NULL)
+                {
+                  rc = -ENOMEM;
+                  goto out;
+                }
+              memcpy (dst, ids, (size_t) n * sizeof (uint64_t));
+            }
+
+          for (long j = 0; j < n; ++j)
+            {
+              struct fswc_mnt_id_req sreq =
+                {
+                  .size = FSWC_MNT_ID_REQ_SIZE,
+                  .spare = 0,
+                  .mnt_id = ids[j],
+                  .param = FSWC_STATMOUNT_MNT_BASIC
+                           | FSWC_STATMOUNT_MNT_ROOT
+                           | FSWC_STATMOUNT_MNT_POINT
+                };
+              uint8_t *sm_buf = sm_dyn != NULL ? sm_dyn : sm_stack;
+              size_t sm_cap = sm_dyn != NULL ? sm_dyn_sz : sizeof (sm_stack);
+              long sr = INTERNAL_SYSCALL_CALL (statmount, &sreq, sm_buf,
+                                               sm_cap, 0);
+              while (sr == -EOVERFLOW)
+                {
+                  size_t next_sz = sm_dyn_sz == 0 ? 65536u : (sm_dyn_sz * 2u);
+                  if (next_sz > 262144u)
+                    {
+                      rc = -EOVERFLOW;
+                      goto out;
+                    }
+                  uint8_t *nb = fswc_sys_mmap_anon (next_sz);
+                  if (nb == NULL)
+                    {
+                      rc = -ENOMEM;
+                      goto out;
+                    }
+                  fswc_sys_munmap (sm_dyn, sm_dyn_sz);
+                  sm_dyn = nb;
+                  sm_dyn_sz = next_sz;
+                  sm_buf = sm_dyn;
+                  sm_cap = sm_dyn_sz;
+                  sr = INTERNAL_SYSCALL_CALL (statmount, &sreq, sm_buf,
+                                              sm_cap, 0);
+                }
+              if (sr == -ENOENT)
+                {
+                  retry_unmount_race = true;
+                  break;
+                }
+              if (INTERNAL_SYSCALL_ERROR_P (sr))
+                {
+                  rc = (int) sr;
+                  goto out;
+                }
+
+              const struct fswc_statmount *sm
+                = (const struct fswc_statmount *) sm_buf;
+              size_t valid_sz = sm->size <= sm_cap ? sm->size : sm_cap;
+              size_t str_cap = valid_sz > offsetof (struct fswc_statmount, str)
+                               ? valid_sz - offsetof (struct fswc_statmount, str)
+                               : 0;
+
+              uint64_t hdr_words[2] = { ids[j], sm->mask };
+              fswc_hash128_update (&lo, &hi, hdr_words, sizeof (hdr_words));
+
+              if (sm->mask & FSWC_STATMOUNT_MNT_BASIC)
+                {
+                  uint64_t basic_words[3]
+                    = { sm->mnt_id, sm->mnt_parent_id, sm->mnt_attr };
+                  fswc_hash128_update (&lo, &hi, basic_words,
+                                       sizeof (basic_words));
+                }
+              if ((sm->mask & FSWC_STATMOUNT_MNT_ROOT)
+                  && sm->mnt_root < str_cap)
+                {
+                  const char *mr = sm->str + sm->mnt_root;
+                  const char *mr_nul
+                    = memchr (mr, '\0', str_cap - sm->mnt_root);
+                  size_t mr_len = mr_nul != NULL
+                                  ? (size_t) (mr_nul - mr)
+                                  : (str_cap - sm->mnt_root);
+                  uint64_t len64 = (uint64_t) mr_len;
+                  fswc_hash128_update (&lo, &hi, &len64, sizeof (len64));
+                  fswc_hash128_update (&lo, &hi, mr, mr_len);
+                }
+              if ((sm->mask & FSWC_STATMOUNT_MNT_POINT)
+                  && sm->mnt_point < str_cap)
+                {
+                  const char *mp = sm->str + sm->mnt_point;
+                  const char *mp_nul
+                    = memchr (mp, '\0', str_cap - sm->mnt_point);
+                  size_t mp_len = mp_nul != NULL
+                                  ? (size_t) (mp_nul - mp)
+                                  : (str_cap - sm->mnt_point);
+                  uint64_t len64 = (uint64_t) mp_len;
+                  fswc_hash128_update (&lo, &hi, &len64, sizeof (len64));
+                  fswc_hash128_update (&lo, &hi, mp, mp_len);
+                }
+            }
+
+          if (retry_unmount_race)
+            break;
+          if (n < 256)
+            break;
+          req.param = ids[n - 1];
+        }
+
+      if (retry_unmount_race)
+        {
+          rc = -ENOENT;
+          continue;
+        }
+
+      *out_lo = lo;
+      *out_hi = hi;
+      rc = 0;
+      goto out;
+    }
+
+out:
+  fswc_sys_munmap (sm_dyn, sm_dyn_sz);
+  return rc;
+#else
+  (void) out_lo;
+  (void) out_hi;
+  (void) opt_ids_ar;
+  return -ENOSYS;
+#endif
+}
+
+/* Lock-free revalidation of an already-published snapshot.  */
+static bool
+fswc_revalidate_snap (const char *prefix, struct fswc_slot_snap *snap,
+                      bool force_now)
+{
+  if (snap == NULL || atomic_load_acquire (&snap->stale) != 0)
+    return false;
+
+  uint32_t cur_gen = atomic_load_acquire (&GL (dl_fswc_state).inval_gen);
+  uint32_t check_ms = fswc_now_coarse_ms ();
+
+  if (!force_now && cur_gen == atomic_load_relaxed (&snap->checked_inval_gen))
+    {
+      uint32_t prev_ms = atomic_load_relaxed (&snap->last_check_ms);
+      if (prev_ms != 0
+          && (uint32_t) (check_ms - prev_ms) <= FSWC_REVALIDATE_MS)
+        return true;
+    }
+
+  {
+    uint32_t euid = (uint32_t) INTERNAL_SYSCALL_CALL (geteuid);
+    uint32_t ruid = (uint32_t) INTERNAL_SYSCALL_CALL (getuid);
+    if (euid != snap->snap_euid
+        || ruid != snap->snap_ruid
+        || (__libc_enable_secure && !(euid == 0 && ruid == 0)))
+      goto mark_stale;
+  }
+
+  char anc_buf[PATH_MAX];
+  for (uint32_t a = 0; a < snap->num_ancestors; ++a)
+    {
+      const struct fswc_ancestor_id *aid = &snap->ancestors[a];
+      if (aid->path_len == 0 || aid->path_len >= sizeof (anc_buf))
+        goto mark_stale;
+      memcpy (anc_buf, prefix, aid->path_len);
+      anc_buf[aid->path_len] = '\0';
+
+      struct statx stx;
+      long r = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, anc_buf,
+                                      AT_SYMLINK_NOFOLLOW,
+                                      STATX_TYPE | STATX_MODE | STATX_INO
+                                      | STATX_CTIME | STATX_MTIME
+                                      | STATX_MNT_ID_UNIQUE, &stx);
+      if (INTERNAL_SYSCALL_ERROR_P (r)
+          || !(stx.stx_mask & STATX_MNT_ID_UNIQUE)
+          || !S_ISDIR (stx.stx_mode)
+          || stx.stx_mnt_id != aid->mnt_id
+          || fswc_pack_dev (stx.stx_dev_major, stx.stx_dev_minor) != aid->dev
+          || stx.stx_ino != aid->ino
+          || stx.stx_ctime.tv_sec != aid->ctime_sec
+          || stx.stx_ctime.tv_nsec != aid->ctime_nsec)
+        goto mark_stale;
+
+      if ((snap->snap_flags & FSWC_SNAP_ANCESTORS_WORLD_SEARCH)
+          && (stx.stx_mode & 0111) != 0111)
+        goto mark_stale;
+
+      if (a + 1 == snap->num_ancestors)
+        {
+          if (stx.stx_mtime.tv_sec != snap->prefix_mtime_sec
+              || stx.stx_mtime.tv_nsec != snap->prefix_mtime_nsec)
+            goto mark_stale;
+          if ((snap->snap_flags & FSWC_SNAP_PREFIX_WORLD_RX)
+              && (stx.stx_mode & 0555) != 0555)
+            goto mark_stale;
+        }
+    }
+
+  uint64_t mlo = 0, mhi = 0;
+  if (fswc_hash_mount_tree (&mlo, &mhi, NULL) != 0
+      || mlo != snap->mnt_list_hash_lo
+      || mhi != snap->mnt_list_hash_hi)
+    goto mark_stale;
+
+  atomic_store_relaxed (&snap->checked_inval_gen, cur_gen);
+  atomic_store_relaxed (&snap->last_check_ms, check_ms);
+  return true;
+
+mark_stale:
+  atomic_store_release (&snap->stale, 1);
+  return false;
+}
+
+/* Check whether an open directory fd or path has NO POSIX access ACL.  */
+static bool
+fswc_fd_no_posix_acl (int dfd)
+{
+  long r = INTERNAL_SYSCALL_CALL (fgetxattr, dfd, "system.posix_acl_access",
+                                  NULL, 0);
+  return r == -ENODATA || r == -EOPNOTSUPP || r == -ENOSYS;
+}
+
+static bool
+fswc_path_no_posix_acl (const char *path)
+{
+  long r = INTERNAL_SYSCALL_CALL (lgetxattr, path, "system.posix_acl_access",
+                                  NULL, 0);
+  return r == -ENODATA || r == -EOPNOTSUPP || r == -ENOSYS;
+}
+
+/* Open per-UID /dev/shm/.fswc-<euid> hardened 0700 directory.  */
+static int
+fswc_open_shm_dir (uint32_t euid)
+{
+  char path[64];
+  memcpy (path, "/dev/shm/.fswc-", 15);
+  char *p = path + 15;
+  fswc_fmt_u64_dec (p, euid);
+
+  INTERNAL_SYSCALL_CALL (mkdirat, AT_FDCWD, path, 0700);
+  long fd = INTERNAL_SYSCALL_CALL (openat, AT_FDCWD, path,
+                                   O_RDONLY | O_DIRECTORY | O_NOFOLLOW
+                                   | O_CLOEXEC, 0);
+  if (INTERNAL_SYSCALL_ERROR_P (fd))
+    return -1;
+
+  struct statx stx;
+  long sr = INTERNAL_SYSCALL_CALL (statx, (int) fd, "", AT_EMPTY_PATH,
+                                   STATX_TYPE | STATX_MODE | STATX_UID, &stx);
+  if (INTERNAL_SYSCALL_ERROR_P (sr)
+      || !S_ISDIR (stx.stx_mode)
+      || stx.stx_uid != euid
+      || (stx.stx_mode & 07777) != 0700)
+    {
+      INTERNAL_SYSCALL_CALL (close, (int) fd);
+      return -1;
+    }
+  return (int) fd;
+}
+
+/* Evict oldest SHM files when free space < 32 MiB or count > 512.
+   Returns true if >= 16 MiB free remains for writing.  */
+struct fswc_evict_cand
+{
+  uint32_t name_off;
+  int64_t mtime_sec;
+  bool is_pkg;
+};
+
+static bool
+fswc_shm_prepare_write (int shm_dfd, size_t write_len)
+{
+  if (shm_dfd < 0)
+    return false;
+
+  struct statfs sfs;
+  if (INTERNAL_SYSCALL_CALL (fstatfs, shm_dfd, &sfs) != 0)
+    return false;
+
+  uint64_t free_bytes = (uint64_t) sfs.f_bavail * (uint64_t) sfs.f_bsize;
+
+  /* Quick scan of entry count only when space is low or pseudo-randomly
+     every ~64 writes (low bits of free_bytes / time) -- actually scanning
+     <= 512 tmpfs dirents takes < 8 us, so checking dirent count directly
+     guarantees strict <= 512 enforcement!  */
+  struct fswc_arena scratch;
+  fswc_arena_init (&scratch);
+
+  long scan_fd = INTERNAL_SYSCALL_CALL (openat, shm_dfd, ".",
+                                        O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+  if (INTERNAL_SYSCALL_ERROR_P (scan_fd))
+    return free_bytes >= FSWC_SHM_MIN_FREE_WRITE + write_len;
+
+  size_t total_files = 0;
+  uint8_t dbuf[4096];
+  for (;;)
+    {
+      long nr = INTERNAL_SYSCALL_CALL (getdents64, (int) scan_fd, dbuf,
+                                       sizeof (dbuf));
+      if (nr <= 0)
+        break;
+      for (long off = 0; off < nr; )
+        {
+          const struct dirent64 *d = (const struct dirent64 *) (dbuf + off);
+          off += d->d_reclen;
+          if (d->d_name[0] == '.'
+              && (d->d_name[1] == '\0'
+                  || (d->d_name[1] == '.' && d->d_name[2] == '\0')))
+            continue;
+          ++total_files;
+        }
+    }
+  INTERNAL_SYSCALL_CALL (close, (int) scan_fd);
+
+  if (free_bytes >= FSWC_SHM_MIN_FREE_EVICT + write_len
+      && total_files < FSWC_SHM_MAX_FILES)
+    {
+      fswc_arena_free (&scratch);
+      return true;
+    }
+
+  if (INTERNAL_SYSCALL_CALL (flock, shm_dfd, LOCK_EX | LOCK_NB) != 0)
+    {
+      fswc_arena_free (&scratch);
+      return free_bytes >= FSWC_SHM_MIN_FREE_WRITE + write_len;
+    }
+
+  scan_fd = INTERNAL_SYSCALL_CALL (openat, shm_dfd, ".",
+                                   O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+  if (!INTERNAL_SYSCALL_ERROR_P (scan_fd))
+    {
+      struct fswc_arena names_arena;
+      fswc_arena_init (&names_arena);
+      size_t ncand = 0;
+
+      for (;;)
+        {
+          long nr = INTERNAL_SYSCALL_CALL (getdents64, (int) scan_fd, dbuf,
+                                           sizeof (dbuf));
+          if (nr <= 0)
+            break;
+          for (long off = 0; off < nr; )
+            {
+              const struct dirent64 *d = (const struct dirent64 *) (dbuf + off);
+              off += d->d_reclen;
+              if (d->d_name[0] == '.'
+                  && (d->d_name[1] == '\0'
+                      || (d->d_name[1] == '.' && d->d_name[2] == '\0')))
+                continue;
+
+              struct statx stx;
+              if (INTERNAL_SYSCALL_CALL (statx, shm_dfd, d->d_name,
+                                         AT_SYMLINK_NOFOLLOW,
+                                         STATX_MTIME, &stx) != 0)
+                continue;
+
+              /* Unlink stale .tmp_ files immediately if > 30s old.  */
+              if (strncmp (d->d_name, ".tmp_", 5) == 0)
+                {
+                  struct timespec rts;
+                  if (INTERNAL_SYSCALL_CALL (clock_gettime, CLOCK_REALTIME,
+                                             &rts) == 0
+                      && rts.tv_sec - stx.stx_mtime.tv_sec > 30)
+                    INTERNAL_SYSCALL_CALL (unlinkat, shm_dfd, d->d_name, 0);
+                  continue;
+                }
+
+              size_t nlen = strlen (d->d_name) + 1;
+              char *ncopy = fswc_arena_alloc (&names_arena, nlen, 1);
+              struct fswc_evict_cand *ec
+                = fswc_arena_alloc (&scratch, sizeof (*ec),
+                                    _Alignof (struct fswc_evict_cand));
+              if (ncopy == NULL || ec == NULL)
+                break;
+              memcpy (ncopy, d->d_name, nlen);
+              ec->name_off = (uint32_t) ((uint8_t *) ncopy - names_arena.base);
+              ec->mtime_sec = stx.stx_mtime.tv_sec;
+              ec->is_pkg = (strncmp (d->d_name, "pkg_", 4) == 0);
+              ++ncand;
+            }
+        }
+      INTERNAL_SYSCALL_CALL (close, (int) scan_fd);
+
+      struct fswc_evict_cand *cands = (struct fswc_evict_cand *) scratch.base;
+      /* Insertion sort: non-pkg_ before pkg_, then older mtime first.  */
+      for (size_t i = 1; i < ncand; ++i)
+        {
+          struct fswc_evict_cand cur = cands[i];
+          size_t j = i;
+          while (j > 0
+                 && ((cands[j - 1].is_pkg && !cur.is_pkg)
+                     || (cands[j - 1].is_pkg == cur.is_pkg
+                         && cands[j - 1].mtime_sec > cur.mtime_sec)))
+            {
+              cands[j] = cands[j - 1];
+              --j;
+            }
+          cands[j] = cur;
+        }
+
+      for (size_t i = 0; i < ncand; ++i)
+        {
+          if (INTERNAL_SYSCALL_CALL (fstatfs, shm_dfd, &sfs) == 0)
+            free_bytes = (uint64_t) sfs.f_bavail * (uint64_t) sfs.f_bsize;
+          if (free_bytes >= FSWC_SHM_MIN_FREE_EVICT + write_len
+              && ncand - i < FSWC_SHM_MAX_FILES / 2)
+            break;
+          /* Prefer keeping pkg_ files unless disk space is low.  */
+          if (cands[i].is_pkg
+              && free_bytes >= FSWC_SHM_MIN_FREE_EVICT + write_len
+              && ncand - i < FSWC_SHM_MAX_FILES)
+            break;
+          const char *nm = (const char *) names_arena.base + cands[i].name_off;
+          INTERNAL_SYSCALL_CALL (unlinkat, shm_dfd, nm, 0);
+        }
+
+      fswc_arena_free (&names_arena);
+    }
+
+  INTERNAL_SYSCALL_CALL (flock, shm_dfd, LOCK_UN);
+  fswc_arena_free (&scratch);
+
+  if (INTERNAL_SYSCALL_CALL (fstatfs, shm_dfd, &sfs) != 0)
+    return false;
+  free_bytes = (uint64_t) sfs.f_bavail * (uint64_t) sfs.f_bsize;
+  return free_bytes >= FSWC_SHM_MIN_FREE_WRITE + write_len;
+}
+
+static bool
+fswc_shm_publish_atomic (int shm_dfd, const char *final_name,
+                         const void *buf, size_t len)
+{
+  if (!fswc_shm_prepare_write (shm_dfd, len))
+    return false;
+
+  static uint32_t tmp_seq;
+  uint32_t seq = atomic_fetch_add_relaxed (&tmp_seq, 1);
+  uint32_t tid = (uint32_t) INTERNAL_SYSCALL_CALL (gettid);
+  uint64_t salt = 0;
+  char tmp_name[96];
+  if (INTERNAL_SYSCALL_CALL (getrandom, &salt, sizeof (salt), 0x0001u)
+      != (long) sizeof (salt))
+    salt = fswc_mix64 (((uint64_t) fswc_now_coarse_ms () << 32)
+                       ^ (uintptr_t) tmp_name ^ seq);
+
+  memcpy (tmp_name, ".tmp_", 5);
+  char *p = tmp_name + 5;
+  p = fswc_fmt_u64_dec (p, tid);
+  *p++ = '_';
+  p = fswc_fmt_u64_dec (p, seq);
+  *p++ = '_';
+  fswc_fmt_hex16 (p, salt);
+
+  long fd = INTERNAL_SYSCALL_CALL (openat, shm_dfd, tmp_name,
+                                   O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW
+                                   | O_CLOEXEC, 0600);
+  if (INTERNAL_SYSCALL_ERROR_P (fd))
+    return false;
+
+  const uint8_t *wp = (const uint8_t *) buf;
+  size_t rem = len;
+  while (rem > 0)
+    {
+      long nw = INTERNAL_SYSCALL_CALL (write, (int) fd, wp, rem);
+      if (nw <= 0)
+        {
+          INTERNAL_SYSCALL_CALL (close, (int) fd);
+          INTERNAL_SYSCALL_CALL (unlinkat, shm_dfd, tmp_name, 0);
+          return false;
+        }
+      wp += (size_t) nw;
+      rem -= (size_t) nw;
+    }
+
+  if (INTERNAL_SYSCALL_CALL (fchmod, (int) fd, 0400) != 0)
+    {
+      INTERNAL_SYSCALL_CALL (close, (int) fd);
+      INTERNAL_SYSCALL_CALL (unlinkat, shm_dfd, tmp_name, 0);
+      return false;
+    }
+  INTERNAL_SYSCALL_CALL (close, (int) fd);
+
+#ifdef __NR_renameat2
+  long rr = INTERNAL_SYSCALL_CALL (renameat2, shm_dfd, tmp_name,
+                                   shm_dfd, final_name, 0);
+#else
+  long rr = INTERNAL_SYSCALL_CALL (renameat, shm_dfd, tmp_name,
+                                   shm_dfd, final_name);
+#endif
+  if (INTERNAL_SYSCALL_ERROR_P (rr))
+    {
+      INTERNAL_SYSCALL_CALL (unlinkat, shm_dfd, tmp_name, 0);
+      return false;
+    }
+  return true;
+}
+
+static bool
+fswc_open_map_shm_ro (int shm_dfd, const char *name, void **out_map,
+                      size_t *out_sz)
+{
+  *out_map = NULL;
+  *out_sz = 0;
+  if (shm_dfd < 0)
+    return false;
+
+  long fd = INTERNAL_SYSCALL_CALL (openat, shm_dfd, name,
+                                   O_RDONLY | O_NOFOLLOW | O_CLOEXEC, 0);
+  if (INTERNAL_SYSCALL_ERROR_P (fd))
+    return false;
+
+  struct statx stx;
+  long sr = INTERNAL_SYSCALL_CALL (statx, (int) fd, "", AT_EMPTY_PATH,
+                                   STATX_TYPE | STATX_SIZE, &stx);
+  if (INTERNAL_SYSCALL_ERROR_P (sr)
+      || !S_ISREG (stx.stx_mode)
+      || stx.stx_size == 0
+      || stx.stx_size > FSWC_BLOB_MAX_SIZE)
+    {
+      INTERNAL_SYSCALL_CALL (close, (int) fd);
+      return false;
+    }
+
+  void *m = fswc_sys_mmap_fd ((int) fd, (size_t) stx.stx_size);
+  INTERNAL_SYSCALL_CALL (close, (int) fd);
+  if (m == NULL)
+    return false;
+  *out_map = m;
+  *out_sz = (size_t) stx.stx_size;
+  return true;
+}
