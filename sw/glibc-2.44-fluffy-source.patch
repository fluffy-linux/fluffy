+#ifdef __NR_mmap2
+  long r = INTERNAL_SYSCALL_CALL (mmap2, NULL, sz, PROT_READ | PROT_WRITE,
+				  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+#else
+  long r = INTERNAL_SYSCALL_CALL (mmap, NULL, sz, PROT_READ | PROT_WRITE,
+				  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+#endif
+  if (INTERNAL_SYSCALL_ERROR_P (r))
+    return NULL;
+  return (void *) r;
+}
+
+static void
+exec_munmap (void *p, size_t sz)
+{
+  if (p != NULL && sz > 0)
+    INTERNAL_SYSCALL_CALL (munmap, p, sz);
+}
+
+struct exec_tmp_arena
+{
+  uint8_t *base;
+  size_t used;
+  size_t cap;
+};
+
+static void *
+exec_arena_alloc (struct exec_tmp_arena *ar, size_t sz, size_t align)
+{
+  size_t mask = align - 1;
+  size_t off = (ar->used + mask) & ~mask;
+  if (off > SIZE_MAX - sz)
+    return NULL;
+  size_t need = off + sz;
+  if (need > ar->cap)
+    {
+      size_t ncap = ar->cap == 0 ? 16384 : ar->cap * 2;
+      while (ncap < need)
+	{
+	  if (ncap > (1u << 26))
+	    return NULL;
+	  ncap *= 2;
+	}
+      uint8_t *nb = exec_mmap_anon (ncap);
+      if (nb == NULL)
+	return NULL;
+      if (ar->used > 0)
+	memcpy (nb, ar->base, ar->used);
+      exec_munmap (ar->base, ar->cap);
+      ar->base = nb;
+      ar->cap = ncap;
+    }
+  ar->used = need;
+  return ar->base + off;
+}
+
+struct exec_str_ref
+{
+  uint32_t off;
+  uint32_t len;
+};
+
+static void
+exec_sort_refs (struct exec_str_ref *arr, struct exec_str_ref *tmp,
+		size_t n, const char *pool)
+{
+  for (size_t width = 1; width < n; width *= 2)
+    {
+      for (size_t i = 0; i < n; i += 2 * width)
+	{
+	  size_t l = i;
+	  size_t mid = (i + width < n) ? (i + width) : n;
+	  size_t r = (i + 2 * width < n) ? (i + 2 * width) : n;
+	  size_t a = l, b = mid, out = l;
+	  while (a < mid && b < r)
+	    {
+	      if (strcmp (pool + arr[a].off, pool + arr[b].off) <= 0)
+		tmp[out++] = arr[a++];
+	      else
+		tmp[out++] = arr[b++];
+	    }
+	  while (a < mid)
+	    tmp[out++] = arr[a++];
+	  while (b < r)
+	    tmp[out++] = arr[b++];
+	}
+      memcpy (arr, tmp, n * sizeof (*arr));
+    }
+}
+
+/* Collect next batch of matching full executable paths after LAST_TRIED into
+   BATCH_BUF[0..BATCH_CAP) without consuming stack space for getdents buffers.
+   Unmaps all temporary arenas before returning!  */
+static size_t __attribute__ ((noinline))
+exec_collect_wildcard_batch (const char *pat, size_t pat_len,
+			     size_t lit_prefix_len,
+			     const char *file, size_t file_len_with_nul,
+			     const char *last_tried, bool have_last,
+			     char *batch_buf, size_t batch_cap,
+			     bool *out_more, bool *out_any_seen)
+{
+  *out_more = false;
+
+  if (lit_prefix_len > pat_len)
+    return 0;
+
+  /* Split PAT into literal DIR_PREFIX, wildcard WILD_COMP, and REST_SUFFIX.
+     Bytes in [0, LIT_PREFIX_LEN) came from already-matched directory names
+     and must be treated strictly literally (even if named "*", "?", "[1]",
+     or containing '\\').  */
+  size_t i = lit_prefix_len;
+  size_t last_slash_idx = SIZE_MAX;
+  for (size_t s = 0; s < lit_prefix_len; ++s)
+    if (pat[s] == '/')
+      last_slash_idx = s;
+  while (i < pat_len)
+    {
+      if (pat[i] == '\\' && i + 1 < pat_len)
+	{
+	  i += 2;
+	  continue;
+	}
+      if (pat[i] == '/')
+	last_slash_idx = i;
+      else if (pat[i] == '*' || pat[i] == '?' || pat[i] == '[')
+	break;
+      ++i;
+    }
+  if (i >= pat_len)
+    return 0;
+
+  size_t comp_start = (last_slash_idx == SIZE_MAX) ? 0 : (last_slash_idx + 1);
+  size_t comp_end = comp_start;
+  while (comp_end < pat_len)
+    {
+      if (pat[comp_end] == '\\' && comp_end + 1 < pat_len)
+	{
+	  comp_end += 2;
+	  continue;
+	}
+      if (pat[comp_end] == '/')
+	break;
+      ++comp_end;
+    }
+
+  const char *wild_comp = pat + comp_start;
+  size_t wild_len = comp_end - comp_start;
+  const char *suffix = pat + comp_end;
+  size_t suffix_len = pat_len - comp_end;
+
+  struct exec_tmp_arena scratch = { NULL, 0, 0 };
+  struct exec_tmp_arena pool_ar = { NULL, 0, 0 };
+  struct exec_tmp_arena refs_ar = { NULL, 0, 0 };
+
+  uint8_t *fixed_buf = exec_arena_alloc (&scratch, 4 * PATH_MAX + 4096, 8);
+  if (fixed_buf == NULL)
+    goto done;
+  scratch.used = 0;
+
+  char *dir_prefix = exec_arena_alloc (&scratch, PATH_MAX, 1);
+  char *dent_buf = exec_arena_alloc (&scratch, 4096, 8);
+  char *cand_tmp = exec_arena_alloc (&scratch, PATH_MAX, 1);
+  if (dir_prefix == NULL || dent_buf == NULL || cand_tmp == NULL)
+    goto done;
+
+  size_t prefix_len;
+  if (last_slash_idx == SIZE_MAX)
+    {
+      dir_prefix[0] = '.';
+      dir_prefix[1] = '\0';
+      prefix_len = 1;
+    }
+  else
+    {
+      prefix_len = (last_slash_idx == 0) ? 1 : last_slash_idx;
+      if (prefix_len >= PATH_MAX)
+	goto done;
+      size_t copy_lit = lit_prefix_len < prefix_len ? lit_prefix_len : prefix_len;
+      if (copy_lit > 0)
+	memcpy (dir_prefix, pat, copy_lit);
+      /* Unescape any backslash-escaped chars after COPY_LIT in DIR_PREFIX.  */
+      size_t out_p = copy_lit;
+      for (size_t k = copy_lit; k < prefix_len; ++k)
+	{
+	  if (pat[k] == '\\' && k + 1 < prefix_len)
+	    ++k;
+	  dir_prefix[out_p++] = pat[k];
+	}
+      dir_prefix[out_p] = '\0';
+      prefix_len = out_p;
+    }
+
+  int dir_fd = __open64_nocancel (dir_prefix,
+				  O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir_fd < 0)
+    goto done;
+
+  ssize_t nread;
+  while ((nread = __getdents64 (dir_fd, dent_buf, 4096)) > 0)
+    {
+      for (ssize_t bpos = 0; bpos < nread; )
+	{
+	  struct dirent64 *d = (struct dirent64 *) (dent_buf + bpos);
+	  bpos += d->d_reclen;
+	  if (file_len_with_nul > 0
+	      && (d->d_type == DT_REG || d->d_type == DT_FIFO
+		  || d->d_type == DT_SOCK || d->d_type == DT_CHR
+		  || d->d_type == DT_BLK))
+	    continue;
+	  if (!exec_match_component (wild_comp, wild_len, d->d_name))
+	    continue;
+
+	  size_t dlen = strlen (d->d_name);
+	  uint32_t off = (uint32_t) pool_ar.used;
+	  char *dst = exec_arena_alloc (&pool_ar, dlen + 1, 1);
+	  struct exec_str_ref *ref
+	    = exec_arena_alloc (&refs_ar, sizeof (*ref),
+				_Alignof (struct exec_str_ref));
+	  if (dst == NULL || ref == NULL)
+	    break;
+	  memcpy (dst, d->d_name, dlen + 1);
+	  ref->off = off;
+	  ref->len = (uint32_t) dlen;
+	}
+    }
+  __close_nocancel_nostatus (dir_fd);
+
+  size_t nentries = refs_ar.used / sizeof (struct exec_str_ref);
+  if (nentries > 1)
+    {
+      struct exec_tmp_arena tmp_ar = { NULL, 0, 0 };
+      struct exec_str_ref *tmp_refs
+	= exec_arena_alloc (&tmp_ar, nentries * sizeof (*tmp_refs),
+			    _Alignof (struct exec_str_ref));
+      if (tmp_refs != NULL)
+	exec_sort_refs ((struct exec_str_ref *) (void *) refs_ar.base,
+			tmp_refs, nentries, (const char *) pool_ar.base);
+      exec_munmap (tmp_ar.base, tmp_ar.cap);
+    }
+
+  const struct exec_str_ref *arr
+    = (const struct exec_str_ref *) (const void *) refs_ar.base;
+  size_t batch_used = 0;
+  size_t batch_cnt = 0;
+
+  /* Note: when DIR_PREFIX came from a relative pattern like "* /bin", omit
+     leading "./" so argv/ENOEXEC script path matches PATH element syntax.  */
+  const char *emit_prefix = (last_slash_idx == SIZE_MAX) ? "" : dir_prefix;
+  size_t emit_prefix_len = (last_slash_idx == SIZE_MAX) ? 0 : prefix_len;
+  bool suffix_has_meta = has_glob_meta (suffix, suffix_len);
+  const char *emit_suffix = suffix;
+  size_t emit_suffix_len = suffix_len;
+  if (!suffix_has_meta && suffix_len > 0
+      && memchr (suffix, '\\', suffix_len) != NULL)
+    {
+      char *unesc_suf = exec_arena_alloc (&scratch, suffix_len + 1, 1);
+      if (unesc_suf == NULL)
+	goto done;
+      size_t out_s = 0;
+      for (size_t k = 0; k < suffix_len; ++k)
+	{
+	  if (suffix[k] == '\\' && k + 1 < suffix_len)
+	    ++k;
+	  unesc_suf[out_s++] = suffix[k];
+	}
+      unesc_suf[out_s] = '\0';
+      emit_suffix = unesc_suf;
+      emit_suffix_len = out_s;
+    }
+
+  for (size_t idx = 0; idx < nentries; ++idx)
+    {
+      const char *ename = (const char *) pool_ar.base + arr[idx].off;
+      size_t elen = arr[idx].len;
+
+      if (suffix_has_meta)
+	{
+	  /* Recursive multi-wildcard segment: build sub-pattern without FILE
+	     so trailing slashes on EMIT_SUFFIX and NEXT_LIT_LEN stay exact.  */
+	  size_t sub_sz
+	    = build_wildcard_exec_path (cand_tmp, PATH_MAX,
+					emit_prefix, emit_prefix_len,
+					ename, elen,
+					emit_suffix, emit_suffix_len,
+					"", 0);
+	  if (sub_sz == 0)
+	    continue;
+	  size_t sub_pat_len = sub_sz - 1;
+	  size_t next_lit_len = sub_pat_len >= emit_suffix_len
+				? (sub_pat_len - emit_suffix_len) : 0;
+	  bool sub_more = false;
+	  size_t got = exec_collect_wildcard_batch (
+	    cand_tmp, sub_pat_len, next_lit_len, file, file_len_with_nul,
+	    last_tried, have_last,
+	    batch_buf + batch_used, batch_cap - batch_used,
+	    &sub_more, out_any_seen);
+	  for (size_t g = 0; g < got; ++g)
+	    batch_used += strlen (batch_buf + batch_used) + 1;
+	  batch_cnt += got;
+	  if (sub_more)
+	    {
+	      *out_more = true;
+	      break;
+	    }
+	  continue;
+	}
+
+      size_t full_sz
+	= build_wildcard_exec_path (cand_tmp, PATH_MAX,
+				    emit_prefix, emit_prefix_len,
+				    ename, elen,
+				    emit_suffix, emit_suffix_len,
+				    file, file_len_with_nul);
+      if (full_sz == 0)
+	continue;
+
+      if (have_last && strcmp (cand_tmp, last_tried) <= 0)
+	continue;
+
+      struct statx stx;
+      long sr = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, cand_tmp,
+				       AT_SYMLINK_NOFOLLOW, STATX_TYPE, &stx);
+      if (sr == -ENOENT || sr == -ENOTDIR)
+	continue;
+
+      *out_any_seen = true;
+      if (batch_used + full_sz > batch_cap)
+	{
+	  *out_more = true;
+	  break;
+	}
+      memcpy (batch_buf + batch_used, cand_tmp, full_sz);
+      batch_used += full_sz;
+      ++batch_cnt;
+    }
+
+done:
+  exec_munmap (scratch.base, scratch.cap);
+  exec_munmap (pool_ar.base, pool_ar.cap);
+  exec_munmap (refs_ar.base, refs_ar.cap);
+  return batch_cnt;
+}
+
+static bool
+exec_path_is_literal_dir (const char *dir_path)
+{
+#ifdef __linux__
+  struct statx stx;
+  long sr = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, dir_path, 0,
+				   STATX_TYPE, &stx);
+  return sr == 0 && (stx.stx_mask & STATX_TYPE) != 0
+	 && S_ISDIR (stx.stx_mode);
+#else
+  struct __stat64_t64 st;
+  int saved = errno;
+  bool ok = __stat64_time64 (dir_path, &st) == 0 && S_ISDIR (st.st_mode);
+  __set_errno (saved);
+  return ok;
+#endif
+}
+
+/* Try wait-free FSWC expansion for "<prefix>/<star>/<subpath>" + FILE (when
+   FILE_LEN_WITH_NUL > 0) or "<prefix>/<star>/<relfile>" (when FILE_LEN_WITH_NUL == 0).
+   Returns 1 if handled via FSWC, -1 on fatal exec error, or 0 to fall back.  */
+static int
+try_fswc_wildcard_elem (const char *pat, size_t pat_len,
+			const char *file, size_t file_len_with_nul,
+			char *exec_buf, size_t exec_cap,
+			char *const argv[], char *const envp[],
+			bool exec_script, bool *got_eacces,
+			uint16_t *seen_slot_mask)
+{
+  if (pat_len < 2 || pat[0] != '/' || memchr (pat, '\\', pat_len) != NULL)
+    return 0;
+
+  const char *star = memchr (pat, '*', pat_len);
+  if (star == NULL || star == pat || star[-1] != '/')
+    return 0;
+  if (star + 1 < pat + pat_len && star[1] != '/')
+    return 0;
+
+  size_t prefix_len = (star - pat == 1) ? 1 : (size_t) (star - 1 - pat);
+  const char *suffix = (star + 1 < pat + pat_len) ? (star + 1) : "";
+  size_t suffix_len = (star + 1 < pat + pat_len)
+		      ? (size_t) ((pat + pat_len) - (star + 1)) : 0;
+
+  if (has_glob_meta (pat, prefix_len) || has_glob_meta (suffix, suffix_len))
+    return 0;
+
+  struct fswc_slot_snap *snap
+    = __fswc_peek_slot_waitfree (pat, prefix_len, seen_slot_mask);
+  if (snap == NULL
+      || (snap->snap_flags & FSWC_SNAP_NO_SQUASHFS) != 0
+      || (snap->snap_flags
+	  & (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+	 != (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+    return 0;
+
+  const struct fswc_view *v = &snap->view;
+  if (file_len_with_nul > 0)
+    {
+      if (__fswc_ht_lookup (v, FSWC_VDIR_PKGS, "*", 1) != NULL)
+	return 0;
+      for (uint32_t m = 0; m < snap->num_mutable_dirs; ++m)
+	{
+	  const struct fswc_top_entry *me = &snap->mutable_dirs[m];
+	  if (me->name_len == 1
+	      && snap->top_strtab[me->name_off] == '*')
+	    return 0;
+	}
+    }
+
+  /* Assemble "<subpath>/<file>" in exec_buf temporarily to resolve in FSWC.  */
+  size_t rel_len = 0;
+  const char *sp = suffix;
+  size_t sl = suffix_len;
+  while (sl > 0 && *sp == '/')
+    {
+      ++sp;
+      --sl;
+    }
+  while (sl > 0 && sp[sl - 1] == '/')
+    --sl;
+  if (sl + 1 + file_len_with_nul > exec_cap)
+    return 0;
+  if (sl > 0)
+    {
+      memcpy (exec_buf, sp, sl);
+      rel_len = sl;
+    }
+  if (file_len_with_nul > 1)
+    {
+      if (rel_len > 0)
+	exec_buf[rel_len++] = '/';
+      memcpy (exec_buf + rel_len, file, file_len_with_nul - 1);
+      rel_len += file_len_with_nul - 1;
+    }
+  if (rel_len == 0)
+    return 0;
+
+  struct fswc_relpath_result rres;
+  if (!__fswc_resolve_pkg_wild_relpath (snap, exec_buf, rel_len, &rres))
+    return 0;
+
+  uint32_t pi = 0;
+  uint32_t npkgs = v->hdr->num_pkgs;
+  uint32_t mi = 0;
+  uint32_t nmut = snap->num_mutable_dirs;
+  bool any_tried = false;
+
+  while (pi < npkgs || mi < nmut)
+    {
+      bool take_pkg;
+      if (pi < npkgs && mi < nmut)
+	{
+	  const struct fswc_pkg *pk = &v->pkgs[pi];
+	  const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+	  int cmp = exec_slice_cmp (v->strtab + pk->name_off, pk->name_len,
+				    snap->top_strtab + me->name_off,
+				    me->name_len);
+	  take_pkg = (cmp <= 0);
+	}
+      else
+	take_pkg = (pi < npkgs);
+
+      if (take_pkg)
+	{
+	  const struct fswc_pkg *pk = &v->pkgs[pi];
+	  uint32_t cur_pi = pi++;
+	  const char *pname = v->strtab + pk->name_off;
+	  if (pk->name_len == 0 || pname[0] == '.')
+	    continue;
+	  int dt = (rres.leaf_ent != NULL)
+		   ? __fswc_posting_find_pkg (v, rres.leaf_ent->all_cnt,
+					      rres.leaf_ent->all_ref, cur_pi)
+		   : -1;
+	  bool interm_lnk = __fswc_pkg_in_lnk_steps (v, &rres, cur_pi);
+	  bool immut = (pk->flags & FSWC_PKG_IMMUTABLE) != 0;
+	  bool pkg_search_ok = (pk->flags & FSWC_PKG_ALL_WORLD_SEARCH) != 0;
+	  if (!interm_lnk && immut
+	      && (!rres.restricted_search || pkg_search_ok))
+	    {
+	      if (dt < 0)
+		continue;
+	      if (file_len_with_nul == 0 && suffix_len > 0
+		  && suffix[suffix_len - 1] == '/'
+		  && dt != DT_DIR && dt != DT_LNK && dt != DT_UNKNOWN)
+		continue;
+	    }
+
+	  if (build_wildcard_exec_path (exec_buf, exec_cap,
+					pat, prefix_len,
+					pname, pk->name_len,
+					suffix, suffix_len,
+					file, file_len_with_nul) == 0)
+	    continue;
+	  if (try_exec_candidate (exec_buf, argv, envp,
+				  exec_script, got_eacces) < 0)
+	    return -1;
+	  if (errno != ENOENT && errno != ENOTDIR)
+	    any_tried = true;
+	}
+      else
+	{
+	  const struct fswc_top_entry *me = &snap->mutable_dirs[mi++];
+	  const char *mname = snap->top_strtab + me->name_off;
+	  if (me->name_len == 0 || mname[0] == '.')
+	    continue;
+	  if (build_wildcard_exec_path (exec_buf, exec_cap,
+					pat, prefix_len,
+					mname,
+					me->name_len,
+					suffix, suffix_len,
+					file, file_len_with_nul) == 0)
+	    continue;
+	  if (try_exec_candidate (exec_buf, argv, envp,
+				  exec_script, got_eacces) < 0)
+	    return -1;
+	  if (errno != ENOENT && errno != ENOTDIR)
+	    any_tried = true;
+	}
+    }
+
+  if (!any_tried && !*got_eacces)
+    __set_errno (ENOENT);
+  return 1;
+}
+
+static int
+run_uncached_wildcard_elem (const char *pat, size_t pat_len,
+			    const char *file, size_t file_len_with_nul,
+			    char *batch_buf, size_t batch_cap,
+			    char *const argv[], char *const envp[],
+			    bool exec_script, bool *got_eacces)
+{
+  char last_tried[PATH_MAX];
+  bool have_last = false;
+  bool any_seen = false;
+  bool any_tried = false;
+
+  while (1)
+    {
+      bool more = false;
+      size_t cnt = exec_collect_wildcard_batch (
+	pat, pat_len, 0, file, file_len_with_nul,
+	last_tried, have_last, batch_buf, batch_cap, &more, &any_seen);
+      if (cnt == 0)
+	break;
+
+      const char *cur = batch_buf;
+      for (size_t b = 0; b < cnt; ++b)
+	{
+	  size_t clen = strlen (cur) + 1;
+	  if (clen <= sizeof (last_tried))
+	    {
+	      memcpy (last_tried, cur, clen);
+	      have_last = true;
+	    }
+	  if (try_exec_candidate (cur, argv, envp,
+				  exec_script, got_eacces) < 0)
+	    return -1;
+	  if (errno != ENOENT && errno != ENOTDIR)
+	    any_tried = true;
+	  cur += clen;
+	}
+
+      if (!more || !have_last)
+	break;
+    }
+
+  if (!any_tried && !*got_eacces)
+    __set_errno (ENOENT);
+  return 0;
+}
+
+/* Find next ':' (or '\0') in a PATH list, skipping ':' inside closed
+   single-component bracket expressions such as [[:alpha:]] or [:].
+   Stops bracket lookahead at '/' or '\0' so an unclosed '[' in an earlier
+   directory never swallows the PATH separator.  */
+static const char *
+exec_next_path_colon (const char *cp)
+{
+  while (*cp != '\0')
+    {
+      if (*cp == '\\' && cp[1] != '\0' && cp[1] != ':' && cp[1] != '/')
+	{
+	  cp += 2;
+	  continue;
+	}
+      if (*cp == '[')
+	{
+	  const char *p = cp + 1;
+	  if (*p == '!' || *p == '^')
+	    ++p;
+	  if (*p == ']')
+	    ++p;
+	  while (*p != '\0' && *p != '/' && *p != ']')
+	    {
+	      if (*p == '\\' && p[1] != '\0' && p[1] != '/')
+		++p;
