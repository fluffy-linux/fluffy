+static bool
+dl_add_rpath_dir (const char *cp, size_t len,
+		  const char *what, const char *where,
+		  struct r_search_path_elem ***resultp, size_t *nelemsp,
+		  size_t *result_capp)
+{
+  struct r_search_path_elem *dirp;
+  for (dirp = GL(dl_all_dirs); dirp != NULL; dirp = dirp->next)
+    if (dirp->dirnamelen == len && memcmp (cp, dirp->dirname, len) == 0)
+      break;
+
+  if (*nelemsp + 2 > *result_capp)
+    {
+      size_t new_cap = *result_capp < 16 ? 32 : *result_capp * 2;
+      struct r_search_path_elem **new_res
+	= malloc (new_cap * sizeof (*new_res));
+      if (new_res == NULL)
+	return false;
+      memcpy (new_res, *resultp, *nelemsp * sizeof (*new_res));
+      free (*resultp);
+      *resultp = new_res;
+      *result_capp = new_cap;
+    }
+
+  struct r_search_path_elem **result = *resultp;
+  size_t nelems = *nelemsp;
+
+  if (dirp != NULL)
+    {
+      size_t cnt;
+      for (cnt = 0; cnt < nelems; ++cnt)
+	if (result[cnt] == dirp)
+	  break;
+      if (cnt == nelems)
+	result[(*nelemsp)++] = dirp;
+      return true;
+    }
+
+  size_t where_len = where != NULL ? strlen (where) + 1 : 0;
+  dirp = (struct r_search_path_elem *)
+    malloc (sizeof (*dirp) + ncapstr * sizeof (enum r_dir_status)
+	    + where_len + len + 1);
+  if (dirp == NULL)
+    return false;
+
+  dirp->dirname = ((char *) dirp + sizeof (*dirp)
+		   + ncapstr * sizeof (enum r_dir_status));
+  *((char *) __mempcpy ((char *) dirp->dirname, cp, len)) = '\0';
+  dirp->dirnamelen = len;
+  dirp->is_pkg_wildcard
+    = dl_parse_pkg_wildcard (cp, len, &dirp->wild_parent_len,
+			     &dirp->wild_prefix_slash_len,
+			     &dirp->wild_suffix_off);
+  if (!dirp->is_pkg_wildcard)
+    {
+      dirp->wild_parent_len = 0;
+      dirp->wild_prefix_slash_len = 0;
+      dirp->wild_suffix_off = 0;
+    }
+
+  size_t eff_max = dirp->is_pkg_wildcard ? (len - 1 + NAME_MAX) : len;
+  if (eff_max > max_dirnamelen)
+    max_dirnamelen = eff_max;
+
+  enum r_dir_status init_val
+    = (dirp->is_pkg_wildcard || cp[0] != '/') ? existing : unknown;
+  for (size_t cnt = 0; cnt < ncapstr; ++cnt)
+    dirp->status[cnt] = init_val;
+
+  dirp->what = what;
+  if (__glibc_likely (where != NULL))
+    dirp->where = memcpy ((char *) dirp + sizeof (*dirp) + len + 1
+			  + (ncapstr * sizeof (enum r_dir_status)),
+			  where, where_len);
+  else
+    dirp->where = NULL;
+
+  dirp->next = GL(dl_all_dirs);
+  GL(dl_all_dirs) = dirp;
+  result[(*nelemsp)++] = dirp;
+  return true;
+}
