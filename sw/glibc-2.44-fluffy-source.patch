+/* Anonymous mmap arena used for mtrace-clean dynamic wildcard directory
+   expansion (both open_path's non-FSWC fallback and dlinfo SERINFO).  */
+struct dl_mmap_arena
+{
+  uint8_t *base;
+  size_t used;
+  size_t cap;
+};
+
+static void
+dl_arena_free (struct dl_mmap_arena *ar)
+{
+  if (ar->base != NULL && ar->cap > 0)
+    __munmap (ar->base, ar->cap);
+  ar->base = NULL;
+  ar->used = 0;
+  ar->cap = 0;
+}
+
+static void *
+dl_arena_alloc (struct dl_mmap_arena *ar, size_t sz, size_t align)
+{
+  size_t mask = align - 1;
+  size_t off = (ar->used + mask) & ~mask;
+  if (off > SIZE_MAX - sz)
+    return NULL;
+  size_t need = off + sz;
+  if (need > ar->cap)
+    {
+      size_t pgsz = GLRO(dl_pagesize) ? GLRO(dl_pagesize) : 4096;
+      size_t ncap = ar->cap == 0 ? ALIGN_UP (4096, pgsz) : ar->cap * 2;
+      while (ncap < need)
+	{
+	  if (ncap > (1u << 26))
+	    return NULL;
+	  ncap *= 2;
+	}
+      ncap = ALIGN_UP (ncap, pgsz);
+      void *nb = __mmap (NULL, ncap, PROT_READ | PROT_WRITE,
+			 MAP_ANON | MAP_PRIVATE, -1, 0);
+      if (nb == MAP_FAILED)
+	return NULL;
+      if (ar->used > 0)
+	memcpy (nb, ar->base, ar->used);
+      if (ar->base != NULL && ar->cap > 0)
+	__munmap (ar->base, ar->cap);
+      ar->base = nb;
+      ar->cap = ncap;
+    }
+  ar->used = need;
+  return ar->base + off;
+}
