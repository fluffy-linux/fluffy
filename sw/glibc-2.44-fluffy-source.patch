+      h ^= (unsigned char) s[i];
+      h *= 16777619U;
+    }
+  return h == 0 ? 1 : h;
+}
+
+static inline uint64_t
+fc_mix64 (uint64_t x)
+{
+  x += 0x9e3779b97f4a7c15ULL;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+  return x ^ (x >> 31);
+}
+
+static const char *const fc_subdir_names[FC_NUM_SUBDIRS] =
+{
+  "bin", "lib", "etc", "include", "libexec"
+};
+
+static inline int
+fc_subdir_id (const char *name, size_t len)
+{
+  switch (len)
+    {
+    case 3:
+      if (memcmp (name, "bin", 3) == 0) return 0;
+      if (memcmp (name, "lib", 3) == 0) return 1;
+      if (memcmp (name, "etc", 3) == 0) return 2;
+      break;
+    case 7:
+      if (memcmp (name, "include", 7) == 0) return 3;
+      if (memcmp (name, "libexec", 7) == 0) return 4;
+      break;
+    }
+  return -1;
+}
+
+static char *
+fc_utoa (char *p, uint64_t v)
+{
+  char tmp[24];
+  int i = 0;
+  if (v == 0)
+    {
+      *p++ = '0';
+      return p;
+    }
+  while (v > 0)
+    {
+      tmp[i++] = (char) ('0' + (v % 10));
+      v /= 10;
+    }
+  while (i > 0)
+    *p++ = tmp[--i];
+  return p;
+}
+
+static void
+fc_format_shm_path (char *buf, const char *dir, uid_t euid, gid_t egid)
+{
+  size_t dlen = strlen (dir);
+  char *p = buf;
+  memcpy (p, dir, dlen);
+  p += dlen;
+  const char *base = "/.fluffy_glob_cache_v1_";
+  size_t blen = strlen (base);
+  memcpy (p, base, blen);
+  p += blen;
+  p = fc_utoa (p, (uint64_t) euid);
+  *p++ = '_';
+  p = fc_utoa (p, (uint64_t) egid);
+  *p = '\0';
+}
+
+static int
+fc_get_prefix_state (const char *prefix, struct statx *stx,
+                     uint32_t *out_mnt_count, uint64_t *out_h1, uint64_t *out_h2)
+{
+  long r = FC_SYSCALL (statx, AT_FDCWD, prefix, AT_STATX_SYNC_AS_STAT,
+                       STATX_BASIC_STATS | STATX_MNT_ID_UNIQUE, stx);
+  if (fc_syscall_err (r) || !S_ISDIR (stx->stx_mode)
+      || !(stx->stx_mask & STATX_MNT_ID_UNIQUE))
+    return -1;
+
+  struct fc_mnt_id_req req =
+    {
+      .size = 24,
+      .spare = 0,
+      .mnt_id = stx->stx_mnt_id,
+      .param = 0
+    };
+  uint64_t mnt_ids[512];
+  uint64_t h1 = 0, h2 = 0;
+  uint32_t total = 0;
+
+  while (1)
+    {
+      long n = FC_SYSCALL (listmount, &req, mnt_ids, 512, 0);
+      if (fc_syscall_err (n))
+        return -1;
+      for (long i = 0; i < n; ++i)
+        {
+          uint64_t m = fc_mix64 (mnt_ids[i]);
+          h1 += m;
+          h2 ^= (m << 19) | (m >> (64 - 19));
+        }
+      total += (uint32_t) n;
+      if (n < 512)
+        break;
+      req.param = mnt_ids[511];
+    }
+
+  *out_mnt_count = total;
+  *out_h1 = h1;
+  *out_h2 = h2;
+  return 0;
+}
+
+static bool
+fc_snapshot_matches (const struct fc_snapshot *snap, const char *prefix,
+                     size_t prefix_len, const struct statx *stx,
+                     uint32_t mnt_count, uint64_t h1, uint64_t h2)
+{
+  return (snap != NULL
+          && snap->magic == FC_MAGIC
+          && snap->prefix_len == prefix_len
+          && snap->prefix_mnt_id == stx->stx_mnt_id
+          && snap->mnt_count == mnt_count
+          && snap->mnt_hash1 == h1
+          && snap->mnt_hash2 == h2
+          && snap->prefix_dev_major == stx->stx_dev_major
+          && snap->prefix_dev_minor == stx->stx_dev_minor
+          && snap->prefix_ino == stx->stx_ino
+          && snap->prefix_ctime_sec == stx->stx_ctime.tv_sec
+          && snap->prefix_ctime_nsec == stx->stx_ctime.tv_nsec
+          && snap->prefix_mtime_sec == stx->stx_mtime.tv_sec
+          && snap->prefix_mtime_nsec == stx->stx_mtime.tv_nsec
+          && memcmp (snap->prefix, prefix, prefix_len) == 0);
+}
+
+static int
+fc_intern_str (struct fc_snapshot *snap, const char *s, size_t len,
+               uint32_t *out_off)
+{
+  if (snap->strtab_used + len + 1 > FC_STRTAB_SIZE)
+    return -1;
+  uint32_t off = snap->strtab_used;
+  memcpy (snap->strtab + off, s, len);
+  snap->strtab[off + len] = '\0';
+  snap->strtab_used += (uint32_t) (len + 1);
+  *out_off = off;
+  return 0;
+}
+
+static int
+fc_insert_top (struct fc_snapshot *snap, uint32_t pkg_idx,
+               const char *name, size_t len, uint8_t is_dir,
+               bool record_dirent)
+{
+  if (len == 0 || len > 0xffff)
+    return -1;
+  uint32_t h = fc_hash_str (0, name, len);
+  uint32_t idx = h & (FC_TOP_HT_SIZE - 1);
+  for (uint32_t step = 0; step < FC_TOP_HT_SIZE; ++step)
+    {
+      struct fc_top_bucket *b = &snap->top_ht[idx];
+      if (b->hash == 0)
+        {
+          uint32_t off;
+          if (fc_intern_str (snap, name, len, &off) < 0)
+            return -1;
+          b->hash = h;
+          b->name_off = off;
+          b->name_len = (uint16_t) len;
+          b->all_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (is_dir)
+            b->dir_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (record_dirent)
+            {
+              if (snap->num_dirents >= FC_MAX_DIRENTS)
+                return -1;
+              struct fc_dirent *de = &snap->dirents[snap->num_dirents++];
+              de->name_off = off;
+              de->name_len = (uint16_t) len;
+              de->is_dir = is_dir;
+              de->sub1_id = 0xff;
+            }
+          return 0;
+        }
+      if (b->hash == h && b->name_len == len
+          && b->name_off + len < FC_STRTAB_SIZE
+          && memcmp (snap->strtab + b->name_off, name, len) == 0)
+        {
+          b->all_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (is_dir)
+            b->dir_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (record_dirent)
+            {
+              if (snap->num_dirents >= FC_MAX_DIRENTS)
+                return -1;
+              struct fc_dirent *de = &snap->dirents[snap->num_dirents++];
+              de->name_off = b->name_off;
+              de->name_len = (uint16_t) len;
+              de->is_dir = is_dir;
+              de->sub1_id = 0xff;
+            }
+          return 0;
+        }
+      idx = (idx + 1) & (FC_TOP_HT_SIZE - 1);
+    }
+  return -1;
+}
+
+static int
+fc_insert_sub (struct fc_snapshot *snap, uint32_t pkg_idx, uint8_t sub1_id,
+               const char *name, size_t len, uint8_t is_dir,
+               bool record_dirent)
+{
+  if (len == 0 || len > 0xffff)
+    return -1;
+  uint32_t h = fc_hash_str ((uint32_t) sub1_id + 1, name, len);
+  uint32_t idx = h & (FC_SUB_HT_SIZE - 1);
+  for (uint32_t step = 0; step < FC_SUB_HT_SIZE; ++step)
+    {
+      struct fc_sub_bucket *b = &snap->sub_ht[idx];
+      if (b->hash == 0)
+        {
+          uint32_t off;
+          if (fc_intern_str (snap, name, len, &off) < 0)
+            return -1;
+          b->hash = h;
+          b->name_off = off;
+          b->name_len = (uint16_t) len;
+          b->sub1_id = sub1_id;
+          b->all_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (is_dir)
+            b->dir_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (record_dirent)
+            {
+              if (snap->num_dirents >= FC_MAX_DIRENTS)
+                return -1;
+              struct fc_dirent *de = &snap->dirents[snap->num_dirents++];
+              de->name_off = off;
+              de->name_len = (uint16_t) len;
+              de->is_dir = is_dir;
+              de->sub1_id = sub1_id;
+            }
+          return 0;
+        }
+      if (b->hash == h && b->sub1_id == sub1_id && b->name_len == len
+          && b->name_off + len < FC_STRTAB_SIZE
+          && memcmp (snap->strtab + b->name_off, name, len) == 0)
+        {
+          b->all_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (is_dir)
+            b->dir_mask.bits[pkg_idx / 64] |= (1ULL << (pkg_idx % 64));
+          if (record_dirent)
+            {
+              if (snap->num_dirents >= FC_MAX_DIRENTS)
+                return -1;
+              struct fc_dirent *de = &snap->dirents[snap->num_dirents++];
+              de->name_off = b->name_off;
+              de->name_len = (uint16_t) len;
+              de->is_dir = is_dir;
+              de->sub1_id = sub1_id;
+            }
+          return 0;
+        }
+      idx = (idx + 1) & (FC_SUB_HT_SIZE - 1);
+    }
+  return -1;
+}
+
+static inline const struct fc_top_bucket *
+fc_lookup_top (const struct fc_snapshot *snap, const char *name, size_t len)
+{
+  uint32_t h = fc_hash_str (0, name, len);
+  uint32_t idx = h & (FC_TOP_HT_SIZE - 1);
+  for (uint32_t step = 0; step < FC_TOP_HT_SIZE; ++step)
+    {
+      const struct fc_top_bucket *b = &snap->top_ht[idx];
+      if (b->hash == 0)
+        return NULL;
+      if (b->hash == h && b->name_len == len
+          && memcmp (snap->strtab + b->name_off, name, len) == 0)
+        return b;
+      idx = (idx + 1) & (FC_TOP_HT_SIZE - 1);
+    }
+  return NULL;
+}
+
+static inline const struct fc_sub_bucket *
+fc_lookup_sub (const struct fc_snapshot *snap, uint8_t sub1_id,
+               const char *name, size_t len)
+{
+  uint32_t h = fc_hash_str ((uint32_t) sub1_id + 1, name, len);
+  uint32_t idx = h & (FC_SUB_HT_SIZE - 1);
+  for (uint32_t step = 0; step < FC_SUB_HT_SIZE; ++step)
+    {
+      const struct fc_sub_bucket *b = &snap->sub_ht[idx];
+      if (b->hash == 0)
+        return NULL;
+      if (b->hash == h && b->sub1_id == sub1_id && b->name_len == len
+          && memcmp (snap->strtab + b->name_off, name, len) == 0)
+        return b;
+      idx = (idx + 1) & (FC_SUB_HT_SIZE - 1);
+    }
+  return NULL;
+}
+
+static uint8_t
+fc_dirent_is_dir (int dfd, const struct fc_linux_dirent64 *d)
+{
+  if (d->d_type == DT_DIR)
+    return 1;
+  if (d->d_type != DT_LNK && d->d_type != DT_UNKNOWN)
+    return 0;
+  struct statx stx;
+  long r = FC_SYSCALL (statx, dfd, d->d_name, 0, STATX_TYPE, &stx);
+  return (!fc_syscall_err (r) && S_ISDIR (stx.stx_mode)) ? 1 : 0;
+}
+
+static int
+fc_build_snapshot (struct fc_snapshot *snap,
+                   const struct fc_snapshot *old_snap,
+                   const char *prefix, size_t prefix_len,
+                   const struct statx *prefix_stx,
+                   uint32_t mnt_count, uint64_t h1, uint64_t h2)
+{
+  if (prefix_len == 0 || prefix_len >= sizeof (snap->prefix))
+    return -1;
+
+  memset (snap, 0, offsetof (struct fc_snapshot, dirents));
+  snap->magic = FC_MAGIC;
+  snap->prefix_len = (uint32_t) prefix_len;
+  memcpy (snap->prefix, prefix, prefix_len + 1);
+  snap->prefix_mnt_id = prefix_stx->stx_mnt_id;
+  snap->prefix_dev_major = prefix_stx->stx_dev_major;
+  snap->prefix_dev_minor = prefix_stx->stx_dev_minor;
+  snap->prefix_ino = prefix_stx->stx_ino;
+  snap->prefix_ctime_sec = prefix_stx->stx_ctime.tv_sec;
+  snap->prefix_ctime_nsec = prefix_stx->stx_ctime.tv_nsec;
+  snap->prefix_mtime_sec = prefix_stx->stx_mtime.tv_sec;
+  snap->prefix_mtime_nsec = prefix_stx->stx_mtime.tv_nsec;
+  snap->mnt_count = mnt_count;
+  snap->mnt_hash1 = h1;
+  snap->mnt_hash2 = h2;
+
+  long pfd_l = FC_SYSCALL (openat, AT_FDCWD, prefix,
+                           O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+  if (fc_syscall_err (pfd_l))
+    return -1;
+  int pfd = (int) pfd_l;
+
+  char dent_buf[8192];
+  uint32_t npkgs = 0;
+
+  while (1)
+    {
+      long nread = FC_SYSCALL (getdents64, pfd, dent_buf, sizeof (dent_buf));
+      if (fc_syscall_err (nread))
+        {
+          FC_SYSCALL (close, pfd);
+          return -1;
+        }
+      if (nread == 0)
+        break;
+
+      for (long bpos = 0; bpos < nread; )
+        {
+          struct fc_linux_dirent64 *d
+            = (struct fc_linux_dirent64 *) (dent_buf + bpos);
+          bpos += d->d_reclen;
+          if (d->d_name[0] == '.')
+            continue;
+          if (d->d_type != DT_DIR && d->d_type != DT_LNK
+              && d->d_type != DT_UNKNOWN)
+            continue;
+
+          size_t namelen = strlen (d->d_name);
+          if (namelen == 0 || namelen >= FC_MAX_PKG_NAME)
+            {
+              FC_SYSCALL (close, pfd);
+              return -1;
+            }
+          if (npkgs >= FC_MAX_PKGS)
+            {
+              FC_SYSCALL (close, pfd);
+              return -1;
+            }
+
+          uint32_t pos = npkgs;
+          while (pos > 0 && strcmp (snap->pkg_names[pos - 1], d->d_name) > 0)
+            {
+              memcpy (snap->pkg_names[pos], snap->pkg_names[pos - 1],
+                      FC_MAX_PKG_NAME);
+              --pos;
+            }
+          memcpy (snap->pkg_names[pos], d->d_name, namelen + 1);
+          ++npkgs;
+        }
+    }
+
+  uint32_t valid_pkgs = 0;
+  uint32_t num_squashfs = 0;
+
+  for (uint32_t i = 0; i < npkgs; ++i)
+    {
+      const char *pkg_name = snap->pkg_names[i];
+      struct statx cstx;
+      long sr = FC_SYSCALL (statx, pfd, pkg_name, 0,
+                            STATX_BASIC_STATS | STATX_MNT_ID_UNIQUE, &cstx);
+      if (fc_syscall_err (sr) || !S_ISDIR (cstx.stx_mode))
+        continue;
+
+      uint32_t pkg_idx = valid_pkgs;
+      if (pkg_idx != i)
+        memcpy (snap->pkg_names[pkg_idx], pkg_name, FC_MAX_PKG_NAME);
+      pkg_name = snap->pkg_names[pkg_idx];
+
+      struct fc_pkg_meta *meta = &snap->pkg_meta[pkg_idx];
+      memset (meta, 0, sizeof (*meta));
+      meta->dev_major = cstx.stx_dev_major;
+      meta->dev_minor = cstx.stx_dev_minor;
+      meta->ino = cstx.stx_ino;
+      meta->mtime_sec = cstx.stx_mtime.tv_sec;
+      meta->mtime_nsec = cstx.stx_mtime.tv_nsec;
+
+#ifndef FC_BENCH_ALLOW_TMPFS
+      if (cstx.stx_mnt_id == prefix_stx->stx_mnt_id
+          && cstx.stx_dev_major == prefix_stx->stx_dev_major
+          && cstx.stx_dev_minor == prefix_stx->stx_dev_minor)
+        {
+          /* Unmounted directory on prefix's filesystem.  If empty (size == 0 on
+             btrfs), record as empty mountpoint; otherwise verify via getdents64.  */
+          if (cstx.stx_size == 0)
+            {
+              meta->is_squashfs = 0;
+              ++valid_pkgs;
+              continue;
+            }
+          long cfd_l = FC_SYSCALL (openat, pfd, pkg_name,
+                                   O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+          if (fc_syscall_err (cfd_l))
+            {
+              FC_SYSCALL (close, pfd);
+              return -1;
+            }
+          int cfd = (int) cfd_l;
+          bool empty = true;
+          long nr = FC_SYSCALL (getdents64, cfd, dent_buf, sizeof (dent_buf));
+          if (!fc_syscall_err (nr) && nr > 0)
+            {
+              for (long bp = 0; bp < nr; )
+                {
+                  struct fc_linux_dirent64 *cd
+                    = (struct fc_linux_dirent64 *) (dent_buf + bp);
+                  bp += cd->d_reclen;
+                  if (cd->d_name[0] == '.'
+                      && (cd->d_name[1] == '\0'
+                          || (cd->d_name[1] == '.' && cd->d_name[2] == '\0')))
+                    continue;
+                  empty = false;
+                  break;
+                }
+            }
+          FC_SYSCALL (close, cfd);
+          if (!empty)
+            {
+              /* Non-empty non-mounted mutable child directory: do not cache.  */
+              FC_SYSCALL (close, pfd);
+              return -1;
+            }
+          meta->is_squashfs = 0;
+          ++valid_pkgs;
+          continue;
+        }
+#endif
+
+      if ((cstx.stx_mode & 0005) != 0005)
+        {
+          FC_SYSCALL (close, pfd);
+          return -1;
+        }
+
+      /* Layer 1 lookup: check if this SquashFS superblock is already cached
+         in old_snap.  */
+      bool reused_l1 = false;
+      if (old_snap != NULL && old_snap->magic == FC_MAGIC)
+        {
+          for (uint32_t oi = 0; oi < old_snap->num_pkgs; ++oi)
+            {
+              const struct fc_pkg_meta *om = &old_snap->pkg_meta[oi];
+              if (om->is_squashfs
+                  && om->dev_major == meta->dev_major
+                  && om->dev_minor == meta->dev_minor
+                  && om->ino == meta->ino
+                  && om->mtime_sec == meta->mtime_sec
+                  && om->mtime_nsec == meta->mtime_nsec
+#ifdef FC_BENCH_ALLOW_TMPFS
+                  && strcmp (old_snap->pkg_names[oi], pkg_name) == 0
+#endif
+                 )
+                {
+                  meta->is_squashfs = 1;
+                  meta->top_start = snap->num_dirents;
+                  meta->top_count = om->top_count;
+                  for (uint16_t k = 0; k < om->top_count; ++k)
+                    {
+                      const struct fc_dirent *ode
+                        = &old_snap->dirents[om->top_start + k];
+                      const char *ename = old_snap->strtab + ode->name_off;
+                      if (fc_insert_top (snap, pkg_idx, ename, ode->name_len,
+                                         ode->is_dir, true) < 0)
+                        {
+                          FC_SYSCALL (close, pfd);
+                          return -1;
+                        }
+                    }
+                  for (uint8_t s = 0; s < FC_NUM_SUBDIRS; ++s)
+                    {
+                      meta->sub_start[s] = snap->num_dirents;
+                      meta->sub_count[s] = om->sub_count[s];
+                      for (uint16_t k = 0; k < om->sub_count[s]; ++k)
+                        {
+                          const struct fc_dirent *ode
+                            = &old_snap->dirents[om->sub_start[s] + k];
+                          const char *ename = old_snap->strtab + ode->name_off;
+                          if (fc_insert_sub (snap, pkg_idx, s, ename,
+                                             ode->name_len, ode->is_dir,
+                                             true) < 0)
+                            {
+                              FC_SYSCALL (close, pfd);
+                              return -1;
+                            }
+                        }
+                    }
+                  reused_l1 = true;
+                  ++num_squashfs;
+                  break;
+                }
+            }
+        }
+
+      if (reused_l1)
+        {
+          ++valid_pkgs;
+          continue;
+        }
+
+      /* Layer 1 miss: open package mount, verify SQUASHFS_MAGIC, and scan.  */
+      long pkg_fd_l = FC_SYSCALL (openat, pfd, pkg_name,
+                                  O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+      if (fc_syscall_err (pkg_fd_l))
+        {
+          FC_SYSCALL (close, pfd);
+          return -1;
+        }
+      int pkg_fd = (int) pkg_fd_l;
+
+      struct fc_kernel_statfs sfs;
+      long sfr = FC_SYSCALL (fstatfs, pkg_fd, &sfs);
+      if (fc_syscall_err (sfr)
+#ifndef FC_BENCH_ALLOW_TMPFS
+          || (unsigned long) sfs.f_type != FC_SQUASHFS_MAGIC
+#endif
+         )
+        {
+          FC_SYSCALL (close, pkg_fd);
+          FC_SYSCALL (close, pfd);
+          return -1;
+        }
+
+      meta->is_squashfs = 1;
+      meta->top_start = snap->num_dirents;
+      uint16_t top_cnt = 0;
+      uint8_t has_sub_dir[FC_NUM_SUBDIRS] = { 0 };
+
+      while (1)
+        {
+          long nr = FC_SYSCALL (getdents64, pkg_fd, dent_buf, sizeof (dent_buf));
+          if (fc_syscall_err (nr))
+            {
+              FC_SYSCALL (close, pkg_fd);
+              FC_SYSCALL (close, pfd);
+              return -1;
+            }
+          if (nr == 0)
+            break;
+          for (long bp = 0; bp < nr; )
+            {
+              struct fc_linux_dirent64 *d
+                = (struct fc_linux_dirent64 *) (dent_buf + bp);
+              bp += d->d_reclen;
+              if (d->d_name[0] == '.'
+                  && (d->d_name[1] == '\0'
+                      || (d->d_name[1] == '.' && d->d_name[2] == '\0')))
+                continue;
+              size_t dlen = strlen (d->d_name);
+              uint8_t is_dir = fc_dirent_is_dir (pkg_fd, d);
+              if (fc_insert_top (snap, pkg_idx, d->d_name, dlen, is_dir, true) < 0)
+                {
+                  FC_SYSCALL (close, pkg_fd);
+                  FC_SYSCALL (close, pfd);
+                  return -1;
+                }
+              ++top_cnt;
+              if (is_dir)
+                {
+                  int sid = fc_subdir_id (d->d_name, dlen);
+                  if (sid >= 0)
+                    has_sub_dir[sid] = 1;
+                }
+            }
+        }
+      meta->top_count = top_cnt;
+
+      for (uint8_t s = 0; s < FC_NUM_SUBDIRS; ++s)
+        {
+          meta->sub_start[s] = snap->num_dirents;
+          meta->sub_count[s] = 0;
+          if (!has_sub_dir[s])
+            continue;
+
+          long sfd_l = FC_SYSCALL (openat, pkg_fd, fc_subdir_names[s],
+                                   O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+          if (fc_syscall_err (sfd_l))
+            continue;
+          int sfd = (int) sfd_l;
+          uint16_t scnt = 0;
+
+          while (1)
+            {
+              long nr = FC_SYSCALL (getdents64, sfd, dent_buf, sizeof (dent_buf));
+              if (fc_syscall_err (nr) || nr == 0)
+                break;
+              for (long bp = 0; bp < nr; )
+                {
+                  struct fc_linux_dirent64 *d
+                    = (struct fc_linux_dirent64 *) (dent_buf + bp);
+                  bp += d->d_reclen;
+                  if (d->d_name[0] == '.'
+                      && (d->d_name[1] == '\0'
+                          || (d->d_name[1] == '.' && d->d_name[2] == '\0')))
+                    continue;
+                  size_t dlen = strlen (d->d_name);
+                  uint8_t is_dir = fc_dirent_is_dir (sfd, d);
+                  if (fc_insert_sub (snap, pkg_idx, s, d->d_name, dlen,
+                                     is_dir, true) < 0)
+                    {
+                      FC_SYSCALL (close, sfd);
+                      FC_SYSCALL (close, pkg_fd);
+                      FC_SYSCALL (close, pfd);
+                      return -1;
+                    }
+                  ++scnt;
+                }
+            }
+          FC_SYSCALL (close, sfd);
+          meta->sub_count[s] = scnt;
+        }
+
+      FC_SYSCALL (close, pkg_fd);
+      ++num_squashfs;
+      ++valid_pkgs;
+    }
+
+  FC_SYSCALL (close, pfd);
+  if (num_squashfs == 0)
+    return -1;
+
+  snap->num_pkgs = valid_pkgs;
+  return 0;
+}
+
+static void
+fc_write_shm_snapshot (const struct fc_snapshot *snap, uid_t euid, gid_t egid)
+{
+  static const char *const dirs[2] = { "/dev/shm", "/tmp" };
+  long pid = FC_SYSCALL0 (getpid);
+  long tid = FC_SYSCALL0 (gettid);
+
+  for (int d = 0; d < 2; ++d)
+    {
+      char final_path[128];
+      char tmp_path[160];
+      fc_format_shm_path (final_path, dirs[d], euid, egid);
+      size_t flen = strlen (final_path);
+      memcpy (tmp_path, final_path, flen);
+      char *p = tmp_path + flen;
+      memcpy (p, ".tmp.", 5);
+      p += 5;
+      p = fc_utoa (p, (uint64_t) pid);
+      *p++ = '.';
+      p = fc_utoa (p, (uint64_t) tid);
+      *p = '\0';
+
+      long fd_l = FC_SYSCALL (openat, AT_FDCWD, tmp_path,
+                              O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW,
+                              0600);
+      if (fc_syscall_err (fd_l))
+        continue;
+      int fd = (int) fd_l;
+
+      const char *buf = (const char *) snap;
+      size_t rem = sizeof (*snap);
+      bool ok = true;
+      while (rem > 0)
+        {
+          long nw = FC_SYSCALL (write, fd, buf, rem);
+          if (fc_syscall_err (nw) || nw == 0)
+            {
+              ok = false;
+              break;
+            }
+          buf += nw;
+          rem -= (size_t) nw;
+        }
+      FC_SYSCALL (close, fd);
+
+      if (ok)
+        {
+          long rr = FC_SYSCALL (renameat, AT_FDCWD, tmp_path,
+                                AT_FDCWD, final_path);
+          if (!fc_syscall_err (rr))
+            return;
+        }
+      FC_SYSCALL (unlinkat, AT_FDCWD, tmp_path, 0);
+    }
+}
+
+static struct fc_snapshot *
+fc_map_shm_snapshot (uid_t euid, gid_t egid)
+{
+  static const char *const dirs[2] = { "/dev/shm", "/tmp" };
+  for (int d = 0; d < 2; ++d)
+    {
+      char final_path[128];
+      fc_format_shm_path (final_path, dirs[d], euid, egid);
+      long fd_l = FC_SYSCALL (openat, AT_FDCWD, final_path,
+                              O_RDONLY | O_CLOEXEC | O_NOFOLLOW, 0);
+      if (fc_syscall_err (fd_l))
+        continue;
+      int fd = (int) fd_l;
+
+      struct statx stx;
+      long sr = FC_SYSCALL (statx, fd, "", AT_EMPTY_PATH,
+                            STATX_BASIC_STATS, &stx);
+      if (!fc_syscall_err (sr)
+          && stx.stx_uid == euid
+          && (stx.stx_mode & 0077) == 0
+          && stx.stx_size == sizeof (struct fc_snapshot))
+        {
+          long m = FC_SYSCALL (mmap, 0, sizeof (struct fc_snapshot),
+                               PROT_READ, MAP_SHARED, fd, 0);
+          FC_SYSCALL (close, fd);
+          if (!fc_syscall_err (m))
+            {
+              struct fc_snapshot *s = (struct fc_snapshot *) m;
+              if (s->magic == FC_MAGIC)
+                return s;
+              FC_SYSCALL (munmap, s, sizeof (struct fc_snapshot));
+            }
+        }
+      else
+        FC_SYSCALL (close, fd);
+    }
+  return NULL;
+}
+
+#ifdef FC_WITH_GLOB_HELPERS
+# ifdef _LIBC
+__libc_lock_define_initialized (static, fc_lock);
+# endif
+static struct fc_snapshot *fc_cur_snap = NULL;
+static uid_t fc_cur_euid = (uid_t) -1;
+static gid_t fc_cur_egid = (gid_t) -1;
+static uint64_t fc_non_sq_mnt_id = 0;
+static uint64_t fc_non_sq_ino = 0;
+
+static const struct fc_snapshot *
+fc_get_snapshot (const char *prefix, size_t prefix_len)
+{
+  if (prefix_len == 0 || prefix_len >= 256)
+    return NULL;
+
+  struct statx stx;
+  uint32_t mnt_count = 0;
+  uint64_t mnt_h1 = 0, mnt_h2 = 0;
+  if (fc_get_prefix_state (prefix, &stx, &mnt_count, &mnt_h1, &mnt_h2) < 0)
+    return NULL;
+
+  if (stx.stx_mnt_id == fc_non_sq_mnt_id && stx.stx_ino == fc_non_sq_ino)
+    return NULL;
+
+  uid_t euid = (uid_t) FC_SYSCALL0 (geteuid);
+  gid_t egid = (gid_t) FC_SYSCALL0 (getegid);
+
+  if (fc_cur_snap != NULL
+      && fc_cur_euid == euid
+      && fc_cur_egid == egid
+      && fc_snapshot_matches (fc_cur_snap, prefix, prefix_len, &stx,
+                              mnt_count, mnt_h1, mnt_h2))
+    return fc_cur_snap;
+
+  struct fc_snapshot *shm_snap = fc_map_shm_snapshot (euid, egid);
+  if (shm_snap != NULL)
+    {
+      if (fc_cur_snap != NULL)
+        FC_SYSCALL (munmap, fc_cur_snap, sizeof (struct fc_snapshot));
+      fc_cur_snap = shm_snap;
+      fc_cur_euid = euid;
+      fc_cur_egid = egid;
+      if (fc_snapshot_matches (fc_cur_snap, prefix, prefix_len, &stx,
+                              mnt_count, mnt_h1, mnt_h2))
+        return fc_cur_snap;
+    }
+
+  long m = FC_SYSCALL (mmap, 0, sizeof (struct fc_snapshot),
+                       PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (fc_syscall_err (m))
+    return NULL;
+  struct fc_snapshot *new_snap = (struct fc_snapshot *) m;
+
+  if (fc_build_snapshot (new_snap, fc_cur_snap, prefix, prefix_len,
+                         &stx, mnt_count, mnt_h1, mnt_h2) < 0)
+    {
+      FC_SYSCALL (munmap, new_snap, sizeof (struct fc_snapshot));
+      fc_non_sq_mnt_id = stx.stx_mnt_id;
+      fc_non_sq_ino = stx.stx_ino;
+      return NULL;
+    }
+
+  fc_write_shm_snapshot (new_snap, euid, egid);
+  if (fc_cur_snap != NULL)
+    FC_SYSCALL (munmap, fc_cur_snap, sizeof (struct fc_snapshot));
+  fc_cur_snap = new_snap;
+  fc_cur_euid = euid;
+  fc_cur_egid = egid;
+  return fc_cur_snap;
+}
+
+static int
+fc_append_match (glob_t *pglob, const char *prefix, size_t prefix_len,
+                 const char *pkg, size_t pkg_len,
+                 const char *sub1, size_t sub1_len,
+                 const char *sub2, size_t sub2_len,
+                 bool add_slash)
+{
+  size_t newcount = pglob->gl_pathc + pglob->gl_offs;
+  if (newcount > SIZE_MAX / sizeof (char *) - 2)
+    return GLOB_NOSPACE;
+  char **new_pathv = realloc (pglob->gl_pathv,
+                              (newcount + 2) * sizeof (char *));
+  if (new_pathv == NULL)
+    return GLOB_NOSPACE;
+  pglob->gl_pathv = new_pathv;
+
+  size_t p_eff = (prefix_len == 1 && prefix[0] == '/') ? 0 : prefix_len;
+  size_t total_len = (p_eff + 1 + pkg_len + 1 + sub1_len
+                      + (sub2 != NULL ? 1 + sub2_len : 0)
+                      + (add_slash ? 1 : 0));
+  char *str = malloc (total_len + 1);
+  if (str == NULL)
+    return GLOB_NOSPACE;
+
+  char *q = str;
+  if (p_eff > 0)
+    {
+      memcpy (q, prefix, p_eff);
+      q += p_eff;
+    }
+  *q++ = '/';
+  memcpy (q, pkg, pkg_len);
+  q += pkg_len;
+  *q++ = '/';
+  memcpy (q, sub1, sub1_len);
+  q += sub1_len;
+  if (sub2 != NULL)
+    {
+      *q++ = '/';
+      memcpy (q, sub2, sub2_len);
+      q += sub2_len;
+    }
+  if (add_slash)
+    *q++ = '/';
+  *q = '\0';
+
+  pglob->gl_pathv[newcount] = str;
+  pglob->gl_pathv[newcount + 1] = NULL;
+  ++pglob->gl_pathc;
+  return 0;
+}
+
+static int
+fc_emit_mask_matches (const struct fc_snapshot *snap,
+                      const struct fc_mask *mask,
+                      const struct fc_mask *dmask,
+                      const char *prefix, size_t prefix_len,
+                      const char *sub1, size_t sub1_len,
+                      const char *sub2, size_t sub2_len,
+                      int flags, glob_t *pglob)
+{
+  size_t nfound = 0;
+  for (size_t w = 0; w < FC_MAX_PKGS / 64; ++w)
+    nfound += (size_t) __builtin_popcountll (mask->bits[w]);
+  if (nfound == 0)
+    return 0;
+
+  size_t cur_idx = pglob->gl_pathc + pglob->gl_offs;
+  if (cur_idx > SIZE_MAX / sizeof (char *) - nfound - 2)
+    return GLOB_NOSPACE;
+  char **new_pathv = realloc (pglob->gl_pathv,
+                              (cur_idx + nfound + 1) * sizeof (char *));
+  if (new_pathv == NULL)
+    return GLOB_NOSPACE;
+  pglob->gl_pathv = new_pathv;
+
+  size_t p_eff = (prefix_len == 1 && prefix[0] == '/') ? 0 : prefix_len;
+
+  for (size_t w = 0; w < FC_MAX_PKGS / 64; ++w)
+    {
+      uint64_t word = mask->bits[w];
+      while (word != 0)
+        {
+          unsigned int bit = (unsigned int) __builtin_ctzll (word);
+          word &= word - 1;
+          uint32_t pkg_idx = (uint32_t) (w * 64 + bit);
+          const char *pkg = snap->pkg_names[pkg_idx];
+          size_t pkg_len = strlen (pkg);
+          bool add_slash = ((flags & GLOB_MARK)
+                            && (dmask->bits[w] & (1ULL << bit)) != 0);
+          size_t total_len = (p_eff + 1 + pkg_len + 1 + sub1_len
+                              + (sub2 != NULL ? 1 + sub2_len : 0)
+                              + (add_slash ? 1 : 0));
+          char *str = malloc (total_len + 1);
+          if (str == NULL)
+            {
+              pglob->gl_pathv[pglob->gl_pathc + pglob->gl_offs] = NULL;
+              return GLOB_NOSPACE;
+            }
+          char *q = str;
+          if (p_eff > 0)
+            {
+              memcpy (q, prefix, p_eff);
+              q += p_eff;
+            }
+          *q++ = '/';
+          memcpy (q, pkg, pkg_len);
+          q += pkg_len;
+          *q++ = '/';
+          memcpy (q, sub1, sub1_len);
+          q += sub1_len;
+          if (sub2 != NULL)
+            {
+              *q++ = '/';
+              memcpy (q, sub2, sub2_len);
+              q += sub2_len;
+            }
+          if (add_slash)
+            *q++ = '/';
+          *q = '\0';
+
+          pglob->gl_pathv[pglob->gl_offs + pglob->gl_pathc++] = str;
+        }
+    }
+  pglob->gl_pathv[pglob->gl_offs + pglob->gl_pathc] = NULL;
+  return 0;
+}
+#endif /* FC_WITH_GLOB_HELPERS */
