+  uint64_t pkg_id_lo;
+  uint64_t pkg_id_hi;
+  uint32_t pkg_flags;
+  uint32_t num_dirs;
+  uint32_t num_entries;
+  uint32_t strtab_size;
+  uint32_t dirs_off;
+  uint32_t entries_off;
+  uint32_t strtab_off;
+  uint32_t reserved;
+};
+
+struct fswc_pkg_cache_dir
+{
