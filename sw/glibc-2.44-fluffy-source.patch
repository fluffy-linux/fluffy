+struct fswc_glob_ctx
+{
+  const struct fswc_slot_snap *snap;
+  const struct fswc_view *v;
+  const struct fswc_glob_comp *comps;
+  size_t ncomps;
+  int flags;
+  int fnm_flags;
+  int interm_flags;
+  int interm_fnm_flags;
+  bool orig_dir_magic;
+  int (*errfunc) (const char *, int);
+  glob_t *pglob;
+  __glob_homedir_fn_t homedir_fn;
+};
+
+static int
+fswc_delegate_subglob (const struct fswc_glob_ctx *ctx,
+                       const char *lit_base, size_t lit_base_len,
+                       size_t from_comp)
+{
+  const struct fswc_glob_comp *c = &ctx->comps[from_comp];
+  bool is_last = (from_comp + 1 == ctx->ncomps);
+
+  if (is_last)
+    {
+      if (c->is_starstar)
+        {
+          if (glob_testdir (lit_base, ctx->flags, ctx->pglob, false) < 0)
+            return 0;
+
+          char sdir_buf[PATH_MAX];
+          const char *sdir = lit_base;
+          if (!ctx->orig_dir_magic && lit_base_len > 0
+              && lit_base[lit_base_len - 1] != '/'
+              && lit_base_len + 1 < sizeof (sdir_buf))
+            {
+              memcpy (sdir_buf, lit_base, lit_base_len);
+              sdir_buf[lit_base_len] = '/';
+              sdir_buf[lit_base_len + 1] = '\0';
+              sdir = sdir_buf;
+            }
+
+          size_t mark_start = ctx->pglob->gl_pathc + ctx->pglob->gl_offs;
+          int r = globstar_scan (sdir, ctx->flags, GS_ADDCURDIR,
+                                 ctx->errfunc, ctx->pglob);
+          if (r != 0)
+            return r;
+          return fswc_apply_glob_mark_slice (ctx->pglob, ctx->flags, mark_start);
+        }
+
+      if ((ctx->flags & GLOB_GLOBSTAR)
+          && glob_testdir (lit_base, ctx->flags, ctx->pglob, false) < 0)
+        return 0;
+
+      size_t old_pathc = ctx->pglob->gl_pathc;
+      size_t mark_start = old_pathc + ctx->pglob->gl_offs;
+      int status = glob_in_dir (c->raw, lit_base,
+                                (ctx->flags | GLOB_APPEND)
+                                & ~(GLOB_NOCHECK | GLOB_NOMAGIC),
+                                ctx->errfunc, ctx->pglob, 0);
+      if (status == GLOB_NOMATCH)
+        return 0;
+      if (status != 0)
+        return status;
+      if (prefix_array (lit_base,
+                        &ctx->pglob->gl_pathv[mark_start],
+                        ctx->pglob->gl_pathc - old_pathc))
+        return GLOB_NOSPACE;
+      return fswc_apply_glob_mark_slice (ctx->pglob, ctx->flags, mark_start);
+    }
+
+  /* Intermediate directory component (from_comp + 1 < ctx->ncomps).  */
+  if (c->is_starstar)
+    {
+      int err = fswc_delegate_subglob (ctx, lit_base, lit_base_len,
+                                       from_comp + 1);
+      if (err != 0)
+        return err;
+
+      if (glob_testdir (lit_base, ctx->flags, ctx->pglob, false) != 0)
+        return 0;
+
+      glob_t subdirs;
+      memset (&subdirs, 0, sizeof (subdirs));
+      int r = globstar_scan (lit_base,
+                             (ctx->flags & ~(GLOB_MARK | GLOB_NOCHECK
+                                             | GLOB_NOMAGIC))
+                             | GLOB_ONLYDIR,
+                             0, ctx->errfunc, &subdirs);
+      if (r != 0)
+        {
+          globfree (&subdirs);
+          return r;
+        }
+      for (size_t i = 0; i < subdirs.gl_pathc; ++i)
+        {
+          const char *sd = subdirs.gl_pathv[i];
+          if (glob_testdir (sd, ctx->flags, ctx->pglob, true) != 0)
+            continue;
+          err = fswc_delegate_subglob (ctx, sd, strlen (sd), from_comp + 1);
+          if (err != 0)
+            {
+              globfree (&subdirs);
+              return err;
+            }
+        }
+      globfree (&subdirs);
+      return 0;
+    }
+
+  if (c->is_lit && !(ctx->flags & GLOB_CASEFOLD))
+    {
+      char next_dir[PATH_MAX];
+      size_t base_l = (lit_base_len == 1 && lit_base[0] == '/') ? 0 : lit_base_len;
+      if (base_l + 1 + c->lit_len >= sizeof (next_dir))
+        return 0;
+      if (base_l > 0)
+        memcpy (next_dir, lit_base, base_l);
+      next_dir[base_l] = '/';
+      memcpy (next_dir + base_l + 1, c->lit, c->lit_len);
+      size_t next_len = base_l + 1 + c->lit_len;
+      next_dir[next_len] = '\0';
+
+      if (!is_dir (next_dir, ctx->flags, ctx->pglob))
+        return 0;
+      return fswc_delegate_subglob (ctx, next_dir, next_len, from_comp + 1);
+    }
+
+  if ((ctx->flags & GLOB_GLOBSTAR)
+      && glob_testdir (lit_base, ctx->flags, ctx->pglob, false) < 0)
+    return 0;
+
+  glob_t subdirs;
+  memset (&subdirs, 0, sizeof (subdirs));
+  int dflags = ((ctx->flags & (GLOB_ERR | GLOB_NOESCAPE | GLOB_EXTMATCH
+                               | GLOB_CASEFOLD | GLOB_SKIPDOTS | GLOB_GLOBSTAR
+                               | GLOB_DOTDOT
+                               | glob_interm_period_flag (ctx->flags)))
+                | GLOB_APPEND | GLOB_NOSORT | GLOB_ONLYDIR);
+  int status = glob_in_dir (c->raw, lit_base, dflags, ctx->errfunc, &subdirs, 0);
+  if (status == GLOB_NOMATCH)
+    return 0;
+  if (status != 0)
+    {
+      globfree (&subdirs);
+      return status;
+    }
+  if (prefix_array (lit_base, subdirs.gl_pathv, subdirs.gl_pathc))
+    {
+      globfree (&subdirs);
+      return GLOB_NOSPACE;
+    }
+  for (size_t i = 0; i < subdirs.gl_pathc; ++i)
+    {
+      const char *sd = subdirs.gl_pathv[i];
+      int err = fswc_delegate_subglob (ctx, sd, strlen (sd), from_comp + 1);
+      if (err != 0)
+        {
+          globfree (&subdirs);
+          return err;
+        }
+    }
+  globfree (&subdirs);
+  return 0;
+}
+
+static int
+fswc_walk_terminal_starstar (const struct fswc_glob_ctx *ctx,
+                             uint32_t pkg_idx, uint32_t cur_vdir,
+                             char *path_buf, size_t path_len,
+                             bool add_curdir, bool curdir_slash)
+{
+  if (add_curdir)
+    {
+      bool slash = curdir_slash || (ctx->flags & GLOB_MARK) != 0;
+      int err = fswc_glob_append_str (ctx->pglob, path_buf, path_len, slash);
+      if (err != 0)
+        return err;
+    }
+
+  if (cur_vdir >= ctx->v->hdr->num_vdirs)
+    return 0;
+
+  const struct fswc_vdir *vd = &ctx->v->vdirs[cur_vdir];
+  for (uint32_t k = 0; k < vd->children_count; ++k)
+    {
+      uint32_t slot = ctx->v->vchildren[vd->children_start + k].ht_slot;
+      if (slot > ctx->v->hdr->ht_mask)
+        continue;
+      const struct fswc_ht_entry *ent = &ctx->v->ht[slot];
+      if ((ctx->flags & GLOB_ONLYDIR) && ent->dir_cnt == 0)
+        continue;
+      int dt = __fswc_posting_find_pkg (ctx->v, ent->all_cnt, ent->all_ref,
+                                        pkg_idx);
+      if (dt < 0)
+        continue;
+
+      const char *ename = ctx->v->strtab + ent->name_off;
+      size_t elen = ent->name_len;
+      if (skipname ("**", "**" + 2, ename, ctx->flags))
+        continue;
+      if (path_len + 1 + elen + 2 >= PATH_MAX)
+        continue;
+
+      size_t save_len = path_len;
+      if (path_len == 0 || path_buf[path_len - 1] != '/')
+        path_buf[path_len++] = '/';
+      memcpy (path_buf + path_len, ename, elen);
+      path_len += elen;
+      path_buf[path_len] = '\0';
+
+      bool child_is_dir = (dt == DT_DIR);
+      if ((dt == DT_LNK || dt == DT_UNKNOWN)
+          && (ctx->flags & (GLOB_ONLYDIR | GLOB_MARK)))
+        child_is_dir = is_dir (path_buf, ctx->flags, ctx->pglob);
+
+      if ((ctx->flags & GLOB_ONLYDIR) && !child_is_dir)
+        {
+          path_len = save_len;
+          path_buf[path_len] = '\0';
+          continue;
+        }
+
+      int err = fswc_glob_append_str (ctx->pglob, path_buf, path_len,
+                                      (ctx->flags & GLOB_MARK) && child_is_dir);
+      if (err != 0)
+        return err;
+
+      if (dt == DT_DIR && ent->child_vdir_id != FSWC_NONE)
+        {
+          err = fswc_walk_terminal_starstar (ctx, pkg_idx, ent->child_vdir_id,
+                                             path_buf, path_len, false, false);
+          if (err != 0)
+            return err;
+        }
+
+      path_len = save_len;
+      path_buf[path_len] = '\0';
+    }
+  return 0;
+}
+
+static int
+fswc_walk_pkg_vdir (const struct fswc_glob_ctx *ctx,
+                    uint32_t pkg_idx, uint32_t cur_vdir, size_t comp_idx,
+                    char *path_buf, size_t path_len)
+{
+  if (cur_vdir >= ctx->v->hdr->num_vdirs)
+    return 0;
+
+  const struct fswc_glob_comp *c = &ctx->comps[comp_idx];
+  bool is_last = (comp_idx + 1 == ctx->ncomps);
+
+  if (c->is_starstar)
+    {
+      if (is_last)
+        return fswc_walk_terminal_starstar (ctx, pkg_idx, cur_vdir,
+                                            path_buf, path_len,
+                                            true, !ctx->orig_dir_magic);
+      int err = fswc_walk_pkg_vdir (ctx, pkg_idx, cur_vdir, comp_idx + 1,
+                                    path_buf, path_len);
+      if (err != 0)
+        return err;
+
+      const struct fswc_vdir *vd = &ctx->v->vdirs[cur_vdir];
+      for (uint32_t k = 0; k < vd->children_count; ++k)
+        {
+          uint32_t slot = ctx->v->vchildren[vd->children_start + k].ht_slot;
+          if (slot > ctx->v->hdr->ht_mask)
+            continue;
+          const struct fswc_ht_entry *ent = &ctx->v->ht[slot];
+          if (ent->dir_cnt == 0 || ent->child_vdir_id == FSWC_NONE)
+            continue;
+          int dt = __fswc_posting_find_pkg (ctx->v, ent->all_cnt, ent->all_ref,
+                                            pkg_idx);
+          if (dt != DT_DIR)
+            continue;
+          const char *ename = ctx->v->strtab + ent->name_off;
+          size_t elen = ent->name_len;
+          if (skipname ("**", "**" + 2, ename, ctx->flags))
+            continue;
+          if (path_len + 1 + elen + 2 >= PATH_MAX)
+            continue;
+          size_t save_len = path_len;
+          path_buf[path_len++] = '/';
+          memcpy (path_buf + path_len, ename, elen);
+          path_len += elen;
+          path_buf[path_len] = '\0';
+          err = fswc_walk_pkg_vdir (ctx, pkg_idx, ent->child_vdir_id, comp_idx,
+                                    path_buf, path_len);
+          path_len = save_len;
+          path_buf[path_len] = '\0';
+          if (err != 0)
+            return err;
+        }
+      return 0;
+    }
+
+  if (c->is_lit && !(ctx->flags & GLOB_CASEFOLD))
+    {
+      const struct fswc_ht_entry *ent
+        = __fswc_ht_lookup (ctx->v, cur_vdir, c->lit, c->lit_len);
+      if (ent == NULL)
+        return 0;
+      int dt = __fswc_posting_find_pkg (ctx->v, ent->all_cnt, ent->all_ref,
+                                        pkg_idx);
+      if (dt < 0)
+        return 0;
+      if (path_len + 1 + c->lit_len + 2 >= PATH_MAX)
+        return 0;
+
+      size_t save_len = path_len;
+      path_buf[path_len++] = '/';
+      memcpy (path_buf + path_len, c->lit, c->lit_len);
+      path_len += c->lit_len;
+      path_buf[path_len] = '\0';
+
+      int err = 0;
+      if (!is_last)
+        {
+          if (dt == DT_DIR && ent->child_vdir_id != FSWC_NONE)
+            err = fswc_walk_pkg_vdir (ctx, pkg_idx, ent->child_vdir_id,
+                                      comp_idx + 1, path_buf, path_len);
+          else if ((dt == DT_LNK || dt == DT_UNKNOWN)
+                   && is_dir (path_buf, ctx->flags, ctx->pglob))
+            err = fswc_delegate_subglob (ctx, path_buf, path_len, comp_idx + 1);
+        }
+      else
+        {
+          bool is_d = (dt == DT_DIR);
+          if ((dt == DT_LNK || dt == DT_UNKNOWN)
+              && (ctx->flags & (GLOB_ONLYDIR | GLOB_MARK)))
+            is_d = is_dir (path_buf, ctx->flags, ctx->pglob);
+          if (!(ctx->flags & GLOB_ONLYDIR) || is_d)
+            err = fswc_glob_append_str (ctx->pglob, path_buf, path_len,
+                                        (ctx->flags & GLOB_MARK) && is_d);
+        }
+
+      path_len = save_len;
+      path_buf[path_len] = '\0';
+      return err;
+    }
+
+  /* Wildcard component: c->raw is already NUL-terminated in raw_pool.  */
+  const char *cpat = c->raw;
+  const char *cpat_end = cpat + c->raw_len;
+  int cur_flags = is_last ? ctx->flags : ctx->interm_flags;
+  int cur_fnm_flags = is_last ? ctx->fnm_flags : ctx->interm_fnm_flags;
+
+  /* Handle "." and ".." if pattern does not skip them (e.g. ".*").  */
+  static const char *const dots[2] = { ".", ".." };
+  for (int di = 0; di < 2; ++di)
+    {
+      if (!skipname (cpat, cpat_end, dots[di], cur_flags)
+          && fnmatch (cpat, dots[di], cur_fnm_flags) == 0)
+        {
+          size_t dlen = (size_t) (di + 1);
+          if (path_len + 1 + dlen + 2 >= PATH_MAX)
+            continue;
+          size_t save_len = path_len;
+          path_buf[path_len++] = '/';
+          memcpy (path_buf + path_len, dots[di], dlen);
+          path_len += dlen;
+          path_buf[path_len] = '\0';
+          int err = is_last
+                    ? fswc_glob_append_str (ctx->pglob, path_buf, path_len,
+                                            (ctx->flags & GLOB_MARK) != 0)
+                    : fswc_delegate_subglob (ctx, path_buf, path_len,
+                                             comp_idx + 1);
+          path_len = save_len;
+          path_buf[path_len] = '\0';
+          if (err != 0)
+            return err;
+        }
+    }
+
+  const struct fswc_vdir *vd = &ctx->v->vdirs[cur_vdir];
+  for (uint32_t k = 0; k < vd->children_count; ++k)
+    {
+      uint32_t slot = ctx->v->vchildren[vd->children_start + k].ht_slot;
+      if (slot > ctx->v->hdr->ht_mask)
+        continue;
+      const struct fswc_ht_entry *ent = &ctx->v->ht[slot];
+      if ((!is_last || (ctx->flags & GLOB_ONLYDIR)) && ent->dir_cnt == 0)
+        continue;
+      int dt = __fswc_posting_find_pkg (ctx->v, ent->all_cnt, ent->all_ref,
+                                        pkg_idx);
+      if (dt < 0)
+        continue;
+      if ((!is_last || (ctx->flags & GLOB_ONLYDIR))
+          && dt != DT_DIR && dt != DT_LNK && dt != DT_UNKNOWN)
+        continue;
+
+      const char *ename = ctx->v->strtab + ent->name_off;
+      size_t elen = ent->name_len;
+      if (skipname (cpat, cpat_end, ename, cur_flags)
+          || fnmatch (cpat, ename, cur_fnm_flags) != 0)
+        continue;
+      if (path_len + 1 + elen + 2 >= PATH_MAX)
+        continue;
+
+      size_t save_len = path_len;
+      path_buf[path_len++] = '/';
+      memcpy (path_buf + path_len, ename, elen);
+      path_len += elen;
+      path_buf[path_len] = '\0';
+
+      int err = 0;
+      if (!is_last)
+        {
+          if (dt == DT_DIR && ent->child_vdir_id != FSWC_NONE)
+            err = fswc_walk_pkg_vdir (ctx, pkg_idx, ent->child_vdir_id,
+                                      comp_idx + 1, path_buf, path_len);
+          else if ((dt == DT_LNK || dt == DT_UNKNOWN)
+                   && is_dir (path_buf, ctx->flags, ctx->pglob))
+            err = fswc_delegate_subglob (ctx, path_buf, path_len, comp_idx + 1);
+        }
+      else
+        {
+          bool is_d = (dt == DT_DIR);
+          if ((dt == DT_LNK || dt == DT_UNKNOWN)
+              && (ctx->flags & (GLOB_ONLYDIR | GLOB_MARK)))
+            is_d = is_dir (path_buf, ctx->flags, ctx->pglob);
+          if (!(ctx->flags & GLOB_ONLYDIR) || is_d)
+            err = fswc_glob_append_str (ctx->pglob, path_buf, path_len,
+                                        (ctx->flags & GLOB_MARK) && is_d);
+        }
+
+      path_len = save_len;
+      path_buf[path_len] = '\0';
+      if (err != 0)
+        return err;
+    }
+
+  return 0;
+}
+
+static int
+fswc_glob_on_snap (const char *prefix, size_t prefix_len,
+                   const struct fswc_slot_snap *snap,
+                   const struct fswc_glob_comp *comps, size_t ncomps,
+                   int flags, bool orig_dir_magic,
+                   int (*errfunc) (const char *, int),
+                   glob_t *pglob, __glob_homedir_fn_t homedir_fn)
+{
+  if ((snap->snap_flags & FSWC_SNAP_NO_SQUASHFS) != 0
+      || snap->view.hdr == NULL
+      || !(snap->snap_flags & FSWC_SNAP_ANCESTORS_WORLD_SEARCH)
+      || !(snap->snap_flags & FSWC_SNAP_PREFIX_WORLD_RX))
+    return -2; /* Fall back to glob_body on non-SquashFS or EACCES prefix.  */
+
+  const struct fswc_view *v = &snap->view;
+  size_t pbase_len = (prefix_len == 1 && prefix[0] == '/') ? 0 : prefix_len;
+  char path_buf[PATH_MAX];
+
+  int interm_flags = (flags & ~GLOB_PERIOD) | glob_interm_period_flag (flags);
+  int fnm_flags = (FNM_PATHNAME
+                   | (!(flags & GLOB_PERIOD) ? FNM_PERIOD : 0)
+                   | ((flags & GLOB_NOESCAPE) ? FNM_NOESCAPE : 0)
+                   | ((flags & GLOB_EXTMATCH) ? FNM_EXTMATCH : 0)
+                   | ((flags & GLOB_CASEFOLD) ? FNM_CASEFOLD : 0)
+                   | ((flags & GLOB_DOTDOT) ? FNM_DOTDOT : 0));
+  int interm_fnm_flags
+    = (FNM_PATHNAME
+       | (!(interm_flags & GLOB_PERIOD) ? FNM_PERIOD : 0)
+       | ((interm_flags & GLOB_NOESCAPE) ? FNM_NOESCAPE : 0)
+       | ((interm_flags & GLOB_EXTMATCH) ? FNM_EXTMATCH : 0)
+       | ((interm_flags & GLOB_CASEFOLD) ? FNM_CASEFOLD : 0)
+       | ((interm_flags & GLOB_DOTDOT) ? FNM_DOTDOT : 0));
+
+  struct fswc_glob_ctx ctx =
+    {
+      .snap = snap,
+      .v = v,
+      .comps = comps,
+      .ncomps = ncomps,
+      .flags = flags,
+      .fnm_flags = fnm_flags,
+      .interm_flags = interm_flags,
+      .interm_fnm_flags = interm_fnm_flags,
+      .orig_dir_magic = orig_dir_magic,
+      .errfunc = errfunc,
+      .pglob = pglob,
+      .homedir_fn = homedir_fn,
+    };
+
+  /* 1. Leading "**" component (e.g. "<pfx>/ **" or "<pfx>/ ** /bash").  */
+  if (comps[0].is_starstar)
+    {
+      if (ncomps == 1)
+        {
+          /* Terminal "<prefix>/ **": emit "<prefix>/" (or "<prefix>" if
+             orig_dir_magic) then every child recursively.  */
+          memcpy (path_buf, prefix, prefix_len);
+          path_buf[prefix_len] = '\0';
+          bool add_slash = !orig_dir_magic || (flags & GLOB_MARK) != 0;
+          if (add_slash && prefix_len == 1 && prefix[0] == '/')
+            add_slash = false;
+          int err = fswc_glob_append_str (pglob, path_buf, prefix_len,
+                                          add_slash);
+          if (err != 0)
+            return err;
+
+          for (uint32_t pi = 0; pi < v->hdr->num_pkgs; ++pi)
+            {
+              const struct fswc_pkg *pk = &v->pkgs[pi];
+              const char *pname = v->strtab + pk->name_off;
+              if (skipname ("**", "**" + 2, pname, flags))
+                continue;
+              if (pbase_len + 1 + pk->name_len + 2 >= PATH_MAX)
+                continue;
+              if (pbase_len > 0)
+                memcpy (path_buf, prefix, pbase_len);
+              path_buf[pbase_len] = '/';
+              memcpy (path_buf + pbase_len + 1, pname, pk->name_len);
+              size_t plen = pbase_len + 1 + pk->name_len;
+              path_buf[plen] = '\0';
+
+              err = fswc_glob_append_str (pglob, path_buf, plen,
+                                          (flags & GLOB_MARK) != 0);
+              if (err != 0)
+                return err;
+
+              if ((pk->flags & (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                                | FSWC_PKG_ALL_WORLD_SEARCH))
+                  == (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                      | FSWC_PKG_ALL_WORLD_SEARCH))
+                err = fswc_walk_terminal_starstar (&ctx, pi, FSWC_VDIR_ROOT,
+                                                   path_buf, plen, false, false);
+              else
+                {
+                  size_t ms = pglob->gl_pathc + pglob->gl_offs;
+                  err = globstar_scan (path_buf, flags, 0, errfunc, pglob);
+                  if (err == 0)
+                    err = fswc_apply_glob_mark_slice (pglob, flags, ms);
+                }
+              if (err != 0)
+                return err;
+            }
+
+          for (uint32_t mi = 0; mi < snap->num_mutable_dirs; ++mi)
+            {
+              const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+              const char *mname = snap->top_strtab + me->name_off;
+              if (skipname ("**", "**" + 2, mname, flags))
+                continue;
+              if (pbase_len + 1 + me->name_len + 2 >= PATH_MAX)
+                continue;
+              if (pbase_len > 0)
+                memcpy (path_buf, prefix, pbase_len);
+              path_buf[pbase_len] = '/';
+              memcpy (path_buf + pbase_len + 1, mname, me->name_len);
+              size_t plen = pbase_len + 1 + me->name_len;
+              path_buf[plen] = '\0';
+
+              int isd = glob_testdir (path_buf, flags, pglob, true);
+              if ((flags & GLOB_ONLYDIR) && isd < 0
+                  && (isd != -2
+                      || glob_testdir (path_buf, flags, pglob, false) < 0))
+                continue;
+              bool dir_or_lnkdir = (isd == 0
+                                    || (isd == -2
+                                        && is_dir (path_buf, flags, pglob)));
+              err = fswc_glob_append_str (pglob, path_buf, plen,
+                                          (flags & GLOB_MARK) && dir_or_lnkdir);
+              if (err != 0)
+                return err;
+              if (isd == 0)
+                {
+                  size_t ms = pglob->gl_pathc + pglob->gl_offs;
+                  err = globstar_scan (path_buf, flags, 0, errfunc, pglob);
+                  if (err == 0)
+                    err = fswc_apply_glob_mark_slice (pglob, flags, ms);
+                  if (err != 0)
+                    return err;
+                }
+            }
+
+          if (!(flags & GLOB_ONLYDIR))
+            for (uint32_t ti = 0; ti < snap->num_top_files; ++ti)
+              {
+                const struct fswc_top_entry *te = &snap->top_files[ti];
+                const char *tname = snap->top_strtab + te->name_off;
+                if (skipname ("**", "**" + 2, tname, flags))
+                  continue;
+                if (pbase_len + 1 + te->name_len + 2 >= PATH_MAX)
+                  continue;
+                if (pbase_len > 0)
+                  memcpy (path_buf, prefix, pbase_len);
+                path_buf[pbase_len] = '/';
+                memcpy (path_buf + pbase_len + 1, tname, te->name_len);
+                size_t plen = pbase_len + 1 + te->name_len;
+                path_buf[plen] = '\0';
+                err = fswc_glob_append_str (pglob, path_buf, plen, false);
+                if (err != 0)
+                  return err;
+              }
+          return 0;
+        }
+
+      /* Non-terminal "<prefix>/ ** /<rest>":
+         (a) zero-step match "<prefix>/<rest>"
+         (b) 1+-step match into real DT_DIR children (never DT_LNK!).  */
+      int err = fswc_glob_on_snap (prefix, prefix_len, snap,
+                                   comps + 1, ncomps - 1, flags,
+                                   orig_dir_magic, errfunc, pglob, homedir_fn);
+      if (err != 0)
+        return err;
+
+      for (uint32_t pi = 0; pi < v->hdr->num_pkgs; ++pi)
+        {
+          const struct fswc_pkg *pk = &v->pkgs[pi];
+          const char *pname = v->strtab + pk->name_off;
+          if (skipname ("**", "**" + 2, pname, flags))
+            continue;
+          if (pbase_len + 1 + pk->name_len + 2 >= PATH_MAX)
+            continue;
+          if (pbase_len > 0)
+            memcpy (path_buf, prefix, pbase_len);
+          path_buf[pbase_len] = '/';
+          memcpy (path_buf + pbase_len + 1, pname, pk->name_len);
+          size_t plen = pbase_len + 1 + pk->name_len;
+          path_buf[plen] = '\0';
+
+          if ((pk->flags & (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                            | FSWC_PKG_ALL_WORLD_SEARCH))
+              == (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                  | FSWC_PKG_ALL_WORLD_SEARCH))
+            err = fswc_walk_pkg_vdir (&ctx, pi, FSWC_VDIR_ROOT, 0,
+                                      path_buf, plen);
+          else
+            {
+              err = fswc_delegate_subglob (&ctx, path_buf, plen, 0);
+              if (err < 0)
+                return -2;
+            }
+          if (err != 0)
+            return err;
+        }
+
+      for (uint32_t mi = 0; mi < snap->num_mutable_dirs; ++mi)
+        {
+          const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+          const char *mname = snap->top_strtab + me->name_off;
+          if (skipname ("**", "**" + 2, mname, flags))
+            continue;
+          if (pbase_len + 1 + me->name_len + 2 >= PATH_MAX)
+            continue;
+          if (pbase_len > 0)
+            memcpy (path_buf, prefix, pbase_len);
+          path_buf[pbase_len] = '/';
+          memcpy (path_buf + pbase_len + 1, mname, me->name_len);
+          size_t plen = pbase_len + 1 + me->name_len;
+          path_buf[plen] = '\0';
+          /* Non-terminal ** must not traverse symlinked directories!  */
+          if (glob_testdir (path_buf, flags, pglob, true) != 0)
+            continue;
+          err = fswc_delegate_subglob (&ctx, path_buf, plen, 0);
+          if (err < 0)
+            return -2;
+          if (err != 0)
+            return err;
+        }
+      return 0;
+    }
+
+  /* 2. Prepare comps[0] (<pkg_pat>) pattern string (already NUL-terminated).  */
+  const char *pkg_pat = comps[0].raw;
+  const char *pkg_pat_end = pkg_pat + comps[0].raw_len;
+
+  /* If ncomps >= 2 and pkg_pat could match "." or "..", let glob_body handle
+     so "<pfx>/.. /..." traversal behaves identically to uncached glob.  */
+  if (ncomps >= 2
+      && (!skipname (pkg_pat, pkg_pat_end, ".", interm_flags)
+          || !skipname (pkg_pat, pkg_pat_end, "..", interm_flags)))
+    return -2;
+
+  /* 3. Single-component "<prefix>/<pkg_pat>" query.  */
+  if (ncomps == 1)
+    {
+      static const char *const dots[2] = { ".", ".." };
+      for (int di = 0; di < 2; ++di)
+        {
+          if (!skipname (pkg_pat, pkg_pat_end, dots[di], flags)
+              && fnmatch (pkg_pat, dots[di], fnm_flags) == 0)
+            {
+              size_t dlen = (size_t) (di + 1);
+              if (pbase_len + 1 + dlen + 2 >= PATH_MAX)
+                continue;
+              if (pbase_len > 0)
+                memcpy (path_buf, prefix, pbase_len);
+              path_buf[pbase_len] = '/';
+              memcpy (path_buf + pbase_len + 1, dots[di], dlen);
+              size_t plen = pbase_len + 1 + dlen;
+              path_buf[plen] = '\0';
+              int err = fswc_glob_append_str (pglob, path_buf, plen,
+                                              (flags & GLOB_MARK) != 0);
+              if (err != 0)
+                return err;
+            }
+        }
+
+      for (uint32_t pi = 0; pi < v->hdr->num_pkgs; ++pi)
+        {
+          const struct fswc_pkg *pk = &v->pkgs[pi];
+          const char *pname = v->strtab + pk->name_off;
+          if (skipname (pkg_pat, pkg_pat_end, pname, flags)
+              || fnmatch (pkg_pat, pname, fnm_flags) != 0)
+            continue;
+          if (pbase_len + 1 + pk->name_len + 2 >= PATH_MAX)
+            continue;
+          if (pbase_len > 0)
+            memcpy (path_buf, prefix, pbase_len);
+          path_buf[pbase_len] = '/';
+          memcpy (path_buf + pbase_len + 1, pname, pk->name_len);
+          size_t plen = pbase_len + 1 + pk->name_len;
+          path_buf[plen] = '\0';
+          int err = fswc_glob_append_str (pglob, path_buf, plen,
+                                          (flags & GLOB_MARK) != 0);
+          if (err != 0)
+            return err;
+        }
+
+      for (uint32_t mi = 0; mi < snap->num_mutable_dirs; ++mi)
+        {
+          const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+          const char *mname = snap->top_strtab + me->name_off;
+          if (skipname (pkg_pat, pkg_pat_end, mname, flags)
+              || fnmatch (pkg_pat, mname, fnm_flags) != 0)
+            continue;
+          if (pbase_len + 1 + me->name_len + 2 >= PATH_MAX)
+            continue;
+          if (pbase_len > 0)
+            memcpy (path_buf, prefix, pbase_len);
+          path_buf[pbase_len] = '/';
+          memcpy (path_buf + pbase_len + 1, mname, me->name_len);
+          size_t plen = pbase_len + 1 + me->name_len;
+          path_buf[plen] = '\0';
+
+          bool is_d = (me->d_type == DT_DIR);
+          if ((me->d_type == DT_LNK || me->d_type == DT_UNKNOWN)
+              && (flags & (GLOB_ONLYDIR | GLOB_MARK)))
+            is_d = is_dir (path_buf, flags, pglob);
+          if ((flags & GLOB_ONLYDIR) && !is_d)
+            continue;
+          int err = fswc_glob_append_str (pglob, path_buf, plen,
+                                          (flags & GLOB_MARK) && is_d);
+          if (err != 0)
+            return err;
+        }
+
+      if (!(flags & GLOB_ONLYDIR))
+        for (uint32_t ti = 0; ti < snap->num_top_files; ++ti)
+          {
+            const struct fswc_top_entry *te = &snap->top_files[ti];
+            const char *tname = snap->top_strtab + te->name_off;
+            if (skipname (pkg_pat, pkg_pat_end, tname, flags)
+                || fnmatch (pkg_pat, tname, fnm_flags) != 0)
+              continue;
+            if (pbase_len + 1 + te->name_len + 2 >= PATH_MAX)
+              continue;
+            if (pbase_len > 0)
+              memcpy (path_buf, prefix, pbase_len);
+            path_buf[pbase_len] = '/';
+            memcpy (path_buf + pbase_len + 1, tname, te->name_len);
+            size_t plen = pbase_len + 1 + te->name_len;
+            path_buf[plen] = '\0';
+            int err = fswc_glob_append_str (pglob, path_buf, plen, false);
+            if (err != 0)
+              return err;
+          }
+      return 0;
+    }
+
+  /* 4. O(depth) Fast Path for "<prefix>/<star>/<lit_1>/.../<lit_k>":
+     Resolves all N SquashFS packages in O(depth) hash lookups without scanning
+     all N packages!  */
+  bool all_rest_lit = !(flags & GLOB_CASEFOLD);
+  for (size_t i = 1; i < ncomps && all_rest_lit; ++i)
+    if (!comps[i].is_lit)
+      all_rest_lit = false;
+
+  if (all_rest_lit
+      && comps[0].raw_len == 1 && comps[0].raw[0] == '*'
+      && v->hdr->num_pkgs > 0)
+    {
+      char rel_lit[PATH_MAX];
+      size_t rel_len = 0;
+      bool fit = true;
+      for (size_t i = 1; i < ncomps; ++i)
+        {
+          if (rel_len + (i > 1 ? 1 : 0) + comps[i].lit_len >= sizeof (rel_lit))
+            {
+              fit = false;
+              break;
+            }
+          if (i > 1)
+            rel_lit[rel_len++] = '/';
+          memcpy (rel_lit + rel_len, comps[i].lit, comps[i].lit_len);
+          rel_len += comps[i].lit_len;
+        }
+
+      struct fswc_relpath_result rres;
+      if (fit
+          && __fswc_resolve_pkg_wild_relpath (snap, rel_lit, rel_len, &rres)
+          && !rres.lnk_overflow)
+        {
+          /* Check if every SquashFS package is clean (IMMUTABLE + WORLD_RX +
+             WORLD_SEARCH, and non-dot pkg name or GLOB_PERIOD) and zero
+             intermediate symlinks exist.  */
+          if (rres.num_lnk_ents == 0
+              && (v->hdr->global_flags
+                  & (FSWC_GF_ALL_WORLD_SEARCH | FSWC_GF_ALL_WORLD_RX))
+                 == (FSWC_GF_ALL_WORLD_SEARCH | FSWC_GF_ALL_WORLD_RX))
+            {
+              bool all_immut = true;
+              for (uint32_t pi = 0; pi < v->hdr->num_pkgs; ++pi)
+                if (!(v->pkgs[pi].flags & FSWC_PKG_IMMUTABLE))
+                  {
+                    all_immut = false;
+                    break;
+                  }
+              if (all_immut)
+                {
+                  if (rres.leaf_ent != NULL)
+                    {
+                      uint32_t inline_word = 0;
+                      uint32_t np = 0;
+                      const uint32_t *plist
+                        = __fswc_posting_slice (v, rres.leaf_ent->all_cnt,
+                                                rres.leaf_ent->all_ref,
+                                                &inline_word, &np);
+                      for (uint32_t m = 0; m < np; ++m)
+                        {
+                          uint32_t pi = FSWC_POSTING_PKG (plist[m]);
+                          uint32_t dt = FSWC_POSTING_DTYPE (plist[m]);
+                          if (pi >= v->hdr->num_pkgs)
+                            continue;
+                          const struct fswc_pkg *pk = &v->pkgs[pi];
+                          const char *pname = v->strtab + pk->name_off;
+                          if (skipname ("*", "*" + 1, pname, interm_flags))
+                            continue;
+                          if (pbase_len + 1 + pk->name_len + 1 + rel_len + 2
+                              >= PATH_MAX)
+                            continue;
+                          if (pbase_len > 0)
+                            memcpy (path_buf, prefix, pbase_len);
+                          path_buf[pbase_len] = '/';
+                          memcpy (path_buf + pbase_len + 1, pname,
+                                  pk->name_len);
+                          path_buf[pbase_len + 1 + pk->name_len] = '/';
+                          memcpy (path_buf + pbase_len + 1 + pk->name_len + 1,
+                                  rel_lit, rel_len);
+                          size_t plen = pbase_len + 1 + pk->name_len + 1
+                                        + rel_len;
+                          path_buf[plen] = '\0';
+
+                          bool is_d = (dt == DT_DIR);
+                          if ((dt == DT_LNK || dt == DT_UNKNOWN)
+                              && (flags & (GLOB_ONLYDIR | GLOB_MARK)))
+                            is_d = is_dir (path_buf, flags, pglob);
+                          if ((flags & GLOB_ONLYDIR) && !is_d)
+                            continue;
+                          int err = fswc_glob_append_str (
+                            pglob, path_buf, plen,
+                            (flags & GLOB_MARK) && is_d);
+                          if (err != 0)
+                            return err;
+                        }
+                    }
+
+                  for (uint32_t mi = 0; mi < snap->num_mutable_dirs; ++mi)
+                    {
+                      const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+                      const char *mname = snap->top_strtab + me->name_off;
+                      if (skipname ("*", "*" + 1, mname, interm_flags))
+                        continue;
+                      if (pbase_len + 1 + me->name_len + 2 >= PATH_MAX)
+                        continue;
+                      if (pbase_len > 0)
+                        memcpy (path_buf, prefix, pbase_len);
+                      path_buf[pbase_len] = '/';
+                      memcpy (path_buf + pbase_len + 1, mname, me->name_len);
+                      size_t plen = pbase_len + 1 + me->name_len;
+                      path_buf[plen] = '\0';
+                      if (me->d_type != DT_DIR
+                          && !is_dir (path_buf, flags, pglob))
+                        continue;
+                      int err = fswc_delegate_subglob (&ctx, path_buf, plen, 1);
+                      if (err < 0)
+                        return -2;
+                      if (err != 0)
+                        return err;
+                    }
+                  return 0;
+                }
+            }
+        }
+    }
+
+  /* 5. General multi-component walk across matching packages + mutable_dirs. */
+  if (comps[0].is_lit && !(flags & GLOB_CASEFOLD))
+    {
+      /* Exact single package name with sub-wildcards.  */
+      const struct fswc_ht_entry *pk_ent
+        = __fswc_ht_lookup (v, FSWC_VDIR_PKGS, comps[0].lit, comps[0].lit_len);
+      if (pk_ent != NULL && pk_ent->all_cnt == 1)
+        {
+          uint32_t pi = FSWC_POSTING_PKG (pk_ent->all_ref);
+          if (pi < v->hdr->num_pkgs)
+            {
+              const struct fswc_pkg *pk = &v->pkgs[pi];
+              if (pbase_len + 1 + pk->name_len + 2 < PATH_MAX)
+                {
+                  if (pbase_len > 0)
+                    memcpy (path_buf, prefix, pbase_len);
+                  path_buf[pbase_len] = '/';
+                  memcpy (path_buf + pbase_len + 1, comps[0].lit,
+                          comps[0].lit_len);
+                  size_t plen = pbase_len + 1 + comps[0].lit_len;
+                  path_buf[plen] = '\0';
+
+                  if ((pk->flags & (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                                    | FSWC_PKG_ALL_WORLD_SEARCH))
+                      == (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                          | FSWC_PKG_ALL_WORLD_SEARCH))
+                    return fswc_walk_pkg_vdir (&ctx, pi, FSWC_VDIR_ROOT, 1,
+                                               path_buf, plen);
+                }
+            }
+        }
+      return -2;
+    }
+
+  for (uint32_t pi = 0; pi < v->hdr->num_pkgs; ++pi)
+    {
+      const struct fswc_pkg *pk = &v->pkgs[pi];
+      const char *pname = v->strtab + pk->name_off;
+      if (skipname (pkg_pat, pkg_pat_end, pname, interm_flags)
+          || fnmatch (pkg_pat, pname, interm_fnm_flags) != 0)
+        continue;
+      if (pbase_len + 1 + pk->name_len + 2 >= PATH_MAX)
+        continue;
+      if (pbase_len > 0)
+        memcpy (path_buf, prefix, pbase_len);
+      path_buf[pbase_len] = '/';
+      memcpy (path_buf + pbase_len + 1, pname, pk->name_len);
+      size_t plen = pbase_len + 1 + pk->name_len;
+      path_buf[plen] = '\0';
+
+      int err;
+      if ((pk->flags & (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+                        | FSWC_PKG_ALL_WORLD_SEARCH))
+          == (FSWC_PKG_IMMUTABLE | FSWC_PKG_ALL_WORLD_RX
+              | FSWC_PKG_ALL_WORLD_SEARCH))
+        err = fswc_walk_pkg_vdir (&ctx, pi, FSWC_VDIR_ROOT, 1, path_buf, plen);
+      else
+        {
+          err = fswc_delegate_subglob (&ctx, path_buf, plen, 1);
+          if (err < 0)
+            return -2;
+        }
+      if (err != 0)
+        return err;
+    }
+
+  for (uint32_t mi = 0; mi < snap->num_mutable_dirs; ++mi)
+    {
+      const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+      const char *mname = snap->top_strtab + me->name_off;
+      if (skipname (pkg_pat, pkg_pat_end, mname, interm_flags)
+          || fnmatch (pkg_pat, mname, interm_fnm_flags) != 0)
+        continue;
+      if (pbase_len + 1 + me->name_len + 2 >= PATH_MAX)
+        continue;
+      if (pbase_len > 0)
+        memcpy (path_buf, prefix, pbase_len);
+      path_buf[pbase_len] = '/';
+      memcpy (path_buf + pbase_len + 1, mname, me->name_len);
+      size_t plen = pbase_len + 1 + me->name_len;
+      path_buf[plen] = '\0';
+      if (me->d_type != DT_DIR && !is_dir (path_buf, flags, pglob))
+        continue;
+      int err = fswc_delegate_subglob (&ctx, path_buf, plen, 1);
+      if (err < 0)
+        return -2;
+      if (err != 0)
+        return err;
+    }
+
+  return 0;
+}
+
+static int
+fswc_glob_try (const char *dirname, size_t dirlen, const char *filename,
+               int flags, int (*errfunc) (const char *, int),
+               glob_t *pglob, __glob_homedir_fn_t homedir_fn,
+               uint16_t *fswc_seen_mask, bool orig_dir_magic, int *out_err)
+{
+  if ((flags & GLOB_ALTDIRFUNC) != 0
+      || dirname == NULL || dirname[0] != '/'
+      || filename == NULL || filename[0] == '\0')
+    return 0;
+
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+  int fn_meta = __glob_pattern_type_ext (filename, quote, extmatch);
+  if (!orig_dir_magic
+      && (fn_meta & (GLOBPAT_SPECIAL | GLOBPAT_BRACKET)) == 0
+      && !(flags & GLOB_CASEFOLD))
+    return 0;
+
+  size_t fnlen = strlen (filename);
+  size_t dbase_len = (dirlen == 1 && dirname[0] == '/') ? 0 : dirlen;
+  if (dbase_len + 1 + fnlen >= PATH_MAX)
+    return 0;
+
+  char full_pat[PATH_MAX];
+  char raw_pool[PATH_MAX + 64];
+  char unesc_pool[PATH_MAX];
+  size_t raw_used = 0;
+  size_t unesc_used = 0;
+  if (dbase_len > 0)
+    memcpy (full_pat, dirname, dbase_len);
+  full_pat[dbase_len] = '/';
+  memcpy (full_pat + dbase_len + 1, filename, fnlen + 1);
+  size_t full_len = dbase_len + 1 + fnlen;
+
+  /* Split full_pat into '/' components, respecting extglob parens and [...]
+     so an inner '/' inside @(a/b) or [a/b] causes a clean fallback to
+     glob_body.  Also bail out on redundant '//' slashes.  */
+  struct fswc_glob_comp all_comps[64];
+  size_t comp_starts[64];
+  size_t total_comps = 0;
+
+  const char *p = full_pat + 1;
+  const char *end = full_pat + full_len;
+  if (p >= end)
+    return 0;
+
+  while (p < end)
+    {
+      if (*p == '/' || total_comps >= 64)
+        return 0;
+      const char *cstart = p;
+      while (p < end && *p != '/')
+        {
+          if (quote && *p == '\\' && p + 1 < end)
+            {
+              if (p[1] == '/')
+                return 0;
+              p += 2;
+              continue;
+            }
+          if (*p == '[')
+            {
+              const char *bp = p + 1;
+              if (bp < end && (*bp == '!' || *bp == '^'))
+                ++bp;
+              if (bp < end && *bp == ']')
+                ++bp;
+              while (bp < end && *bp != ']')
+                {
+                  if (*bp == '/')
+                    return 0;
+                  if (quote && *bp == '\\' && bp + 1 < end)
+                    ++bp;
+                  ++bp;
+                }
+              if (bp < end && *bp == ']')
+                {
+                  p = bp + 1;
+                  continue;
+                }
+            }
+          if (extmatch && p + 1 < end && is_extglob (p))
+            {
+              const char *np = glob_patscan (p + 2, end, 0, quote);
+              if (np != NULL && np > p + 2)
+                {
+                  if (memchr (p + 2, '/', (size_t) (np - (p + 2))) != NULL)
+                    return 0;
+                  p = np;
+                  continue;
+                }
+            }
+          ++p;
+        }
+
+      size_t clen = (size_t) (p - cstart);
+      if (clen == 0 || clen >= NAME_MAX + 2
+          || raw_used + clen + 1 > sizeof (raw_pool))
+        return 0;
+
+      char *raw_ptr = raw_pool + raw_used;
