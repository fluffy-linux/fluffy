+static int
+fswc_apply_glob_mark_slice (glob_t *pglob, int flags, size_t start_idx)
+{
+  if (!(flags & GLOB_MARK))
+    return 0;
+
+  for (size_t i = start_idx; i < pglob->gl_pathc + pglob->gl_offs; ++i)
+    {
+      size_t curlen = strlen (pglob->gl_pathv[i]);
+      if (curlen > 0 && pglob->gl_pathv[i][curlen - 1] == '/')
+        continue;
+      if (is_dir (pglob->gl_pathv[i], flags, pglob))
+        {
+          char *newp = realloc (pglob->gl_pathv[i], curlen + 2);
+          if (newp == NULL)
+            return GLOB_NOSPACE;
+          newp[curlen] = '/';
+          newp[curlen + 1] = '\0';
+          pglob->gl_pathv[i] = newp;
+        }
+    }
+  return 0;
+}
