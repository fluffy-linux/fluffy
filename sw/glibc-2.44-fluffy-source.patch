+{
+  return ((p[0] == '?' || p[0] == '*' || p[0] == '+' || p[0] == '@'
+           || p[0] == '!')
+          && p[1] == '(');
+}
+
+static const char *
+glob_dirscan (const char *pat, int dirsep, bool quote)
+{
+  const char *d = NULL;
+  const char *pe = pat + strlen (pat);
+
+  for (const char *p = pat; p && *p; ++p)
+    {
+      if (is_extglob (p))
+        {
+          const char *np = glob_patscan (p + 2, pe, 0, quote);
+          if (np == NULL || np == p + 2)
+            continue;
+          p = np - 1;
+        }
+      else if (*p == dirsep)
+        d = p;
+    }
+  return d;
+}
+
+/* Scan from CP up to END looking for the next top-level ':' (outside
+   brackets and extglob parens).  Returns pointer to ':' or END.  */
+static const char *
+next_colon_sub (const char *cp, const char *end, int flags)
+{
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+
+  while (cp < end && *cp != '\0')
+    {
+      if (quote && *cp == '\\')
+        {
+          ++cp;
+          if (cp < end && *cp != '\0')
+            ++cp;
+        }
+      else if (*cp == '[')
+        {
+          const char *p = cp + 1;
+          if (p < end && (*p == '!' || *p == '^'))
+            ++p;
+          if (p < end && *p == ']')
+            ++p;
+          while (p < end && *p != '\0' && *p != ']')
+            {
+              if (quote && *p == '\\' && p + 1 < end)
+                ++p;
+              else if (p[0] == '['
+                       && (p[1] == ':' || p[1] == '.' || p[1] == '='))
+                {
+                  char type = p[1];
+                  const char *t = p + 2;
+                  while (t < end && *t != '\0' && (type == '.' || *t != ']'))
+                    {
+                      if (*t == type && t + 1 < end && t[1] == ']')
+                        {
+                          p = t + 1;
+                          break;
+                        }
+                      ++t;
+                    }
+                }
+              ++p;
+            }
+          if (p < end && *p == ']')
+            cp = p + 1;
+          else
+            ++cp;
+        }
+      else if (extmatch && cp + 1 < end && is_extglob (cp))
+        {
+          const char *np = glob_patscan (cp + 2, end, 0, quote);
+          if (np != NULL && np > cp + 2)
+            cp = np;
+          else
+            ++cp;
+        }
+      else if (*cp == ':')
+        return cp;
+      else
+        ++cp;
+    }
+  return end;
+}
+
+static bool skipname (const char *pat, const char *pat_end, const char *dname,
+                      int flags);
+
+static bool
+extglob_skipname (const char *pat, const char *pat_end, const char *dname,
+                  int flags)
+{
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool wild = (*pat == '*' || *pat == '?');
+  const char *pp = pat + 2;
+  const char *pe = glob_patscan (pp, pat_end, 0, quote);
+  if (pe == NULL || pe > pat_end || pe[-1] != ')')
+    return false;
+
+  if (pe == pat_end && memchr (pp, '|', pe - pp - 1) == NULL)
+    return skipname (pp, pe - 1, dname, flags);
+
+  bool r = true;
+  const char *t;
+  while ((t = glob_patscan (pp, pe, '|', quote)) != NULL)
+    {
+      const char *sub_end = (is_extglob (pp) && t[-1] == ')') ? t : t - 1;
+      r = skipname (pp, sub_end, dname, flags);
+      if (!r)
+        return false;
+      pp = t;
+      if (pp == pe)
+        break;
+    }
+
+  if (pp == pat_end)
+    return r;
+
+  if (wild && pe < pat_end)
+    return skipname (pe, pat_end, dname, flags);
+
+  return true;
+}
+
+static bool
+skipname (const char *pat, const char *pat_end, const char *dname, int flags)
+{
+  bool quote = !(flags & GLOB_NOESCAPE);
+  if ((flags & GLOB_EXTMATCH) && pat + 2 <= pat_end && is_extglob (pat))
+    return extglob_skipname (pat, pat_end, dname, flags);
+
+  bool is_dot_or_dotdot = (dname[0] == '.'
+                           && (dname[1] == '\0'
+                               || (dname[1] == '.' && dname[2] == '\0')));
+  if ((flags & GLOB_SKIPDOTS) && is_dot_or_dotdot)
+    return true;
+
+  bool pat_starts_dot = (pat < pat_end
+                         && (pat[0] == '.'
+                             || (quote && pat + 1 < pat_end
+                                 && pat[0] == '\\' && pat[1] == '.')));
+
+  if ((flags & GLOB_PERIOD) && (flags & GLOB_DOTDOT) && !pat_starts_dot
+      && is_dot_or_dotdot)
+    return true;
+
+  if (!(flags & GLOB_PERIOD) && dname[0] == '.' && !pat_starts_dot)
+    return true;
+
+  return false;
+}
+
+/* Return 0 if DIR is a real directory, -2 if DIR is a symlink, -1 otherwise.  */
+static int
+glob_testdir (const char *dir, int flags, const glob_t *pglob, bool check_symlink)
+{
+  struct_stat st;
+  struct_stat64 st64;
+  if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+    {
+      int r = check_symlink ? pglob->GLOB_LSTAT (dir, &st)
+                            : pglob->gl_stat (dir, &st);
+      if (r < 0)
+        return -1;
+      if (check_symlink && S_ISLNK (st.st_mode))
+        return -2;
+      return S_ISDIR (st.st_mode) ? 0 : -1;
+    }
+  else
+    {
+      int r = GLOB_FSTATAT64 (AT_FDCWD, dir, &st64,
+                              check_symlink ? AT_SYMLINK_NOFOLLOW : 0);
+      if (r < 0)
+        return -1;
+      if (check_symlink && S_ISLNK (st64.st_mode))
+        return -2;
+      return S_ISDIR (st64.st_mode) ? 0 : -1;
+    }
+}
+
+/* Internal flags for globstar_scan.  */
+#define GS_ADDCURDIR 1
+#define GS_NULLDIR   2
+
+static int
+globstar_scan (const char *sdir, int flags, int gs_flags,
+               int (*errfunc) (const char *, int), glob_t *pglob)
+{
+  void *stream = (__builtin_expect (flags & GLOB_ALTDIRFUNC, 0)
+                  ? (*pglob->gl_opendir) (sdir)
+                  : opendir (sdir));
+  if (stream == NULL)
+    {
+      if (errno != ENOTDIR
+          && ((errfunc != NULL && (*errfunc) (sdir, errno))
+              || (flags & GLOB_ERR)))
+        return GLOB_ABORTED;
+      return 0;
+    }
+
+  if (gs_flags & GS_ADDCURDIR)
+    {
+      size_t newcount = pglob->gl_pathc + pglob->gl_offs;
+      if (newcount > SIZE_MAX / sizeof (char *) - 2)
+        {
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+      char **new_gl_pathv = realloc (pglob->gl_pathv,
+                                     (newcount + 2) * sizeof (char *));
+      if (new_gl_pathv == NULL)
+        {
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+      pglob->gl_pathv = new_gl_pathv;
+      pglob->gl_pathv[newcount] = strdup ((gs_flags & GS_NULLDIR) ? "" : sdir);
+      if (pglob->gl_pathv[newcount] == NULL)
+        {
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+      pglob->gl_pathv[newcount + 1] = NULL;
+      ++pglob->gl_pathc;
+    }
+
+  size_t sdirlen = strlen (sdir);
+  bool ign_dot = (gs_flags & GS_NULLDIR) && sdirlen == 1 && sdir[0] == '.';
+  bool rm_dot = (sdirlen == 1 && sdir[0] == '.');
+
+  while (1)
+    {
+      struct readdir_result d;
+      if (__builtin_expect (flags & GLOB_ALTDIRFUNC, 0))
+        d = convert_dirent (GL_READDIR (pglob, stream));
+      else
+        {
+#ifdef COMPILE_GLOB64
+          d = convert_dirent (__readdir (stream));
+#else
+          d = convert_dirent64 (__readdir64 (stream));
+#endif
+        }
+      if (d.name == NULL)
+        break;
+
+      if (d.name[0] == '.'
+          && (d.name[1] == '\0' || (d.name[1] == '.' && d.name[2] == '\0')))
+        continue;
+
+      if (skipname ("**", "**" + 2, d.name, flags))
+        continue;
+
+      size_t namelen = strlen (d.name);
+      char *subdir;
+      if (ign_dot || rm_dot)
+        subdir = strdup (d.name);
+      else if (sdirlen > 0 && sdir[sdirlen - 1] == '/')
+        {
+          subdir = malloc (sdirlen + namelen + 1);
+          if (subdir != NULL)
+            mempcpy (mempcpy (subdir, sdir, sdirlen), d.name, namelen + 1);
+        }
+      else
+        {
+          subdir = malloc (sdirlen + 1 + namelen + 1);
+          if (subdir != NULL)
+            {
+              char *p = mempcpy (subdir, sdir, sdirlen);
+              *p++ = '/';
+              memcpy (p, d.name, namelen + 1);
+            }
+        }
+      if (subdir == NULL)
+        {
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+
+      int isdir = glob_testdir (subdir, flags, pglob, true);
+      if ((flags & GLOB_ONLYDIR) && isdir < 0
+          && (isdir != -2 || glob_testdir (subdir, flags, pglob, false) < 0))
+        {
+          free (subdir);
+          continue;
+        }
+
+      size_t newcount = pglob->gl_pathc + pglob->gl_offs;
+      if (newcount > SIZE_MAX / sizeof (char *) - 2)
+        {
+          free (subdir);
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+      char **new_gl_pathv = realloc (pglob->gl_pathv,
+                                     (newcount + 2) * sizeof (char *));
+      if (new_gl_pathv == NULL)
+        {
+          free (subdir);
+          if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+            (*pglob->gl_closedir) (stream);
+          else
+            closedir (stream);
+          return GLOB_NOSPACE;
+        }
+      pglob->gl_pathv = new_gl_pathv;
+      pglob->gl_pathv[newcount] = subdir;
+      pglob->gl_pathv[newcount + 1] = NULL;
+      ++pglob->gl_pathc;
+
+      if (isdir == 0)
+        {
+          int r = globstar_scan (subdir, flags, 0, errfunc, pglob);
+          if (r != 0)
+            {
+              if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+                (*pglob->gl_closedir) (stream);
+              else
+                closedir (stream);
+              return r;
+            }
+        }
+    }
+
+  int save = errno;
+  if (__glibc_unlikely (flags & GLOB_ALTDIRFUNC))
+    (*pglob->gl_closedir) (stream);
+  else
+    closedir (stream);
+  __set_errno (save);
+  return 0;
+}
+
+
+static bool
+fc_has_dot_component (const char *s)
+{
+  while (*s != '\0')
+    {
+      if (s[0] == '.'
+          && (s[1] == '\0' || s[1] == '/'
+              || (s[1] == '.' && (s[2] == '\0' || s[2] == '/'))))
+        return true;
+      const char *slash = strchr (s, '/');
+      if (slash == NULL)
+        break;
+      if (slash[1] == '/' || slash[1] == '\0')
+        return true;
+      s = slash + 1;
+    }
+  return false;
+}
+
+static int
+fc_glob_try (const char *dirname, size_t dirlen, const char *filename,
+             int flags, glob_t *pglob, int *out_err)
+{
+  if (flags & (GLOB_ERR | GLOB_ALTDIRFUNC | GLOB_CASEFOLD
+               | GLOB_PERIOD | GLOB_KEEP_SLASHES))
+    return 0;
+  if (filename == NULL || filename[0] == '\0')
+    return 0;
+  if ((flags & GLOB_GLOBSTAR) != 0
+      && (strstr (dirname, "**") != NULL || strstr (filename, "**") != NULL))
+    return 0;
+
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+
+  /* Case A: prefix / * / sub1 */
+  if (dirlen >= 2 && dirname[dirlen - 2] == '/' && dirname[dirlen - 1] == '*'
+      && (dirlen == 2 || dirname[dirlen - 3] != '/'))
+    {
+      if (strcmp (filename, ".") != 0 && strcmp (filename, "..") != 0
+          && __glob_pattern_type_ext (filename, quote, extmatch) == GLOBPAT_NONE)
+        {
+          size_t prefix_len = (dirlen == 2) ? 1 : (dirlen - 2);
+          if (prefix_len < PATH_MAX)
+            {
+              char pbuf[PATH_MAX];
+              memcpy (pbuf, dirname, prefix_len);
+              pbuf[prefix_len] = '\0';
+              if (__glob_pattern_type_ext (pbuf, quote, extmatch) == GLOBPAT_NONE)
+                {
+                  struct fswc_view v;
+                  bool locked = false;
+                  if (fswc_glob_acquire_view (pbuf, prefix_len, &v, &locked))
+                    {
+                      size_t fnlen = strlen (filename);
+                      const struct fswc_ht_entry *tb
+                        = fswc_lookup (&v, 0U, filename, fnlen);
+                      if (tb != NULL
+                          && (flags & (GLOB_ONLYDIR | GLOB_MARK)) != 0
+                          && (tb->name_len_ns & FSWC_HT_EXT_LNK) != 0)
+                        {
+                          fswc_glob_release_view (locked);
+                          return 0;
+                        }
+                      int err = 0;
+                      if (tb != NULL)
+                        err = fswc_emit_ht_matches (&v, tb, pbuf, prefix_len,
+                                                    filename, fnlen,
+                                                    NULL, 0, flags, pglob);
+                      fswc_glob_release_view (locked);
+                      if (err != 0)
+                        {
+                          *out_err = err;
+                          return -1;
+                        }
+                      return 1;
+                    }
+                }
+            }
+        }
+      return 0;
+    }
+
+  /* Case B: prefix / * / sub1 / sub2 */
+  const char *last_slash = NULL;
+  for (size_t k = dirlen; k > 0; --k)
+    if (dirname[k - 1] == '/')
+      {
+        last_slash = dirname + (k - 1);
+        break;
+      }
+  if (last_slash != NULL && last_slash >= dirname + 2
+      && last_slash[-1] == '*' && last_slash[-2] == '/')
+    {
+      const char *sub1 = last_slash + 1;
+      size_t sub1_len = (size_t) ((dirname + dirlen) - sub1);
+      int sub1_id = fc_subdir_id (sub1, sub1_len);
+      if (sub1_id >= 0)
+        {
+          size_t star_pos = (size_t) (last_slash - 2 - dirname);
+          if (star_pos == 0 || dirname[star_pos - 1] != '/')
+            {
+              size_t prefix_len = (star_pos == 0) ? 1 : star_pos;
+              if (prefix_len < PATH_MAX)
+                {
+                  char pbuf[PATH_MAX];
+                  memcpy (pbuf, dirname, prefix_len);
+                  pbuf[prefix_len] = '\0';
+                  if (__glob_pattern_type_ext (pbuf, quote, extmatch) == GLOBPAT_NONE)
+                    {
+                      int fn_meta = __glob_pattern_type_ext (filename, quote, extmatch);
+                      struct fswc_view v;
+                      bool locked = false;
+                      if (fswc_glob_acquire_view (pbuf, prefix_len, &v, &locked))
+                        {
+                          int err = 0;
+                          size_t fnlen = strlen (filename);
+                          char unesc_fn[NAME_MAX + 1];
+                          const char *lit_fn = filename;
+                          size_t lit_len = fnlen;
+                          bool is_lit = (fn_meta == GLOBPAT_NONE);
+                          if (!is_lit
+                              && (fn_meta & (GLOBPAT_SPECIAL | GLOBPAT_BRACKET)) == 0
+                              && fnlen <= NAME_MAX)
+                            {
+                              char * dst = unesc_fn;
+                              for (const char *sp = filename; *sp != '\0'; ++sp)
+                                {
+                                  if (*sp == '\\' && sp[1] != '\0')
+                                    ++sp;
+                                  *dst++ = *sp;
+                                }
+                              *dst = '\0';
+                              lit_fn = unesc_fn;
+                              lit_len = (size_t) (dst - unesc_fn);
+                              is_lit = true;
+                            }
+                          if (is_lit
+                              && !(lit_len == 1 && lit_fn[0] == '.')
+                              && !(lit_len == 2 && lit_fn[0] == '.' && lit_fn[1] == '.'))
+                            {
+                              const struct fswc_ht_entry *sb
+                                = fswc_lookup (&v, (uint8_t) (sub1_id + 1),
+                                               lit_fn, lit_len);
+                              if (sb != NULL
+                                  && (flags & (GLOB_ONLYDIR | GLOB_MARK)) != 0
+                                  && (sb->name_len_ns & FSWC_HT_EXT_LNK) != 0)
+                                {
+                                  fswc_glob_release_view (locked);
+                                  return 0;
+                                }
+                              if (sb != NULL)
+                                err = fswc_emit_ht_matches (&v, sb,
+                                                            pbuf, prefix_len,
+                                                            sub1, sub1_len,
+                                                            lit_fn, lit_len,
+                                                            flags, pglob);
+                            }
+                          else if (!is_lit)
+                            {
+                              const struct fswc_ht_entry *tb
+                                = fswc_lookup (&v, 0U, sub1, sub1_len);
+                              if (tb != NULL)
+                                {
+                                  int fnm_flags
+                                    = (FNM_PATHNAME
+                                       | (!(flags & GLOB_PERIOD) ? FNM_PERIOD : 0)
+                                       | ((flags & GLOB_NOESCAPE) ? FNM_NOESCAPE : 0)
+                                       | ((flags & GLOB_EXTMATCH) ? FNM_EXTMATCH : 0)
+                                       | ((flags & GLOB_CASEFOLD) ? FNM_CASEFOLD : 0)
+                                       | ((flags & GLOB_DOTDOT) ? FNM_DOTDOT : 0));
+                                  const char *pat_end = filename + fnlen;
+                                  uint32_t inline_slot = 0;
+                                  uint32_t nfound = 0;
+                                  const uint32_t *list
+                                    = fswc_posting_slice (&v, tb->dir_count,
+                                                          tb->dir_ref,
+                                                          &inline_slot, &nfound);
+                                  for (uint32_t m = 0; m < nfound && err == 0; ++m)
+                                    {
+                                      uint32_t pkg_idx = list[m];
+                                      if (pkg_idx >= v.hdr->num_pkgs)
+                                        continue;
+                                      const struct fswc_pkg *pm = &v.pkgs[pkg_idx];
+                                      const char *pkg = v.strtab + pm->name_off;
+                                      size_t pkg_len = pm->name_len;
+                                      uint32_t st = pm->sub_start[sub1_id];
+                                      uint32_t cnt = pm->sub_count[sub1_id];
+                                      for (uint32_t k = 0; k < cnt; ++k)
+                                        {
+                                          const struct fswc_dirent *de
+                                            = &v.dirents[st + k];
+                                          bool de_is_dir
+                                            = (de->name_len_flags & FSWC_DE_IS_DIR) != 0;
+                                          bool de_ext_lnk
+                                            = (de->name_len_flags & FSWC_DE_EXT_LNK) != 0;
+                                          if ((flags & GLOB_ONLYDIR) && !de_is_dir && !de_ext_lnk)
+                                            continue;
+                                          uint32_t de_len
+                                            = de->name_len_flags & FSWC_DE_LEN_MASK;
+                                          const char *ename = v.strtab + de->name_off;
+                                          if (skipname (filename, pat_end, ename, flags))
+                                            continue;
+                                          if (fnmatch (filename, ename, fnm_flags) == 0)
+                                            {
+                                              if (de_ext_lnk
+                                                  && (flags & (GLOB_ONLYDIR | GLOB_MARK)) != 0)
+                                                {
+                                                  size_t pe = (prefix_len == 1 && pbuf[0] == '/') ? 0 : prefix_len;
+                                                  size_t fl = pe + 1 + pkg_len + 1 + sub1_len + 1 + de_len;
+                                                  if (fl >= PATH_MAX)
+                                                    continue;
+                                                  char lpath[PATH_MAX];
+                                                  char *lp = lpath;
+                                                  if (pe > 0)
+                                                    lp = mempcpy (lp, pbuf, pe);
+                                                  *lp++ = '/';
+                                                  lp = mempcpy (lp, pkg, pkg_len);
+                                                  *lp++ = '/';
+                                                  lp = mempcpy (lp, sub1, sub1_len);
+                                                  *lp++ = '/';
+                                                  memcpy (lp, ename, de_len + 1);
+                                                  de_is_dir = is_dir (lpath, flags, pglob);
+                                                  if ((flags & GLOB_ONLYDIR) && !de_is_dir)
+                                                    continue;
+                                                }
+                                              bool add_slash
+                                                = ((flags & GLOB_MARK) && de_is_dir);
+                                              err = fc_append_match (pglob,
+                                                                     pbuf, prefix_len,
+                                                                     pkg, pkg_len,
+                                                                     sub1, sub1_len,
+                                                                     ename, de_len,
+                                                                     add_slash);
+                                              if (err != 0)
+                                                break;
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                          fswc_glob_release_view (locked);
+                          if (err != 0)
+                            {
+                              *out_err = err;
+                              return -1;
+                            }
+                          return 1;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+  /* Case C: prefix / * / include / rel_dir / filename (literal up to depth 5) */
+  const char *inc_star = strstr (dirname, "/*/include/");
+  if (inc_star != NULL && (inc_star == dirname || inc_star[-1] != '/')
+      && strcmp (filename, ".") != 0 && strcmp (filename, "..") != 0
+      && __glob_pattern_type_ext (filename, quote, extmatch) == GLOBPAT_NONE)
+    {
+      size_t prefix_len = (inc_star == dirname) ? 1 : (size_t) (inc_star - dirname);
+      const char *rel_dir = inc_star + sizeof ("/*/include/") - 1;
+      size_t rel_dir_len = (size_t) ((dirname + dirlen) - rel_dir);
+      size_t fnlen = strlen (filename);
+      if (prefix_len < PATH_MAX && rel_dir_len > 0
