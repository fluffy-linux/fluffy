+static int
+fc_glob_try (const char *dirname, size_t dirlen, const char *filename,
+             int flags, glob_t *pglob, int *out_err)
+{
+  if (flags & (GLOB_ERR | GLOB_ALTDIRFUNC | GLOB_CASEFOLD
+               | GLOB_GLOBSTAR | GLOB_PERIOD | GLOB_KEEP_SLASHES))
+    return 0;
+  if (filename == NULL || filename[0] == '\0')
+    return 0;
+
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+
+  /* Case A: prefix / * / sub1 */
+  if (dirlen >= 2 && dirname[dirlen - 2] == '/' && dirname[dirlen - 1] == '*'
+      && (dirlen == 2 || dirname[dirlen - 3] != '/'))
+    {
+      if (strcmp (filename, ".") != 0 && strcmp (filename, "..") != 0
+          && __glob_pattern_type_ext (filename, quote, extmatch) == GLOBPAT_NONE)
+        {
+          size_t prefix_len = (dirlen == 2) ? 1 : (dirlen - 2);
+          if (prefix_len < 256)
+            {
+              char pbuf[256];
+              memcpy (pbuf, dirname, prefix_len);
+              pbuf[prefix_len] = '\0';
+              if (__glob_pattern_type_ext (pbuf, quote, extmatch) == GLOBPAT_NONE)
+                {
+#ifdef _LIBC
+                  __libc_lock_lock (fc_lock);
+#endif
+                  const struct fc_snapshot *snap = fc_get_snapshot (pbuf, prefix_len);
+                  if (snap != NULL)
+                    {
+                      size_t fnlen = strlen (filename);
+                      const struct fc_top_bucket *tb
+                        = fc_lookup_top (snap, filename, fnlen);
+                      int err = 0;
+                      if (tb != NULL)
+                        {
+                          const struct fc_mask *mask
+                            = (flags & GLOB_ONLYDIR) ? &tb->dir_mask : &tb->all_mask;
+                          err = fc_emit_mask_matches (snap, mask, &tb->dir_mask,
+                                                      pbuf, prefix_len,
+                                                      filename, fnlen,
+                                                      NULL, 0, flags, pglob);
+                        }
+#ifdef _LIBC
+                      __libc_lock_unlock (fc_lock);
+#endif
+                      if (err != 0)
+                        {
+                          *out_err = err;
+                          return -1;
+                        }
+                      return 1;
+                    }
+#ifdef _LIBC
+                  __libc_lock_unlock (fc_lock);
+#endif
+                }
+            }
+        }
+      return 0;
+    }
+
+  /* Case B: prefix / * / sub1 / sub2 */
+  const char *last_slash = memrchr (dirname, '/', dirlen);
+  if (last_slash != NULL && last_slash >= dirname + 2
+      && last_slash[-1] == '*' && last_slash[-2] == '/')
+    {
+      const char *sub1 = last_slash + 1;
+      size_t sub1_len = (size_t) ((dirname + dirlen) - sub1);
+      int sub1_id = fc_subdir_id (sub1, sub1_len);
+      if (sub1_id >= 0)
+        {
+          size_t star_pos = (size_t) (last_slash - 2 - dirname);
+          if (star_pos == 0 || dirname[star_pos - 1] != '/')
+            {
+              size_t prefix_len = (star_pos == 0) ? 1 : star_pos;
+              if (prefix_len < 256)
+                {
+                  char pbuf[256];
+                  memcpy (pbuf, dirname, prefix_len);
+                  pbuf[prefix_len] = '\0';
+                  if (__glob_pattern_type_ext (pbuf, quote, extmatch) == GLOBPAT_NONE)
+                    {
+                      int fn_meta = __glob_pattern_type_ext (filename, quote, extmatch);
+#ifdef _LIBC
+                      __libc_lock_lock (fc_lock);
+#endif
+                      const struct fc_snapshot *snap = fc_get_snapshot (pbuf, prefix_len);
+                      if (snap != NULL)
+                        {
+                          int err = 0;
+                          if (fn_meta == GLOBPAT_NONE
+                              && strcmp (filename, ".") != 0
+                              && strcmp (filename, "..") != 0)
+                            {
+                              size_t fnlen = strlen (filename);
+                              const struct fc_sub_bucket *sb
+                                = fc_lookup_sub (snap, (uint8_t) sub1_id,
+                                                 filename, fnlen);
+                              if (sb != NULL)
+                                {
+                                  const struct fc_mask *mask
+                                    = ((flags & GLOB_ONLYDIR)
+                                       ? &sb->dir_mask : &sb->all_mask);
+                                  err = fc_emit_mask_matches (snap, mask,
+                                                              &sb->dir_mask,
+                                                              pbuf, prefix_len,
+                                                              sub1, sub1_len,
+                                                              filename, fnlen,
+                                                              flags, pglob);
+                                }
+                            }
+                          else if (fn_meta != GLOBPAT_NONE)
+                            {
+                              const struct fc_top_bucket *tb
+                                = fc_lookup_top (snap, sub1, sub1_len);
+                              if (tb != NULL)
+                                {
+                                  int fnm_flags
+                                    = (FNM_PATHNAME
+                                       | (!(flags & GLOB_PERIOD) ? FNM_PERIOD : 0)
+                                       | ((flags & GLOB_NOESCAPE) ? FNM_NOESCAPE : 0)
+                                       | ((flags & GLOB_EXTMATCH) ? FNM_EXTMATCH : 0)
+                                       | ((flags & GLOB_CASEFOLD) ? FNM_CASEFOLD : 0)
+                                       | ((flags & GLOB_DOTDOT) ? FNM_DOTDOT : 0));
+                                  const char *pat_end = filename + strlen (filename);
+                                  for (size_t w = 0; w < FC_MAX_PKGS / 64 && err == 0; ++w)
+                                    {
+                                      uint64_t word = tb->dir_mask.bits[w];
+                                      while (word != 0)
+                                        {
+                                          unsigned int bit = (unsigned int) __builtin_ctzll (word);
+                                          word &= word - 1;
+                                          uint32_t pkg_idx = (uint32_t) (w * 64 + bit);
+                                          const char *pkg = snap->pkg_names[pkg_idx];
+                                          size_t pkg_len = strlen (pkg);
+                                          const struct fc_pkg_meta *pm = &snap->pkg_meta[pkg_idx];
+                                          uint32_t st = pm->sub_start[sub1_id];
+                                          uint16_t cnt = pm->sub_count[sub1_id];
+                                          for (uint16_t k = 0; k < cnt; ++k)
+                                            {
+                                              const struct fc_dirent *de = &snap->dirents[st + k];
+                                              if ((flags & GLOB_ONLYDIR) && !de->is_dir)
+                                                continue;
+                                              const char *ename = snap->strtab + de->name_off;
+                                              if (skipname (filename, pat_end, ename, flags))
+                                                continue;
+                                              if (fnmatch (filename, ename, fnm_flags) == 0)
+                                                {
+                                                  bool add_slash = ((flags & GLOB_MARK) && de->is_dir);
+                                                  err = fc_append_match (pglob, pbuf, prefix_len,
+                                                                         pkg, pkg_len,
+                                                                         sub1, sub1_len,
+                                                                         ename, de->name_len,
+                                                                         add_slash);
+                                                  if (err != 0)
+                                                    break;
+                                                }
+                                            }
+                                          if (err != 0)
+                                            break;
+                                        }
+                                    }
+                                }
+                            }
+#ifdef _LIBC
+                          __libc_lock_unlock (fc_lock);
+#endif
+                          if (err != 0)
+                            {
+                              *out_err = err;
+                              return -1;
+                            }
+                          return 1;
+                        }
+#ifdef _LIBC
+                      __libc_lock_unlock (fc_lock);
+#endif
+                    }
+                }
+            }
+        }
+    }
+  return 0;
+}
