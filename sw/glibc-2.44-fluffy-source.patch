+#ifdef FC_WITH_EXECVPE_HELPERS
+# define FC_EXECVPE_MAX_MATCHES 8
+
+/* Lock-free, CLONE_VM/CLONE_VFORK-safe lookup for execvpe/posix_spawnp.
+   Always unmaps any temporary snapshot before returning so no mappings leak
+   into a CLONE_VM parent on execve.  */
+static int
+fc_execvpe_lookup (const char *prefix, size_t prefix_len,
+                   const char *sub1, size_t sub1_len,
+                   const char *file, size_t file_len_no_nul,
+                   char out_pkgs[FC_EXECVPE_MAX_MATCHES][FC_MAX_PKG_NAME])
+{
+  if (prefix_len == 0 || prefix_len >= 256 || file_len_no_nul == 0)
+    return -1;
+  int sub1_id = fc_subdir_id (sub1, sub1_len);
+  if (sub1_id < 0)
+    return -1;
+
+  struct statx stx;
+  uint32_t mnt_count = 0;
+  uint64_t mnt_h1 = 0, mnt_h2 = 0;
+  if (fc_get_prefix_state (prefix, &stx, &mnt_count, &mnt_h1, &mnt_h2) < 0)
+    return -1;
+
+  uid_t euid = (uid_t) FC_SYSCALL0 (geteuid);
+  gid_t egid = (gid_t) FC_SYSCALL0 (getegid);
+
+  struct fc_snapshot *snap = fc_map_shm_snapshot (euid, egid);
+  if (snap == NULL
+      || !fc_snapshot_matches (snap, prefix, prefix_len, &stx,
+                               mnt_count, mnt_h1, mnt_h2))
+    {
+      long m = FC_SYSCALL (mmap, 0, sizeof (struct fc_snapshot),
+                           PROT_READ | PROT_WRITE,
+                           MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      if (fc_syscall_err (m))
+        {
+          if (snap != NULL)
+            FC_SYSCALL (munmap, snap, sizeof (struct fc_snapshot));
+          return -1;
+        }
+      struct fc_snapshot *new_snap = (struct fc_snapshot *) m;
+      int br = fc_build_snapshot (new_snap, snap, prefix, prefix_len,
+                                  &stx, mnt_count, mnt_h1, mnt_h2);
+      if (snap != NULL)
+        FC_SYSCALL (munmap, snap, sizeof (struct fc_snapshot));
+      if (br < 0)
+        {
+          FC_SYSCALL (munmap, new_snap, sizeof (struct fc_snapshot));
+          return -1;
+        }
+      fc_write_shm_snapshot (new_snap, euid, egid);
+      snap = new_snap;
+    }
+
+  const struct fc_sub_bucket *sb
+    = fc_lookup_sub (snap, (uint8_t) sub1_id, file, file_len_no_nul);
+  int count = 0;
+  if (sb != NULL)
+    {
+      for (size_t w = 0; w < FC_MAX_PKGS / 64; ++w)
+        {
+          uint64_t word = sb->all_mask.bits[w];
+          while (word != 0)
+            {
+              if (count >= FC_EXECVPE_MAX_MATCHES)
+                {
+                  FC_SYSCALL (munmap, snap, sizeof (struct fc_snapshot));
+                  return -1;
+                }
+              unsigned int bit = (unsigned int) __builtin_ctzll (word);
+              word &= word - 1;
+              uint32_t pkg_idx = (uint32_t) (w * 64 + bit);
+              memcpy (out_pkgs[count++], snap->pkg_names[pkg_idx],
+                      FC_MAX_PKG_NAME);
+            }
+        }
+    }
+
+  FC_SYSCALL (munmap, snap, sizeof (struct fc_snapshot));
+  return count;
+}
+#endif /* FC_WITH_EXECVPE_HELPERS */
