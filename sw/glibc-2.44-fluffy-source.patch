+      int fswc_err = __fswc_probe_exact (path);
+      if (fswc_err < 0)
+        return INLINE_SYSCALL_ERROR_RETURN_VALUE (-fswc_err);
+    }
+#endif
+
   int ret = INLINE_SYSCALL_CALL (statx, fd, path, flags, mask, buf);
 #ifdef __ASSUME_STATX
