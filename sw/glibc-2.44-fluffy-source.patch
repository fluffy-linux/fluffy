+static int
+glob_literal_suffix_try (const char *dirname, size_t dirlen,
+                         const char *filename, int flags,
+                         glob_t *pglob, int *out_err)
+{
+  if (flags & (GLOB_ERR | GLOB_ALTDIRFUNC | GLOB_CASEFOLD
+               | GLOB_GLOBSTAR | GLOB_PERIOD | GLOB_KEEP_SLASHES))
+    return 0;
+  if (filename == NULL || filename[0] == '\0'
+      || strcmp (filename, ".") == 0 || strcmp (filename, "..") == 0)
+    return 0;
+
+  bool quote = !(flags & GLOB_NOESCAPE);
+  bool extmatch = (flags & GLOB_EXTMATCH) != 0;
+  if (__glob_pattern_type_ext (filename, quote, extmatch) != GLOBPAT_NONE)
+    return 0;
+
+  const char *star = strstr (dirname, "/*");
+  if (star == NULL || (star > dirname && star[-1] == '/'))
+    return 0;
+  if (star[2] != '\0' && (star[2] != '/' || star[3] == '\0' || star[3] == '/'))
+    return 0;
+
+  size_t prefix_len = (star == dirname) ? 1 : (size_t) (star - dirname);
+  if (prefix_len >= PATH_MAX)
+    return 0;
+
+  char pbuf[PATH_MAX];
+  memcpy (pbuf, dirname, prefix_len);
+  pbuf[prefix_len] = '\0';
+  if (__glob_pattern_type_ext (pbuf, quote, extmatch) != GLOBPAT_NONE)
+    return 0;
+
+  const char *mid = (star[2] == '/') ? (star + 3) : NULL;
+  size_t mid_len = (mid != NULL) ? (size_t) ((dirname + dirlen) - mid) : 0;
+  if (mid != NULL)
+    {
+      if (__glob_pattern_type_ext (mid, quote, extmatch) != GLOBPAT_NONE
+          || fc_has_dot_component (mid))
+        return 0;
+    }
+
+  size_t fnlen = strlen (filename);
+  DIR *stream = opendir (pbuf);
+  if (stream == NULL)
+    return 1;
+
+  int dfd = dirfd (stream);
+  while (1)
+    {
+      struct readdir_result d;
+#ifdef COMPILE_GLOB64
+      d = convert_dirent (__readdir (stream));
+#else
+      d = convert_dirent64 (__readdir64 (stream));
+#endif
+      if (d.name == NULL)
+        break;
+      if (d.name[0] == '.')
+        continue;
+      dirent_type dtype = readdir_result_type (d);
+      if (dtype != DT_DIR && dtype != DT_LNK && dtype != DT_UNKNOWN)
+        continue;
+
+      size_t dlen = strlen (d.name);
+      size_t rel_len = dlen + (mid != NULL ? 1 + mid_len : 0) + 1 + fnlen;
+      if (rel_len >= PATH_MAX)
+        continue;
+
+      char rel_path[PATH_MAX];
+      char *rp = mempcpy (rel_path, d.name, dlen);
+      if (mid != NULL)
+        {
+          *rp++ = '/';
+          rp = mempcpy (rp, mid, mid_len);
+        }
+      *rp++ = '/';
+      memcpy (rp, filename, fnlen + 1);
+
+      struct_stat64 st64;
+      int st_flags = (flags & GLOB_ONLYDIR) ? 0 : AT_SYMLINK_NOFOLLOW;
+      if (GLOB_FSTATAT64 (dfd, rel_path, &st64, st_flags) == 0
+          && (!(flags & GLOB_ONLYDIR) || S_ISDIR (st64.st_mode)))
+        {
+          bool add_slash = false;
+          if (flags & GLOB_MARK)
+            {
+              if (S_ISDIR (st64.st_mode))
+                add_slash = true;
+              else if (S_ISLNK (st64.st_mode)
+                       && GLOB_FSTATAT64 (dfd, rel_path, &st64, 0) == 0
+                       && S_ISDIR (st64.st_mode))
+                add_slash = true;
+            }
+          int err = fc_append_match (pglob, pbuf, prefix_len,
+                                     d.name, dlen,
+                                     mid != NULL ? mid : filename,
+                                     mid != NULL ? mid_len : fnlen,
+                                     mid != NULL ? filename : NULL,
+                                     mid != NULL ? fnlen : 0,
+                                     add_slash);
+          if (err != 0)
+            {
+              closedir (stream);
+              *out_err = err;
+              return -1;
+            }
+        }
+    }
+
+  closedir (stream);
+  return 1;
+}
