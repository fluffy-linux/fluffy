+#ifdef FC_WITH_RTLD_HELPERS
+static struct fc_snapshot *fc_rtld_snap = NULL;
+static uint16_t fc_rtld_dir_pkg_idx[FC_MAX_PKGS];
+
+static const struct fc_snapshot *
+fc_rtld_get_snapshot (const char *prefix, size_t prefix_len)
+{
+  if (prefix_len == 0 || prefix_len >= 256)
+    return NULL;
+
+  struct statx stx;
+  uint32_t mnt_count = 0;
+  uint64_t mnt_h1 = 0, mnt_h2 = 0;
+  if (fc_get_prefix_state (prefix, &stx, &mnt_count, &mnt_h1, &mnt_h2) < 0)
+    return NULL;
+
+  if (fc_rtld_snap != NULL
+      && fc_snapshot_matches (fc_rtld_snap, prefix, prefix_len, &stx,
+                              mnt_count, mnt_h1, mnt_h2))
+    return fc_rtld_snap;
+
+  uid_t euid = (uid_t) FC_SYSCALL0 (geteuid);
+  gid_t egid = (gid_t) FC_SYSCALL0 (getegid);
+
+  struct fc_snapshot *shm_snap = fc_map_shm_snapshot (euid, egid);
+  if (shm_snap != NULL)
+    {
+      if (fc_rtld_snap != NULL)
+        FC_SYSCALL (munmap, fc_rtld_snap, sizeof (struct fc_snapshot));
+      fc_rtld_snap = shm_snap;
+      if (fc_snapshot_matches (fc_rtld_snap, prefix, prefix_len, &stx,
+                              mnt_count, mnt_h1, mnt_h2))
+        return fc_rtld_snap;
+    }
+
+  long m = FC_SYSCALL (mmap, 0, sizeof (struct fc_snapshot),
+                       PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (fc_syscall_err (m))
+    return NULL;
+  struct fc_snapshot *new_snap = (struct fc_snapshot *) m;
+
+  if (fc_build_snapshot (new_snap, fc_rtld_snap, prefix, prefix_len,
+                         &stx, mnt_count, mnt_h1, mnt_h2) < 0)
+    {
+      FC_SYSCALL (munmap, new_snap, sizeof (struct fc_snapshot));
+      return NULL;
+    }
+
+  fc_write_shm_snapshot (new_snap, euid, egid);
+  if (fc_rtld_snap != NULL)
+    FC_SYSCALL (munmap, fc_rtld_snap, sizeof (struct fc_snapshot));
+  fc_rtld_snap = new_snap;
+  return fc_rtld_snap;
+}
