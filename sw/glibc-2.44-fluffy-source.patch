+      if (memcmp (name, "alnum", 5) == 0)
+	return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z')
+	       || (c >= 'a' && c <= 'z');
+      if (memcmp (name, "alpha", 5) == 0)
+	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+      if (memcmp (name, "ascii", 5) == 0)
+	return c <= 0x7f;
+      if (memcmp (name, "blank", 5) == 0)
+	return c == ' ' || c == '\t';
+      if (memcmp (name, "cntrl", 5) == 0)
+	return c < 0x20 || c == 0x7f;
+      if (memcmp (name, "digit", 5) == 0)
+	return c >= '0' && c <= '9';
+      if (memcmp (name, "graph", 5) == 0)
+	return c >= 0x21 && c <= 0x7e;
+      if (memcmp (name, "lower", 5) == 0)
+	return c >= 'a' && c <= 'z';
+      if (memcmp (name, "print", 5) == 0)
+	return c >= 0x20 && c <= 0x7e;
+      if (memcmp (name, "punct", 5) == 0)
+	return (c >= 0x21 && c <= 0x2f) || (c >= 0x3a && c <= 0x40)
+	       || (c >= 0x5b && c <= 0x60) || (c >= 0x7b && c <= 0x7e);
+      if (memcmp (name, "space", 5) == 0)
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r'
+	       || c == '\v' || c == '\f';
+      if (memcmp (name, "upper", 5) == 0)
+	return c >= 'A' && c <= 'Z';
