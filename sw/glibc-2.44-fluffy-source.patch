+  if (errno != ENOENT && errno != EACCES && errno != ENOTDIR)
+    {
+      struct __stat64_t64 st;
+      buf[buflen - namelen] = '\0';
+      if (__stat64_time64 (buf, &st) == 0 && S_ISDIR (st.st_mode))
+	*out_fatal_err = true;
+    }
+  return -1;
+}
