+/* Validate Tier-1 pkg_* cache file.  */
+static bool
+fswc_validate_pkg_cache (const void *map, size_t map_sz,
+                         uint64_t id_lo, uint64_t id_hi)
+{
+  if (map == NULL || map_sz < sizeof (struct fswc_pkg_cache_hdr)
+      || map_sz > FSWC_BLOB_MAX_SIZE)
+    return false;
+  const struct fswc_pkg_cache_hdr *h = (const struct fswc_pkg_cache_hdr *) map;
+  if (h->magic != FSWC_PKG_MAGIC
+      || h->version != FSWC_PKG_VERSION
+      || h->total_size != (uint64_t) map_sz
+      || h->pkg_id_lo != id_lo
+      || h->pkg_id_hi != id_hi
+      || h->num_dirs == 0
+      || h->strtab_size == 0)
+    return false;
+  if (!fswc_check_section (h->total_size, h->dirs_off, h->num_dirs,
+                           sizeof (struct fswc_pkg_cache_dir))
+      || !fswc_check_section (h->total_size, h->entries_off, h->num_entries,
+                              sizeof (struct fswc_pkg_cache_ent))
+      || !fswc_check_section (h->total_size, h->strtab_off, h->strtab_size, 1))
+    return false;
+  const uint8_t *base = (const uint8_t *) map;
+  const char *strtab = (const char *) (base + h->strtab_off);
+  if (strtab[h->strtab_size - 1] != '\0')
+    return false;
+
+  const struct fswc_pkg_cache_dir *pdirs
+    = (const struct fswc_pkg_cache_dir *) (base + h->dirs_off);
+  const struct fswc_pkg_cache_ent *pents
+    = (const struct fswc_pkg_cache_ent *) (base + h->entries_off);
+
+  for (uint32_t d = 0; d < h->num_dirs; ++d)
+    if ((uint64_t) pdirs[d].entries_start + pdirs[d].entries_count
+        > h->num_entries)
+      return false;
+
+  for (uint32_t e = 0; e < h->num_entries; ++e)
+    {
+      if (!fswc_valid_str_ent (strtab, h->strtab_size,
+                               pents[e].name_off, pents[e].name_len))
+        return false;
+      if (pents[e].child_dir_idx != FSWC_NONE
+          && pents[e].child_dir_idx >= h->num_dirs)
+        return false;
+    }
+
+  return true;
+}
+
+/* Scan a single SquashFS package directory tree (BFS topological order)
+   into an in-memory fswc_pkg_cache_hdr buffer.  */
+struct fswc_scan_qitem
+{
+  int dfd;
+  uint32_t dir_idx;
+  uint16_t dir_flags;
+};
+
+static void *
+fswc_scan_squashfs_pkg (int root_dfd, uint64_t pkg_id_lo, uint64_t pkg_id_hi,
+                        size_t max_inodes, size_t *io_inodes,
+                        size_t *out_buf_sz)
+{
+  *out_buf_sz = 0;
+
+  struct statx rstx;
+  if (INTERNAL_SYSCALL_CALL (statx, root_dfd, "", AT_EMPTY_PATH,
+                             STATX_TYPE | STATX_MODE, &rstx) != 0
+      || !S_ISDIR (rstx.stx_mode))
+    return NULL;
+
+  bool root_no_acl = fswc_fd_no_posix_acl (root_dfd);
+  uint16_t root_dflags = 0;
+  if (root_no_acl && (rstx.stx_mode & 0111) == 0111)
+    root_dflags |= FSWC_DIR_WORLD_SEARCH;
+  if (root_no_acl && (rstx.stx_mode & 0555) == 0555)
+    root_dflags |= FSWC_DIR_WORLD_RX;
+
+  struct fswc_arena dirs_ar, ents_ar, str_ar, q_ar, tmp_ents_ar;
+  fswc_arena_init (&dirs_ar);
+  fswc_arena_init (&ents_ar);
+  fswc_arena_init (&str_ar);
+  fswc_arena_init (&q_ar);
+  fswc_arena_init (&tmp_ents_ar);
+  size_t q_head = 0;
+  size_t q_tail = 0;
+
+  /* Put "" at strtab offset 0.  */
+  char *z = fswc_arena_alloc (&str_ar, 1, 1);
+  if (z == NULL)
+    goto fail;
+  *z = '\0';
+
+  struct fswc_pkg_cache_dir *d0
+    = fswc_arena_alloc (&dirs_ar, sizeof (*d0), _Alignof (struct fswc_pkg_cache_dir));
+  struct fswc_scan_qitem *q0
+    = fswc_arena_alloc (&q_ar, sizeof (*q0), _Alignof (struct fswc_scan_qitem));
+  if (d0 == NULL || q0 == NULL)
+    goto fail;
+
+  d0->parent_dir_idx = FSWC_NONE;
+  d0->name_off = 0;
+  d0->name_len = 0;
+  d0->dir_flags = root_dflags;
+  d0->entries_start = 0;
+  d0->entries_count = 0;
+
+  q0->dfd = root_dfd; /* Borrowed; do not close qidx == 0! */
+  q0->dir_idx = 0;
+  q0->dir_flags = root_dflags;
+  q_tail = 1;
+
+  uint32_t pkg_flags = (FSWC_PKG_IMMUTABLE
+                        | ((root_dflags & FSWC_DIR_WORLD_SEARCH)
+                           ? FSWC_PKG_ALL_WORLD_SEARCH : 0)
+                        | ((root_dflags & FSWC_DIR_WORLD_RX)
+                           ? FSWC_PKG_ALL_WORLD_RX : 0));
+
+  uint8_t dbuf[8192];
+
+  while (q_head < q_tail)
+    {
+      struct fswc_scan_qitem cur
+        = ((struct fswc_scan_qitem *) q_ar.base)[q_head];
+      tmp_ents_ar.used = 0;
+      uint32_t local_cnt = 0;
+
+      for (;;)
+        {
+          long nr = INTERNAL_SYSCALL_CALL (getdents64, cur.dfd, dbuf,
+                                           sizeof (dbuf));
+          if (nr < 0)
+            goto fail;
+          if (nr == 0)
+            break;
+
+          for (long off = 0; off < nr; )
+            {
+              const struct dirent64 *de = (const struct dirent64 *) (dbuf + off);
+              off += de->d_reclen;
+              if (de->d_name[0] == '.'
+                  && (de->d_name[1] == '\0'
+                      || (de->d_name[1] == '.' && de->d_name[2] == '\0')))
+                continue;
+
+              ++(*io_inodes);
+              if (max_inodes != 0 && *io_inodes > max_inodes)
+                goto fail;
+
+              size_t nlen = strlen (de->d_name);
+              if (nlen == 0 || nlen > NAME_MAX)
+                goto fail;
+
+              uint8_t dt = de->d_type;
+              if (dt == DT_UNKNOWN)
+                {
+                  struct statx estx;
+                  if (INTERNAL_SYSCALL_CALL (statx, cur.dfd, de->d_name,
+                                             AT_SYMLINK_NOFOLLOW,
+                                             STATX_TYPE, &estx) == 0)
+                    dt = IFTODT (estx.stx_mode);
+                }
+
+              char *s = fswc_arena_alloc (&str_ar, nlen + 1, 1);
+              struct fswc_pkg_cache_ent *pe
+                = fswc_arena_alloc (&tmp_ents_ar, sizeof (*pe),
+                                    _Alignof (struct fswc_pkg_cache_ent));
+              if (s == NULL || pe == NULL)
+                goto fail;
+              uint32_t soff = (uint32_t) ((uint8_t *) s - str_ar.base);
+              memcpy (s, de->d_name, nlen + 1);
+
+              pe->name_off = soff;
+              pe->name_len = (uint16_t) nlen;
+              pe->d_type = dt;
+              pe->child_dir_flags = 0;
+              pe->child_dir_idx = FSWC_NONE;
+              ++local_cnt;
+            }
+        }
+
+      uint32_t estart
+        = (uint32_t) (ents_ar.used / sizeof (struct fswc_pkg_cache_ent));
+      if (local_cnt > 0)
+        {
+          struct fswc_pkg_cache_ent *dst
+            = fswc_arena_alloc (&ents_ar,
+                                local_cnt * sizeof (struct fswc_pkg_cache_ent),
+                                _Alignof (struct fswc_pkg_cache_ent));
+          if (dst == NULL)
+            goto fail;
+          memcpy (dst, tmp_ents_ar.base,
+                  local_cnt * sizeof (struct fswc_pkg_cache_ent));
+
+          for (uint32_t k = 0; k < local_cnt; ++k)
+            {
+              struct fswc_pkg_cache_ent *pe
+                = &((struct fswc_pkg_cache_ent *) ents_ar.base)[estart + k];
+              if (pe->d_type != DT_DIR)
+                continue;
+
+              const char *cname = (const char *) str_ar.base + pe->name_off;
+              long cfd = INTERNAL_SYSCALL_CALL (openat, cur.dfd, cname,
+                                                O_RDONLY | O_DIRECTORY
+                                                | O_NOFOLLOW | O_CLOEXEC, 0);
+              if (INTERNAL_SYSCALL_ERROR_P (cfd))
+                {
+                  /* Unreadable subdir (e.g. 0700 root-only dir scanned by
+                     unprivileged user): keep DT_DIR entry with child_dir_idx
+                     = FSWC_NONE and flags = 0 so queries into it fall through
+                     to kernel for exact EACCES / errfunc handling.  */
+                  pe->child_dir_flags = 0;
+                  pe->child_dir_idx = FSWC_NONE;
+                  pkg_flags &= ~(FSWC_PKG_ALL_WORLD_SEARCH
+                                 | FSWC_PKG_ALL_WORLD_RX);
+                  continue;
+                }
+
+              struct statx cstx;
+              uint16_t cdflags = 0;
+              if (INTERNAL_SYSCALL_CALL (statx, (int) cfd, "", AT_EMPTY_PATH,
+                                         STATX_MODE, &cstx) == 0)
+                {
+                  bool no_acl = fswc_fd_no_posix_acl ((int) cfd);
+                  if (no_acl && (cstx.stx_mode & 0111) == 0111)
+                    cdflags |= FSWC_DIR_WORLD_SEARCH;
+                  if (no_acl && (cstx.stx_mode & 0555) == 0555)
+                    cdflags |= FSWC_DIR_WORLD_RX;
+                }
+              if (!(cdflags & FSWC_DIR_WORLD_SEARCH))
+                pkg_flags &= ~FSWC_PKG_ALL_WORLD_SEARCH;
+              if (!(cdflags & FSWC_DIR_WORLD_RX))
+                pkg_flags &= ~FSWC_PKG_ALL_WORLD_RX;
+
+              uint32_t new_didx
+                = (uint32_t) (dirs_ar.used / sizeof (struct fswc_pkg_cache_dir));
+              struct fswc_pkg_cache_dir *nd
+                = fswc_arena_alloc (&dirs_ar, sizeof (*nd),
+                                    _Alignof (struct fswc_pkg_cache_dir));
+              struct fswc_scan_qitem *nq
+                = fswc_arena_alloc (&q_ar, sizeof (*nq),
+                                    _Alignof (struct fswc_scan_qitem));
+              if (nd == NULL || nq == NULL)
+                {
+                  INTERNAL_SYSCALL_CALL (close, (int) cfd);
+                  goto fail;
+                }
+              /* Refresh pe pointer in case ents_ar was untouched.  */
+              pe = &((struct fswc_pkg_cache_ent *) ents_ar.base)[estart + k];
+              pe->child_dir_flags = (uint8_t) cdflags;
+              pe->child_dir_idx = new_didx;
+
+              nd->parent_dir_idx = cur.dir_idx;
+              nd->name_off = pe->name_off;
+              nd->name_len = pe->name_len;
+              nd->dir_flags = cdflags;
+              nd->entries_start = 0;
+              nd->entries_count = 0;
+
+              nq->dfd = (int) cfd;
+              nq->dir_idx = new_didx;
+              nq->dir_flags = cdflags;
+              ++q_tail;
+            }
+        }
+
+      struct fswc_pkg_cache_dir *cd
+        = &((struct fswc_pkg_cache_dir *) dirs_ar.base)[cur.dir_idx];
+      cd->entries_start = estart;
+      cd->entries_count = local_cnt;
+
+      if (q_head > 0)
+        {
+          INTERNAL_SYSCALL_CALL (close, cur.dfd);
+          ((struct fswc_scan_qitem *) q_ar.base)[q_head].dfd = -1;
+        }
+      ++q_head;
+    }
+
+  uint32_t num_dirs
+    = (uint32_t) (dirs_ar.used / sizeof (struct fswc_pkg_cache_dir));
+  uint32_t num_ents
+    = (uint32_t) (ents_ar.used / sizeof (struct fswc_pkg_cache_ent));
+  uint32_t str_sz = (uint32_t) str_ar.used;
+
+  uint64_t dirs_off = fswc_align8 (sizeof (struct fswc_pkg_cache_hdr));
+  uint64_t ents_off = fswc_align8 (dirs_off + dirs_ar.used);
+  uint64_t str_off = fswc_align8 (ents_off + ents_ar.used);
+  uint64_t total_sz = fswc_align8 (str_off + str_ar.used);
+  if (total_sz > FSWC_BLOB_MAX_SIZE)
+    goto fail;
+
+  uint8_t *out = fswc_sys_mmap_anon ((size_t) total_sz);
+  if (out == NULL)
+    goto fail;
+
+  struct fswc_pkg_cache_hdr *hdr = (struct fswc_pkg_cache_hdr *) out;
+  hdr->magic = FSWC_PKG_MAGIC;
+  hdr->version = FSWC_PKG_VERSION;
+  hdr->total_size = total_sz;
+  hdr->pkg_id_lo = pkg_id_lo;
+  hdr->pkg_id_hi = pkg_id_hi;
+  hdr->pkg_flags = pkg_flags;
+  hdr->num_dirs = num_dirs;
+  hdr->num_entries = num_ents;
+  hdr->strtab_size = str_sz;
+  hdr->dirs_off = (uint32_t) dirs_off;
+  hdr->entries_off = (uint32_t) ents_off;
+  hdr->strtab_off = (uint32_t) str_off;
+  hdr->reserved = 0;
+
+  if (dirs_ar.used > 0)
+    memcpy (out + dirs_off, dirs_ar.base, dirs_ar.used);
+  if (ents_ar.used > 0)
+    memcpy (out + ents_off, ents_ar.base, ents_ar.used);
+  if (str_ar.used > 0)
+    memcpy (out + str_off, str_ar.base, str_ar.used);
+
+  fswc_arena_free (&dirs_ar);
+  fswc_arena_free (&ents_ar);
+  fswc_arena_free (&str_ar);
+  fswc_arena_free (&q_ar);
+  fswc_arena_free (&tmp_ents_ar);
+  *out_buf_sz = (size_t) total_sz;
+  return out;
+
+fail:
+  if (q_ar.base != NULL)
+    for (size_t i = (q_head > 0 ? q_head : 1); i < q_tail; ++i)
+      {
+        int fd = ((struct fswc_scan_qitem *) q_ar.base)[i].dfd;
+        if (fd >= 0)
+          INTERNAL_SYSCALL_CALL (close, fd);
+      }
+  fswc_arena_free (&dirs_ar);
+  fswc_arena_free (&ents_ar);
+  fswc_arena_free (&str_ar);
+  fswc_arena_free (&q_ar);
+  fswc_arena_free (&tmp_ents_ar);
+  return NULL;
+}
+
+/* Builder structures for assembling Merged Virtual Trie blob.  */
+struct fswc_bld_post_node
+{
+  uint32_t packed_word;
+  uint32_t next_node; /* FSWC_NONE or index in post_nodes[] */
+};
+
+struct fswc_bld_post_list
+{
+  uint32_t head;
+  uint32_t tail;
+  uint16_t count;
+};
+
+struct fswc_bld_ent
+{
+  uint64_t hash;
+  uint32_t parent_vdir_id;
+  uint32_t name_off;
+  uint16_t name_len;
+  uint16_t flags;
+  uint32_t child_vdir_id;
+  uint16_t dir_cnt;
+  struct fswc_bld_post_list all_posts;
+  uint32_t next_child_in_vdir; /* Linked list of children in parent vdir */
+  uint32_t final_ht_slot;
+};
+
+struct fswc_bld_vdir
+{
+  uint32_t first_ent;
+  uint32_t children_count;
+  uint16_t flags;
+  struct fswc_bld_post_list dir_posts;
+};
+
+struct fswc_pkg_input
+{
+  const char *name;
+  uint16_t name_len;
+  uint64_t pkg_id_lo;
+  uint64_t pkg_id_hi;
+  const struct fswc_pkg_cache_hdr *pcache;
+  size_t pcache_sz;
+};
+
+static bool
+fswc_bld_post_append (struct fswc_arena *nodes_ar,
+                      struct fswc_bld_post_list *lst, uint32_t word)
+{
+  uint32_t idx
+    = (uint32_t) (nodes_ar->used / sizeof (struct fswc_bld_post_node));
+  struct fswc_bld_post_node *n
+    = fswc_arena_alloc (nodes_ar, sizeof (*n),
+                        _Alignof (struct fswc_bld_post_node));
+  if (n == NULL)
+    return false;
+  n->packed_word = word;
+  n->next_node = FSWC_NONE;
+  if (lst->count == 0)
+    lst->head = idx;
+  else
+    ((struct fswc_bld_post_node *) nodes_ar->base)[lst->tail].next_node = idx;
+  lst->tail = idx;
+  ++lst->count;
+  return true;
+}
+
+static bool
+fswc_bld_ht_grow (struct fswc_arena *bht_ar, uint32_t *bht_mask,
+                  const struct fswc_bld_ent *ents, uint32_t num_ents)
+{
+  uint32_t new_cap = *bht_mask == 0 ? 1024u : (*bht_mask + 1u) * 2u;
+  size_t bytes = (size_t) new_cap * sizeof (uint32_t);
+  uint32_t *tab = fswc_sys_mmap_anon (bytes);
+  if (tab == NULL)
+    return false;
+  memset (tab, 0xff, bytes); /* Fill with FSWC_NONE */
+  uint32_t mask = new_cap - 1u;
+  for (uint32_t i = 0; i < num_ents; ++i)
+    {
+      uint32_t slot = (uint32_t) ents[i].hash & mask;
+      while (tab[slot] != FSWC_NONE)
+        slot = (slot + 1u) & mask;
+      tab[slot] = i;
+    }
+  if (bht_ar->base != NULL)
+    fswc_sys_munmap (bht_ar->base, bht_ar->cap);
+  bht_ar->base = (uint8_t *) tab;
+  bht_ar->used = bytes;
+  bht_ar->cap = bytes;
+  *bht_mask = mask;
+  return true;
+}
+
+static uint32_t
+fswc_bld_intern_str (struct fswc_arena *str_ar, struct fswc_arena *sht_ar,
+                     uint32_t *sht_mask, uint32_t *sht_cnt,
+                     const char *s, uint16_t len)
+{
+  uint64_t h = fswc_key_hash (0x535452u, s, len);
+  if (*sht_mask == 0 || ((uint64_t) (*sht_cnt + 1) * 10 >= (uint64_t) (*sht_mask + 1) * 7))
+    {
+      uint32_t ncap = *sht_mask == 0 ? 1024u : (*sht_mask + 1u) * 2u;
+      size_t bytes = (size_t) ncap * sizeof (uint32_t);
+      uint32_t *ntab = fswc_sys_mmap_anon (bytes);
+      if (ntab == NULL)
+        return FSWC_NONE;
+      memset (ntab, 0xff, bytes);
+      uint32_t nmask = ncap - 1u;
+      if (sht_ar->base != NULL)
+        {
+          const uint32_t *old = (const uint32_t *) sht_ar->base;
+          uint32_t ocap = *sht_mask + 1u;
+          for (uint32_t i = 0; i < ocap; ++i)
+            if (old[i] != FSWC_NONE)
+              {
+                const char *os = (const char *) str_ar->base + old[i];
+                uint64_t oh = fswc_key_hash (0x535452u, os, strlen (os));
+                uint32_t sl = (uint32_t) oh & nmask;
+                while (ntab[sl] != FSWC_NONE)
+                  sl = (sl + 1u) & nmask;
+                ntab[sl] = old[i];
+              }
+          fswc_sys_munmap (sht_ar->base, sht_ar->cap);
+        }
+      sht_ar->base = (uint8_t *) ntab;
+      sht_ar->used = bytes;
+      sht_ar->cap = bytes;
+      *sht_mask = nmask;
+    }
+
+  uint32_t *tab = (uint32_t *) sht_ar->base;
+  uint32_t slot = (uint32_t) h & *sht_mask;
+  while (tab[slot] != FSWC_NONE)
+    {
+      const char *es = (const char *) str_ar->base + tab[slot];
+      if (memcmp (es, s, len) == 0 && es[len] == '\0')
+        return tab[slot];
+      slot = (slot + 1u) & *sht_mask;
+    }
+
+  char *dst = fswc_arena_alloc (str_ar, (size_t) len + 1, 1);
+  if (dst == NULL)
+    return FSWC_NONE;
+  uint32_t off = (uint32_t) ((uint8_t *) dst - str_ar->base);
+  memcpy (dst, s, len);
+  dst[len] = '\0';
+  tab[slot] = off;
+  ++(*sht_cnt);
+  return off;
+}
+
+static uint32_t
+fswc_bld_get_or_add_ent (struct fswc_arena *ents_ar, struct fswc_arena *bht_ar,
+                         uint32_t *bht_mask, struct fswc_arena *str_ar,
+                         struct fswc_arena *sht_ar, uint32_t *sht_mask,
+                         uint32_t *sht_cnt, struct fswc_arena *vdirs_ar,
+                         uint32_t parent_vdir_id, const char *name,
+                         uint16_t name_len)
+{
+  uint32_t num_ents = (uint32_t) (ents_ar->used / sizeof (struct fswc_bld_ent));
+  if (*bht_mask == 0
+      || (uint64_t) (num_ents + 1) * 10 >= (uint64_t) (*bht_mask + 1) * 7)
+    {
+      if (!fswc_bld_ht_grow (bht_ar, bht_mask,
+                             (const struct fswc_bld_ent *) ents_ar->base,
+                             num_ents))
+        return FSWC_NONE;
+    }
+
+  uint64_t h = fswc_key_hash (parent_vdir_id, name, name_len);
+  uint32_t *bht = (uint32_t *) bht_ar->base;
+  uint32_t slot = (uint32_t) h & *bht_mask;
+  while (bht[slot] != FSWC_NONE)
+    {
+      uint32_t idx = bht[slot];
+      const struct fswc_bld_ent *e
+        = &((const struct fswc_bld_ent *) ents_ar->base)[idx];
+      if (e->hash == h
+          && e->parent_vdir_id == parent_vdir_id
+          && e->name_len == name_len
+          && memcmp ((const char *) str_ar->base + e->name_off, name,
+                     name_len) == 0)
+        return idx;
+      slot = (slot + 1u) & *bht_mask;
+    }
+
+  uint32_t noff = fswc_bld_intern_str (str_ar, sht_ar, sht_mask, sht_cnt,
+                                       name, name_len);
+  if (noff == FSWC_NONE)
+    return FSWC_NONE;
+
+  struct fswc_bld_ent *ne
+    = fswc_arena_alloc (ents_ar, sizeof (*ne), _Alignof (struct fswc_bld_ent));
+  if (ne == NULL)
+    return FSWC_NONE;
+
+  ne->hash = h;
+  ne->parent_vdir_id = parent_vdir_id;
+  ne->name_off = noff;
+  ne->name_len = name_len;
+  ne->flags = 0;
+  ne->child_vdir_id = FSWC_NONE;
+  ne->dir_cnt = 0;
+  ne->all_posts.head = FSWC_NONE;
+  ne->all_posts.tail = FSWC_NONE;
+  ne->all_posts.count = 0;
+  ne->final_ht_slot = FSWC_NONE;
+
+  if (parent_vdir_id != FSWC_VDIR_PKGS)
+    {
+      struct fswc_bld_vdir *vd
+        = &((struct fswc_bld_vdir *) vdirs_ar->base)[parent_vdir_id];
+      ne->next_child_in_vdir = vd->first_ent;
+      vd->first_ent = num_ents;
+      ++vd->children_count;
+    }
+  else
+    ne->next_child_in_vdir = FSWC_NONE;
+
+  bht[slot] = num_ents;
+  return num_ents;
+}
+
+static uint32_t
+fswc_bld_alloc_vdir (struct fswc_arena *vdirs_ar)
+{
+  uint32_t id = (uint32_t) (vdirs_ar->used / sizeof (struct fswc_bld_vdir));
+  struct fswc_bld_vdir *vd
+    = fswc_arena_alloc (vdirs_ar, sizeof (*vd), _Alignof (struct fswc_bld_vdir));
+  if (vd == NULL)
+    return FSWC_NONE;
+  vd->first_ent = FSWC_NONE;
+  vd->children_count = 0;
+  vd->flags = FSWC_VDIR_ALL_WORLD_SEARCH | FSWC_VDIR_ALL_WORLD_RX;
+  vd->dir_posts.head = FSWC_NONE;
+  vd->dir_posts.tail = FSWC_NONE;
+  vd->dir_posts.count = 0;
+  return id;
+}
+
+static uint32_t
+fswc_serialize_postings (const struct fswc_bld_post_list *lst,
+                         const struct fswc_bld_post_node *nodes,
+                         struct fswc_arena *post_out_ar, bool *ok)
+{
+  if (lst->count == 0)
+    return 0;
+  if (lst->count == 1)
+    return nodes[lst->head].packed_word;
+
+  uint32_t start = (uint32_t) (post_out_ar->used / sizeof (uint32_t));
+  uint32_t *dst = fswc_arena_alloc (post_out_ar,
+                                    (size_t) lst->count * sizeof (uint32_t),
+                                    _Alignof (uint32_t));
+  if (dst == NULL)
+    {
+      *ok = false;
+      return 0;
+    }
+  uint32_t cur = lst->head;
+  for (uint16_t i = 0; i < lst->count; ++i)
+    {
+      dst[i] = nodes[cur].packed_word;
+      cur = nodes[cur].next_node;
+    }
+  return start;
+}
+
+/* Merge sort helper for vchildren[] sorted by strcmp(basename).  */
+static void
+fswc_sort_ent_indices_by_name (uint32_t *arr, uint32_t *tmp, size_t n,
+                               const struct fswc_bld_ent *ents,
+                               const char *strtab)
+{
+  for (size_t width = 1; width < n; width <<= 1)
+    {
+      for (size_t i = 0; i < n; i += 2 * width)
+        {
+          size_t mid = i + width < n ? i + width : n;
+          size_t end = i + 2 * width < n ? i + 2 * width : n;
+          size_t l = i, r = mid, k = i;
+          while (l < mid && r < end)
+            {
+              const char *sl = strtab + ents[arr[l]].name_off;
+              const char *sr = strtab + ents[arr[r]].name_off;
+              if (strcmp (sl, sr) <= 0)
+                tmp[k++] = arr[l++];
+              else
+                tmp[k++] = arr[r++];
+            }
+          while (l < mid)
+            tmp[k++] = arr[l++];
+          while (r < end)
+            tmp[k++] = arr[r++];
+        }
+      memcpy (arr, tmp, n * sizeof (uint32_t));
+    }
+}
+
+/* Assemble Merged Virtual Trie blob from sorted fswc_pkg_input[0..num_pkgs-1].  */
+static void *
+fswc_assemble_blob (const struct fswc_pkg_input *pkgs, uint32_t num_pkgs,
+                    uint64_t pkgset_lo, uint64_t pkgset_hi,
+                    size_t *out_blob_sz)
+{
+  *out_blob_sz = 0;
+
+  struct fswc_arena ents_ar, bht_ar, str_ar, sht_ar, vdirs_ar, pnodes_ar;
+  struct fswc_arena map_ar, post_out_ar, vchild_ar, pkgs_out_ar, sort_ar;
+  fswc_arena_init (&ents_ar);
+  fswc_arena_init (&bht_ar);
+  fswc_arena_init (&str_ar);
+  fswc_arena_init (&sht_ar);
+  fswc_arena_init (&vdirs_ar);
+  fswc_arena_init (&pnodes_ar);
+  fswc_arena_init (&map_ar);
+  fswc_arena_init (&post_out_ar);
+  fswc_arena_init (&vchild_ar);
+  fswc_arena_init (&pkgs_out_ar);
+  fswc_arena_init (&sort_ar);
+
+  uint32_t bht_mask = 0;
+  uint32_t sht_mask = 0;
+  uint32_t sht_cnt = 0;
+  void *final_blob = NULL;
+
+  /* Put "" at strtab[0].  */
+  if (fswc_bld_intern_str (&str_ar, &sht_ar, &sht_mask, &sht_cnt, "", 0) == FSWC_NONE)
+    goto cleanup;
+
+  /* Allocate vdir 0 = FSWC_VDIR_ROOT.  */
+  if (fswc_bld_alloc_vdir (&vdirs_ar) != FSWC_VDIR_ROOT)
+    goto cleanup;
+
+  struct fswc_pkg *out_pkgs
+    = fswc_arena_alloc (&pkgs_out_ar, (size_t) num_pkgs * sizeof (struct fswc_pkg),
+                        _Alignof (struct fswc_pkg));
+  if (out_pkgs == NULL)
+    goto cleanup;
+
+  uint32_t global_flags = FSWC_GF_ALL_WORLD_SEARCH | FSWC_GF_ALL_WORLD_RX;
+
+  for (uint32_t p = 0; p < num_pkgs; ++p)
+    {
+      const struct fswc_pkg_cache_hdr *ph = pkgs[p].pcache;
+      const struct fswc_pkg_cache_dir *pdirs
+        = (const struct fswc_pkg_cache_dir *) ((const uint8_t *) ph + ph->dirs_off);
+      const struct fswc_pkg_cache_ent *pents
+        = (const struct fswc_pkg_cache_ent *) ((const uint8_t *) ph + ph->entries_off);
+      const char *pstr = (const char *) ph + ph->strtab_off;
+
+      uint32_t pnoff = fswc_bld_intern_str (&str_ar, &sht_ar, &sht_mask,
+                                            &sht_cnt, pkgs[p].name,
+                                            pkgs[p].name_len);
+      if (pnoff == FSWC_NONE)
+        goto cleanup;
+
+      out_pkgs[p].name_off = pnoff;
+      out_pkgs[p].name_len = pkgs[p].name_len;
+      out_pkgs[p].flags = (uint16_t) ph->pkg_flags;
+      if (!(ph->pkg_flags & FSWC_PKG_ALL_WORLD_SEARCH))
+        global_flags &= ~FSWC_GF_ALL_WORLD_SEARCH;
+      if (!(ph->pkg_flags & FSWC_PKG_ALL_WORLD_RX))
+        global_flags &= ~FSWC_GF_ALL_WORLD_RX;
+
+      /* Insert (FSWC_VDIR_PKGS, pkg_name) for O(1) <pkg> lookup! */
+      uint32_t pk_eidx
+        = fswc_bld_get_or_add_ent (&ents_ar, &bht_ar, &bht_mask,
+                                   &str_ar, &sht_ar, &sht_mask, &sht_cnt,
+                                   &vdirs_ar, FSWC_VDIR_PKGS,
+                                   pkgs[p].name, pkgs[p].name_len);
+      if (pk_eidx == FSWC_NONE)
+        goto cleanup;
+      {
+        struct fswc_bld_ent *pke
+          = &((struct fswc_bld_ent *) ents_ar.base)[pk_eidx];
+        pke->flags |= FSWC_ENT_HAS_DIR;
+        pke->child_vdir_id = FSWC_VDIR_ROOT;
+        pke->dir_cnt = 1;
+        if (!fswc_bld_post_append (&pnodes_ar, &pke->all_posts,
+                                   FSWC_POSTING_PACK (p, DT_DIR)))
+          goto cleanup;
+      }
+
+      map_ar.used = 0;
+      uint32_t *dir_to_vdir
+        = fswc_arena_alloc (&map_ar, (size_t) ph->num_dirs * sizeof (uint32_t),
+                            _Alignof (uint32_t));
+      if (dir_to_vdir == NULL)
+        goto cleanup;
+      memset (dir_to_vdir, 0xff, (size_t) ph->num_dirs * sizeof (uint32_t));
+      dir_to_vdir[0] = FSWC_VDIR_ROOT;
+
+      for (uint32_t d = 0; d < ph->num_dirs; ++d)
+        {
+          uint32_t vdir_id = dir_to_vdir[d];
+          if (vdir_id == FSWC_NONE
+              || vdir_id >= (uint32_t) (vdirs_ar.used
+                                        / sizeof (struct fswc_bld_vdir)))
+            goto cleanup;
+          const struct fswc_pkg_cache_dir *pd = &pdirs[d];
+          if ((uint64_t) pd->entries_start + pd->entries_count > ph->num_entries)
+            goto cleanup;
+
+          struct fswc_bld_vdir *vd
+            = &((struct fswc_bld_vdir *) vdirs_ar.base)[vdir_id];
+          if (!(pd->dir_flags & FSWC_DIR_WORLD_SEARCH))
+            vd->flags &= ~FSWC_VDIR_ALL_WORLD_SEARCH;
+          if (!(pd->dir_flags & FSWC_DIR_WORLD_RX))
+            vd->flags &= ~FSWC_VDIR_ALL_WORLD_RX;
+          if (!fswc_bld_post_append (&pnodes_ar, &vd->dir_posts,
+                                     FSWC_POSTING_PACK (p, DT_DIR)))
+            goto cleanup;
+
+          for (uint32_t k = 0; k < pd->entries_count; ++k)
+            {
+              const struct fswc_pkg_cache_ent *pe
+                = &pents[pd->entries_start + k];
+              if (!fswc_valid_str_ent (pstr, ph->strtab_size,
+                                       pe->name_off, pe->name_len))
+                goto cleanup;
+              const char *ename = pstr + pe->name_off;
+
+              uint32_t eidx
+                = fswc_bld_get_or_add_ent (&ents_ar, &bht_ar, &bht_mask,
+                                           &str_ar, &sht_ar, &sht_mask,
+                                           &sht_cnt, &vdirs_ar, vdir_id,
+                                           ename, pe->name_len);
+              if (eidx == FSWC_NONE)
+                goto cleanup;
+
+              struct fswc_bld_ent *be
+                = &((struct fswc_bld_ent *) ents_ar.base)[eidx];
+              if (!fswc_bld_post_append (&pnodes_ar, &be->all_posts,
+                                         FSWC_POSTING_PACK (p, pe->d_type)))
+                goto cleanup;
+
+              if (pe->d_type == DT_LNK)
+                {
+                  be->flags |= FSWC_ENT_HAS_LNK;
+                  ++be->dir_cnt;
+                }
+              else if (pe->d_type == DT_DIR)
+                {
+                  be->flags |= FSWC_ENT_HAS_DIR;
+                  ++be->dir_cnt;
+                  if (!(pe->child_dir_flags & FSWC_DIR_WORLD_SEARCH))
+                    be->flags |= FSWC_ENT_RESTRICTED_SEARCH;
+                  if (!(pe->child_dir_flags & FSWC_DIR_WORLD_RX))
+                    be->flags |= FSWC_ENT_RESTRICTED_RX;
+
+                  if (be->child_vdir_id == FSWC_NONE)
+                    {
+                      uint32_t nv = fswc_bld_alloc_vdir (&vdirs_ar);
+                      if (nv == FSWC_NONE)
+                        goto cleanup;
+                      be = &((struct fswc_bld_ent *) ents_ar.base)[eidx];
+                      be->child_vdir_id = nv;
+                    }
+
+                  if (pe->child_dir_idx != FSWC_NONE)
+                    {
+                      if (pe->child_dir_idx >= ph->num_dirs
+                          || pe->child_dir_idx <= d
+                          || dir_to_vdir[pe->child_dir_idx] != FSWC_NONE)
+                        goto cleanup;
+                      dir_to_vdir[pe->child_dir_idx] = be->child_vdir_id;
+                    }
+                  else
+                    {
+                      /* Unreadable 0700 subdir: record restricted vdir.  */
+                      struct fswc_bld_vdir *cvd
+                        = &((struct fswc_bld_vdir *) vdirs_ar.base)[be->child_vdir_id];
+                      cvd->flags &= ~(FSWC_VDIR_ALL_WORLD_SEARCH
+                                      | FSWC_VDIR_ALL_WORLD_RX);
+                      if (!fswc_bld_post_append (&pnodes_ar, &cvd->dir_posts,
+                                                 FSWC_POSTING_PACK (p, DT_DIR)))
+                        goto cleanup;
+                    }
+                }
+            }
+        }
+    }
+
+  uint32_t num_ents = (uint32_t) (ents_ar.used / sizeof (struct fswc_bld_ent));
+  uint32_t num_vdirs = (uint32_t) (vdirs_ar.used / sizeof (struct fswc_bld_vdir));
+  struct fswc_bld_ent *ents = (struct fswc_bld_ent *) ents_ar.base;
+  struct fswc_bld_vdir *vdirs = (struct fswc_bld_vdir *) vdirs_ar.base;
+  const struct fswc_bld_post_node *pnodes
+    = (const struct fswc_bld_post_node *) pnodes_ar.base;
+
+  /* Size final open-addressed ht[] with load factor <= 0.65 (cap >= 16).  */
+  uint64_t ht_cap = 16;
+  while (ht_cap * 13 < (uint64_t) (num_ents + 1) * 20)
+    {
+      ht_cap <<= 1;
+      if (ht_cap > (1ULL << 26))
+        goto cleanup;
+    }
+  uint32_t ht_mask = (uint32_t) (ht_cap - 1ULL);
+  size_t ht_bytes = (size_t) ht_cap * sizeof (struct fswc_ht_entry);
+  struct fswc_ht_entry *final_ht = fswc_sys_mmap_anon (ht_bytes);
+  if (final_ht == NULL)
+    goto cleanup;
+
+  bool post_ok = true;
+  for (uint32_t i = 0; i < num_ents; ++i)
+    {
+      uint32_t slot = (uint32_t) ents[i].hash & ht_mask;
+      while (final_ht[slot].hash != 0)
+        slot = (slot + 1u) & ht_mask;
+      ents[i].final_ht_slot = slot;
+
+      struct fswc_ht_entry *fe = &final_ht[slot];
+      fe->hash = ents[i].hash;
+      fe->parent_vdir_id = ents[i].parent_vdir_id;
+      fe->name_off = ents[i].name_off;
+      fe->name_len = ents[i].name_len;
+      fe->flags = ents[i].flags;
+      fe->child_vdir_id = ents[i].child_vdir_id;
+      fe->all_ref = fswc_serialize_postings (&ents[i].all_posts, pnodes,
+                                             &post_out_ar, &post_ok);
+      fe->all_cnt = ents[i].all_posts.count;
+      fe->dir_cnt = ents[i].dir_cnt;
+      if (!post_ok)
+        {
+          fswc_sys_munmap (final_ht, ht_bytes);
+          goto cleanup;
+        }
+    }
+
+  /* Build struct fswc_vdir[] and strcmp-sorted vchildren[].  */
+  size_t vdirs_out_bytes = (size_t) num_vdirs * sizeof (struct fswc_vdir);
+  struct fswc_vdir *final_vdirs = fswc_sys_mmap_anon (vdirs_out_bytes);
+  if (final_vdirs == NULL)
+    {
+      fswc_sys_munmap (final_ht, ht_bytes);
+      goto cleanup;
+    }
+
+  for (uint32_t v = 0; v < num_vdirs; ++v)
+    {
+      uint32_t ccnt = vdirs[v].children_count;
+      uint32_t cstart
+        = (uint32_t) (vchild_ar.used / sizeof (struct fswc_vchild));
+      final_vdirs[v].children_start = cstart;
+      final_vdirs[v].children_count = ccnt;
+      final_vdirs[v].dir_postings_ref
+        = fswc_serialize_postings (&vdirs[v].dir_posts, pnodes,
+                                   &post_out_ar, &post_ok);
+      final_vdirs[v].dir_postings_cnt = vdirs[v].dir_posts.count;
+      final_vdirs[v].flags = vdirs[v].flags;
+      if (!post_ok)
+        {
+          fswc_sys_munmap (final_vdirs, vdirs_out_bytes);
+          fswc_sys_munmap (final_ht, ht_bytes);
+          goto cleanup;
+        }
+
+      if (ccnt > 0)
+        {
+          sort_ar.used = 0;
+          uint32_t *idx_arr
+            = fswc_arena_alloc (&sort_ar, (size_t) ccnt * 2 * sizeof (uint32_t),
+                                _Alignof (uint32_t));
+          struct fswc_vchild *vc_dst
+            = fswc_arena_alloc (&vchild_ar,
+                                (size_t) ccnt * sizeof (struct fswc_vchild),
+                                _Alignof (struct fswc_vchild));
+          if (idx_arr == NULL || vc_dst == NULL)
+            {
+              fswc_sys_munmap (final_vdirs, vdirs_out_bytes);
+              fswc_sys_munmap (final_ht, ht_bytes);
+              goto cleanup;
+            }
+          uint32_t cur = vdirs[v].first_ent;
+          for (uint32_t k = 0; k < ccnt; ++k)
+            {
+              idx_arr[k] = cur;
+              cur = ents[cur].next_child_in_vdir;
+            }
+          if (ccnt > 1)
+            fswc_sort_ent_indices_by_name (idx_arr, idx_arr + ccnt, ccnt,
+                                           ents, (const char *) str_ar.base);
+          for (uint32_t k = 0; k < ccnt; ++k)
+            vc_dst[k].ht_slot = ents[idx_arr[k]].final_ht_slot;
+        }
+    }
+
+  uint32_t num_postings = (uint32_t) (post_out_ar.used / sizeof (uint32_t));
+  uint32_t num_vchildren
+    = (uint32_t) (vchild_ar.used / sizeof (struct fswc_vchild));
+  uint32_t strtab_size = (uint32_t) str_ar.used;
+
+  uint64_t pkgs_off = fswc_align8 (sizeof (struct fswc_header));
+  uint64_t vdirs_off = fswc_align8 (pkgs_off + pkgs_out_ar.used);
+  uint64_t ht_off = fswc_align8 (vdirs_off + (uint64_t) num_vdirs * sizeof (struct fswc_vdir));
+  uint64_t postings_off = fswc_align8 (ht_off + ht_bytes);
+  uint64_t vchildren_off = fswc_align8 (postings_off + post_out_ar.used);
+  uint64_t strtab_off = fswc_align8 (vchildren_off + vchild_ar.used);
+  uint64_t total_size = fswc_align8 (strtab_off + str_ar.used);
+
+  if (total_size <= FSWC_BLOB_MAX_SIZE)
+    {
+      uint8_t *blob = fswc_sys_mmap_anon ((size_t) total_size);
+      if (blob != NULL)
+        {
+          struct fswc_header *hdr = (struct fswc_header *) blob;
+          hdr->magic = FSWC_BLOB_MAGIC;
+          hdr->version = FSWC_BLOB_VERSION;
+          hdr->total_size = total_size;
+          hdr->pkgset_hash_lo = pkgset_lo;
+          hdr->pkgset_hash_hi = pkgset_hi;
+          hdr->num_pkgs = num_pkgs;
+          hdr->num_vdirs = num_vdirs;
+          hdr->ht_mask = ht_mask;
+          hdr->num_postings = num_postings;
+          hdr->num_vchildren = num_vchildren;
+          hdr->strtab_size = strtab_size;
+          hdr->global_flags = global_flags;
+          hdr->pkgs_off = (uint32_t) pkgs_off;
+          hdr->vdirs_off = (uint32_t) vdirs_off;
+          hdr->ht_off = (uint32_t) ht_off;
+          hdr->postings_off = (uint32_t) postings_off;
+          hdr->vchildren_off = (uint32_t) vchildren_off;
+          hdr->strtab_off = (uint32_t) strtab_off;
+          hdr->reserved = 0;
+
+          memcpy (blob + pkgs_off, pkgs_out_ar.base, pkgs_out_ar.used);
+          memcpy (blob + vdirs_off, final_vdirs,
+                  (size_t) num_vdirs * sizeof (struct fswc_vdir));
+          memcpy (blob + ht_off, final_ht, ht_bytes);
+          if (post_out_ar.used > 0)
+            memcpy (blob + postings_off, post_out_ar.base, post_out_ar.used);
+          if (vchild_ar.used > 0)
+            memcpy (blob + vchildren_off, vchild_ar.base, vchild_ar.used);
+          memcpy (blob + strtab_off, str_ar.base, str_ar.used);
+
+          final_blob = blob;
+          *out_blob_sz = (size_t) total_size;
+        }
+    }
+
+  fswc_sys_munmap (final_vdirs, vdirs_out_bytes);
+  fswc_sys_munmap (final_ht, ht_bytes);
+
+cleanup:
+  fswc_arena_free (&ents_ar);
+  fswc_arena_free (&bht_ar);
+  fswc_arena_free (&str_ar);
+  fswc_arena_free (&sht_ar);
+  fswc_arena_free (&vdirs_ar);
+  fswc_arena_free (&pnodes_ar);
+  fswc_arena_free (&map_ar);
+  fswc_arena_free (&post_out_ar);
+  fswc_arena_free (&vchild_ar);
+  fswc_arena_free (&pkgs_out_ar);
+  fswc_arena_free (&sort_ar);
+  return final_blob;
+}
+
+/* Compute Tier-1 128b pkg_id from loop backing file (or mount tuple fallback).  */
+static void
+fswc_compute_pkg_id (const char *prefix, size_t prefix_len,
+                     const char *pkg_name,
+                     uint32_t sb_major, uint32_t sb_minor,
+                     const struct statx *pkg_stx,
+                     uint64_t *out_lo, uint64_t *out_hi,
+                     bool *out_persist_tier1)
+{
+  *out_persist_tier1 = false;
+
+  char sys_path[96];
+  memcpy (sys_path, "/sys/dev/block/", 15);
+  char *p = sys_path + 15;
+  p = fswc_fmt_u64_dec (p, sb_major);
+  *p++ = ':';
+  p = fswc_fmt_u64_dec (p, sb_minor);
+  memcpy (p, "/loop/backing_file", 19);
+
+  long lfd = INTERNAL_SYSCALL_CALL (openat, AT_FDCWD, sys_path,
+                                    O_RDONLY | O_CLOEXEC, 0);
+  if (!INTERNAL_SYSCALL_ERROR_P (lfd))
+    {
+      char back_buf[PATH_MAX];
+      long nr = INTERNAL_SYSCALL_CALL (read, (int) lfd, back_buf,
+                                       sizeof (back_buf) - 1);
+      INTERNAL_SYSCALL_CALL (close, (int) lfd);
+      if (nr > 0)
+        {
+          while (nr > 0
+                 && (back_buf[nr - 1] == '\n' || back_buf[nr - 1] == '\r'))
+            --nr;
+          back_buf[nr] = '\0';
+
+          struct statx bstx;
+          long sr = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, back_buf, 0,
+                                           STATX_BASIC_STATS, &bstx);
+          if (INTERNAL_SYSCALL_ERROR_P (sr))
+            {
+              /* Fallback: <prefix>/<basename(backing_file)> for chroot builds. */
+              const char *base = back_buf;
+              for (long bi = nr; bi > 0; --bi)
+                if (back_buf[bi - 1] == '/')
+                  {
+                    base = back_buf + bi;
+                    break;
+                  }
+              size_t blen = (size_t) ((back_buf + nr) - base);
+              if (blen > 0 && prefix_len + 1 + blen < PATH_MAX)
+                {
+                  char alt[PATH_MAX];
+                  memcpy (alt, prefix, prefix_len);
+                  alt[prefix_len] = '/';
+                  memcpy (alt + prefix_len + 1, base, blen + 1);
+                  sr = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, alt, 0,
+                                              STATX_BASIC_STATS, &bstx);
+                }
+            }
+
+          if (!INTERNAL_SYSCALL_ERROR_P (sr) && S_ISREG (bstx.stx_mode))
+            {
+              uint64_t tuple[7] =
+                {
+                  fswc_pack_dev (bstx.stx_dev_major, bstx.stx_dev_minor),
+                  bstx.stx_ino,
+                  bstx.stx_size,
+                  (uint64_t) bstx.stx_ctime.tv_sec,
+                  (uint64_t) bstx.stx_ctime.tv_nsec,
+                  (uint64_t) bstx.stx_mtime.tv_sec,
+                  (uint64_t) bstx.stx_mtime.tv_nsec
+                };
+              uint64_t lo = FSWC_HASH_INIT_LO ^ 0x5449455231ULL;
+              uint64_t hi = FSWC_HASH_INIT_HI;
+              fswc_hash128_update (&lo, &hi, tuple, sizeof (tuple));
+              *out_lo = lo;
+              *out_hi = hi;
+              *out_persist_tier1 = true;
+              return;
+            }
+        }
+    }
+
+  (void) pkg_name;
+  uint64_t fallback[5] =
+    {
+      pkg_stx->stx_mnt_id,
+      fswc_pack_dev (sb_major, sb_minor),
+      pkg_stx->stx_ino,
+      (uint64_t) pkg_stx->stx_mtime.tv_sec,
+      (uint64_t) pkg_stx->stx_mtime.tv_nsec
+    };
+  uint64_t lo = FSWC_HASH_INIT_LO ^ 0x46414c4c42ULL;
+  uint64_t hi = FSWC_HASH_INIT_HI;
+  fswc_hash128_update (&lo, &hi, fallback, sizeof (fallback));
+  *out_lo = lo;
+  *out_hi = hi;
+}
+
+/* Cold/warm snapshot builder called under GL(dl_fswc_state).lock.  */
+struct fswc_mnt_rec
+{
+  uint64_t mnt_id;
+  uint32_t sb_major;
+  uint32_t sb_minor;
+  uint64_t sb_magic;
+  uint32_t name_off;
+  uint16_t name_len;
+  bool is_descendant; /* Mount under <prefix>/<pkg>/<subpath> */
+};
+
+struct fswc_cand_pkg
+{
+  uint32_t name_off;
+  uint16_t name_len;
+  uint32_t sb_major;
+  uint32_t sb_minor;
+  uint64_t pkg_id_lo;
+  uint64_t pkg_id_hi;
+  bool persist_tier1;
+  int dfd;
+};
+
+static void
+fswc_sort_top_entries (struct fswc_top_entry *arr, size_t n, const char *strtab)
+{
+  for (size_t i = 1; i < n; ++i)
+    {
+      struct fswc_top_entry cur = arr[i];
+      const char *cs = strtab + cur.name_off;
+      size_t j = i;
+      while (j > 0 && strcmp (strtab + arr[j - 1].name_off, cs) > 0)
+        {
+          arr[j] = arr[j - 1];
+          --j;
+        }
+      arr[j] = cur;
+    }
+}
+
+static void
+fswc_sort_cand_pkgs (struct fswc_cand_pkg *arr, size_t n, const char *strtab)
+{
+  for (size_t i = 1; i < n; ++i)
+    {
+      struct fswc_cand_pkg cur = arr[i];
+      const char *cs = strtab + cur.name_off;
+      size_t j = i;
+      while (j > 0 && strcmp (strtab + arr[j - 1].name_off, cs) > 0)
+        {
+          arr[j] = arr[j - 1];
+          --j;
+        }
+      arr[j] = cur;
+    }
+}
+
+static struct fswc_slot_snap *
+fswc_build_or_load_snap_locked (const char *prefix, size_t prefix_len)
+{
+#if !defined __NR_listmount || !defined __NR_statmount
+  GL (dl_fswc_state).mode = 0;
+  return NULL;
+#else
+  uint32_t euid = (uint32_t) INTERNAL_SYSCALL_CALL (geteuid);
+  uint32_t ruid = (uint32_t) INTERNAL_SYSCALL_CALL (getuid);
+  if (__libc_enable_secure && !(euid == 0 && ruid == 0))
+    return NULL;
+
+  uint32_t start_gen = atomic_load_acquire (&GL (dl_fswc_state).inval_gen);
+  uint32_t build_ms = fswc_now_coarse_ms ();
+
+  /* 1. Validate all ancestors "/" .. prefix (no symlinks).  */
+  struct fswc_ancestor_id ancs[FSWC_MAX_ANCESTORS];
+  uint32_t nanc = 0;
+  bool all_anc_world_search = true;
+  char anc_buf[PATH_MAX];
+
+  size_t pos = 0;
+  while (pos < prefix_len)
+    {
+      uint16_t plen;
+      if (pos == 0)
+        {
+          plen = 1;
+          pos = 1;
+        }
+      else
+        {
+          const char *slash = memchr (prefix + pos, '/', prefix_len - pos);
+          plen = slash != NULL
+                 ? (uint16_t) (slash - prefix) : (uint16_t) prefix_len;
+          pos = slash != NULL ? (size_t) (slash - prefix) + 1 : prefix_len;
+        }
+      if (nanc >= FSWC_MAX_ANCESTORS)
+        return NULL;
+
+      memcpy (anc_buf, prefix, plen);
+      anc_buf[plen] = '\0';
+
+      struct statx stx;
+      long sr = INTERNAL_SYSCALL_CALL (statx, AT_FDCWD, anc_buf,
+                                       AT_SYMLINK_NOFOLLOW,
+                                       STATX_BASIC_STATS | STATX_MNT_ID_UNIQUE,
+                                       &stx);
+      if (sr == -ENOSYS)
+        {
+          GL (dl_fswc_state).mode = 0;
+          return NULL;
+        }
+      if (INTERNAL_SYSCALL_ERROR_P (sr))
+        return NULL;
+      if (!(stx.stx_mask & STATX_MNT_ID_UNIQUE))
+        {
+          GL (dl_fswc_state).mode = 0;
+          return NULL;
+        }
+      if (!S_ISDIR (stx.stx_mode))
+        return NULL;
+
+      if ((stx.stx_mode & 0111) != 0111 || !fswc_path_no_posix_acl (anc_buf))
+        all_anc_world_search = false;
+
+      ancs[nanc].mnt_id = stx.stx_mnt_id;
+      ancs[nanc].dev = fswc_pack_dev (stx.stx_dev_major, stx.stx_dev_minor);
+      ancs[nanc].ino = stx.stx_ino;
+      ancs[nanc].ctime_sec = stx.stx_ctime.tv_sec;
+      ancs[nanc].ctime_nsec = stx.stx_ctime.tv_nsec;
+      ancs[nanc].path_len = plen;
+      ancs[nanc].pad = 0;
+      ++nanc;
+    }
+
+  long prefix_fd = INTERNAL_SYSCALL_CALL (openat, AT_FDCWD, prefix,
+                                          O_RDONLY | O_DIRECTORY | O_NOFOLLOW
+                                          | O_CLOEXEC, 0);
+  if (INTERNAL_SYSCALL_ERROR_P (prefix_fd))
+    return NULL;
+
+  struct statx pstx;
+  if (INTERNAL_SYSCALL_CALL (statx, (int) prefix_fd, "", AT_EMPTY_PATH,
+                             STATX_BASIC_STATS | STATX_MNT_ID_UNIQUE,
+                             &pstx) != 0
+      || !S_ISDIR (pstx.stx_mode)
+      || pstx.stx_mnt_id != ancs[nanc - 1].mnt_id
+      || pstx.stx_ino != ancs[nanc - 1].ino
+      || pstx.stx_ctime.tv_sec != ancs[nanc - 1].ctime_sec
+      || pstx.stx_ctime.tv_nsec != ancs[nanc - 1].ctime_nsec)
+    {
+      INTERNAL_SYSCALL_CALL (close, (int) prefix_fd);
+      return NULL;
+    }
+
+  uint32_t snap_flags = 0;
+  if (all_anc_world_search)
+    snap_flags |= FSWC_SNAP_ANCESTORS_WORLD_SEARCH;
+  if ((pstx.stx_mode & 0555) == 0555 && fswc_fd_no_posix_acl ((int) prefix_fd))
+    snap_flags |= FSWC_SNAP_PREFIX_WORLD_RX;
+
+  /* 2. Collect paginated listmount(LSMT_ROOT) + statmount mount-tree hash.  */
+  struct fswc_arena mnt_ids_ar;
+  fswc_arena_init (&mnt_ids_ar);
+  uint64_t mnt_hash_lo = 0;
+  uint64_t mnt_hash_hi = 0;
+  {
+    int hm_rc = fswc_hash_mount_tree (&mnt_hash_lo, &mnt_hash_hi, &mnt_ids_ar);
+    if (hm_rc != 0)
+      {
+        if (hm_rc == -ENOSYS)
+          GL (dl_fswc_state).mode = 0;
+        fswc_arena_free (&mnt_ids_ar);
+        INTERNAL_SYSCALL_CALL (close, (int) prefix_fd);
+        return NULL;
+      }
+  }
+
+  int shm_dfd = fswc_open_shm_dir (euid);
+  char ns_name[64];
+  fswc_format_ns_name (ns_name, pstx.stx_mnt_id, pstx.stx_ino);
+
+  /* 3. Fast path: check existing ns_<mnt_id>_<ino> in /dev/shm/.fswc-<euid>.  */
+  if (shm_dfd >= 0)
+    {
+      void *ns_map = NULL;
+      size_t ns_sz = 0;
+      if (fswc_open_map_shm_ro (shm_dfd, ns_name, &ns_map, &ns_sz))
+        {
+          const struct fswc_ns_header *nh = (const struct fswc_ns_header *) ns_map;
+          bool ns_ok = false;
+          if (ns_sz >= sizeof (*nh)
+              && ns_sz <= (16u << 20)
+              && nh->magic == FSWC_NS_MAGIC
+              && nh->version == FSWC_NS_VERSION
+              && nh->total_size == (uint64_t) ns_sz
+              && nh->prefix_mnt_id == pstx.stx_mnt_id
+              && nh->prefix_dev == ancs[nanc - 1].dev
+              && nh->prefix_ino == pstx.stx_ino
+              && nh->prefix_ctime_sec == pstx.stx_ctime.tv_sec
+              && nh->prefix_ctime_nsec == pstx.stx_ctime.tv_nsec
+              && nh->prefix_mtime_sec == pstx.stx_mtime.tv_sec
+              && nh->prefix_mtime_nsec == pstx.stx_mtime.tv_nsec
+              && nh->mnt_list_hash_lo == mnt_hash_lo
+              && nh->mnt_list_hash_hi == mnt_hash_hi
+              && fswc_check_section (nh->total_size, nh->mutable_off,
+                                     nh->num_mutable_dirs,
+                                     sizeof (struct fswc_top_entry))
+              && fswc_check_section (nh->total_size, nh->top_files_off,
+                                     nh->num_top_files,
+                                     sizeof (struct fswc_top_entry))
+              && fswc_check_section (nh->total_size, nh->strtab_off,
+                                     nh->strtab_size, 1)
+              && nh->strtab_size >= 1
+              && ((const char *) ns_map + nh->strtab_off)[nh->strtab_size - 1] == '\0')
+            {
+              const char *ns_str = (const char *) ns_map + nh->strtab_off;
+              const struct fswc_top_entry *ns_mut
+                = (const struct fswc_top_entry *) ((const uint8_t *) ns_map
+                                                   + nh->mutable_off);
+              const struct fswc_top_entry *ns_top
+                = (const struct fswc_top_entry *) ((const uint8_t *) ns_map
+                                                   + nh->top_files_off);
+              ns_ok = true;
+              for (uint32_t i = 0; i < nh->num_mutable_dirs; ++i)
+                if (!fswc_valid_str_ent (ns_str, nh->strtab_size,
+                                         ns_mut[i].name_off,
+                                         ns_mut[i].name_len))
+                  {
+                    ns_ok = false;
+                    break;
+                  }
+              for (uint32_t i = 0; ns_ok && i < nh->num_top_files; ++i)
+                if (!fswc_valid_str_ent (ns_str, nh->strtab_size,
+                                         ns_top[i].name_off,
+                                         ns_top[i].name_len))
+                  {
+                    ns_ok = false;
+                    break;
+                  }
+            }
+          if (ns_ok)
+            {
+              if (nh->flags & FSWC_SNAP_NO_SQUASHFS)
+                {
+                  struct fswc_slot_snap *snap
+                    = fswc_perm_alloc_locked (sizeof (*snap), _Alignof (struct fswc_slot_snap));
+                  fswc_sys_munmap (ns_map, ns_sz);
+                  fswc_arena_free (&mnt_ids_ar);
+                  INTERNAL_SYSCALL_CALL (close, shm_dfd);
+                  INTERNAL_SYSCALL_CALL (close, (int) prefix_fd);
+                  if (snap == NULL)
+                    return NULL;
+                  memset (snap, 0, sizeof (*snap));
+                  snap->last_check_ms = build_ms;
+                  snap->checked_inval_gen = start_gen;
+                  snap->snap_flags = snap_flags | FSWC_SNAP_NO_SQUASHFS;
+                  snap->snap_euid = euid;
+                  snap->snap_ruid = ruid;
+                  snap->num_ancestors = nanc;
+                  memcpy (snap->ancestors, ancs, nanc * sizeof (ancs[0]));
+                  snap->prefix_mnt_id = pstx.stx_mnt_id;
+                  snap->prefix_dev = ancs[nanc - 1].dev;
+                  snap->prefix_ino = pstx.stx_ino;
+                  snap->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+                  snap->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+                  snap->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+                  snap->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+                  snap->mnt_list_hash_lo = mnt_hash_lo;
+                  snap->mnt_list_hash_hi = mnt_hash_hi;
+                  return snap;
+                }
+
+              char blob_name[64];
+              fswc_format_blob_name (blob_name, nh->pkgset_hash_lo,
+                                     nh->pkgset_hash_hi);
+              void *blob_map = NULL;
+              size_t blob_sz = 0;
+              struct fswc_view view;
+              if (fswc_open_map_shm_ro (shm_dfd, blob_name, &blob_map, &blob_sz))
+                {
+                  if (fswc_validate_blob (blob_map, blob_sz, &view)
+                      && view.hdr->pkgset_hash_lo == nh->pkgset_hash_lo
+                      && view.hdr->pkgset_hash_hi == nh->pkgset_hash_hi)
+                    {
+                      uint32_t nh_num_mut = nh->num_mutable_dirs;
+                      uint32_t nh_num_top = nh->num_top_files;
+                      size_t mut_bytes = (size_t) nh_num_mut * sizeof (struct fswc_top_entry);
+                      size_t top_bytes = (size_t) nh_num_top * sizeof (struct fswc_top_entry);
+                      struct fswc_slot_snap *snap
+                        = fswc_perm_alloc_locked (sizeof (*snap), _Alignof (struct fswc_slot_snap));
+                      struct fswc_top_entry *mut_cp
+                        = mut_bytes > 0
+                          ? fswc_perm_alloc_locked (mut_bytes, _Alignof (struct fswc_top_entry))
+                          : NULL;
+                      struct fswc_top_entry *top_cp
+                        = top_bytes > 0
+                          ? fswc_perm_alloc_locked (top_bytes, _Alignof (struct fswc_top_entry))
+                          : NULL;
+                      char *str_cp
+                        = fswc_perm_alloc_locked (nh->strtab_size, 1);
+
+                      if (snap != NULL && str_cp != NULL
+                          && (mut_bytes == 0 || mut_cp != NULL)
+                          && (top_bytes == 0 || top_cp != NULL))
+                        {
+                          if (mut_bytes > 0)
+                            memcpy (mut_cp, (const uint8_t *) ns_map + nh->mutable_off, mut_bytes);
+                          if (top_bytes > 0)
+                            memcpy (top_cp, (const uint8_t *) ns_map + nh->top_files_off, top_bytes);
+                          memcpy (str_cp, (const uint8_t *) ns_map + nh->strtab_off, nh->strtab_size);
+
+                          fswc_sys_munmap (ns_map, ns_sz);
+                          fswc_arena_free (&mnt_ids_ar);
+                          INTERNAL_SYSCALL_CALL (close, shm_dfd);
+                          INTERNAL_SYSCALL_CALL (close, (int) prefix_fd);
+
+                          memset (snap, 0, sizeof (*snap));
+                          snap->last_check_ms = build_ms;
+                          snap->checked_inval_gen = start_gen;
+                          snap->snap_flags = snap_flags;
+                          snap->snap_euid = euid;
+                          snap->snap_ruid = ruid;
+                          snap->num_ancestors = nanc;
+                          memcpy (snap->ancestors, ancs, nanc * sizeof (ancs[0]));
+                          snap->prefix_mnt_id = pstx.stx_mnt_id;
+                          snap->prefix_dev = ancs[nanc - 1].dev;
+                          snap->prefix_ino = pstx.stx_ino;
+                          snap->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+                          snap->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+                          snap->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+                          snap->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+                          snap->mnt_list_hash_lo = mnt_hash_lo;
+                          snap->mnt_list_hash_hi = mnt_hash_hi;
+                          snap->num_mutable_dirs = nh_num_mut;
+                          snap->num_top_files = nh_num_top;
+                          snap->mutable_dirs = mut_cp;
+                          snap->top_files = top_cp;
+                          snap->top_strtab = str_cp;
+                          snap->view = view;
+                          return snap;
+                        }
+                    }
+                  fswc_sys_munmap (blob_map, blob_sz);
+                }
+            }
+          fswc_sys_munmap (ns_map, ns_sz);
+        }
+    }
+
+  /* 4. Cold ns_* build: inspect mounts under <prefix>/ via statmount.  */
+  struct fswc_arena mrecs_ar, mstr_ar, cands_ar, mut_ar, top_ar, tstr_ar, pmaps_ar;
+  fswc_arena_init (&mrecs_ar);
+  fswc_arena_init (&mstr_ar);
+  fswc_arena_init (&cands_ar);
+  fswc_arena_init (&mut_ar);
+  fswc_arena_init (&top_ar);
+  fswc_arena_init (&tstr_ar);
+  fswc_arena_init (&pmaps_ar);
+
+  struct fswc_slot_snap *ret_snap = NULL;
+  size_t num_mnt_ids = mnt_ids_ar.used / sizeof (uint64_t);
+  const uint64_t *mnt_ids = (const uint64_t *) mnt_ids_ar.base;
+
+  _Alignas (struct fswc_statmount)
+    uint8_t sm_raw[sizeof (struct fswc_statmount) + PATH_MAX + 128];
+  uint8_t *sm_cold_dyn = NULL;
+  size_t sm_cold_dyn_sz = 0;
+  bool any_squashfs_child = false;
+
+  for (size_t i = 0; i < num_mnt_ids; ++i)
+    {
+      struct fswc_mnt_id_req sreq =
+        {
+          .size = FSWC_MNT_ID_REQ_SIZE,
+          .spare = 0,
+          .mnt_id = mnt_ids[i],
+          .param = FSWC_STATMOUNT_SB_BASIC | FSWC_STATMOUNT_MNT_BASIC
+                   | FSWC_STATMOUNT_MNT_POINT
+        };
+      uint8_t *sm_buf = sm_cold_dyn != NULL ? sm_cold_dyn : sm_raw;
+      size_t sm_cap = sm_cold_dyn != NULL ? sm_cold_dyn_sz : sizeof (sm_raw);
+      long sr = INTERNAL_SYSCALL_CALL (statmount, &sreq, sm_buf, sm_cap, 0);
+      while (sr == -EOVERFLOW)
+        {
+          size_t next_sz = sm_cold_dyn_sz == 0 ? 65536u : (sm_cold_dyn_sz * 2u);
+          if (next_sz > 262144u)
+            goto out_cold;
+          uint8_t *nb = fswc_sys_mmap_anon (next_sz);
+          if (nb == NULL)
+            goto out_cold;
+          fswc_sys_munmap (sm_cold_dyn, sm_cold_dyn_sz);
+          sm_cold_dyn = nb;
+          sm_cold_dyn_sz = next_sz;
+          sm_buf = sm_cold_dyn;
+          sm_cap = sm_cold_dyn_sz;
+          sr = INTERNAL_SYSCALL_CALL (statmount, &sreq, sm_buf, sm_cap, 0);
+        }
+      if (sr == -ENOSYS)
+        {
+          GL (dl_fswc_state).mode = 0;
+          goto out_cold;
+        }
+      if (INTERNAL_SYSCALL_ERROR_P (sr))
+        continue;
+
+      const struct fswc_statmount *sm = (const struct fswc_statmount *) sm_buf;
+      if (!(sm->mask & FSWC_STATMOUNT_MNT_POINT))
+        continue;
+      size_t valid_sz = sm->size <= sm_cap ? sm->size : sm_cap;
+      size_t str_cap = valid_sz > offsetof (struct fswc_statmount, str)
+                       ? valid_sz - offsetof (struct fswc_statmount, str) : 0;
+      if (sm->mnt_point >= str_cap)
+        continue;
+
+      const char *mp = sm->str + sm->mnt_point;
+      if (memchr (mp, '\0', str_cap - sm->mnt_point) == NULL)
+        continue;
+      if (strncmp (mp, prefix, prefix_len) != 0
+          || mp[prefix_len] != '/'
+          || mp[prefix_len + 1] == '\0')
+        continue;
+
+      const char *rel = mp + prefix_len + 1;
+      const char *slash = strchr (rel, '/');
+      size_t pkg_len = slash != NULL ? (size_t) (slash - rel) : strlen (rel);
+      if (pkg_len == 0 || pkg_len > NAME_MAX)
+        continue;
+
+      char *ns = fswc_arena_alloc (&mstr_ar, pkg_len + 1, 1);
+      struct fswc_mnt_rec *mr
+        = fswc_arena_alloc (&mrecs_ar, sizeof (*mr), _Alignof (struct fswc_mnt_rec));
+      if (ns == NULL || mr == NULL)
+        goto out_cold;
+      uint32_t noff = (uint32_t) ((uint8_t *) ns - mstr_ar.base);
+      memcpy (ns, rel, pkg_len);
+      ns[pkg_len] = '\0';
+
+      mr->mnt_id = mnt_ids[i];
+      mr->sb_major = sm->sb_dev_major;
+      mr->sb_minor = sm->sb_dev_minor;
+      mr->sb_magic = sm->sb_magic;
+      mr->name_off = noff;
+      mr->name_len = (uint16_t) pkg_len;
+      mr->is_descendant = (slash != NULL);
+      if (!mr->is_descendant && sm->sb_magic == SQUASHFS_MAGIC)
+        any_squashfs_child = true;
+    }
+
+  /* 5. Zero SquashFS mounts under <prefix>/: record NO_SQUASHFS_CHILDREN!  */
+  if (!any_squashfs_child)
+    {
+      if (shm_dfd >= 0)
+        {
+          uint8_t zbuf[sizeof (struct fswc_ns_header) + 8];
+          memset (zbuf, 0, sizeof (zbuf));
+          struct fswc_ns_header *nh = (struct fswc_ns_header *) zbuf;
+          nh->magic = FSWC_NS_MAGIC;
+          nh->version = FSWC_NS_VERSION;
+          nh->total_size = sizeof (zbuf);
+          nh->flags = FSWC_SNAP_NO_SQUASHFS;
+          nh->strtab_size = 1;
+          nh->prefix_mnt_id = pstx.stx_mnt_id;
+          nh->prefix_dev = ancs[nanc - 1].dev;
+          nh->prefix_ino = pstx.stx_ino;
+          nh->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+          nh->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+          nh->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+          nh->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+          nh->mnt_list_hash_lo = mnt_hash_lo;
+          nh->mnt_list_hash_hi = mnt_hash_hi;
+          nh->mutable_off = sizeof (struct fswc_ns_header);
+          nh->top_files_off = sizeof (struct fswc_ns_header);
+          nh->strtab_off = sizeof (struct fswc_ns_header);
+          fswc_shm_publish_atomic (shm_dfd, ns_name, zbuf, sizeof (zbuf));
+        }
+
+      struct fswc_slot_snap *snap
+        = fswc_perm_alloc_locked (sizeof (*snap), _Alignof (struct fswc_slot_snap));
+      if (snap != NULL)
+        {
+          memset (snap, 0, sizeof (*snap));
+          snap->last_check_ms = build_ms;
+          snap->checked_inval_gen = start_gen;
+          snap->snap_flags = snap_flags | FSWC_SNAP_NO_SQUASHFS;
+          snap->snap_euid = euid;
+          snap->snap_ruid = ruid;
+          snap->num_ancestors = nanc;
+          memcpy (snap->ancestors, ancs, nanc * sizeof (ancs[0]));
+          snap->prefix_mnt_id = pstx.stx_mnt_id;
+          snap->prefix_dev = ancs[nanc - 1].dev;
+          snap->prefix_ino = pstx.stx_ino;
+          snap->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+          snap->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+          snap->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+          snap->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+          snap->mnt_list_hash_lo = mnt_hash_lo;
+          snap->mnt_list_hash_hi = mnt_hash_hi;
+          ret_snap = snap;
+        }
+      goto out_cold;
+    }
+
+  /* 6. Scan <prefix> top-level entries and classify immutable SquashFS vs
+     mutable_dirs[] vs top_files[].  */
+  {
+    char *tz = fswc_arena_alloc (&tstr_ar, 1, 1);
+    if (tz == NULL)
+      goto out_cold;
+    *tz = '\0';
+
+    size_t nmrecs = mrecs_ar.used / sizeof (struct fswc_mnt_rec);
+    const struct fswc_mnt_rec *mrecs = (const struct fswc_mnt_rec *) mrecs_ar.base;
+    const char *mstr = (const char *) mstr_ar.base;
+
+    uint8_t dbuf[8192];
+    for (;;)
+      {
+        long nr = INTERNAL_SYSCALL_CALL (getdents64, (int) prefix_fd, dbuf,
+                                         sizeof (dbuf));
+        if (nr < 0)
+          goto out_cold;
+        if (nr == 0)
+          break;
+
+        for (long off = 0; off < nr; )
+          {
+            const struct dirent64 *de = (const struct dirent64 *) (dbuf + off);
+            off += de->d_reclen;
+            if (de->d_name[0] == '.'
+                && (de->d_name[1] == '\0'
+                    || (de->d_name[1] == '.' && de->d_name[2] == '\0')))
+              continue;
+
+            size_t nlen = strlen (de->d_name);
+            if (nlen == 0 || nlen > NAME_MAX)
+              goto out_cold;
+
+            uint8_t dt = de->d_type;
+            if (dt == DT_UNKNOWN)
+              {
+                struct statx estx;
+                if (INTERNAL_SYSCALL_CALL (statx, (int) prefix_fd, de->d_name,
+                                           AT_SYMLINK_NOFOLLOW, STATX_TYPE,
+                                           &estx) == 0)
+                  dt = IFTODT (estx.stx_mode);
+              }
+
+            char *ts = fswc_arena_alloc (&tstr_ar, nlen + 1, 1);
+            if (ts == NULL)
+              goto out_cold;
+            uint32_t tsoff = (uint32_t) ((uint8_t *) ts - tstr_ar.base);
+            memcpy (ts, de->d_name, nlen + 1);
+
+            bool is_immut_sqfs = false;
+            if (dt == DT_DIR)
+              {
+                bool has_desc = false;
+                for (size_t m = 0; m < nmrecs; ++m)
+                  if (mrecs[m].is_descendant
+                      && mrecs[m].name_len == nlen
+                      && memcmp (mstr + mrecs[m].name_off, de->d_name, nlen) == 0)
+                    {
+                      has_desc = true;
+                      break;
+                    }
+
+                if (!has_desc)
+                  {
+                    long pfd = INTERNAL_SYSCALL_CALL (openat, (int) prefix_fd,
+                                                      de->d_name,
+                                                      O_RDONLY | O_DIRECTORY
+                                                      | O_NOFOLLOW | O_CLOEXEC,
+                                                      0);
+                    if (!INTERNAL_SYSCALL_ERROR_P (pfd))
+                      {
+                        struct statx kstx;
+                        if (INTERNAL_SYSCALL_CALL (statx, (int) pfd, "",
+                                                   AT_EMPTY_PATH,
+                                                   STATX_BASIC_STATS
+                                                   | STATX_MNT_ID_UNIQUE,
+                                                   &kstx) == 0
+                            && (kstx.stx_mask & STATX_MNT_ID_UNIQUE)
+                            && kstx.stx_mnt_id != pstx.stx_mnt_id)
+                          {
+                            for (size_t m = 0; m < nmrecs; ++m)
+                              if (!mrecs[m].is_descendant
+                                  && mrecs[m].mnt_id == kstx.stx_mnt_id
+                                  && mrecs[m].sb_magic == SQUASHFS_MAGIC)
+                                {
+                                  struct fswc_cand_pkg *cp
+                                    = fswc_arena_alloc (&cands_ar, sizeof (*cp),
+                                                        _Alignof (struct fswc_cand_pkg));
+                                  if (cp == NULL)
+                                    {
+                                      INTERNAL_SYSCALL_CALL (close, (int) pfd);
+                                      goto out_cold;
+                                    }
+                                  cp->name_off = tsoff;
+                                  cp->name_len = (uint16_t) nlen;
+                                  cp->sb_major = mrecs[m].sb_major;
+                                  cp->sb_minor = mrecs[m].sb_minor;
+                                  cp->dfd = (int) pfd;
+                                  fswc_compute_pkg_id (prefix, prefix_len,
+                                                       de->d_name,
+                                                       cp->sb_major,
+                                                       cp->sb_minor,
+                                                       &kstx,
+                                                       &cp->pkg_id_lo,
+                                                       &cp->pkg_id_hi,
+                                                       &cp->persist_tier1);
+                                  is_immut_sqfs = true;
+                                  break;
+                                }
+                          }
+                        if (!is_immut_sqfs)
+                          INTERNAL_SYSCALL_CALL (close, (int) pfd);
+                      }
+                  }
+              }
+
+            if (!is_immut_sqfs)
+              {
+                struct fswc_arena *target_ar
+                  = (dt == DT_DIR || dt == DT_LNK || dt == DT_UNKNOWN)
+                    ? &mut_ar : &top_ar;
+                struct fswc_top_entry *te
+                  = fswc_arena_alloc (target_ar, sizeof (*te),
+                                      _Alignof (struct fswc_top_entry));
+                if (te == NULL)
+                  goto out_cold;
+                te->name_off = tsoff;
+                te->name_len = (uint16_t) nlen;
+                te->d_type = dt;
+                te->flags = 0;
+              }
+          }
+      }
+  }
+
+  size_t num_cands = cands_ar.used / sizeof (struct fswc_cand_pkg);
+  struct fswc_cand_pkg *cands = (struct fswc_cand_pkg *) cands_ar.base;
+  size_t num_mut = mut_ar.used / sizeof (struct fswc_top_entry);
+  struct fswc_top_entry *muts = (struct fswc_top_entry *) mut_ar.base;
+  size_t num_top = top_ar.used / sizeof (struct fswc_top_entry);
+  struct fswc_top_entry *tops = (struct fswc_top_entry *) top_ar.base;
+  const char *tstr = (const char *) tstr_ar.base;
+
+  if (num_cands == 0)
+    {
+      /* All SquashFS child mounts were overmounted or inaccessible!  */
+      struct fswc_slot_snap *snap
+        = fswc_perm_alloc_locked (sizeof (*snap), _Alignof (struct fswc_slot_snap));
+      if (snap != NULL)
+        {
+          memset (snap, 0, sizeof (*snap));
+          snap->last_check_ms = build_ms;
+          snap->checked_inval_gen = start_gen;
+          snap->snap_flags = snap_flags | FSWC_SNAP_NO_SQUASHFS;
+          snap->snap_euid = euid;
+          snap->snap_ruid = ruid;
+          snap->num_ancestors = nanc;
+          memcpy (snap->ancestors, ancs, nanc * sizeof (ancs[0]));
+          snap->prefix_mnt_id = pstx.stx_mnt_id;
+          snap->prefix_dev = ancs[nanc - 1].dev;
+          snap->prefix_ino = pstx.stx_ino;
+          snap->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+          snap->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+          snap->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+          snap->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+          snap->mnt_list_hash_lo = mnt_hash_lo;
+          snap->mnt_list_hash_hi = mnt_hash_hi;
+          ret_snap = snap;
+        }
+      goto out_cold;
+    }
+
+  if (num_cands > FSWC_MAX_PKGS)
+    goto out_cold;
+
+  fswc_sort_cand_pkgs (cands, num_cands, tstr);
+  if (num_mut > 1)
+    fswc_sort_top_entries (muts, num_mut, tstr);
+  if (num_top > 1)
+    fswc_sort_top_entries (tops, num_top, tstr);
+
+  /* 7. Compute 128-bit pkgset_hash over sorted immutable packages.  */
+  uint64_t pkgset_lo = FSWC_HASH_INIT_LO ^ 0x504b47534554ULL;
+  uint64_t pkgset_hi = FSWC_HASH_INIT_HI;
+  {
+    uint32_t np = (uint32_t) num_cands;
+    fswc_hash128_update (&pkgset_lo, &pkgset_hi, &np, sizeof (np));
+    for (size_t i = 0; i < num_cands; ++i)
+      {
+        const char *nm = tstr + cands[i].name_off;
+        uint64_t meta[3] =
+          {
+            cands[i].name_len,
+            cands[i].pkg_id_lo,
+            cands[i].pkg_id_hi
+          };
+        fswc_hash128_update (&pkgset_lo, &pkgset_hi, meta, sizeof (meta));
+        fswc_hash128_update (&pkgset_lo, &pkgset_hi, nm, cands[i].name_len);
+      }
+  }
+
+  char blob_name[64];
+  fswc_format_blob_name (blob_name, pkgset_lo, pkgset_hi);
+
+  void *final_blob_map = NULL;
+  size_t final_blob_sz = 0;
+  struct fswc_view view;
+
+  /* 8. Check if blob_<pkgset_hash> ALREADY exists in /dev/shm!  */
+  if (shm_dfd >= 0
+      && fswc_open_map_shm_ro (shm_dfd, blob_name, &final_blob_map,
+                               &final_blob_sz))
+    {
+      if (!fswc_validate_blob (final_blob_map, final_blob_sz, &view)
+          || view.hdr->pkgset_hash_lo != pkgset_lo
+          || view.hdr->pkgset_hash_hi != pkgset_hi)
+        {
+          fswc_sys_munmap (final_blob_map, final_blob_sz);
+          final_blob_map = NULL;
+          final_blob_sz = 0;
+        }
+    }
+
+  /* 9. Build blob_<pkgset_hash> from Tier-1 pkg_* cache or Tier-0 SquashFS scan.  */
+  if (final_blob_map == NULL)
+    {
+      struct fswc_pkg_input *pinputs
+        = fswc_arena_alloc (&pmaps_ar,
+                            num_cands * sizeof (struct fswc_pkg_input),
+                            _Alignof (struct fswc_pkg_input));
+      if (pinputs == NULL)
+        goto out_cold;
+      memset (pinputs, 0, num_cands * sizeof (struct fswc_pkg_input));
+
+      size_t max_inodes = GL (dl_fswc_state).max_inodes;
+      size_t scanned_inodes = 0;
+      bool scan_ok = true;
+
+      for (size_t i = 0; i < num_cands; ++i)
+        {
+          pinputs[i].name = tstr + cands[i].name_off;
+          pinputs[i].name_len = cands[i].name_len;
+          pinputs[i].pkg_id_lo = cands[i].pkg_id_lo;
+          pinputs[i].pkg_id_hi = cands[i].pkg_id_hi;
+
+          char pkg_cache_name[64];
+          fswc_format_pkg_name (pkg_cache_name, cands[i].pkg_id_lo,
+                                cands[i].pkg_id_hi);
+
+          void *pmap = NULL;
+          size_t psz = 0;
+          if (cands[i].persist_tier1 && shm_dfd >= 0
+              && fswc_open_map_shm_ro (shm_dfd, pkg_cache_name, &pmap, &psz))
+            {
+              if (fswc_validate_pkg_cache (pmap, psz, cands[i].pkg_id_lo,
+                                           cands[i].pkg_id_hi))
+                {
+                  const struct fswc_pkg_cache_hdr *ph = pmap;
+                  scanned_inodes += ph->num_entries;
+                  if (max_inodes != 0 && scanned_inodes > max_inodes)
+                    {
+                      fswc_sys_munmap (pmap, psz);
+                      scan_ok = false;
+                      break;
+                    }
+                  pinputs[i].pcache = ph;
+                  pinputs[i].pcache_sz = psz;
+                  continue;
+                }
+              fswc_sys_munmap (pmap, psz);
+            }
+
+          pmap = fswc_scan_squashfs_pkg (cands[i].dfd, cands[i].pkg_id_lo,
+                                         cands[i].pkg_id_hi, max_inodes,
+                                         &scanned_inodes, &psz);
+          if (pmap == NULL)
+            {
+              scan_ok = false;
+              break;
+            }
+          if (cands[i].persist_tier1 && shm_dfd >= 0)
+            fswc_shm_publish_atomic (shm_dfd, pkg_cache_name, pmap, psz);
+
+          pinputs[i].pcache = pmap;
+          pinputs[i].pcache_sz = psz;
+        }
+
+      void *built_blob = NULL;
+      size_t built_sz = 0;
+      if (scan_ok)
+        built_blob = fswc_assemble_blob (pinputs, (uint32_t) num_cands,
+                                         pkgset_lo, pkgset_hi, &built_sz);
+
+      for (size_t i = 0; i < num_cands; ++i)
+        if (pinputs[i].pcache != NULL)
+          fswc_sys_munmap ((void *) pinputs[i].pcache, pinputs[i].pcache_sz);
+
+      if (built_blob == NULL)
+        goto out_cold;
+
+      if (shm_dfd >= 0
+          && fswc_shm_publish_atomic (shm_dfd, blob_name, built_blob, built_sz)
+          && fswc_open_map_shm_ro (shm_dfd, blob_name, &final_blob_map,
+                                   &final_blob_sz)
+          && fswc_validate_blob (final_blob_map, final_blob_sz, &view))
+        {
+          /* Discard anonymous copy in favor of pure MAP_SHARED (0 KiB dirty)! */
+          fswc_sys_munmap (built_blob, built_sz);
+        }
+      else
+        {
+          if (final_blob_map != NULL)
+            fswc_sys_munmap (final_blob_map, final_blob_sz);
+          if (!fswc_validate_blob (built_blob, built_sz, &view))
+            {
+              fswc_sys_munmap (built_blob, built_sz);
+              goto out_cold;
+            }
+          Internal_mprotect_ro:;
+          INTERNAL_SYSCALL_CALL (mprotect, built_blob,
+                                 (built_sz + 4095ULL) & ~4095ULL, PROT_READ);
+          (void) &&Internal_mprotect_ro;
+          final_blob_map = built_blob;
+          final_blob_sz = built_sz;
+        }
+    }
+
+  /* 10. Publish ns_<prefix_mnt_id>_<prefix_ino> to /dev/shm.  */
+  if (shm_dfd >= 0)
+    {
+      uint64_t mut_off = fswc_align8 (sizeof (struct fswc_ns_header));
+      uint64_t top_off = fswc_align8 (mut_off + mut_ar.used);
+      uint64_t str_off = fswc_align8 (top_off + top_ar.used);
+      uint64_t ns_tot = fswc_align8 (str_off + tstr_ar.used);
+      if (ns_tot <= FSWC_BLOB_MAX_SIZE)
+        {
+          uint8_t *nbuf = fswc_sys_mmap_anon ((size_t) ns_tot);
+          if (nbuf != NULL)
+            {
+              struct fswc_ns_header *nh = (struct fswc_ns_header *) nbuf;
+              nh->magic = FSWC_NS_MAGIC;
+              nh->version = FSWC_NS_VERSION;
+              nh->total_size = ns_tot;
+              nh->flags = 0;
+              nh->num_mutable_dirs = (uint32_t) num_mut;
+              nh->num_top_files = (uint32_t) num_top;
+              nh->strtab_size = (uint32_t) tstr_ar.used;
+              nh->prefix_mnt_id = pstx.stx_mnt_id;
+              nh->prefix_dev = ancs[nanc - 1].dev;
+              nh->prefix_ino = pstx.stx_ino;
+              nh->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+              nh->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+              nh->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+              nh->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+              nh->mnt_list_hash_lo = mnt_hash_lo;
+              nh->mnt_list_hash_hi = mnt_hash_hi;
+              nh->pkgset_hash_lo = pkgset_lo;
+              nh->pkgset_hash_hi = pkgset_hi;
+              nh->mutable_off = (uint32_t) mut_off;
+              nh->top_files_off = (uint32_t) top_off;
+              nh->strtab_off = (uint32_t) str_off;
+              if (mut_ar.used > 0)
+                memcpy (nbuf + mut_off, mut_ar.base, mut_ar.used);
+              if (top_ar.used > 0)
+                memcpy (nbuf + top_off, top_ar.base, top_ar.used);
+              memcpy (nbuf + str_off, tstr_ar.base, tstr_ar.used);
+              fswc_shm_publish_atomic (shm_dfd, ns_name, nbuf, (size_t) ns_tot);
+              fswc_sys_munmap (nbuf, (size_t) ns_tot);
+            }
+        }
+    }
+
+  /* 11. Allocate immortal struct fswc_slot_snap.  */
+  {
+    struct fswc_slot_snap *snap
+      = fswc_perm_alloc_locked (sizeof (*snap), _Alignof (struct fswc_slot_snap));
+    struct fswc_top_entry *mut_cp
+      = mut_ar.used > 0
+        ? fswc_perm_alloc_locked (mut_ar.used, _Alignof (struct fswc_top_entry))
+        : NULL;
+    struct fswc_top_entry *top_cp
+      = top_ar.used > 0
+        ? fswc_perm_alloc_locked (top_ar.used, _Alignof (struct fswc_top_entry))
+        : NULL;
+    char *str_cp = fswc_perm_alloc_locked (tstr_ar.used, 1);
+
+    if (snap == NULL || str_cp == NULL
+        || (mut_ar.used > 0 && mut_cp == NULL)
+        || (top_ar.used > 0 && top_cp == NULL))
+      {
+        fswc_sys_munmap (final_blob_map, final_blob_sz);
+        goto out_cold;
+      }
+
+    if (mut_ar.used > 0)
+      memcpy (mut_cp, mut_ar.base, mut_ar.used);
+    if (top_ar.used > 0)
+      memcpy (top_cp, top_ar.base, top_ar.used);
+    memcpy (str_cp, tstr_ar.base, tstr_ar.used);
+
+    memset (snap, 0, sizeof (*snap));
+    snap->last_check_ms = build_ms;
+    snap->checked_inval_gen = start_gen;
+    snap->snap_flags = snap_flags;
+    snap->snap_euid = euid;
+    snap->snap_ruid = ruid;
+    snap->num_ancestors = nanc;
+    memcpy (snap->ancestors, ancs, nanc * sizeof (ancs[0]));
+    snap->prefix_mnt_id = pstx.stx_mnt_id;
+    snap->prefix_dev = ancs[nanc - 1].dev;
+    snap->prefix_ino = pstx.stx_ino;
+    snap->prefix_ctime_sec = pstx.stx_ctime.tv_sec;
+    snap->prefix_ctime_nsec = pstx.stx_ctime.tv_nsec;
+    snap->prefix_mtime_sec = pstx.stx_mtime.tv_sec;
+    snap->prefix_mtime_nsec = pstx.stx_mtime.tv_nsec;
+    snap->mnt_list_hash_lo = mnt_hash_lo;
+    snap->mnt_list_hash_hi = mnt_hash_hi;
+    snap->num_mutable_dirs = (uint32_t) num_mut;
+    snap->num_top_files = (uint32_t) num_top;
+    snap->mutable_dirs = mut_cp;
+    snap->top_files = top_cp;
+    snap->top_strtab = str_cp;
+    snap->view = view;
+    ret_snap = snap;
+  }
+
+out_cold:
+  if (cands_ar.base != NULL)
+    {
+      size_t nc = cands_ar.used / sizeof (struct fswc_cand_pkg);
+      for (size_t i = 0; i < nc; ++i)
+        {
+          int fd = ((struct fswc_cand_pkg *) cands_ar.base)[i].dfd;
+          if (fd >= 0)
+            INTERNAL_SYSCALL_CALL (close, fd);
+        }
+    }
+  fswc_arena_free (&mrecs_ar);
+  fswc_arena_free (&mstr_ar);
+  fswc_arena_free (&cands_ar);
+  fswc_arena_free (&mut_ar);
+  fswc_arena_free (&top_ar);
+  fswc_arena_free (&tstr_ar);
+  fswc_arena_free (&pmaps_ar);
+  fswc_arena_free (&mnt_ids_ar);
+  fswc_sys_munmap (sm_cold_dyn, sm_cold_dyn_sz);
+  if (shm_dfd >= 0)
+    INTERNAL_SYSCALL_CALL (close, shm_dfd);
+  INTERNAL_SYSCALL_CALL (close, (int) prefix_fd);
+  return ret_snap;
+#endif
+}
+
+bool
+__fswc_acquire_slot_amortized (const char *raw_prefix, size_t raw_len,
+                               uint16_t *seen_mask, uint16_t *out_slot_idx,
+                               struct fswc_slot_snap **out_snap)
+{
+  *out_slot_idx = 0;
+  *out_snap = NULL;
+
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (__glibc_unlikely (atomic_load_acquire (&st->init_state) == 0))
+    __fswc_init ();
+
+  int32_t mode = st->mode;
+  if (mode <= 0)
+    return false;
+
+  size_t plen;
+  if (!fswc_canonicalize_prefix (raw_prefix, raw_len, &plen))
+    return false;
+
+  /* 1. Lock-free lookup of existing slot.  */
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = atomic_load_acquire (&st->slots[i].prefix_len);
+      if (slen == 0)
+        break;
+      if (slen == plen && memcmp (st->slots[i].prefix, raw_prefix, plen) == 0)
+        {
+          bool force_reval
+            = !(seen_mask != NULL && (*seen_mask & (1u << i)));
+          struct fswc_slot_snap *snap = atomic_load_acquire (&st->slots[i].snap);
+          if (fswc_revalidate_snap (st->slots[i].prefix, snap, force_reval))
+            {
+              if (seen_mask != NULL)
+                *seen_mask |= (uint16_t) (1u << i);
+              *out_slot_idx = i;
+              *out_snap = snap;
+              return true;
+            }
+          break;
+        }
+    }
+
+  /* 2. Slow path under GL.lock: build or refresh slot.  */
+  fswc_lock_acquire ();
+
+  uint16_t target_idx = FSWC_MAX_SLOTS;
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = st->slots[i].prefix_len;
+      if (slen == 0)
+        {
+          target_idx = i;
+          break;
+        }
+      if (slen == plen && memcmp (st->slots[i].prefix, raw_prefix, plen) == 0)
+        {
+          bool force_reval
+            = !(seen_mask != NULL && (*seen_mask & (1u << i)));
+          struct fswc_slot_snap *snap = atomic_load_acquire (&st->slots[i].snap);
+          if (fswc_revalidate_snap (st->slots[i].prefix, snap, force_reval))
+            {
+              fswc_lock_release ();
+              if (seen_mask != NULL)
+                *seen_mask |= (uint16_t) (1u << i);
+              *out_slot_idx = i;
+              *out_snap = snap;
+              return true;
+            }
+          target_idx = i;
+          break;
+        }
+    }
+
+  if (target_idx >= FSWC_MAX_SLOTS)
+    {
+      fswc_lock_release ();
+      return false;
+    }
+
+  const char *canon_prefix = st->slots[target_idx].prefix;
+  if (canon_prefix == NULL)
+    {
+      char *cp = fswc_perm_alloc_locked (plen + 1, 1);
+      if (cp == NULL)
+        {
+          fswc_lock_release ();
+          return false;
+        }
+      memcpy (cp, raw_prefix, plen);
+      cp[plen] = '\0';
+      canon_prefix = cp;
+    }
+
+  struct fswc_slot_snap *new_snap
+    = fswc_build_or_load_snap_locked (canon_prefix, plen);
+  if (new_snap != NULL)
+    {
+      atomic_store_release (&st->slots[target_idx].snap, new_snap);
+      if (st->slots[target_idx].prefix_len == 0)
+        {
+          st->slots[target_idx].prefix = canon_prefix;
+          atomic_store_release (&st->slots[target_idx].prefix_len,
+                                (uint32_t) plen);
+        }
+    }
+
+  fswc_lock_release ();
+  if (new_snap == NULL)
+    return false;
+  if (seen_mask != NULL)
+    *seen_mask |= (uint16_t) (1u << target_idx);
+  *out_slot_idx = target_idx;
+  *out_snap = new_snap;
+  return true;
+}
+
+bool
+__fswc_acquire_slot (const char *raw_prefix, size_t raw_len,
+                     uint16_t *out_slot_idx, struct fswc_slot_snap **out_snap)
+{
+  return __fswc_acquire_slot_amortized (raw_prefix, raw_len, NULL,
+                                        out_slot_idx, out_snap);
+}
+
+struct fswc_slot_snap *
+__fswc_peek_slot_waitfree (const char *raw_prefix, size_t raw_len,
+                           uint16_t *seen_mask)
+{
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (atomic_load_acquire (&st->init_state) == 0 || st->mode <= 0)
+    return NULL;
+
+  size_t plen;
+  if (!fswc_canonicalize_prefix (raw_prefix, raw_len, &plen))
+    return NULL;
+
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = atomic_load_acquire (&st->slots[i].prefix_len);
+      if (slen == 0)
+        break;
+      if (slen == plen && memcmp (st->slots[i].prefix, raw_prefix, plen) == 0)
+        {
+          bool force_reval
+            = !(seen_mask != NULL && (*seen_mask & (uint16_t) (1u << i)));
+          struct fswc_slot_snap *snap = atomic_load_acquire (&st->slots[i].snap);
+          if (fswc_revalidate_snap (st->slots[i].prefix, snap, force_reval))
+            {
+              if (seen_mask != NULL)
+                *seen_mask |= (uint16_t) (1u << i);
+              return snap;
+            }
+          return NULL;
+        }
+    }
+  return NULL;
+}
+
+bool
+__fswc_snap_is_valid (const struct fswc_slot_snap *snap)
+{
+  if (snap == NULL || atomic_load_acquire (&snap->stale) != 0)
+    return false;
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (atomic_load_acquire (&st->init_state) == 0 || st->mode <= 0)
+    return false;
+  bool force_reval = true;
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = atomic_load_acquire (&st->slots[i].prefix_len);
+      if (slen == 0)
+        break;
+      if (atomic_load_acquire (&st->slots[i].snap) == snap)
+        return fswc_revalidate_snap (st->slots[i].prefix,
+                                     (struct fswc_slot_snap *) snap,
+                                     force_reval);
+    }
+  return false;
+}
+
+bool
+__fswc_find_mapped_prefix (const char *path, size_t *out_prefix_len)
+{
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (atomic_load_acquire (&st->init_state) == 0 || st->mode <= 0
+      || path == NULL || path[0] != '/')
+    return false;
+
+  size_t best_len = 0;
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = atomic_load_acquire (&st->slots[i].prefix_len);
+      if (slen == 0)
+        break;
+      if (slen > best_len
+          && strncmp (path, st->slots[i].prefix, slen) == 0
+          && path[slen] == '/')
+        {
+          struct fswc_slot_snap *snap = atomic_load_acquire (&st->slots[i].snap);
+          if (snap != NULL && !(snap->snap_flags & FSWC_SNAP_NO_SQUASHFS))
+            best_len = slen;
+        }
+    }
+  if (best_len == 0)
+    return false;
+  *out_prefix_len = best_len;
+  return true;
+}
+
+/* mode=2 async-signal-safe, wait-free, allocation-free exact path negative
+   filter.  Returns 0 to fall through to kernel, or -ENOENT / -ENOTDIR.  */
+int
+__fswc_probe_exact (const char *path)
+{
+  struct fswc_state *st = &GL (dl_fswc_state);
+  if (atomic_load_acquire (&st->init_state) == 0 || st->mode < 2
+      || path == NULL || path[0] != '/')
+    return 0;
+
+  /* Reject paths >= PATH_MAX so kernel returns exact ENAMETOOLONG.  */
+  const char *path_nul = memchr (path, '\0', PATH_MAX);
+  if (path_nul == NULL)
+    return 0;
+  size_t path_len = (size_t) (path_nul - path);
+
+  /* Match longest active non-empty SquashFS prefix slot.  */
+  uint16_t matched_slot = FSWC_MAX_SLOTS;
+  uint32_t best_plen = 0;
+  for (uint16_t i = 0; i < FSWC_MAX_SLOTS; ++i)
+    {
+      uint32_t slen = atomic_load_acquire (&st->slots[i].prefix_len);
+      if (slen == 0)
+        break;
+      if (slen > best_plen
+          && path_len > slen
+          && path[slen] == '/'
+          && memcmp (path, st->slots[i].prefix, slen) == 0)
+        {
+          best_plen = slen;
+          matched_slot = i;
+        }
+    }
+  if (matched_slot >= FSWC_MAX_SLOTS)
+    return 0;
+
+  /* Note: if multiple '/' follow prefix (e.g. "<pfx>///bash/bin/foo"), only
+     proceed if prefix itself is a WORLD_SEARCH directory -- verified below! */
+  const char *p = path + best_plen + 1;
+  while (*p == '/')
+    ++p;
+  if (*p == '\0')
+    return 0;
+
+  /* Parse <pkg> component.  */
+  const char *pkg_start = p;
+  while (*p != '\0' && *p != '/')
+    ++p;
+  size_t pkg_len = (size_t) (p - pkg_start);
+  if (pkg_len == 0 || pkg_len > NAME_MAX
+      || (pkg_len == 1 && pkg_start[0] == '.')
+      || (pkg_len == 2 && pkg_start[0] == '.' && pkg_start[1] == '.'))
+    return 0;
+
+  struct fswc_slot_snap *snap
+    = atomic_load_acquire (&st->slots[matched_slot].snap);
+  if (snap == NULL
+      || (snap->snap_flags & FSWC_SNAP_NO_SQUASHFS)
+      || !(snap->snap_flags & FSWC_SNAP_ANCESTORS_WORLD_SEARCH))
+    return 0;
+
+  if (!fswc_revalidate_snap (st->slots[matched_slot].prefix, snap, false))
+    return 0;
+
+  const struct fswc_view *v = &snap->view;
+  const struct fswc_ht_entry *pk_ent
+    = __fswc_ht_lookup (v, FSWC_VDIR_PKGS, pkg_start, pkg_len);
+  if (pk_ent == NULL || pk_ent->all_cnt != 1)
+    /* Mutable dir, symlink, *.squashfs file, or missing pkg: let kernel handle
+       so unlinking a *.squashfs file never races between ENOTDIR and ENOENT. */
+    return 0;
+
+  uint32_t pkg_idx = FSWC_POSTING_PKG (pk_ent->all_ref);
+  if (pkg_idx >= v->hdr->num_pkgs)
+    return 0;
+  const struct fswc_pkg *pkg = &v->pkgs[pkg_idx];
+  if (!(pkg->flags & FSWC_PKG_IMMUTABLE))
+    return 0;
+
+  /* If path ends at <prefix>/<pkg> or <prefix>/<pkg>/, positive hit! */
+  while (*p == '/')
+    ++p;
+  if (*p == '\0')
+    return 0;
+
+  bool pkg_all_ws = (pkg->flags & FSWC_PKG_ALL_WORLD_SEARCH) != 0;
+  uint32_t cur_vdir = FSWC_VDIR_ROOT;
+  if (!pkg_all_ws
+      && !(v->vdirs[cur_vdir].flags & FSWC_VDIR_ALL_WORLD_SEARCH))
+    return 0;
+
+  uint32_t vdir_stack[32];
+  uint32_t depth = 0;
+
+  while (*p != '\0')
+    {
+      const char *cstart = p;
+      while (*p != '\0' && *p != '/')
+        ++p;
+      size_t clen = (size_t) (p - cstart);
+      if (clen > NAME_MAX)
+        return 0;
+
+      bool has_slash_after = (*p == '/');
+      while (*p == '/')
+        ++p;
+      bool has_more = (*p != '\0');
+
+      if (clen == 1 && cstart[0] == '.')
+        continue;
+
+      if (clen == 2 && cstart[0] == '.' && cstart[1] == '.')
+        {
+          if (depth == 0)
+            return 0; /* Escapes <prefix>/<pkg> */
+          cur_vdir = vdir_stack[--depth];
+          continue;
+        }
+
+      const struct fswc_ht_entry *ent
+        = __fswc_ht_lookup (v, cur_vdir, cstart, clen);
+      if (ent == NULL)
+        return -ENOENT;
+
+      int dt = __fswc_posting_find_pkg (v, ent->all_cnt, ent->all_ref, pkg_idx);
+      if (dt < 0)
+        return -ENOENT;
+
+      if (dt == DT_LNK || dt == DT_UNKNOWN)
+        return 0; /* Always let kernel resolve symlinks! */
+
+      if (has_slash_after || has_more)
+        {
+          if (dt != DT_DIR)
+            return -ENOTDIR;
+          if (!has_more)
+            return 0; /* Positive "<dir>/" leaf hit! */
+          if (ent->child_vdir_id == FSWC_NONE
+              || ent->child_vdir_id >= v->hdr->num_vdirs
+              || depth >= 32)
+            return 0;
+          if (!pkg_all_ws
+              && !(v->vdirs[ent->child_vdir_id].flags
+                   & FSWC_VDIR_ALL_WORLD_SEARCH))
+            return 0;
+          vdir_stack[depth++] = cur_vdir;
+          cur_vdir = ent->child_vdir_id;
+        }
+      else
+        return 0; /* Positive leaf hit: let kernel open/stat/access! */
+    }
+
+  return 0;
+}
