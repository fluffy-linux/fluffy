+static int
+fswc_glob_append_str (glob_t *pglob, const char *s, size_t len, bool add_slash)
+{
+  size_t newcount = pglob->gl_pathc + pglob->gl_offs;
+  if (newcount > SIZE_MAX / sizeof (char *) - 2)
+    return GLOB_NOSPACE;
+  char *copy = malloc (len + (add_slash ? 2 : 1));
+  if (copy == NULL)
+    return GLOB_NOSPACE;
+  memcpy (copy, s, len);
+  if (add_slash)
+    copy[len++] = '/';
+  copy[len] = '\0';
+  bool first_alloc = (pglob->gl_pathv == NULL);
+  char **new_v = realloc (pglob->gl_pathv, (newcount + 2) * sizeof (char *));
+  if (new_v == NULL)
+    {
+      free (copy);
+      return GLOB_NOSPACE;
+    }
+  if (first_alloc)
+    for (size_t i = 0; i < pglob->gl_offs; ++i)
+      new_v[i] = NULL;
+  new_v[newcount] = copy;
+  new_v[newcount + 1] = NULL;
+  pglob->gl_pathv = new_v;
+  ++pglob->gl_pathc;
+  return 0;
+}
