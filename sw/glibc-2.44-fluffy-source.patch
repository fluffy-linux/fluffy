+
+#ifndef _FSWC_H
+#define _FSWC_H 1
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define FSWC_BLOB_MAGIC   0x43575346u /* "FSWC" */
+#define FSWC_BLOB_VERSION 5u
+#define FSWC_NS_MAGIC     0x534e5746u /* "FWNS" */
+#define FSWC_NS_VERSION   6u
+#define FSWC_PKG_MAGIC    0x47505746u /* "FWPG" */
+#define FSWC_PKG_VERSION  5u
+
+#define FSWC_VDIR_ROOT    0u          /* Virtual union root of packages */
+#define FSWC_VDIR_PKGS    0xffffffffu /* Sentinel key space for <pkg> names */
+#define FSWC_NONE         0xffffffffu
+#define FSWC_MAX_PKGS     65534u
+#define FSWC_MAX_SLOTS    16u
+#define FSWC_MAX_ANCESTORS 16u
+#define FSWC_MAX_LNK_STEPS 16u
+
+/* Posting word layout: low 24 bits = pkg_idx, high 8 bits = d_type.  */
+#define FSWC_POSTING_PACK(pkg, dt) \
+  (((uint32_t) (pkg) & 0x00ffffffu) | ((uint32_t) (dt) << 24))
+#define FSWC_POSTING_PKG(word)   ((word) & 0x00ffffffu)
+#define FSWC_POSTING_DTYPE(word) (((word) >> 24) & 0xffu)
+
+/* Global blob flags: */
+#define FSWC_GF_ALL_WORLD_SEARCH  (1u << 0)
+#define FSWC_GF_ALL_WORLD_RX      (1u << 1)
+
+/* Per-package flags: */
+#define FSWC_PKG_IMMUTABLE        (1u << 0)
+#define FSWC_PKG_ALL_WORLD_SEARCH (1u << 1)
+#define FSWC_PKG_ALL_WORLD_RX     (1u << 2)
+
+/* Per-vdir flags: */
+#define FSWC_VDIR_ALL_WORLD_SEARCH (1u << 0)
+#define FSWC_VDIR_ALL_WORLD_RX     (1u << 1)
+
+/* Per-ht_entry flags: */
+#define FSWC_ENT_HAS_LNK           (1u << 0)
+#define FSWC_ENT_HAS_DIR           (1u << 1)
+#define FSWC_ENT_RESTRICTED_SEARCH (1u << 2)
+#define FSWC_ENT_RESTRICTED_RX     (1u << 3)
+
+/* Per-slot snapshot flags: */
+#define FSWC_SNAP_NO_SQUASHFS            (1u << 0)
+#define FSWC_SNAP_ANCESTORS_WORLD_SEARCH (1u << 1)
+#define FSWC_SNAP_PREFIX_WORLD_RX        (1u << 2)
+
+struct fswc_header
+{
+  uint32_t magic;
+  uint32_t version;
+  uint64_t total_size;
+  uint64_t pkgset_hash_lo;
+  uint64_t pkgset_hash_hi;
+  uint32_t num_pkgs;
+  uint32_t num_vdirs;
+  uint32_t ht_mask;
+  uint32_t num_postings;
+  uint32_t num_vchildren;
+  uint32_t strtab_size;
+  uint32_t global_flags;
+  uint32_t pkgs_off;
+  uint32_t vdirs_off;
+  uint32_t ht_off;
+  uint32_t postings_off;
+  uint32_t vchildren_off;
+  uint32_t strtab_off;
+  uint32_t reserved;
+};
+
+struct fswc_pkg
+{
+  uint32_t name_off;
+  uint16_t name_len;
+  uint16_t flags;
+};
+
+struct fswc_vdir
+{
+  uint32_t children_start;
+  uint32_t children_count;
+  uint32_t dir_postings_ref;
+  uint16_t dir_postings_cnt;
+  uint16_t flags;
+};
+
+struct fswc_ht_entry
+{
+  uint64_t hash;
+  uint32_t parent_vdir_id;
+  uint32_t name_off;
+  uint16_t name_len;
+  uint16_t flags;
+  uint32_t child_vdir_id;
+  uint32_t all_ref;
+  uint16_t all_cnt;
+  uint16_t dir_cnt;
+};
+
+struct fswc_vchild
+{
+  uint32_t ht_slot;
+};
+
+struct fswc_ancestor_id
+{
+  uint64_t mnt_id;
+  uint64_t dev;
+  uint64_t ino;
+  int64_t ctime_sec;
+  uint32_t ctime_nsec;
+  uint16_t path_len;
+  uint16_t pad;
+};
+
+struct fswc_top_entry
+{
+  uint32_t name_off;
+  uint16_t name_len;
+  uint8_t d_type;
+  uint8_t flags;
+};
+
+struct fswc_view
+{
+  const struct fswc_header *hdr;
+  const struct fswc_pkg *pkgs;
+  const struct fswc_vdir *vdirs;
+  const struct fswc_ht_entry *ht;
+  const uint32_t *postings;
+  const struct fswc_vchild *vchildren;
+  const char *strtab;
+  size_t map_size;
+};
+
+struct fswc_slot_snap
+{
+  uint32_t last_check_ms;
+  uint32_t checked_inval_gen;
+  uint32_t stale;
+
+  uint32_t snap_flags;
+  uint32_t snap_euid;
+  uint32_t snap_ruid;
+  uint32_t num_ancestors;
+  uint64_t prefix_mnt_id;
+  uint64_t prefix_dev;
+  uint64_t prefix_ino;
+  int64_t prefix_ctime_sec;
+  int64_t prefix_mtime_sec;
+  uint32_t prefix_ctime_nsec;
+  uint32_t prefix_mtime_nsec;
+  uint64_t mnt_list_hash_lo;
+  uint64_t mnt_list_hash_hi;
+  struct fswc_ancestor_id ancestors[FSWC_MAX_ANCESTORS];
+
+  uint32_t num_mutable_dirs;
+  uint32_t num_top_files;
+  const struct fswc_top_entry *mutable_dirs;
+  const struct fswc_top_entry *top_files;
+  const char *top_strtab;
+
+  struct fswc_view view;
+};
+
+struct fswc_slot
+{
+  const char *prefix;
+  uint32_t prefix_len;
+  uint32_t reserved;
+  struct fswc_slot_snap *snap;
+};
+
+struct fswc_state
+{
+  uint32_t lock;
+  uint32_t init_state;
+  int32_t mode;
+  uint32_t inval_gen;
+  size_t max_inodes;
+  uint32_t init_euid;
+  uint32_t init_ruid;
+  uint8_t *perm_cur;
+  size_t perm_rem;
+  struct fswc_slot slots[FSWC_MAX_SLOTS];
+};
+
+struct fswc_relpath_result
+{
+  const struct fswc_ht_entry *leaf_ent;
+  uint32_t target_vdir_id;
+  uint32_t num_lnk_ents;
+  bool lnk_overflow;
+  bool restricted_search;
+  const struct fswc_ht_entry *lnk_ents[FSWC_MAX_LNK_STEPS];
+};
+
+extern void __fswc_init (void) attribute_hidden;
+extern void __fswc_fork_lock_parent (void) attribute_hidden;
+extern void __fswc_fork_unlock_parent (void) attribute_hidden;
+extern void __fswc_fork_child (void) attribute_hidden;
+extern void __fswc_invalidate (void) attribute_hidden;
+extern int __fswc_probe_exact (const char *path) attribute_hidden;
+
+extern bool __fswc_acquire_slot (const char *raw_prefix, size_t raw_len,
+                                 uint16_t *out_slot_idx,
+                                 struct fswc_slot_snap **out_snap)
+     attribute_hidden;
+
+extern bool __fswc_acquire_slot_amortized (const char *raw_prefix,
+                                           size_t raw_len,
+                                           uint16_t *seen_mask,
+                                           uint16_t *out_slot_idx,
+                                           struct fswc_slot_snap **out_snap)
+     attribute_hidden;
+
+extern struct fswc_slot_snap *__fswc_peek_slot_waitfree (const char *raw_prefix,
+                                                         size_t raw_len,
+                                                         uint16_t *seen_mask)
+     attribute_hidden;
+
+extern bool __fswc_snap_is_valid (const struct fswc_slot_snap *snap)
+     attribute_hidden;
+
+extern bool __fswc_find_mapped_prefix (const char *path,
+                                       size_t *out_prefix_len)
+     attribute_hidden;
+
+extern const struct fswc_ht_entry *__fswc_ht_lookup (const struct fswc_view *v,
+                                                     uint32_t parent_vdir_id,
+                                                     const char *name,
+                                                     size_t name_len)
+     attribute_hidden;
+
+extern const uint32_t *__fswc_posting_slice (const struct fswc_view *v,
+                                             uint16_t cnt, uint32_t ref,
+                                             uint32_t *inline_buf,
+                                             uint32_t *out_n)
+     attribute_hidden;
+
+extern int __fswc_posting_find_pkg (const struct fswc_view *v,
+                                    uint16_t cnt, uint32_t ref,
+                                    uint32_t pkg_idx)
+     attribute_hidden;
+
+extern bool __fswc_resolve_pkg_wild_relpath (const struct fswc_slot_snap *snap,
+                                             const char *relpath,
+                                             size_t rel_len,
+                                             struct fswc_relpath_result *out)
+     attribute_hidden;
+
+extern bool __fswc_pkg_in_lnk_steps (const struct fswc_view *v,
+                                     const struct fswc_relpath_result *res,
+                                     uint32_t pkg_idx)
+     attribute_hidden;
+
+#ifdef SHARED
+# define FSWC_INVALIDATE() __fswc_invalidate ()
+#else
+# define FSWC_INVALIDATE() call_function_static_weak (__fswc_invalidate)
+#endif
+
+#endif /* _FSWC_H */
