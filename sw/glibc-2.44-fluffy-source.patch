+/* Attempt to execute EXEC_PATH.  Returns 0 to continue searching PATH, or -1
+   on fatal execution error.  */
+static int
+try_exec_candidate (const char *exec_path, char *const argv[],
+                    char *const envp[], bool exec_script, bool *got_eacces)
+{
+  __execve (exec_path, argv, envp);
+
+  if (errno == ENOEXEC && exec_script)
+    maybe_script_execute (exec_path, argv, envp);
+
+  switch (errno)
+    {
+    case EACCES:
+      *got_eacces = true;
+      [[fallthrough]];
+    case ENOENT:
+    case ESTALE:
+    case ENOTDIR:
+    case ENAMETOOLONG:
+    case ENODEV:
+    case ETIMEDOUT:
+      return 0;
+
+    default:
+      return -1;
+    }
+}
+
+static size_t
+build_wildcard_exec_path (char *exec_buf, size_t cap,
+                          const char *prefix, size_t prefix_len,
+                          const char *pkg, size_t pkg_len,
+                          const char *suffix, size_t suffix_len,
+                          const char *file, size_t file_len_with_nul)
+{
+  if (prefix_len + 1 + pkg_len + suffix_len + 1 + file_len_with_nul > cap)
+    return 0;
+
+  char *eb = exec_buf;
+  memcpy (eb, prefix, prefix_len);
+  eb += prefix_len;
+  if (eb > exec_buf && *(eb - 1) != '/')
+    *eb++ = '/';
+  memcpy (eb, pkg, pkg_len);
+  eb += pkg_len;
+  if (suffix_len > 0)
+    {
+      memcpy (eb, suffix, suffix_len);
+      eb += suffix_len;
+    }
+  if (eb > exec_buf && *(eb - 1) != '/')
+    *eb++ = '/';
+  memcpy (eb, file, file_len_with_nul);
+  return (size_t) ((eb + file_len_with_nul) - exec_buf);
+}
