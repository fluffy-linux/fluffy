+#ifdef SHARED
+		      q = __mempcpy (q, capstr[v].str, capstr[v].len);
+#endif
+		      q = __mempcpy (q, s->name, s->namelen);
+		      __fswc_query_prepare (&star_queries[v], c->idx, rel,
+					    q - 1 - rel);
+		    }
+		  s->prepared = c->idx;
+		  /* Rebuild this variant's name, overwritten above.  */
+		  edp = s->buf + c->len + 1;
+#ifdef SHARED
