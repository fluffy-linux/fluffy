+{
+  int pnest = 0;
+  int bnest = 0;
+  bool skip = false;
+  const char *bfirst = NULL;
+
+  if (string >= end)
+    return NULL;
+
+  for (const char *s = string; *s != '\0'; ++s)
+    {
+      if (s >= end)
+        return s;
+      if (skip)
+        {
+          skip = false;
+          continue;
+        }
+      switch (*s)
+        {
+        case '\\':
+          if (quote)
+            skip = true;
+          break;
+        case '[':
+          if (bnest == 0)
+            {
+              bfirst = s + 1;
+              if (*bfirst == '!' || *bfirst == '^')
+                ++bfirst;
+              ++bnest;
+            }
+          else if (s[1] == ':' || s[1] == '.' || s[1] == '=')
+            {
+              char type = s[1];
+              const char *t = s + 2;
+              while (*t != '\0' && (type == '.' || *t != ']'))
+                {
+                  if (*t == type && t[1] == ']')
+                    {
+                      s = t + 1;
+                      break;
+                    }
+                  ++t;
+                }
+            }
+          break;
+        case ']':
+          if (bnest > 0 && s != bfirst)
+            {
+              --bnest;
+              bfirst = NULL;
+            }
+          break;
+        case '(':
+          if (bnest == 0)
+            ++pnest;
+          break;
+        case ')':
+          if (bnest == 0 && pnest-- <= 0)
+            return s + 1;
+          break;
+        default:
+          if (bnest == 0 && pnest == 0 && delim != 0 && *s == delim)
+            return s + 1;
+          break;
+        }
+    }
