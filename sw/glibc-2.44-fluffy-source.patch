+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <sysdep.h>
+#include <unistd.h>
+
+int
+__execve (const char *path, char *const argv[], char *const envp[])
+{
+  int r = INLINE_SYSCALL_CALL (execve, path, argv, envp);
+  if (__glibc_unlikely (r < 0 && errno == ENOENT && path != NULL))
+    {
+      bool has_slash = false;
+      bool has_meta = false;
+      for (const char *p = path; *p != '\0'; ++p)
+	{
+	  if (*p == '\\' && p[1] != '\0')
+	    {
+	      ++p;
+	      continue;
+	    }
+	  if (*p == '/')
+	    has_slash = true;
+	  else if (*p == '*' || *p == '?' || *p == '[')
+	    has_meta = true;
+	}
+      if (has_slash && has_meta)
+	return __execve_wildcard_path (path, argv, envp);
+    }
+  return r;
+}
+weak_alias (__execve, execve)
