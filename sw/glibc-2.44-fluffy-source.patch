+static bool
+is_extglob (const char *p)
+{
+  return ((p[0] == '?' || p[0] == '*' || p[0] == '+' || p[0] == '@'
+           || p[0] == '!')
+          && p[1] == '(');
+}
+
+static const char *
+glob_dirscan (const char *pat, int dirsep, bool quote)
+{
+  const char *d = NULL;
+  const char *pe = pat + strlen (pat);
+
+  for (const char *p = pat; p && *p; ++p)
+    {
+      if (is_extglob (p))
+        {
+          const char *np = glob_patscan (p + 2, pe, 0, quote);
+          if (np == NULL || np == p + 2)
+            continue;
+          p = np - 1;
+        }
+      else if (*p == dirsep)
+        d = p;
+    }
+  return d;
+}
