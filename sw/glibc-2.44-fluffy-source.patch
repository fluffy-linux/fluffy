+#ifndef SHARED
+struct fswc_state _dl_fswc_state;
+#endif
+
+#ifndef SQUASHFS_MAGIC
+# define SQUASHFS_MAGIC 0x73717368u
+#endif
+
+#ifndef STATX_MNT_ID_UNIQUE
+# define STATX_MNT_ID_UNIQUE 0x00004000U
+#endif
+
+#define FSWC_LSMT_ROOT           0xffffffffffffffffULL
+#define FSWC_MNT_ID_REQ_SIZE     24u
+#define FSWC_STATMOUNT_SB_BASIC  0x00000001ULL
+#define FSWC_STATMOUNT_MNT_BASIC 0x00000002ULL
+#define FSWC_STATMOUNT_MNT_ROOT  0x00000008ULL
+#define FSWC_STATMOUNT_MNT_POINT 0x00000010ULL
+
+#define FSWC_REVALIDATE_MS       50u         /* 50 ms */
