+/* Limit-free SquashFS-aware shared directory cache for Fluffy Linux.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+    Binary layout (mmap'd PROT_READ, 8-byte aligned, position-independent):
+     [struct fswc_header]
+     [struct fswc_pkg      * num_pkgs]       (sorted lexicographically)
+     [struct fswc_ht_entry * (ht_mask + 1)]  (<= 50% load open-addressed FNV-1a)
+     [uint32_t             * postings_count] (sorted pkg_idx slices for count > 1)
+     [struct fswc_dirent   * dirents_count]  (per-pkg contiguous dirent slices)
+     [char                 * strtab_size]    (NUL-terminated deduplicated strings)
+
+   Single-package postings (count == 1) are stored inline in fswc_ht_entry
+   without indirection.  All build buffers grow dynamically via anonymous
+   mmap + mremap (zero malloc dependency, zero fixed package/path/size caps).  */
+
+#ifndef _GLOB_FLUFFY_CACHE_H
+#define _GLOB_FLUFFY_CACHE_H 1
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <limits.h>
+#include <string.h>
+#include <fcntl.h>
+#include <dirent.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#ifndef STATX_TYPE
+# include <linux/stat.h>
+#endif
+#include <sys/syscall.h>
+
+#include <unistd.h>
+#ifdef _LIBC
+# include <sysdep.h>
+# define FC_SYSCALL(name, ...) INTERNAL_SYSCALL_CALL (name, __VA_ARGS__)
+# define FC_SYSCALL0(name)     INTERNAL_SYSCALL_CALL (name)
+#else
+# include <errno.h>
+# if defined __x86_64__
+static inline long
+fc_raw_syscall (long nr, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+  long ret;
+  register long r10 __asm__ ("r10") = a4;
+  register long r8 __asm__ ("r8") = a5;
+  register long r9 __asm__ ("r9") = a6;
+  __asm__ volatile ("syscall"
+                    : "=a" (ret)
+                    : "a" (nr), "D" (a1), "S" (a2), "d" (a3),
+                      "r" (r10), "r" (r8), "r" (r9)
+                    : "rcx", "r11", "memory");
+  return ret;
+}
+# else
+static inline long
+fc_raw_syscall (long nr, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+  long r = syscall (nr, a1, a2, a3, a4, a5, a6);
+  return r < 0 ? -errno : r;
+}
+# endif
+# define FC_SYSCALL_N(_1, _2, _3, _4, _5, _6, _7, NAME, ...) NAME
+# define FC_SYSCALL0(name) \
+  fc_raw_syscall (__NR_##name, 0, 0, 0, 0, 0, 0)
+# define FC_SC1(n, a) \
+  fc_raw_syscall (__NR_##n, (long) (a), 0, 0, 0, 0, 0)
+# define FC_SC2(n, a, b) \
+  fc_raw_syscall (__NR_##n, (long) (a), (long) (b), 0, 0, 0, 0)
+# define FC_SC3(n, a, b, c) \
+  fc_raw_syscall (__NR_##n, (long) (a), (long) (b), (long) (c), 0, 0, 0)
+# define FC_SC4(n, a, b, c, d) \
+  fc_raw_syscall (__NR_##n, (long) (a), (long) (b), (long) (c), (long) (d), 0, 0)
+# define FC_SC5(n, a, b, c, d, e) \
+  fc_raw_syscall (__NR_##n, (long) (a), (long) (b), (long) (c), (long) (d), (long) (e), 0)
+# define FC_SC6(n, a, b, c, d, e, f) \
+  fc_raw_syscall (__NR_##n, (long) (a), (long) (b), (long) (c), (long) (d), (long) (e), (long) (f))
+# define FC_SYSCALL(name, ...) \
+  FC_SYSCALL_N (name, __VA_ARGS__, FC_SC6, FC_SC5, FC_SC4, FC_SC3, FC_SC2, FC_SC1, 0) (name, __VA_ARGS__)
+#endif
+
+#ifndef __NR_statx
+# define __NR_statx 332
+#endif
+#ifndef __NR_listmount
+# define __NR_listmount 458
+#endif
+#ifndef STATX_MNT_ID_UNIQUE
+# define STATX_MNT_ID_UNIQUE 0x00004000U
+#endif
+#ifndef MREMAP_MAYMOVE
+# define MREMAP_MAYMOVE 1
+#endif
+#ifndef AT_EMPTY_PATH
+# define AT_EMPTY_PATH 0x1000
+#endif
+#ifndef MAP_ANONYMOUS
+# define MAP_ANONYMOUS 0x20
+#endif
+
+#define FSWC_MAGIC           0x46535743U /* "FSWC" */
+#define FSWC_VERSION         4U
+#define FSWC_SHM_SLOTS       16U         /* bounded per-(uid, mnt_id) slots */
+#define FSWC_NUM_SUBDIRS     5U          /* 0:bin, 1:lib, 2:etc, 3:include, 4:libexec */
+#define FSWC_INC_MAX_SLASHES 4U          /* up to 5 components inside include/ */
+#define FSWC_SQUASHFS_MAGIC  0x73717368UL
+#define FSWC_ST_RDONLY       0x00000001UL
+#define FSWC_PKG_IMMUTABLE   0x00000001U
+#define FSWC_PKG_SQUASHFS    0x00000002U
+#define FSWC_HDR_WORLD_RX    0x00000001U
+#define FSWC_HDR_SEALED      0x00000002U
+#define FSWC_DE_IS_DIR       0x80000000U
+#define FSWC_DE_EXT_LNK      0x40000000U
+#define FSWC_DE_LEN_MASK     0x00ffffffU
+#define FSWC_HT_EXT_LNK      0x80000000U
+#define FSWC_HT_KEY_MASK     0x7fffffffU
+#define FSWC_STATX_MASK      (STATX_TYPE | STATX_MODE | STATX_INO \
+                              | STATX_MTIME | STATX_CTIME | STATX_MNT_ID_UNIQUE)
+
+static inline bool
+fswc_is_secure_mode (void)
+{
+#ifdef _LIBC
+  return __libc_enable_secure != 0;
+#else
+  return (FC_SYSCALL0 (geteuid) != FC_SYSCALL0 (getuid)
+          || FC_SYSCALL0 (getegid) != FC_SYSCALL0 (getgid));
+#endif
+}
