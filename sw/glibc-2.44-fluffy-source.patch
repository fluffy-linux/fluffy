+/* Expand wildcard element R into sorted existing concrete directory paths
+   (each ending with '/') stored in POOL_AR and indexed in REFS_AR.  */
+static void
+dl_expand_wildcard_elem_mmap (const struct r_search_path_elem *r,
+			      struct dl_mmap_arena *pool_ar,
+			      struct dl_mmap_arena *refs_ar,
+			      uint16_t *seen_slot_mask)
+{
+  const char *pat = r->dirname;
+  size_t parent_len = r->wild_parent_len;
+  size_t prefix_slash_len = r->wild_prefix_slash_len;
+  const char *suffix = pat + r->wild_suffix_off;
+  size_t suffix_len = r->dirnamelen - r->wild_suffix_off;
+
+  bool used_fswc = false;
+  uint16_t slot_idx = 0;
+  struct fswc_slot_snap *snap = NULL;
+  if (parent_len < PATH_MAX
+      && __fswc_acquire_slot_amortized (pat, parent_len, seen_slot_mask,
+					&slot_idx, &snap)
+      && snap != NULL
+      && (snap->snap_flags & FSWC_SNAP_NO_SQUASHFS) == 0
+      && (snap->snap_flags
+	  & (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+	 == (FSWC_SNAP_ANCESTORS_WORLD_SEARCH | FSWC_SNAP_PREFIX_WORLD_RX))
+    {
+      const char *relpath = suffix + 1;
+      size_t rel_len = suffix_len > 2 ? suffix_len - 2 : 0;
+      struct fswc_relpath_result rres;
+      if (__fswc_resolve_pkg_wild_relpath (snap, relpath, rel_len, &rres))
+	{
+	  used_fswc = true;
+	  const struct fswc_view *v = &snap->view;
+	  uint32_t pi = 0;
+	  uint32_t npkgs = v->hdr->num_pkgs;
+	  uint32_t mi = 0;
+	  uint32_t nmut = snap->num_mutable_dirs;
+
+	  while (pi < npkgs || mi < nmut)
+	    {
+	      bool take_pkg;
+	      if (pi < npkgs && mi < nmut)
+		{
+		  const struct fswc_pkg *pk = &v->pkgs[pi];
+		  const struct fswc_top_entry *me = &snap->mutable_dirs[mi];
+		  int cmp = dl_name_slice_cmp (v->strtab + pk->name_off,
+					       pk->name_len,
+					       snap->top_strtab + me->name_off,
+					       me->name_len);
+		  take_pkg = (cmp <= 0);
+		}
+	      else
+		take_pkg = (pi < npkgs);
+
+	      const char *cand_pkg;
+	      size_t cand_pkg_len;
+	      bool need_stat = true;
+
+	      if (take_pkg)
+		{
+		  const struct fswc_pkg *pk = &v->pkgs[pi];
+		  uint32_t cur_pi = pi++;
+		  cand_pkg = v->strtab + pk->name_off;
+		  cand_pkg_len = pk->name_len;
+		  if (cand_pkg_len == 0 || cand_pkg_len > NAME_MAX
+		      || cand_pkg[0] == '.')
+		    continue;
+		  bool immut = (pk->flags & FSWC_PKG_IMMUTABLE) != 0;
+		  bool pkg_search_ok
+		    = (pk->flags & FSWC_PKG_ALL_WORLD_SEARCH) != 0;
+		  if (rel_len == 0)
+		    need_stat = !immut;
+		  else if (!rres.restricted_search || pkg_search_ok)
+		    {
+		      int dt = (rres.leaf_ent != NULL)
+			       ? __fswc_posting_find_pkg (v,
+							  rres.leaf_ent->all_cnt,
+							  rres.leaf_ent->all_ref,
+							  cur_pi)
+			       : -1;
+		      bool interm_lnk = __fswc_pkg_in_lnk_steps (v, &rres,
+								 cur_pi);
+		      if (immut && !interm_lnk)
+			{
+			  if (dt == DT_DIR)
+			    need_stat = false;
+			  else if (dt != DT_LNK && dt != DT_UNKNOWN)
+			    continue;
+			}
+		    }
+		}
+	      else
+		{
+		  const struct fswc_top_entry *me = &snap->mutable_dirs[mi++];
+		  cand_pkg = snap->top_strtab + me->name_off;
+		  cand_pkg_len = me->name_len;
+		  if (cand_pkg_len == 0 || cand_pkg_len > NAME_MAX
+		      || cand_pkg[0] == '.')
+		    continue;
+		}
+
+	      size_t full_len = prefix_slash_len + cand_pkg_len + suffix_len;
+	      size_t prev_pool = pool_ar->used;
+	      char *p = dl_arena_alloc (pool_ar, full_len + 1, 1);
+	      if (p == NULL)
+		continue;
+	      memcpy (p, pat, prefix_slash_len);
+	      memcpy (p + prefix_slash_len, cand_pkg, cand_pkg_len);
+	      memcpy (p + prefix_slash_len + cand_pkg_len, suffix, suffix_len);
