+static bool
+fc_has_dot_component (const char *s)
+{
+  while (*s != '\0')
+    {
+      if (s[0] == '.'
+          && (s[1] == '\0' || s[1] == '/'
+              || (s[1] == '.' && (s[2] == '\0' || s[2] == '/'))))
+        return true;
+      const char *slash = strchr (s, '/');
+      if (slash == NULL)
+        break;
+      if (slash[1] == '/' || slash[1] == '\0')
+        return true;
+      s = slash + 1;
+    }
+  return false;
+}
