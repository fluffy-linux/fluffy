if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

HAS_LDFLAGS=-lmpdec

ARCHIVES=(
    96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8 https://github.com/fluffy-linux/mpdecimal/releases/download/$VERSION/mpdecimal-$VERSION.tar.gz
    4df23f48019a6e4bd9ec7ce7002df961897ad96e35379d7ffbb2fb7bdf9769c3 file://mpdecimal-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i mpdecimal-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make
}

CHECK() {
    make check_local
}

INSTALL() {
    make install
}
