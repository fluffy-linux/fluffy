if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

# Built straight from Fluffy's branch (our commits on upstream's 4.0.1
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    a72f1fab4cdf679e2f4bdf2e63128222b23f282d https://github.com/fluffy-linux/mpdecimal.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        sed
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        sed
        tar
        xz
    )
fi

MAKE() {

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make
}

CHECK() {
    make check_local
}

INSTALL() {
    make install
}
