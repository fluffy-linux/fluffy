if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

ARCHIVES=(
    96d33abb4bb0070c7be0fed4246cd38416188325f820468214471938545b1ac8 https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$VERSION.tar.gz
    db5318b18b7fdd3d10f9f70c1c5fda03ed86b5695fcd7207bc7f5f4a448d991e file://mpdecimal-$VERSION-fluffy.patch
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i mpdecimal-$VERSION-fluffy.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/mpdecimal \
        --disable-static \
        --docdir=/sw/mpdecimal/share/doc/mpdecimal-$VERSION
    make
}

CHECK() {
    make check_local
}

INSTALL() {
    make install
}
