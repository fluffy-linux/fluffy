if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=9.2.1025

# Built straight from Fluffy's branch (our commits on upstream's v9.2.1025
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    37e2c7c6acddb2d690cedbb7a468d0959bfc2cfe https://github.com/fluffy-linux/vim.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        ncurses
        sed
        tar
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        ncurses
        sed
        tar
    )
fi

MAKE() {

    echo '#define SYS_VIMRC_FILE "/sw/vim/etc/vimrc"' >> src/feature.h

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/vim \
        --with-tlib=ncurses
    make
}

INSTALL() {
    make install

    ln -sv vim $DESTDIR/sw/vim/bin/vi

    for L in $DESTDIR/sw/vim/share/man/{,*/}man1/vim.1; do
        ln -sv vim.1 $(dirname $L)/vi.1
    done

    mkdir -pv $DESTDIR/sw/vim/share/doc
    ln -sv ../vim/vim92/doc $DESTDIR/sw/vim/share/doc/vim-$VERSION

    mkdir -pv $DESTDIR/sw/vim/etc
    cat > $DESTDIR/sw/vim/etc/vimrc << "EOF"
" Begin /sw/vim/etc/vimrc

" Ensure defaults are set before customizing settings, not after
source $VIMRUNTIME/defaults.vim
let skip_defaults_vim=1

set nocompatible
set backspace=2
set mouse=
syntax on
if (&term == "xterm") || (&term == "vt100")
  set background=dark
endif

if filereadable('/etc/vimrc')
  source /etc/vimrc
endif

" End /sw/vim/etc/vimrc
EOF
}
