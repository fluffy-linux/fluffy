if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.14

ARCHIVES=(
    bc8d3c73535b8838d8c8e2654d73edc4e6ae8c8acdb45d5df5dc9a1547446d43 https://github.com/fluffy-linux/grub/releases/download/grub-$VERSION/grub-$VERSION.tar.xz
    6ab40604c289b8dedb1dec75eecfe3f985a0bef2ff11d06fdf18e8ff8a61fd89 file://grub-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    xz
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        python
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        python
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i grub-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure \
        --prefix=/sw/grub \
        --sysconfdir=/sw/grub/etc \
        --sbindir=/sw/grub/bin \
        --disable-efiemu \
        --disable-werror
    make
}

CHECK() {
    true
}

INSTALL() {
    make install
}
