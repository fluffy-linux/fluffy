if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.3

ARCHIVES=(
    51f74eb0f51cfa9873b85264dfdd5d46e8957ec95b88f0fb762f63d9e164c72e https://ftpmirror.gnu.org/texinfo/texinfo-$VERSION.tar.xz
    c7ec72c350fce9dc15527c8397fcf1cfb29292d47d7c7326773f9f7d777cf8cd file://texinfo-$VERSION-fluffy-shell.patch
    b385f43b509ceb6a506264794ff8670400ce2bade13aa67100996f20a6d37e7f file://texinfo-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    ncurses
    perl
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i texinfo-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i texinfo-$VERSION-fluffy-test.patch

    ./configure \
        --prefix=/sw/texinfo
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
