diff --no-dereference -Naur kbd-2.10.0/configure kbd-2.10.0/configure
--- kbd-2.10.0/configure	2026-05-25 07:17:15.399726452 +0000
+++ kbd-2.10.0/configure	2026-05-25 07:17:15.399726452 +0000
@@ -19640,9 +19640,9 @@
 
 case "$host_cpu" in #(
   i?86*) :
-    RESIZECONS_PROGS=yes ;; #(
+    RESIZECONS_PROGS=no ;; #(
   x86_64*) :
-    RESIZECONS_PROGS=yes ;; #(
+    RESIZECONS_PROGS=no ;; #(
   *) :
     RESIZECONS_PROGS=no
  ;; #(
@@ -19814,9 +19814,9 @@
 		PKG_CONFIG=""
 	fi
 fi
-if test -z "$PKG_CONFIG"; then
-	as_fn_error $? "pkg-config not found" "$LINENO" 5
-fi
+: "${LZMA_CFLAGS:=${XZ_CFLAGS:-}}"
+: "${LZMA_LIBS:=${XZ_LIBS:-}}"
+PKG_CONFIG="false" 
 
 { printf '%s\n' "$as_me:${as_lineno-$LINENO}: checking the configure options..." >&5
 printf '%s\n' "$as_me: checking the configure options..." >&6;}
