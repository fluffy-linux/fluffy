if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.0.5

# Built straight from Fluffy's branch (our commits on upstream's
# pkgconf-3.0.5 tag): swctl fetches the pinned commit with git.  Meson
# comes from git too: Fluffy's meson branch, placed as ../meson.tar.
ARCHIVES=(
    d5b08696a5ea4413a3f99431617c2ea6deb2314e https://github.com/fluffy-linux/pkgconf.git#refs/heads/fluffy/pkgconf-$VERSION
    cdafdf57bc3b0ddede7dcd2505e772a08b382bab https://github.com/fluffy-linux/meson.git#refs/heads/fluffy/1.12.0
)

NEEDS=(
    glibc
)

# As LFS, pkgconf is built with meson.py from meson's source, under the
# temporary python: the final python and util-linux use pkgconf, and ninja
# is built from python-pass1 and util-linux-pass1, so nothing loops.
if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gcc-pass2
        glibc
        libgcc
        linux-headers
        ninja
        python-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gcc
        glibc
        libgcc
        linux-headers
        ninja
        python-pass1
        sed
        tar
    )
fi

MAKE() {
    tar -xf ../meson.tar

    mkdir build
    cd build
    python3 ../meson/meson.py setup \
        --prefix=/sw/pkgconf \
        --libdir=/sw/pkgconf/lib \
        --buildtype=release \
        -Dwith-pkg-config-dir='/sw/*/lib/pkgconfig:/sw/*/share/pkgconfig' \
        -Dwith-system-libdir='/sw/*/lib' \
        -Dwith-system-includedir='/sw/*/include' \
        ..
    ninja
}

CHECK() {
    ninja -C build test
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install
    ln -sv pkgconf $DESTDIR/sw/pkgconf/bin/pkg-config
    ln -sv pkgconf.1 $DESTDIR/sw/pkgconf/share/man/man1/pkg-config.1
}
