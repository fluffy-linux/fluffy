if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.5.8

ARCHIVES=(
    1b1203ca152ccd63983c3f2112f7fe6fa5afd453218ede5153d1b31e11bb8405 https://github.com/fluffy-linux/libpipeline/releases/download/$VERSION/libpipeline-$VERSION.tar.gz
)

HAS_LDFLAGS="-lpipeline"

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure \
        --prefix=/sw/libpipeline
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
