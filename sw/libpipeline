if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.5.8

# Built straight from Fluffy's branch (our commits on upstream's 1.5.8
# tag): swctl fetches the pinned commit, and the gnulib commit it pins,
# with git.  The tag has no configure, Makefile.in or gnulib files, so
# MAKE bootstraps it with the autoconf, automake and libtool the release
# tarball was made with (2.72, 1.16.5, 2.4.7), from their Fluffy
# branches.
ARCHIVES=(
    ba241d28516a85eff8abf80d1b891d3e2eaacebc https://github.com/fluffy-linux/libpipeline.git#refs/heads/fluffy/$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        # pkg.m4, for PKG_CHECK_MODULES in the configure bootstrap makes.
        pkgconf
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        # pkg.m4, for PKG_CHECK_MODULES in the configure bootstrap makes.
        pkgconf
        sed
        tar
    )
fi

# Bootstrapped with the autotools libpipeline's release tarball was made
# with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    $CONFIG_SHELL ./configure \
        --prefix=/sw/libpipeline
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
