ON=host-build

VERSION=4.0.1

ARCHIVES=(
    2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09 https://github.com/openssl/openssl/releases/download/openssl-$VERSION/openssl-$VERSION.tar.gz
    abf82586f823b212db5b5bd21c67ae08cb6482bdb5f1c347b346f5288507c2c1 file://openssl-$VERSION-fluffy-shell.patch
    fcba612593e5ca9c40129ce372de8f45d176cf0c5aa26a27188f7e91da144f46 file://openssl-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    linux-headers
    make-pass1
    patch-pass1
)

MAKE() {
    patch -Z -Np1 -i openssl-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-source.patch
    ./Configure linux-x86_64 \
        --prefix=/sw/openssl \
        --openssldir='/sw/*/etc/ssl' \
        --libdir=lib \
        shared \
        no-tests \
        no-static-engine \
        CC="$FLUFFY_TGT-gcc"
    make
}

INSTALL() {
    make install_sw
    rm -v $DESTDIR/sw/openssl/lib/lib*.a 2>/dev/null || true
}
