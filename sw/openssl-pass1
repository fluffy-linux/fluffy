ON=host-build

VERSION=4.0.1

ARCHIVES=(
    ac9e41bcf242c6f862337c5cb88d6cc5eb9c9f1a https://github.com/fluffy-linux/openssl.git#refs/heads/fluffy/openssl-$VERSION
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
    make-pass1
)

MAKE() {
    perl ./Configure linux-x86_64 \
        --prefix=/sw/openssl \
        --openssldir='/sw/*/etc/ssl' \
        --libdir=lib \
        shared \
        no-tests \
        no-static-engine \
        CC="$FLUFFY_TGT-gcc"
    make
}

INSTALL() {
    make install_sw
    rm -v $DESTDIR/sw/openssl/lib/lib*.a 2>/dev/null || true
}
