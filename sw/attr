if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.6.0

HAS_LDFLAGS=-lattr

ARCHIVES=(
    d42fa374513180bb48cb11a46696f488240e5124ff1e6ad88b0abff706985612 https://download.savannah.gnu.org/releases/attr/attr-$VERSION.tar.gz
    4fe15575f01abb0491890e93899695bbb398a34e7c00590398362e571d667f14 file://attr-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i attr-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/attr \
        --disable-static \
        --sysconfdir=/sw/attr/etc \
        --docdir=/sw/attr/share/doc/attr-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/attr/lib/libattr.la
}
