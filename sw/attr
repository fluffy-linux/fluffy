if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.6.0

ARCHIVES=(
    d42fa374513180bb48cb11a46696f488240e5124ff1e6ad88b0abff706985612 https://download.savannah.gnu.org/releases/attr/attr-$VERSION.tar.gz
    b0a3eaaa98754244076f5fa821b5749de1041a743d0f7fb16f60c1142c988540 file://attr-$VERSION-fluffy-shell.patch
    3dcb5bf880e30c2d40ecb4bad26651f37e5b91ad334667acd25bc4d1027c89bd file://attr-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i attr-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i attr-$VERSION-fluffy-test.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/attr \
        --disable-static \
        --sysconfdir=/sw/attr/etc \
        --docdir=/sw/attr/share/doc/attr-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/attr/lib/libattr.la
}
