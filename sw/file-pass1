ON=host-build

VERSION=5.48

# Built straight from Fluffy's branch (upstream's FILE5_48 tag): swctl
# fetches the pinned commit with git.  The tag has no configure or
# Makefile.in, so MAKE regenerates them with the autoconf, automake and
# libtool the release tarball was made with (2.72, 1.18, 2.4.7), from
# their Fluffy branches.
ARCHIVES=(
    eb754ace19fed5481d8142426543100a2d6bae4e https://github.com/fluffy-linux/file.git#refs/heads/fluffy/FILE${VERSION//./_}
    770e5e68703124021d82b15817a2d50718f83676 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    f07c865d9d7f5f4f595cfa8626e58440695d0f1e https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

# Regenerated with the autotools file's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    mkdir build
    pushd build
        CONFIG_SITE=/sw/glibc/share/config.site ../configure \
            --disable-bzlib \
            --disable-libseccomp \
            --disable-xzlib \
            --disable-zlib
        make
    popd
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/file \
        --host=$FLUFFY_TGT \
        --build=$(./config.guess)
    make FILE_COMPILE=$(pwd)/build/src/file
}

INSTALL() {
    make install
    rm -v $DESTDIR/sw/file/lib/libmagic.la
}
