if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.25

ARCHIVES=(
    1cb83e4f702e60b8211ab5ec4c2afbab1b1dec80209456a7d2faf7584ed225ea https://github.com/fluffy-linux/which/releases/download/v$VERSION/which-$VERSION.tar.gz
    c001e76ac9740d5b03bf5d6aff178595ef10dd593aa4dba89790637c01baa2c3 file://which-$VERSION-fluffy-source.patch
    cc504bfcfd8b0afd02fd8e609c738c318f7b862e14c2d39de2e1e6b2153f660e file://which-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i ../which-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ../which-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/which
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/which/share/info/dir
}
