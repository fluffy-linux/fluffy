if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.10

# Built straight from Fluffy's branch (our commits on upstream's v4.10
# tag): swctl fetches the pinned commit, and the gnulib and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it, and its
# translations come from the Translation Project's files, merged as the
# release's make dist did.
ARCHIVES=(
    1041359ee65f5160841dae26e0b781a111027df6 https://github.com/fluffy-linux/sed.git#refs/heads/fluffy/v$VERSION
    b3d3778291f117f8420d4871f32b4d7c4caf23d1 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.73.1-b400b
    1a3ba678aa6cb7796a3438b3e1df02bc39d91a81 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1.91
)

NEEDS=(
    acl
    attr
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        texinfo
        xz
    )
fi

# Bootstrapped with the autotools sed's release tarball was made with:
# development snapshots of autoconf and automake.  gettext gives
# bootstrap autopoint, and the build xgettext, msgmerge and msgfmt.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/sed \
        --docdir=/sw/sed/share/doc/sed-$VERSION
    # The translations as make dist merges them with sed.pot.
    make -C po update-po
    make
    make html
}

CHECK() {
    make SUBDIRS=. check
    make -C gnulib-tests 'LOG_COMPILER=bash -c '\''case "$$0" in *.sh) exec bash "$$0" "$$@";; *) exec "$$0" "$$@";; esac'\''' check
}

INSTALL() {
    make install
    install -d -m755 $DESTDIR/sw/sed/share/doc/sed-$VERSION
    install -m644 doc/sed.html $DESTDIR/sw/sed/share/doc/sed-$VERSION
}
