diff --no-dereference -Naur tcl8.6.18/tests/exec.test tcl8.6.18.test/tests/exec.test
--- tcl8.6.18/tests/exec.test	2026-05-07 17:12:36.000000000 +0000
+++ tcl8.6.18.test/tests/exec.test	2026-05-07 17:12:36.000000000 +0000
@@ -687,13 +687,14 @@
 } -body {
     # Note that we have to allow for the current contents of the temporary
     # file, which is why the result is 14 and not 12
-    exec /bin/sh -c \
+    set shCmd [expr {[file executable /sw/bash/bin/bash] ? "/sw/bash/bin/bash" : "/bin/sh"}]
+    exec $shCmd -c \
 	    {for a in 1 2 3; do sleep 1; echo $a; done} >>$tmpfile &
-    exec /bin/sh -c \
+    exec $shCmd -c \
 	    {for a in 4 5 6; do sleep 1; echo $a >&2; done} 2>>$tmpfile &
-    exec /bin/sh -c \
+    exec $shCmd -c \
 	    {for a in a b c; do sleep 1; echo $a; done} >>$tmpfile &
-    exec /bin/sh -c \
+    exec $shCmd -c \
 	    {for a in d e f; do sleep 1; echo $a >&2; done} 2>>$tmpfile &
     # The above four shell invocations take about 3 seconds to finish, so allow
     # 5s (in case the machine is busy)
@@ -703,6 +704,7 @@
     # file descriptor in the [exec >>...]
     file size $tmpfile
 } -cleanup {
+    unset -nocomplain shCmd
     removeFile $tmpfile
 } -result 26
 
