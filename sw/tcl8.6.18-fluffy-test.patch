+test unixFile-1.14 {multi-component glob with ~ subdirectory does not escape to HOME} -constraints {unix} -setup {
+    set tdir [file join [temporaryDirectory] tilde_escape]
+    set fakeHome [file join [temporaryDirectory] fake_home]
+    file mkdir "$tdir/~" "$tdir/a/~" $fakeHome
+    close [open "$tdir/~/local_only" w]
+    close [open "$tdir/a/~/deep_only" w]
+    close [open [file join $fakeHome victim] w]
+    set savedHome [expr {[info exists ::env(HOME)] ? $::env(HOME) : ""}]
+    set hadHome [info exists ::env(HOME)]
+    set ::env(HOME) $fakeHome
+} -body {
+    set g1 [lsort [glob -nocomplain -directory $tdir */*]]
+    set g2 [lsort [glob -nocomplain -directory $tdir */*/*]]
+    set g3 [lsort [glob -nocomplain -tails -directory $tdir */*]]
+    set f1 [lindex $g1 1]
+    set f2 [lindex $g2 0]
+    list [file normalize $f1] [file exists $f1] [file normalize $f2] [file exists $f2] $g3 [file exists [file join $fakeHome victim]]
+} -cleanup {
+    if {$hadHome} {
+        set ::env(HOME) $savedHome
+    } else {
+        unset -nocomplain ::env(HOME)
+    }
+    file delete -force $tdir $fakeHome
+} -result [list "[file normalize [file join [temporaryDirectory] tilde_escape]]/~/local_only" 1 "[file normalize [file join [temporaryDirectory] tilde_escape]]/a/~/deep_only" 1 {a/~ ~/local_only} 1]
+test unixFile-1.15 {auto_execok: colon always splits PATH, brackets are literal} -constraints {unix} -setup {
