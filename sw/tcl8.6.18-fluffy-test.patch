+} -cleanup {
+    file delete -force $braceDir
+} -result {{1 {unmatched open-brace in file name}} {1 {unmatched close-brace in file name}} {alpha.txt beta.txt}}
+test unixFile-1.12 {testReportingFilesystem intercepts brace multi-glob} -constraints {unix testfilesystem} -setup {
