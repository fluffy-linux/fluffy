diff --no-dereference -Naur tcl8.6.18.orig/tests/unixFile.test tcl8.6.18/tests/unixFile.test
--- tcl8.6.18.orig/tests/unixFile.test	2026-04-17 18:51:37.000000000 +0000
+++ tcl8.6.18/tests/unixFile.test	2026-04-17 18:51:37.000000000 +0000
@@ -56,6 +56,32 @@
     set env(PATH) ":/dummy"
     testfindexecutable junk
 } $absPath
+test unixFile-1.8 {Tcl_FindExecutable wildcard PATH} -constraints {testfindexecutable unix} -setup {
+    file mkdir pkg_b/bin pkg_a/bin
+    file attributes [makeFile "" pkg_b/bin/wjunk] -perm 0o777
+    file attributes [makeFile "" pkg_a/bin/wjunk] -perm 0o777
+} -body {
+    set env(PATH) "/dummy:[pwd]/pkg_*/bin"
+    testfindexecutable wjunk
+} -cleanup {
+    removeFile pkg_a/bin/wjunk
+    removeFile pkg_b/bin/wjunk
+    file delete -force pkg_a pkg_b
+} -result [file join [temporaryDirectory] pkg_a bin wjunk]
+test unixFile-1.9 {auto_execok wildcard PATH} -constraints {unix} -setup {
+    auto_reset
+    file mkdir pkg_b/bin pkg_a/bin
+    file attributes [makeFile "" pkg_b/bin/wjunk2] -perm 0o777
+    file attributes [makeFile "" pkg_a/bin/wjunk2] -perm 0o777
+} -body {
+    set env(PATH) "/dummy:[pwd]/pkg_*/bin"
+    auto_execok wjunk2
+} -cleanup {
+    auto_reset
+    removeFile pkg_a/bin/wjunk2
+    removeFile pkg_b/bin/wjunk2
+    file delete -force pkg_a pkg_b
+} -result [list [file join [temporaryDirectory] pkg_a bin wjunk2]]
 
 # cleanup
 catch {set env(PATH) $oldPath}
