diff --no-dereference -Naur tcl8.6.18.orig/tests/chanio.test tcl8.6.18/tests/chanio.test
--- tcl8.6.18.orig/tests/chanio.test	2026-04-17 18:51:37.000000000 +0000
+++ tcl8.6.18/tests/chanio.test	2026-04-17 18:51:37.000000000 +0000
@@ -56,7 +56,7 @@
     # some tests can only be run is umask is 2 if "umask" cannot be run, the
     # tests will be skipped.
     set umaskValue 0
-    testConstraint umask [expr {![catch {set umaskValue [scan [exec /bin/sh -c umask] %o]}]}]
+    testConstraint umask [expr {![catch {set umaskValue [scan [exec /sw/bash/bin/bash -c umask] %o]}]}]
 
