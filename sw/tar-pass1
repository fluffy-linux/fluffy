ON=host-build

VERSION=1.35

# Built straight from Fluffy's branch, as tar is: the host's autotools
# build the ones tar's release tarball was made with, and bootstrap runs
# the host's autopoint.  The branch's xexec fix matters here: tar runs
# compressors (gzip, xz, ...) through /bin/sh -c, which Fluffy doesn't
# have, so without it tar-pass1 can't create or extract a compressed
# archive inside the root (binutils' gprofng builds its examples.tar.gz
# at install).
ARCHIVES=(
    027b8bbc8df681b3a30c7fe93a6c027794767e6e https://github.com/fluffy-linux/tar.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/tar \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    # The translations as make dist merges them with tar.pot.
    make -C po update-po
    make
}

INSTALL() {
    make install
}
