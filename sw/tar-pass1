ON=host-build

VERSION=1.35

ARCHIVES=(
    4d62ff37342ec7aed748535323930c7cf94acf71c3591882b26a7ea50f3edc16 https://github.com/fluffy-linux/tar/releases/download/v$VERSION/tar-$VERSION.tar.xz
    754d6eda1c3e8b407d858249ae58e8fdba1def25131dc2f81a93ed10cb1594b3 file://tar-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    # tar runs compressors (gzip, xz, ...) through /bin/sh -c, which Fluffy
    # doesn't have: without this, tar-pass1 can't create or extract a
    # compressed archive inside the root (binutils' gprofng builds its
    # examples.tar.gz at install).  The same source patch as sw/tar.
    patch -Z -Np1 -i ../tar-$VERSION-fluffy-source.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/tar \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
