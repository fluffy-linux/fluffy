if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.70.0

# Built straight from Fluffy's branch (our commits on upstream's v1.70.0
# tag): swctl fetches the pinned commit and its submodules with git.  The
# tag has no configure or Makefile.in, so MAKE regenerates them.
ARCHIVES=(
    2acae710caba057c9992fbd4a119b921d84e41c5 https://github.com/fluffy-linux/nghttp2.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make-pass1
        perl
        pkgconf
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        perl
        pkgconf
        sed
        tar
    )
fi

# Regenerated with the autotools nghttp2's release tarball was made with.
source sw/autoconf-2.71.common
source sw/automake-1.16.5.common
source sw/libtool-2.4.7.common

# As BLFS 13.1-systemd builds it: the library only.
MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/nghttp2 \
        --disable-static \
        --enable-lib-only \
        --docdir=/sw/nghttp2/share/doc/nghttp2-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    find $DESTDIR/sw/nghttp2/lib -name '*.la' -delete
}
