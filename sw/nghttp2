if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.70.0

# Built straight from Fluffy's branch (our commits on upstream's v1.70.0
# tag): swctl fetches the pinned commit and its submodules with git.  The
# tag has no configure or Makefile.in, so MAKE regenerates them with the
# autoconf, automake and libtool the release tarball was made with (2.71,
# 1.16.5, 2.4.7), from their Fluffy branches.
ARCHIVES=(
    2acae710caba057c9992fbd4a119b921d84e41c5 https://github.com/fluffy-linux/nghttp2.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make-pass1
        perl
        pkgconf
        sed
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        perl
        pkgconf
        sed
    )
fi

# Regenerated with the autotools nghttp2's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

# As BLFS 13.1-systemd builds it: the library only.
MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/nghttp2 \
        --disable-static \
        --enable-lib-only \
        --docdir=/sw/nghttp2/share/doc/nghttp2-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    find $DESTDIR/sw/nghttp2/lib -name '*.la' -delete
}
