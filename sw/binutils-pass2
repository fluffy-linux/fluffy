ON=host-build

VERSION=2.47

ARCHIVES=(
    fb2a0f2fb12b6e89a2ef4ef380c5530c5a4d91a59f7561734b1e8a5c7e90a015 https://ftpmirror.gnu.org/binutils/binutils-$VERSION.tar.xz
    d55d43d32b92023ad42327040481f0f37e7ab99b86a98a6d68c68a553460824d file://binutils-$VERSION-fluffy-shell.patch
    6690a172945cba4e886738bb16a66acf115d88d044212a3ae9f4b42454f33d4d file://binutils-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

MAKE_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i binutils-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i binutils-$VERSION-fluffy-source.patch
    sed '6031s/$add_dir//' -i ltmain.sh

    mkdir -v build
    cd build
    ../configure \
        --prefix=/sw/binutils \
        --with-lib-path='/sw/*/lib' \
        --build=$(../config.guess) \
        --host=$FLUFFY_TGT \
        --disable-nls \
        --enable-shared \
        --enable-gprofng=no \
        --disable-werror \
        --enable-64-bit-bfd \
        --enable-new-dtags \
        --enable-default-hash-style=gnu
    make
}

INSTALL_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

INSTALL() {
    cd build
    make install
    rm -v $DESTDIR/sw/binutils/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.{a,la}
}
