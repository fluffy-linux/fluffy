ON=host-build

VERSION=2.47

ARCHIVES=(
    154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff https://ftpmirror.gnu.org/binutils/binutils-$VERSION.tar.xz
    4602feb91bec5a8053b8683a5032a835d35940f0d1e3aa17a28c6db42adfbd9a file://binutils-$VERSION-fluffy-shell.patch
    b336826eebce46174f9237c3d5c1acef3ed00a74de8431cc97c9eb6b95d4977b file://binutils-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i binutils-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i binutils-$VERSION-fluffy-source.patch
    sed '6031s/$add_dir//' -i ltmain.sh

    mkdir -v build
    cd build
    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/binutils \
        --with-lib-path='/sw/*/lib' \
        --build=$(../config.guess) \
        --host=$FLUFFY_TGT \
        --disable-nls \
        --enable-shared \
        --enable-gprofng=no \
        --disable-werror \
        --enable-64-bit-bfd \
        --enable-new-dtags \
        --enable-default-hash-style=gnu
    CONFIG_SITE=/sw/glibc/share/config.site make
}

INSTALL() {
    cd build
    make install
    rm -v $DESTDIR/sw/binutils/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.{a,la}
}
