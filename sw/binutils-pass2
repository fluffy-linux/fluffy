ON=host-build

VERSION=2.47

# Built straight from Fluffy's branch (our commits on upstream's
# binutils-2_47 tag): swctl fetches the pinned commit with git.  What the
# release tarball ships prebuilt (the bison and flex parsers, the info
# and man pages, the message catalogs) the build makes.
ARCHIVES=(
    75f0ca41735d89fe7bda30cc6dd2317e18457922 https://github.com/fluffy-linux/binutils-gdb.git#refs/heads/fluffy/binutils-${VERSION//./_}
    4c82238e58956b9a72bd94460534a0faa3d388bc9ea1c3a46479b8dd65bb7856 file://binutils-$VERSION-pass2-ltmain.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    # LFS's edit to libtool for pass 2 only (its chapter 6 sed, as a
    # context patch): see the patch's header.
    patch -Z -Np1 -i ../binutils-$VERSION-pass2-ltmain.patch

    # The repository also holds gdb, gdbserver, the simulators and the
    # libraries only they use, which the release leaves out: the last
    # configure options leave them out of the build too.
    #
    # Not LFS's: --enable-deterministic-archives makes ar's D the default,
    # so static libraries record uid, gid and mtime 0, not the builder's
    # (glibc's .a files differed only in that between CI and a local build).
    mkdir -v build
    cd build
    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/binutils \
        --with-lib-path='=/sw/*/lib' \
        --build=$(../config.guess) \
        --host=$FLUFFY_TGT \
        --disable-nls \
        --enable-shared \
        --enable-gprofng=no \
        --disable-werror \
        --enable-deterministic-archives \
        --enable-64-bit-bfd \
        --enable-new-dtags \
        --enable-default-hash-style=gnu \
        --disable-gdb \
        --disable-gdbserver \
        --disable-sim \
        --disable-readline \
        --disable-libdecnumber \
        --disable-libbacktrace
    CONFIG_SITE=/sw/glibc/share/config.site make
}

INSTALL() {
    cd build
    make install
    rm -v $DESTDIR/sw/binutils/lib/lib{bfd,ctf,ctf-nobfd,opcodes,sframe}.{a,la}
}
