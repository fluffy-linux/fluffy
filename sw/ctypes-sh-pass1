ON=host-build

VERSION=1.3

ARCHIVES=(
    ab032a845d8e579e39159f9bb8e68214892b2d927e6c70834230c88145892165 https://github.com/fluffy-linux/ctypes.sh/releases/download/v$VERSION/ctypes-sh-$VERSION.tar.gz
)

NEEDS=(
    bash-pass1
    glibc-pass1
    libffi-pass1
)

BUILD_NEEDS=(
    bash-pass1
    gcc-pass1
    glibc-pass1
    libffi-pass1
    linux-headers
)

MAKE() {
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/ctypes-sh \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    make
}

INSTALL() {
    make install
    rm -v $DESTDIR/sw/ctypes-sh/lib/ctypes.la
}
