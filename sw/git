# As BLFS 13.1-systemd builds it.  git's tag has no configure (only its
# release tarball does), so BLFS's configure options become the Makefile
# variables they set:
# --with-gitconfig=/etc/gitconfig is ETC_GITCONFIG, --with-python=python3
# PYTHON_PATH, --with-libpcre2 USE_LIBPCRE2.  NO_RUST as BLFS says when
# rustc is not installed.  perllibdir is perl's site_perl under /sw/git,
# which perl searches through its /sw/*/lib/perl5/<ver>/site_perl dirs.
MAKE() {
    cat > config.mak << END
prefix = /sw/git
perllibdir = /sw/git/lib/perl5/5.44/site_perl
ETC_GITCONFIG = /etc/gitconfig
SHELL_PATH = /sw/bash/bin/bash
PERL_PATH = /sw/perl/bin/perl
PYTHON_PATH = /sw/python/bin/python3
CC = gcc
CFLAGS = -O2 $(pkg-config --cflags zlib libcurl libpcre2-8 expat openssl)
LDFLAGS = $(pkg-config --libs-only-L zlib libcurl libpcre2-8 expat openssl)
CURL_LDFLAGS = $(pkg-config --libs libcurl)
USE_LIBPCRE2 = 1
NO_RUST = 1
END
    make
}

# No controlling terminal: some tests check that git fails rather than
# prompts, and with one git would ask on /dev/tty and wait.
CHECK() {
    GIT_UNZIP=nonexist setsid -w make test -k
}

INSTALL() {
    make install
}
