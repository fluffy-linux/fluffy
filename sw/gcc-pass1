ON=host-build

VERSION=16.2.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.4.1
GMP_VERSION=6.3.0
GLIBC_VERSION=2.44

# Upstream's releases/gcc-16.2.0 tag, as our fork has it: swctl fetches
# the pinned tag with git.  What the release tarball ships
# prebuilt that this build uses (gengtype's flex scanner) the build
# makes.
ARCHIVES=(
    1831ac03fd08e3400c16b29f21762e6b326a618d https://github.com/fluffy-linux/gcc.git#refs/tags/releases/gcc-$VERSION
    b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01 https://github.com/fluffy-linux/mpfr/releases/download/$MPFR_VERSION/mpfr-$MPFR_VERSION.tar.xz
    91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931 https://github.com/fluffy-linux/mpc/releases/download/$MPC_VERSION/mpc-$MPC_VERSION.tar.xz
    a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 https://github.com/fluffy-linux/gmp/releases/download/gmp-$GMP_VERSION/gmp-$GMP_VERSION.tar.xz
    d21dab1464de8eed7ffea38261c0cb30876160106de19d4c4a6c58cdb5836884 file://gcc-$VERSION-pass1-lib64.patch
    ed1f9d742cc0e8646c2d6ae6b6d79003d75576022831d34cd45fc9a9fa3167b1 file://gcc-$VERSION-pass1-linux64.patch
)

NEEDS=(
    binutils-pass1
)

BUILD_NEEDS=(
    binutils-pass1
)

# Stock gcc: this cross compiler runs only on the build host, against the
# host's C library, so it gets none of Fluffy's gcc commits.  Where the
# other gccs search /sw/*, it is given the absolute paths of the packages
# the cross passes use: glibc, linux-headers, binutils and libstdcpp.
MAKE() {
    tar -xf ../mpfr-$MPFR_VERSION.tar.xz
    mv -v mpfr-$MPFR_VERSION mpfr
    tar -xf ../mpc-$MPC_VERSION.tar.xz
    mv -v mpc-$MPC_VERSION mpc
    tar -xf ../gmp-$GMP_VERSION.tar.xz
    mv -v gmp-$GMP_VERSION gmp

    # LFS's lib64 edit and the pass's own loader and startfile paths, as
    # patches, not commits: this pass builds the bare tag (see the
    # patches' headers).
    patch -Z -Np1 -i ../gcc-$VERSION-pass1-lib64.patch
    patch -Z -Np1 -i ../gcc-$VERSION-pass1-linux64.patch

    mkdir -v build
    cd build
    ../configure \
        --target=$FLUFFY_TGT \
        --prefix=/sw/gcc \
        --with-glibc-version=$GLIBC_VERSION \
        --with-newlib \
        --without-headers \
        --with-as=/sw/binutils/bin/$FLUFFY_TGT-as \
        --with-ld=/sw/binutils/bin/$FLUFFY_TGT-ld \
        --with-gxx-include-dir=/sw/libstdcpp/include/c++ \
        --enable-default-pie \
        --enable-default-ssp \
        --disable-fixincludes \
        --disable-nls \
        --disable-shared \
        --disable-multilib \
        --disable-threads \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libssp \
        --disable-libvtv \
        --disable-libstdcxx \
        --enable-languages=c,c++
    make
}

INSTALL() {
    cd build
    make install
    # make install runs install-info for gcc's manuals at once (each is its
    # own make target), and their writes to share/info/dir race: builds of
    # the same recipe kept different sets of entries.  So the dir file is
    # written again from scratch by gcc's info install alone, run serially.
    # (Not the top-level install-info: it would also install the in-tree
    # gmp's, mpfr's and mpc's manuals, which make install leaves out.)
    rm -f $DESTDIR/sw/gcc/share/info/dir
    make -C gcc -j1 install-info
    local inc_dir="$($FLUFFY_TGT-gcc -print-file-name=include)"
    cat ../gcc/{limitx,glimits,limity}.h > "${DESTDIR}${inc_dir#$DESTDIR}/limits.h"

    # A stock cross compiler without a sysroot searches no system header
    # directory, so add glibc's and the kernel's after gcc's own.  A specs
    # file there replaces the built-in specs (and with them the linker's
    # --eh-frame-hdr, which unwinding needs), so it is the complete
    # -dumpspecs output with only *cpp extended.
    # Written aside first: gcc would read a half-written specs file.
    local specs="${DESTDIR}${inc_dir#$DESTDIR}/../specs"
    $FLUFFY_TGT-gcc -dumpspecs |
        sed '/^\*cpp:$/{n;s|$| %{!nostdinc:-idirafter /sw/glibc/include -idirafter /sw/linux-headers/include}|}' \
        > "$specs.new"
    grep -q -- '--eh-frame-hdr' "$specs.new"
    mv "$specs.new" "$specs"
}
