ON=host-build

VERSION=16.2.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.4.1
GMP_VERSION=6.3.0
GLIBC_VERSION=2.44

ARCHIVES=(
    e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e https://ftpmirror.gnu.org/gcc/gcc-$VERSION/gcc-$VERSION.tar.xz
    b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01 https://ftpmirror.gnu.org/mpfr/mpfr-$MPFR_VERSION.tar.xz
    91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931 https://ftpmirror.gnu.org/mpc/mpc-$MPC_VERSION.tar.xz
    a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 https://ftpmirror.gnu.org/gmp/gmp-$GMP_VERSION.tar.xz
    14f783de32e23716a14dcb197edae9e130c9b8605374293bec921ad972ca3c78 file://gcc-$VERSION-fluffy-shell.patch
    fe609085e63f315b9550b5c914674dfdbc460b8d06c5ef88b7573ba57e03e3de file://gcc-$VERSION-fluffy-source.patch
)

NEEDS=(
    binutils-pass1
)

MAKE_NEEDS=(
    binutils-pass1
)

MAKE() {
    patch -Z -Np1 -i gcc-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i gcc-$VERSION-fluffy-source.patch

    mv -v mpfr-$MPFR_VERSION mpfr
    mv -v mpc-$MPC_VERSION mpc
    mv -v gmp-$GMP_VERSION gmp

    mkdir -v build
    cd build
    ../configure \
        --target=$FLUFFY_TGT \
        --prefix=/sw/gcc \
        --with-glibc-version=$GLIBC_VERSION \
        --with-newlib \
        --without-headers \
        --enable-default-pie \
        --enable-default-ssp \
        --disable-fixincludes \
        --disable-nls \
        --disable-shared \
        --disable-multilib \
        --disable-threads \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libssp \
        --disable-libvtv \
        --disable-libstdcxx \
        --enable-languages=c,c++
    make
}

INSTALL_NEEDS=(
    binutils-pass1
)

INSTALL() {
    cd build
    make install
    local inc_dir="$($FLUFFY_TGT-gcc -print-file-name=include)"
    cat ../gcc/{limitx,glimits,limity}.h > "${DESTDIR}${inc_dir#$DESTDIR}/limits.h"
}
