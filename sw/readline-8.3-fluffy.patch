Date: Wed, 18 Nov 2026 07:59:41 -0500
Subject: [PATCH 5/7] rlconf.h: let the build set SYS_INPUTRC

Only define SYS_INPUTRC to /etc/inputrc when the build has not already
defined it, so that Fluffy's recipe can pass
-DSYS_INPUTRC='"/sw/*/etc/inputrc:/etc/inputrc"' and keep the /sw
convention out of the source.
---
 rlconf.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rlconf.h b/rlconf.h
index e0fd735..48a7b83 100644
--- a/rlconf.h
+++ b/rlconf.h
@@ -43,7 +43,9 @@
 #define DEFAULT_INPUTRC "~/.inputrc"
 
 /* The ultimate last-ditch filename for an init file -- system-wide. */
+#if !defined (SYS_INPUTRC)
 #define SYS_INPUTRC "/etc/inputrc"
+#endif
 
 /* If defined, expand tabs to spaces. */
 #define DISPLAY_TABS

From 09187476a894f5d2d04eb487be10e2b2eed0ace4 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:59:41 -0500
Subject: [PATCH 6/7] Read init files from search lists

Let an init file name (INPUTRC, rl_read_init_file, $include, and
SYS_INPUTRC) be a ':'-separated search list whose elements may contain
a whole '*' component, expanded with glob (GLOB_PATHS): every file it
names is read, in order, so later ones override earlier ones.  Fluffy
uses "/sw/*/etc/inputrc:/etc/inputrc": each package's settings, then
the administrator's.

A name without '*' is first opened as it is, so a file whose name
contains ':' still works; only if that fails with ENOENT and the name
has a ':' is it taken as a list.  Directories (an empty element is ".")
are skipped.  GLOB_PATHS lists have no tilde syntax of their own, so a
leading '~' in each element is expanded first
(_rl_tilde_expand_list); readline's tilde_expand would not do it, since
by default it expands only after a space or a tab.

The single-file reader becomes _rl_read_init_file_single, which records
the file as last_readline_init_file only when reading one file, not a
list's members.
---
 bind.c | 109 +++++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 107 insertions(+), 2 deletions(-)

diff --git a/bind.c b/bind.c
index 6aaa637..32ac4c4 100644
--- a/bind.c
+++ b/bind.c
@@ -53,6 +53,10 @@ extern int errno;
 #endif /* !errno */
 
 #include "posixstat.h"
+#include <glob.h>
+#ifndef GLOB_PATHS
+#  define GLOB_PATHS (1 << 29)
+#endif
 
 /* System-specific feature definitions and include files. */
 #include "rldefs.h"
@@ -1064,7 +1068,7 @@ rl_read_init_file (const char *filename)
 }
 
 static int
-_rl_read_init_file (const char *filename, int include_level)
+_rl_read_init_file_single (const char *filename, int update_last, int include_level)
 {
   register int i;
   char *buffer, *openname, *line, *end;
@@ -1081,7 +1085,7 @@ _rl_read_init_file (const char *filename, int include_level)
   if (buffer == 0)
     return (errno);
   
-  if (include_level == 0 && filename != last_readline_init_file)
+  if (update_last && include_level == 0 && filename != last_readline_init_file)
     {
       FREE (last_readline_init_file);
       last_readline_init_file = savestring (filename);
@@ -1129,6 +1133,107 @@ _rl_read_init_file (const char *filename, int include_level)
   return (0);
 }
 
+/* Return a copy of LIST with a leading ~ expanded in each ':'-separated
+   element; GLOB_PATHS search lists have no tilde syntax of their own.  */
+static char *
+_rl_tilde_expand_list (const char *list)
+{
+  char *result = 0;
+  size_t len = 0;
+  const char *p = list;
+
+  for (;;)
+    {
+      const char *end = strchr (p, ':');
+      size_t n = end ? (size_t)(end - p) : strlen (p);
+      char *elem = (char *)xmalloc (n + 1);
+      char *exp;
+      size_t elen;
+
+      memcpy (elem, p, n);
+      elem[n] = '\0';
+      exp = (*elem == '~') ? tilde_expand_word (elem) : elem;
+      elen = strlen (exp);
+      result = (char *)xrealloc (result, len + elen + 2);
+      memcpy (result + len, exp, elen);
+      len += elen;
+      if (exp != elem)
+	xfree (exp);
+      xfree (elem);
+      if (end == 0)
+	break;
+      result[len++] = ':';
+      p = end + 1;
+    }
+  result[len] = '\0';
+  return result;
+}
+
+static int
+_rl_read_init_file (const char *filename, int include_level)
+{
+  int r;
+
+  if (filename == 0)
+    return (ENOENT);
+
+  if (strpbrk (filename, "*?[") == 0)
+    {
+      r = _rl_read_init_file_single (filename, 1, include_level);
+      if (r == 0 || strchr (filename, ':') == 0 || r != ENOENT)
+	return (r);
+    }
+
+  {
+    glob_t gl;
+    int any_ok = 0;
+    int last_err = ENOENT;
+    char *pattern = _rl_tilde_expand_list (filename);
+
+    memset (&gl, 0, sizeof (gl));
+    if (glob (pattern, GLOB_PATHS, NULL, &gl) == 0)
+      {
+	size_t gi;
+	for (gi = 0; gi < gl.gl_pathc; ++gi)
+	  {
+	    struct stat st;
+	    const char *old_file;
+	    int old_line, old_level, old_reading;
+
+	    if (stat (gl.gl_pathv[gi], &st) == 0 && S_ISDIR (st.st_mode))
+	      continue;
+
+	    old_file = current_readline_init_file;
+	    old_line = current_readline_init_lineno;
+	    old_level = current_readline_init_include_level;
+	    old_reading = currently_reading_init_file;
+	    r = _rl_read_init_file_single (gl.gl_pathv[gi], 0, include_level);
+	    current_readline_init_file = old_file;
+	    current_readline_init_lineno = old_line;
+	    current_readline_init_include_level = old_level;
+	    currently_reading_init_file = old_reading;
+	    if (r == 0)
+	      any_ok = 1;
+	    else
+	      last_err = r;
+	  }
+      }
+    globfree (&gl);
+    xfree (pattern);
+
+    if (any_ok)
+      {
+	if (include_level == 0 && filename != last_readline_init_file)
+	  {
+	    FREE (last_readline_init_file);
+	    last_readline_init_file = savestring (filename);
+	  }
+	return (0);
+      }
+    return (last_err);
+  }
+}
+
 static void
 _rl_init_file_error (const char *format, ...)
 {

From fd189cf5d9a0530aa1dff76e137dc16d2a47a984 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:59:50 -0500
Subject: [PATCH 7/7] Test init-file search lists in "make check"

Readline had no "make check".  Add one that builds a small program
calling rl_read_init_file with search lists over a fixture tree, and
checks: every match of a wildcard element is read, a missing /etc
element is harmless, empty elements are ignored, an existing file
whose name contains ':' is read as one file, '~' is expanded in a list
element, entries are read in list order (later ones win), and a list
of only empty elements fails with ENOENT.
---
 Makefile.in           |  6 ++-
 tests/inputrc-glob.c  | 41 ++++++++++++++++++++
 tests/inputrc-glob.sh | 89 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 135 insertions(+), 1 deletion(-)
 create mode 100644 tests/inputrc-glob.c
 create mode 100644 tests/inputrc-glob.sh

diff --git a/Makefile.in b/Makefile.in
index 52577fc..e8f050c 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -342,9 +342,13 @@ install-dvi:
 install-html:
 install-pdf:
 install-ps:
-check:
 installcheck:
 
+check: $(TARGETS)
+	CC='$(CC)' CFLAGS='$(ASAN_CFLAGS) $(CFLAGS)' LDFLAGS='$(ASAN_LDFLAGS) $(LDFLAGS)' \
+	TERMCAP_LIB='$(TERMCAP_LIB)' srcdir='$(srcdir)' \
+		$(SHELL) $(srcdir)/tests/inputrc-glob.sh
+
 dist:   force
 	@echo Readline distributions are created using $(srcdir)/support/mkdist.
 	@echo Here is a sample of the necessary commands:
diff --git a/tests/inputrc-glob.c b/tests/inputrc-glob.c
new file mode 100644
index 0000000..c5d1d26
--- /dev/null
+++ b/tests/inputrc-glob.c
@@ -0,0 +1,41 @@
+/* inputrc-glob.c -- read one init file list with rl_read_init_file() and
+   print the variables the inputrc-glob.sh fixtures set.
+
+   Usage: inputrc-glob FILENAME
+   Prints "bell-style|editing-mode|completion-ignore-case" on success, or
+   "ERR:<errno>" and exits 1 if rl_read_init_file() fails. */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "readline.h"
+
+static const char *
+var (const char *name)
+{
+  const char *v = rl_variable_value (name);
+  return v ? v : "";
+}
+
+int
+main (int argc, char **argv)
+{
+  int r;
+
+  if (argc != 2)
+    {
+      fprintf (stderr, "usage: %s FILENAME\n", argv[0]);
+      return 2;
+    }
+
+  rl_initialize ();
+  r = rl_read_init_file (argv[1]);
+  if (r != 0)
+    {
+      printf ("ERR:%d\n", r);
+      return 1;
+    }
+  printf ("%s|%s|%s\n", var ("bell-style"), var ("editing-mode"),
+	  var ("completion-ignore-case"));
+  return 0;
+}
diff --git a/tests/inputrc-glob.sh b/tests/inputrc-glob.sh
new file mode 100644
index 0000000..4a9c66e
--- /dev/null
+++ b/tests/inputrc-glob.sh
@@ -0,0 +1,89 @@
+#! /bin/sh
+# Test rl_read_init_file()'s colon-separated, wildcard-aware init file lists
+# (what makes a SYS_INPUTRC such as "/sw/*/etc/inputrc:/etc/inputrc" work):
+# vendor-then-/etc precedence, a literal filename containing ':', '~'
+# expansion, empty leading/trailing list entries, and ":" alone.  Every
+# fixture lives under a temporary directory; nothing here reads the host's
+# own inputrc files.
+#
+# Run from the build directory after "make", normally via "make check":
+#   CC=... CFLAGS=... LDFLAGS=... TERMCAP_LIB=... srcdir=... $(SHELL) tests/inputrc-glob.sh
+
+: "${CC:=cc}" "${srcdir:=.}"
+td="$(mktemp -d)" || exit 99
+trap 'rm -rf "$td"' EXIT
+fail=0
+
+# Link against the library this tree just built: libreadline.a if static
+# libraries were built, otherwise shlib/libreadline.so.X.Y through a private
+# directory holding the libreadline.so and soname links the build tree lacks.
+if test -f ./libreadline.a
+then
+    rllib=./libreadline.a
+else
+    real=
+    for f in shlib/libreadline.so.*
+    do
+        test -f "$f" && test ! -h "$f" && real="$f"
+    done
+    if test -z "$real"
+    then
+        echo "FAIL: no libreadline.a or shlib/libreadline.so.* (run make first)"
+        exit 1
+    fi
+    mkdir "$td/lib" || exit 99
+    n="${real##*/}"
+    ln -s "$(cd "${real%/*}" && pwd)/$n" "$td/lib/$n" || exit 99
+    while case "$n" in *.so.*) true ;; *) false ;; esac
+    do
+        ln -s "$n" "$td/lib/${n%.*}" || exit 99
+        n="${n%.*}"
+    done
+    rllib="-L$td/lib -Wl,-rpath,$td/lib -lreadline"
+fi
+
+prog="$td/inputrc-glob"
+if ! $CC $CFLAGS -DREADLINE_LIBRARY -I. -I"$srcdir" $LDFLAGS \
+    -o "$prog" "$srcdir/tests/inputrc-glob.c" $rllib $TERMCAP_LIB
+then
+    echo "FAIL: cannot build $prog"
+    exit 1
+fi
+
+mkdir -p "$td/sw/pkgA/etc" "$td/sw/pkgB/etc" "$td/etc" "$td/home" || exit 99
+printf 'set bell-style none\nset editing-mode emacs\n' > "$td/sw/pkgA/etc/inputrc"
+printf 'set completion-ignore-case on\n' > "$td/sw/pkgB/etc/inputrc"
+printf 'set bell-style audible\nset editing-mode vi\n' > "$td/my:inputrc"
+printf 'set bell-style visible\n' > "$td/home/.inputrc"
+
+# expect EXPECTED FILENAME DESCRIPTION
+expect() {
+    got="$(TERM=dumb HOME="$td/home" INPUTRC=/dev/null "$prog" "$2" < /dev/null 2> "$td/stderr")"
+    if test "$got" = "$1"
+    then
+        echo "PASS: $3"
+    else
+        echo "FAIL: $3: rl_read_init_file(\"$2\"): expected '$1', got '$got'"
+        sed 's/^/  stderr: /' "$td/stderr"
+        fail=1
+    fi
+}
+
+expect 'none|emacs|on' "$td/sw/*/etc/inputrc:$td/etc/inputrc" \
+    'wildcard vendor files are all read; a missing /etc entry is harmless'
+expect 'none|emacs|on' ":$td/sw/*/etc/inputrc:" \
+    'empty leading and trailing entries are ignored'
+expect 'audible|vi|off' "$td/my:inputrc" \
+    'an existing file whose name contains a colon is read literally'
+expect 'visible|emacs|on' "$td/sw/*/etc/inputrc:~/.inputrc" \
+    '~ is expanded in a list entry, and later entries win'
+expect 'none|emacs|on' "~/.inputrc:$td/sw/*/etc/inputrc" \
+    'entries are read in list order'
+expect 'ERR:2' ':' \
+    'a list with only empty entries fails with ENOENT'
+
+printf 'set bell-style visible\n' > "$td/etc/inputrc"
+expect 'visible|emacs|on' "$td/sw/*/etc/inputrc:$td/etc/inputrc" \
+    '/etc entry after the vendor wildcard overrides vendor settings'
+
+exit $fail
