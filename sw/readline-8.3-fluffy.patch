From 09735c4109f84e55a32471e46187450d2db1d16b Mon Sep 17 00:00:00 2001
From: Chet Ramey <chet.ramey@case.edu>
Date: Fri, 11 Jul 2025 11:51:15 -0400
Subject: [PATCH 1/7] Readline-8.3 patch 1: fix for readline event hook

When an application's rl_input_available_hook reports input,
rl_gather_tyi went on to read none, since nothing set chars_avail; and
when select found input it skipped the FIONREAD query that sets it.

From upstream commit 15970c4 (readline-8.3 official patch 1), input.c
only: the patchlevel bump is left out, as Fluffy's earlier patches did,
so that this series reproduces them exactly.
---
 input.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/input.c b/input.c
index e6a39e2..8e69326 100644
--- a/input.c
+++ b/input.c
@@ -268,6 +268,8 @@ rl_gather_tyi (void)
       result = (*rl_input_available_hook) ();
       if (result == 0)
         result = -1;
+      else
+        chars_avail = 1;
     }
 
 #if defined (HAVE_PSELECT) || defined (HAVE_SELECT)
@@ -285,6 +287,7 @@ rl_gather_tyi (void)
 #endif
       if (result <= 0)
 	return 0;	/* Nothing to read. */
+   result = -1;
     }
 #endif
 

From 7e02dc3e578fa2e53367618179c9279b461369a4 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:58:41 -0500
Subject: [PATCH 2/7] Install the libraries without keeping .old copies

"make install" renamed any library already in place to <lib>.old
before installing the new one.  A Fluffy package is installed into an
empty DESTDIR and shipped as an image, so there is never an old library
to keep, and a stray .old file would only end up in the image.

(The Cygwin-only branch of shlib-install also lost the braces around
$echo, with no change in meaning.)
---
 Makefile.in           | 2 --
 support/shlib-install | 8 ++++----
 2 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index 54bd19a..52577fc 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -258,10 +258,8 @@ uninstall-pc:
 maybe-uninstall-pc: uninstall-pc
 
 install-static: installdirs $(STATIC_LIBS) install-headers install-doc ${install_examples} install-pc
-	-$(MV) $(DESTDIR)$(libdir)/libreadline.a $(DESTDIR)$(libdir)/libreadline.old
 	$(INSTALL_DATA) libreadline.a $(DESTDIR)$(libdir)/libreadline.a
 	-test -n "$(RANLIB)" && $(RANLIB) $(DESTDIR)$(libdir)/libreadline.a
-	-$(MV) $(DESTDIR)$(libdir)/libhistory.a $(DESTDIR)$(libdir)/libhistory.old
 	$(INSTALL_DATA) libhistory.a $(DESTDIR)$(libdir)/libhistory.a
 	-test -n "$(RANLIB)" && $(RANLIB) $(DESTDIR)$(libdir)/libhistory.a
 
diff --git a/support/shlib-install b/support/shlib-install
index 661355d..839b77e 100755
--- a/support/shlib-install
+++ b/support/shlib-install
@@ -49,9 +49,9 @@ LN="ln -s"
 # pre-install
 
 if [ -z "$uninstall" ]; then
-	${echo} $RM ${INSTALLDIR}/${LIBNAME}.${OLDSUFF}
+	:
 	if [ -f "$INSTALLDIR/$LIBNAME" ]; then
-		${echo} $MV $INSTALLDIR/$LIBNAME ${INSTALLDIR}/${LIBNAME}.${OLDSUFF}
+	:
 	fi
 fi
 
@@ -79,9 +79,9 @@ cygwin*|mingw*)
 	IMPLIBNAME=`echo ${LIBNAME} \
 		| sed -e 's,^cyg,lib,' -e 's,[0-9]*.dll$,.dll.a,'`
 	if [ -z "$uninstall" ]; then
-		${echo} $RM ${BINDIR}/${LIBNAME}.${OLDSUFF}
+	:
 		if [ -f "$BINDIR/$LIBNAME" ]; then
-			${echo} $MV $BINDIR/$LIBNAME $BINDIR/$LIBNAME.$OLDSUFF
+			$echo $MV $BINDIR/$LIBNAME $BINDIR/$LIBNAME.$OLDSUFF
 		fi
 		${echo} $MV ${INSTALLDIR}/${LIBNAME} ${BINDIR}/${LIBNAME}
 		${echo} chmod a+x ${BINDIR}/${LIBNAME}

From a01360c5d822ffabbad80df790e41a3cb276fe2c Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:59:41 -0500
Subject: [PATCH 3/7] shobj-conf: do not set an rpath on Linux

The shared libraries were linked with -rpath $(libdir), baking
/sw/readline/lib into them.  On Fluffy the loader finds every package's
libraries through its /sw/*/lib search path, and a package must not
name its own install location in its binaries.
---
 support/shobj-conf | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/support/shobj-conf b/support/shobj-conf
index c3df351..689bd00 100644
--- a/support/shobj-conf
+++ b/support/shobj-conf
@@ -128,7 +128,7 @@ linux*-*|gnu*-*|k*bsd*-gnu-*|midnightbsd*|freebsd*|dragonfly*)
 	SHOBJ_LD='${CC}'
 	SHOBJ_LDFLAGS='-shared -Wl,-soname,$@'
 
-	SHLIB_XLDFLAGS='-Wl,-rpath,$(libdir) -Wl,-soname,`basename $@ $(SHLIB_MINOR)`'
+	SHLIB_XLDFLAGS='-Wl,-soname,`basename $@ $(SHLIB_MINOR)`'
 	SHLIB_LIBVERSION='$(SHLIB_LIBSUFF).$(SHLIB_MAJOR)$(SHLIB_MINOR)'
 	;;
 
@@ -269,7 +269,7 @@ irix[56]*-*gcc*)
 	SHOBJ_LD='${CC}'
 	SHOBJ_LDFLAGS='-shared -Wl,-soname,$@'
 
-	SHLIB_XLDFLAGS='-Wl,-rpath,$(libdir)'
+	SHLIB_XLDFLAGS=''
 	SHLIB_LIBVERSION='$(SHLIB_LIBSUFF).$(SHLIB_MAJOR)'
 	;;
 

From 8029d5bfadffba7a5dca3808dab833a7be1f7f03 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:59:41 -0500
Subject: [PATCH 4/7] shobj-conf: link the shared libraries with $(TERMCAP_LIB)

On Linux, libreadline.so was linked without the termcap library
(ncurses) whose functions it calls, so it carried no DT_NEEDED for it
and every program using readline had to link ncurses itself.  Set
SHLIB_LIBS, as some other systems' entries already do, so that the
shared library records the dependency.
---
 support/shobj-conf | 1 +
 1 file changed, 1 insertion(+)

diff --git a/support/shobj-conf b/support/shobj-conf
index 689bd00..0544ce4 100644
--- a/support/shobj-conf
+++ b/support/shobj-conf
@@ -130,6 +130,7 @@ linux*-*|gnu*-*|k*bsd*-gnu-*|midnightbsd*|freebsd*|dragonfly*)
 
 	SHLIB_XLDFLAGS='-Wl,-soname,`basename $@ $(SHLIB_MINOR)`'
 	SHLIB_LIBVERSION='$(SHLIB_LIBSUFF).$(SHLIB_MAJOR)$(SHLIB_MINOR)'
+	SHLIB_LIBS='$(TERMCAP_LIB)'
 	;;
 
 # Darwin/MacOS X

From 3f1adbd78b934fee0b464c0f1be96f8c758816ad Mon Sep 17 00:00:00 2001
