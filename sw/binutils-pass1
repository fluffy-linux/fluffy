ON=host-build

VERSION=2.47

ARCHIVES=(
    154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff https://sourceware.org/pub/binutils/releases/binutils-$VERSION.tar.xz
    17c3f59e8992c67263d803832b4fe5ac61e8d4c65b5727fb42b59f1f7ae17217 file://binutils-$VERSION-fluffy-shell.patch
    6690a172945cba4e886738bb16a66acf115d88d044212a3ae9f4b42454f33d4d file://binutils-$VERSION-fluffy-source.patch
)

MAKE() {
    patch -Z -Np1 -i binutils-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i binutils-$VERSION-fluffy-source.patch

    mkdir -v build
    cd build
    ../configure \
        --prefix=/sw/binutils \
        --target=$FLUFFY_TGT \
        --disable-nls \
        --enable-gprofng=no \
        --disable-werror \
        --enable-new-dtags \
        --enable-default-hash-style=gnu
    make
}

INSTALL() {
    cd build
    make install
}
