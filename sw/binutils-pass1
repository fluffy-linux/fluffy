ON=host

VERSION=2.47

ARCHIVES=(
    154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff https://sourceware.org/pub/binutils/releases/binutils-$VERSION.tar.xz
    519994f4f77062ad66395a980b5e049df395dd1ea17dc7a4ca7788d7bf454554 file://binutils-$VERSION-fluffy.patch
)

MAKE() {
    patch -Np1 -i binutils-$VERSION-fluffy.patch

    mkdir -v build
    cd build
    ../configure \
        --prefix=/sw/binutils \
        --target=$FLUFFY_TGT \
        --disable-nls \
        --enable-gprofng=no \
        --disable-werror \
        --enable-new-dtags \
        --enable-default-hash-style=gnu
    make
}

INSTALL() {
    cd build
    make install
}
