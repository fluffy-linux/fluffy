ON=host-build

VERSION=1.3.2

# Built from Fluffy's branch (our commits on upstream's v1.3.2 tag), no
# patch: GitHub's tarball of the branch until it is released.
ARCHIVES=(
    57b937080a41d041ed1221ac44bcc967bcb8dbcc16d6e9bd85bf23499866e7f3 https://github.com/fluffy-linux/zlib/archive/refs/heads/fluffy/v$VERSION.tar.gz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    CC="$FLUFFY_TGT-gcc" ./configure --prefix=/sw/zlib
    make
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
