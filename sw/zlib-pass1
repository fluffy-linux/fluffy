ON=host-build

VERSION=1.3.2

HAS_LDFLAGS=-lz

ARCHIVES=(
    bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 https://github.com/fluffy-linux/zlib/releases/download/v$VERSION/zlib-$VERSION.tar.gz
    488dd373e46ae3fee312810f37cba3a27f3f93d4434c821d09e726a00d3b87da file://zlib-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i zlib-$VERSION-fluffy-source.patch
    CC="$FLUFFY_TGT-gcc" ./configure --prefix=/sw/zlib
    make
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
