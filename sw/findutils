if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.11.0

ARCHIVES=(
    bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd https://ftpmirror.gnu.org/findutils/findutils-$VERSION.tar.xz
    1b5338e5a912f92962533191a482d97a57f2e923966dacaa5446c79df1b455a2 file://findutils-$VERSION-fluffy-shell.patch
    b7440a6c91a02bd8ecf1825d3285f85dd219fce4e09cd7e636e77850bdf6bc40 file://findutils-$VERSION-fluffy-test.patch
)

NEEDS=(
    bash
    coreutils
    glibc
    sed
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils-pass1
        gawk
        gcc
        gettext
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        python
        sed
        tar-pass1
        tcl
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        python
        sed
        tar
        tcl
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i findutils-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i findutils-$VERSION-fluffy-test.patch

    ac_cv_path_SORT=sort CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/findutils \
        --localstatedir=/var/locate
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install localstatedir=/sw/findutils/var/locate
    rm -rf $DESTDIR/sw/findutils/var
}
