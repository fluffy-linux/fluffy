if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.11.0

# Built straight from Fluffy's branch (our commits on upstream's v4.11.0
# tag): swctl fetches the pinned commit, and the gnulib and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it with the
# autotools findutils' release tarball was made with, and its
# translations come from the Translation Project's files, merged as the
# release's make dist did.
ARCHIVES=(
    fb67440a37230cdcd31907b99543bbf4795e2336 https://github.com/fluffy-linux/findutils.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    c47d100eab0ff3b64e16811f6b3925b233085497 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17
)

NEEDS=(
    bash
    coreutils
    glibc
    sed
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        dejagnu
        diffutils
        expect
        findutils-pass1
        gawk
        gcc
        gettext
        glibc
        gperf
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        python
        sed
        tar-pass1
        tcl
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        gettext
        glibc
        gperf
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        python
        sed
        tar
        tcl
        texinfo
        xz
    )
fi

# Bootstrapped with the autotools findutils' release tarball was made
# with.  bootstrap runs autopoint, bison and gzip, the build gperf
# (gnulib's lookup tables), xgettext, msgmerge and msgfmt (the
# translations) and makeinfo (the manual), which the release tarball
# ships made.  texinfo comes after findutils
# and needs it, so in cross-build texinfo-pass1 stands in.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    ac_cv_path_SORT=sort CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/findutils \
        --localstatedir=/var/locate
    # The translations as make dist merges them with findutils.pot.
    make -C po update-po
    make
}

CHECK() {
    # gnulib's test-regex-el fails here: the regex fastmap disagrees with
    # the plain match for \xd3, \xf2 and \xf3 against \xf2 in the Greek
    # (ISO-8859-7) locale.  Fluffy's tarball build marked it as expected
    # to fail too; the cause is not tracked down.
    make check XFAIL_TESTS=test-regex-el
}

INSTALL() {
    make install localstatedir=/sw/findutils/var/locate
    rm -rf $DESTDIR/sw/findutils/var
}
