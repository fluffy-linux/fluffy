if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.44.0

ARCHIVES=(
    505cf43912e9480495c344c70260452e32aa2a73c546a026b3f100053b23ce91 https://github.com/fluffy-linux/perl5/releases/download/v$VERSION/perl-$VERSION.tar.xz
    76d5b2c38546637ae9847dbee846f3dc38440b662c94c9455f5f68a995c9bd8b file://perl-$VERSION-fluffy-source.patch
    2dbbf22a0f2fd0114d14851b95df2546e715b3deef7d3b03308cc78d0070a0de file://perl-$VERSION-fluffy-test.patch
)

NEEDS=(
    bzip2
    gdbm
    glibc
    less
    libxcrypt
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gdbm
        glibc
        grep
        gzip-pass1
        iana-etc
        less
        libgcc
        libxcrypt
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gdbm
        glibc
        grep
        gzip
        iana-etc
        less
        libgcc
        libxcrypt
        linux-headers
        make
        patch
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i perl-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i perl-$VERSION-fluffy-test.patch

    export BUILD_ZLIB=False
    export BUILD_BZIP2=0

    sh Configure -des \
        -D prefix=/sw/perl \
        -D vendorprefix=/sw/perl \
        -D privlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D archlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D sitelib=/sw/perl/lib/perl5/5.44/site_perl \
        -D sitearch=/sw/perl/lib/perl5/5.44/site_perl \
        -D vendorlib=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D vendorarch=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D man1dir=/sw/perl/share/man/man1 \
        -D man3dir=/sw/perl/share/man/man3 \
        -D pager="/sw/less/bin/less -isR" \
        -D useshrplib \
        -D usethreads \
        -D sh=/sw/bash/bin/bash \
        -D targetsh=/sw/bash/bin/bash \
        -D locincpth="" \
        -D loclibpth=""
    make
}

CHECK() {
    TEST_JOBS=$(nproc) make test_harness
}

INSTALL() {
    make install
    unset BUILD_ZLIB BUILD_BZIP2
}
