if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.44.0

# Built straight from Fluffy's branch (our commits on upstream's v5.44.0
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    09d9f963c6439cecdd47b97b127629818d514b65 https://github.com/fluffy-linux/perl5.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    bzip2
    gdbm
    glibc
    less
    libxcrypt
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gdbm
        glibc
        grep
        gzip-pass1
        iana-etc
        less
        libgcc
        libxcrypt
        linux-headers
        make-pass1
        sed
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gdbm
        glibc
        grep
        gzip
        iana-etc
        less
        libgcc
        libxcrypt
        linux-headers
        make
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    export BUILD_ZLIB=False
    export BUILD_BZIP2=0

    sh Configure -des \
        -D prefix=/sw/perl \
        -D vendorprefix=/sw/perl \
        -D privlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D archlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D sitelib=/sw/perl/lib/perl5/5.44/site_perl \
        -D sitearch=/sw/perl/lib/perl5/5.44/site_perl \
        -D vendorlib=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D vendorarch=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D otherlibdirs="/sw/*/lib/perl5/5.44/site_perl:/sw/*/lib/perl5/5.44/vendor_perl" \
        -D man1dir=/sw/perl/share/man/man1 \
        -D man3dir=/sw/perl/share/man/man3 \
        -D pager="/sw/less/bin/less -isR" \
        -D useshrplib \
        -D usethreads \
        -D sh=/sw/bash/bin/bash \
        -D targetsh=/sw/bash/bin/bash \
        -D locincpth="" \
        -D loclibpth=""
    make
}

CHECK() {
    TEST_JOBS=$(nproc) make test_harness
}

INSTALL() {
    make install
    unset BUILD_ZLIB BUILD_BZIP2
}
