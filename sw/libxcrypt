if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.5.2

ARCHIVES=(
    71513a31c01a428bccd5367a32fd95f115d6dac50fb5b60c779d5c7942aec071 https://github.com/besser82/libxcrypt/releases/download/v$VERSION/libxcrypt-$VERSION.tar.xz
    c52bbf6498d194b9dc92dbbac213319421f2315b36be6f67ebfafc021acd870b file://libxcrypt-$VERSION-fluffy-shell.patch
    0e2ec45ef1e38458d02b79205b4c911295f5a06a3d99f5fc2cc4004bafb22bd2 file://libxcrypt-$VERSION-fluffy-source.patch
    e02212356aa16f69e3ac765bff970ca26c0578b19457937425eae0eac7851081 file://libxcrypt-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i libxcrypt-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i libxcrypt-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i libxcrypt-$VERSION-fluffy-test.patch

    ./configure \
        --prefix=/sw/libxcrypt \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=no \
        --disable-static \
        --disable-failure-tokens
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/libxcrypt/lib/libcrypt.la
}
