if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.5.2

HAS_LDFLAGS=-lcrypt

ARCHIVES=(
    71513a31c01a428bccd5367a32fd95f115d6dac50fb5b60c779d5c7942aec071 https://github.com/besser82/libxcrypt/releases/download/v$VERSION/libxcrypt-$VERSION.tar.xz
    0a0c1ff0c61708f89d3aec4d334345aac48b50d821b5e6c795ffd15f1774b44d file://libxcrypt-$VERSION-fluffy-source.patch
    95c5ec81dd64182e87f5e9c0e7cb0c5b0dcada490e7d77b24bc50db45f6317ca file://libxcrypt-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i libxcrypt-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i libxcrypt-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/libxcrypt \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=no \
        --disable-static \
        --disable-failure-tokens
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/libxcrypt/lib/libcrypt.la
}
