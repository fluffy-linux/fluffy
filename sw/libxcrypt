if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.5.2

# Built straight from Fluffy's branch (our commits on upstream's v4.5.2
# tag, LFS's glibc 2.43 fix among them): swctl fetches the pinned commit
# with git.  The tag has no configure or Makefile.in, so MAKE runs
# autogen.sh, as upstream makes its release tarball: with the autoconf,
# automake and libtool the release was made with (2.72, 1.18.1, 2.5.4),
# from their Fluffy branches.
ARCHIVES=(
    7a0264c284b328c851c8b90318b7efee007ff66e https://github.com/fluffy-linux/libxcrypt.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
    2b62947fd566e11dedf3c2c7e252f05a8937d54c https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.5.4
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/libxcrypt \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=no \
        --disable-static \
        --disable-failure-tokens
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/libxcrypt/lib/libcrypt.la
}
