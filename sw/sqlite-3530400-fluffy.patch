@@ -2086,7 +2086,104 @@
 } else {
 	# unix separates $PATH with colons and has and executable bit
 	proc split-path {} {
-		split [getenv PATH .] :
+		set pathStr [getenv PATH .]
+		if {[string first {[} $pathStr] < 0} {
+			set raw [split $pathStr :]
+		} else {
+			set raw {}
+			set pathLen [string length $pathStr]
+			set segStart 0
+			set idx 0
+			while {$idx < $pathLen} {
+				set ch [string index $pathStr $idx]
+				if {$ch eq ":"} {
+					lappend raw [string range $pathStr $segStart [expr {$idx - 1}]]
+					incr idx
+					set segStart $idx
+					continue
+				}
+				if {$ch eq "\["} {
+					set q [expr {$idx + 1}]
+					if {$q < $pathLen && [string index $pathStr $q] in {! ^}} {
+						incr q
+					}
+					if {$q < $pathLen && [string index $pathStr $q] eq "\]"} {
+						incr q
+					}
+					while {$q < $pathLen} {
+						set qc [string index $pathStr $q]
+						if {$qc eq "\]" || $qc eq "/"} {
+							break
+						}
+						if {$qc eq "\[" && ($q + 1) < $pathLen
+								&& [string index $pathStr [expr {$q + 1}]] in {: . =}} {
+							set ctype [string index $pathStr [expr {$q + 1}]]
+							set inner [expr {$q + 2}]
+							while {$inner < $pathLen} {
+								set ic [string index $pathStr $inner]
+								if {$ic eq "/" || ($ctype ne "." && $ic eq "\]")} {
+									break
+								}
+								if {$ic eq $ctype && ($inner + 1) < $pathLen
+										&& [string index $pathStr [expr {$inner + 1}]] eq "\]"} {
+									set q [expr {$inner + 2}]
+									set inner -1
+									break
+								}
+								incr inner
+							}
+							if {$inner == -1} {
+								continue
+							}
+						}
+						incr q
+					}
+					if {$q < $pathLen && [string index $pathStr $q] eq "\]"} {
+						set idx [expr {$q + 1}]
+						continue
+					}
+				}
+				incr idx
+			}
+			lappend raw [string range $pathStr $segStart end]
+		}
+		set dirs {}
+		foreach p $raw {
+			if {$p ne "" && [file isdirectory $p]} {
+				lappend dirs $p
+			} elseif {[string first * $p] >= 0
+					|| [string first ? $p] >= 0
+					|| [string first "\[" $p] >= 0} {
+				set gpat [string map {\\ \\\\ \{ \\{ \} \\}} $p]
+				if {$::autosetup(istcl)} {
+					if {[string index $gpat 0] eq "~"} {
+						set gpat "\\$gpat"
+					}
+					if {![catch {glob -nocomplain -types d -- $gpat} matches] && [llength $matches] > 0} {
+						lappend dirs {*}[lsort -ascii $matches]
+					} else {
+						lappend dirs $p
+					}
+				} else {
+					set matches {}
+					if {![catch {glob -nocomplain -- $gpat} raw_matches]} {
+						foreach m [lsort $raw_matches] {
+							if {[file isdirectory $m]} {
+								lappend matches $m
+							}
+						}
+					}
+					if {[llength $matches] > 0} {
+						lappend dirs {*}$matches
+					} else {
+						lappend dirs $p
+					}
+				}
+			} else {
+				lappend dirs $p
+			}
+		}
+		return $dirs
 	}
 	# Check for an executable file
 	proc file-isexec {exec} {
