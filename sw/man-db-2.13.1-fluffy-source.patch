@@ -6,7 +6,7 @@
 [Service]
 Type=oneshot
 # Recover from deletion, per FHS.
-ExecStart=+/usr/bin/install -d -o @cache_top_owner@ -g @cache_top_owner@ -m 0755 /var/cache/man
