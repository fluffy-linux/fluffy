+static void clear_sections (bool user)
+{
+	enum config_flag target = user ? SECTION_USER : SECTION;
+	size_t i = gl_list_size (config);
+	while (i > 0) {
+		--i;
+		const struct config_item *existing =
+		        (const struct config_item *) gl_list_get_at (config, i);
+		if (existing->flag == target)
