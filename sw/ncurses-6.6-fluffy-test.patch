diff --no-dereference -Naur ncurses-6.6.orig/progs/check-terminfo-dirs.sh ncurses-6.6/progs/check-terminfo-dirs.sh
--- ncurses-6.6.orig/progs/check-terminfo-dirs.sh	1970-01-01 00:00:00.000000000 +0000
+++ ncurses-6.6/progs/check-terminfo-dirs.sh	2025-10-18 13:34:20.000000000 +0000
@@ -0,0 +1,106 @@
+#! /bin/sh
+# Test tic/infocmp terminfo database lookup through TERMINFO_DIRS lists with
+# wildcard entries ("/sw/*/share/terminfo"), bracket expressions that contain
+# ':' (which must not split the list), /etc-before-vendor precedence, and
+# that an empty entry means the compiled-in default, never the current
+# directory.  Every fixture lives under a temporary directory; nothing here
+# depends on the host's own terminfo trees.
+#
+# Run from the progs build directory after "make", normally via "make check":
+#   TIC=./tic INFOCMP=./infocmp LIBDIR=../lib TERMINFO_SRC=../misc/terminfo.src \
+#       $(SHELL) check-terminfo-dirs.sh
+
+abspath() {
+    case "$1" in
+    /*) printf '%s\n' "$1" ;;
+    *) printf '%s/%s\n' "$(pwd)" "$1" ;;
+    esac
+}
+TIC="$(abspath "${TIC:-./tic}")"
+INFOCMP="$(abspath "${INFOCMP:-./infocmp}")"
+LIBDIR="$(abspath "${LIBDIR:-../lib}")"
+TERMINFO_SRC="$(abspath "${TERMINFO_SRC:-../misc/terminfo.src}")"
+
+td="$(mktemp -d)" || exit 99
+trap 'rm -rf "$td"' EXIT
+fail=0
+
+LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+HOME="$td/home"
+TERMINFO="$td/nonexistent"
+export LD_LIBRARY_PATH HOME TERMINFO
+unset TERMINFO_DIRS
+
+mkdir -p "$td/home" "$td/default" "$td/sw/pkgA/share/terminfo" \
+    "$td/sw/1:colon/share/terminfo" "$td/etc/terminfo" "$td/cwd" || exit 99
+
+printf 'custom-fluffy-term|fluffy vendor term,\n\tcols#111, lines#24,\n' > "$td/vendor.ti"
+printf 'colon-fluffy-term|fluffy colon vendor term,\n\tcols#123, lines#25,\n' > "$td/colon.ti"
+printf 'custom-fluffy-term|fluffy etc override,\n\tcols#199, lines#42,\n' > "$td/etc.ti"
+printf 'cwd-evil-term|evil cwd term,\n\tcols#666, lines#13,\n' > "$td/cwd.ti"
+
+# run DESCRIPTION COMMAND...: the command must succeed.
+run() {
+    desc="$1"
+    shift
+    if "$@" > "$td/out" 2>&1
+    then
+        echo "PASS: $desc"
+    else
+        echo "FAIL: $desc: $*"
+        sed 's/^/  /' "$td/out"
+        fail=1
+    fi
+}
+
+run 'tic compiles xterm-256color from terminfo.src' \
+    "$TIC" -x -o "$td/default" -e xterm-256color "$TERMINFO_SRC"
+run 'infocmp reads xterm-256color back through TERMINFO' \
+    env TERMINFO="$td/default" "$INFOCMP" xterm-256color
+
+run 'tic compiles the vendor fixture' "$TIC" -o "$td/sw/pkgA/share/terminfo" "$td/vendor.ti"
+run 'tic compiles into a directory whose name contains a colon' \
+    "$TIC" -o "$td/sw/1:colon/share/terminfo" "$td/colon.ti"
+run 'tic compiles the /etc fixture' "$TIC" -o "$td/etc/terminfo" "$td/etc.ti"
+run 'tic compiles the current-directory fixture' "$TIC" -o "$td/cwd" "$td/cwd.ti"
+
+# expect NAME CAPABILITY TERMINFO_DIRS DESCRIPTION: infocmp NAME, run from
+# $td/cwd, must succeed and print CAPABILITY.
+expect() {
+    if (cd "$td/cwd" && TERMINFO_DIRS="$3" "$INFOCMP" "$1") > "$td/out" 2>&1 &&
+        grep "$2," "$td/out" > /dev/null
+    then
+        echo "PASS: $4"
+    else
+        echo "FAIL: $4: TERMINFO_DIRS='$3' infocmp $1: expected $2"
+        sed 's/^/  /' "$td/out"
+        fail=1
+    fi
+}
+
+# reject NAME TERMINFO_DIRS DESCRIPTION: infocmp NAME, run from $td/cwd,
+# must fail.
+reject() {
+    if (cd "$td/cwd" && TERMINFO_DIRS="$2" "$INFOCMP" "$1") > "$td/out" 2>&1
+    then
+        echo "FAIL: $3: TERMINFO_DIRS='$2' infocmp $1 unexpectedly succeeded"
+        sed 's/^/  /' "$td/out"
+        fail=1
+    else
+        echo "PASS: $3"
+    fi
+}
+
+vendor_dirs="$td/missing_etc:$td/sw/[[:alpha:]]*/share/terminfo:$td/sw/1[a:]colon/share/terminfo"
+expect custom-fluffy-term 'cols#111' "$vendor_dirs" \
+    'a missing entry is skipped and a [[:alpha:]] wildcard entry is searched'
+expect colon-fluffy-term 'cols#123' "$vendor_dirs" \
+    'a bracket expression containing a colon does not split the list'
+expect custom-fluffy-term 'cols#199' "$td/etc/terminfo:$td/sw/*/share/terminfo" \
+    'an /etc entry before the vendor wildcard takes precedence'
+expect custom-fluffy-term 'cols#111' ":$td/sw/*/share/terminfo" \
+    'entries after an empty leading entry are still searched'
+reject cwd-evil-term ":$td/sw/*/share/terminfo" \
+    'an empty leading entry never reads a terminfo tree from the current directory'
+
+exit $fail
