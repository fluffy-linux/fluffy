if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.4.1

# Built straight from Fluffy's branch (our commits on upstream's
# gawk-5.4.1 tag): swctl fetches the pinned commit with git.  The tag
# carries configure and the Makefile.in files; make builds the info
# manuals the release tarball ships.
ARCHIVES=(
    5c137f95a170ffc7abc62c061bd0abeefda17f23 https://github.com/fluffy-linux/gawk.git#refs/heads/fluffy/gawk-$VERSION
)

NEEDS=(
    bash
    glibc
    gmp
    mpfr
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        gmp
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        mpfr
        ncurses
        readline
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        gmp
        grep
        gzip
        libgcc
        linux-headers
        make
        mpfr
        ncurses
        readline
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gawk
    make
}

CHECK() {
    make PAGER=cat check
}

INSTALL() {
    make INSTALL="/sw/coreutils/bin/install -c" install
    ln -sv gawk.1 $DESTDIR/sw/gawk/share/man/man1/awk.1
    install -vDm644 doc/{awkforai.txt,*.{eps,pdf,jpg}} -t $DESTDIR/sw/gawk/share/doc/gawk-$VERSION
    find $DESTDIR/sw/gawk -name '*.la' -delete
}
