if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.4.1

ARCHIVES=(
    07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37 https://github.com/fluffy-linux/gawk/releases/download/gawk-$VERSION/gawk-$VERSION.tar.xz
    b9956cc9d1a2e50130c28244399853946ba76fa8896102e15f28398946c98ef4 file://gawk-$VERSION-fluffy-source.patch
    e53b14e1924322ad37dd8c106b89fe119c04137b677a7817f6524be59568e3a9 file://gawk-$VERSION-fluffy-test.patch
)

NEEDS=(
    bash
    glibc
    gmp
    mpfr
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        gmp
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        mpfr
        ncurses
        patch-pass1
        readline
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        gmp
        grep
        gzip
        libgcc
        linux-headers
        make
        mpfr
        ncurses
        patch
        readline
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i gawk-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i gawk-$VERSION-fluffy-test.patch

    sed -i 's/extras//' Makefile.in
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gawk
    make
}

CHECK() {
    make PAGER=cat check
}

INSTALL() {
    make INSTALL="/sw/coreutils/bin/install -c" install
    ln -sv gawk.1 $DESTDIR/sw/gawk/share/man/man1/awk.1
    install -vDm644 doc/{awkforai.txt,*.{eps,pdf,jpg}} -t $DESTDIR/sw/gawk/share/doc/gawk-$VERSION
    find $DESTDIR/sw/gawk -name '*.la' -delete
}
