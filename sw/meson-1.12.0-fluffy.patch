+
+    def test_fluffy_shebang_rewrite(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            py_script = Path(tmpdir) / 'gen.py'
+            py_script.write_text('#!/nonexistent/usr/bin/env python3\nprint("ok")\n', encoding='utf-8')
+            py_script.chmod(0o755)
+
+            prog = ExternalProgram(str(py_script), silent=True)
+            self.assertTrue(prog.found())
+            self.assertEqual(prog.get_command(), mesonbuild.mesonlib.python_command + [str(py_script)])
