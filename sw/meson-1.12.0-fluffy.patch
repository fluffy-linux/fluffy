+    @staticmethod
+    def _needs_shebang_rewrite(script: str) -> bool:
+        try:
+            with open(script, 'rb') as f:
+                if f.read(2) != b'#!':
+                    return False
+                first_line = f.readline().decode('utf-8', errors='replace').strip()
+            commands = first_line.split('#')[0].strip().split(maxsplit=1)
+            return bool(commands) and not os.path.exists(commands[0])
+        except Exception:
+            return False
+
