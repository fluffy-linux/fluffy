if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.3.0

# Built straight from Fluffy's branch (our commits on upstream's
# gmp-6.3.0 tag, LFS's gcc 15 edit among them): swctl fetches the pinned
# commit with git.  The tag has no configure, Makefile.in or gmp.info,
# so MAKE regenerates them as the tag's .bootstrap does, with the
# autoconf, automake and libtool the release was made with (2.69, 1.15,
# 2.4.6), from their Fluffy branches.  make also writes demos/calc's
# parser and scanner, which the tarball ships, with bison and flex (the
# demos aren't installed).
ARCHIVES=(
    b014758f355f3d1ec645cda0acdb09811a16e3d7 https://github.com/fluffy-linux/gmp.git#refs/heads/fluffy/gmp-$VERSION
    48eccc1ad68d408db760ce345e08eda16b694c52 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.69
    d134bdcb732a6f097d9553a0d2a311d66fbd834c https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.15
    963b66efea03cad6818121235016785e051d14c3 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.6
)

if test -v CROSS
then
    NEEDS=(
        glibc
        libgcc
        libstdcpp-pass1
    )
else
    NEEDS=(
        glibc
        libgcc
        libstdcpp
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        flex
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        libstdcpp-pass1
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        libgcc
        libstdcpp
        linux-headers
        m4
        make
        patch
        perl
        sed
        texinfo
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    # .bootstrap, without its doc/version.texi stub: make writes that.
    # Not -f: gmp's own config.guess, which picks the CPU, stays.
    autoreconf -i
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gmp \
        --enable-cxx \
        --disable-static \
        --docdir=/sw/gmp/share/doc/gmp-$VERSION
    # doc/version.texi, which the tarball ships: outside maintainer mode
    # make doesn't write it by itself.
    make -C doc stamp-vti
    make
    make html
}

CHECK() {
    make check 2>&1 | tee gmp-check-log
    test "$(awk '/# PASS:/{total+=$3} ; END{print total}' gmp-check-log)" -ge 199
}

INSTALL() {
    make install
    make install-html
    rm -fv $DESTDIR/sw/gmp/lib/libgmp*.la
}
