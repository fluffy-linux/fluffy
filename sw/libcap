if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.78

HAS_LDFLAGS=-lcap

ARCHIVES=(
    0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11 https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-$VERSION.tar.xz
    6d8d0f13b96dd7ec84fd4da53ff4b29f2c59e56af4bc22ebf10aa1b81171362b file://libcap-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i libcap-$VERSION-fluffy-source.patch

    sed -i '/install -m.*STA/d' libcap/Makefile
    make prefix=/sw/libcap lib=lib sbin=bin
}

CHECK() {
    make test
}

INSTALL() {
    make prefix=/sw/libcap lib=lib sbin=bin install
}
