if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.78

# Built straight from Fluffy's branch (our commits on upstream's libcap-2.78
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    814ac4b5da5ed56684d1e7c491fa3c46673a43a4 https://github.com/fluffy-linux/libcap.git#refs/heads/fluffy/libcap-$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        perl
        sed
    )
fi

MAKE() {

    sed -i '/install -m.*STA/d' libcap/Makefile
    make prefix=/sw/libcap lib=lib sbin=bin
}

CHECK() {
    make test
}

INSTALL() {
    make prefix=/sw/libcap lib=lib sbin=bin install
}
