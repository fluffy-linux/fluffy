if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.78

ARCHIVES=(
    0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11 https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-$VERSION.tar.xz
    362bae376e6c93e3fd27e0864ca38b1cc54561ca79155beb599a669340ad1da5 file://libcap-$VERSION-fluffy-shell.patch
    b5ff8c5cefecfd9a9da62b3465690b062ea814ffb6abbdc88eab777deb4d25e9 file://libcap-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    MAKE_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    MAKE_NEEDS=(
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i libcap-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i libcap-$VERSION-fluffy-source.patch

    sed -i '/install -m.*STA/d' libcap/Makefile
    make prefix=/sw/libcap lib=lib sbin=bin
}

if test -v CROSS
then
    CHECK_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
    )
else
    CHECK_NEEDS=(
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        sed
    )
fi

CHECK() {
    make test
}

if test -v CROSS
then
    INSTALL_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
    )
else
    INSTALL_NEEDS=(
        bash
        binutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        sed
    )
fi

INSTALL() {
    make prefix=/sw/libcap lib=lib sbin=bin install
}
