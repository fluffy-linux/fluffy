if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=0.26.5

# Built straight from Fluffy's branch (our commits on upstream's 0.26.5
# tag, BLFS's anchor hook among them): swctl fetches the pinned commit,
# and the pkcs11-json commit it pins, with git.  Built with meson, as
# BLFS 13.1-systemd builds it; the man pages are made with xsltproc.  The
# release tarball's prebuilt gtk-doc HTML manual is not installed: BLFS
# doesn't build it, and Fluffy has no gtk-doc.
ARCHIVES=(
    6d2fdf3034295c9775a058c273b1dfc0740888b0 https://github.com/fluffy-linux/p11-kit.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc
    libffi
    libtasn1
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        docbook-xml
        docbook-xsl-nons
        gcc
        gettext
        glibc
        grep
        libffi
        libgcc
        libtasn1
        libxslt
        linux-headers
        make-pass1
        meson
        ninja
        patch-pass1
        pkgconf
        python
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        docbook-xml
        docbook-xsl-nons
        gcc
        gettext
        glibc
        grep
        libffi
        libgcc
        libtasn1
        libxslt
        linux-headers
        make
        meson
        ninja
        patch
        pkgconf
        python
        sed
        tar
        xz
    )
fi

MAKE() {
    mkdir -p build
    cd build
    meson setup .. \
        --prefix=/sw/p11-kit \
        --sysconfdir=/sw/p11-kit/etc \
        --buildtype=release \
        --wrap-mode=nofallback \
        -D trust_paths=/etc/pki/anchors:/sw/ca-certificates/etc/ssl/certs/ca-certificates.crt \
        -D bashcompdir=/sw/p11-kit/share/bash-completion/completions \
        -D man=true
    ninja
}

CHECK() {
    meson test -C build --print-errorlogs
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install
    ln -sfv ../libexec/p11-kit/trust-extract-compat \
        $DESTDIR/sw/p11-kit/bin/update-ca-certificates
    ln -sfv ./pkcs11/p11-kit-trust.so $DESTDIR/sw/p11-kit/lib/libnssckbi.so
    find $DESTDIR/sw/p11-kit -name '*.la' -delete
}
