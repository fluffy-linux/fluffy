if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=0.26.5

HAS_CFLAGS=-I/sw/p11-kit/include/p11-kit-1
HAS_LDFLAGS=-lp11-kit

ARCHIVES=(
    f2cc09111e44bf3fea58f023180b33acea90aa82d042d6fbb623fbc5ba033bb7 https://github.com/fluffy-linux/p11-kit/releases/download/$VERSION/p11-kit-$VERSION.tar.xz
    dce356808741d5a1045a2cc9a7d7eb5b834e1a9ab5cf8ed1e41a3c66cd8041b5 file://p11-kit-$VERSION-fluffy-source.patch
    b169b0e9542f6dc06a9474748eedc97c854dc6608bec3a0b1ddc03d202716a33 file://p11-kit-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    libffi
    libtasn1
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        grep
        libffi
        libgcc
        libtasn1
        linux-headers
        make-pass1
        patch-pass1
        python
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libffi
        libgcc
        libtasn1
        linux-headers
        make
        patch
        python
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i p11-kit-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i p11-kit-$VERSION-fluffy-test.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/p11-kit \
        --sysconfdir=/sw/p11-kit/etc \
        --with-trust-paths=/etc/pki/anchors:/sw/ca-certificates/etc/ssl/certs/ca-certificates.crt \
        --disable-static \
        bashcompdir=/sw/p11-kit/share/bash-completion/completions
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    ln -sfv ../libexec/p11-kit/trust-extract-compat \
        $DESTDIR/sw/p11-kit/bin/update-ca-certificates
    ln -sfv ./pkcs11/p11-kit-trust.so $DESTDIR/sw/p11-kit/lib/libnssckbi.so
    find $DESTDIR/sw/p11-kit -name '*.la' -delete
}
