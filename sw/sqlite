if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3530400

# Built straight from Fluffy's branch (our commits on upstream's
# version-3.53.4 tag): swctl fetches the pinned commit with git.  The
# tag is SQLite's canonical source tree; MAKE makes the release's
# autoconf package from it with make amalgamation-tarball, as the
# release was made, and builds that package as LFS does.
ARCHIVES=(
    d79b2dd8ec7bb31de79a3d3af968652cd7f260d5 https://github.com/fluffy-linux/sqlite.git#refs/heads/fluffy/version-3.53.4
)

NEEDS=(
    glibc
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        tcl
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        tcl
        xz
        zlib
    )
fi

MAKE() {
    CROSS="" ./configure
    CROSS="" make amalgamation-tarball
    mkdir autoconf-package
    tar -xf sqlite-autoconf-$VERSION.tar.gz -C autoconf-package \
        --strip-components=1
    cd autoconf-package
    CROSS="" ./configure \
        --prefix=/sw/sqlite \
        --disable-static \
        --enable-fts4 \
        --enable-fts5 \
        --disable-rpath \
        --soname=legacy \
        CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 \
                  -D SQLITE_ENABLE_UNLOCK_NOTIFY=1   \
                  -D SQLITE_ENABLE_DBSTAT_VTAB=1     \
                  -D SQLITE_SECURE_DELETE=1"
    make LDFLAGS.rpath=""
}

CHECK() {
    make -C autoconf-package check
}

INSTALL() {
    make -C autoconf-package install
}
