if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0.8

# Built straight from Fluffy's branch (our commits on upstream's
# bzip2-1.0.8 tag): swctl fetches the pinned commit with git.  The tag has
# no manual.html, manual.pdf or manual.ps, so this installs no manual for
# now (the user's decision, 2026-11-21): building manual.html needs the
# DocBook tools, which need bash, perl and python, which need bzip2, a
# cycle that only a separate bzip2-doc package would break.
ARCHIVES=(
    4435604aa824f4e8808c9888f902cbac14c97236 https://github.com/fluffy-linux/bzip2.git#refs/heads/fluffy/bzip2-$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        gcc-pass2
        glibc
        libgcc
        linux-headers
        make-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        gcc
        glibc
        libgcc
        linux-headers
        make
    )
fi

MAKE() {
    make -f Makefile-libbz2_so
    make clean
    make bzip2 bzip2recover
}

CHECK() {
    make test
}

INSTALL() {
    make PREFIX=$DESTDIR/sw/bzip2 install
    cp -av libbz2.so.* $DESTDIR/sw/bzip2/lib
    ln -sfv libbz2.so.$VERSION $DESTDIR/sw/bzip2/lib/libbz2.so
    ln -sfv libbz2.so.$VERSION $DESTDIR/sw/bzip2/lib/libbz2.so.1
    cp -v bzip2-shared $DESTDIR/sw/bzip2/bin/bzip2
    for i in $DESTDIR/sw/bzip2/bin/{bzcat,bunzip2}
    do
        ln -sfv bzip2 "$i"
    done
    rm -fv $DESTDIR/sw/bzip2/lib/libbz2.a
}
