if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0.8

HAS_LDFLAGS=-lbz2

ARCHIVES=(
    ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269 https://www.sourceware.org/pub/bzip2/bzip2-$VERSION.tar.gz
    b6e179e81e1732c2b97552b07b702daac383b7a186e8cbca2d466fbfa1e574b0 file://bzip2-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        gcc-pass2
        glibc
        libgcc
        linux-headers
        make-pass1
        patch-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        gcc
        glibc
        libgcc
        linux-headers
        make
        patch
    )
fi

MAKE() {
    patch -Z -Np1 -i bzip2-$VERSION-fluffy-source.patch
    make -f Makefile-libbz2_so
    make clean
    make bzip2 bzip2recover
}

CHECK() {
    make test
}

INSTALL() {
    make PREFIX=$DESTDIR/sw/bzip2 install
    cp -av libbz2.so.* $DESTDIR/sw/bzip2/lib
    ln -sfv libbz2.so.$VERSION $DESTDIR/sw/bzip2/lib/libbz2.so
    ln -sfv libbz2.so.$VERSION $DESTDIR/sw/bzip2/lib/libbz2.so.1
    cp -v bzip2-shared $DESTDIR/sw/bzip2/bin/bzip2
    for i in $DESTDIR/sw/bzip2/bin/{bzcat,bunzip2}
    do
        ln -sfv bzip2 "$i"
    done
    rm -fv $DESTDIR/sw/bzip2/lib/libbz2.a
}
