if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.12

# Built straight from Fluffy's branch (our commits on upstream's v3.12
# tag): swctl fetches the pinned commit, and the gnulib and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it, and its
# translations come from the Translation Project's files, merged as the
# release's make dist did.
ARCHIVES=(
    e0e298fb622a721ac86d6b8bc20bdd16833a20ac https://github.com/fluffy-linux/grep.git#refs/heads/fluffy/v$VERSION
    1996f5b17a22cc4056860b7bc807dc061e1c4368 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    a88a8c2541f3fcb0137de63799a80e31e5435ae4 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc
    pcre2
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        pcre2
        perl-pass1
        pkgconf
        sed-pass1
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        pcre2
        perl
        pkgconf
        sed
        tar
        texinfo
        xz
    )
fi

# Bootstrapped with the autotools grep's release tarball was made with:
# development snapshots of autoconf and automake.  gettext gives
# bootstrap autopoint, and the build xgettext, msgmerge and msgfmt.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/grep
    # The translations as make dist merges them with grep.pot.
    make -C po update-po
    make
}

CHECK() {
    make -C tests check
    make -C gnulib-tests 'LOG_COMPILER=bash -c '\''case "$$0" in *.sh) exec bash "$$0" "$$@";; *) exec "$$0" "$$@";; esac'\''' check
}

INSTALL() {
    make install
}
