if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.12

ARCHIVES=(
    2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9 https://ftpmirror.gnu.org/grep/grep-$VERSION.tar.xz
    e1c951e867e80d1918bee4eafcd47a5161d5277a6727c235aa962347d651c54e file://grep-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    pcre2
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        pcre2
        perl-pass1
        sed-pass1
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        pcre2
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i grep-$VERSION-fluffy-source.patch

    sed -i "s/echo/#echo/" src/egrep.sh
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/grep
    make
}

CHECK() {
    make -C tests check
    make -C gnulib-tests 'LOG_COMPILER=bash -c '\''case "$$0" in *.sh) exec bash "$$0" "$$@";; *) exec "$$0" "$$@";; esac'\''' check
}

INSTALL() {
    make install
}
