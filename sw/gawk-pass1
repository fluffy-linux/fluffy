ON=host-build

VERSION=5.4.1

ARCHIVES=(
    07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37 https://ftpmirror.gnu.org/gawk/gawk-$VERSION.tar.xz
    b9956cc9d1a2e50130c28244399853946ba76fa8896102e15f28398946c98ef4 file://gawk-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i gawk-$VERSION-fluffy-source.patch
    sed -i 's/extras//' Makefile.in
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/gawk \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
