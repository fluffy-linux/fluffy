ON=host-build

VERSION=5.4.1

# Built straight from Fluffy's branch (our commits on upstream's
# gawk-5.4.1 tag): swctl fetches the pinned commit with git.  The tag
# carries configure and the Makefile.in files; make builds the info
# manuals the release tarball ships, with the host's makeinfo.
ARCHIVES=(
    5c137f95a170ffc7abc62c061bd0abeefda17f23 https://github.com/fluffy-linux/gawk.git#refs/heads/fluffy/gawk-$VERSION
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/gawk \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
