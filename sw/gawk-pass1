ON=host-build

VERSION=5.4.1

ARCHIVES=(
    07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37 https://github.com/fluffy-linux/gawk/releases/download/gawk-$VERSION/gawk-$VERSION.tar.xz
    1c803aa39dca0607d70be7290fee8ba52afdf3f16f02b2c07c6aab342f6df38a file://gawk-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    patch -Z -Np1 -i gawk-$VERSION-fluffy-source.patch
    sed -i 's/extras//' Makefile.in
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/gawk \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
