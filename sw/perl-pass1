ON=cross-build

VERSION=5.44.0

# Built straight from Fluffy's branch (our commits on upstream's v5.44.0
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    40d6bf8e2be17416be5a43f62c7c33af22cb6ef7 https://github.com/fluffy-linux/perl5.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    linux-headers
    make-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    sh Configure -des \
        -D prefix=/sw/perl \
        -D vendorprefix=/sw/perl \
        -D useshrplib \
        -D privlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D archlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D sitelib=/sw/perl/lib/perl5/5.44/site_perl \
        -D sitearch=/sw/perl/lib/perl5/5.44/site_perl \
        -D vendorlib=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D vendorarch=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D otherlibdirs="/sw/*/lib/perl5/5.44/site_perl:/sw/*/lib/perl5/5.44/vendor_perl" \
        -D man1dir=none \
        -D man3dir=none \
        -D sh=/sw/bash/bin/bash \
        -D targetsh=/sw/bash/bin/bash \
        -D locincpth="" \
        -D loclibpth=""
    make
}

INSTALL() {
    make install
}
