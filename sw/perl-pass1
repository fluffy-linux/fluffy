ON=cross-build

VERSION=5.44.0

ARCHIVES=(
    505cf43912e9480495c344c70260452e32aa2a73c546a026b3f100053b23ce91 https://www.cpan.org/src/5.0/perl-$VERSION.tar.xz
    02bcb501257e1256771a4832977aeea1761ff4442501f29e631a5aed90a60e2b file://perl-$VERSION-fluffy-shell.patch
    e6ff3e538acbaa3823fef31c2f230a004c3fe19ab104837bf340612a9330cb6b file://perl-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    grep-pass1
    gzip-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i perl-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i perl-$VERSION-fluffy-test.patch
    sh Configure -des \
        -D prefix=/sw/perl \
        -D vendorprefix=/sw/perl \
        -D useshrplib \
        -D privlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D archlib=/sw/perl/lib/perl5/5.44/core_perl \
        -D sitelib=/sw/perl/lib/perl5/5.44/site_perl \
        -D sitearch=/sw/perl/lib/perl5/5.44/site_perl \
        -D vendorlib=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D vendorarch=/sw/perl/lib/perl5/5.44/vendor_perl \
        -D man1dir=none \
        -D man3dir=none \
        -D targetsh=/sw/bash/bin/bash \
        -D locincpth="" \
        -D loclibpth=""
    make
}

INSTALL() {
    make install
}
