ON=host-build

VERSION=3.12

ARCHIVES=(
    2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9 https://github.com/fluffy-linux/grep/releases/download/v$VERSION/grep-$VERSION.tar.xz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    # egrep and fgrep are scripts whose #! line is configure's shell, the
    # host's /bin/bash otherwise, which doesn't exist inside the root (and
    # then binutils' configure, testing makeinfo through egrep, decides
    # it is missing).
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/grep \
        --host=$FLUFFY_TGT \
        --build=$(./build-aux/config.guess)
    make
}

INSTALL() {
    make install
}
