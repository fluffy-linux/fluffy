ON=host-build

VERSION=3.12

# Built straight from Fluffy's branch, as grep is: the host's autotools
# build the ones grep's release tarball was made with, and bootstrap runs
# the host's autopoint.  bootstrap copies pkg-config's pkg.m4 into m4/
# and refuses the host's (serial 12): it takes pkgconf-pass1's, as grep
# takes pkgconf's.
ARCHIVES=(
    10099f47ab61637b8a63040b565c4e5b67d974ab https://github.com/fluffy-linux/grep.git#refs/heads/fluffy/v$VERSION
    1996f5b17a22cc4056860b7bc807dc061e1c4368 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    a88a8c2541f3fcb0137de63799a80e31e5435ae4 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
    pkgconf-pass1
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    # egrep and fgrep are scripts whose #! line is configure's shell, the
    # host's /bin/bash otherwise, which doesn't exist inside the root (and
    # then binutils' configure, testing makeinfo through egrep, decides
    # it is missing).
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/grep \
        --host=$FLUFFY_TGT \
        --build=$(./build-aux/config.guess)
    # The translations as make dist merges them with grep.pot.
    make -C po update-po
    make
}

INSTALL() {
    make install
}
