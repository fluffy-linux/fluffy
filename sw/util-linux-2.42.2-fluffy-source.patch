+		if (end > p) {
+			if (d != s)
+				*d++ = ':';
+			if (d != p)
+				memmove(d, p, (size_t)(end - p));
+			d += (size_t)(end - p);
+		}
+		if (*end == '\0')
+			break;
+		p = end + 1;
+	}
+	*d = '\0';
+}
