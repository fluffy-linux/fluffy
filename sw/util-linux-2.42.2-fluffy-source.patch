+static const char *fsck_next_path_colon(const char *p)
+{
+	while (*p != '\0' && *p != ':') {
+		if (*p == '[') {
+			const char *q = p + 1;
+			if (*q == '!' || *q == '^')
+				q++;
+			if (*q == ']')
+				q++;
+			while (*q != '\0' && *q != ']' && *q != '/') {
+				if (*q == '[' &&
+				    (q[1] == ':' || q[1] == '.' || q[1] == '=')) {
+					char ctype = q[1];
+					const char *inner = q + 2;
+					while (*inner != '\0' && *inner != '/' &&
+					       (ctype == '.' || *inner != ']') &&
+					       !(*inner == ctype && inner[1] == ']'))
+						inner++;
+					if (*inner == ctype && inner[1] == ']') {
+						q = inner + 2;
+						continue;
+					}
+				}
+				q++;
+			}
