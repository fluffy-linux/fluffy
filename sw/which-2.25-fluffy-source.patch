+static char *escape_glob_backslash(const char *s)
+{
+  size_t extra = 0;
+  for (const char *p = s; *p; ++p)
+    if (*p == '\\' || *p == '*' || *p == '?' || *p == '[')
+      ++extra;
+  char *out = (char *) xmalloc(strlen(s) + extra + 1);
+  char *d = out;
+  for (const char *p = s; *p; ++p)
+  {
+    if (*p == '\\' || *p == '*' || *p == '?' || *p == '[')
+      *d++ = '\\';
+    *d++ = *p;
+  }
+  *d = '\0';
+  return out;
+}
+
+static int has_unescaped_wild(const char *s)
+{
+  for (const char *p = s; *p; ++p)
+  {
+    if (*p == '\\' && p[1] != '\0')
+    {
+      ++p;
+      continue;
+    }
+    if (*p == '*' || *p == '?' || *p == '[')
+      return 1;
+  }
+  return 0;
