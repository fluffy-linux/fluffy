diff --no-dereference -Naur binutils-2.47.orig/ld/ldfile.c binutils-2.47/ld/ldfile.c
--- binutils-2.47.orig/ld/ldfile.c	2026-07-25 23:00:00.000000000 +0000
+++ binutils-2.47/ld/ldfile.c	2026-07-25 23:00:00.000000000 +0000
@@ -304,28 +304,99 @@
 /* Adds NAME to the library search path.
    Makes a copy of NAME using xmalloc().  */
 
-void
-ldfile_add_library_path (const char *name, bool cmdline)
+static void
+ldfile_add_literal_library_path (const char *name, bool cmdline)
 {
   search_dirs_type *new_dirs;
 
-  if (!cmdline && config.only_cmd_line_lib_dirs)
-    return;
-
   new_dirs = (search_dirs_type *) xmalloc (sizeof (search_dirs_type));
   new_dirs->next = NULL;
   new_dirs->cmdline = cmdline;
   *search_tail_ptr = new_dirs;
   search_tail_ptr = &new_dirs->next;
+  new_dirs->name = xstrdup (name);
+}
+
+static char *
+ldfile_escape_glob_prefix (const char *s)
+{
+  size_t len = strlen (s);
+  char *out = (char *) xmalloc (len * 2 + 1);
+  char *q = out;
+
+  for (const char *p = s; *p != '\0'; ++p)
+    {
+      if (*p == '\\' || *p == '*' || *p == '?' || *p == '[')
+	*q++ = '\\';
+      *q++ = *p;
+    }
+  *q = '\0';
+  return out;
+}
+
+void
+ldfile_add_library_path (const char *name, bool cmdline)
+{
+  const char *suffix = name;
+  bool use_sysroot = false;
+
+  if (!cmdline && config.only_cmd_line_lib_dirs)
+    return;
 
   /* If a directory is marked as honoring sysroot, prepend the sysroot path
-     now.  */
+     now before checking the pattern suffix for wildcards.  */
   if (name[0] == '=')
-    new_dirs->name = concat (ld_sysroot, name + 1, (const char *) NULL);
+    {
+      suffix = name + 1;
+      use_sysroot = true;
+    }
   else if (startswith (name, "$SYSROOT"))
-    new_dirs->name = concat (ld_sysroot, name + strlen ("$SYSROOT"), (const char *) NULL);
-  else
-    new_dirs->name = xstrdup (name);
+    {
+      suffix = name + strlen ("$SYSROOT");
+      use_sysroot = true;
+    }
+
+  char *full = use_sysroot ? concat (ld_sysroot, suffix, (const char *) NULL)
+			   : NULL;
+  const char *cand = use_sysroot ? full : name;
+  struct stat st;
+
+  /* Check literal directory existence first so explicit paths containing
+     metacharacters (e.g. -L /tmp/build[1]/lib) are preserved verbatim.  */
+  if (stat (cand, &st) == 0 && S_ISDIR (st.st_mode))
+    {
+      ldfile_add_literal_library_path (cand, cmdline);
+      free (full);
+      return;
+    }
+
+  if (strpbrk (suffix, "*?[") != NULL)
+    {
+      char *esc_sysroot = use_sysroot ? ldfile_escape_glob_prefix (ld_sysroot)
+				      : NULL;
+      char *pat = use_sysroot ? concat (esc_sysroot, suffix, (const char *) NULL)
+			      : NULL;
+      glob_t globbuf;
+
+      memset (&globbuf, 0, sizeof (globbuf));
+      int gr = glob (use_sysroot ? pat : suffix, GLOB_ONLYDIR, NULL, &globbuf);
+      if (gr == 0)
+	{
+	  size_t i;
+	  for (i = 0; i < globbuf.gl_pathc; i++)
+	    ldfile_add_literal_library_path (globbuf.gl_pathv[i], cmdline);
+	}
+      else if (gr == GLOB_NOMATCH && cmdline)
+	ldfile_add_literal_library_path (cand, cmdline);
+      globfree (&globbuf);
+      free (pat);
+      free (esc_sysroot);
+      free (full);
+      return;
+    }
+
+  ldfile_add_literal_library_path (cand, cmdline);
+  free (full);
 }
 
 static void
