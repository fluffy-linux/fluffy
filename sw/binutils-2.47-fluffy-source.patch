+/* Map or build a temporary FSWC view for execvpe when GLRO(dl_fluffy_cache)
+   is unavailable or stale.  Caller MUST munmap (*out_temp_map, view->map_size)
+   before calling __execve so CLONE_VM | CLONE_VFORK parents never leak VMAs.  */
+static bool
+fswc_execvpe_open_view (const char *prefix, size_t prefix_len,
+                        struct fswc_view *out_view, void **out_temp_map)
+{
+  *out_temp_map = NULL;
+  if (prefix_len == 0 || prefix_len > 0x00ffffffU || fswc_is_secure_mode ())
+    return false;
+
+  bool is_sw = fswc_is_sw_prefix (prefix, prefix_len);
+  if (is_sw)
+    {
+# ifdef FSWC_EXEC_HAVE_GLRO
+      if (GLRO (dl_fluffy_cache) != NULL && GLRO (dl_fluffy_cache_size) != 0)
+        {
+          const struct fswc_header *gh
+            = (const struct fswc_header *) GLRO (dl_fluffy_cache);
+          if ((gh->flags & FSWC_HDR_SEALED) != 0
+              && fswc_init_view (gh, GLRO (dl_fluffy_cache_size), out_view))
+            return true;
+        }
+# endif
+      uid_t seuid = (uid_t) FC_SYSCALL0 (geteuid);
+      void *sptr = fswc_try_acquire_sealed (seuid, prefix, prefix_len,
+                                            NULL, out_view);
+      if (sptr != NULL)
+        {
+          *out_temp_map = sptr;
+          return true;
+        }
+    }
+
+  struct statx stx;
+  uint32_t mnt_count = 0;
+  uint64_t mnt_h1 = 0, mnt_h2 = 0;
+  if (fswc_get_prefix_state (prefix, &stx, &mnt_count, &mnt_h1, &mnt_h2) < 0)
+    return false;
+
+# ifdef FSWC_EXEC_HAVE_GLRO
+  if (GLRO (dl_fluffy_cache) != NULL && GLRO (dl_fluffy_cache_size) != 0)
+    {
+      struct fswc_view glro_v;
+      if (fswc_init_view (GLRO (dl_fluffy_cache), GLRO (dl_fluffy_cache_size),
+                          &glro_v)
+          && fswc_view_matches (&glro_v, prefix, prefix_len, &stx,
+                                mnt_count, mnt_h1, mnt_h2))
+        {
+          *out_view = glro_v;
+          return true;
+        }
+    }
+# endif
+
+  uid_t euid = (uid_t) FC_SYSCALL0 (geteuid);
+  void *stale_ptr = NULL;
+  struct fswc_view stale_view;
+  void *shm_ptr = fswc_map_shm_matching (euid, prefix, prefix_len, &stx,
+                                         mnt_count, mnt_h1, mnt_h2,
+                                         out_view, &stale_ptr, &stale_view);
+  if (shm_ptr != NULL)
+    {
+      *out_temp_map = shm_ptr;
+      return true;
+    }
+
+  void *built = fswc_build_and_publish (stale_ptr != NULL ? &stale_view : NULL,
+                                        prefix, prefix_len, &stx,
+                                        mnt_count, mnt_h1, mnt_h2, euid,
+                                        out_view);
+  if (stale_ptr != NULL)
+    FC_SYSCALL (munmap, stale_ptr, stale_view.map_size);
+  if (built == NULL)
+    return false;
+
+  *out_temp_map = built;
+  return true;
+}
