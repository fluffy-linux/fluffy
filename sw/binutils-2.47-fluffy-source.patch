+static inline void
+fswc_glob_release_view (bool locked)
+{
+# ifdef _LIBC
+  if (locked)
+    __libc_lock_unlock (fc_lock);
+# else
+  (void) locked;
+# endif
+}
+
+static int
+fc_append_match (glob_t *pglob, const char *prefix, size_t prefix_len,
+                 const char *pkg, size_t pkg_len,
+                 const char *sub1, size_t sub1_len,
+                 const char *sub2, size_t sub2_len,
+                 bool add_slash)
+{
+  size_t newcount = pglob->gl_pathc + pglob->gl_offs;
+  if (newcount > SIZE_MAX / sizeof (char *) - 2U)
+    return GLOB_NOSPACE;
+  char **new_pathv = (char **) (pglob->gl_pathv == NULL
+                                ? malloc ((newcount + 2U) * sizeof (char *))
+                                : realloc (pglob->gl_pathv,
+                                           (newcount + 2U) * sizeof (char *)));
+  if (new_pathv == NULL)
+    return GLOB_NOSPACE;
+  pglob->gl_pathv = new_pathv;
+
+  size_t p_eff = (prefix_len == 1U && prefix[0] == '/') ? 0U : prefix_len;
+  size_t total_len = (p_eff + 1U + pkg_len + 1U + sub1_len
+                      + (sub2 != NULL ? 1U + sub2_len : 0U)
+                      + (add_slash ? 1U : 0U));
+  char *str = (char *) malloc (total_len + 1U);
+  if (str == NULL)
+    return GLOB_NOSPACE;
+
+  char *q = str;
+  if (p_eff > 0)
+    {
+      memcpy (q, prefix, p_eff);
+      q += p_eff;
+    }
+  *q++ = '/';
+  memcpy (q, pkg, pkg_len);
+  q += pkg_len;
+  *q++ = '/';
+  memcpy (q, sub1, sub1_len);
+  q += sub1_len;
+  if (sub2 != NULL)
+    {
+      *q++ = '/';
+      memcpy (q, sub2, sub2_len);
+      q += sub2_len;
+    }
+  if (add_slash)
+    *q++ = '/';
+  *q = '\0';
+
+  pglob->gl_pathv[newcount] = str;
+  pglob->gl_pathv[newcount + 1U] = NULL;
+  ++pglob->gl_pathc;
+  return 0;
+}
+
+static int
+fswc_emit_ht_matches (const struct fswc_view *v,
+                      const struct fswc_ht_entry *e,
+                      const char *prefix, size_t prefix_len,
+                      const char *sub1, size_t sub1_len,
+                      const char *sub2, size_t sub2_len,
+                      int flags, glob_t *pglob)
+{
+  bool only_dir = (flags & GLOB_ONLYDIR) != 0;
+  uint32_t raw_cnt = only_dir ? e->dir_count : e->all_count;
+  uint32_t raw_ref = only_dir ? e->dir_ref : e->all_ref;
+  uint32_t inline_slot = 0;
+  uint32_t nfound = 0;
+  const uint32_t *list = fswc_posting_slice (v, raw_cnt, raw_ref,
+                                             &inline_slot, &nfound);
+  if (nfound == 0 || list == NULL)
+    return 0;
+
+  size_t cur_idx = pglob->gl_pathc + pglob->gl_offs;
+  if (cur_idx > SIZE_MAX / sizeof (char *) - (size_t) nfound - 2U)
+    return GLOB_NOSPACE;
+  size_t alloc_slots = cur_idx + (size_t) nfound + 1U;
+  char **new_pathv = (char **) (pglob->gl_pathv == NULL
+                                ? malloc (alloc_slots * sizeof (char *))
+                                : realloc (pglob->gl_pathv,
+                                           alloc_slots * sizeof (char *)));
+  if (new_pathv == NULL)
+    return GLOB_NOSPACE;
+  pglob->gl_pathv = new_pathv;
+
+  size_t p_eff = (prefix_len == 1U && prefix[0] == '/') ? 0U : prefix_len;
+  bool want_mark = (flags & GLOB_MARK) != 0;
+
+  for (uint32_t i = 0; i < nfound; ++i)
+    {
+      uint32_t pkg_idx = list[i];
+      if (pkg_idx >= v->hdr->num_pkgs)
+        continue;
+      const struct fswc_pkg *pk = &v->pkgs[pkg_idx];
+      const char *pkg = v->strtab + pk->name_off;
+      size_t pkg_len = pk->name_len;
+      bool add_slash = (want_mark
+                        && (only_dir
+                            || fswc_posting_contains (v, e->dir_count,
+                                                      e->dir_ref, pkg_idx)));
+      size_t total_len = (p_eff + 1U + pkg_len + 1U + sub1_len
+                          + (sub2 != NULL ? 1U + sub2_len : 0U)
+                          + (add_slash ? 1U : 0U));
+      char *str = (char *) malloc (total_len + 1U);
+      if (str == NULL)
+        {
+          pglob->gl_pathv[pglob->gl_offs + pglob->gl_pathc] = NULL;
+          return GLOB_NOSPACE;
+        }
+
+      char *q = str;
+      if (p_eff > 0)
+        {
+          memcpy (q, prefix, p_eff);
+          q += p_eff;
+        }
+      *q++ = '/';
+      memcpy (q, pkg, pkg_len);
+      q += pkg_len;
+      *q++ = '/';
+      memcpy (q, sub1, sub1_len);
+      q += sub1_len;
+      if (sub2 != NULL)
+        {
+          *q++ = '/';
+          memcpy (q, sub2, sub2_len);
+          q += sub2_len;
+        }
+      if (add_slash)
+        *q++ = '/';
+      *q = '\0';
+
+      pglob->gl_pathv[pglob->gl_offs + pglob->gl_pathc++] = str;
+    }
+  pglob->gl_pathv[pglob->gl_offs + pglob->gl_pathc] = NULL;
+  return 0;
+}
