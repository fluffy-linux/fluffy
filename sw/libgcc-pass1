ON=host-build

VERSION=16.2.0

# Upstream's releases/gcc-16.2.0 tag, as our fork has it: swctl fetches
# the pinned tag with git.  No Fluffy commits: the stock
# source, as the release tarball was.
ARCHIVES=(
    1831ac03fd08e3400c16b29f21762e6b326a618d https://github.com/fluffy-linux/gcc.git#refs/tags/releases/gcc-$VERSION
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    binutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    sed '/thread_header =/s/@.*@/gthr-posix.h/' \
        -i libgcc/Makefile.in libgcc/configure
    sed 's|^gcc_objdir =.*|gcc_objdir = ./gcc|' \
        -i libgcc/Makefile.in

    mkdir -v build
    cd build

    mkdir -pv gcc/include
    ln -sv "$($FLUFFY_TGT-gcc -print-file-name=plugin)"/include/* gcc/
    cat > gcc/tconfig.h << 'END'
#ifndef GCC_TCONFIG_H
#define GCC_TCONFIG_H
#ifndef USED_FOR_TARGET
# define USED_FOR_TARGET
#endif
#include "auto-host.h"
#ifdef IN_GCC
# include "ansidecl.h"
#endif
#endif /* GCC_TCONFIG_H */
END
    cat > gcc/libgcc.mvars << 'END'
GCC_CFLAGS = -g -O2 -DIN_GCC -W -Wall -Wno-narrowing -Wwrite-strings -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wold-style-definition -isystem ./include
INHIBIT_LIBC_CFLAGS =
END

    CC=$FLUFFY_TGT-gcc ../libgcc/configure \
        --build=$(../config.guess) \
        --host=$FLUFFY_TGT \
        --target=$FLUFFY_TGT \
        --prefix=/sw/libgcc \
        --enable-shared \
        --disable-multilib \
        gcc_cv_target_thread_file=posix
    make
}

CHECK() {
    cd build
    # The unwinder finds frames through PT_GNU_EH_FRAME: without it every
    # pthread_exit, pthread_cancel and C++ throw aborts, silently.
    $FLUFFY_TGT-readelf -lW libgcc_s.so.1 | grep -q GNU_EH_FRAME
}

INSTALL() {
    cd build
    make install
}
