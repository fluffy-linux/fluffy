if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.16.2

ARCHIVES=(
    0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2 https://github.com/fluffy-linux/dbus/releases/download/dbus-$VERSION/dbus-$VERSION.tar.xz
    d7eaafd3f57d803f85181edd17093d18dd4e0349f85d75e77a88fe9859c52aa1 file://dbus-$VERSION-fluffy-source.patch
    2371a3a2b44d3968dda76cd687dd9f5a86a5d31eef0f02b4a9ecea2e7d9c3e29 file://dbus.passwd
    52e41a94ae1d317eda62cc90c4e0cf67af2161fb845668f020be20962a2ac552 file://dbus.group
)

NEEDS=(
    expat
    glibc
    systemd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expat
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        meson
        ninja
        patch
        pkgconf
        python
        sed
        systemd
        tar
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expat
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        meson
        ninja
        patch
        pkgconf
        python
        sed
        systemd
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i ../dbus-$VERSION-fluffy-source.patch

    mkdir -p build
    cd build

    meson setup .. \
        --prefix=/sw/dbus \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dasserts=false \
        -Dvendor_pkg_prefix=/sw \
        -Dsystem_socket=/run/dbus/system_bus_socket \
        -Dsystem_pid_file=/run/dbus/pid \
        -Dsystemd_system_unitdir=/sw/dbus/lib/systemd/system \
        -Dsystemd_user_unitdir=/sw/dbus/lib/systemd/user

    ninja
}

CHECK() {
    meson test -C build --print-errorlogs
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install

    mkdir -p $DESTDIR/sw/dbus/etc
    install -m 644 ../dbus.passwd $DESTDIR/sw/dbus/etc/passwd
    install -m 644 ../dbus.group $DESTDIR/sw/dbus/etc/group

    rm -rf $DESTDIR/sw/dbus/lib/tmpfiles.d
    mkdir -p $DESTDIR/sw/dbus/var/lib/dbus
    ln -sf /etc/machine-id $DESTDIR/sw/dbus/var/lib/dbus/machine-id
}
