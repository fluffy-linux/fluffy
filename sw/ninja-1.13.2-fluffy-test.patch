diff --no-dereference -Naur ninja-1.13.2.orig/misc/jobserver_test.py ninja-1.13.2/misc/jobserver_test.py
--- ninja-1.13.2.orig/misc/jobserver_test.py	2025-11-20 16:26:20.000000000 +0000
+++ ninja-1.13.2/misc/jobserver_test.py	2025-11-20 16:26:20.000000000 +0000
@@ -319,6 +319,22 @@
             prefix_args=[sys.executable, "-S", _JOBSERVER_POOL_SCRIPT]
         )

+    def test_subprocess_uses_posix_bash(self):
+        # Commands run through _PATH_BSHELL with argv[0] "sh", which on
+        # Fluffy is bash in POSIX mode -- not "bash -c", not another sh.
+        build_plan = r"""
+rule shellcheck
+    command = printf '%s:%s\n' "$${BASH_VERSION:+bash}" "$$SHELLOPTS"
+
+build all: shellcheck
+"""
+        with BuildDir(build_plan) as b:
+            ret = b.ninja_spawn(["--quiet", "all"])
+            self.assertEqual(ret.returncode, 0)
+            shell, opts = ret.stdout.strip().split(":", 1)
+            self.assertEqual(shell, "bash")
+            self.assertIn("posix", opts.split(":"))
+
 
 if __name__ == "__main__":
     unittest.main()
