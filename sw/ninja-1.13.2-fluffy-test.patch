             prefix_args=[sys.executable, "-S", _JOBSERVER_POOL_SCRIPT]
         )
 
+    def test_subprocess_uses_fluffy_bash(self):
+        build_plan = r"""
+rule shellcheck
+    command = printf '%s\n' "$$BASH"
+
+build all: shellcheck
+"""
+        with BuildDir(build_plan) as b:
+            ret = b.ninja_spawn(["--quiet", "all"])
+            self.assertEqual(ret.returncode, 0)
+            self.assertEqual(ret.stdout.strip(), "/sw/bash/bin/bash")
+
 
 if __name__ == "__main__":
     unittest.main()
