ON=host-build

VERSION=16.2.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.4.1
GMP_VERSION=6.3.0

# Built straight from Fluffy's branch (our commits on upstream's
# releases/gcc-16.2.0 tag): swctl fetches the pinned commit with git.  What
# the release tarball ships prebuilt that this build uses (gengtype's
# flex scanner, the info and man pages) the build makes.
ARCHIVES=(
    249a7913825ded5cb6aab9f39eff492057a959e6 https://github.com/fluffy-linux/gcc.git#refs/heads/fluffy/releases/gcc-$VERSION
    b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01 https://github.com/fluffy-linux/mpfr/releases/download/$MPFR_VERSION/mpfr-$MPFR_VERSION.tar.xz
    91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931 https://github.com/fluffy-linux/mpc/releases/download/$MPC_VERSION/mpc-$MPC_VERSION.tar.xz
    a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 https://github.com/fluffy-linux/gmp/releases/download/gmp-$GMP_VERSION/gmp-$GMP_VERSION.tar.xz
)

NEEDS=(
    binutils-pass2
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
)

MAKE() {
    tar -xf ../mpfr-$MPFR_VERSION.tar.xz
    mv -v mpfr-$MPFR_VERSION mpfr
    tar -xf ../mpc-$MPC_VERSION.tar.xz
    mv -v mpc-$MPC_VERSION mpc
    tar -xf ../gmp-$GMP_VERSION.tar.xz
    mv -v gmp-$GMP_VERSION gmp

    mkdir -v build
    cd build

    # Target libstdc++ is linked by the gcc-pass1 driver (CXX_FOR_TARGET),
    # which is --disable-shared and never links libgcc_s: libstdc++.so would
    # reference _Unwind_* with no DT_NEEDED on libgcc_s.so.1.  Add it for
    # -shared links only.
    printf '*libgcc:\n+ %%{shared:-lgcc_s}\n\n' > libgcc_s.specs

    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --build=$(../config.guess) \
        --host=$FLUFFY_TGT \
        --target=$FLUFFY_TGT \
        --prefix=/sw/gcc \
        --with-native-system-header-dir='/sw/*/include' \
        --enable-default-pie \
        --enable-default-ssp \
        --disable-fixincludes \
        --disable-nls \
        --disable-multilib \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libsanitizer \
        --disable-libssp \
        --disable-libvtv \
        --enable-languages=c,c++ \
        CXX_FOR_TARGET="$FLUFFY_TGT-gcc -nostdinc++ -specs=$PWD/libgcc_s.specs" \
        LDFLAGS_FOR_TARGET=-L$PWD/$FLUFFY_TGT/libgcc \
        target_configargs=gcc_cv_target_thread_file=posix
    CONFIG_SITE=/sw/glibc/share/config.site make
}

INSTALL() {
    cd build
    make install
    ln -sv gcc $DESTDIR/sw/gcc/bin/cc
}
