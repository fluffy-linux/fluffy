if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=16.2.0

# Built straight from Fluffy's branch (our commits on upstream's
# releases/gcc-16.2.0 tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    249a7913825ded5cb6aab9f39eff492057a959e6 https://github.com/fluffy-linux/gcc.git#refs/heads/fluffy/releases/gcc-$VERSION
)

if test -v CROSS
then
    NEEDS=(
        glibc-pass1
    )
else
    NEEDS=(
        glibc
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        gawk-pass1
        gcc-pass2
        glibc-pass1
        grep-pass1
        linux-headers
        make-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        gawk
        gcc
        glibc
        grep
        linux-headers
        make
        sed
    )
fi

MAKE() {
    sed 's|^gcc_objdir =.*|gcc_objdir = ./gcc|' \
        -i libgcc/Makefile.in

    mkdir -v build
    cd build

    mkdir -pv gcc/include
    ln -sv "$(gcc -print-file-name=plugin)"/include/* gcc/
    cat > gcc/tconfig.h << 'END'
#ifndef GCC_TCONFIG_H
#define GCC_TCONFIG_H
#ifndef USED_FOR_TARGET
# define USED_FOR_TARGET
#endif
#include "auto-host.h"
#ifdef IN_GCC
# include "ansidecl.h"
#endif
#endif /* GCC_TCONFIG_H */
END
    cat > gcc/libgcc.mvars << 'END'
GCC_CFLAGS = -g -O2 -DIN_GCC -W -Wall -Wno-narrowing -Wwrite-strings -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes -Wold-style-definition -isystem ./include
INHIBIT_LIBC_CFLAGS =
END

    CONFIG_SITE=/sw/glibc/share/config.site CC=gcc ../libgcc/configure \
        --build=$(../config.guess) \
        --host=$(../config.guess) \
        --target=$(../config.guess) \
        --prefix=/sw/libgcc \
        --enable-shared \
        --disable-multilib
    make
}

CHECK() {
    cd build
    make check
}

INSTALL() {
    cd build
    make install
}
