ON=cross-build

VERSION=16.2.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.4.1
GMP_VERSION=6.3.0

ARCHIVES=(
    e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e https://ftpmirror.gnu.org/gcc/gcc-$VERSION/gcc-$VERSION.tar.xz
    b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01 https://ftpmirror.gnu.org/mpfr/mpfr-$MPFR_VERSION.tar.xz
    91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931 https://ftpmirror.gnu.org/mpc/mpc-$MPC_VERSION.tar.xz
    a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898 https://ftpmirror.gnu.org/gmp/gmp-$GMP_VERSION.tar.xz
    14f783de32e23716a14dcb197edae9e130c9b8605374293bec921ad972ca3c78 file://gcc-$VERSION-fluffy-shell.patch
    56d4923478beb3abdd92be03416c40eff9da6427995642cf77b2f20c9fa012cb file://gcc-$VERSION-fluffy-source.patch
    d6e5b7179a943a375757600a250b15e572d713ba12873126524bd25b692ad6be file://mpfr-$MPFR_VERSION-fluffy-shell.patch
    b8a8497e880e35f53687c65dd7bb25ef9cd937ec650c22fddf0fa902ef1d6782 file://mpc-$MPC_VERSION-fluffy-shell.patch
    f771fd5ba22d4f88f767694508ef19a99e649e3c60a0ebef7aa894055b9704b3 file://gmp-$GMP_VERSION-fluffy-shell.patch
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    grep-pass1
    linux-headers
    m4-pass1
    make-pass1
    patch-pass1
    sed-pass1
)

MAKE() {
    mv -v mpfr-$MPFR_VERSION mpfr
    mv -v mpc-$MPC_VERSION mpc
    mv -v gmp-$GMP_VERSION gmp

    patch -Z -Np1 -i gcc-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i gcc-$VERSION-fluffy-source.patch
    patch -Z -Np1 -d mpfr -i ../mpfr-$MPFR_VERSION-fluffy-shell.patch
    patch -Z -Np1 -d mpc -i ../mpc-$MPC_VERSION-fluffy-shell.patch
    patch -Z -Np1 -d gmp -i ../gmp-$GMP_VERSION-fluffy-shell.patch

    sed -e '/m64=/s/lib64/lib/' \
        -i gcc/config/i386/t-linux64
    cat >> gcc/config/i386/linux64.h << EOF
#undef GLIBC_DYNAMIC_LINKER64
#define GLIBC_DYNAMIC_LINKER64 "/sw/glibc/lib/ld-linux-x86-64.so.2"
#undef STARTFILE_PREFIX_SPEC
#define STARTFILE_PREFIX_SPEC "/sw/*/lib/"
#undef MD_EXEC_PREFIX
#define MD_EXEC_PREFIX "/sw/*/bin/"
EOF

    mkdir -v build
    cd build

    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/libgcc \
        --with-native-system-header-dir='/sw/*/include' \
        --disable-fixincludes \
        --enable-shared \
        --disable-multilib \
        --disable-bootstrap \
        --disable-libatomic \
        --disable-libgomp \
        --disable-libquadmath \
        --disable-libsanitizer \
        --disable-libssp \
        --disable-libvtv \
        --enable-languages=c
    CONFIG_SITE=/sw/glibc/share/config.site make all-target-libgcc
}

INSTALL() {
    cd build
    make install-target-libgcc
}
