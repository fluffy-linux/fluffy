if test -v CROSS
then
    ON=host-build
else
    ON=fluffy-build
fi

VERSION=7.1.8

# Built straight from Fluffy's branch (our commits on upstream's v7.1.8
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    ee53a5abd9bfd9e178465c183bab6aed413a8e49 https://github.com/fluffy-linux/linux.git#refs/heads/fluffy/v$VERSION
)

if ! test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        findutils
        gcc
        glibc
        grep
        libgcc
        make
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    make mrproper
    make headers
    find usr/include -type f ! -name '*.h' -delete
}

INSTALL() {
    cp -rv usr/include $DESTDIR/sw/linux-headers
}
