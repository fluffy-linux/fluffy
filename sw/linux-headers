if test -v CROSS
then
    ON=host-build
else
    ON=fluffy-build
fi

VERSION=7.1.8

ARCHIVES=(
    ff01dcb449279d5b4cfccdb01fee639cf5ff1803f1749a77844dd33915422c49 https://github.com/fluffy-linux/linux/releases/download/v$VERSION/linux-$VERSION.tar.xz
)

if ! test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        findutils
        gcc
        glibc
        grep
        libgcc
        make
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    make mrproper
    make headers
    find usr/include -type f ! -name '*.h' -delete
}

INSTALL() {
    cp -rv usr/include $DESTDIR/sw/linux-headers
}
