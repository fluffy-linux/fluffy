if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.4.1

# Built straight from Fluffy's branch (upstream's 1.4.1 tag): swctl
# fetches the pinned commit with git.  The tag has no configure,
# Makefile.in or mpc.info, so MAKE regenerates them with the autoconf,
# automake and libtool the release tarball was made with (2.72, 1.17,
# 2.4.7), from their Fluffy branches.
ARCHIVES=(
    532a18ae8222f928c58f7ffd1b4f0122062172bd https://github.com/fluffy-linux/mpc.git#refs/heads/fluffy/$VERSION
    770e5e68703124021d82b15817a2d50718f83676 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    c47d100eab0ff3b64e16811f6b3925b233085497 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc
    gmp
    mpfr
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        gmp
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        mpfr
        patch-pass1
        perl-pass1
        sed-pass1
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        gmp
        grep
        libgcc
        linux-headers
        make
        mpfr
        patch
        perl
        sed
        texinfo
    )
fi

# Regenerated with the autotools mpc's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpc \
        --disable-static \
        --docdir=/sw/mpc/share/doc/mpc-$VERSION
    make
    make html
}

CHECK() {
    make check
}

INSTALL() {
    make install
    make install-html
    rm -fv $DESTDIR/sw/mpc/lib/libmpc.la
}
