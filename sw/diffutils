if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.12

# Built straight from Fluffy's branch (our commits on upstream's v3.12
# tag): swctl fetches the pinned commit, and the gnulib and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it with the
# autotools diffutils' release tarball was made with (development
# snapshots), and its translations come from the Translation Project's
# files, merged as the release's make dist did.
ARCHIVES=(
    ccbabc3eef9e170ac2176764dc7a12aa0e33a1ba https://github.com/fluffy-linux/diffutils.git#refs/heads/fluffy/v$VERSION
    1996f5b17a22cc4056860b7bc807dc061e1c4368 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    a88a8c2541f3fcb0137de63799a80e31e5435ae4 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        gperf
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl
        pkgconf
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        gperf
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        pkgconf
        sed
        tar
        texinfo
        xz
    )
fi

# Bootstrapped with the autotools diffutils' release tarball was made
# with.  bootstrap runs autopoint and gzip, the build gperf (gnulib's
# lookup tables), xgettext, msgmerge and msgfmt (the translations),
# makeinfo (the manual) and perl (man/help2man, for the man pages), which
# the release tarball ships made; bootstrap also copies pkgconf's pkg.m4.
# texinfo comes after diffutils and needs it, so in cross-build
# texinfo-pass1 stands in.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    ac_cv_path_PR_PROGRAM=pr CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/diffutils
    # The translations as make dist merges them with diffutils.pot.
    make -C po update-po
    # The manual is dated by diffutils.texi's time, as the release's is
    # (git gives every file the commit's).
    touch -d '2025-01-12 12:00 UTC' doc/diffutils.texi
    # The release's man pages are dated by the release (its v3.12 tag,
    # April 2025); man/help2man dates them by SOURCE_DATE_EPOCH.
    SOURCE_DATE_EPOCH=1744166239 make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
