if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.18.1

# Built straight from Fluffy's branch (our commits on upstream's v1.18.1
# tag): swctl fetches the pinned commit with git.  The tag has no
# configure or Makefile.in; its bootstrap makes them with autoconf-pass1
# in cross-build, the previous autoconf in fluffy-build.  The man pages
# come from the help2man automake carries.
ARCHIVES=(
    d6fb77e1155d440250377e2da51ba4c3de019560 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v$VERSION
)

if test -v CROSS
then
    NEEDS=(
        autoconf
        bash
        coreutils-pass1
        grep
        m4
        perl
        sed
        texinfo-pass1
    )
else
    NEEDS=(
        autoconf
        bash
        coreutils
        grep
        m4
        perl
        sed
        texinfo
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf-pass1
        bash
        binutils
        bison
        bzip2
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        flex
        gawk-pass1
        gcc
        gettext
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make-pass1
        perl
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        autoconf
        bash
        binutils
        bison
        bzip2
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make
        perl
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./bootstrap
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/automake \
        --docdir=/sw/automake/share/doc/automake-$VERSION
    make
}

CHECK() {
    make -j$(($(nproc)>4?$(nproc):4)) check
}

# aclocal finds other packages' macros (libtool's, pkgconf's, gettext's)
# through a dirlist in its own macro directory; its lines may be globs.
INSTALL() {
    make install
    echo '/sw/*/share/aclocal' > $DESTDIR/sw/automake/share/aclocal/dirlist
}
