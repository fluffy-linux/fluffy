if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.2

# Built straight from Fluffy's branch (upstream's 4.0.2 tag; Fluffy has no
# commits on it): swctl fetches the pinned commit with git.  flit_core is
# the flit_core directory of the flit repository, which is what its
# release tarball holds.
ARCHIVES=(
    60c0b3d97bf095fbdb7671a02e51f8d8aba2fb85 https://github.com/fluffy-linux/flit.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils-pass1
        python
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        python
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD/flit_core
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/flit-core flit_core
}
