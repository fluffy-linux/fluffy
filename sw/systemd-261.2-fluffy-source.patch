         return !!strpbrk(p, GLOB_CHARS);
 }
+
+char* glob_escape(const char *s) {
+        assert(s);
+
+        size_t extra = 0;
+        for (const char *p = s; *p != '\0'; p++)
+                if (strchr("\\*?[]{}~", *p))
+                        extra++;
+
+        char *escaped = new(char, strlen(s) + extra + 1);
+        if (!escaped)
+                return NULL;
+
+        char *d = escaped;
+        for (const char *p = s; *p != '\0'; p++) {
+                if (strchr("\\*?[]{}~", *p))
+                        *d++ = '\\';
+                *d++ = *p;
+        }
+        *d = '\0';
+        return escaped;
+}
