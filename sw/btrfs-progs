if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.1

# Built straight from Fluffy's branch (our commits on upstream's v7.1
# tag): swctl fetches the pinned commit with git.  The tag has no
# configure, include/config.h.in or config/ helpers, so MAKE runs
# autogen.sh with the autoconf and automake the release tarball was
# made with (2.73, 1.18.1).  The tarball's prebuilt man pages (made
# with Sphinx, which Fluffy doesn't have) aren't in git; this recipe
# never installed them (BLFS does).
ARCHIVES=(
    bf9a89086802033e0b270761fe02b11d0f5ad447 https://github.com/fluffy-linux/btrfs-progs.git#refs/heads/fluffy/v$VERSION
    008e8749cc5ef038ed8dbe86c24c67401af88c36 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.73
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
)

NEEDS=(
    e2fsprogs
    glibc
    libgcc
    systemd
    util-linux
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        e2fsprogs
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        pkgconf
        sed
        systemd
        tar
        util-linux
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        e2fsprogs
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        pkgconf
        sed
        systemd
        tar
        util-linux
        xz
        zlib
        zstd
    )
fi

source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/btrfs-progs \
        --bindir=/sw/btrfs-progs/bin \
        --sbindir=/sw/btrfs-progs/bin \
        --disable-static \
        --disable-documentation \
        --disable-python \
        --disable-lzo
    make
}

INSTALL() {
    make install
    find $DESTDIR/sw/btrfs-progs -name '*.la' -delete
}
