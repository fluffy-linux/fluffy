if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.1

HAS_LDFLAGS="-lbtrfs -lbtrfsutil"

ARCHIVES=(
    d1f55cc2971398c9142eaa79d203e63d586a3b4b867f956664a1d68322cd4e34 https://github.com/fluffy-linux/btrfs-progs/releases/download/v$VERSION/btrfs-progs-v$VERSION.tar.xz
    18b74d5ca7f026cb79351ece40af5db7eed1a5990164ff58b703bae6723a201a file://btrfs-progs-v$VERSION-fluffy-source.patch
)

NEEDS=(
    e2fsprogs
    glibc
    libgcc
    systemd
    util-linux
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        e2fsprogs
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        systemd
        tar
        util-linux
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        e2fsprogs
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        systemd
        tar
        util-linux
        xz
        zlib
        zstd
    )
fi

MAKE() {
    patch -Z -Np1 -i btrfs-progs-v$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    PKG_CONFIG="false" \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/btrfs-progs \
        --bindir=/sw/btrfs-progs/bin \
        --sbindir=/sw/btrfs-progs/bin \
        --disable-static \
        --disable-documentation \
        --disable-python \
        --disable-lzo
    make
}

INSTALL() {
    make install
    find $DESTDIR/sw/btrfs-progs -name '*.la' -delete
}
