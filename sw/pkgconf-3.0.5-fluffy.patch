From c7883427b96d47134dd666c08aa32ac3512aba01 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:13:29 -0500
Subject: [PATCH 1/2] Expand '*' components in search lists

On Fluffy every package lives in its own /sw/<pkg>, so there is no
single directory of .pc files or headers.  Let any path list pkgconf
reads (the configured default path, PKG_CONFIG_PATH, PKG_CONFIG_LIBDIR,
and the system include and library directories) name them all with an
element whose component is exactly '*', like /sw/*/lib/pkgconfig: it
stands for every directory it matches, in byte order.

The expansion is the C library's: glob() with GLOB_PATHS follows the
same rule as execvp and the dynamic loader (only a whole '*' component
is a wildcard, byte order whatever the locale), and GLOB_NOMAGIC keeps
an element without one as it is, as before.

Expanding the system directories too is what keeps "-I" and "-L" out of
consumers' flags: with --with-system-libdir='/sw/*/lib', -L/sw/zstd/lib
is dropped exactly as -L/usr/lib is elsewhere, since the compiler and
linker search /sw/*/{include,lib} themselves.
---
 libpkgconf/path.c | 34 +++++++++++++++++++++++++++++++---
 1 file changed, 31 insertions(+), 3 deletions(-)

diff --git a/libpkgconf/path.c b/libpkgconf/path.c
index 0d2f71a..d6af968 100644
--- a/libpkgconf/path.c
+++ b/libpkgconf/path.c
@@ -25,6 +25,8 @@
 # define PKGCONF_CACHE_INODES
 #endif
 
+#include <glob.h>
+
 static bool
 #ifdef PKGCONF_CACHE_INODES
 path_list_contains_entry(const pkgconf_buffer_t *text, pkgconf_list_t *dirlist, struct stat *st)
@@ -187,7 +189,9 @@ pkgconf_path_prepend(const char *text, pkgconf_list_t *dirlist, bool filter)
  *
  * .. c:function:: size_t pkgconf_path_split(const char *text, pkgconf_list_t *dirlist)
  *
- *    Splits a given text input and inserts paths into a path list.
+ *    Splits a given text input and inserts paths into a path list.  An
+ *    element with a path component that is exactly ``*`` is replaced by
+ *    the directories it matches, in byte order.
  *
  *    :param char* text: The path text to split and add as path nodes.
  *    :param pkgconf_list_t* dirlist: The path list to have the path nodes added to.
@@ -195,6 +199,30 @@ pkgconf_path_prepend(const char *text, pkgconf_list_t *dirlist, bool filter)
  *    :return: number of path nodes added to the path list
  *    :rtype: size_t
  */
+/*
+ * Adds the directories one search-list element names.  A path component
+ * that is exactly "*" stands for every directory it matches, in byte order
+ * (Fluffy searches each package's lib/pkgconfig that way, with "*" in
+ * place of the package): glob()'s GLOB_PATHS applies the same rule as
+ * execvp and the dynamic loader, and GLOB_NOMAGIC keeps an element without
+ * one as it is, whether or not it exists.
+ */
+static size_t
+path_add_element(const char *element, pkgconf_list_t *dirlist, bool filter)
+{
+	glob_t g;
+	size_t i;
+
+	if (glob(element, GLOB_PATHS | GLOB_NOMAGIC, NULL, &g) != 0)
+		return 0;
+
+	for (i = 0; i < g.gl_pathc; i++)
+		pkgconf_path_add(g.gl_pathv[i], dirlist, filter);
+
+	globfree(&g);
+	return i;
+}
+
 size_t
 pkgconf_path_split(const char *text, pkgconf_list_t *dirlist, bool filter)
 {
@@ -210,9 +238,9 @@ pkgconf_path_split(const char *text, pkgconf_list_t *dirlist, bool filter)
 
 	while ((p = strtok(iter, PKG_CONFIG_PATH_SEP_S)) != NULL)
 	{
-		pkgconf_path_add(p, dirlist, filter);
+		count += path_add_element(p, dirlist, filter);
 
-		count++, iter = NULL;
+		iter = NULL;
 	}
 	free(workbuf);
 

From 434ed2743f6c729cf8ee099235b010826586c8d9 Mon Sep 17 00:00:00 2001
From: Toushun <348031417+toushun@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:16:16 -0500
Subject: [PATCH 2/2] Test search lists with '*' components

Add t/fluffy, run by "make check" and meson, over a small tree laid out
like Fluffy's /sw: packages a, B and c, an image file beside them
(zz-1.0.squashfs), and a hidden .hid, each with .pc files in
lib/pkgconfig or share/pkgconfig.  The tests check that

- a '*' element finds .pc files in every package, in lib/pkgconfig and
  share/pkgconfig alike;
- when two packages have the same .pc file, the first in byte order
  wins (B before a, whatever the locale);
- a hidden directory is never a match, though it sorts first;
- with '*' system directories, -I and -L for any package are dropped
  and other flags kept;
- a path without '*' is used as it is, even with '[' in it.

Makefile.in gains the same line as Makefile.am, since the release
tarball's generated files are used as they are.
