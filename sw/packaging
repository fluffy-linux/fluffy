if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=26.3

# Built straight from Fluffy's branch (upstream's 26.3 tag; Fluffy has no
# commits on it): swctl fetches the pinned commit with git.
ARCHIVES=(
    929fd4b1410ac7ef61ef3f45b2f5d7e87711a9b5 https://github.com/fluffy-linux/packaging.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils-pass1
        flit-core
        python
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        python
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/packaging packaging
}
