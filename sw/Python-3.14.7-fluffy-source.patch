+            Py_DECREF(pat_bytes);
+            return PyErr_NoMemory();
+        }
+        size_t nr = 0;
+        for (size_t i = 0; i < root_len; i++) {
+            if (root_str[i] == '/' && nr > 0 && norm_root[nr - 1] == '/') {
+                continue;
+            }
+            norm_root[nr++] = root_str[i];
+        }
