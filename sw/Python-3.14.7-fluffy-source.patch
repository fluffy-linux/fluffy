+static PyObject *
+getpath_glob(PyObject *Py_UNUSED(self), PyObject *args)
+{
+    PyObject *pathobj;
+    if (!PyArg_ParseTuple(args, "U", &pathobj)) {
+        return NULL;
+    }
+    wchar_t *wpath = PyUnicode_AsWideCharString(pathobj, NULL);
+    if (!wpath) {
+        return NULL;
+    }
+    char *pattern = Py_EncodeLocale(wpath, NULL);
+    PyMem_Free(wpath);
+    if (!pattern) {
+        PyErr_NoMemory();
+        return NULL;
+    }
+    PyObject *list = PyList_New(0);
+    if (!list) {
+        PyMem_Free(pattern);
+        return NULL;
+    }
+#ifndef MS_WINDOWS
+    glob_t g = { 0 };
+    int rc = glob(pattern, GLOB_ONLYDIR | GLOB_NOESCAPE, NULL, &g);
+    PyMem_Free(pattern);
+    if (rc == GLOB_NOSPACE) {
+        globfree(&g);
+        Py_DECREF(list);
+        PyErr_NoMemory();
+        return NULL;
+    }
+    if (rc == 0) {
+        for (size_t i = 0; i < g.gl_pathc; i++) {
+            size_t len;
+            wchar_t *w = Py_DecodeLocale(g.gl_pathv[i], &len);
+            if (!w) {
+                Py_DECREF(list);
+                globfree(&g);
+                PyErr_NoMemory();
+                return NULL;
+            }
+            PyObject *item = PyUnicode_FromWideChar(w, len);
+            PyMem_RawFree(w);
+            if (!item || PyList_Append(list, item) < 0) {
+                Py_XDECREF(item);
+                Py_DECREF(list);
+                globfree(&g);
+                return NULL;
+            }
+            Py_DECREF(item);
+        }
+    }
+    globfree(&g);
+#else
+    PyMem_Free(pattern);
+#endif
+    return list;
+}
