+    int is_bytes = 0;
+    PyObject *pat_bytes = NULL;
+    if (PyUnicode_Check(pat_obj)) {
+        pat_bytes = PyUnicode_EncodeFSDefault(pat_obj);
+        if (pat_bytes == NULL) {
