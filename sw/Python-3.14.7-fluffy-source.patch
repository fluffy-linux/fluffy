             path = path.split(os.fsencode(os.pathsep))
         else:
+            has_wildcard = '*' in path or '?' in path
             path = os.fsdecode(path)
             path = path.split(os.pathsep)
 
+        if has_wildcard:
+            import glob
+            expanded = []
+            for d in path:
+                d_str = os.fsdecode(d) if use_bytes else d
