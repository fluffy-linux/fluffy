+#ifdef GLOB_TILDE
+    if ((flags & GLOB_TILDE) && pat_str[0] == '~') tilde_rel = 1;
+#endif
+#ifdef GLOB_TILDE_CHECK
+    if ((flags & GLOB_TILDE_CHECK) && pat_str[0] == '~') tilde_rel = 1;
+#endif
