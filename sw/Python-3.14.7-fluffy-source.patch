+                                                 &esc_prefix_len, &doubled_bs);
+        if (alloc_pat == NULL) {
+            PyMem_Free(norm_root);
+            Py_DECREF(root_bytes);
+            Py_DECREF(pat_bytes);
+            return NULL;
+        }
+        c_pattern = alloc_pat;
+    }
+
+    int nomatch_return_pat = 0;
+    if (strip_len > 0) {
+#ifdef GLOB_NOCHECK
+        if (flags & GLOB_NOCHECK) {
+            nomatch_return_pat = 1;
+        }
+#endif
+#ifdef GLOB_NOMAGIC
+        if (!nomatch_return_pat && (flags & GLOB_NOMAGIC)
