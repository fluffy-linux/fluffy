+    allowed |= GLOB_NOCHECK;
+#endif
+#ifdef GLOB_NOESCAPE
+    allowed |= GLOB_NOESCAPE;
+#endif
+#ifdef GLOB_PERIOD
+    allowed |= GLOB_PERIOD;
+#endif
+#ifdef GLOB_BRACE
+    allowed |= GLOB_BRACE;
+#endif
+#ifdef GLOB_NOMAGIC
+    allowed |= GLOB_NOMAGIC;
+#endif
+#ifdef GLOB_TILDE
+    allowed |= GLOB_TILDE;
+#endif
+#ifdef GLOB_ONLYDIR
+    allowed |= GLOB_ONLYDIR;
+#endif
+#ifdef GLOB_TILDE_CHECK
