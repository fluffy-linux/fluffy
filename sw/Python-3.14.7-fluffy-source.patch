+    char *norm_root = NULL;
+    char *alloc_pat = NULL;
+    const char *c_pattern = pat_str;
+    int call_flags = flags;
+    size_t rlen = 0;
+    size_t strip_len = 0;
+    size_t esc_prefix_len = 0;
+    int doubled_bs = 0;
+    size_t orig_pat_slashes = 0;
+    int pat_has_magic = 0;
+#ifdef GLOB_KEEP_SLASHES
+    if (flags & GLOB_KEEP_SLASHES) {
