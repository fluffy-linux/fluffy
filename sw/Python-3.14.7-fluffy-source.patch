+++ Python-3.14.7.source/Lib/os.py	2026-10-31 16:08:53.703893776 +0000
@@ -687,6 +687,15 @@
 
     if path_list is None:
         path_list = defpath
+    if '*' in path_list or '?' in path_list:
+        import glob
+        expanded = []
+        for d in path_list.split(pathsep):
+            if '*' in d or '?' in d:
+                expanded.extend(sorted(glob.glob(d)))
+            else:
+                expanded.append(d)
+        return expanded
     return path_list.split(pathsep)
 
 
