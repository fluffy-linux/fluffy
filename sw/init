if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0

ARCHIVES=(
    4596e959a950a3959bfdf521f5ccfc1c0dc2000c274c96d96fa7029af77d2d4f file://init.c
)

NEEDS=()

if test -v CROSS
then
    BUILD_NEEDS=(
        binutils
        gcc
        glibc
        linux-headers
    )
else
    BUILD_NEEDS=(
        binutils
        gcc
        glibc
        linux-headers
    )
fi

MAKE() {
    gcc -static -O2 -Wall -Wextra -Werror init.c -o init
}

INSTALL() {
    mkdir -p $DESTDIR/sw/init/bin
    cp -v init $DESTDIR/sw/init/bin/init
}
