if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=16.2.0

ARCHIVES=(
    e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e https://ftpmirror.gnu.org/gcc/gcc-$VERSION/gcc-$VERSION.tar.xz
    14f783de32e23716a14dcb197edae9e130c9b8605374293bec921ad972ca3c78 file://gcc-$VERSION-fluffy-shell.patch
)

NEEDS=(
    glibc
    libgcc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        python-pass1
        sed-pass1
        tcl
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        python
        sed
        tcl
    )
fi

MAKE() {
    patch -Z -Np1 -i gcc-$VERSION-fluffy-shell.patch

    ln -sv gthr-posix.h libgcc/gthr-default.h

    mkdir -v build
    cd build
    CONFIG_SITE=/sw/glibc/share/config.site ../libstdc++-v3/configure \
        --prefix=/sw/libstdcpp \
        --disable-multilib \
        --disable-nls \
        --disable-libstdcxx-pch \
        --with-gxx-include-dir=/sw/libstdcpp/include/c++
    make
}

CHECK() {
    cd build
    ln -sfv . libstdc++-v3
    sed -i 's|SECTIONLDFLAGS="|SECTIONLDFLAGS="-L${BUILD_DIR}/src/.libs |' scripts/testsuite_flags
    sed -i '/TEST_GCC_EXEC_PREFIX/d' testsuite/Makefile
    ulimit -s -H unlimited
    LD_LIBRARY_PATH="$PWD/src/.libs" make -k check
    ../contrib/test_summary -t
    rm -fv libstdc++-v3
    ! grep -E '^(FAIL|XPASS|UNRESOLVED|ERROR):' $(find . -name '*.sum')
}

INSTALL() {
    cd build
    make install
    rm -fv $DESTDIR/sw/libstdcpp/lib/lib{stdc++{,exp,fs},supc++}.la
    mkdir -pv $DESTDIR/sw/libstdcpp/share/gdb/auto-load/sw/libstdcpp/lib
    mv -v $DESTDIR/sw/libstdcpp/lib/*gdb.py $DESTDIR/sw/libstdcpp/share/gdb/auto-load/sw/libstdcpp/lib
}
