if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=16.2.0

# Built straight from Fluffy's branch (our commits on upstream's
# releases/gcc-16.2.0 tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    249a7913825ded5cb6aab9f39eff492057a959e6 https://github.com/fluffy-linux/gcc.git#refs/heads/fluffy/releases/gcc-$VERSION
)

NEEDS=(
    glibc
    libgcc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        python-pass1
        sed-pass1
        tcl
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        python
        sed
        tcl
    )
fi

MAKE() {
    ln -sv gthr-posix.h libgcc/gthr-default.h

    mkdir -v build
    cd build
    CONFIG_SITE=/sw/glibc/share/config.site ../libstdc++-v3/configure \
        --prefix=/sw/libstdcpp \
        --disable-multilib \
        --disable-nls \
        --disable-libstdcxx-pch \
        --with-gxx-include-dir=/sw/libstdcpp/include/c++ \
        CXX='g++ -nostdinc++' \
        CXXFLAGS='-g -O2'
    make
}

CHECK() {
    cd build
    ulimit -s -H unlimited
    LD_LIBRARY_PATH="$PWD/src/.libs" make -k check
    ../contrib/test_summary -t
    ! grep -E '^(FAIL|XPASS|UNRESOLVED|ERROR):' $(find . -name '*.sum')
}

INSTALL() {
    cd build
    make install
    rm -fv $DESTDIR/sw/libstdcpp/lib/lib{stdc++{,exp,fs},supc++}.la
    mkdir -pv $DESTDIR/sw/libstdcpp/share/gdb/auto-load/sw/libstdcpp/lib
    mv -v $DESTDIR/sw/libstdcpp/lib/*gdb.py $DESTDIR/sw/libstdcpp/share/gdb/auto-load/sw/libstdcpp/lib
}
