if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.4.0

HAS_LDFLAGS=-lacl

ARCHIVES=(
    e661131456d2708a01c614a0f400e11d7d1bfaeb6f3e74b75bb980b72f0161a3 https://github.com/fluffy-linux/acl/releases/download/v$VERSION/acl-$VERSION.tar.xz
    107000ecaeed120e8175e4cb12cb02d5dd96d89fed5f5664c375019b41336d88 file://acl-$VERSION-fluffy-test.patch
)

NEEDS=(
    attr
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        attr
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i acl-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/acl \
        --disable-static \
        --docdir=/sw/acl/share/doc/acl-$VERSION
    make
}

CHECK() {
    make check TESTS="test/getfacl-lfs.run test/getfacl-noacl.run test/getfacl-recursive.run test/malformed-restore.run test/setfacl-X.run"
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/acl/lib/libacl.la
}
