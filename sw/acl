if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.4.0

ARCHIVES=(
    e661131456d2708a01c614a0f400e11d7d1bfaeb6f3e74b75bb980b72f0161a3 https://download.savannah.gnu.org/releases/acl/acl-$VERSION.tar.xz
    3b6fa9f9013c4b1b24fcd90927a1234e37a85083fff713db6e670e225303ce9e file://acl-$VERSION-fluffy-shell.patch
    4347e0a8e4a38205518a9fd90d980698370b11ac464bbd715343806768538ab2 file://acl-$VERSION-fluffy-test.patch
)

NEEDS=(
    attr
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        attr
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i acl-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i acl-$VERSION-fluffy-test.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/acl \
        --disable-static \
        --docdir=/sw/acl/share/doc/acl-$VERSION
    make
}

CHECK() {
    make check TESTS="test/getfacl-lfs.run test/getfacl-noacl.run test/getfacl-recursive.run test/malformed-restore.run test/setfacl-X.run"
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/acl/lib/libacl.la
}
