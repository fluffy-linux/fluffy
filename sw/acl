if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.4.0

# Built straight from Fluffy's branch (our commits on upstream's v2.4.0
# tag): swctl fetches the pinned commit with git.  The tag has no
# configure, Makefile.in or gettext files, so MAKE runs autogen.sh, as
# upstream makes its release tarball: with the autoconf, automake and
# libtool the release was made with (2.72, 1.18.1, 2.5.4), from their
# Fluffy branches, and gettext's autopoint.  The translations are merged
# with the release's acl.pot, as its make dist did.
ARCHIVES=(
    584eb9f2d829a77bb8ee9dbddefa3cfe760196e0 https://github.com/fluffy-linux/acl.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
    2b62947fd566e11dedf3c2c7e252f05a8937d54c https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.5.4
)

NEEDS=(
    attr
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        attr
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        xz
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autopoint_wrapper
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/acl \
        --disable-static \
        --docdir=/sw/acl/share/doc/acl-$VERSION
    # The translations as make dist merges them with acl.pot.
    make -C po update-po
    make
}

# autogen.sh runs autopoint, which gettext installs with a #!/bin/sh line
# (gettext's bug): put one that runs it with bash first in PATH, beside
# the autotools.
autopoint_wrapper() {
    printf '#!%s\nexec %s /sw/gettext/bin/autopoint "$@"\n' \
        "$CONFIG_SHELL" "$CONFIG_SHELL" > .autotools/bin/autopoint
    chmod +x .autotools/bin/autopoint
}

CHECK() {
    make check TESTS="test/getfacl-lfs.run test/getfacl-noacl.run test/getfacl-recursive.run test/malformed-restore.run test/setfacl-X.run"
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/acl/lib/libacl.la
}
