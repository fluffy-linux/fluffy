if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.24.1

# Built straight from Fluffy's branch (our commits on upstream's 1.24.1
# tag): swctl fetches the pinned commit, and the gnulib commit it pins,
# with git.  The tag has no configure, Makefile.in or gnulib files, so
# MAKE bootstraps it with the autoconf and automake the release tarball
# was made with (2.69, 1.16.3); pkgconf gives that bootstrap pkg.m4, and
# bison and makeinfo write the parsers and the manual the tarball ships.
ARCHIVES=(
    e50939decf593b1a898144bc447b63b4024a1b36 https://github.com/fluffy-linux/groff.git#refs/heads/fluffy/$VERSION
    48eccc1ad68d408db760ce345e08eda16b694c52 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.69
    9d78c9a5e6180fb86ad77f3e6b4e82403bc86da6 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.3
)

NEEDS=(
    glibc
    libgcc
    libstdcpp
    perl
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        perl
        pkgconf
        sed
        tar
        texinfo
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        patch
        perl
        pkgconf
        sed
        tar
        texinfo
        xz
    )
fi

source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    PAGE=letter $CONFIG_SHELL ./configure \
        --prefix=/sw/groff
    make -j1
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
