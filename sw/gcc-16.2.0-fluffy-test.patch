diff --no-dereference -Naur gcc-16.2.0.orig/gcc/testsuite/gcc.dg/fluffy/zlib-zstd-run.c gcc-16.2.0/gcc/testsuite/gcc.dg/fluffy/zlib-zstd-run.c
--- gcc-16.2.0.orig/gcc/testsuite/gcc.dg/fluffy/zlib-zstd-run.c	1970-01-01 00:00:00.000000000 +0000
+++ gcc-16.2.0/gcc/testsuite/gcc.dg/fluffy/zlib-zstd-run.c	2026-08-07 07:46:11.216575764 +0000
@@ -0,0 +1,16 @@
+/* zlib and zstd installed in the live prefix are found, linked and loaded
+   with no -I or -L options.  Unsupported when the compiler cannot see
+   <zlib.h> and <zstd.h> at all.  */
+/* { dg-do run } */
+/* { dg-require-effective-target zlib_zstd_headers } */
+/* { dg-additional-options "-lz -lzstd" } */
+
+#include <stdio.h>
+#include <zlib.h>
+#include <zstd.h>
+
+int
+main (void)
+{
+  return (zlibVersion () != NULL && ZSTD_versionNumber () > 0) ? 0 : 1;
+}
