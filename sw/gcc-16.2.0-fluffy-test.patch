diff --no-dereference -Naur gcc-16.2.0.orig/gcc/testsuite/gcc.dg/fluffy/fluffy.exp gcc-16.2.0/gcc/testsuite/gcc.dg/fluffy/fluffy.exp
--- gcc-16.2.0.orig/gcc/testsuite/gcc.dg/fluffy/fluffy.exp	1970-01-01 00:00:00.000000000 +0000
+++ gcc-16.2.0/gcc/testsuite/gcc.dg/fluffy/fluffy.exp	2026-08-07 07:46:11.216575764 +0000
@@ -0,0 +1,77 @@
+# Copyright (C) 2026 Free Software Foundation, Inc.
+
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# Fluffy Linux include search tests.
+#
+# Fluffy configures gcc with --with-native-system-header-dir='/sw/*/include'
+# and patches incpath.cc so that -I, -I=, --sysroot and the standard include
+# directories may be glob patterns, while an existing directory whose name
+# merely contains glob metacharacters is still used literally.  The include
+# tests below build their own fixture trees (with "[1]" in the directory
+# names) under the current output directory, so they never depend on the
+# host's /sw.  The tests take no dg-options; fluffy.exp supplies each
+# one's fixture options.  Tests without an entry in fluffy_include_flags
+# (the live zlib/zstd link test) run with the default options only.
+
+load_lib gcc-dg.exp
+
+global DEFAULT_CFLAGS
+if ![info exists DEFAULT_CFLAGS] then {
+    set DEFAULT_CFLAGS " -ansi -pedantic-errors"
+}
+
+dg-init
+
+set fx [file join [pwd] fluffy-include]
+file delete -force $fx
+foreach {name text} {
+    wild/pkg[1]/include/wild_test.h	"#define WILD_OK 42"
+    sys[1]/sw/pkg[1]/include/sys_test.h	"#define SYS_OK 99"
+    lit[1]/include/lit_test.h		"#define LIT_OK 77"
+    lit1/include/lit_test.h		"#define LIT_OK 13"
+} {
+    file mkdir [file dirname [file join $fx $name]]
+    set fd [open [file join $fx $name] w]
+    puts $fd $text
+    close $fd
+}
+
+# The compiler command line goes through Tcl evaluation in DejaGnu's
+# local_exec, so quote the brackets in the fixture names.
+set q [string map {[ \\[ ] \\]} $fx]
+
+array set fluffy_include_flags [list \
+    include-wild.c "-I$q/wild/*/include" \
+    include-sysroot.c "--sysroot=$q/sys\\\[1\\\]" \
+    include-sysroot-eq.c "--sysroot=$q/sys\\\[1\\\] -I=/sw/*/include" \
+    include-sysroot-eq-nostdinc.c "--sysroot=$q/sys\\\[1\\\] -nostdinc -I=/sw/*/include" \
+    include-literal.c "-I$q/lit\\\[1\\\]/include" \
+    missing-include-dirs.c "-Wmissing-include-dirs -Werror -I$q/nonexistent_inc\\\[1\\\]" \
+]
+
+# The fixture options go in the default-flags argument so that the
+# absolute fixture paths do not end up in the test names.
+foreach test [lsort [glob -nocomplain $srcdir/$subdir/*.c]] {
+    set flags $DEFAULT_CFLAGS
+    if [info exists fluffy_include_flags([file tail $test])] {
+	append flags " " $fluffy_include_flags([file tail $test])
+    }
+    dg-runtest [list $test] "" $flags
+}
+
+file delete -force $fx
+
+dg-finish
