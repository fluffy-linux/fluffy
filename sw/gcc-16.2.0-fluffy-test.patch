diff --no-dereference -Naur gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/include-next-cstdlib.C gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/include-next-cstdlib.C
--- gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/include-next-cstdlib.C	1970-01-01 00:00:00.000000000 +0000
+++ gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/include-next-cstdlib.C	2026-08-07 07:46:11.216575764 +0000
@@ -0,0 +1,15 @@
+// <cstdlib> from the libstdc++ headers (--with-gxx-include-dir=
+// '/sw/*/include/c++') chains with #include_next <stdlib.h> into glibc's
+// header in another wildcard-expanded system include directory.
+// Unsupported when the compiler cannot see the libstdc++ headers at all.
+// { dg-do compile }
+// { dg-require-effective-target libstdcxx_headers }
+
+#include <cstdlib>
+
+int
+f (int x)
+{
+  std::div_t d = std::div (x, 3);
+  return d.rem + std::abs (x) + EXIT_SUCCESS;
+}
diff --no-dereference -Naur gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/include-next-stdlib.C gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/include-next-stdlib.C
--- gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/include-next-stdlib.C	1970-01-01 00:00:00.000000000 +0000
+++ gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/include-next-stdlib.C	2026-08-07 07:46:11.216575764 +0000
@@ -0,0 +1,14 @@
+// libstdc++'s <stdlib.h> wrapper chains with #include_next <stdlib.h> into
+// glibc's header in another wildcard-expanded system include directory.
+// Unsupported when the compiler cannot see the libstdc++ headers at all.
+// { dg-do compile }
+// { dg-require-effective-target libstdcxx_headers }
+
+#include <stdlib.h>
+
+int
+f (int x)
+{
+  div_t d = div (x, 3);
+  return d.rem + std::abs (x) + EXIT_SUCCESS;
+}
diff --no-dereference -Naur gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/iostream-zlib-zstd-run.C gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/iostream-zlib-zstd-run.C
--- gcc-16.2.0.orig/gcc/testsuite/g++.dg/fluffy/iostream-zlib-zstd-run.C	1970-01-01 00:00:00.000000000 +0000
+++ gcc-16.2.0/gcc/testsuite/g++.dg/fluffy/iostream-zlib-zstd-run.C	2026-08-07 07:46:11.216575764 +0000
@@ -0,0 +1,21 @@
+// libstdc++, zlib and zstd installed in the live prefix are found, linked
+// and loaded with no -I or -L options.  Unsupported when the compiler cannot
+// see the libstdc++, zlib or zstd headers at all.
+// { dg-do run }
+// { dg-require-effective-target libstdcxx_headers }
+// { dg-require-effective-target zlib_zstd_headers }
+// { dg-additional-options "-lz -lzstd" }
+
+#include <cstdlib>
+#include <iostream>
+#include <sstream>
+#include <zlib.h>
+#include <zstd.h>
+
+int
+main ()
+{
+  std::ostringstream os;
+  os << zlibVersion () << ":" << ZSTD_versionNumber ();
+  return os.str ().empty () ? EXIT_FAILURE : EXIT_SUCCESS;
+}
