ON=cross-build

VERSION=3.3

# gperf for gettext.  gettext's sources from git lack the lookup tables
# its release tarball ships (gnulib's iconv_open-*.h, unicase's
# special-casing-table.h, uninorm's composition-table.h), and the build
# makes them with gperf.  The final gperf comes after gettext and is
# built with the final bash, grep and sed, which need gettext: this pass
# breaks that cycle, built with the temporary tools.  Beyond LFS, which
# builds gettext from its release tarball.  Built straight from Fluffy's
# branch, as gperf is.
ARCHIVES=(
    b51df51f93514108844029599d23d774e591aad8 https://github.com/fluffy-linux/gperf.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    c47d100eab0ff3b64e16811f6b3925b233085497 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    libstdcpp-pass1
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    glibc-pass1
    grep-pass1
    gzip-pass1
    libgcc-pass1
    libstdcpp-pass1
    linux-headers
    make-pass1
    sed-pass1
    tar-pass1
    texinfo-pass1
    xz-pass1
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    # autogen.sh runs make -f Makefile.devel, whose rules run autoconf
    # and autoheader in the same directories: not in parallel.
    MAKEFLAGS= $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gperf
    gperf_make
}

# As gperf's: no PDF.
gperf_make() {
    make TEXI2PDF=: "$@"
}

INSTALL() {
    gperf_make install
}
