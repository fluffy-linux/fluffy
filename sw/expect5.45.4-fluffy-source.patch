diff --no-dereference -Naur expect5.45.4.orig/fixline1 expect5.45.4/fixline1
--- expect5.45.4.orig/fixline1	2018-02-02 19:15:52.000000000 +0000
+++ expect5.45.4/fixline1	2018-02-02 19:15:52.000000000 +0000
@@ -12,13 +12,13 @@
 #
 set line1 [gets stdin]
 if {"$line1" == "\#!/bin/sh"} {
-    # if multi-line hack already in place, do nothing
-    set header $line1
+    # if multi-line hack already in place, rewrite shebang for Fluffy
+    set header "#!/sw/bash/bin/bash"
 } else {
     # if single-line #!, switch to multi-line rewrite
 
     regexp "^#!(.*/)*(.*)" $line1 X X tail
-    set header "#!/bin/sh\n"
+    set header "#!/sw/bash/bin/bash\n"
     append header "# \\\n"
     append header "exec $tail "; append header {"$0" ${1+"$@"}}
 }
