+  /* Detect default shell if default /bin/sh is not accessible.  */
+  {
+    extern const char *default_shell;
+    if (access (default_shell, X_OK) != 0)
+      {
+        if (access ("/sw/bash/bin/sh", X_OK) == 0)
+          default_shell = "/sw/bash/bin/sh";
+        else if (access ("/sw/bash/bin/bash", X_OK) == 0)
+          default_shell = "/sw/bash/bin/bash";
+        else
+          {
+            const char *sh = find_in_given_path ("sh", NULL, NULL, 0);
+            if (!sh)
+              sh = find_in_given_path ("bash", NULL, NULL, 0);
+            if (sh)
+              default_shell = sh;
+          }
+      }
+  }
+
   /* Define some internal and special variables.  */
   define_automatic_variables ();
 
