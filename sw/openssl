VERSION=4.0.1

ARCHIVES=(
    2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09 https://github.com/openssl/openssl/releases/download/openssl-$VERSION/openssl-$VERSION.tar.gz
    5b26ab2d703d911005c3edc9e8ed71f66b0fe46c399703dc75871a5296c11c21 file://openssl-$VERSION-fluffy-shell.patch
    e41b6190c05262569b4a3f8b71dc1d24680f1c4933e5a228be1870218956df72 file://openssl-$VERSION-fluffy-source.patch
    ea528a091f500129a418ad31db3bd75ca8fe3c351425b66c51d4c2a5bf9dcfc2 file://openssl-$VERSION-fluffy-test.patch
)

MAKE() {
    patch -Z -Np1 -i openssl-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-test.patch
    ./config \
        --prefix=/sw/openssl \
        --openssldir=/etc/ssl \
        --libdir=lib \
        shared \
        zlib-dynamic
    make
}

CHECK() {
    make test
}

INSTALL() {
    make INSTALL_LIBS= MANSUFFIX=ssl install
    mv -v /sw/openssl/share/doc/openssl /sw/openssl/share/doc/openssl-$VERSION
    cp -vfr doc/* /sw/openssl/share/doc/openssl-$VERSION
}
