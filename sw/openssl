if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

HAS_LDFLAGS="-lssl -lcrypto"

ARCHIVES=(
    2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09 https://github.com/fluffy-linux/openssl/releases/download/openssl-$VERSION/openssl-$VERSION.tar.gz
    3327a2e133ba3204da818d5b546175fe8196276664942f6b02770f660dedee35 file://openssl-$VERSION-fluffy-ch8.patch
    9f04bdece1eaed057c2bb5c78414d0f954a8324bd9a6881bf6d2573ee8991bba file://openssl-$VERSION-fluffy-source.patch
    9398f6e944392e2ca225f11f9ea188aff8d19d6ae02f7c5f526e00497c036d04 file://openssl-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    perl
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i openssl-$VERSION-fluffy-ch8.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-test.patch

    ./config \
        --prefix=/sw/openssl \
        --openssldir='/sw/*/etc/ssl' \
        --libdir=lib \
        shared \
        zlib-dynamic
    make
}

CHECK() {
    HARNESS_JOBS=$(nproc) make test
}

INSTALL() {
    make INSTALL_LIBS= MANSUFFIX=ssl OPENSSLDIR=/sw/openssl/etc/ssl install
    mv -v $DESTDIR/sw/openssl/share/doc/openssl $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
    cp -vfr doc/* $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
}
