if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

ARCHIVES=(
    2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09 https://github.com/openssl/openssl/releases/download/openssl-$VERSION/openssl-$VERSION.tar.gz
    079e8073597e5ad1571314a13041ea0231af016b7148ef68e307492ac905d77f file://openssl-$VERSION-fluffy-ch8.patch
    fcba612593e5ca9c40129ce372de8f45d176cf0c5aa26a27188f7e91da144f46 file://openssl-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    perl
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i openssl-$VERSION-fluffy-ch8.patch
    patch -Z -Np1 -i openssl-$VERSION-fluffy-source.patch

    ./config \
        --prefix=/sw/openssl \
        --openssldir='/sw/*/etc/ssl' \
        --libdir=lib \
        shared \
        zlib-dynamic
    make
}

CHECK() {
    make test
}

INSTALL() {
    make INSTALL_LIBS= MANSUFFIX=ssl OPENSSLDIR=/sw/openssl/etc/ssl install
    mv -v $DESTDIR/sw/openssl/share/doc/openssl $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
    cp -vfr doc/* $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
}
