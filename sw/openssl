if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.1

ARCHIVES=(
    ac9e41bcf242c6f862337c5cb88d6cc5eb9c9f1a https://github.com/fluffy-linux/openssl.git#refs/heads/fluffy/openssl-$VERSION
)

NEEDS=(
    glibc
    perl
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        perl
        sed
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        perl
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {

    ./config \
        --prefix=/sw/openssl \
        --openssldir='/sw/*/etc/ssl' \
        --libdir=lib \
        shared \
        zlib-dynamic
    make
}

CHECK() {
    HARNESS_JOBS=$(nproc) make test
}

INSTALL() {
    make INSTALL_LIBS= MANSUFFIX=ssl OPENSSLDIR=/sw/openssl/etc/ssl install
    mv -v $DESTDIR/sw/openssl/share/doc/openssl $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
    cp -vfr doc/* $DESTDIR/sw/openssl/share/doc/openssl-$VERSION
}
