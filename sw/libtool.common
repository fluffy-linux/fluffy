# Libtool at the version a package's release tarball was generated with,
# built from git inside the package's own build for libtoolize.  The
# recipe lists that version's Fluffy branch in its own ARCHIVES, so it is
# placed as ../libtool.tar with its gnulib and gl-mod/bootstrap
# submodules:
#
#     <commit> https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v<version>
#
# and sources this file; MAKE calls libtool_build after autoconf_build and
# automake_build (its bootstrap runs them) and before autoreconf.  It
# installs beside them, so their aclocal finds libtool's macros.  The man
# pages, the manual and doc/notes.txt (all made with makeinfo) are not
# built.
# It installs into the build's own prefix, never into a package's DESTDIR.

case "$ON" in
    cross-build)
        # The helper unpacks its sources with tar, and libtool's bootstrap
        # applies its gnulib diffs with patch and checks that xz is there
        # (its buildreq): the pass1 tools here, so that packages patch,
        # tar and xz depend on can regenerate too.
        BUILD_NEEDS+=(
            patch-pass1
            tar-pass1
            xz-pass1
        )
        ;;
    fluffy-build)
        BUILD_NEEDS+=(
            patch
            tar
            xz
        )
        ;;
esac

libtool_build() {
    local prefix="$PWD/.autotools"
    mkdir -p .autotools-build
    tar -xf ../libtool.tar -C .autotools-build
    (
        cd .autotools-build/libtool
        ${CONFIG_SHELL:-/bin/sh} ./bootstrap --skip-git --skip-po --gnulib-srcdir=gnulib
        ${CONFIG_SHELL:-/bin/sh} ./configure --prefix="$prefix"
        make man1_MANS= dist_man1_MANS= INFO_DEPS= notes_txt=
        make man1_MANS= dist_man1_MANS= INFO_DEPS= notes_txt= DESTDIR= install
    )
}
