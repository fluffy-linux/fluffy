if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.1.8

# Built straight from Fluffy's branch (our commits on upstream's v7.1.8
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    ee53a5abd9bfd9e178465c183bab6aed413a8e49 https://github.com/fluffy-linux/linux.git#refs/heads/fluffy/v$VERSION
    8b1d71f89324e12b85ef07a742f4d9b584fe65fe786d799d3288925d062459d7 file://config-$VERSION
)

NEEDS=()

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        bc
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip
        kmod
        libelf
        libgcc
        linux-headers
        make
        openssl
        perl
        sed
        tar
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        bc
        binutils
