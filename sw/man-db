if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.13.1

ARCHIVES=(
    8afebb6f7eb6bb8542929458841f5c7e6f240e30c86358c1fbcefbea076c87d9 https://github.com/fluffy-linux/man-db/releases/download/$VERSION/man-db-$VERSION.tar.xz
    85e507321ae90dd1ba77cc8b2d5fcb94ea7b7dada2f37486c9dc0a0f5a82ddaf file://man-db-$VERSION-fluffy-source.patch
    9c835417d019c59191806abc806b87bdaf998808f5826c84533b5f71c94d1c7f file://man-db-$VERSION-fluffy-test.patch
)

NEEDS=(
    gdbm
    glibc
    libpipeline
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gdbm
        gettext
        glibc
        grep
        groff
        gzip
        libgcc
        libpipeline
        linux-headers
        make
        patch
        sed
        systemd
        tar
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gdbm
        gettext
        glibc
        grep
        groff
        gzip
        libgcc
        libpipeline
        linux-headers
        make
        patch
        sed
        systemd
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i man-db-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i man-db-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    libpipeline_CFLAGS=" " \
    libpipeline_LIBS="-lpipeline" \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/man-db \
        --sbindir=/sw/man-db/bin \
        --docdir=/sw/man-db/share/doc/man-db-$VERSION \
        --sysconfdir=/sw/man-db/etc \
        --disable-setuid \
        --disable-cache-owner \
        --with-browser=/sw/lynx/bin/lynx \
        --with-vgrind=/sw/groff/bin/vgrind \
        --with-grap=/sw/grap/bin/grap \
        --with-systemdsystemunitdir=/sw/man-db/lib/systemd/system \
        --with-systemdtmpfilesdir=/sw/man-db/lib/tmpfiles.d \
        --without-libseccomp
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    find $DESTDIR/sw/man-db -name '*.la' -delete
}
