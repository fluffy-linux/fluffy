 if test ${ax_cv_check_ldflags___Wl___image_base_0x400000+y}
 then :
   printf %s "(cached) " >&6
 else $as_nop
 
   ax_check_save_flags=$LDFLAGS
-  LDFLAGS="$LDFLAGS  -Wl,--image-base,0x400000"
+  LDFLAGS="$LDFLAGS  -Wl,--nonexist-linker-option,0x400000"
   cat confdefs.h - <<_ACEOF >conftest.$ac_ext
 /* end confdefs.h.  */
 
