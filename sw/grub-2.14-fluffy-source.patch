diff --no-dereference -Naur grub-2.14/configure grub-2.14/configure
--- grub-2.14/configure	2026-01-14 13:26:54.000000000 -0500
+++ grub-2.14/configure	2026-01-14 13:26:54.000000000 -0500
@@ -40919,15 +40919,15 @@
 
 
 if test "x$TARGET_APPLE_LINKER" != x1 ; then
-{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether the linker accepts -Wl,--image-base,0x400000" >&5
-printf %s "checking whether the linker accepts -Wl,--image-base,0x400000... " >&6; }
+{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether the linker accepts -Wl,--nonexist-linker-option,0x400000" >&5
