ON=host-build

VERSION=1.4.21

ARCHIVES=(
    f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66 https://github.com/fluffy-linux/m4/releases/download/v$VERSION/m4-$VERSION.tar.xz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

MAKE() {
    # syscmd and esyscmd run the shell configure finds, the host's /bin/sh
    # here, but this m4 runs inside the root, which has none: autoconf's
    # m4_esyscmd (help2man's version in AC_INIT) failed.  Name the shell
    # the final m4 finds.
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/m4 \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess) \
        --with-syscmd-shell=/sw/bash/bin/sh
    make
}

INSTALL() {
    make install
}
