ON=host-build

VERSION=1.4.21

# Built straight from Fluffy's branch (our commits on upstream's v1.4.21
# tag): swctl fetches the pinned commit, and the gnulib, bootstrap and
# translationproject commits it pins, with git.  The tag has no
# configure, Makefile.in or gnulib files, so MAKE bootstraps it with the
# autotools m4's release tarball was made with (an autoconf
# pre-release), built with the host's, and the host's autopoint.
ARCHIVES=(
    d8fb16dab82b5c8bf095e93500abd18edbce58e9 https://github.com/fluffy-linux/m4.git#refs/heads/fluffy/v$VERSION
    0b379cd13a9e54b2bdc8ac17c188be7a07581d75 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.90
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-git --skip-po --gnulib-srcdir=gnulib
    # syscmd and esyscmd run the shell configure finds, the host's /bin/sh
    # here, but this m4 runs inside the root, which has none: autoconf's
    # m4_esyscmd (help2man's version in AC_INIT) failed.  Name the shell
    # the final m4 finds.
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/m4 \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess) \
        --with-syscmd-shell=/sw/bash/bin/sh
    # The translations as make dist merges them with m4.pot.
    make -C po update-po
    # The man page is help2man's output, and help2man needs perl, which
    # comes later: this temporary m4 writes and installs none.
    make HELP2MAN=: man_MANS=
}

INSTALL() {
    make HELP2MAN=: man_MANS= install
}
