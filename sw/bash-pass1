ON=host-build

VERSION=5.3

ARCHIVES=(
    0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba https://ftpmirror.gnu.org/bash/bash-$VERSION.tar.gz
    26b6fe28d82797afe85ba22ce897a80bb3d74bf46de0f64d702a021690a2ccef file://bash-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
    ncurses-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
    ncurses-pass1
)

MAKE() {
    patch -Z -Np1 -i bash-$VERSION-fluffy-source.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/bash \
        --build=$(sh support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc
    make
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh
}
