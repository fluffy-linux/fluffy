ON=host

VERSION=5.3

ARCHIVES=(
    0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba https://ftpmirror.gnu.org/bash/bash-$VERSION.tar.gz
)

NEEDS=(glibc-pass1 ncurses-pass1)
MAKE_NEEDS=(gcc-pass1 glibc-pass1 ncurses-pass1 linux-headers)

MAKE() {
    ./configure \
        --prefix=/sw/bash \
        --build=$(sh support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc
    make
}

INSTALL_NEEDS=(gcc-pass1 glibc-pass1 ncurses-pass1 linux-headers)

INSTALL() {
    make install
    ln -sv bash /sw/bash/bin/sh
}
