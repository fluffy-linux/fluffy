ON=host-build

VERSION=5.3

ARCHIVES=(
    0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba https://github.com/fluffy-linux/bash/releases/download/bash-$VERSION/bash-$VERSION.tar.gz
    f7b59e4800e659f04a0e9291a89d228fc8bd6a3fe9e638dcec146d4c1481c811 file://bash-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
    ncurses-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
    ncurses-pass1
)

MAKE() {
    patch -Z -Np1 -i bash-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bash \
        --build=$($CONFIG_SHELL support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc \
        CPPFLAGS='-DSYS_PROFILE="\"/sw/*/etc/profile:/etc/profile\"" -DSYS_INPUTRC="\"/sw/*/etc/inputrc:/etc/inputrc\""'
    make
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh
}
