ON=host-build

VERSION=5.3

ARCHIVES=(
    0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba https://ftpmirror.gnu.org/bash/bash-$VERSION.tar.gz
    9dd1e607089d21baff2db33932059035482948d5b21fa30bd671dc4cfff6f294 file://bash-$VERSION-fluffy-source.patch
)

NEEDS=(
    ncurses-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    linux-headers
    ncurses-pass1
)

MAKE() {
    patch -Z -Np1 -i bash-$VERSION-fluffy-source.patch

    ./configure \
        --prefix=/sw/bash \
        --build=$(sh support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc
    make
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh
}
