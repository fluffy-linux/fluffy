ON=host-build

VERSION=5.3

ARCHIVES=(
    d7705765d4680cae5e243edfe28b8cd146c25f47 https://github.com/fluffy-linux/bash.git#refs/heads/fluffy/bash-$VERSION
)

NEEDS=(
    glibc-pass1
    ncurses-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
    ncurses-pass1
)

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bash \
        --build=$($CONFIG_SHELL support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc \
        CPPFLAGS='-I/sw/ncurses/include -DSYS_PROFILE="\"/sw/*/etc/profile:/etc/profile\"" -DSYS_INPUTRC="\"/sw/*/etc/inputrc:/etc/inputrc\""'
    make
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh
}
