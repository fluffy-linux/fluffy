ON=host-build

VERSION=5.3

ARCHIVES=(
    0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba https://github.com/fluffy-linux/bash/releases/download/bash-$VERSION/bash-$VERSION.tar.gz
    79812c6d5c8caeea5d1cb56953b8193d2687b9a01a16279c90ee1038dd792a0c file://bash-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc-pass1
    ncurses-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
    ncurses-pass1
)

MAKE() {
    patch -Z -Np1 -i bash-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bash \
        --build=$($CONFIG_SHELL support/config.guess) \
        --host=$FLUFFY_TGT \
        --without-bash-malloc
    make
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh
}
