if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.26

# Built straight from Fluffy's branch (our commits on upstream's v1.26
# tag): swctl fetches the pinned commit, and the translationproject
# commit it pins, with git.  The tag has no configure, Makefile.in,
# gettext files, gdbmtool parser and scanner or gdbm.info, so MAKE
# regenerates them: with the autoconf, automake and libtool the release
# tarball was made with (2.71, 1.16.5, 2.5.4), from their Fluffy
# branches, and with Fluffy's autopoint, bison, flex and makeinfo.  The
# translations are the Translation Project's files the release took.
ARCHIVES=(
    1644f1ac7719f5b2ec573006281993bfb2d9a842 https://github.com/fluffy-linux/gdbm.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    2b62947fd566e11dedf3c2c7e252f05a8937d54c https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.5.4
)

NEEDS=(
    glibc
    ncurses
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        flex
        gawk-pass1
        gcc
        gettext
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        readline
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        readline
        sed
        tar
        texinfo
        xz
    )
fi

# Regenerated with the autotools gdbm's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gdbm \
        --disable-static \
        --enable-libgdbm-compat
    make
    # The test suite, generated with that autoconf's autom4te, as the
    # release's was.
    make -C tests testsuite
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
