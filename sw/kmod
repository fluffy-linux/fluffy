if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=34.2

# Built straight from Fluffy's branch (our commits on upstream's v34.2
# tag): swctl fetches the pinned commit with git.  kmod builds with meson,
# so the release tarball's autotools files are not needed.
ARCHIVES=(
    2a645f6949ec7bb391b7847ce3d3d57effbe4a4c https://github.com/fluffy-linux/kmod.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
    openssl
    xz
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        meson
        ninja
        openssl
        pkgconf
        python
        sed
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        meson
        ninja
        openssl
        pkgconf
        python
        sed
        xz
        zlib
        zstd
    )
fi

MAKE() {
    mkdir -p build
    cd build
    CFLAGS="-DVENDOR_PKG_PREFIX=\\\"/sw\\\" ${CFLAGS:-}" \
    meson setup --prefix=/sw/kmod \
        --buildtype=release \
        --sysconfdir=/etc \
        --sbindir=/sw/kmod/bin \
        --libdir=/sw/kmod/lib \
        -Dmoduledir=/sw/linux/lib/modules \
        -Dmanpages=false \
        -Dbuild-tests=true \
        ..
    ninja
}

CHECK() {
    meson test -C build --print-errorlogs
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install
}
