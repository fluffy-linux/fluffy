if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=34.2

HAS_LDFLAGS=-lkmod

ARCHIVES=(
    5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54 https://github.com/fluffy-linux/kmod/releases/download/v$VERSION/kmod-$VERSION.tar.xz
    e96a0f0805dd970126554b6b35c85b6ec73bb02394939c0c65e964b9ec2c0fb1 file://kmod-$VERSION-fluffy-test.patch
    11e6ed00e7f15bd8446a4f4f9160e3e1c441e8c71bae199c8459d69c18040202 file://kmod-$VERSION-fluffy.patch
)

NEEDS=(
    glibc
    openssl
    xz
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        meson
        ninja
        openssl
        patch-pass1
        python
        sed
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        meson
        ninja
        openssl
        patch
        python
        sed
        xz
        zlib
        zstd
    )
fi

MAKE() {
    patch -Z -Np1 -i kmod-$VERSION-fluffy-test.patch
    patch -Z -Np1 -i kmod-$VERSION-fluffy.patch

    mkdir -p build
    cd build
    CFLAGS="-DVENDOR_PKG_PREFIX=\\\"/sw\\\" ${CFLAGS:-}" \
    meson setup --prefix=/sw/kmod \
        --buildtype=release \
        --sysconfdir=/etc \
        --sbindir=/sw/kmod/bin \
        --libdir=/sw/kmod/lib \
        -Dmoduledir=/sw/linux/lib/modules \
        -Dmanpages=false \
        -Dbuild-tests=true \
        ..
    ninja
}

CHECK() {
    meson test -C build --print-errorlogs
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install
}
