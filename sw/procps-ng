if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.0.7

ARCHIVES=(
    9d2021f47a4501c667862c9942a92d1953694b21d11bcd1702e83eb594e3d67d https://downloads.sourceforge.net/procps-ng/procps-ng-$VERSION.tar.xz
    274386d20067991161324a26ab9da1a5bf5a85870c8c01dee8dfec6246330239 file://procps-ng-$VERSION-fluffy-source.patch
    60e072cee7493cd23903ebbb8e263d73420e0acbbd6f176c38db65ba65a01a26 file://procps-ng-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    libgcc
    ncurses
    systemd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i procps-ng-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i procps-ng-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    PKG_CONFIG="false" \
    NCURSES_CFLAGS=" " \
    NCURSES_LIBS="-lncursesw" \
    SYSTEMD_CFLAGS=" " \
    SYSTEMD_LIBS="-lsystemd" \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/procps-ng \
        --sbindir=/sw/procps-ng/bin \
        --docdir=/sw/procps-ng/share/doc/procps-ng-$VERSION \
        --disable-static \
        --disable-kill \
        --enable-watch8bit \
        --with-systemd
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    find $DESTDIR/sw/procps-ng -name '*.la' -delete
}
