if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.1.6

ARCHIVES=(
    0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d https://pypi.org/packages/source/J/Jinja2/jinja2-$VERSION.tar.gz
)

NEEDS=(
    markupsafe
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        markupsafe
        python
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        markupsafe
        python
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/jinja2 jinja2
}
