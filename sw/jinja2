if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.1.6

# Built straight from Fluffy's branch (upstream's 3.1.6 tag; Fluffy has no
# commits on it): swctl fetches the pinned commit with git.
ARCHIVES=(
    15206881c006c79667fe5154fe80c01c65410679 https://github.com/fluffy-linux/jinja.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    markupsafe
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        markupsafe
        python
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        flit-core
        markupsafe
        python
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/jinja2 jinja2
}
