if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.45.4

ARCHIVES=(
    49a7da83b0bdd9f46d04a04deec19c7767bb9a323e40c4781f89caf760b92c34 https://github.com/fluffy-linux/expect/releases/download/expect_${VERSION//./_}/expect$VERSION.tar.gz
    ab5fc0af9e2e0f80d7623c1a3a3dbeb1da3d8c9134276792199df401f9eb2cec file://expect-$VERSION-gcc15-1.patch
    a6d16fcc0e066e8216d2d822a89ff95359de03ad0614383fa5285c3f0fbebba6 file://expect$VERSION-fluffy-source.patch
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        glibc
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        glibc
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        tcl
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        tcl
    )
fi

MAKE() {
    patch -Z -Np1 -i expect-$VERSION-gcc15-1.patch
    patch -Z -Np1 -i expect$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/expect \
        --mandir=/sw/expect/share/man \
        --enable-shared \
        --disable-rpath
    make
}

CHECK() {
    make test
}

INSTALL() {
    make install
    ln -svf expect$VERSION/libexpect$VERSION.so $DESTDIR/sw/expect/lib
}
