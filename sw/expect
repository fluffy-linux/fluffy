if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.45.4

# Built straight from Fluffy's branch (our commits, LFS's gcc15 patch
# first, on upstream's expect-5-45-4 tag): swctl fetches the pinned
# commit with git.  configure is committed upstream.
ARCHIVES=(
    3414e50618cb610a13624197d9354dd37ec4c777 https://github.com/fluffy-linux/expect.git#refs/heads/fluffy/expect-${VERSION//./-}
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        glibc
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        glibc
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
        tar-pass1
        tcl
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        sed
        tar
        tcl
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/expect \
        --mandir=/sw/expect/share/man \
        --enable-shared \
        --disable-rpath
    make
}

CHECK() {
    make test
}

INSTALL() {
    make install
    ln -svf expect$VERSION/libexpect$VERSION.so $DESTDIR/sw/expect/lib
}
