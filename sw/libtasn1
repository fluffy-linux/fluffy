if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.21.0

# Built straight from Fluffy's branch (our commits on upstream's v4.21.0
# tag): swctl fetches the pinned commit, and the gnulib commit it pins,
# with git.  The tag has no configure, Makefile.in, gnulib files, ASN.1
# parser or manuals, so MAKE runs gnulib's bootstrap with the autoconf,
# automake and libtool the release tarball was made with (2.72, 1.17,
# 2.4.7), and make writes the parser with bison, the man pages with
# help2man and gdoc, and the manual with makeinfo.
ARCHIVES=(
    ca76ebd0c0019cd34168446b9f2a655b0cb9254b https://github.com/fluffy-linux/libtasn1.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    c47d100eab0ff3b64e16811f6b3925b233085497 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk
        gcc
        glibc
        grep
        gzip
        help2man
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar
        texinfo
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        help2man
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        tar
        texinfo
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/libtasn1 \
        --disable-static
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    find $DESTDIR/sw/libtasn1 -name '*.la' -delete
}
