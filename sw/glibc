if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.44
TZDATA_VERSION=2026c

# Built straight from Fluffy's branch (our commits on upstream's
# glibc-2.44 tag): swctl fetches the pinned commit with git.  The branch
# carries LFS's glibc-fhs-1 patch, its glibc-2.44-upstream_fixes-1 patch
# as the upstream commits it is made of, and the book's nsswitch.conf and
# hosts, which make install installs.  Two of the book's edits are left
# out because they change nothing here: its sed on the Makefile's
# test-installation line disables a check the Makefile only runs when
# the prefix is /usr and nothing is installed under DESTDIR, and its sed
# on ldd's RTLDLIST strips "/usr", which ldd's /sw/glibc paths do
# not contain.
ARCHIVES=(
    14921213fafa2dead5254a8585e3890e74b592cc https://github.com/fluffy-linux/glibc.git#refs/heads/fluffy/glibc-$VERSION
    e4a178a4477f3d0ea77cc31828ff72aa38feff8d61aa13e7e99e142e9d902be4 https://github.com/fluffy-linux/tz/releases/download/$TZDATA_VERSION/tzdata$TZDATA_VERSION.tar.gz
    0d0ebdf6c6a81658e352a96e703815779105a3489a52bc3c74746e07d368dda0 file://glibc.passwd
    b2b74131611f9116dfbae38c97575816812fe6273ccf795582bb12a5c21e2fea file://glibc.group
)

NEEDS=(
    libgcc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        perl-pass1
        python-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        grep
        gzip
        libgcc
        linux-headers
        make
        perl
        python
        sed
        tar
    )
fi

MAKE() {
    mkdir -v build
    cd build
    cat > configparms << "EOF"
rootsbindir=/sw/glibc/bin
sbindir=/sw/glibc/bin
user-defined-trusted-dirs=/sw/*/lib
EOF

    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/glibc \
        --disable-profile \
        --disable-werror \
        --enable-kernel=5.10 \
        --enable-stack-protector=strong \
        --disable-nscd \
        libc_cv_slibdir=/sw/glibc/lib
    make
}

CHECK() {
    cd build
    TIMEOUTFACTOR=10 make check || {
        if test -f tests.sum
        then
            for f in $(awk '/^FAIL:/ {print $2}' tests.sum)
            do
                echo "=== $f.out ==="
                cat "$f.out" || true
            done
        fi
        return 1
    }
}

INSTALL() {
    cd build
    make install
    # Serially: in parallel, the locales go into locale-archive in a
    # different order each time, and so does its layout, so glibc's image
    # never came out the same twice (the same 886 locales, ~78 MB of
    # differing bytes).
    make -j1 localedata/install-locales

    mkdir -p $DESTDIR/sw/glibc/etc
    install -m 644 ../../glibc.passwd $DESTDIR/sw/glibc/etc/passwd
    install -m 644 ../../glibc.group $DESTDIR/sw/glibc/etc/group

    cat > $DESTDIR/sw/glibc/etc/host.conf << "EOF"
multi on
EOF

    tar -xf ../../tzdata$TZDATA_VERSION.tar.gz
    ZONEINFO=$DESTDIR/sw/glibc/share/zoneinfo
    mkdir -pv $ZONEINFO/{posix,right}
    for tz in etcetera southamerica northamerica europe africa antarctica asia australasia backward
    do
        zic -L /dev/null   -d $ZONEINFO       $tz
        zic -L /dev/null   -d $ZONEINFO/posix $tz
        zic -L leapseconds -d $ZONEINFO/right $tz
    done
    cp -v zone.tab zone1970.tab iso3166.tab $ZONEINFO
    zic -d $ZONEINFO -p America/New_York
    unset ZONEINFO

    mkdir -p $DESTDIR/sw/glibc/share
    cat > $DESTDIR/sw/glibc/share/config.site << "EOF"
ac_cv_func_posix_spawn_file_actions_addchdir=yes
ac_cv_func_posix_spawn_file_actions_addfchdir=yes
EOF
}
