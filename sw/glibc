ON=cross-build

VERSION=2.44

ARCHIVES=(
    37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667 https://ftpmirror.gnu.org/glibc/glibc-$VERSION.tar.xz
    643552db030e2f2d7ffde4f558e0f5f83d3fabf34a2e0e56ebdb49750ac27b0d https://www.linuxfromscratch.org/patches/lfs/13.1/glibc-fhs-1.patch
    4b63488e050692d873aa99ceda2c36e902f2feebff0cbea4d9ab938ffcdc9d6e file://glibc-$VERSION-fluffy.patch
)

MAKE_NEEDS=(bash-pass1 bison-pass1 coreutils-pass1 diffutils-pass1 gawk-pass1 gcc-pass2 grep-pass1 linux-headers make-pass1 patch-pass1 perl-pass1 python-pass1 sed-pass1)

MAKE() {
    patch -Z -Np1 -i glibc-fhs-1.patch
    patch -Z -Np1 -i glibc-$VERSION-fluffy.patch

    mkdir -v build
    cd build
    echo "rootsbindir=/sw/glibc/bin" > configparms

    ../configure \
        --prefix=/sw/glibc \
        --disable-profile \
        --disable-werror \
        --enable-kernel=5.4 \
        --enable-stack-protector=strong \
        --disable-nscd \
        libc_cv_slibdir=/sw/glibc/lib
    make
}

CHECK_NEEDS=(bash-pass1 bison-pass1 coreutils-pass1 diffutils-pass1 gawk-pass1 gcc-pass2 grep-pass1 linux-headers make-pass1 perl-pass1 python-pass1 sed-pass1)

CHECK() {
    cd build
    make check
}

INSTALL_NEEDS=(bash-pass1 coreutils-pass1 gawk-pass1 gcc-pass2 linux-headers make-pass1 perl-pass1 python-pass1 sed-pass1)

INSTALL() {
    cd build
    make install
    sed '/RTLDLIST/s@/usr@@g' -i $DESTDIR/sw/glibc/bin/ldd
}
