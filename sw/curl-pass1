ON=host-build

VERSION=8.23.0

HAS_LDFLAGS=-lcurl

ARCHIVES=(
    8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5 https://curl.se/download/curl-$VERSION.tar.xz
    2594eb98f8272a60df111235b94bc5b0ea79ec5cff750801d02e270cd0fe037d file://curl-$VERSION-fluffy-source.patch
    a3f92fc9cec3592efcb089bcec37fa5025b8b7f3b67d22ca4a8abac343c4e4b7 file://curl-$VERSION-fluffy-test.patch
)

NEEDS=(
    ca-certificates
    glibc-pass1
    openssl-pass1
    zlib-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
    make-pass1
    openssl-pass1
    patch-pass1
    sed-pass1
    zlib-pass1
    zstd-pass1
)

MAKE() {
    patch -Z -Np1 -i curl-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i curl-$VERSION-fluffy-test.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --host=$FLUFFY_TGT \
        --build=$($CONFIG_SHELL ./config.guess) \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

INSTALL() {
    make install
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
