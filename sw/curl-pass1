ON=host-build

VERSION=8.21.0

# Built straight from Fluffy's branch (our commits on upstream's curl-8_21_0
# tag): swctl fetches the pinned commit with git.  The tag has no configure
# or Makefile.in, so MAKE regenerates them with autoreconf.
ARCHIVES=(
    9f43e798f75b411aaa1c615b864c2d9cc19f62a1 https://github.com/fluffy-linux/curl.git#refs/heads/fluffy/curl-${VERSION//./_}
)

NEEDS=(
    ca-certificates
    glibc-pass1
    openssl-pass1
    zlib-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
    make-pass1
    openssl-pass1
    pkgconf-pass1
    sed-pass1
    zlib-pass1
    zstd-pass1
)

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    # The host's autotools, as host-build uses the host's other tools.
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --host=$FLUFFY_TGT \
        --build=$($CONFIG_SHELL ./config.guess) \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

INSTALL() {
    make install
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
