ON=host-build

VERSION=8.21.0

# Built straight from Fluffy's branch (our commits on upstream's curl-8_21_0
# tag): swctl fetches the pinned commit with git.  The tag has no configure
# or Makefile.in, so MAKE regenerates them with the autoconf, automake and
# libtool the release tarball was made with (2.71, 1.16.5, 2.4.7), from
# their Fluffy branches.
ARCHIVES=(
    a7d85d2fe87a066f7ad214ea37827a0e04af2e73 https://github.com/fluffy-linux/curl.git#refs/heads/fluffy/curl-${VERSION//./_}
    e7648086b3e532ccae07faa400570f86aa3e6780 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    18416d641dc5c220ec82283ff43cdaa7cb0d619c https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    5e3be7ab26ea416c6c29a3b6536d5e8d778f4142 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    ca-certificates
    glibc-pass1
    openssl-pass1
    zlib-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
    make-pass1
    openssl-pass1
    pkgconf-pass1
    sed-pass1
    zlib-pass1
    zstd-pass1
)

# Regenerated with the autotools curl's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --host=$FLUFFY_TGT \
        --build=$($CONFIG_SHELL ./config.guess) \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

INSTALL() {
    make install
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
