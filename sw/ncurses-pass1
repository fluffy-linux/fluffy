ON=host-build

VERSION=6.6

# Built straight from Fluffy's branch (our commits on upstream's v6_6
# snapshot tag, which equals the release tarball, LFS's curses.h edit
# among them): swctl fetches the pinned commit with git.
ARCHIVES=(
    6ad2db4a4fcf810e9b797b55a7e1af0903579f6c https://github.com/fluffy-linux/ncurses-snapshots.git#refs/heads/fluffy/v${VERSION//./_}
)

NEEDS=(
    glibc-pass1
    libstdcpp-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    libstdcpp-pass1
    linux-headers
)

MAKE() {
    mkdir -pv build
    pushd build
        CONFIG_SITE=/sw/glibc/share/config.site ../configure AWK=gawk
        make -C include
        make -C progs tic
    popd

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/ncurses \
        --host=$FLUFFY_TGT \
        --build=$(./config.guess) \
        --mandir=/sw/ncurses/share/man \
        --with-manpage-format=normal \
        --with-terminfo-dirs="/etc/terminfo:/sw/*/share/terminfo" \
        --with-shared \
        --without-normal \
        --with-cxx-shared \
        --without-debug \
        --without-ada \
        --disable-stripping \
        --enable-widec \
        --enable-overwrite \
        AWK=gawk
    make
}

INSTALL() {
    PATH="$PWD/build/progs:$PATH" make install
    ln -sv libncursesw.so $DESTDIR/sw/ncurses/lib/libncurses.so
}
