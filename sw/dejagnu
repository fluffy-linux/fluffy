if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.6.3

# Built straight from Fluffy's branch (our commits on upstream's
# dejagnu-1.6.3-release tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    3c3d69df20d57d273d00023188243b72c6ce3f6f https://github.com/fluffy-linux/dejagnu.git#refs/heads/fluffy/dejagnu-$VERSION-release
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        expect
        gawk-pass1
        grep-pass1
        sed-pass1
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        expect
        gawk
        grep
        sed
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
        tar-pass1
        tcl
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        sed
        tar
        tcl
        texinfo
    )
fi

MAKE() {
    mkdir -v build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ../configure \
        --prefix=/sw/dejagnu
    # The release tarball ships doc/dejagnu.info; git has only the
    # Texinfo source, so build it here.
    make
    makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
    makeinfo --plaintext       -o doc/dejagnu.txt  ../doc/dejagnu.texi
}

CHECK() {
    cd build
    make check
}

INSTALL() {
    cd build
    make install
    install -v -dm755  $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
    install -v -m644   doc/dejagnu.{html,txt} $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
}
