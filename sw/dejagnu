if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.6.3

ARCHIVES=(
    87daefacd7958b4a69f88c6856dbd1634261963c414079d0c371f589cd66a2e3 https://ftpmirror.gnu.org/dejagnu/dejagnu-$VERSION.tar.gz
    36bb31081a9172482d34870e8e9abe9a39314385c3b6a8829848fede7872f0a1 file://dejagnu-$VERSION-fluffy-shell.patch
    84402dfb6becdb4535dc8d4f105685feacd09a0248e008a2bec5f5260cb1e2b7 file://dejagnu-$VERSION-fluffy-source.patch
    8150c0cfe6033cedd215c5f33b0f7880b0f44b0c163d23c8c73dc56a466bdf6a file://dejagnu-$VERSION-fluffy-test.patch
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        expect
        gawk-pass1
        grep-pass1
        sed-pass1
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        expect
        gawk
        grep
        sed
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        tcl
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        tcl
        texinfo
    )
fi

MAKE() {
    patch -Z -Np1 -i dejagnu-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i dejagnu-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i dejagnu-$VERSION-fluffy-test.patch

    mkdir -v build
    cd build

    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/dejagnu
    makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
    makeinfo --plaintext       -o doc/dejagnu.txt  ../doc/dejagnu.texi
}

CHECK() {
    cd build
    make check
}

INSTALL() {
    cd build
    make install
    install -v -dm755  $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
    install -v -m644   doc/dejagnu.{html,txt} $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
}
