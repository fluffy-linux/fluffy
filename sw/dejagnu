if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.6.3

ARCHIVES=(
    87daefacd7958b4a69f88c6856dbd1634261963c414079d0c371f589cd66a2e3 https://github.com/fluffy-linux/dejagnu/releases/download/dejagnu-$VERSION-release/dejagnu-$VERSION.tar.gz
    9f39bfd22753e0e2f0c4c7b30c335842c768a2e982bcbe5b8150e1c1ed0ddc12 file://dejagnu-$VERSION-fluffy-source.patch
    41a5ab8452af4d665f4eab676229c33a8bc7901034e8a2281c7e1f0bd005bdd2 file://dejagnu-$VERSION-fluffy-test.patch
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        expect
        gawk-pass1
        grep-pass1
        sed-pass1
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        expect
        gawk
        grep
        sed
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        tcl
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        tcl
        texinfo
    )
fi

MAKE() {
    patch -Z -Np1 -i dejagnu-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i dejagnu-$VERSION-fluffy-test.patch

    mkdir -v build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ../configure \
        --prefix=/sw/dejagnu
    makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
    makeinfo --plaintext       -o doc/dejagnu.txt  ../doc/dejagnu.texi
}

CHECK() {
    cd build
    make check

    tclsh <<'EOF'
set td [exec mktemp -d]
set d_bkt [file join $td {1:pkg} bin]
set d_bs  [file join $td "dir_bs\\"]
set d_lit [file join $td "lit\[1\]" bin]
set d_li1 [file join $td "lit1" bin]
set d_br  [file join $td {br{a,b}} pkg bin]
file mkdir $d_bkt $d_bs $d_lit $d_li1 $d_br
foreach {d fn} [list $d_bkt dj_probe $d_lit lit_probe $d_li1 lit_probe $d_br br_probe] {
    set fp [file join $d $fn]
    set fd [open $fp w]
    puts $fd "stub"
    close $fd
    file attributes $fp -permissions 0755
}

proc verbose {args} {}
proc warning {args} {}
source ../lib/utils.exp

set env(PATH) "/sw/*/bin"
if {[which gcc] eq "0"} {
    error "which gcc failed under PATH=/sw/*/bin"
}
set env(PATH) [format ":%s:%s:%s/%s/*/bin:%s/%s/bin:/sw/*/bin" $d_bs $d_lit $td {br{a,b}} $td {1[a:]pkg}]
if {[which dj_probe] ne [file join $d_bkt dj_probe]} {
    error "which dj_probe failed under bracket-colon PATH"
}
if {[which lit_probe] ne [file join $d_lit lit_probe]} {
    error "which lit_probe failed literal \[1\] precedence"
}
if {[which br_probe] ne [file join $d_br br_probe]} {
    error "which br_probe failed brace literal wildcard PATH"
}
file delete -force $td
EOF
}

INSTALL() {
    cd build
    make install
    install -v -dm755  $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
    install -v -m644   doc/dejagnu.{html,txt} $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
}
