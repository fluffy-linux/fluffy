if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.6.3

ARCHIVES=(
    87daefacd7958b4a69f88c6856dbd1634261963c414079d0c371f589cd66a2e3 https://github.com/fluffy-linux/dejagnu/releases/download/dejagnu-$VERSION-release/dejagnu-$VERSION.tar.gz
    9f39bfd22753e0e2f0c4c7b30c335842c768a2e982bcbe5b8150e1c1ed0ddc12 file://dejagnu-$VERSION-fluffy-source.patch
    4bfe7bdb2c90092ebed5a5d26a42124b3fa71cd0f1817c6e4a9763a4ecce141d file://dejagnu-$VERSION-fluffy-test.patch
)

if test -v CROSS
then
    NEEDS=(
        bash-pass1
        coreutils-pass1
        expect
        gawk-pass1
        grep-pass1
        sed-pass1
        tcl
    )
else
    NEEDS=(
        bash
        coreutils
        expect
        gawk
        grep
        sed
        tcl
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        tcl
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        tcl
        texinfo
    )
fi

MAKE() {
    patch -Z -Np1 -i ../dejagnu-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ../dejagnu-$VERSION-fluffy-test.patch

    mkdir -v build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ../configure \
        --prefix=/sw/dejagnu
    makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
    makeinfo --plaintext       -o doc/dejagnu.txt  ../doc/dejagnu.texi
}

CHECK() {
    cd build
    make check
}

INSTALL() {
    cd build
    make install
    install -v -dm755  $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
    install -v -m644   doc/dejagnu.{html,txt} $DESTDIR/sw/dejagnu/share/doc/dejagnu-$VERSION
}
