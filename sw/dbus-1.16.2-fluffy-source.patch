 #define DBUS_UNIX_STANDARD_SYSTEM_SERVICEDIR "/dbus-1/system-services"
 
+static dbus_bool_t
+_dbus_split_glob_paths_and_append (DBusString *dirs,
+                                   const char *suffix,
+                                   DBusList  **dir_list)
+{
+  DBusList *raw_dirs = NULL;
+  DBusList *link;
+
+  if (!_dbus_split_paths_and_append (dirs, suffix, &raw_dirs))
+    return FALSE;
+
+  while ((link = _dbus_list_pop_first_link (&raw_dirs)) != NULL)
+    {
+      char *cpath = link->data;
+
+      if (strpbrk (cpath, "*?[") != NULL)
+        {
+          glob_t gl;
+          int rc;
+
+          _dbus_list_free_link (link);
+          memset (&gl, 0, sizeof (gl));
+          rc = glob (cpath, 0, NULL, &gl);
+          dbus_free (cpath);
+
+          if (rc == 0)
+            {
+              size_t j;
+
+              for (j = 0; j < gl.gl_pathc; j++)
+                {
+                  char *matched = _dbus_strdup (gl.gl_pathv[j]);
+
+                  if (matched == NULL || !_dbus_list_append (dir_list, matched))
+                    {
+                      dbus_free (matched);
+                      globfree (&gl);
+                      goto oom;
+                    }
+                }
+            }
+          else if (rc == GLOB_NOSPACE)
+            {
+              globfree (&gl);
+              goto oom;
+            }
+
+          globfree (&gl);
+        }
+      else
+        {
+          _dbus_list_append_link (dir_list, link);
+        }
+    }
+
+  return TRUE;
+
+oom:
+  _dbus_list_clear_full (&raw_dirs, dbus_free);
+  _dbus_list_clear_full (dir_list, dbus_free);
+  return FALSE;
+}
+
 /**
  * Returns the standard directories for a session bus to look for
  * transient service activation files.
