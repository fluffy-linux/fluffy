# From git the build also runs bison (the grammars), gperf (gnulib's
# lookup tables), makeinfo (the manuals), help2man (the man pages, which
# it writes by running the programs; spit is a Python script) and groff
# (their HTML), which the release tarball ships made.  In cross-build
# gperf, groff, help2man, python and texinfo come after gettext and need
# it, so their pass1 builds stand in.  gettext's own copy of help2man
# needs perl's Locale::gettext, which Fluffy lacks (it is in neither LFS
# nor BLFS), so MAKE runs Fluffy's help2man instead.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    export GNULIB_SRCDIR=$PWD/gnulib
    $CONFIG_SHELL ./autopull.sh
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gettext \
        --disable-static \
        --docdir=/sw/gettext/share/doc/gettext-$VERSION
    # The manuals are dated by their .texi's time, as the release's are
    # (git gives every file the commit's).
    touch -d '2026-01-27 12:00 UTC' gettext-tools/doc/gettext.texi
    touch -d '2025-10-01 12:00 UTC' libtextstyle/doc/libtextstyle.texi
    # The release's man pages are dated by the release (its v1.0 tag,
    # January 2026); help2man dates them by SOURCE_DATE_EPOCH.
    SOURCE_DATE_EPOCH=1769645591 make HELP2MAN='$(PERL) -w -- '"$(command -v help2man)"
    # The examples' translations, installed with them, as make dist
    # writes them from the release's templates.
    make -C gettext-tools/examples/po update-po
}

CHECK() {
    make check
}

# Beyond LFS: spit, a Python script, and its pages are left out; they are
# sw/gettext-spit, which NEEDS python (gettext can't: see there).
INSTALL() {
    make install
    chmod -v 0755 $DESTDIR/sw/gettext/lib/preloadable_libintl.so
    rm -fv $DESTDIR/sw/gettext/lib/lib*.la
    rm -v $DESTDIR/sw/gettext/bin/spit \
        $DESTDIR/sw/gettext/share/man/man1/spit.1 \
        $DESTDIR/sw/gettext/share/doc/gettext-$VERSION/spit.1.html
}
