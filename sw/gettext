if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0

ARCHIVES=(
    71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7 https://github.com/fluffy-linux/gettext/releases/download/v$VERSION/gettext-$VERSION.tar.xz
    24d2a42e3eb51d0574b51e019e5864f374dc2a26170049ac00f5db849567d0ce file://gettext-$VERSION-fluffy-shell.patch
)

NEEDS=(
    acl
    attr
    gcc
    glibc
    libgcc
    libstdcpp
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext-pass1
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        perl-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i gettext-$VERSION-fluffy-shell.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/gettext \
        --disable-static \
        --docdir=/sw/gettext/share/doc/gettext-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    chmod -v 0755 $DESTDIR/sw/gettext/lib/preloadable_libintl.so
    rm -fv $DESTDIR/sw/gettext/lib/lib*.la
}
