if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0

# Built straight from Fluffy's branch (our commits on upstream's v1.0
# tag): swctl fetches the pinned commit, and the gnulib and tree-sitter
# commits it pins, with git.  The tag has no configure, Makefile.in or
# gnulib files, so MAKE runs autopull.sh and autogen.sh with the
# autotools gettext's release tarball was made with.
ARCHIVES=(
    83f7f5a3e73d40559dfce09dcb78cc9ef4bf8f87 https://github.com/fluffy-linux/gettext.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
    8e25f43f9ecbcfbbc48762662d46fa54164876af https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.6.0
)

NEEDS=(
    acl
    attr
    gcc
    glibc
    libgcc
    libstdcpp
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext-pass1
        glibc
        gperf-pass1
        grep-pass1
        groff-pass1
        gzip-pass1
        help2man-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        perl-pass1
        python-pass1
        sed-pass1
        tar-pass1
        texinfo-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        gperf
        grep
        groff
