if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.0

ARCHIVES=(
    71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7 https://ftpmirror.gnu.org/gettext/gettext-$VERSION.tar.xz
    0dcf6b402f8ba8c40e98ea1c5c79daab2f0143629351263c1e0c798eaabd9a9b file://gettext-$VERSION-fluffy-shell.patch
)

NEEDS=(
    acl
    attr
    glibc
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext-pass1
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        perl-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i gettext-$VERSION-fluffy-shell.patch

    ./configure \
        --prefix=/sw/gettext \
        --disable-static \
        --docdir=/sw/gettext/share/doc/gettext-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    chmod -v 0755 $DESTDIR/sw/gettext/lib/preloadable_libintl.so
}
