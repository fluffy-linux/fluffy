+char *
+shell_next_path_pattern (const char *path_list, size_t *idx_p, int *has_glob_p)
+{
+  const char *end, *seg_start, *colon;
+  size_t seg_len;
+  int has_glob, has_bs;
+  char *out;
+
+  if (path_list == 0 || *idx_p == (size_t)-1)
+    return ((char *)NULL);
+
+  end = path_list + strlen (path_list);
+  seg_start = path_list + *idx_p;
+  colon = shell_scan_path_colon (seg_start, end, &has_glob, &has_bs);
+  seg_len = (size_t)(colon - seg_start);
+
+  if (*colon == ':')
+    *idx_p = (size_t)(colon - path_list) + 1;
+  else
+    *idx_p = (size_t)-1;
+
+  if (seg_len == 0)
+    {
+      *has_glob_p = 0;
+      return (savestring ("."));
+    }
+
+  if (glob_ignore_case || (seg_len > 1 && seg_start[0] == '\\' && seg_start[1] == '~'))
+    has_glob = 1;
+
+  *has_glob_p = has_glob;
+  out = (char *)xmalloc (seg_len + 1);
+  if (has_glob == 0 && has_bs)
+    {
+      size_t si, di = 0;
+      for (si = 0; si < seg_len; ++si)
+	{
+	  if (seg_start[si] == '\\' && si + 1 < seg_len)
+	    ++si;
+	  out[di++] = seg_start[si];
+	}
+      out[di] = '\0';
+    }
+  else
+    {
+      memcpy (out, seg_start, seg_len);
+      out[seg_len] = '\0';
+    }
+  return (out);
+}
+
+static char **
+shell_run_path_glob (const char *pat)
+{
+  glob_t g;
+  int gflags, r;
+
+  noglob_dot_filenames = glob_dot_filenames == 0;
+  QUIT;
+  gflags = bash_glob_flags ();
+  if (posixly_correct == 0)
+    gflags |= GLOB_TILDE;
+  memset (&g, 0, sizeof (g));
+  r = glob (pat, gflags, NULL, &g);
+
+  if (interrupt_state || terminating_signal)
+    {
+      if (g.gl_pathv)
+	globfree (&g);
+      QUIT;
+    }
+  run_pending_traps ();
+
+  if (r != 0)
+    {
+      if (g.gl_pathv)
+	globfree (&g);
+      return ((char **)NULL);
+    }
+
+  return (g.gl_pathv);
+}
+
+char **
+shell_glob_path_segment (const char *seg)
+{
+  return (shell_run_path_glob (seg ? seg : "."));
+}
+
+char **
+shell_glob_path_target (const char *seg, const char *name)
+{
+  size_t slen, nlen, i, p;
+  char *pat, **res;
+
+  slen = strlen (seg);
+  while (slen > 1 && seg[slen - 1] == '/')
+    {
+      size_t bs = 0;
+      while (bs < slen - 1 && seg[slen - 2 - bs] == '\\')
+	++bs;
+      if (bs & 1)
+	break;
+      --slen;
+    }
+
+  nlen = strlen (name);
+  pat = (char *)xmalloc (slen + 1 + (nlen * 2) + 1);
+  memcpy (pat, seg, slen);
+  p = slen;
+  if (p == 0 || pat[p - 1] != '/')
