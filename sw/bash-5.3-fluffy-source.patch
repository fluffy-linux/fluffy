-char **
-glob_vector (char *pat, char *dir, int flags)
-{
-  DIR *d;
-  struct dirent *dp;
-  struct globval *nextlink, *lastlink, *e, *dirlist;
-  char *nextname, *npat, *subdir;
-  unsigned int count, i;
-  int lose, skip, ndirs, isdir, add_current;
