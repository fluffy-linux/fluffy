+static const char *
+shell_scan_path_colon (const char *cp, const char *end,
+		       int *has_glob_p, int *has_bs_p)
+{
+  int has_glob = 0;
+  int has_bs = 0;
+
+  while (cp < end && *cp != '\0')
+    {
+      if (*cp == '\\')
+	{
+	  has_bs = 1;
+	  ++cp;
+	  if (cp < end && *cp != '\0')
+	    ++cp;
+	}
+      else if (*cp == '*' || *cp == '?')
+	{
+	  has_glob = 1;
+	  ++cp;
+	}
+      else if (*cp == '[')
+	{
+	  const char *p = cp + 1;
+	  if (p < end && (*p == '!' || *p == '^'))
+	    ++p;
+	  if (p < end && *p == ']')
+	    ++p;
+	  while (p < end && *p != '\0' && *p != ']')
+	    {
+	      if (*p == '\\' && p + 1 < end)
+		++p;
+	      else if (p[0] == '[' && p + 1 < end
+		       && (p[1] == ':' || p[1] == '.' || p[1] == '='))
+		{
+		  char ctype = p[1];
+		  const char *t = p + 2;
+		  while (t < end && *t != '\0' && (ctype == '.' || *t != ']'))
+		    {
+		      if (*t == ctype && t + 1 < end && t[1] == ']')
+			{
+			  p = t + 1;
+			  break;
+			}
+		      ++t;
+		    }
+		}
+	      ++p;
+	    }
+	  if (p < end && *p == ']')
+	    {
+	      has_glob = 1;
+	      cp = p + 1;
+	    }
+	  else
+	    ++cp;
+	}
+      else if (extended_glob && cp + 1 < end && cp[1] == '('
+	       && (*cp == '?' || *cp == '*' || *cp == '+'
+		   || *cp == '@' || *cp == '!'))
+	{
+	  const char *p = cp + 2;
+	  int depth = 1;
+	  while (p < end && *p != '\0' && depth > 0)
+	    {
+	      if (*p == '\\' && p + 1 < end)
+		++p;
+	      else if (*p == '(')
+		++depth;
+	      else if (*p == ')')
+		--depth;
+	      ++p;
+	    }
+	  if (depth == 0)
+	    {
+	      has_glob = 1;
+	      cp = p;
+	    }
+	  else
+	    ++cp;
+	}
+      else if (*cp == ':')
+	break;
+      else
+	++cp;
+    }
+
+  *has_glob_p = has_glob;
+  *has_bs_p = has_bs;
+  return cp;
+}
