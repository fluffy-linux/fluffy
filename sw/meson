if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.12.0

# Built straight from Fluffy's branch (our commits on upstream's 1.12.0
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    cdafdf57bc3b0ddede7dcd2505e772a08b382bab https://github.com/fluffy-linux/meson.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    ninja
    python
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        gcc
        glibc
        libgcc
        linux-headers
        ninja
        packaging
        python
        setuptools
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        gcc
        glibc
        libgcc
        linux-headers
        ninja
        packaging
        python
        setuptools
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

CHECK() {
    python3 -B -m unittest \
        unittests/internaltests.py \
        unittests/optiontests.py \
        unittests/taptests.py \
        unittests/versiontests.py \
        unittests/cargotests.py \
        unittests/datatests.py
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/meson meson
    install -vDm644 data/shell-completions/bash/meson "$DESTDIR/sw/meson/share/bash-completion/completions/meson"
    install -vDm644 data/shell-completions/zsh/_meson "$DESTDIR/sw/meson/share/zsh/site-functions/_meson"
}
