if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=9.11

# Built straight from Fluffy's branch (our commits on upstream's v9.11
# tag, LFS's i18n patch among them): swctl fetches the pinned commit, and
# the gnulib and translationproject commits it pins, with git.  The tag
# has no configure, Makefile.in or gnulib files, so MAKE bootstraps it,
# and its translations come from the Translation Project's files (or the
# release's own, where TP's no longer give them), merged as the
# release's make dist did.
ARCHIVES=(
    73b280fb5e222f019ed67a26c49ff68f1ea73484 https://github.com/fluffy-linux/coreutils.git#refs/heads/fluffy/v$VERSION
    83bfc9cc82d6b4480d7ed9838823212dfb3aa03b https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.73.1-b400b
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
)

