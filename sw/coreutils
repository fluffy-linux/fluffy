if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=9.11

ARCHIVES=(
    394024eda0a5955217ceda9cd1201e65dc8fa3aa29c2951135a49521d57c3cc3 https://github.com/fluffy-linux/coreutils/releases/download/v$VERSION/coreutils-$VERSION.tar.xz
    7c2aecf9ae24b87b019595e382b9f41d2c96de7f95abe95ad8cacc7e2ce1bbcc file://coreutils-$VERSION-i18n-1.patch
    2bc3a5a73b2eba8a3e29554f43baa0c2c8c1e4a75cee059c4fb68785f1b8c29a file://coreutils-$VERSION-fluffy-shell.patch
    c24ff3e4dd0e9bb5423612f974ccd660f9cc8ac180d9bf02b6ff656e3d1b0a90 file://coreutils-$VERSION-fluffy-source.patch
)

NEEDS=(
    acl
    attr
    glibc
    gmp
    libcap
    openssl
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        autoconf
        automake
        bash
        binutils
        bzip2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        gettext
        glibc
        gmp
        grep
        gzip-pass1
        libcap
        libgcc
        linux-headers
        m4
        make-pass1
        openssl
        patch-pass1
        perl
        python
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        acl
        attr
        autoconf
        automake
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        gmp
        grep
        gzip
        libcap
        libgcc
        linux-headers
        m4
        make
        openssl
        patch
        perl
        python
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i coreutils-$VERSION-i18n-1.patch
    patch -Z -Np1 -i coreutils-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i coreutils-$VERSION-fluffy-source.patch

    autoreconf -fv
    automake -af
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/coreutils
    make
}

CHECK() {
    unset SOURCE_DATE_EPOCH
    make RUN_EXPENSIVE_TESTS=yes check < /dev/null
}

INSTALL() {
    make install
    find $DESTDIR/sw/coreutils -name '*.la' -delete
}
