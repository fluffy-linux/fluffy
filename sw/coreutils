# Bootstrapped with the autotools coreutils' release tarball was made
# with: an autoconf development snapshot and automake 1.18.1.  bootstrap
# also requires bison and gperf, and the build makes with them what the
# release tarball ships made (gnulib's parse-datetime, lookup tables).
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/coreutils
    # The translations as make dist merges them with coreutils.pot.
    make -C po update-po
    # The manual is dated by coreutils.texi's time, as the release's is
    # (git gives every file the commit's).
    touch -d '2026-04-06 12:00 UTC' doc/coreutils.texi
    # The release's man pages are dated by the release (its v9.11 tag,
    # April 2026); man/help2man dates them by SOURCE_DATE_EPOCH.
    SOURCE_DATE_EPOCH=1776688917 make
}

CHECK() {
    unset SOURCE_DATE_EPOCH
    make RUN_EXPENSIVE_TESTS=yes check < /dev/null
}

INSTALL() {
    make install
    find $DESTDIR/sw/coreutils -name '*.la' -delete
}
