+static ParameterError existingfile_or_glob(char **store,
+                                           const struct LongShort *a,
+                                           const char *filename)
+{
+  if(strpbrk(filename, "*?["))
+    return getstr(store, filename, DENY_BLANK);
+  return existingfile(store, a, filename);
+}
