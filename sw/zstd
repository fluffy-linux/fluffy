if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.5.7

# Built straight from Fluffy's branch (our commits on upstream's v1.5.7
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    82999a3e7c505c51b2a91481fe43b111593dd4dd https://github.com/fluffy-linux/zstd.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
    lz4
    xz
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        file
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        lz4
        make-pass1
        pkgconf
        sed-pass1
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        file
        gcc
        glibc
        grep
        libgcc
        linux-headers
        lz4
        make
        pkgconf
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    make prefix=/sw/zstd
}

CHECK() {
    make check
}

INSTALL() {
    make prefix=/sw/zstd install
    rm -v $DESTDIR/sw/zstd/lib/libzstd.a
}
