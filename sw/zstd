if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.5.7

HAS_LDFLAGS=-lzstd

ARCHIVES=(
    eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3 https://github.com/facebook/zstd/releases/download/v$VERSION/zstd-$VERSION.tar.gz
    1fa8da4aae3c3a47eb01266fc23aa0312b2615c6c39985d0a799954b3f826695 file://zstd-$VERSION-fluffy-shell.patch
    43e1e3ea0f9fc4b3a01a5a4842b797504ac74e5f3e092cc60cca520114d275d4 file://zstd-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    lz4
    xz
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        file
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        lz4
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        file
        gcc
        glibc
        grep
        libgcc
        linux-headers
        lz4
        make
        patch
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i zstd-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i zstd-$VERSION-fluffy-test.patch
    make prefix=/sw/zstd
}

CHECK() {
    make check
}

INSTALL() {
    make prefix=/sw/zstd install
    rm -v $DESTDIR/sw/zstd/lib/libzstd.a
}
