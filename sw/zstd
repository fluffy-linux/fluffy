if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.5.7

# Built from Fluffy's branch (our commits on upstream's v1.5.7 tag), no
# patch: GitHub's tarball of the branch until it is released.
ARCHIVES=(
    263d3947df065888d4bb0a26df5b02d12ae11209c52005420643b0132ca71b2a https://github.com/fluffy-linux/zstd/archive/refs/heads/fluffy/v$VERSION.tar.gz
)

NEEDS=(
    glibc
    lz4
    xz
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        file
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        lz4
        make-pass1
        patch-pass1
        pkgconf
        sed-pass1
        tar-pass1
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        file
        gcc
        glibc
        grep
        libgcc
        linux-headers
        lz4
        make
        patch
        pkgconf
        sed
        tar
        xz
        zlib
    )
fi

MAKE() {
    make prefix=/sw/zstd
}

CHECK() {
    make check
}

INSTALL() {
    make prefix=/sw/zstd install
    rm -v $DESTDIR/sw/zstd/lib/libzstd.a
}
