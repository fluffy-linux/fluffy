if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=84.0.0

ARCHIVES=(
    f4695c21257f0d9b537ec2692c941d02ee143b7cc1276941349a546573b2ef73 https://pypi.org/packages/source/s/setuptools/setuptools-$VERSION.tar.gz
)

NEEDS=(
    wheel
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        coreutils-pass1
        packaging
        python
        wheel
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        packaging
        python
        wheel
    )
fi

MAKE() {
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

INSTALL() {
    pip3 install --no-index --find-links dist --no-cache-dir --no-build-isolation --root "$DESTDIR" --prefix /sw/setuptools setuptools
}
