ON=host-build

VERSION=2026.10.20

ARCHIVES=(
    796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe https://curl.se/ca/cacert.pem
)

INSTALL_NEEDS=(
    coreutils-pass1
)

INSTALL() {
    install -vdm755 $DESTDIR/sw/ca-certificates/etc/ssl/certs
    install -vm644 cacert.pem $DESTDIR/sw/ca-certificates/etc/ssl/certs/ca-certificates.crt
    ln -sfv certs/ca-certificates.crt $DESTDIR/sw/ca-certificates/etc/ssl/cert.pem
}
