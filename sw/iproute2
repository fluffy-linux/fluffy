if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.1.0

ARCHIVES=(
    fd9fa1b95809417157ca83dd72957e3261bdbce896353cb936f80af0b33a4b5c https://github.com/fluffy-linux/iproute2/releases/download/v$VERSION/iproute2-$VERSION.tar.xz
    b5868b22f31d231dd8667c9d27caf483adeb1377ffd1ded2c0fd133b57e833ad file://iproute2-$VERSION-fluffy-source.patch
    359ef28f1926e3f105e4d80fb0dc0c608e38ed11470a0c23622a4c59e73413b8 file://iproute2-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    libcap
    libelf
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip-pass1
        libcap
        libelf
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        pkgconf
        python
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip
        libcap
        libelf
        libgcc
        linux-headers
        make
        patch
        pkgconf
        python
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i ../iproute2-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i ../iproute2-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix /sw/iproute2
    CFLAGS='-DCONF_VENDOR_DIR="\"/sw/*/etc/iproute2\""' \
    make \
        PREFIX=/sw/iproute2 \
        SBINDIR=/sw/iproute2/bin \
        CONF_USR_DIR=/sw/iproute2/etc/iproute2 \
        CONF_ETC_DIR=/etc/iproute2 \
        NETNS_RUN_DIR=/run/netns
}

CHECK() {
    make check-unit
}

INSTALL() {
    make \
        PREFIX=/sw/iproute2 \
        SBINDIR=/sw/iproute2/bin \
        CONF_USR_DIR=/sw/iproute2/etc/iproute2 \
        CONF_ETC_DIR=/etc/iproute2 \
        NETNS_RUN_DIR=/run/netns \
        install
}
