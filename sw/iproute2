if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=7.1.0

ARCHIVES=(
    05167cc5bb37f13900bccf69289cc22c1a4d256d https://github.com/fluffy-linux/iproute2.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
    libcap
    libelf
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip-pass1
        libcap
        libelf
        libgcc
        linux-headers
        make-pass1
        pkgconf
        python
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip
        libcap
        libelf
        libgcc
        linux-headers
        make
        pkgconf
        python
        sed
        tar
    )
fi

MAKE() {

    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix /sw/iproute2
    CFLAGS='-DCONF_VENDOR_DIR="\"/sw/*/etc/iproute2\""' \
    make \
        PREFIX=/sw/iproute2 \
        SBINDIR=/sw/iproute2/bin \
        CONF_USR_DIR=/sw/iproute2/etc/iproute2 \
        CONF_ETC_DIR=/etc/iproute2 \
        NETNS_RUN_DIR=/run/netns
}

CHECK() {
    make check-unit
}

INSTALL() {
    make \
        PREFIX=/sw/iproute2 \
        SBINDIR=/sw/iproute2/bin \
        CONF_USR_DIR=/sw/iproute2/etc/iproute2 \
        CONF_ETC_DIR=/etc/iproute2 \
        NETNS_RUN_DIR=/run/netns \
        install
}
