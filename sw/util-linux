MAKE() {
    patch -Z -Np1 -i util-linux-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    PKG_CONFIG="false" \
    SYSTEMD_CFLAGS=" " \
    SYSTEMD_LIBS="-lsystemd" \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/util-linux \
        --sbindir=/sw/util-linux/bin \
        --runstatedir=/run \
        --enable-fs-paths-default='/sw/*/bin' \
        --disable-chfn-chsh \
        --disable-login \
        --disable-nologin \
        --disable-su \
        --disable-setpriv \
        --disable-runuser \
        --disable-pylibmount \
        --disable-liblastlog2 \
        --disable-pam-lastlog2 \
        --disable-static \
        --disable-bash-completion \
        --disable-makeinstall-chown \
        --disable-makeinstall-setuid \
        --without-python \
        --with-systemd \
        --with-systemdsystemunitdir=/sw/util-linux/lib/systemd/system \
        --with-tmpfilesdir=/sw/util-linux/lib/tmpfiles.d \
        --with-sysusersdir=/sw/util-linux/lib/sysusers.d \
        --without-tinfo \
        ADJTIME_PATH=/var/lib/hwclock/adjtime \
        --docdir=/sw/util-linux/share/doc/util-linux-$VERSION
    make usrsbin_execdir=/sw/util-linux/bin
}

CHECK() {
    make test_pathnames test_configs
    test "$(./test_pathnames _PATH_LOGIN)" = "login"
    test "$(./test_pathnames _PATH_DEFPATH)" = "/sw/*/bin"
    test "$(./test_pathnames _PATH_DEFPATH_ROOT)" = "/sw/*/bin"
    grep -Fq '#define FS_SEARCH_PATH "/sw/*/bin"' config.h
    rm -rf /tmp/fluffy-fsck /tmp/fluffy-ulcfg
    mkdir -p /tmp/fluffy-fsck/pkg/bin
    ln -sf /sw/coreutils/bin/true /tmp/fluffy-fsck/pkg/bin/fsck.fluffytest
    FSTAB_FILE=/dev/null PATH="/tmp/fluffy-fsck/*/bin:$PATH" ./fsck -T -N -t fluffytest /dev/null | grep -Fq '[/tmp/fluffy-fsck/pkg/bin/fsck.fluffytest'

    mkdir -p /tmp/fluffy-ulcfg/sw/util-linux/etc /tmp/fluffy-ulcfg/etc
    printf 'vendor\n' > /tmp/fluffy-ulcfg/sw/util-linux/etc/issue
    ./test_configs --etc /tmp/fluffy-ulcfg/etc --usr "/tmp/fluffy-ulcfg/sw/*/etc" --name issue | grep -Fq '/tmp/fluffy-ulcfg/sw/util-linux/etc/issue'
    printf 'user\n' > /tmp/fluffy-ulcfg/etc/issue
    ./test_configs --etc /tmp/fluffy-ulcfg/etc --usr "/tmp/fluffy-ulcfg/sw/*/etc" --name issue | grep -Fq '/tmp/fluffy-ulcfg/etc/issue'
    rm -rf /tmp/fluffy-fsck /tmp/fluffy-ulcfg
}

INSTALL() {
    make usrsbin_execdir=/sw/util-linux/bin install
    find $DESTDIR/sw/util-linux -name '*.la' -delete
    rm -rf $DESTDIR/sw/util-linux/lib/sysusers.d

    mkdir -pv $DESTDIR/sw/util-linux/etc
    install -m 644 util-linux.passwd $DESTDIR/sw/util-linux/etc/passwd
    install -m 644 util-linux.group $DESTDIR/sw/util-linux/etc/group
    cat > $DESTDIR/sw/util-linux/etc/issue << "EOF"
\S
Kernel \r on \m (\l)

EOF

    SYSUNITDIR=$DESTDIR/sw/util-linux/lib/systemd/system
    mkdir -pv $SYSUNITDIR

    cat > $SYSUNITDIR/getty@.service << "EOF"
#  SPDX-License-Identifier: LGPL-2.1-or-later

[Unit]
Description=Getty on %I
Documentation=man:agetty(8) man:systemd-getty-generator(8)
Documentation=https://0pointer.de/blog/projects/serial-console.html
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
Before=getty.target
IgnoreOnIsolate=yes
Conflicts=rescue.service
Before=rescue.service
ConditionPathExists=/dev/tty0

[Service]
ExecStart=-agetty --noreset --noclear - ${TERM}
Type=idle
Restart=always
RestartSec=0
UtmpIdentifier=%I
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
IgnoreSIGPIPE=no
SendSIGHUP=yes
