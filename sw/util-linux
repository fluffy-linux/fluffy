    ln -sfv getty@.service $SYSUNITDIR/autovt@.service

    mkdir -pv $SYSUNITDIR/getty.target.wants
    ln -sfv ../getty@.service $SYSUNITDIR/getty.target.wants/getty@tty1.service

    mkdir -pv $SYSUNITDIR/sockets.target.wants
