if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.42.2

HAS_LDFLAGS="-lblkid -luuid"

ARCHIVES=(
    03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a https://github.com/fluffy-linux/util-linux/releases/download/v$VERSION/util-linux-$VERSION.tar.xz
    c14f2d5cdb9c003a00421ad2b529b6f437468c698d6263d50bb82036885086f8 file://util-linux-$VERSION-fluffy-source.patch
    90d7fa2696fdd062ac66280049dabb8b64a8e08985c35356b74b089a73fd88e2 file://util-linux.passwd
    45385873a244b0a6e8ba7c068ef4707bd4d71c42b313de486020f744375364b4 file://util-linux.group
)

NEEDS=(
    glibc
    libgcc
    ncurses
    systemd
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
        zlib
