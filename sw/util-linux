if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.42.2

HAS_LDFLAGS="-lblkid -luuid"

ARCHIVES=(
    03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a https://github.com/fluffy-linux/util-linux/releases/download/v$VERSION/util-linux-$VERSION.tar.xz
    1bdd46acb6c974a9705c22e2247470428bc93384e1a264075fc9c6fd69957d7b file://util-linux-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    libgcc
    ncurses
    systemd
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        systemd
        tar
        xz
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i util-linux-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    PKG_CONFIG="false" \
    SYSTEMD_CFLAGS=" " \
    SYSTEMD_LIBS="-lsystemd" \
    $CONFIG_SHELL ./configure \
        --prefix=/sw/util-linux \
        --sbindir=/sw/util-linux/bin \
        --runstatedir=/run \
        --enable-fs-paths-default='/sw/*/bin' \
        --disable-chfn-chsh \
        --disable-login \
        --disable-nologin \
        --disable-su \
        --disable-setpriv \
        --disable-runuser \
        --disable-pylibmount \
        --disable-liblastlog2 \
        --disable-pam-lastlog2 \
        --disable-static \
        --disable-bash-completion \
        --disable-makeinstall-chown \
        --disable-makeinstall-setuid \
        --without-python \
        --with-systemd \
        --with-systemdsystemunitdir=/sw/util-linux/lib/systemd/system \
        --with-tmpfilesdir=/sw/util-linux/lib/tmpfiles.d \
        --with-sysusersdir=/sw/util-linux/lib/sysusers.d \
        --without-tinfo \
        ADJTIME_PATH=/var/lib/hwclock/adjtime \
        --docdir=/sw/util-linux/share/doc/util-linux-$VERSION
    make usrsbin_execdir=/sw/util-linux/bin
}

CHECK() {
    make test_pathnames
    test "$(./test_pathnames _PATH_LOGIN)" = "login"
    test "$(./test_pathnames _PATH_DEFPATH)" = "/sw/*/bin"
    test "$(./test_pathnames _PATH_DEFPATH_ROOT)" = "/sw/*/bin"
    grep -Fq '#define FS_SEARCH_PATH "/sw/*/bin"' config.h
    mkdir -p /tmp/fluffy-fsck/pkg/bin
    ln -sf /sw/coreutils/bin/true /tmp/fluffy-fsck/pkg/bin/fsck.fluffytest
    FSTAB_FILE=/dev/null PATH="/tmp/fluffy-fsck/*/bin:$PATH" ./fsck -T -N -t fluffytest /dev/null | grep -Fq '[/tmp/fluffy-fsck/pkg/bin/fsck.fluffytest'
}

INSTALL() {
    make usrsbin_execdir=/sw/util-linux/bin install
    find $DESTDIR/sw/util-linux -name '*.la' -delete
}
