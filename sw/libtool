if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.6.2

# Built straight from Fluffy's branch (our commits on upstream's v2.6.2
# tag): swctl fetches the pinned commit with git, with its gnulib and
# gl-mod/bootstrap submodules.  The tag has no configure or Makefile.in;
# its bootstrap makes them with autoconf-pass1 and automake-pass1 in
# cross-build, the previous autoconf and automake in fluffy-build (2.73
# and 1.18.1, the versions the release tarball was made with).  The man
# pages are made with help2man, the release's 1.49.3, from its tag (a Perl
# script that writes itself; Fluffy doesn't package it), the manual with
# makeinfo.
ARCHIVES=(
    43e42b1c5afb4f167a582f4aa31429a4399d8474 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v$VERSION
    0503f547e06b5d3fd91533aae86b560e104140d7 https://github.com/fluffy-linux/help2man.git#refs/tags/v1.49.3
)

NEEDS=(
    bash
    glibc
    sed
)

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf-pass1
        automake-pass1
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl-pass1
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        autoconf
        automake
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    mkdir .help2man
    tar -xf ../help2man.tar -C .help2man
    perl .help2man/help2man/help2man.PL --stdout > .help2man/help2man.pl

    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./bootstrap --skip-git --skip-po --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/libtool
    make HELP2MAN="perl $PWD/.help2man/help2man.pl"
}

CHECK() {
    make HELP2MAN="perl $PWD/.help2man/help2man.pl" check
}

INSTALL() {
    make HELP2MAN="perl $PWD/.help2man/help2man.pl" install
    rm -fv $DESTDIR/sw/libtool/lib/libltdl.a
}
