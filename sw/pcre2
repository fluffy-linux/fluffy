ON=cross-build

VERSION=10.47

HAS_LDFLAGS=-lpcre2-8

ARCHIVES=(
    47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7 https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$VERSION/pcre2-$VERSION.tar.bz2
    14c4174e09eee2a481213a1475ca234431cb3fa12571ee1e64ccf38c6b242772 file://pcre2-$VERSION-fluffy-shell.patch
    7017025f0da44ec4fdebeaabe72eb25ea7e8adb7f9e370fb25d65ba8625d6be6 file://pcre2-$VERSION-fluffy-test.patch
)

NEEDS=(
    bzip2
    glibc
    readline
    zlib
)

BUILD_NEEDS=(
    bash-pass1
    binutils-pass2
    bzip2
    coreutils-pass1
    diffutils-pass1
    gawk-pass1
    gcc-pass2
    glibc
    grep-pass1
    linux-headers
    make-pass1
    patch-pass1
    readline
    sed-pass1
    tar-pass1
    zlib
)

MAKE() {
    patch -Z -Np1 -i pcre2-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i pcre2-$VERSION-fluffy-test.patch
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/pcre2 \
        --docdir=/sw/pcre2/share/doc/pcre2-$VERSION \
        --enable-unicode \
        --enable-jit \
        --enable-pcre2-16 \
        --enable-pcre2-32 \
        --enable-pcre2grep-libz \
        --enable-pcre2grep-libbz2 \
        --enable-pcre2test-libreadline \
        --disable-static
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
