if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=10.47

HAS_LDFLAGS=-lpcre2-8

ARCHIVES=(
    47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7 https://github.com/fluffy-linux/pcre2/releases/download/pcre2-$VERSION/pcre2-$VERSION.tar.bz2
    1250912274d44649a860e62e4e2a541ca2992903c8dddc4541c97a6815f00fbc file://pcre2-$VERSION-fluffy-source.patch
    7017025f0da44ec4fdebeaabe72eb25ea7e8adb7f9e370fb25d65ba8625d6be6 file://pcre2-$VERSION-fluffy-test.patch
)

NEEDS=(
    bzip2
    glibc
    readline
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        bzip2
        coreutils-pass1
        diffutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        readline
        sed-pass1
        tar-pass1
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils
        diffutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        readline
        sed
        tar
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i pcre2-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i pcre2-$VERSION-fluffy-test.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/pcre2 \
        --docdir=/sw/pcre2/share/doc/pcre2-$VERSION \
        --enable-unicode \
        --enable-jit \
        --enable-pcre2-16 \
        --enable-pcre2-32 \
        --enable-pcre2grep-libz \
        --enable-pcre2grep-libbz2 \
        --enable-pcre2test-libreadline \
        --disable-static
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
