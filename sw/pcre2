if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=10.47

# Built straight from Fluffy's branch (our commits on upstream's
# pcre2-10.47 tag, which carries configure and the other generated
# files): swctl fetches the pinned commit, and the sljit commit it pins,
# with git.
ARCHIVES=(
    1ed4ab14e7344913b1a058762f5c24c7e1fcfe65 https://github.com/fluffy-linux/pcre2.git#refs/heads/fluffy/pcre2-$VERSION
)

NEEDS=(
    bzip2
    glibc
    readline
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        bzip2
        coreutils-pass1
        diffutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        readline
        sed-pass1
        tar-pass1
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils
        diffutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        readline
        sed
        tar
        zlib
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/pcre2 \
        --docdir=/sw/pcre2/share/doc/pcre2-$VERSION \
        --enable-unicode \
        --enable-jit \
        --enable-pcre2-16 \
        --enable-pcre2-32 \
        --enable-pcre2grep-libz \
        --enable-pcre2grep-libbz2 \
        --enable-pcre2test-libreadline \
        --disable-static
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
