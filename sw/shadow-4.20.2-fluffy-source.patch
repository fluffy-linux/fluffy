+#define VENDOR_PASSWD_FILES "/sw/*/etc/passwd"
+#endif
+
+static struct passwd *vendor_pw = NULL;
+
+static bool seen_name_list (char **names, size_t count, const char *name)
+{
+	for (size_t i = 0; i < count; i++) {
+		if (streq (names[i], name)) {
+			return true;
+		}
+	}
+	return false;
