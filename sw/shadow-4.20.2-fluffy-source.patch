+	if (flen < slen || !streq (passwd_db.filename + flen - slen, PASSWD_FILE)) {
+		return NULL;
+	}
+	plen = flen - slen;
+	while (plen > 0 && passwd_db.filename[plen - 1] == '/') {
+		plen--;
+	}
+	pat = aprintf ("%.*s%s", (int) plen, passwd_db.filename, VENDOR_PASSWD_FILES);
+	if (NULL == pat) {
+		return NULL;
+	}
