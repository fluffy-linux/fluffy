+#include <string.h>
 
 #include "alloc/calloc.h"
 #include "alloc/malloc.h"
@@ -146,9 +149,109 @@
 	return commonio_open (&group_db, mode);
 }
 
+#ifndef VENDOR_GROUP_FILES
+#define VENDOR_GROUP_FILES "/sw/*/etc/group"
+#endif
+
+static struct group *vendor_gr = NULL;
+
+static bool seen_gr_name (char **names, size_t count, const char *name)
+{
+	for (size_t i = 0; i < count; i++) {
+		if (streq (names[i], name)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static const struct group *vendor_gr_locate_common (const char *name,
+                                                    gid_t gid,
+                                                    bool by_gid)
+{
+	size_t flen = strlen (group_db.filename);
+	size_t slen = strlen (GROUP_FILE);
+	size_t plen;
+	char *pat;
+	glob_t gl;
+	char **seen = NULL;
+	size_t seen_cnt = 0, seen_cap = 0;
+	const struct group *found = NULL;
+
+	if (flen < slen || !streq (group_db.filename + flen - slen, GROUP_FILE)) {
+		return NULL;
+	}
+	plen = flen - slen;
+	while (plen > 0 && group_db.filename[plen - 1] == '/') {
+		plen--;
+	}
+	pat = aprintf ("%.*s%s", (int) plen, group_db.filename, VENDOR_GROUP_FILES);
+	if (NULL == pat) {
+		return NULL;
+	}
+	if (glob (pat, 0, NULL, &gl) != 0) {
+		free (pat);
+		return NULL;
+	}
+	free (pat);
+
+	for (size_t i = 0; i < gl.gl_pathc && NULL == found; i++) {
+		FILE *fp = fopen (gl.gl_pathv[i], "r");
+		struct group *gr;
+
+		if (NULL == fp) {
+			continue;
+		}
+		while (NULL != (gr = fgetgrent (fp))) {
+			if (group_db.isopen
+			    && commonio_locate (&group_db, gr->gr_name) != NULL) {
+				continue;
+			}
+			if (seen_gr_name (seen, seen_cnt, gr->gr_name)) {
+				continue;
+			}
+			if (seen_cnt == seen_cap) {
+				size_t ncap = (0 == seen_cap) ? 16 : seen_cap * 2;
+				char **nseen = realloc (seen, ncap * sizeof (*nseen));
+				if (NULL != nseen) {
+					seen = nseen;
+					seen_cap = ncap;
+				}
+			}
+			if (seen_cnt < seen_cap) {
+				char *dup_name = strdup (gr->gr_name);
+				if (NULL != dup_name) {
+					seen[seen_cnt++] = dup_name;
+				}
+			}
+			if (by_gid ? (gr->gr_gid == gid) : streq (gr->gr_name, name)) {
+				if (NULL != vendor_gr) {
+					group_free (vendor_gr);
+				}
+				vendor_gr = __gr_dup (gr);
+				found = vendor_gr;
+				break;
+			}
+		}
+		(void) fclose (fp);
+	}
+
+	for (size_t i = 0; i < seen_cnt; i++) {
+		free (seen[i]);
+	}
+	free (seen);
+	globfree (&gl);
+	return found;
+}
+
 /*@observer@*/ /*@null@*/const struct group *gr_locate (const char *name)
 {
-	return commonio_locate (&group_db, name);
+	const struct group *grp = commonio_locate (&group_db, name);
+
+	if (NULL != grp) {
+		return grp;
+	}
+	return vendor_gr_locate_common (name, 0, false);
 }
 
 /*@observer@*/ /*@null@*/const struct group *gr_locate_gid (gid_t gid)
