+
+static const struct passwd *vendor_pw_locate_common (const char *name,
+                                                     uid_t uid,
+                                                     bool by_uid)
+{
+	size_t flen = strlen (passwd_db.filename);
+	size_t slen = strlen (PASSWD_FILE);
+	size_t plen;
+	char *pat;
+	glob_t gl;
+	char **seen = NULL;
+	size_t seen_cnt = 0, seen_cap = 0;
+	const struct passwd *found = NULL;
