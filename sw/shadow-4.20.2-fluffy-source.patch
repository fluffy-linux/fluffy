+		free (pat);
+		return NULL;
+	}
+	free (pat);
+
+	for (size_t i = 0; i < gl.gl_pathc && NULL == found; i++) {
+		FILE *fp = fopen (gl.gl_pathv[i], "r");
+		struct passwd *pw;
