MAKE() {
    patch -Z -Np1 -i ../systemd-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i ../systemd-$VERSION-fluffy-source.patch

    mkdir -p build
    cd build

    meson setup .. \
        --prefix=/sw/systemd \
        --buildtype=release \
        -Dacl=enabled \
        -Dblkid=enabled \
        -Dbzip2=disabled \
        -Dfdisk=enabled \
        -Dkmod=enabled \
        -Dlibcrypt=enabled \
        -Dlibmount=enabled \
        -Dopenssl=enabled \
        -Dxz=enabled \
        -Dzlib=enabled \
        -Dzstd=enabled \
        -Dcreate-log-dirs=false \
        -Ddefault-dnssec=no \
        -Dfallback-hostname=fluffy \
        -Dcontainer-uid-base-max=$(( 0x3FFF0000 )) \
        -Dfirstboot=false \
        -Dinstall-sysconfdir=false \
        -Dinstall-tests=false \
        -Dldconfig=false \
        -Dsysusers=false \
        -Drpmmacrosdir=no \
        -Dshellprofiledir=no \
        -Dsshconfdir=no \
        -Dsshdconfdir=no \
        -Dhomed=disabled \
        -Dman=disabled \
        -Dmode=release \
        -Dpamconfdir=no \
        -Ddev-kvm-mode=0660 \
        -Dnobody-group=nogroup \
        -Dsysupdate=disabled \
        -Dukify=disabled \
        -Dsplit-bin=false \
        -Duser-path=/sw/*/bin \
        -Dvendor-pkg-prefix=/sw \
        -Dkernel-modules-dir=/sw/linux/lib/modules \
        -Ddebug-shell=/sw/bash/bin/bash \
        -Dagetty-path=agetty \
        -Dkexec-path=kexec \
        -Dkmod-path=kmod \
        -Dloadkeys-path=loadkeys \
        -Dmount-path=mount \
        -Dnologin-path=nologin \
        -Dquotacheck-path=quotacheck \
        -Dquotaon-path=quotaon \
        -Dsetfont-path=setfont \
        -Dsulogin-path=sulogin \
        -Dswapoff-path=swapoff \
        -Dswapon-path=swapon \
        -Dumount-path=umount \
        -Ddocdir=/sw/systemd/share/doc/systemd-$VERSION

    ninja
}

CHECK() {
    meson test -C build \
        test-glob-util \
        test-path-util \
        test-path-lookup \
        test-condition \
        test-conf-files \
        test-conf-parser \
        test-uid-classification \
        test-mount-util \
        test-dlopen-so \
        --print-errorlogs
}

INSTALL() {
    DESTDIR=$DESTDIR ninja -C build install

    build/systemd-hwdb --usr --root=$DESTDIR update

    ln -sfv ../lib/systemd/systemd $DESTDIR/sw/systemd/bin/init

    # Keep /etc stateless: prevent systemd-tmpfiles --boot from populating /etc
    # with factory copies, /etc/resolv.conf, /etc/mtab, or empty /etc/credstore*.
    rm -fv $DESTDIR/sw/systemd/lib/tmpfiles.d/{etc.conf,systemd-resolve.conf,credstore.conf}
    rm -rfv $DESTDIR/sw/systemd/share/factory/etc

    mkdir -pv $DESTDIR/sw/systemd/etc
    install -m 644 ../systemd.passwd $DESTDIR/sw/systemd/etc/passwd
    install -m 644 ../systemd.group $DESTDIR/sw/systemd/etc/group
    ln -sfv /run/systemd/resolve/stub-resolv.conf $DESTDIR/sw/systemd/etc/resolv.conf

    cat > $DESTDIR/sw/systemd/lib/os-release << "EOF"
NAME="Fluffy Linux"
ID=fluffy
PRETTY_NAME="Fluffy Linux"
EOF

    # Not LFS's: PID 1 reacts to at most 5 mount table changes a second
    # (src/core/mount.c's rate limit), and while it is limited every mount
    # job waits, even one whose condition fails.  Early boot makes about 13-16
    # (API file systems, remount-fs, a credentials tmpfs per unit with
    # ImportCredential=), and with no initrd they all land in PID 1's first
    # second: binfmt_misc's mount, which sandboxed services trigger, waited
    # about 0.9 s, and userdbd, udevd and resolved behind it (upstream issue
    # #28264).  The documented knob (docs/ENVIRONMENT.md) raises the burst;
    # at 20 it never triggered, and userspace boot went from 2.21 s to about
    # 1.33 s.  The user's ruling, 2026-11-27.
    mkdir -pv $DESTDIR/sw/systemd/lib/systemd/system.conf.d
    cat > $DESTDIR/sw/systemd/lib/systemd/system.conf.d/50-mount-rate-limit.conf << "EOF"
[Manager]
ManagerEnvironment=SYSTEMD_DEFAULT_MOUNT_RATE_LIMIT_BURST=20
EOF

    mkdir -pv $DESTDIR/sw/systemd/lib/systemd/system-preset
    mkdir -pv $DESTDIR/sw/systemd/lib/systemd/user-preset
    rm -fv $DESTDIR/sw/systemd/lib/systemd/system-preset/*.preset
    rm -fv $DESTDIR/sw/systemd/lib/systemd/user-preset/*.preset
    printf 'disable *\n' > $DESTDIR/sw/systemd/lib/systemd/system-preset/99-default.preset
    printf 'disable *\n' > $DESTDIR/sw/systemd/lib/systemd/user-preset/99-default.preset

    # agetty lives in util-linux, so util-linux owns the getty service units.
    SYSUNITDIR=$DESTDIR/sw/systemd/lib/systemd/system
    rm -fv \
        $SYSUNITDIR/getty@.service \
        $SYSUNITDIR/serial-getty@.service \
        $SYSUNITDIR/console-getty.service \
        $SYSUNITDIR/container-getty@.service \
        $SYSUNITDIR/autovt@.service
    rm -rfv $SYSUNITDIR/getty.target.wants

    ln -sfv reboot.target $SYSUNITDIR/ctrl-alt-del.target
    ln -sfv systemd-networkd.service $SYSUNITDIR/dbus-org.freedesktop.network1.service
    ln -sfv systemd-oomd.service $SYSUNITDIR/dbus-org.freedesktop.oom1.service
    ln -sfv systemd-resolved.service $SYSUNITDIR/dbus-org.freedesktop.resolve1.service
    ln -sfv systemd-timesyncd.service $SYSUNITDIR/dbus-org.freedesktop.timesync1.service

    mkdir -pv $SYSUNITDIR/multi-user.target.wants
    for u in machines.target remote-fs.target systemd-networkd.service systemd-oomd.service
    do
        ln -sfv ../$u $SYSUNITDIR/multi-user.target.wants/$u
    done

    mkdir -pv $SYSUNITDIR/network-online.target.wants
    ln -sfv ../systemd-networkd-wait-online.service \
        $SYSUNITDIR/network-online.target.wants/systemd-networkd-wait-online.service

    mkdir -pv $SYSUNITDIR/sockets.target.wants
    for u in \
        systemd-factory-reset.socket \
        systemd-journald-audit.socket \
        systemd-mountfsd.socket \
        systemd-networkd-resolve-hook.socket \
        systemd-networkd.socket \
        systemd-networkd-varlink-metrics.socket \
        systemd-networkd-varlink.socket \
        systemd-nsresourced.socket \
        systemd-oomd.socket \
        systemd-report-basic.socket \
        systemd-report-cgroup.socket \
        systemd-resolved-monitor.socket \
        systemd-resolved-varlink.socket \
        systemd-storage-block.socket \
        systemd-storage-fs.socket \
        systemd-sysext.socket \
        systemd-userdbd.socket
    do
        ln -sfv ../$u $SYSUNITDIR/sockets.target.wants/$u
    done

    mkdir -pv $SYSUNITDIR/sysinit.target.wants
    for u in \
        systemd-confext.service \
        systemd-network-generator.service \
        systemd-pstore.service \
        systemd-resolved.service \
        systemd-sysext.service \
        systemd-timesyncd.service \
        systemd-udev-load-credentials.service \
        systemd-userdb-load-credentials.service
    do
        ln -sfv ../$u $SYSUNITDIR/sysinit.target.wants/$u
    done

    mkdir -pv $SYSUNITDIR/systemd-journald.service.wants
    ln -sfv ../systemd-journald-audit.socket \
        $SYSUNITDIR/systemd-journald.service.wants/systemd-journald-audit.socket

    mkdir -pv $DESTDIR/sw/systemd/share/man
    tar --strip-components=1 --no-same-owner --no-same-permissions \
        -C $DESTDIR/sw/systemd/share/man \
        -xf ../systemd-man-pages-$VERSION.tar.xz
}
