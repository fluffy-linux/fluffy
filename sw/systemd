    7b62b8271aa5532fcf9011d8d6d0fd5c01070dab862c482741d3f600f8f51962 file://systemd-$VERSION-fluffy-shell.patch
    05199805a4d9eb4bebe913ff9a379a3de133cf453d118c4d6fe6031983363baa file://systemd-$VERSION-fluffy-source.patch
