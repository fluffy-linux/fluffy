if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=704

# Built straight from Fluffy's branch (our commits on upstream's v704
# tag): swctl fetches the pinned commit with git.  The tag lacks the files
# the release's make -f Makefile.aut adds (configure, defines.h.in,
# help.c, funcs.h and the versioned man pages), so MAKE makes them as it
# does, with the autoconf the release tarball was made with (2.72).
ARCHIVES=(
    555f82c680264a303dc5aa59cd6aaad69a3ba72f https://github.com/fluffy-linux/less.git#refs/heads/fluffy/v$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
)

NEEDS=(
    glibc
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        perl-pass1
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar
        xz
    )
fi

source sw/autoconf.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    # The man pages are dated by the release (its v704 tag, 30 May 2026).
    SOURCE_DATE_EPOCH=1780185255 make -f Makefile.aut \
        help.c funcs.h configure less.nro lesskey.nro lessecho.nro
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/less \
        --sysconfdir=/sw/less/etc
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
