if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=704

ARCHIVES=(
    20a0b0a2bb2525fa53c7eee9beb854b4c9cf172eabb209af7020743547bfe9fb https://github.com/fluffy-linux/less/releases/download/v$VERSION/less-$VERSION.tar.gz
    89d014808ffa1063f4b6c602c6898829329dbb66428f3418e4de59e15b1e38be file://less-$VERSION-fluffy-source.patch
    80ad0eb07fe85df9ffd1c53f64a495fddae4eb4cd4e78fa5204e71bb6deb3ccd file://less-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        perl-pass1
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i less-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i less-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/less \
        --sysconfdir=/sw/less/etc
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
