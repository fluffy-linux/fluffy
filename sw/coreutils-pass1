ON=host-build

VERSION=9.11

# Built straight from Fluffy's branch, as coreutils is: the host's autotools
# build the ones coreutils's release tarball was made with, and bootstrap
# runs the host's autopoint.
ARCHIVES=(
    8228d4e33928122d736cc9d89601cb5bfda865aa https://github.com/fluffy-linux/coreutils.git#refs/heads/fluffy/v$VERSION
    83bfc9cc82d6b4480d7ed9838823212dfb3aa03b https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.73.1-b400b
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

source sw/autoconf.common
source sw/automake.common

MAKE() {
    autoconf_build
    automake_build
    ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/coreutils \
        --host=$FLUFFY_TGT \
        --build=$(build-aux/config.guess) \
        --enable-install-program=hostname
    # The translations as make dist merges them.
    make -C po update-po
    make
}

INSTALL() {
    make install
}
