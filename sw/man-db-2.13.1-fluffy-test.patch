diff --no-dereference -Naur man-db-2.13.1.orig/src/tests/manpath-glob-config-path man-db-2.13.1/src/tests/manpath-glob-config-path
--- man-db-2.13.1.orig/src/tests/manpath-glob-config-path	1970-01-01 00:00:00.000000000 +0000
+++ man-db-2.13.1/src/tests/manpath-glob-config-path	2025-05-02 12:53:52.000000000 +0000
@@ -0,0 +1,57 @@
+#! /bin/sh
+
+# Test colon-separated, wildcard system configuration paths
+# (MAN_SYSTEM_CONFIG_PATH): vendor files from every matching package are
+# read first and the local file last, empty elements are ignored, and a
+# wildcard MANDATORY_MANPATH found there resolves pages.
+
+: "${srcdir=.}"
+# shellcheck source-path=SCRIPTDIR
+. "$srcdir/testlib.sh"
+
+: "${MAN=man}"
+: "${MANPATH_PROG=manpath}"
+
+init
+# This test is about the system configuration path itself; testlib.sh
+# disables system configuration by default, so re-enable it here and point
+# it entirely at files inside $tmpdir.
+unset MAN_TEST_DISABLE_SYSTEM_CONFIG MANPATH
+HOME="$tmpdir"
+export HOME
+MAN_TEST_DISABLE_PATH=1
+export MAN_TEST_DISABLE_PATH
+
+mkdir -p "$tmpdir/sw/pkgA/etc" "$tmpdir/sw/pkgB/share/man" "$tmpdir/etc" \
+	"$tmpdir/man1" "$tmpdir/man2"
+printf 'MANDATORY_MANPATH\t%s/man1\n' "$tmpdir" \
+	>"$tmpdir/sw/pkgA/etc/man_db.conf"
+MAN_SYSTEM_CONFIG_PATH=":$tmpdir/sw/*/etc/man_db.conf:$tmpdir/etc/man_db.conf"
+export MAN_SYSTEM_CONFIG_PATH
+
+run $MANPATH_PROG \
+	>"$tmpdir/1.out" 2>/dev/null
+echo "$abstmpdir/man1" >"$tmpdir/1.exp"
+expect_files_equal 'vendor config found through a wildcard element' \
+	"$tmpdir/1.exp" "$tmpdir/1.out"
+
+printf 'MANDATORY_MANPATH\t%s/man2\n' "$tmpdir" \
+	>"$tmpdir/etc/man_db.conf"
+run $MANPATH_PROG \
+	>"$tmpdir/1.out" 2>/dev/null
+echo "$abstmpdir/man1:$abstmpdir/man2" >"$tmpdir/1.exp"
+expect_files_equal 'vendor config read before the local config' \
+	"$tmpdir/1.exp" "$tmpdir/1.out"
+
+write_page fluffyx 1 "$tmpdir/sw/pkgB/share/man/man1/fluffyx.1" \
+	UTF-8 '' '' 'fluffyx \- a page in a second package'
+printf 'MANDATORY_MANPATH\t%s/sw/*/share/man\n' "$tmpdir" \
+	>"$tmpdir/sw/pkgA/etc/man_db.conf"
+: >"$tmpdir/etc/man_db.conf"
+run $MAN -w fluffyx \
+	>"$tmpdir/1.out" 2>/dev/null
+echo "$abstmpdir/sw/pkgB/share/man/man1/fluffyx.1" >"$tmpdir/1.exp"
+expect_files_equal 'wildcard MANDATORY_MANPATH from a vendor config' \
+	"$tmpdir/1.exp" "$tmpdir/1.out"
+
+finish
