if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.8

ARCHIVES=(
    57b3cf4f77555992881e5ba2a09a63b05aa2c56342a60ed4305b5f45938390b5 https://github.com/fluffy-linux/inetutils/releases/download/v$VERSION/inetutils-$VERSION.tar.gz
)

NEEDS=(
    glibc
    ncurses
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        readline
        sed
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        patch
        readline
        sed
        tar
        xz
    )
fi

MAKE() {
    sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/inetutils \
        --localstatedir=/sw/inetutils/var \
        --disable-logger \
        --disable-whois \
        --disable-rcp \
        --disable-rexec \
        --disable-rlogin \
        --disable-rsh \
        --disable-servers
    make
}

CHECK() {
    make 'LOG_COMPILER=bash -c '\''case "$$0" in *.sh) exec bash "$$0" "$$@";; *) exec "$$0" "$$@";; esac'\''' check
}

INSTALL() {
    make SUIDMODE="-m 4755" install
    install -d -m755 $DESTDIR/sw/inetutils/sbin
    ln -sfv ../bin/ifconfig $DESTDIR/sw/inetutils/sbin/ifconfig
}
