ON=host-build

VERSION=2.56.1

# Built from Fluffy's branch (our commits on upstream's v2.56.1 tag), no
# patch: GitHub's tarball of the branch until it is released.
ARCHIVES=(
    4a7c41570f3c239c0c8b67320b1244357c4b4864830c2ed50d5337e35f15abdb https://github.com/fluffy-linux/git/archive/refs/heads/fluffy/v$VERSION.tar.gz
)

NEEDS=(
    curl-pass1
    glibc-pass1
    zlib-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    curl-pass1
    diffutils-pass1
    findutils-pass1
    gcc-pass1
    glibc-pass1
    grep-pass1
    linux-headers
    make-pass1
    openssl-pass1
    pkgconf-pass1
    sed-pass1
    zlib-pass1
    zstd-pass1
)

# Only what swctl's PREPARE needs: fetch and archive (builtins) and
# git-remote-https (libcurl).  No Perl, Python, Tcl/Tk, gettext, expat
# or Rust.
MAKE() {
    cat > config.mak << END
prefix = /sw/git
SHELL_PATH = /sw/bash/bin/bash
CC = $FLUFFY_TGT-gcc
AR = $FLUFFY_TGT-ar
CFLAGS = -O2 $(pkg-config --cflags zlib libcurl)
LDFLAGS = $(pkg-config --libs-only-L zlib libcurl)
CURL_LDFLAGS = $(pkg-config --libs libcurl)
NO_PERL = 1
NO_PYTHON = 1
NO_TCLTK = 1
NO_GETTEXT = 1
NO_EXPAT = 1
NO_OPENSSL = 1
NO_RUST = 1
END
    make
}

INSTALL() {
    make install
}
