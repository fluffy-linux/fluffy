if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.10.0

ARCHIVES=(
    6e5ca4f8d76ee9e3a8db700b667f13e12aac9933828a64e1aaad93d26be9b479 https://github.com/fluffy-linux/kbd/releases/download/v$VERSION/kbd-$VERSION.tar.xz
    8be28dcb11420624a500f2ea4fe975f771174bffee50e54ec8cd295a2dec104e file://kbd-$VERSION-backspace-1.patch
    2e4261029fa3cc1da9adb2c6449e1d6580a5109580374b1a9ba48fccce11aaf4 file://kbd-$VERSION-fluffy-source.patch
    ab4cc59862782ac4f2daeff0115306c3f9968fac54d9227c802f866c22d541c2 file://kbd-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        autoconf
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i kbd-$VERSION-backspace-1.patch
    patch -Z -Np1 -i kbd-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i kbd-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure \
        --prefix=/sw/kbd \
        --disable-vlock
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
