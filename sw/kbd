if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.10.0

ARCHIVES=(
    6e5ca4f8d76ee9e3a8db700b667f13e12aac9933828a64e1aaad93d26be9b479 https://www.kernel.org/pub/linux/utils/kbd/kbd-$VERSION.tar.xz
    8be28dcb11420624a500f2ea4fe975f771174bffee50e54ec8cd295a2dec104e https://www.linuxfromscratch.org/patches/lfs/13.1/kbd-$VERSION-backspace-1.patch
    161527a337e9caf2c7e668a2e5a34718a00d6d9a3fde4c822b702f80ed80b5e3 file://kbd-$VERSION-fluffy-shell.patch
    d136ed31fd3ce99b2e31158a189f5de410edb4d0020e9ef9e06285a22447da71 file://kbd-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        autoconf
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
    )
fi

MAKE() {
    patch -Z -Np1 -i kbd-$VERSION-backspace-1.patch
    patch -Z -Np1 -i kbd-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i kbd-$VERSION-fluffy-source.patch

    ./configure \
        --prefix=/sw/kbd \
        --disable-vlock
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
