if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.2.2

# Built straight from Fluffy's branch (our commits on upstream's 4.2.2
# tag): swctl fetches the pinned commit with git.  The tag has no
# configure or Makefile.in, so MAKE runs autogen.sh, as upstream makes
# its release tarball: with the autoconf, automake and libtool the
# release was made with (2.72, 1.17, 2.5.4), from their Fluffy branches.
ARCHIVES=(
    c330c0458216121cb5c1a25fbf4e084f2ef2c502 https://github.com/fluffy-linux/mpfr.git#refs/heads/fluffy/$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    c47d100eab0ff3b64e16811f6b3925b233085497 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17
    2b62947fd566e11dedf3c2c7e252f05a8937d54c https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.5.4
)

NEEDS=(
    glibc
    gmp
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        gmp
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        gmp
        grep
        libgcc
        linux-headers
        make
        patch
        perl
        sed
        texinfo
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/mpfr \
        --disable-static \
        --enable-thread-safe \
        --docdir=/sw/mpfr/share/doc/mpfr-$VERSION
    make
    make html
}

CHECK() {
    make check
}

INSTALL() {
    make install
    make install-html
    rm -fv $DESTDIR/sw/mpfr/lib/libmpfr.la
}
