if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.3.2

HAS_LDFLAGS=-lz

ARCHIVES=(
    bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 https://github.com/fluffy-linux/zlib/releases/download/v$VERSION/zlib-$VERSION.tar.gz
    f4628bd4a76cac6b819416615daf7670e3305bf60ba4aa60c2512bec9235d641 file://zlib-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i zlib-$VERSION-fluffy-source.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix=/sw/zlib
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
