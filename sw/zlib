if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.3.2

# Built from Fluffy's branch (our commits on upstream's v1.3.2 tag), no
# patch: GitHub's tarball of the branch until it is released.
ARCHIVES=(
    57b937080a41d041ed1221ac44bcc967bcb8dbcc16d6e9bd85bf23499866e7f3 https://github.com/fluffy-linux/zlib/archive/refs/heads/fluffy/v$VERSION.tar.gz
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix=/sw/zlib
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
