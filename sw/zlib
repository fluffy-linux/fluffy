if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.3.2

# Experiment: built from the Fluffy branch itself (its commits on upstream's
# v1.3.2 tag), no patch.  GitHub's branch tarball until the commits are
# settled.
ARCHIVES=(
    d1b57bf060086f75fa1bb6585418892de057dbff5dbb9e42157faf3584ffb53b https://github.com/fluffy-linux/zlib/archive/refs/heads/exp/zlib-$VERSION.tar.gz
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix=/sw/zlib
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
