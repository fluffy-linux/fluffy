if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.3.2

# Built straight from Fluffy's branch (our commits on upstream's v1.3.2
# tag): swctl fetches the pinned commit with git.
ARCHIVES=(
    b794956e494df6b9d8cf7d3012a3724085bf0233 https://github.com/fluffy-linux/zlib.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        sed
        tar
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure --prefix=/sw/zlib
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
