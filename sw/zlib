if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.3.2

HAS_LDFLAGS=-lz

ARCHIVES=(
    bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 https://zlib.net/fossils/zlib-$VERSION.tar.gz
    521833b4e36d84b9dc80e1bd393277861282ac1d72323b55270d3e47f91bc45c file://zlib-$VERSION-fluffy-shell.patch
    488dd373e46ae3fee312810f37cba3a27f3f93d4434c821d09e726a00d3b87da file://zlib-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i zlib-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i zlib-$VERSION-fluffy-source.patch
    ./configure --prefix=/sw/zlib
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/zlib/lib/libz.a
}
