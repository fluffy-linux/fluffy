if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=16.2.0

# Built straight from Fluffy's branch (our commits on upstream's
# releases/gcc-16.2.0 tag): swctl fetches the pinned commit with git.  What
# the release tarball ships prebuilt that this build uses (gengtype's
# flex scanner, the info and man pages) the build makes.
ARCHIVES=(
    249a7913825ded5cb6aab9f39eff492057a959e6 https://github.com/fluffy-linux/gcc.git#refs/heads/fluffy/releases/gcc-$VERSION
)

NEEDS=(
    binutils
    glibc
    gmp
    libgcc
    libstdcpp
    mpc
    mpfr
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        file-pass1
        findutils-pass1
        flex
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        gmp
        grep-pass1
        libgcc
        libstdcpp
        linux-headers
        make-pass1
        mpc
        mpfr
        perl-pass1
        python-pass1
        sed-pass1
        tar-pass1
        tcl
        texinfo-pass1
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        file
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        gmp
        grep
        libgcc
        libstdcpp
        linux-headers
        make
        mpc
        mpfr
        perl
        python
        sed
        tar
        tcl
        texinfo
        zlib
        zstd
    )
fi

MAKE() {
    mkdir -v build
    cd build
    CONFIG_SITE=/sw/glibc/share/config.site ../configure \
        --prefix=/sw/gcc \
        LD=/sw/binutils/bin/ld \
        --with-native-system-header-dir='/sw/*/include' \
        --with-gxx-include-dir='/sw/*/include/c++' \
        --enable-default-pie \
        --enable-default-ssp \
        --enable-host-pie \
        --enable-targets=all \
        --disable-fixincludes \
        --disable-nls \
        --disable-multilib \
        --disable-bootstrap \
        --disable-libstdcxx \
        --with-system-zlib \
        --with-zstd \
        --enable-languages=c,c++
    CONFIG_SITE=/sw/glibc/share/config.site make
}

CHECK() {
    cd build
    ulimit -s -H unlimited
    COLUMNS=1024 make -k check || true
    ../contrib/test_summary -t
    grep -q '=== gcc Summary ===' gcc/testsuite/gcc/gcc.sum
    grep -q '=== g++ Summary ===' gcc/testsuite/g++/g++.sum
    ! grep -E '^(FAIL|XPASS|UNRESOLVED|ERROR):' $(find . -name '*.sum')
}

INSTALL() {
    cd build
    make install
    # make install runs install-info for several manuals at once (each of
    # gcc's is its own make target, and libgomp's and libquadmath's install
    # alongside), and their writes to share/info/dir race: builds of the
    # same recipe kept different sets of entries.  So the dir file is
    # written again from scratch by the info installs of those three
    # directories alone, run serially.
    rm -f $DESTDIR/sw/gcc/share/info/dir
    local d
    for d in gcc */libgomp */libquadmath
    do
        make -C "$d" -j1 install-info
    done
    ln -svr $DESTDIR/sw/gcc/bin/cpp $DESTDIR/sw/gcc/lib
    ln -sv gcc $DESTDIR/sw/gcc/bin/cc
    ln -sv gcc.1 $DESTDIR/sw/gcc/share/man/man1/cc.1
    install -v -dm755 $DESTDIR/sw/gcc/lib/bfd-plugins
    ln -sfvr $DESTDIR/sw/gcc/libexec/gcc/*/$VERSION/liblto_plugin.so $DESTDIR/sw/gcc/lib/bfd-plugins/

    rm -fv $DESTDIR/sw/gcc/lib/libgcc_s.so*
}
