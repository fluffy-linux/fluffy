if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=23.7

ARCHIVES=(
    58c55d9c1402474065adae669511c191de374b0871eec781239ab400b907c327 https://github.com/fluffy-linux/psmisc/releases/download/v$VERSION/psmisc-$VERSION.tar.xz
    6e8008deb93c7fcb54ef9baa5156893d2c6655d301316a7d1ff53c3985d9a971 file://psmisc-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    ncurses
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        patch-pass1
        sed-pass1
        tcl
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        linux-headers
        make
        ncurses
        patch
        sed
        tcl
    )
fi

MAKE() {
    patch -Z -Np1 -i psmisc-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/psmisc
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
