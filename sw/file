if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.48

HAS_LDFLAGS=-lmagic

ARCHIVES=(
    ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283 https://astron.com/pub/file/file-$VERSION.tar.gz
    7973df10da80fffb459395d2c11e5a4f7699ad6001b82ab7c446af737a6dfc1d file://file-$VERSION-fluffy-shell.patch
)

if test -v CROSS
then
    NEEDS=(
        bzip2
        glibc
        xz
        zlib
        zstd-pass1
    )
else
    NEEDS=(
        bzip2
        glibc
        xz
        zlib
        zstd
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        bzip2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        xz
        zlib
        zstd-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bzip2
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        xz
        zlib
        zstd
    )
fi

MAKE() {
    patch -Z -Np1 -i file-$VERSION-fluffy-shell.patch
    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/file
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -fv $DESTDIR/sw/file/lib/libmagic.la
}
