if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.47.4

HAS_LDFLAGS="-lext2fs -lcom_err"

ARCHIVES=(
    da274408bebbfd13a5a2fc3cfc66e3ffff17c48534673aa67f88d49b99123b96 https://github.com/fluffy-linux/e2fsprogs/releases/download/v$VERSION/e2fsprogs-$VERSION.tar.gz
    0ce30f1956b55e2d7e4af90e1bb120435cabafa39e76b1fa31bf26ae3b5986c4 file://e2fsprogs-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    libgcc
    util-linux
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        texinfo
        util-linux
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        texinfo
        util-linux
    )
fi

MAKE() {
    patch -Z -Np1 -i e2fsprogs-$VERSION-fluffy-source.patch

    mkdir -p build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    CPPFLAGS='-DVENDOR_E2FSCK_CONF="\"/sw/*/etc/e2fsck.conf\"" -DVENDOR_MKE2FS_CONF="\"/sw/*/etc/mke2fs.conf\""' \
    PKG_CONFIG="false" \
    $CONFIG_SHELL ../configure \
        --prefix=/sw/e2fsprogs \
        --bindir=/sw/e2fsprogs/bin \
        --sbindir=/sw/e2fsprogs/bin \
        --sysconfdir=/sw/e2fsprogs/etc \
        --enable-elf-shlibs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fsck \
        --with-systemd-unit-dir=/sw/e2fsprogs/lib/systemd/system \
        --with-udev-rules-dir=/sw/e2fsprogs/lib/udev/rules.d \
        --without-crond-dir
    make
}

CHECK() {
    local d bp td
    for d in lib/et lib/ss lib/e2p lib/ext2fs misc e2fsck debugfs resize
    do
        make -C "build/$d" check
    done
    make -C build/lib/support test_profile

    bp="$PWD/build"
    td=$(mktemp -d)
    mkdir -p "$td/sw/pkgA/etc" "$td/sw/pkgB/etc" "$td/sw/1:pkg/etc" "$td/etc" "$td/cwd"
    printf '[defaults]\n\tkey = from_pkgA\n\tvendor_only = keep_me\n[fs_types]\n\tfluffy_test = {\n\t\tblocksize = 4096\n\t\tinode_size = 256\n\t}\n' > "$td/sw/pkgA/etc/mke2fs.conf"
    printf '[defaults]\n\tother = from_pkgB\n' > "$td/sw/pkgB/etc/mke2fs.conf"
    printf '[defaults]\n\tcolon_key = from_colon\n' > "$td/sw/1:pkg/etc/mke2fs.conf"
    printf '[options]\n\tallow_cancellation = true\n' > "$td/sw/pkgA/etc/e2fsck.conf"
    printf 'INVALID SYNTAX === [[[\n' > "$td/cwd/badconf"

    test "$("$bp/lib/support/test_profile" "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query1 defaults key)" = "from_pkgA"
    test "$("$bp/lib/support/test_profile" "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query1 defaults other)" = "from_pkgB"
    test "$("$bp/lib/support/test_profile" "$td/sw/[[:alpha:]]*/etc/mke2fs.conf:$td/sw/1[a:]pkg/etc/mke2fs.conf" query1 defaults colon_key)" = "from_colon"

    (
        cd "$td/cwd"
        test "$("$bp/lib/support/test_profile" ":$td/sw/*/etc/mke2fs.conf:" query1 defaults key)" = "from_pkgA"
        truncate -s 16M "$td/fs.img"
        LD_LIBRARY_PATH="$bp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            MKE2FS_CONFIG="$td/sw/*/etc/mke2fs.conf" \
            "$bp/misc/mke2fs" -q -F -T fluffy_test "$td/fs.img"
        LD_LIBRARY_PATH="$bp/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            E2FSCK_CONFIG="$td/sw/*/etc/e2fsck.conf" \
            "$bp/e2fsck/e2fsck" -fn "$td/fs.img" >/dev/null
    )

    printf '[defaults]\n\tkey = from_etc\n' > "$td/etc/mke2fs.conf"
    test "$("$bp/lib/support/test_profile" "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query1 defaults key)" = "from_etc"
    test "$("$bp/lib/support/test_profile" "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query1 defaults vendor_only)" = "keep_me"
    rm -rf "$td"
}

INSTALL() {
    cd build
    make install
    make install-libs
    rm -fv $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.a
    chmod -v u+w $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.so.* 2>/dev/null || true

    install -dm755 $DESTDIR/sw/e2fsprogs/lib/systemd/system/{multi-user.target.wants,timers.target.wants}
    ln -sf ../e2scrub_reap.service $DESTDIR/sw/e2fsprogs/lib/systemd/system/multi-user.target.wants/e2scrub_reap.service
    ln -sf ../e2scrub_all.timer $DESTDIR/sw/e2fsprogs/lib/systemd/system/timers.target.wants/e2scrub_all.timer
}
