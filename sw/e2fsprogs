if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.47.4

HAS_LDFLAGS="-lext2fs -lcom_err"

ARCHIVES=(
    da274408bebbfd13a5a2fc3cfc66e3ffff17c48534673aa67f88d49b99123b96 https://github.com/fluffy-linux/e2fsprogs/releases/download/v$VERSION/e2fsprogs-$VERSION.tar.gz
    feb5203aa50ab02f744e67c891b7e1d163cbb24b16c0b6c98232edfd147b2110 file://e2fsprogs-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    libgcc
    util-linux
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        texinfo
        util-linux
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        texinfo
        util-linux
    )
fi

MAKE() {
    patch -Z -Np1 -i e2fsprogs-$VERSION-fluffy-source.patch

    mkdir -p build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    PKG_CONFIG="false" \
    $CONFIG_SHELL ../configure \
        --prefix=/sw/e2fsprogs \
        --bindir=/sw/e2fsprogs/bin \
        --sbindir=/sw/e2fsprogs/bin \
        --sysconfdir=/sw/e2fsprogs/etc \
        --enable-elf-shlibs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fsck \
        --with-systemd-unit-dir=/sw/e2fsprogs/lib/systemd/system \
        --with-udev-rules-dir=/sw/e2fsprogs/lib/udev/rules.d \
        --without-crond-dir
    make
}

CHECK() {
    make -C build/lib/support test_profile
    local td
    td=$(mktemp -d)
    mkdir -p "$td/sw/pkgA/etc" "$td/sw/pkgB/etc" "$td/etc"
    printf '[defaults]\n\tkey = from_pkgA\n\tvendor_only = keep_me\n' > "$td/sw/pkgA/etc/mke2fs.conf"
    printf '[defaults]\n\tother = from_pkgB\n' > "$td/sw/pkgB/etc/mke2fs.conf"

    test "$(./build/lib/support/test_profile "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query defaults key)" = "from_pkgA"
    test "$(./build/lib/support/test_profile "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query defaults other)" = "from_pkgB"

    printf '[defaults]\n\tkey = from_etc\n' > "$td/etc/mke2fs.conf"
    test "$(./build/lib/support/test_profile "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query defaults key)" = "from_etc"
    test "$(./build/lib/support/test_profile "$td/etc/mke2fs.conf:$td/sw/*/etc/mke2fs.conf" query defaults vendor_only)" = "keep_me"
    rm -rf "$td"
}

INSTALL() {
    cd build
    make install
    make install-libs
    rm -fv $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.a
    chmod -v u+w $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.so.* 2>/dev/null || true

    install -dm755 $DESTDIR/sw/e2fsprogs/lib/systemd/system/{multi-user.target.wants,timers.target.wants}
    ln -sf ../e2scrub_reap.service $DESTDIR/sw/e2fsprogs/lib/systemd/system/multi-user.target.wants/e2scrub_reap.service
    ln -sf ../e2scrub_all.timer $DESTDIR/sw/e2fsprogs/lib/systemd/system/timers.target.wants/e2scrub_all.timer
}
