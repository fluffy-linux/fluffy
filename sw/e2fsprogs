if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.47.4

ARCHIVES=(
    e47092d617a4245a2df847ac3da806654f95f239 https://github.com/fluffy-linux/e2fsprogs.git#refs/heads/fluffy/v$VERSION
)

NEEDS=(
    glibc
    libgcc
    util-linux
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        pkgconf
        sed
        tar
        texinfo
        util-linux
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        pkgconf
        sed
        tar
        texinfo
        util-linux
    )
fi

MAKE() {

    mkdir -p build
    cd build

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site \
    CPPFLAGS='-DVENDOR_E2FSCK_CONF="\"/sw/*/etc/e2fsck.conf\"" -DVENDOR_MKE2FS_CONF="\"/sw/*/etc/mke2fs.conf\""' \
    $CONFIG_SHELL ../configure \
        --prefix=/sw/e2fsprogs \
        --bindir=/sw/e2fsprogs/bin \
        --sbindir=/sw/e2fsprogs/bin \
        --sysconfdir=/sw/e2fsprogs/etc \
        --enable-elf-shlibs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fsck \
        --with-systemd-unit-dir=/sw/e2fsprogs/lib/systemd/system \
        --with-udev-rules-dir=/sw/e2fsprogs/lib/udev/rules.d \
        --without-crond-dir
    make
}

CHECK() {
    local d
    for d in lib/et lib/ss lib/e2p lib/ext2fs lib/support misc e2fsck debugfs resize
    do
        make -C "build/$d" check
    done
}

INSTALL() {
    cd build
    make install
    make install-libs
    rm -fv $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.a
    chmod -v u+w $DESTDIR/sw/e2fsprogs/lib/{libcom_err,libe2p,libext2fs,libss}.so.* 2>/dev/null || true

    install -dm755 $DESTDIR/sw/e2fsprogs/lib/systemd/system/{multi-user.target.wants,timers.target.wants}
    ln -sf ../e2scrub_reap.service $DESTDIR/sw/e2fsprogs/lib/systemd/system/multi-user.target.wants/e2scrub_reap.service
    ln -sf ../e2scrub_all.timer $DESTDIR/sw/e2fsprogs/lib/systemd/system/timers.target.wants/e2scrub_all.timer
}
