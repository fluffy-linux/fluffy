if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.8.0

ARCHIVES=(
    7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4 https://github.com/libffi/libffi/releases/download/v$VERSION/libffi-$VERSION.tar.gz
    b9ce6bd5c345aaf1d36b6ea5a776a4fbbbee8741b1a1aed6031dcf5af8d327ec file://libffi-$VERSION-fluffy.patch
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        sed
        tar-pass1
        tcl
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        sed
        tar
        tcl
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i libffi-$VERSION-fluffy.patch

    ./configure \
        --prefix=/sw/libffi \
        --disable-static \
        --disable-multi-os-directory \
        --with-gcc-arch=native
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -v $DESTDIR/sw/libffi/lib/libffi.la
}
