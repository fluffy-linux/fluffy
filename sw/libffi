if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.8.0

# Built straight from Fluffy's branch (upstream's v3.8.0 tag): swctl
# fetches the pinned commit with git.  The tag has no configure,
# Makefile.in or libffi.info, so MAKE regenerates them.
ARCHIVES=(
    12ffd1f9dc56fcea79d2f742f424301ae668d663 https://github.com/fluffy-linux/libffi.git#refs/heads/fluffy/v$VERSION
    6d71b5a3bfe08b333ef1e9eb8fdfd8172a5f6607 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    fecfc0984bc0aa2623d671fbcaaf4afbad979dee https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    12c01761b8567defd3d8060feb87a216ce91bef7 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        dejagnu
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        sed
        tar-pass1
        tcl
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        dejagnu
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        sed
        tar
        tcl
        texinfo
        xz
    )
fi

# Regenerated with the autotools libffi's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    # Not LFS's --with-gcc-arch=native, which compiles for the building
    # machine's CPU (AVX here), so an image from the binary cache might not
    # run on another and differs by machine; --without-gcc-arch is LFS's
    # own alternative, generic x86-64 (the user's ruling, 2026-11-27, as
    # for gmp).
    $CONFIG_SHELL ./configure \
        --prefix=/sw/libffi \
        --disable-static \
        --disable-multi-os-directory \
        --without-gcc-arch
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    rm -v $DESTDIR/sw/libffi/lib/libffi.la
}
