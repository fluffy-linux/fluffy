if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.73

ARCHIVES=(
    9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e https://github.com/fluffy-linux/autoconf/releases/download/v$VERSION/autoconf-$VERSION.tar.xz
    67fb6445f64c2c6e22bfa88b1df327bcfab341ba210ffa73d55478eeb6c71ddf file://autoconf-$VERSION-fluffy-source.patch
    83e1ba4e9b29b1d4407539d8da5a39993194ce04f301bf34233f005ed414cc5b file://autoconf-$VERSION-fluffy-test.patch
)

if test -v CROSS
then
    NEEDS=(
        bash
        coreutils-pass1
        grep
        m4
        make-pass1
        perl
        sed
        texinfo-pass1
    )
else
    NEEDS=(
        bash
        coreutils
        grep
        m4
        make
        perl
        sed
        texinfo
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        automake
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i autoconf-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i autoconf-$VERSION-fluffy-test.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/autoconf
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
