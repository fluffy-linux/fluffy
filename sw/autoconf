if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.73

# Built straight from Fluffy's branch (our commits on upstream's v2.73
# tag): swctl fetches the pinned commit with git.  The tag has no
# configure or Makefile.in, so MAKE regenerates them with autoconf-pass1
# and automake-pass1 in cross-build, the previous autoconf and automake in
# fluffy-build.  The man pages are made with help2man 1.49.3, the
# release's: help2man-pass1 in cross-build, since help2man's own build
# needs coreutils, whose build needs autoconf.
ARCHIVES=(
    e22e555ccb88ac24a4cbdb20dc6629191bb5d1e8 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v$VERSION
)

if test -v CROSS
then
    NEEDS=(
        bash
        coreutils-pass1
        grep
        m4
        make-pass1
        perl
        sed
        texinfo-pass1
    )
else
    NEEDS=(
        bash
        coreutils
        grep
        m4
        make
        perl
        sed
        texinfo
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf-pass1
        automake-pass1
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        help2man-pass1
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make-pass1
        perl
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        automake
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        help2man
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make
        perl
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/autoconf
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
