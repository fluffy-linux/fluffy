if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.73

ARCHIVES=(
    9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e https://ftpmirror.gnu.org/autoconf/autoconf-$VERSION.tar.xz
    54cf02c0280cb03cd32cbd131aeb8ff9bfa47a41bf13ff1005f6a07c1dccdbb2 file://autoconf-$VERSION-fluffy-shell.patch
)

if test -v CROSS
then
    NEEDS=(
        bash
        coreutils-pass1
        grep
        m4
        make-pass1
        perl
        sed
        texinfo-pass1
    )
else
    NEEDS=(
        bash
        coreutils
        grep
        m4
        make
        perl
        sed
        texinfo
    )
fi

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        automake
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        libtool
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
        texinfo
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i autoconf-$VERSION-fluffy-shell.patch

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/autoconf
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
