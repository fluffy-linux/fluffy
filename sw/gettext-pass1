ON=cross-build

VERSION=1.0

ARCHIVES=(
    71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7 https://ftpmirror.gnu.org/gettext/gettext-$VERSION.tar.xz
    24d2a42e3eb51d0574b51e019e5864f374dc2a26170049ac00f5db849567d0ce file://gettext-$VERSION-fluffy-shell.patch
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    grep-pass1
    gzip-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i gettext-$VERSION-fluffy-shell.patch
    CONFIG_SITE=/sw/glibc/share/config.site ./configure --disable-shared
    make
}

INSTALL() {
    mkdir -pv $DESTDIR/sw/gettext/bin
    cp -v gettext-tools/src/{msgfmt,msgmerge,xgettext} $DESTDIR/sw/gettext/bin
}
