ON=cross-build

VERSION=1.0

ARCHIVES=(
    71132a3fb71e68245b8f2ac4e9e97137d3e5c02f415636eb508ae607bc01add7 https://ftpmirror.gnu.org/gettext/gettext-$VERSION.tar.xz
    f9f233ee9053183de5d76ead66f475d1d7789ee1fa99ee14848967ef0cef3bf8 file://gettext-$VERSION-fluffy-shell.patch
    9784517849fb34ada1167d40c963fa6506d10f86c0ccc3fba5fdec007e70e110 file://gettext-$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc-pass1
)

MAKE_NEEDS=(
    bash-pass1
    coreutils-pass1
    diffutils-pass1
    findutils-pass1
    gawk-pass1
    gcc-pass2
    grep-pass1
    gzip-pass1
    linux-headers
    make-pass1
    patch-pass1
    sed-pass1
    tar-pass1
    xz-pass1
)

MAKE() {
    patch -Z -Np1 -i gettext-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i gettext-$VERSION-fluffy-test.patch
    ./configure --disable-shared
    make
}

INSTALL_NEEDS=(
    bash-pass1
    coreutils-pass1
)

INSTALL() {
    mkdir -pv $DESTDIR/sw/gettext/bin
    cp -v gettext-tools/src/{msgfmt,msgmerge,xgettext} $DESTDIR/sw/gettext/bin
}
