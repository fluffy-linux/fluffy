ON=host-build

VERSION=32

ARCHIVES=(
    6dd1b97fd9273d268b70c1be3c2592cbbe1488bca5e45c12c58f8c74362758d5 https://github.com/aperezdc/signify/releases/download/v$VERSION/signify-$VERSION.tar.xz
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    coreutils-pass1
    gcc-pass1
    glibc-pass1
    linux-headers
    make-pass1
)

MAKE() {
    make CC="$FLUFFY_TGT-gcc" BUNDLED_LIBBSD=1 EXTRA_CFLAGS="-D_GNU_SOURCE" VERIFY_ONLY=0
}

INSTALL() {
    mkdir -pv $DESTDIR/sw/signify/bin
    cp -v signify $DESTDIR/sw/signify/bin/signify
}
