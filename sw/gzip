if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.14

# Built straight from Fluffy's branch (our commits on upstream's v1.14
# tag): swctl fetches the pinned commit, and the gnulib commit it pins,
# with git.  The tag has no configure, Makefile.in or gnulib files, so
# MAKE bootstraps it.
ARCHIVES=(
    612f880773f62784c74aef3a9b632b7d553a6386 https://github.com/fluffy-linux/gzip.git#refs/heads/fluffy/v$VERSION
    1996f5b17a22cc4056860b7bc807dc061e1c4368 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    a88a8c2541f3fcb0137de63799a80e31e5435ae4 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
        texinfo-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        texinfo
        xz
    )
fi

# Bootstrapped with the autotools gzip's release tarball was made with:
# development snapshots of autoconf and automake.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    $CONFIG_SHELL ./configure \
        --prefix=/sw/gzip
    make
}

CHECK() {
    make LOG_COMPILER=/sw/bash/bin/bash check
}

INSTALL() {
    make install
}
