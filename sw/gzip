if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=1.14

ARCHIVES=(
    01a7b881bd220bfdf615f97b8718f80bdfd3f6add385b993dcf6efd14e8c0ac6 https://github.com/fluffy-linux/gzip/releases/download/v$VERSION/gzip-$VERSION.tar.xz
)

NEEDS=(
    glibc
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    $CONFIG_SHELL ./configure \
        --prefix=/sw/gzip
    make
}

CHECK() {
    make LOG_COMPILER=/sw/bash/bin/bash check
}

INSTALL() {
    make install
}
