diff --no-dereference -Naur readline-8.3.orig/Makefile.in readline-8.3/Makefile.in
--- readline-8.3.orig/Makefile.in	2025-06-02 20:10:34.000000000 +0000
+++ readline-8.3/Makefile.in	2025-06-02 20:10:34.000000000 +0000
@@ -258,10 +258,8 @@
 maybe-uninstall-pc: uninstall-pc
 
 install-static: installdirs $(STATIC_LIBS) install-headers install-doc ${install_examples} install-pc
-	-$(MV) $(DESTDIR)$(libdir)/libreadline.a $(DESTDIR)$(libdir)/libreadline.old
 	$(INSTALL_DATA) libreadline.a $(DESTDIR)$(libdir)/libreadline.a
 	-test -n "$(RANLIB)" && $(RANLIB) $(DESTDIR)$(libdir)/libreadline.a
-	-$(MV) $(DESTDIR)$(libdir)/libhistory.a $(DESTDIR)$(libdir)/libhistory.old
 	$(INSTALL_DATA) libhistory.a $(DESTDIR)$(libdir)/libhistory.a
 	-test -n "$(RANLIB)" && $(RANLIB) $(DESTDIR)$(libdir)/libhistory.a
 
diff --no-dereference -Naur readline-8.3.orig/input.c readline-8.3/input.c
--- readline-8.3.orig/input.c	2025-05-02 13:29:05.000000000 +0000
+++ readline-8.3/input.c	2025-05-02 13:29:05.000000000 +0000
@@ -268,6 +268,8 @@
       result = (*rl_input_available_hook) ();
       if (result == 0)
         result = -1;
+      else
+        chars_avail = 1;
     }
 
 #if defined (HAVE_PSELECT) || defined (HAVE_SELECT)
@@ -285,6 +287,7 @@
 #endif
       if (result <= 0)
 	return 0;	/* Nothing to read. */
+   result = -1;
     }
 #endif
 
diff --no-dereference -Naur readline-8.3.orig/support/shlib-install readline-8.3/support/shlib-install
--- readline-8.3.orig/support/shlib-install	2019-12-13 14:46:13.000000000 +0000
+++ readline-8.3/support/shlib-install	2019-12-13 14:46:13.000000000 +0000
@@ -49,9 +49,9 @@
 # pre-install
 
 if [ -z "$uninstall" ]; then
-	${echo} $RM ${INSTALLDIR}/${LIBNAME}.${OLDSUFF}
+	:
 	if [ -f "$INSTALLDIR/$LIBNAME" ]; then
-		${echo} $MV $INSTALLDIR/$LIBNAME ${INSTALLDIR}/${LIBNAME}.${OLDSUFF}
+	:
 	fi
 fi
 
@@ -79,9 +79,9 @@
 	IMPLIBNAME=`echo ${LIBNAME} \
 		| sed -e 's,^cyg,lib,' -e 's,[0-9]*.dll$,.dll.a,'`
 	if [ -z "$uninstall" ]; then
-		${echo} $RM ${BINDIR}/${LIBNAME}.${OLDSUFF}
+	:
 		if [ -f "$BINDIR/$LIBNAME" ]; then
-			${echo} $MV $BINDIR/$LIBNAME $BINDIR/$LIBNAME.$OLDSUFF
+			$echo $MV $BINDIR/$LIBNAME $BINDIR/$LIBNAME.$OLDSUFF
 		fi
 		${echo} $MV ${INSTALLDIR}/${LIBNAME} ${BINDIR}/${LIBNAME}
 		${echo} chmod a+x ${BINDIR}/${LIBNAME}
