if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.20.2

ARCHIVES=(
    b89f432b75ae55a2d852b446d0365484795fdf533ab97d550e325fa15594a224 https://github.com/shadow-maint/shadow/releases/download/$VERSION/shadow-$VERSION.tar.xz
    81f4f60e02fa0593705df7356b469374f8e7ab65427b9536d636d06d009f42e4 file://shadow-$VERSION-fluffy-shell.patch
    2b536ef6d28f36052adff35c4dc57a3875d13776fe92d8c920a6a81ccbd838f0 file://shadow-$VERSION-fluffy-source.patch
)

NEEDS=(
    acl
    attr
    glibc
    libxcrypt
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        libxcrypt
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        libxcrypt
        linux-headers
        make
        patch
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i shadow-$VERSION-fluffy-shell.patch
    patch -Z -Np1 -i shadow-$VERSION-fluffy-source.patch

    find man -name Makefile.in -exec sed -i 's/groups\.1 / /'   {} \;
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

    CONFIG_SITE=/sw/glibc/share/config.site ./configure \
        --prefix=/sw/shadow \
        --sbindir=/sw/shadow/bin \
        --sysconfdir=/sw/shadow/etc \
        --disable-static \
        --with-{b,yes}crypt \
        --without-libbsd \
        --with-group-name-max-length=32 \
        --disable-logind \
        shadow_cv_maildir=/var/mail \
        shadow_cv_logdir=/var/log
    make
}

INSTALL() {
    make install
    make -C man install-man
    rm -fv $DESTDIR/sw/shadow/lib/libsubid.la
}
