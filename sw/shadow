if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.20.2

HAS_LDFLAGS=-lsubid

ARCHIVES=(
    b89f432b75ae55a2d852b446d0365484795fdf533ab97d550e325fa15594a224 https://github.com/fluffy-linux/shadow/releases/download/$VERSION/shadow-$VERSION.tar.xz
    349f5116cb5b4c448428f5f127c500c308cbc588c6fee83fc5114f948c9dd974 file://shadow-$VERSION-fluffy-source.patch
)

NEEDS=(
    acl
    attr
    glibc
    libxcrypt
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        libxcrypt
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        libxcrypt
        linux-headers
        make
        patch
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i shadow-$VERSION-fluffy-source.patch

    find man -name Makefile.in -exec sed -i 's/groups\.1 / /'   {} \;
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/shadow \
        --sbindir=/sw/shadow/bin \
        --sysconfdir=/sw/shadow/etc \
        --disable-static \
        --with-{b,yes}crypt \
        --without-libbsd \
        --with-group-name-max-length=32 \
        --disable-logind \
        shadow_cv_maildir=/var/mail \
        shadow_cv_logdir=/var/log
    make
}

if ! test -v CROSS
then
    CHECK() {
        local pfx
        pfx="$(mktemp -d)"
        mkdir -p "$pfx/etc" "$pfx/sw/glibc/etc" "$pfx/sw/shadow/etc"

        cat << "EOF" > "$pfx/sw/glibc/etc/passwd"
root:x:0:0:root:/root:/sw/bash/bin/bash
daemon:*:1931809929:1931809929:Daemon User:/dev/null:/sw/coreutils/bin/false
EOF
        cat << "EOF" > "$pfx/sw/glibc/etc/group"
root:x:0:
wheel:x:97:
EOF
        cat << "EOF" > "$pfx/sw/shadow/etc/login.defs"
UID_MIN 2500
UID_MAX 60000
GID_MIN 2500
GID_MAX 60000
PASS_MAX_DAYS 4242
ENCRYPT_METHOD YESCRYPT
EOF
        cat << "EOF" > "$pfx/etc/login.defs"
UID_MIN 3100
EOF

        # 1. chpasswd on vendor root creates /etc/shadow (0600) without creating /etc/passwd
        echo "root:secretpass" | ./src/chpasswd -P "$pfx"
        test ! -e "$pfx/etc/passwd"
        test -f "$pfx/etc/shadow"
        test "$(stat -c '%a' "$pfx/etc/shadow")" = "600"
        grep -q '^root:\$y\$[^:]*:[^:]*:[^:]*:4242:' "$pfx/etc/shadow"

        # 2. useradd creates /etc/passwd & /etc/group, honors user UID_MIN=3100 + vendor PASS_MAX_DAYS=4242,
        #    and CoW-materializes vendor group 'wheel' into /etc/group
        ./src/useradd -P "$pfx" -M -G wheel -s /sw/bash/bin/bash alice
        grep -q '^alice:x:3100:2500::/home/alice:/sw/bash/bin/bash$' "$pfx/etc/passwd"
        ! grep -q '^root:' "$pfx/etc/passwd"
        grep -q '^wheel:x:97:alice$' "$pfx/etc/group"
        grep -q '^alice:!:[^:]*:[^:]*:4242:' "$pfx/etc/shadow"

        # 3. usermod CoW-materializes vendor account 'daemon' into /etc/passwd
        ./src/usermod -P "$pfx" -c "Modified Daemon" daemon
        grep -q '^daemon:\*:1931809929:1931809929:Modified Daemon:/dev/null:/sw/coreutils/bin/false$' "$pfx/etc/passwd"

        rm -rf "$pfx"
    }
fi

INSTALL() {
    make install
    make -C man install-man
    rm -fv $DESTDIR/sw/shadow/lib/libsubid.la
}
