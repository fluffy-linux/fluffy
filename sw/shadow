if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=4.20.2

ARCHIVES=(
    b89f432b75ae55a2d852b446d0365484795fdf533ab97d550e325fa15594a224 https://github.com/fluffy-linux/shadow/releases/download/$VERSION/shadow-$VERSION.tar.xz
    2cfa6fb46fb9bf5ecd0518d27dac1198cbae76fedbe8a54ee2a4dc335ef1e306 file://shadow-$VERSION-fluffy-source.patch
)

NEEDS=(
    acl
    attr
    glibc
    libxcrypt
)

if test -v CROSS
then
    BUILD_NEEDS=(
        acl
        attr
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        libgcc
        libxcrypt
        linux-headers
        make-pass1
        patch-pass1
        pkgconf
        sed-pass1
    )
else
    BUILD_NEEDS=(
        acl
        attr
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        gettext
        glibc
        grep
        libgcc
        libxcrypt
        linux-headers
        make
        patch
        pkgconf
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i ../shadow-$VERSION-fluffy-source.patch

    find man -name Makefile.in -exec sed -i 's/groups\.1 / /'   {} \;
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/shadow \
        --exec-prefix=/sw/shadow \
        --sbindir=/sw/shadow/bin \
        --sysconfdir=/sw/shadow/etc \
        --disable-static \
        --with-{b,yes}crypt \
        --without-libbsd \
        --with-group-name-max-length=32 \
        --disable-logind \
        shadow_cv_maildir=/var/mail \
        shadow_cv_logdir=/var/log \
        CPPFLAGS='-DVENDOR_LOGINDEFS="\"/sw/*/etc/login.defs\"" -DVENDOR_GROUP_FILES="\"/sw/*/etc/group\"" -DVENDOR_PASSWD_FILES="\"/sw/*/etc/passwd\"" -DNOLOGIN_PROGRAM="\"/sw/shadow/bin/nologin\"" -DPATH_ENV="\"/sw/coreutils/bin/env\""'
    make
}

if ! test -v CROSS
then
    CHECK() {
        local pfx err_out rc=0
        pfx="$(mktemp -d '/tmp/shd_test_[1]:XXXXXX')"
        mkdir -p "$pfx/etc" "$pfx/sw/glibc/etc" "$pfx/sw/shadow/etc" "$pfx/ro/etc" "$pfx/ro/sw/glibc/etc"

        # 0. Explicit nonexistent CLI files fail with E_CANTOPEN / E_CANT_OPEN (exit 3),
        #    while stateless -P read-only queries succeed without /etc/{passwd,shadow}
        rc=0
        ./src/pwck -r "$pfx/missing_passwd" 2>/dev/null || rc=$?
        test "$rc" -eq 3
        rc=0
        ./src/grpck -r "$pfx/missing_group" 2>/dev/null || rc=$?
        test "$rc" -eq 3
        echo "selfuser:x:$(id -u):$(id -g):Self:/tmp:/sw/bash/bin/bash" > "$pfx/ro/sw/glibc/etc/passwd"
        ./src/chage -P "$pfx/ro" -l selfuser >/dev/null
        test ! -e "$pfx/ro/etc/passwd"
        test ! -e "$pfx/ro/etc/shadow"

        cat << "EOF" > "$pfx/sw/glibc/etc/passwd"
root:x:0:0:root:/root:/sw/bash/bin/bash
daemon:*:1931809929:1931809929:Daemon User:/dev/null:/sw/coreutils/bin/false
EOF
        cat << "EOF" > "$pfx/sw/glibc/etc/group"
root:x:0:
wheel:x:97:
EOF
        cat << "EOF" > "$pfx/sw/shadow/etc/login.defs"
UID_MIN 2500
UID_MAX 60000
GID_MIN 3500
GID_MAX 60000
PASS_MAX_DAYS 4242
ENCRYPT_METHOD YESCRYPT
USERGROUPS_ENAB yes
EOF
        cat << "EOF" > "$pfx/etc/login.defs"
UID_MIN 3100
EOF

        # 1. chpasswd on vendor root creates /etc/shadow (0600) without creating /etc/passwd
        echo "root:secretpass" | ./src/chpasswd -P "$pfx"
        test ! -e "$pfx/etc/passwd"
        test -f "$pfx/etc/shadow"
        test "$(stat -c '%a' "$pfx/etc/shadow")" = "600"
        grep -q '^root:\$y\$[^:]*:[^:]*:[^:]*:4242:' "$pfx/etc/shadow"

        # 2. useradd creates /etc/passwd & /etc/group, honors user UID_MIN=3100 + vendor GID_MIN=3500 & PASS_MAX_DAYS=4242,
        #    uses default _PATH_BSHELL (/sw/bash/bin/bash), and CoW-materializes vendor group 'wheel' into /etc/group
        ./src/useradd -P "$pfx" -M -G wheel alice
        grep -q '^alice:x:3100:3500::/home/alice:/sw/bash/bin/bash$' "$pfx/etc/passwd"
        ! grep -q '^root:' "$pfx/etc/passwd"
        grep -q '^wheel:x:97:alice$' "$pfx/etc/group"
        grep -q '^alice:!:[^:]*:[^:]*:4242:' "$pfx/etc/shadow"

        # 3. usermod CoW-materializes vendor account 'daemon' into /etc/passwd & accepts /sw/shadow/bin/nologin without Warning
        err_out="$(./src/usermod -P "$pfx" -s /sw/shadow/bin/nologin -c "Modified Daemon" daemon 2>&1)"
        test -z "$err_out"
        grep -q '^daemon:\*:1931809929:1931809929:Modified Daemon:/dev/null:/sw/shadow/bin/nologin$' "$pfx/etc/passwd"

        # 4. usermod -l, usermod -G "", and userdel CoW-materialize and update vendor supplementary groups
        ./src/useradd -P "$pfx" -M bob
        cat << "EOF" >> "$pfx/sw/glibc/etc/group"
staff:x:998:alice,bob
audio:x:999:alicenew,bob
video:x:997:bob
EOF
        ./src/usermod -P "$pfx" -l alicenew alice
        grep -q '^wheel:x:97:alicenew$' "$pfx/etc/group"
        grep -Eq '^staff:x:998:(alicenew,bob|bob,alicenew)$' "$pfx/etc/group"
        ! grep -q '^audio:' "$pfx/etc/group"

        ./src/usermod -P "$pfx" -G "" alicenew
        grep -q '^wheel:x:97:$' "$pfx/etc/group"
        grep -q '^staff:x:998:bob$' "$pfx/etc/group"
        grep -q '^audio:x:999:bob$' "$pfx/etc/group"
        ! grep -q '^video:' "$pfx/etc/group"

        ./src/userdel -P "$pfx" bob
        ! grep -q '^bob:' "$pfx/etc/passwd"
        ! grep -q '^bob:' "$pfx/etc/group"
        grep -q '^staff:x:998:$' "$pfx/etc/group"
        grep -q '^audio:x:999:$' "$pfx/etc/group"
        grep -q '^video:x:997:$' "$pfx/etc/group"

        rm -rf "$pfx"
    }
fi

INSTALL() {
    make install
    make -C man install-man
    rm -fv $DESTDIR/sw/shadow/lib/libsubid.la
}
