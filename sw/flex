if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.6.4

# Built straight from Fluffy's branch (upstream's v2.6.4 tag): swctl
# fetches the pinned commit with git.  The tag has no configure,
# Makefile.in, scanner (src/scan.c), parser (src/parse.c) or built
# manuals, so MAKE runs autogen.sh with the autoconf, automake and
# libtool the release was made with (2.69, 1.15, 2.4.6), from their
# Fluffy branches, and gettext's autopoint; make writes the scanner with
# flex-pass1, the parser with bison, the man page with help2man and the
# manual with makeinfo.
ARCHIVES=(
    ab49343b08c933e32de8de78132649f9560a3727 https://github.com/fluffy-linux/flex.git#refs/heads/fluffy/v$VERSION
    48eccc1ad68d408db760ce345e08eda16b694c52 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.69
    d134bdcb732a6f097d9553a0d2a311d66fbd834c https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.15
    963b66efea03cad6818121235016785e051d14c3 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.6
)

NEEDS=(
    glibc
    m4
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        flex-pass1
        gawk-pass1
        gcc-pass2
        gettext-pass1
        glibc
        grep-pass1
        gzip-pass1
        help2man-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        texinfo-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        help2man
        libgcc
        linux-headers
        m4
        make
        patch
        sed
        tar
        texinfo
    )
fi

source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/flex \
        --disable-static \
        --docdir=/sw/flex/share/doc/flex-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    ln -sv flex $DESTDIR/sw/flex/bin/lex
    ln -sv flex.1 $DESTDIR/sw/flex/share/man/man1/lex.1
}
