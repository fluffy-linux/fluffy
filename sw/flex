if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=2.6.4

HAS_LDFLAGS=-lfl

ARCHIVES=(
    e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995 https://github.com/fluffy-linux/flex/releases/download/v$VERSION/flex-$VERSION.tar.gz
)

NEEDS=(
    glibc
    m4
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        bison-pass1
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        sed
        tar
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/flex \
        --disable-static \
        --docdir=/sw/flex/share/doc/flex-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    ln -sv flex $DESTDIR/sw/flex/bin/lex
    ln -sv flex.1 $DESTDIR/sw/flex/share/man/man1/lex.1
}
