ON=host-build

VERSION=3.0.5

# Built straight from Fluffy's branch (our commits on upstream's
# pkgconf-3.0.5 tag): swctl fetches the pinned commit with git.  The tag has
# no configure or Makefile.in, so MAKE regenerates them with autogen.sh, as
# upstream makes its release tarball.
ARCHIVES=(
    d5b08696a5ea4413a3f99431617c2ea6deb2314e https://github.com/fluffy-linux/pkgconf.git#refs/heads/fluffy/pkgconf-$VERSION
    e22e555ccb88ac24a4cbdb20dc6629191bb5d1e8 https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.73
    d6fb77e1155d440250377e2da51ba4c3de019560 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
    143fe4356381cc64148b80e93b5b4c3651971d33 https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.6.0
)

NEEDS=(
    glibc-pass1
)

# Not in LFS, whose chapter 6 builds nothing that needs pkg-config.  Ours
# does (curl-pass1, python-pass1, util-linux-pass1, ...), and pkg-config
# here searches the /sw it builds for, not the host's.  Its system
# directories are the ones stock gcc-pass1 searches, so every other
# package's -I and -L are printed in full.
BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

# Regenerated with the autotools pkgconf's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    $CONFIG_SHELL ./autogen.sh
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/pkgconf \
        --host=$FLUFFY_TGT \
        --build=$($CONFIG_SHELL ./config.guess) \
        --disable-static \
        --with-pkg-config-dir='/sw/*/lib/pkgconfig:/sw/*/share/pkgconfig' \
        --with-system-libdir=/sw/glibc/lib \
        --with-system-includedir=/sw/glibc/include:/sw/linux-headers/include
    make
}

INSTALL() {
    make install
    ln -sv pkgconf $DESTDIR/sw/pkgconf/bin/pkg-config
    find $DESTDIR/sw/pkgconf/lib -name '*.la' -delete
}
