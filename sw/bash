if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=5.3

ARCHIVES=(
    d7705765d4680cae5e243edfe28b8cd146c25f47 https://github.com/fluffy-linux/bash.git#refs/heads/fluffy/bash-$VERSION
)

NEEDS=(
    glibc
    ncurses
    readline
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        expect
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        ncurses
        perl-pass1
        readline
        sed-pass1
        tar-pass1
        tcl
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        expect
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        ncurses
        perl
        readline
        sed
        tar
        tcl
        xz
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bash \
        --without-bash-malloc \
        --with-installed-readline \
        --docdir=/sw/bash/share/doc/bash-$VERSION \
        CPPFLAGS='-DSYS_PROFILE="\"/sw/*/etc/profile:/etc/profile\""'
    make
}

CHECK() {
    expect -c '
set timeout -1
spawn make tests
expect eof
lassign [wait] _ _ _ value
exit $value
'
    for t in run-glob-test run-glob-bracket run-globstar run-extglob run-extglob2 run-extglob3
    do
        env -C tests TMPDIR=/tmp BASH_TSTOUT=/tmp/bashtst-$$ THIS_SH=$PWD/bash BUILD_DIR=$PWD PATH=$PWD:$PATH $PWD/bash $t
    done
}

INSTALL() {
    make install
    ln -sv bash $DESTDIR/sw/bash/bin/sh

    install -dm755 $DESTDIR/sw/bash/etc
    cat > $DESTDIR/sw/bash/etc/profile << "EOF"
# Begin /sw/bash/etc/profile

export PATH="/sw/*/bin"
umask 022

if [[ -n "${BASH_VERSION:-}" && $- == *i* ]]; then
    if (( EUID == 0 )); then
        PS1='\u@\h:\w# '
    else
        PS1='\u@\h:\w\$ '
    fi
fi

# End /sw/bash/etc/profile
EOF
}
