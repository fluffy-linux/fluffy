ON=host-build

VERSION=1.14

# Built straight from Fluffy's branch (our commits on upstream's v1.14
# tag): swctl fetches the pinned commit, and the gnulib commit it pins,
# with git.  The tag has no configure, Makefile.in or gnulib files, so
# MAKE bootstraps it.
ARCHIVES=(
    612f880773f62784c74aef3a9b632b7d553a6386 https://github.com/fluffy-linux/gzip.git#refs/heads/fluffy/v$VERSION
    18bfebd5367050afd0f2f5b8eb1c2acc93c26c3a https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72.76-2f64
    df341d9c2ff367a0b177cb998c08ade9c03c0e3f https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.17.0.91
)

NEEDS=(
    glibc-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    linux-headers
)

# Bootstrapped with the autotools gzip's release tarball was made with:
# development snapshots of autoconf and automake.
source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    $CONFIG_SHELL ./bootstrap --skip-po --no-git --gnulib-srcdir=gnulib
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/gzip \
        --host=$FLUFFY_TGT
    make
}

INSTALL() {
    make install
}
