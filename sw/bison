if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=3.8.2

ARCHIVES=(
    9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2 https://github.com/fluffy-linux/bison/releases/download/v$VERSION/bison-$VERSION.tar.xz
    12fddada7b0fb9d9374a2e7fff40b23de5ea354946a095b356afc0b9f18b3380 file://bison-$VERSION-fluffy-source.patch
)

NEEDS=(
    glibc
    m4
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        flex
        gawk-pass1
        gcc
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        m4
        make-pass1
        patch-pass1
        perl-pass1
        sed-pass1
        tar-pass1
        xz
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        m4
        make
        patch
        perl
        sed
        tar
        xz
    )
fi

MAKE() {
    patch -Z -Np1 -i bison-$VERSION-fluffy-source.patch

    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/bison \
        --docdir=/sw/bison/share/doc/bison-$VERSION \
        M4=/sw/m4/bin/m4
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
}
