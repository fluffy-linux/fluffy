if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=0.195

# Built straight from Fluffy's branch (our commits on upstream's
# elfutils-0.195 tag, and upstream's later fix to known-dwarf.awk for
# gawk 5.4, by the user's exception to "never newer than LFS"): swctl
# fetches the pinned commit with git.  The tag has no configure,
# Makefile.in, gettext files or generated disassembler tables, so MAKE
# regenerates them with autoreconf, as upstream makes its release
# tarball (autoconf 2.72, automake 1.18.1, from their Fluffy branches,
# and gettext's autopoint), and configures in maintainer mode, in which
# make generates the tables with bison and flex.
ARCHIVES=(
    3048c839487856190e7c66a376cf744df03d10a4 https://github.com/fluffy-linux/elfutils.git#refs/heads/fluffy/elfutils-$VERSION
    ae4ca8a64a5ba81ed37e3aa37ef8d75abd4925fb https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.72
    cc330adb5f903693718796b765fb0cce0aaa66ba https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.18.1
)

NEEDS=(
    bzip2
    glibc
    xz
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        bison
        bzip2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        flex
        gawk-pass1
        gcc
        gettext
        glibc
        grep
        gzip-pass1
        libgcc
        libstdcpp
        linux-headers
        m4
        make-pass1
        patch-pass1
        pkgconf
        sed
        tar-pass1
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        bison
        bzip2
        coreutils
        diffutils
        findutils
        flex
        gawk
        gcc
        gettext
        glibc
        grep
        gzip
        libgcc
        libstdcpp
        linux-headers
        m4
        make
        patch
        pkgconf
        sed
        tar
        xz
        zlib
        zstd
    )
fi

source sw/autoconf.common
source sw/automake.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    # gettext installs autopoint with a #!/bin/sh line (gettext's bug).
    export AUTOPOINT="$CONFIG_SHELL /sw/gettext/bin/autopoint"
    autoreconf -fi
    ./configure \
        --prefix=/sw/libelf \
        --enable-maintainer-mode \
        --disable-debuginfod \
        --enable-libdebuginfod=dummy \
        --without-libarchive
    make -C lib
    make -C libelf
}

CHECK() {
    make -k check
}

INSTALL() {
    make -C libelf install
    install -vDm644 config/libelf.pc $DESTDIR/sw/libelf/lib/pkgconfig/libelf.pc
    rm -v $DESTDIR/sw/libelf/lib/libelf.a
}
