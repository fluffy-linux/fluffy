if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.21.0

# Built straight from Fluffy's branch (our commits on upstream's curl-8_21_0
# tag): swctl fetches the pinned commit with git.  The tag has no configure
# or Makefile.in, so MAKE regenerates them with autoreconf.
ARCHIVES=(
    a7d85d2fe87a066f7ad214ea37827a0e04af2e73 https://github.com/fluffy-linux/curl.git#refs/heads/fluffy/curl-${VERSION//./_}
)

NEEDS=(
    ca-certificates
    glibc
    nghttp2
    openssl
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        autoconf
        automake
        bash
        binutils
        ca-certificates
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        libtool
        linux-headers
        m4
        make-pass1
        nghttp2
        openssl
        perl
        pkgconf
        python
        sed
        tar-pass1
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        autoconf
        automake
        bash
        binutils
        ca-certificates
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        libtool
        linux-headers
        m4
        make
        nghttp2
        openssl
        perl
        pkgconf
        python
        sed
        tar
        xz
        zlib
        zstd
    )
fi

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    # Fluffy's autotools (LFS's autoconf, automake and libtool).
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

CHECK() {
    make test-nonflaky TFLAGS="-n -j$(nproc)"
}

INSTALL() {
    make install
    rm -rf docs/examples/.deps
    find docs \( -name Makefile\* -o -name \*.1 -o -name \*.3 -o -name CMakeLists.txt \) -delete
    install -v -d -m755 $DESTDIR/sw/curl/share/doc/curl-$VERSION
    cp -v -R docs -T $DESTDIR/sw/curl/share/doc/curl-$VERSION
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
