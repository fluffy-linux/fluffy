if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.23.0

HAS_LDFLAGS=-lcurl

ARCHIVES=(
    8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5 https://github.com/fluffy-linux/curl/releases/download/curl-${VERSION//./_}/curl-$VERSION.tar.xz
    2594eb98f8272a60df111235b94bc5b0ea79ec5cff750801d02e270cd0fe037d file://curl-$VERSION-fluffy-source.patch
    a3f92fc9cec3592efcb089bcec37fa5025b8b7f3b67d22ca4a8abac343c4e4b7 file://curl-$VERSION-fluffy-test.patch
    039bf88a47db3d62b63eb94922b71f459b9526b51d78bef85f4adb6f26826655 file://curl-$VERSION-fluffy-ch8.patch
)

NEEDS=(
    ca-certificates
    glibc
    openssl
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        ca-certificates
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        openssl
        patch-pass1
        perl
        python
        sed
        tar-pass1
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        ca-certificates
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        openssl
        patch
        perl
        python
        sed
        tar
        xz
        zlib
        zstd
    )
fi

MAKE() {
    patch -Z -Np1 -i curl-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i curl-$VERSION-fluffy-test.patch
    patch -Z -Np1 -i curl-$VERSION-fluffy-ch8.patch
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

CHECK() {
    make test-nonflaky TFLAGS="-n -j$(nproc)"
}

INSTALL() {
    make install
    rm -rf docs/examples/.deps
    find docs \( -name Makefile\* -o -name \*.1 -o -name \*.3 -o -name CMakeLists.txt \) -delete
    install -v -d -m755 $DESTDIR/sw/curl/share/doc/curl-$VERSION
    cp -v -R docs -T $DESTDIR/sw/curl/share/doc/curl-$VERSION
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
