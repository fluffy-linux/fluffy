if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.21.0

# Built straight from Fluffy's branch (our commits on upstream's curl-8_21_0
# tag): swctl fetches the pinned commit with git.  The tag has no configure
# or Makefile.in, so MAKE regenerates them with the autoconf, automake and
# libtool the release tarball was made with (2.71, 1.16.5, 2.4.7), from
# their Fluffy branches.
ARCHIVES=(
    a7d85d2fe87a066f7ad214ea37827a0e04af2e73 https://github.com/fluffy-linux/curl.git#refs/heads/fluffy/curl-${VERSION//./_}
    ba484d1863d991a16e8acc5b414bb73eb0ef73bd https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v2.71
    dc8bbd04db8f65af58d764d70f1c4a168621ffb1 https://github.com/fluffy-linux/automake.git#refs/heads/fluffy/v1.16.5
    a6ae0fe54d0952d5f7e702b885ed7060bf7c390b https://github.com/fluffy-linux/libtool.git#refs/heads/fluffy/v2.4.7
)

NEEDS=(
    ca-certificates
    glibc
    nghttp2
    openssl
    zlib
    zstd
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash
        binutils
        ca-certificates
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc
        glibc
        grep
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        nghttp2
        openssl
        perl
        pkgconf
        python
        sed
        xz
        zlib
        zstd
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        ca-certificates
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        nghttp2
        openssl
        perl
        pkgconf
        python
        sed
        xz
        zlib
        zstd
    )
fi

# Regenerated with the autotools curl's release tarball was made with.
source sw/autoconf.common
source sw/automake.common
source sw/libtool.common

MAKE() {
    export CONFIG_SHELL=/sw/bash/bin/bash
    autoconf_build
    automake_build
    libtool_build
    autoreconf -fi
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/curl \
        --disable-static \
        --with-openssl \
        --without-libpsl \
        --with-ca-bundle='/sw/*/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-path='/sw/*/etc/ssl/certs' \
        --with-ca-fallback
    make
}

CHECK() {
    make test-nonflaky TFLAGS="-n -j$(nproc)"
}

INSTALL() {
    make install
    rm -rf docs/examples/.deps
    find docs \( -name Makefile\* -o -name \*.1 -o -name \*.3 -o -name CMakeLists.txt \) -delete
    install -v -d -m755 $DESTDIR/sw/curl/share/doc/curl-$VERSION
    cp -v -R docs -T $DESTDIR/sw/curl/share/doc/curl-$VERSION
    find $DESTDIR/sw/curl/lib -name '*.la' -delete
}
