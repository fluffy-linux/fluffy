ON=host-build

VERSION=4.7.5

# Built straight from Fluffy's branch (upstream's 4.7.5 tag; no commits
# of ours): swctl fetches the pinned commit with git.  Its archive is the
# release, apart from version.mk's abbreviated hash, which the build
# doesn't use (the Makefile sets RELEASE_VERSION).
ARCHIVES=(
    708c59ae80853b0845017c33b42e56061cc546cd https://github.com/fluffy-linux/squashfs-tools.git#refs/heads/fluffy/$VERSION
)

NEEDS=(
    glibc-pass1
    libgcc-pass1
    zstd-pass1
)

BUILD_NEEDS=(
    gcc-pass1
    glibc-pass1
    libgcc-pass1
    linux-headers
    zstd-pass1
)

MAKE() {
    make -C squashfs-tools \
        CC=$FLUFFY_TGT-gcc \
        GZIP_SUPPORT=0 \
        XZ_SUPPORT=0 \
        ZSTD_SUPPORT=1 \
        LZO_SUPPORT=0 \
        LZ4_SUPPORT=0 \
        COMP_DEFAULT=zstd \
        EXTRA_CFLAGS="-I/sw/zstd/include" \
        EXTRA_LDFLAGS="-L/sw/zstd/lib"
}

INSTALL() {
    mkdir -pv $DESTDIR/sw/squashfs-tools/bin
    cp -v squashfs-tools/{mksquashfs,unsquashfs} $DESTDIR/sw/squashfs-tools/bin
    ln -sv unsquashfs $DESTDIR/sw/squashfs-tools/bin/sqfscat
    ln -sv mksquashfs $DESTDIR/sw/squashfs-tools/bin/sqfstar
}
