# Autoconf at the version a package's release tarball was generated with,
# built from git inside the package's own build to regenerate its
# configure.  The recipe lists that version's Fluffy branch in its own
# ARCHIVES, so it is placed as ../autoconf.tar:
#
#     <commit> https://github.com/fluffy-linux/autoconf.git#refs/heads/fluffy/v<version>
#
# and sources this file; MAKE calls autoconf_build before autoreconf.
#
# Building autoconf from git takes an existing autoconf and automake (its
# own configure is generated), and m4 and perl: the host's in host-build,
# autoconf-pass1, automake-pass1, m4-pass1 and perl-pass1 in cross-build
# (a recipe naming the final m4 or perl gets those instead), the final
# packages in fluffy-build.  The man pages need help2man and the manual
# makeinfo; neither is built.
# It installs into the build's own prefix, never into a package's DESTDIR.

case "$ON" in
    cross-build)
        BUILD_NEEDS+=(
            autoconf-pass1
            automake-pass1
            m4-pass1
            perl-pass1
            # The helper unpacks its sources with tar.
            tar-pass1
        )
        ;;
    fluffy-build)
        BUILD_NEEDS+=(
            autoconf
            automake
            m4
            perl
            tar
        )
        ;;
esac

autoconf_build() {
    local prefix="$PWD/.autotools"
    mkdir -p .autotools-build
    tar -xf ../autoconf.tar -C .autotools-build
    (
        cd .autotools-build/autoconf
        autoreconf -fi
        ${CONFIG_SHELL:-/bin/sh} ./configure --prefix="$prefix"
        make dist_man_MANS= INFO_DEPS=
        make dist_man_MANS= INFO_DEPS= DESTDIR= install
    )
    export PATH="$prefix/bin:$PATH"
}
