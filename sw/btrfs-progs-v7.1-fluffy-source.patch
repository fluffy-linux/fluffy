diff --no-dereference -Naur btrfs-progs-v7.1.orig/configure btrfs-progs-v7.1/configure
--- btrfs-progs-v7.1.orig/configure	2026-07-14 22:42:06.000000000 +0000
+++ btrfs-progs-v7.1/configure	2026-07-14 22:42:06.000000000 +0000
@@ -11223,10 +11223,7 @@
 # udev v190 introduced the btrfs builtin and a udev rule to use it.
 # Our udev rule gives us the friendly dm names but isn't required (or valid)
 # on earlier releases.
-UDEVDIR=
-if ${PKG_CONFIG} udev --atleast-version 190; then
-	UDEVDIR="$(${PKG_CONFIG} udev --variable=udevdir)"
-fi
+UDEVDIR='${prefix}/lib/udev'
 
 
 
