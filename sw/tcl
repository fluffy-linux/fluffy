if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=8.6.18

HAS_LDFLAGS=-ltcl8.6

ARCHIVES=(
    14f9af32b1767ff718477a8f974ad03c34341097e6b43f4ce54644ee974e268e https://github.com/fluffy-linux/tcl/releases/download/core-${VERSION//./-}/tcl$VERSION-src.tar.gz
    bee2d83a19ce50624eeae951be29fe5f654b171357a6391123caf18107cec543 https://github.com/fluffy-linux/tcl/releases/download/core-${VERSION//./-}/tcl$VERSION-html.tar.gz
    65b998a705a2b8812c22a731ed3c001589d79590edf184a3300d25bfd7f9a067 file://tcl$VERSION-fluffy-source.patch
    97296312735d79b0fbfcf9d70e67e84cd18d681481f34a8a5d4b7445f220bbba file://tcl$VERSION-fluffy-test.patch
)

NEEDS=(
    glibc
    zlib
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        binutils-pass2
        coreutils-pass1
        diffutils-pass1
        findutils-pass1
        gawk-pass1
        gcc-pass2
        glibc
        grep-pass1
        gzip-pass1
        libgcc
        linux-headers
        make-pass1
        patch-pass1
        sed-pass1
        tar-pass1
        zlib
    )
else
    BUILD_NEEDS=(
        bash
        binutils
        coreutils
        diffutils
        findutils
        gawk
        gcc
        glibc
        grep
        gzip
        libgcc
        linux-headers
        make
        patch
        sed
        tar
        zlib
    )
fi

MAKE() {
    patch -Z -Np1 -i tcl$VERSION-fluffy-source.patch
    patch -Z -Np1 -i tcl$VERSION-fluffy-test.patch

    SRCDIR=$(pwd)
    cd unix
    export CONFIG_SHELL=/sw/bash/bin/bash
    CONFIG_SITE=/sw/glibc/share/config.site $CONFIG_SHELL ./configure \
        --prefix=/sw/tcl \
        --mandir=/sw/tcl/share/man \
        --disable-rpath \
        TCL_PACKAGE_PATH="/sw/*/lib"
    make

    sed -e "s|$SRCDIR/unix|/sw/tcl/lib|" \
        -e "s|$SRCDIR|/sw/tcl/include|"  \
        -i tclConfig.sh
    touch -r Makefile tclConfig.sh

    sed -e "s|$SRCDIR/unix/pkgs/tdbc1.1.13|/sw/tcl/lib/tdbc1.1.13|" \
        -e "s|$SRCDIR/pkgs/tdbc1.1.13/generic|/sw/tcl/include|"    \
        -e "s|$SRCDIR/pkgs/tdbc1.1.13/library|/sw/tcl/lib/tcl8.6|" \
        -e "s|$SRCDIR/pkgs/tdbc1.1.13|/sw/tcl/include|"            \
        -i pkgs/tdbc1.1.13/tdbcConfig.sh

    sed -e "s|$SRCDIR/unix/pkgs/itcl4.3.7|/sw/tcl/lib/itcl4.3.7|" \
        -e "s|$SRCDIR/pkgs/itcl4.3.7/generic|/sw/tcl/include|"    \
        -e "s|$SRCDIR/pkgs/itcl4.3.7/library|/sw/tcl/lib/tcl8.6|" \
        -e "s|$SRCDIR/pkgs/itcl4.3.7|/sw/tcl/include|"            \
        -i pkgs/itcl4.3.7/itclConfig.sh

    unset SRCDIR
}

CHECK() {
    cd unix
    LC_ALL=C.UTF-8 make test
}

INSTALL() {
    cd unix
    make install
    chmod 644 $DESTDIR/sw/tcl/lib/libtclstub8.6.a
    chmod -v u+w $DESTDIR/sw/tcl/lib/libtcl8.6.so
    make install-private-headers
    ln -sfv tclsh8.6 $DESTDIR/sw/tcl/bin/tclsh
    if test -f $DESTDIR/sw/tcl/share/man/man3/Thread.3
    then
        mv -v $DESTDIR/sw/tcl/share/man/man3/{Thread,Tcl_Thread}.3
    fi
    mkdir -v -p $DESTDIR/sw/tcl/share/doc/tcl-$VERSION
    cp -v -r ../tcl$VERSION-html/tcl$VERSION/html/* $DESTDIR/sw/tcl/share/doc/tcl-$VERSION
}
