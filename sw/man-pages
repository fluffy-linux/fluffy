if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.18

# Built straight from Fluffy's branch (our commits on upstream's
# man-pages-6.18 tag, the first of them dating the pages as the release
# does, then LFS's removal of the crypt(3) pages, which libxcrypt
# provides): swctl fetches the pinned commit with git.
ARCHIVES=(
    622ec6e009cddb536d8b4cdc2f0db57e62ebbbd0 https://github.com/fluffy-linux/man-pages.git#refs/heads/fluffy/man-pages-$VERSION
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        coreutils-pass1
        findutils-pass1
        grep-pass1
        make-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        findutils
        grep
        make
        sed
    )
fi

INSTALL() {
    make -R GIT=false SHELL=/sw/bash/bin/bash prefix=/sw/man-pages install
}
