if test -v CROSS
then
    ON=cross-build
else
    ON=fluffy-build
fi

VERSION=6.18

ARCHIVES=(
    c934fadc8b59748c68227a34f6581d2ddf8282b73cdcd52546c8cd88b74b24d1 https://github.com/fluffy-linux/man-pages/releases/download/man-pages-$VERSION/man-pages-$VERSION.tar.xz
    a833f7f585791611f1c25814a1c429406af0a3f03f81f01cf1f1f538e51a60c6 file://man-pages-$VERSION-fluffy-source.patch
    0d84d157288e440c1f6602472f57d27de6315be13d0c442e1bc3110664aec4a1 file://man-pages-$VERSION-fluffy-test.patch
)

if test -v CROSS
then
    BUILD_NEEDS=(
        bash-pass1
        coreutils-pass1
        findutils-pass1
        grep-pass1
        make-pass1
        patch-pass1
        sed-pass1
    )
else
    BUILD_NEEDS=(
        bash
        coreutils
        findutils
        grep
        make
        patch
        sed
    )
fi

MAKE() {
    patch -Z -Np1 -i man-pages-$VERSION-fluffy-source.patch
    patch -Z -Np1 -i man-pages-$VERSION-fluffy-test.patch
    rm -vf man/man3/crypt*
}

INSTALL() {
    make -R GIT=false SHELL=/sw/bash/bin/bash prefix=/sw/man-pages install
}
