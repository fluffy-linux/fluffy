#!/usr/bin/env bash
# Writes the Buildkite agent token to /run/fluffy-ci/agent-token, and the
# GitHub container registry token (binary cache publishing), when Secret
# Manager has one, to /run/fluffy-ci/ghcr-token (root only).  Both are read
# with the VM's service account, from the metadata server, without
# surrounding whitespace (a token stored from a file often ends in a
# newline).  Needs, from /etc/fluffy-ci/agent.env: FLUFFY_CI_PROJECT (the
# GCP project holding the secrets).
set -euo pipefail

: "${FLUFFY_CI_PROJECT:?}"

metadata=http://metadata.google.internal/computeMetadata/v1
# The metadata server can be slow to answer early in a VM's first boot:
# wait for the service account's token, for up to 2 minutes.
access_token=
for attempt in $(seq 1 40)
do
    if reply=$(curl -fsS -H Metadata-Flavor:Google \
        "$metadata/instance/service-accounts/default/token")
    then
        access_token=$(printf '%s' "$reply" | python3 -c 'import json, sys; print(json.load(sys.stdin)["access_token"])') && break
    fi
    sleep 3
done
if test -z "$access_token"
then
    echo "fluffy-ci-agent-token: no service account token from the metadata server" >&2
    exit 1
fi

# secret NAME: print the latest version of secret NAME, trimmed.  The access
# token goes to curl as a config on stdin, never on the command line.
secret() {
    printf 'header = "Authorization: Bearer %s"\n' "$access_token" |
        curl -fsS --retry 5 -K - \
            "https://secretmanager.googleapis.com/v1/projects/$FLUFFY_CI_PROJECT/secrets/$1/versions/latest:access" |
        python3 -c 'import base64, json, sys; sys.stdout.write(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode().strip())'
}

install -d -m 700 -o buildkite-agent -g buildkite-agent /run/fluffy-ci
umask 077
secret buildkite-agent-token > /run/fluffy-ci/agent-token
chown buildkite-agent:buildkite-agent /run/fluffy-ci/agent-token

# The registry token is optional: without it the agent still builds, and
# swctl only reads the cache.
if secret ghcr-token > /run/fluffy-ci/ghcr-token.new && test -s /run/fluffy-ci/ghcr-token.new
then
    chmod 600 /run/fluffy-ci/ghcr-token.new
    mv /run/fluffy-ci/ghcr-token.new /run/fluffy-ci/ghcr-token
else
    rm -f /run/fluffy-ci/ghcr-token.new
    echo "fluffy-ci-agent-token: no ghcr-token in Secret Manager; the cache is read-only"
fi
