#!/usr/bin/env bash
# Sets every fluffy-linux git mirror's "upstream" organization custom
# property ("URL of upstream Git repository, if any"; read by
# `mirror sync`) from the bare mirrors mkmirror.sh keeps on the user's PC:
# a mirror's origin remote is its upstream.  Repositories imported from
# something other than git (CVS, Fossil, release tarballs, the Translation
# Project) have no origin and keep the property empty; their description
# names their source.
#
#   backfill-properties            show what it would set
#   backfill-properties --apply    set the values
#
# Runs with the user's gh login.
set -euo pipefail

org=fluffy-linux
base=$HOME/Source/github.com/fluffy-linux
apply=0
test "${1:-}" = --apply && apply=1

declare -A url
for m in "$base"/*.git
do
    r=$(basename "$m" .git)
    u=$(git -C "$m" remote get-url origin 2>/dev/null || true)
    case "$u" in
        ""|/*|file://*) continue ;;  # not git, or a local import
    esac
    url[$r]=$u
done

for r in $(gh repo list "$org" --limit 1000 --json name --jq '.[].name' | sort)
do
    test "$r" != fluffy || continue
    if test -z "${url[$r]:-}"
    then
        echo "$r: (not git) $(gh repo view "$org/$r" --json description --jq .description)"
        continue
    fi
    echo "$r: ${url[$r]}"
    if (( apply ))
    then
        printf '{"properties": [{"property_name": "upstream", "value": "%s"}]}\n' "${url[$r]}" |
            gh api -X PATCH "/repos/$org/$r/properties/values" --input - > /dev/null
    fi
done
