#!/usr/bin/env bash

set -euo pipefail

if test -z "${SUDO_UID:-}"
then
    echo "Must be run via sudo: sudo $0" >&2
    exit 1
fi

sw_dir="/mnt/fluffy/sw"

exec unshare -m bash -s << "EOF"
set -euo pipefail

# Make all mounts private so nothing leaks back to the host
mount --make-rprivate /

mkdir -p /sw/{binutils,gcc,glibc,libstdcpp,linux-headers,libffi,ncurses}

mount -t squashfs -o ro /mnt/fluffy/sw/glibc-pass1-*.squashfs /sw/glibc
mount -t squashfs -o ro /mnt/fluffy/sw/linux-headers-*.squashfs /sw/linux-headers
mount -t squashfs -o ro /mnt/fluffy/sw/binutils-pass2-*.squashfs /sw/binutils
mount -t squashfs -o ro /mnt/fluffy/sw/gcc-pass2-*.squashfs /sw/gcc
mount -t squashfs -o ro /mnt/fluffy/sw/libstdcpp-pass1-*.squashfs /sw/libstdcpp
mount -t squashfs -o ro /mnt/fluffy/sw/libffi-pass1-*.squashfs /sw/libffi
mount -t squashfs -o ro /mnt/fluffy/sw/ncurses-pass1-*.squashfs /sw/ncurses

FLUFFY_TGT="$(uname -m)-fluffy-linux-gnu"
export PATH="/sw/gcc/bin:/sw/binutils/bin:/sw/binutils/$FLUFFY_TGT/bin:/usr/bin:/bin"

tmpdir="$(mktemp -d)"
trap "rm -rf '$tmpdir'" EXIT

echo "---- 1. Checking compiler & linker versions ----"
"$FLUFFY_TGT-gcc" --version | head -n 1
cc --version | head -n 1
ld --version | head -n 1
as --version | head -n 1

echo
echo "---- 2. Compiling C dummy program ----"
cat << "C_EOF" > "$tmpdir/dummy.c"
#include <stdio.h>
int main() {
    printf("C toolchain OK! libc at %p\n", (void *)printf);
    return 42;
}
C_EOF

"$FLUFFY_TGT-gcc" "$tmpdir/dummy.c" -o "$tmpdir/dummy"

echo "Checking dynamic linker PT_INTERP:"
readelf -l "$tmpdir/dummy" | grep "program interpreter"

echo "Executing C dummy:"
set +e
"$tmpdir/dummy"
ret=$?
set -e
if test "$ret" -ne 42
then
    echo "ERROR: Unexpected exit code $ret (expected 42)" >&2
    exit 1
fi
echo "Exit code: 42 (verified)"

echo
echo "---- 3. Compiling C++ dummy program (<iostream>) ----"
cat << "CPP_EOF" > "$tmpdir/dummy.cpp"
#include <iostream>
int main() {
    std::cout << "C++ toolchain & libstdc++ OK!" << std::endl;
    return 0;
}
CPP_EOF

"$FLUFFY_TGT-g++" "$tmpdir/dummy.cpp" -o "$tmpdir/dummy-cpp"

echo "Checking dynamic dependencies:"
readelf -d "$tmpdir/dummy-cpp" | grep NEEDED

echo "Executing C++ dummy:"
"$tmpdir/dummy-cpp"

echo
echo "---- 4. Verifying late-bound discovery (<ffi.h> + -lffi with ZERO -I/-L) ----"
cat << "FFI_EOF" > "$tmpdir/test-ffi.c"
#include <stdio.h>
#include <ffi.h>

int main() {
    ffi_cif cif;
    ffi_type *args[1];
    void *values[1];
    char *s = "Late-bound discovery OK!";

    args[0] = &ffi_type_pointer;
    values[0] = &s;

    if (ffi_prep_cif(&cif, FFI_DEFAULT_ABI, 1, &ffi_type_sint, args) == FFI_OK) {
        ffi_arg rc;
        ffi_call(&cif, FFI_FN(puts), &rc, values);
        return 0;
    }
    return 1;
}
FFI_EOF

# Zero -I, zero -L! Pure late-bound discovery:
"$FLUFFY_TGT-gcc" "$tmpdir/test-ffi.c" -lffi -o "$tmpdir/test-ffi"
"$tmpdir/test-ffi"

echo
echo "========================================================"
echo "  ALL SANITY CHECKS PASSED: Toolchain is fully operational!"
echo "========================================================"
EOF
