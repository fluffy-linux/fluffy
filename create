#!/usr/bin/env bash

set -euo pipefail

source ctypes.sh

CLONE_FS=0x00000200
CLONE_NEWNS=0x00020000
CLONE_NEWNET=0x40000000

MS_RDONLY=0x00000001
MS_REMOUNT=0x00000020
MS_BIND=0x00001000
MS_REC=0x00004000
MS_PRIVATE=0x00040000

log() {
    echo "$@" >&2
}

banner() {
    local prefix="---- $1 "
    local dashes="-------------------------------------------------------------------------------"
    log
    log "${prefix}${dashes:${#prefix}}"
    log
}

fatal() {
    log "$@"
    exit 1
}

call() {
    local ret
    dlcall -n ret -r int "$@"
    if (( ${ret#*:} == -1 ))
    then
        return 1
    fi
}

lockdown() {
    banner $1
    trap "fatal \"$1 failed with exit code \$?\"" ERR
    (
        wd="$(pwd)"

        local -n phase_needs="${1}_NEEDS"
        local -a queue=("${phase_needs[@]}")
        local -A seen=()
        local -a resolved_deps=()
        local dep_path=""

        while (( ${#queue[@]} > 0 ))
        do
            local dep="${queue[0]}"
            queue=("${queue[@]:1}")

            if test -n "${seen[$dep]:-}"
            then
                continue
            fi
            seen[$dep]=1

            if test ! -f "$root/sw/$dep"
            then
                fatal "dependency package file not found: $root/sw/$dep"
            fi

            local -a sub_needs=()
            readarray -t sub_needs < <(
                NEEDS=()
                source "$root/sw/$dep"
                if (( ${#NEEDS[@]} > 0 ))
                then
                    printf '%s\n' "${NEEDS[@]}"
                fi
            )
            queue+=("${sub_needs[@]}")
            resolved_deps+=("$dep")
        done

        case "$1" in
            MAKE)
                ;;
            CHECK)
                mkdir -p "$work_dir/test-results" "$work_dir/test-work"
                ;;
            INSTALL)
                mkdir -p "$work_dir/installed"
                ;;
            *)
                fatal "unknown phase: $1"
                ;;
        esac

        # elevate back to root strictly to set up namespaces and mounts
        call setresuid 0 0 0
        call setresgid 0 0 0

        # no network access for builds, ro / and rw /work
        call unshare $(( CLONE_NEWNET | CLONE_NEWNS ))

        # stop mount propagation back to the parent/host namespace
        call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL

        if test "$ON" == host
        then
            call mount /bin/bash /bin/sh $NULL $MS_BIND $NULL
            call mount /mnt/fluffy/sw /sw $NULL $(( MS_BIND | MS_REC )) $NULL
        fi

        for dep in "${resolved_deps[@]}"
        do
            shopt -s nullglob
            local matches=(/sw/"$dep"-[0-9]*.squashfs)
            shopt -u nullglob
            if (( ${#matches[@]} == 0 ))
            then
                fatal "no squashfs found for dependency: $dep"
            fi
            if (( ${#matches[@]} > 1 ))
            then
                fatal "multiple squashfs found for dependency $dep: ${matches[*]}"
            fi
            local dep_mount="/sw/${dep%-pass*}"
            mkdir -p "$dep_mount"
            mount -t squashfs -o ro "${matches[0]}" "$dep_mount"
            dep_path="${dep_path:+$dep_path:}$dep_mount/bin"
        done

        case "$1" in
            MAKE)
                # mount pwd read-write at /work
                call mount "$wd" /work $NULL $(( MS_BIND | MS_REC )) $NULL
                ;;
            CHECK)
                call mount overlay /work overlay 0 "lowerdir=$wd,upperdir=$work_dir/test-results,workdir=$work_dir/test-work"
                ;;
            INSTALL)
                mkdir -p "/sw/$mount_pkg"
                call mount "$work_dir/installed" "/sw/$mount_pkg" $NULL $(( MS_BIND | MS_REC )) $NULL
                call mount "$wd" /work $NULL $(( MS_BIND | MS_REC )) $NULL
                dep_path="/sw/$mount_pkg/bin${dep_path:+:$dep_path}"
                ;;
        esac

        if test "$ON" == host
        then
            call mount none /sw $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL
        fi

        # bind-mount / to itself so VFS lets us change its per-mount ro flag,
        # then remount the / bind-mount read-only
        call mount / / $NULL $(( MS_BIND | MS_REC )) $NULL
        call mount none / $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL

        # mount a fresh private tmpfs on /tmp that is automatically destroyed when the namespace exits
        call mount tmpfs /tmp tmpfs 0 $NULL

        # enter /work so our cwd is on top of the writable mount
        cd /work

        # permanently drop root (including saved UID/GID) for the build phase
        call setgroups 0 $NULL
        call setresgid "$SUDO_GID" "$SUDO_GID" "$SUDO_GID"
        call setresuid "$SUDO_UID" "$SUDO_UID" "$SUDO_UID"

        set +h
        umask 022

        local saved_term="${TERM:-dumb}"
        local nproc_val="$(nproc)"
        local uname_m="$(uname -m)"

        # scrub environment variables so host variables cannot leak into builds
        for var in $(compgen -e)
        do
            case "$var" in
                PWD|SHLVL|_)
                    ;;
                *)
                    unset "$var"
                    ;;
            esac
        done

        export HOME=/tmp
        export TERM="$saved_term"
        export LC_ALL=POSIX
        export MAKEFLAGS="-j$(( nproc_val > 1 ? nproc_val - 1 : 1 ))"
        export PATH=/usr/bin
        if test ! -L /bin
        then
            export PATH="/bin:$PATH"
        fi
        if test -n "$dep_path"
        then
            export PATH="$dep_path:$PATH"
        fi

        if test "$ON" == host
        then
            export FLUFFY=/mnt/fluffy
            export FLUFFY_TGT="${uname_m}-fluffy-linux-gnu"
            export CONFIG_SITE=/dev/null
        fi

        "$1"
    )
    trap - ERR
}

if test $# -ne 1
then
    fatal "Usage: $0 <package>"
fi

if test -z "${SUDO_UID:-}" || test -z "${SUDO_GID:-}"
then
    fatal "must be run via sudo"
fi

pkg_file="$(realpath -e "$1" 2>/dev/null || true)"

cd "$(dirname "${BASH_SOURCE[0]}")"
root="$(pwd)"
work_dir="$root/work"

# drop to the calling user immediately, keeping saved UID/GID 0 only for lockdown mounts
call setgroups 0 $NULL
call setresgid "$SUDO_GID" "$SUDO_GID" 0
call setresuid "$SUDO_UID" "$SUDO_UID" 0

if test -z "$pkg_file" && test -f "$root/sw/$1"
then
    pkg_file="$root/sw/$1"
fi

if test -z "$pkg_file" || test ! -f "$pkg_file"
then
    fatal "Package not found: $1"
fi

pkg="$(basename "$pkg_file")"
mount_pkg="${pkg%-pass*}"

declare -a ARCHIVES
declare -a archives
declare -a NEEDS=()
declare -a MAKE_NEEDS=()
declare -a CHECK_NEEDS=()
declare -a INSTALL_NEEDS=()

banner PREPARE

ON=fluffy
source "$pkg_file"

if test -z "${VERSION:-}"
then
    fatal "no VERSION defined"
fi

if test "$(type -t INSTALL)" != function
then
    fatal "no INSTALL function defined"
fi

if (( ${#ARCHIVES[@]} % 2 != 0 ))
then
    fatal "Invalid number of items: ${#ARCHIVES[@]}"
fi

case "$ON" in
    host)
        sw_dir="/mnt/fluffy/sw"
        ;;
    fluffy)
        sw_dir="/sw"
        ;;
    *)
        fatal "Invalid ON target: $ON"
        ;;
esac

mkdir -p "$work_dir/archives"

for ((i=0; i<${#ARCHIVES[@]}; i+=2))
do
    sha256="${ARCHIVES[i]}"
    url="${ARCHIVES[i+1]}"
    filename="${url##*/}"
    archives+=("$filename")
    if [[ "$url" != *://* || "$url" == file://* ]]
    then
        local_path="$root/sw/${url#file://}"
        if test ! -f "$local_path"
        then
            fatal "local archive not found: $local_path"
        fi
        actual_sha256="$(sha256sum "$local_path" | cut -d' ' -f1)"
        if test "$actual_sha256" != "$sha256"
        then
            fatal "checksum mismatch for $filename: $actual_sha256 != $sha256"
        fi
        cp "$local_path" "$work_dir/archives/$filename"
        continue
    fi
    if test -f "$work_dir/archives/$filename"
    then
        # assume downloaded
        continue
    fi
    tmpfile="$(mktemp)"
    log -n "downloading $filename... "
    wget --quiet --output-document "$tmpfile" "$url"
    actual_sha256="$(sha256sum "$tmpfile" | cut -d' ' -f1)"
    if test "$actual_sha256" != "$sha256"
    then
        rm "$tmpfile"
        fatal "checksum mismatch: $actual_sha256 != $sha256"
    fi
    mv "$tmpfile" "$work_dir/archives/$filename"
    log "done"
done

log -n "cleaning work area... "
rm -rf "$work_dir"/{src,installed,test-results,test-work}
mkdir -p "$work_dir/src"
log "done"

cd "$work_dir/src"
log -n "extracting ${archives[0]}..."
tar -xf "$work_dir/archives/${archives[0]}"
log "done"

# the first archive is special and we change to its directory
# so that the build scripts can be run from there
shopt -s extglob
archive_name="${archives[0]%%?(-src).tar.*}"
cd "$archive_name"
shopt -u extglob

for archive in "${archives[@]:1}"
do
    case "$archive" in
        *.tar.*)
            log -n "extracting $archive..."
            tar -xf "$work_dir/archives/$archive"
            log "done"
            ;;
        *)
            cp "$work_dir/archives/$archive" .
            ;;
    esac
done


if test "$(type -t MAKE)" == function
then
    lockdown MAKE
fi

if test "$(type -t CHECK)" == function
then
    lockdown CHECK
fi

lockdown INSTALL

banner SQUASHFS

squashfs_file="$sw_dir/$pkg-$VERSION.squashfs"
(
    call setresuid 0 0 0
    call setresgid 0 0 0
    rm -f "$squashfs_file"
    mksquashfs \
        "$work_dir/installed" "$squashfs_file" \
        -all-root \
        -comp zstd \
        -quiet \
        -no-progress
)

log "squashfs created: $squashfs_file"

banner CLEANUP
cd "$root"
rm -rf "$work_dir"/{src,installed,test-results,test-work}
