#!/usr/bin/env bash

set -euo pipefail

source ctypes.sh

CLONE_FS=0x00000200
CLONE_NEWNS=0x00020000
CLONE_NEWNET=0x40000000

MS_RDONLY=0x00000001
MS_REMOUNT=0x00000020
MS_BIND=0x00001000
MS_REC=0x00004000
MS_PRIVATE=0x00040000

cd "$(dirname "$BASH_SOURCE[0]")"

root="$(pwd)"

log() {
    echo "$@" >&2
}

banner() {
    local prefix="---- $1 "
    local dashes="-------------------------------------------------------------------------------"
    log
    log "${prefix}${dashes:${#prefix}}"
    log
}

fatal() {
    log "$@"
    exit 1
}

call() {
    local ret
    dlcall -n ret -r int "$@"
    if (( ${ret#*:} == -1 ))
    then
        return 1
    fi
}

lockdown() {
    trap "fatal \"$1 failed with exit code \$?\"" ERR
    (
        wd="$(pwd)"

        # no network access for builds, ro / and rw /work
        call unshare $(( CLONE_NEWNET | CLONE_NEWNS ))

        # stop mount propagation back to the parent/host namespace
        call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL

        case "$1" in
            MAKE)
                banner MAKE
                # mount pwd read-write
                call mount "$wd" "$wd" $NULL $(( MS_BIND | MS_REC )) $NULL
                ;;
            CHECK)
                banner CHECK
                mkdir -p "$root/work/test-results" "$root/work/test-work"
                call mount overlay "$wd" overlay 0 "lowerdir=$wd,upperdir=$root/work/test-results,workdir=$root/work/test-work"
                ;;
            INSTALL)
                banner INSTALL
                call mount "$wd" "$wd" $NULL $(( MS_BIND | MS_REC )) $NULL
                mkdir -p "$root/work/installed" "/sw/$pkg"
                call mount "$root/work/installed" "/sw/$pkg" $NULL $(( MS_BIND | MS_REC )) $NULL
                ;;
            *)
                fatal "unknown phase: $1"
                ;;
        esac

        # bind-mount / to itself so VFS lets us change its per-mount ro flag,
        # then remount the / bind-mount read-only
        call mount / / $NULL $(( MS_BIND )) $NULL
        call mount none / $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL

        # re-enter workdir so our cwd is on top of the writable mount, not shadowed underneath
        cd "$wd"

        "$1"
    )
    trap - ERR
}

if test $# -ne 1; then
    fatal "Usage: $0 <package>"
fi

if test ! -f $1; then
    fatal "Package not found: $1"
fi

pkg="$(basename "$1")"

declare -a ARCHIVES
declare -a archives

banner PREPARE

source $1

if test "$(type -t INSTALL)" != function
then
    fatal "no INSTALL function defined"
fi

if (( ${#ARCHIVES[@]} % 2 != 0 )); then
    fatal "Invalid number of items: ${#items[@]}"
fi

mkdir -p archives

for ((i=0; i<${#ARCHIVES[@]}; i+=2)); do
    md5="${ARCHIVES[i]}"
    url="${ARCHIVES[i+1]}"
    filename="${url##*/}"
    archives+=("$filename")
    if test -f "archives/$filename"; then
        # assume downloaded
        continue
    fi
    tmpfile="$(mktemp)"
    log -n "downloading $filename... "
    wget --quiet --output-document "$tmpfile" "$url"
    actual_md5="$(md5sum "$tmpfile" | cut -d' ' -f1)"
    if test "$actual_md5" != "$md5"; then
        rm "$tmpfile"
        fatal "checksum mismatch: $actual_md5 != $md5"
    fi
    mv "$tmpfile" "archives/$filename"
    log "done"
done

if test -d work; then
    log -n "deleting stale work area... "
    rm -rf work
    log "done"
fi

log "creating fresh work area"
mkdir work
cd work
for archive in "${archives[@]}"; do
    log -n "extracting $archive..."
    tar -xf "$root/archives/$archive"
    log "done"
done

# the first archive is special and we change to its directory
# so that the build scripts can be run from there
shopt -s extglob
cd "${archives[0]%%?(-src).tar.*}"
shopt -u extglob


if test "$(type -t MAKE)" == function
then
    lockdown MAKE
fi

if test "$(type -t CHECK)" == function
then
    lockdown CHECK
fi

lockdown INSTALL

log "cleaning up work area"
cd "$root"
rm -rf work
