VERSION=2.6.4

ARCHIVES=(
    e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995 https://github.com/westes/flex/releases/download/v$VERSION/flex-$VERSION.tar.gz
)

MAKE() {
    ./configure --prefix=/sw/flex \
        --disable-static \
        --docdir=/sw/flex/share/doc/flex-$VERSION
    make
}

CHECK() {
    make check
}

INSTALL() {
    make install
    ln -sv flex /sw/flex/bin/lex
    ln -sv flex.1 /sw/flex/share/man/man1/lex.1
}
