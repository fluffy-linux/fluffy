VERSION=8.3

ARCHIVES=(
    fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc https://ftpmirror.gnu.org/readline/readline-$VERSION.tar.gz
)

MAKE() {
    sed -i '/MV.*old/d' Makefile.in
    sed -i '/{OLDSUFF}/c:' support/shlib-install
    sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf
    sed -e '270a\
     else\
       chars_avail = 1;' \
        -e '288i\   result = -1;' \
        -i.orig input.c
    ./configure --prefix=/sw/readline \
        --disable-static \
        --with-curses \
        --docdir=/sw/readline/share/doc/readline-$VERSION
    make SHLIB_LIBS="-lncursesw"
}

INSTALL() {
    make install
    install -v -m644 doc/*.{ps,pdf,html,dvi} /sw/readline/share/doc/readline-$VERSION
}
