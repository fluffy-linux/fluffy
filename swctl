#!/sw/bash/bin/bash

# shellcheck disable=SC2154
# swctl - manage /sw mounts and manifests in Fluffy Linux

set -euo pipefail

source ctypes.sh

MNT_ITER_FORWARD=0
MNT_ITER_BACKWARD=1

CLONE_NEWNS=0x00020000
CLONE_NEWNET=0x40000000

MS_RDONLY=0x00000001
MS_REMOUNT=0x00000020
MS_BIND=0x00001000
MS_REC=0x00004000
MS_PRIVATE=0x00040000

log() {
    echo "$@" >&2
}

fatal() {
    log "$@"
    exit 1
}

call() {
    local ret
    dlcall -n ret -r int "$@"
    if (( ${ret#*:} == -1 ))
    then
        fatal "call failed: $*"
    fi
}

call_ptr() {
    local var="$1"
    shift
    dlcall -n "$var" -r pointer "$@"
    if test "${!var}" == "$NULL"
    then
        fatal "call failed: $*"
    fi
}

cleanup() {
    if test -n "${mnt_table:-}" && test "$mnt_table" != "$NULL"
    then
        dlcall mnt_free_table "$mnt_table"
    fi
}

if test $# -lt 1
then
    fatal "no arguments provided"
fi

trap cleanup EXIT

if test -d /mnt/fluffy
then
    FSTAB=${FSTAB:-/mnt/fluffy/etc/fluffy/fstab}
else
    FSTAB=${FSTAB:-/etc/fluffy/fstab}
fi

KEY_DIR="${FLUFFY_KEY_DIR:-${FSTAB%/*}/keys}"
SEC_KEY="${FLUFFY_SEC_KEY:-$KEY_DIR/release.sec}"
PUB_KEY="${FLUFFY_PUB_KEY:-$KEY_DIR/release.pub}"
SIGNIFY="$(command -v signify || command -v signify-openbsd || true)"

ensure_keys() {
    if test ! -f "$SEC_KEY"
    then
        if test -z "$SIGNIFY"
        then
            fatal "signify not found: cannot generate release keys"
        fi
        mkdir -p "${SEC_KEY%/*}"
        chmod 700 "${SEC_KEY%/*}"
        log "generating release keypair at $SEC_KEY..."
        "$SIGNIFY" -G -n -c "fluffy release key" -p "$PUB_KEY" -s "$SEC_KEY"
    fi
}

if test -f /sw/util-linux/lib/libmount.so.1
then
    dlopen /sw/util-linux/lib/libmount.so.1
elif test -f /mnt/fluffy/sw/util-linux/lib/libmount.so.1
then
    dlopen /mnt/fluffy/sw/util-linux/lib/libmount.so.1
else
    dlopen libmount.so.1
fi

call_ptr mnt_table mnt_new_table
call mnt_table_set_parser_errcb "$mnt_table" $NULL
call mnt_table_enable_comments "$mnt_table" "int:1"

if test -f "$FSTAB"
then
    call mnt_table_parse_fstab "$mnt_table" "string:$FSTAB"
fi

find_fs_by_pkg() {
    local query="$1"
    local __var="$2"
    local query_name="${query##*/}"
    local query_base="${query_name%-pass*}"

    eval "$__var=\$NULL"
    local fallback="$NULL"

    call_ptr itr mnt_new_iter "int:$MNT_ITER_FORWARD"
    call_ptr p_fs malloc "ulong:8"
    local val=(pointer:0)
    pack "$p_fs" val

    while true
    do
        dlcall -r int -n ret mnt_table_next_fs "$mnt_table" "$itr" "$p_fs"
        if test "$ret" != "int:0"
        then
            break
        fi
        unpack "$p_fs" val
        local curr_fs="${val[0]}"
        dlcall -r string -n src_str mnt_fs_get_source "$curr_fs"
        local src="${src_str#string:}"
        local filename="${src##*/}"
        local base="${filename%.squashfs}"
        local cur_pkg
        if [[ "$base" =~ ^(.*)-[0-9] ]]
        then
            cur_pkg="${BASH_REMATCH[1]}"
        else
            cur_pkg="$base"
        fi

        dlcall -r string -n tgt_str mnt_fs_get_target "$curr_fs"
        local tgt="${tgt_str#string:}"
        local tgt_pkg="${tgt##*/}"
        local cur_base="${cur_pkg%-pass*}"

        if test "$cur_pkg" == "$query_name"
        then
            eval "$__var=\$curr_fs"
            break
        fi

        if test "$fallback" == "$NULL"
        then
            if test "$tgt_pkg" == "$query_name" || test "$cur_base" == "$query_name" || test "$cur_pkg" == "$query_base"
            then
                fallback="$curr_fs"
            fi
        fi
    done

    dlcall free "$p_fs"
    dlcall mnt_free_iter "$itr"

    if eval "test \"\$$__var\" == \"\$NULL\"" && test "$fallback" != "$NULL"
    then
        eval "$__var=\$fallback"
    fi
}

register_entry() {
    local mountpoint="$1"
    local squashfs="$2"
    shift 2

    local old_ifs="$IFS"
    IFS=,
    local needs="$*"
    IFS="$old_ifs"

    local real_squashfs="$squashfs"
    if test -d /mnt/fluffy && test -f "/mnt/fluffy$squashfs"
    then
        real_squashfs="/mnt/fluffy$squashfs"
    fi

    if test ! -f "$real_squashfs"
    then
        fatal "squashfs file not found: $real_squashfs"
    fi

    ensure_keys

    if test -z "$SIGNIFY"
    then
        fatal "signify not found: cannot sign package"
    fi

    local tmp_sig
    tmp_sig="$(mktemp)"
    "$SIGNIFY" -S -s "$SEC_KEY" -m "$real_squashfs" -x "$tmp_sig"
    local pkg_sig
    {
        read -r _
        read -r pkg_sig
    } < "$tmp_sig"
    rm -f "$tmp_sig"

    local pkg_filename="${squashfs##*/}"
    local pkg_base="${pkg_filename%.squashfs}"
    local pkg_name
    if [[ "$pkg_base" =~ ^(.*)-[0-9] ]]
    then
        pkg_name="${BASH_REMATCH[1]}"
    else
        pkg_name="$pkg_base"
    fi

    # does an entry for this package already exist?
    find_fs_by_pkg "$pkg_name" mnt_fs
    if test "$mnt_fs" == "$NULL"
    then
        log "doesn't exist - creating $mountpoint ($pkg_name)"
        call_ptr mnt_fs mnt_new_fs
        if test "$mnt_fs" == "$NULL"
        then
            fatal "failed to create mnt_fs"
        fi

        # Find first entry with target > $mountpoint (or same target and cur_pkg > pkg_name) to insert alphabetically
        call_ptr itr mnt_new_iter "int:$MNT_ITER_FORWARD"
        call_ptr p_fs malloc "ulong:8"
        local val=(pointer:0)
        pack "$p_fs" val

        local pos="$NULL"
        while true
        do
            dlcall -r int -n ret mnt_table_next_fs "$mnt_table" "$itr" "$p_fs"
            if test "$ret" != "int:0"
            then
                break
            fi
            unpack "$p_fs" val
            local curr_fs="${val[0]}"
            dlcall -r string -n curr_tgt mnt_fs_get_target "$curr_fs"
            curr_tgt="${curr_tgt#string:}"

            dlcall -r string -n curr_src_str mnt_fs_get_source "$curr_fs"
            local curr_src="${curr_src_str#string:}"
            local c_filename="${curr_src##*/}"
            local c_base="${c_filename%.squashfs}"
            local c_pkg
            if [[ "$c_base" =~ ^(.*)-[0-9] ]]
            then
                c_pkg="${BASH_REMATCH[1]}"
            else
                c_pkg="$c_base"
            fi

            if [[ "$curr_tgt" > "$mountpoint" ]] || ( [[ "$curr_tgt" == "$mountpoint" ]] && [[ "$c_pkg" > "$pkg_name" ]] )
            then
                pos="$curr_fs"
                break
            fi
        done

        dlcall free "$p_fs"
        dlcall mnt_free_iter "$itr"

        if test "$pos" != "$NULL"
        then
            # In libmount, before=0 inserts before pos
            call mnt_table_insert_fs "$mnt_table" "int:0" "$pos" "$mnt_fs"
        else
            call mnt_table_add_fs "$mnt_table" "$mnt_fs"
        fi
        dlcall mnt_unref_fs "$mnt_fs" # table holds a reference to mnt_fs
    else
        log "fstab entry exists: updating $mountpoint ($pkg_name)"
    fi

    local options="X-fluffy.signature=$pkg_sig"
    if test -n "$needs"
    then
        options="$options,X-fluffy.needs=\"$needs\""
    fi

    call mnt_fs_set_source "$mnt_fs" "string:$squashfs"
    call mnt_fs_set_target "$mnt_fs" "string:$mountpoint"
    call mnt_fs_set_fstype "$mnt_fs" "string:squashfs"
    call mnt_fs_set_options "$mnt_fs" "string:$options"
}

mount_targets() {
    local prefix=""
    while test $# -gt 0
    do
        case "$1" in
            --prefix)
                prefix="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    if test $# -eq 0
    then
        fatal "no targets specified to mount"
    fi

    local -A missing_pkgs=()
    local -A state=()
    local -a order=()
    local -a call_stack=()

    dfs() {
        local target="$1"
        local pkg_name="${target##*/}"

        find_fs_by_pkg "$pkg_name" fs
        if test "$fs" == "$NULL"
        then
            missing_pkgs["$pkg_name"]=1
            return 0
        fi

        dlcall -r string -n src_str mnt_fs_get_source "$fs"
        local src="${src_str#string:}"
        local filename="${src##*/}"
        local base="${filename%.squashfs}"
        local canon_pkg
        if [[ "$base" =~ ^(.*)-[0-9] ]]
        then
            canon_pkg="${BASH_REMATCH[1]}"
        else
            canon_pkg="$base"
        fi

        local cur_state="${state[$canon_pkg]:-0}"
        if test "$cur_state" -eq 2
        then
            return 0
        fi
        if test "$cur_state" -eq 1
        then
            fatal "circular dependency detected: ${call_stack[*]} -> $canon_pkg"
        fi

        state[$canon_pkg]=1
        call_stack+=("$canon_pkg")

        dlcall -r string -n fs_opts mnt_fs_get_options "$fs"
        local opts="${fs_opts#string:}"
        local needs=""
        if [[ "$opts" =~ -?X-?fluffy\.needs=\"([^\"]*)\" || "$opts" =~ -?X-?fluffy\.needs=([^, ]*) ]]
        then
            needs="${BASH_REMATCH[1]}"
        fi

        if test -n "$needs"
        then
            local old_ifs="$IFS"
            IFS=,
            local -a sub_needs=()
            read -ra sub_needs <<< "$needs"
            IFS="$old_ifs"

            local dep
            for dep in "${sub_needs[@]}"
            do
                dfs "$dep"
            done
        fi

        call_stack=("${call_stack[@]:0:${#call_stack[@]}-1}")
        state[$canon_pkg]=2
        order+=("$canon_pkg")
    }

    local root_tgt
    for root_tgt in "$@"
    do
        dfs "$root_tgt"
    done

    if (( ${#missing_pkgs[@]} > 0 ))
    then
        local -a sorted_missing=()
        readarray -t sorted_missing < <(printf "%s\n" "${!missing_pkgs[@]}" | LC_ALL=C sort)
        local dep
        for dep in "${sorted_missing[@]}"
        do
            log "package $dep not found in $FSTAB"
        done
        exit 1
    fi

    # Check that all squashfs files exist before mounting anything
    local -A missing_files=()
    local pkg
    for pkg in "${order[@]}"
    do
        find_fs_by_pkg "$pkg" fs
        if test "$fs" == "$NULL"
        then
            continue
        fi

        dlcall -r string -n src_str mnt_fs_get_source "$fs"
        local src="${src_str#string:}"
        local real_src
        if test -n "$prefix"
        then
            real_src="$prefix$src"
        else
            real_src="$src"
        fi

        if test ! -f "$real_src"
        then
            missing_files["$real_src"]=1
        fi
    done

    if (( ${#missing_files[@]} > 0 ))
    then
        local -a sorted_missing_files=()
        readarray -t sorted_missing_files < <(printf "%s\n" "${!missing_files[@]}" | LC_ALL=C sort)
        local file
        for file in "${sorted_missing_files[@]}"
        do
            log "squashfs file not found: $file"
        done
        exit 1
    fi

    # Check for target mount conflicts across dependencies
    local -A target_owner=()
    local -A target_conflicts=()
    local pkg
    for pkg in "${order[@]}"
    do
        find_fs_by_pkg "$pkg" fs
        if test "$fs" == "$NULL"
        then
            continue
        fi

        dlcall -r string -n tgt_str mnt_fs_get_target "$fs"
        local tgt="${tgt_str#string:}"
        local real_tgt
        if test -n "$prefix"
        then
            real_tgt="$prefix$tgt"
        else
            real_tgt="$tgt"
        fi

        if test -n "${target_owner[$real_tgt]:-}" && test "${target_owner[$real_tgt]}" != "$pkg"
        then
            target_conflicts["$real_tgt"]="${target_owner[$real_tgt]} and $pkg"
        else
            target_owner["$real_tgt"]="$pkg"
        fi
    done

    if (( ${#target_conflicts[@]} > 0 ))
    then
        local -a sorted_conflicts=()
        readarray -t sorted_conflicts < <(printf "%s
" "${!target_conflicts[@]}" | LC_ALL=C sort)
        local c_tgt
        for c_tgt in "${sorted_conflicts[@]}"
        do
            log "mount conflict on $c_tgt: ${target_conflicts[$c_tgt]}"
        done
        exit 1
    fi

    # Read kernel mount table via libmount to avoid mounting already-mounted targets
    call_ptr mtab mnt_new_table
    call mnt_table_parse_mtab "$mtab" $NULL

    # Mount in topological post-order (dependencies mounted first)
    for pkg in "${order[@]}"
    do
        find_fs_by_pkg "$pkg" fs
        if test "$fs" == "$NULL"
        then
            continue
        fi

        dlcall -r string -n src_str mnt_fs_get_source "$fs"
        local src="${src_str#string:}"
        dlcall -r string -n tgt_str mnt_fs_get_target "$fs"
        local tgt="${tgt_str#string:}"
        local pkg_name="${tgt##*/}"

        local real_src
        local real_tgt
        if test -n "$prefix"
        then
            real_src="$prefix$src"
            real_tgt="$prefix$tgt"
        else
            real_src="$src"
            real_tgt="$tgt"
        fi

        if test ! -f "$real_src"
        then
            fatal "squashfs file not found: $real_src"
        fi

        # Check if target is already mounted via libmount
        local is_mnt
        dlcall -r pointer -n is_mnt mnt_table_find_target "$mtab" "string:$real_tgt" "int:0"
        if test "$is_mnt" != "$NULL"
        then
            continue
        fi

        mkdir -p "$real_tgt"

        call_ptr cxt mnt_new_context
        if test "$cxt" == "$NULL"
        then
            fatal "failed to create mount context"
        fi

        call mnt_context_set_source "$cxt" "string:$real_src"
        call mnt_context_set_target "$cxt" "string:$real_tgt"
        call mnt_context_set_fstype "$cxt" "string:squashfs"
        call mnt_context_set_options "$cxt" "string:ro,X-mount.mkdir"

        dlcall -r int -n ret mnt_context_mount "$cxt"
        if test "$ret" != "int:0"
        then
            dlcall -r int -n sys_err mnt_context_get_syscall_errno "$cxt"
            fatal "failed to mount $real_src on $real_tgt: rc=${ret#*:} errno=${sys_err#*:}"
        fi
        dlcall mnt_free_context "$cxt"
        log "mounted $real_src on $real_tgt"

        local hook=""
        if test -f "$real_tgt/bin/fluffy-upsert"
        then
            hook="$real_tgt/bin/fluffy-upsert"
        elif test -f "$real_tgt/lib/fluffy-upsert"
        then
            hook="$real_tgt/lib/fluffy-upsert"
        fi

        if test -n "$hook"
        then
            local etc_pkg="${prefix}/etc/$pkg_name"
            if test ! -d "$etc_pkg" || test "$real_src" -nt "$etc_pkg"
            then
                log "running fluffy-upsert for $pkg_name..."
                (
                    call unshare $(( CLONE_NEWNS | CLONE_NEWNET ))
                    call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL
                    if test -d /mnt/fluffy
                    then
                        call mount none /mnt/fluffy $NULL $(( MS_REC | MS_PRIVATE )) $NULL
                    fi

                    if test -n "$prefix"
                    then
                        call chroot "$prefix"
                        call chdir "/"
                    fi

                    set +h
                    shopt -s nullglob
                    export PATH=""
                    for d in /sw/*/bin
                    do
                        PATH="${PATH:+$PATH:}$d"
                    done
                    shopt -u nullglob
                    export HOME=/tmp
                    export LC_ALL=POSIX

                    mkdir -p "/etc/$pkg_name"
                    call mount "/etc/$pkg_name" "/etc/$pkg_name" $NULL $(( MS_BIND | MS_REC )) $NULL

                    call mount / / $NULL $(( MS_BIND | MS_REC )) $NULL
                    call mount none / $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL

                    call mount none "/etc/$pkg_name" $NULL $(( MS_BIND | MS_REMOUNT )) $NULL
                    call mount tmpfs /tmp tmpfs 0 $NULL

                    local hook_in_ns
                    if test -f "$tgt/bin/fluffy-upsert"
                    then
                        hook_in_ns="$tgt/bin/fluffy-upsert"
                    else
                        hook_in_ns="$tgt/lib/fluffy-upsert"
                    fi

                    "$hook_in_ns"
                )
                touch "$etc_pkg"
                log "fluffy-upsert completed for $pkg_name"
            fi
        fi
    done
    dlcall mnt_free_table "$mtab"
}

trim_deps() {
    local one_per_line=0
    while test $# -gt 0
    do
        case "$1" in
            -1|--lines)
                one_per_line=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    if test $# -eq 0
    then
        return 0
    fi

    local -a raw_args=("$@")
    local -A is_dep=()
    local -A input_canon=()
    local -A input_tgt=()
    local -A seen_input=()
    local -A visited=()

    collect_transitive() {
        local cur_pkg="$1"

        find_fs_by_pkg "$cur_pkg" fs
        if test "$fs" == "$NULL"
        then
            return 0
        fi

        dlcall -r string -n fs_opts mnt_fs_get_options "$fs"
        local opts="${fs_opts#string:}"
        local needs=""
        if [[ "$opts" =~ -?X-?fluffy\.needs=\"([^\"]*)\" || "$opts" =~ -?X-?fluffy\.needs=([^, ]*) ]]
        then
            needs="${BASH_REMATCH[1]}"
        fi

        if test -n "$needs"
        then
            local old_ifs="$IFS"
            IFS=,
            local -a sub_needs=()
            read -ra sub_needs <<< "$needs"
            IFS="$old_ifs"

            local dep
            for dep in "${sub_needs[@]}"
            do
                local dep_name="${dep##*/}"
                find_fs_by_pkg "$dep_name" dep_fs
                if test "$dep_fs" != "$NULL"
                then
                    dlcall -r string -n dep_src_str mnt_fs_get_source "$dep_fs"
                    local dep_src="${dep_src_str#string:}"
                    local dep_fn="${dep_src##*/}"
                    local dep_base="${dep_fn%.squashfs}"
                    local dep_canon
                    if [[ "$dep_base" =~ ^(.*)-[0-9] ]]
                    then
                        dep_canon="${BASH_REMATCH[1]}"
                    else
                        dep_canon="$dep_base"
                    fi

                    dlcall -r string -n dep_tgt_str mnt_fs_get_target "$dep_fs"
                    local dep_tgt="${dep_tgt_str#string:}"
                    local dep_tgt_name="${dep_tgt##*/}"
                    local dep_base_name="${dep_canon%-pass*}"

                    is_dep["$dep_canon"]=1
                    is_dep["$dep_tgt_name"]=1
                    is_dep["$dep_base_name"]=1

                    if test "${visited[$dep_canon]:-0}" -eq 0
                    then
                        visited["$dep_canon"]=1
                        collect_transitive "$dep_canon"
                    fi
                fi
            done
        fi
    }

    local arg
    for arg in "${raw_args[@]}"
    do
        local name="${arg##*/}"
        find_fs_by_pkg "$name" fs
        if test "$fs" == "$NULL"
        then
            fatal "package $arg not found in $FSTAB"
        fi

        dlcall -r string -n src_str mnt_fs_get_source "$fs"
        local src="${src_str#string:}"
        local fn="${src##*/}"
        local base="${fn%.squashfs}"
        local canon
        if [[ "$base" =~ ^(.*)-[0-9] ]]
        then
            canon="${BASH_REMATCH[1]}"
        else
            canon="$base"
        fi

        dlcall -r string -n tgt_str mnt_fs_get_target "$fs"
        local tgt="${tgt_str#string:}"
        local tgt_name="${tgt##*/}"

        input_canon["$arg"]="$canon"
        input_tgt["$arg"]="$tgt_name"

        visited=()
        collect_transitive "$canon"
    done

    local -a roots=()
    for arg in "${raw_args[@]}"
    do
        local canon="${input_canon[$arg]}"
        local tgt_name="${input_tgt[$arg]}"
        local canon_base="${canon%-pass*}"

        if test "${seen_input[$arg]:-0}" -eq 1
        then
            continue
        fi
        seen_input["$arg"]=1

        if test "${is_dep[$canon]:-0}" -eq 0 && test "${is_dep[$tgt_name]:-0}" -eq 0 && test "${is_dep[$canon_base]:-0}" -eq 0
        then
            roots+=("$arg")
        fi
    done

    if test "$one_per_line" -eq 1
    then
        local r
        for r in "${roots[@]}"
        do
            echo "$r"
        done
    else
        echo "${roots[*]}"
    fi
}

sign_and_save_fstab() {
    ensure_keys

    local tmp_content
    local tmp_sig
    tmp_content="$(mktemp)"
    tmp_sig="$(mktemp)"

    call mnt_table_set_intro_comment "$mnt_table" $NULL
    call mnt_table_replace_file "$mnt_table" "string:$tmp_content"

    "$SIGNIFY" -S -s "$SEC_KEY" -m "$tmp_content" -x "$tmp_sig"
    local fstab_sig=""
    {
        read -r _
        read -r fstab_sig
    } < "$tmp_sig"
    rm -f "$tmp_content" "$tmp_sig"

    call mnt_table_set_intro_comment "$mnt_table" "string:# fluffy.signature=$fstab_sig"$'\n'
    mkdir -p "${FSTAB%/*}"
    call mnt_table_replace_file "$mnt_table" "string:$FSTAB"
    log "fstab signed: $FSTAB"
}

unregister_entry() {
    if test $# -eq 0
    then
        fatal "no packages specified to unregister"
    fi

    while test $# -gt 0
    do
        local pkg="$1"
        shift
        local pkg_name="${pkg##*/}"

        local mnt_fs="$NULL"
        find_fs_by_pkg "$pkg_name" mnt_fs
        if test "$mnt_fs" == "$NULL"
        then
            log "warning: package $pkg not found in $FSTAB"
            continue
        fi

        dlcall -r string -n tgt_str mnt_fs_get_target "$mnt_fs"
        local tgt="${tgt_str#string:}"
        dlcall -r string -n src_str mnt_fs_get_source "$mnt_fs"
        local src="${src_str#string:}"

        dlcall -r int -n ret mnt_table_remove_fs "$mnt_table" "$mnt_fs"
        if test "$ret" != "int:0"
        then
            fatal "failed to remove $pkg from table"
        fi
        log "unregistered $pkg ($src on $tgt)"
    done
}

case "$1" in
register)
    shift
    register_entry "$@"
    sign_and_save_fstab
    ;;
unregister)
    shift
    unregister_entry "$@"
    sign_and_save_fstab
    ;;
mount)
    shift
    mount_targets "$@"
    ;;
trim|roots|reduce)
    shift
    trim_deps "$@"
    ;;
*)
    fatal "unknown command: $1"
    ;;
esac
