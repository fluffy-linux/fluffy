#!/sw/bash/bin/bash

# shellcheck disable=SC2154
# swctl - manage /sw mounts, manifests, and package builds in Fluffy Linux

set -euo pipefail
shopt -s extglob

# shellcheck disable=SC1091,SC2218
builtin source ctypes.sh

MNT_ITER_FORWARD=0

CLONE_NEWNS=0x00020000
CLONE_NEWNET=0x40000000

MS_RDONLY=0x00000001
MS_NOSUID=0x00000002
MS_NODEV=0x00000004
MS_REMOUNT=0x00000020
MS_BIND=0x00001000
MS_REC=0x00004000
MS_PRIVATE=0x00040000

MNT_DETACH=2

log() {
    echo "$@" >&2
}

# On Buildkite (BUILDKITE=true), phases log as Buildkite expects: each
# phase's output in full, under a collapsed section named after the phase
# ("--- MAKE"; the step names the package), which opens when anything
# fails ("^^^ +++"); Buildkite times sections itself, so no elapsed
# times.  Elsewhere, quietly as before: one line per package with each
# phase's time, the output in a phase log shown only when the phase fails.
bk_log=0
test "${BUILDKITE:-}" != true || bk_log=1

# bk_section NAME: on Buildkite, start section NAME unless it is the
# current one.  A step starts PREPARE before it looks its dependencies up
# and fetches them, so their lines (CACHED, VETTED) are part of PREPARE.
# The current section is exported, since swctl runs itself again to build
# a package, which must not start it a second time.
bk_current="${FLUFFY_BK_SECTION:-}"
bk_section() {
    (( bk_log )) || return 0
    test "$bk_current" != "$1" || return 0
    log "--- $1"
    bk_current="$1"
    export FLUFFY_BK_SECTION="$1"
}

# pkg_log MESSAGE: a CI step's line about its package ($pkg), "pkg: MESSAGE";
# on Buildkite just MESSAGE, since the step already names the package.
pkg_log() {
    if (( bk_log ))
    then
        log "$1"
    else
        log "$pkg: $1"
    fi
}

fatal() {
    # On Buildkite, open the section the failure is in (see bk_log).
    test "${bk_log:-0}" != 1 || log "^^^ +++"
    log "$@"
    exit 1
}

validate_pkg_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]]
    then
        fatal "invalid package name: $name"
    fi
}

resolve_in_chroot() {
    local root_dir="${1%/}" rel_path="$2" candidate
    candidate="$(realpath -m "$root_dir/${rel_path#/}")"
    if [[ "$candidate" != "$root_dir"/* ]]
    then
        fatal "chroot path escapes $root_dir: $rel_path -> $candidate"
    fi
    printf '%s' "$candidate"
}

source() {
    local src="$1"
    shift
    if [[ "$src" != /* && "$src" != ./* ]] && test -f "sw/$src"
    then
        src="sw/$src"
    fi
    if test -n "${current_eval_pkg:-}" && test "$src" != "sw/$current_eval_pkg"
    then
        if [[ ! " ${pkg_includes["$current_eval_pkg"]:-} " =~ [[:space:]]"$src"[[:space:]] ]]
        then
            pkg_includes["$current_eval_pkg"]+="$src "
        fi
    fi
    # shellcheck disable=SC1090
    builtin source "$src" "$@"
}

.() {
    # shellcheck disable=SC1090
    source "$@"
}

call() {
    local ret
    dlcall -n ret -r int "$@"
    if (( ${ret#*:} == -1 ))
    then
        fatal "call failed: $*"
    fi
}

call_ptr() {
    local var="$1"
    shift
    dlcall -n "$var" -r pointer "$@"
    if test "${!var}" == "$NULL"
    then
        fatal "call failed: $*"
    fi
}

if test $# -lt 1
then
    fatal "no arguments provided"
fi

if (( EUID != 0 ))
then
    fatal "must be run as root"
fi

cd "$(dirname "${BASH_SOURCE[0]}")"

if test -n "${FLUFFY:-}"
then
    call unshare $CLONE_NEWNS
    call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL
    call mount "$FLUFFY/sw" /sw $NULL $(( MS_BIND | MS_REC )) $NULL
    if test -d /dev/shm
    then
        call mount tmpfs /dev/shm tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
    fi
fi

if test -v CROSS
then
    if test "$CROSS" == "0"
    then
        unset CROSS
    else
        export CROSS
    fi
fi

FSTAB=${FSTAB:-/sw/.build/fstab}
check_sha256() {
    test -f "$1" && test "$(sha256sum "$1" | cut -d' ' -f1)" == "$2"
}

verify_sha256() {
    local file="$1" expected="$2" name="$3" actual
    actual="$(sha256sum "$file" | cut -d' ' -f1)"
    if test "$actual" != "$expected"
    then
        fatal "checksum mismatch for $name: $actual != $expected"
    fi
}

# An ARCHIVES URL https://<host>/<path>.git#refs/{heads,tags}/<name> is a git
# repository and the ref to fetch from it; its checksum is the object that
# ref must point at: a commit, or for an annotated tag the tag object, so the
# tag's message and signature are pinned too.  It is fetched at depth 1 into
# work/git, a bare store swctl owns as it owns work/archives, under
# refs/fluffy/<host>/<path>.git/<ref>, and never fetched again while that ref
# matches.  A branch may move on, so a stale branch ref is refetched; a tag
# never moves, so a tag ref is fetched only once.  (git's own refusal to
# clobber tags covers only refs/tags/*, not this namespace.)  A branch that
# has moved past its pin fails the build on purpose: drift is to be seen and
# the pin updated, never worked around by fetching the old commit by id.
is_git_url() {
    [[ "${1%%#*}" == *.git ]]
}

# No git command on the store starts background work: an automatic gc,
# detached after a fetch, rewrites the shallow file while the next fetch
# or archive reads it ("shallow file has changed since we read it", on
# CI's fresh store filling with openssl's submodules).  swctl owns the
# store and nothing in it needs collecting.
store_git() {
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
        git -c gc.auto=0 -c maintenance.auto=false -C "$work_dir/git" "$@"
}

fetch_git() {
    local want="$1" url="$2" repo ref local_ref got
    if [[ ! "$url" =~ ^https://[a-zA-Z0-9.-]+/[^#:]+\.git#refs/(heads|tags)/[^#]+$ ]]
    then
        fatal "invalid git URL (want https://<host>/<path>.git#refs/{heads,tags}/<name>): $url"
    fi
    if [[ ! "$want" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]
    then
        fatal "invalid object id for $url: $want"
    fi
    repo="${url%%#*}"
    ref="${url#*#}"
    local_ref="refs/fluffy/${repo#https://}/$ref"
    git check-ref-format "$local_ref" || fatal "invalid ref name: $local_ref"

    if test ! -d "$work_dir/git"
    then
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git init --quiet --bare "$work_dir/git"
    fi

    got="$(store_git rev-parse --quiet --verify "$local_ref" || true)"
    if test "$got" != "$want"
    then
        if [[ "$ref" == refs/tags/* && -n "$got" ]]
        then
            fatal "$url was fetched as $got, but the recipe pins $want: tags never move"
        fi
        store_git fetch --quiet --no-tags --depth=1 -- "$repo" "+$ref:$local_ref"
        got="$(store_git rev-parse --quiet --verify "$local_ref" || true)"
        if test "$got" != "$want"
        then
            store_git update-ref -d "$local_ref"
            fatal "$url is at $got, but the recipe pins $want"
        fi
    fi
    store_git rev-parse --quiet --verify "$want^{commit}" > /dev/null || fatal "$url: $want is not a commit or a tag of one"
    fetch_git_submodules "$repo" "$want"
}

# A repository's submodules come with it.  Each URL in its .gitmodules must
# be relative (../<name>.git), resolved against the repository's own URL as
# git resolves it, so a package's sources all stay with its fork; each
# gitlink commit, pinned by the repository's tree, is fetched at depth 1
# under refs/fluffy/<host>/<path>.git/commits/<commit>.  Only its own
# submodules, not theirs, as "git submodule update" does by default.
# Prints "<commit> <url> <path>" per submodule of REPO's COMMIT.
git_submodules() {
    local repo="$1" commit="$2" key name path mode type sub rel base url
    store_git cat-file -e "$commit:.gitmodules" 2> /dev/null || return 0
    while read -r key path
    do
        name="${key#submodule.}"
        name="${name%.path}"
        # A path naming no gitlink in the tree is skipped, as git skips it.
        # (Parsed with read, not awk: PREPARE has only cross-build's tools.)
        type="" sub=""
        read -r mode type sub _ < <(store_git ls-tree "$commit" -- "$path") || true
        test "$type" == commit || continue
        rel="$(store_git config --blob "$commit:.gitmodules" --get "submodule.$name.url")" ||
            fatal "$repo: submodule $path has no URL"
        [[ "$rel" == ../* || "$rel" == ./* ]] ||
            fatal "$repo: submodule $path has URL $rel; it must be relative, such as ../<name>.git"
        base="$repo"
        while :
        do
            case "$rel" in
                ../*) base="${base%/*}"; rel="${rel#../}" ;;
                ./*) rel="${rel#./}" ;;
                *) break ;;
            esac
        done
        url="$base/$rel"
        [[ "$url" =~ ^https://[a-zA-Z0-9.-]+/[^#:]+\.git$ ]] ||
            fatal "$repo: submodule $path resolves to $url, not https://<host>/<path>.git"
        echo "$sub $url $path"
    done < <(store_git config --blob "$commit:.gitmodules" --get-regexp '^submodule\..*\.path$' || true)
}

fetch_git_submodules() {
    local list sub url path local_ref
    list="$(git_submodules "$1" "$2")"
    while read -r sub url path
    do
        test -n "$sub" || continue
        local_ref="refs/fluffy/${url#https://}/commits/$sub"
        git check-ref-format "$local_ref" || fatal "invalid ref name: $local_ref"
        if ! store_git rev-parse --quiet --verify "$local_ref" > /dev/null
        then
            store_git fetch --quiet --no-tags --depth=1 -- "$url" "+$sub:$local_ref"
        fi
        test "$(store_git rev-parse --quiet --verify "$local_ref^{commit}")" == "$sub" ||
            fatal "$url: could not fetch $sub for $1's $path"
    done <<< "$list"
}

# Extracts REPO's COMMIT, with its submodules, into the directory DIR.
extract_git() {
    local repo="$1" commit="$2" dir="$3" list sub url path
    store_git archive --format=tar "$commit" |
        tar --no-same-owner --no-same-permissions -C "$dir" -xf -
    list="$(git_submodules "$repo" "$commit")"
    while read -r sub url path
    do
        test -n "$sub" || continue
        mkdir -p "$dir/$path"
        store_git archive --format=tar "$sub" |
            tar --no-same-owner --no-same-permissions -C "$dir/$path" -xf -
    done <<< "$list"
}

# Writes REPO's COMMIT, with its submodules, as the tar file TAR holding
# PREFIX/.
tar_git() {
    local repo="$1" commit="$2" tar="$3" prefix="$4" list sub url path
    store_git archive --format=tar --prefix="$prefix/" "$commit" > "$tar"
    list="$(git_submodules "$repo" "$commit")"
    while read -r sub url path
    do
        test -n "$sub" || continue
        store_git archive --format=tar --prefix="$prefix/$path/" "$sub" > "$tar.sub"
        tar --concatenate --file="$tar" "$tar.sub"
        rm -f "$tar.sub"
    done <<< "$list"
}

bring_up_lo() {
    local ptr ptr16 sock fd
    local -a arr=(short)

    dlcall -r pointer -n ptr malloc 40
    dlcall memset "$ptr" int:0 ulong:40
    dlcall strcpy "$ptr" string:lo
    dlcall -r int -n sock socket int:2 int:2 int:0
    fd="${sock#*:}"
    if (( fd != -1 ))
    then
        call ioctl int:$fd ulong:35091 "$ptr"
        printf -v ptr16 "pointer:0x%x" $(( ${ptr#*:} + 16 ))
        unpack "$ptr16" arr
        arr=(short:$(( ${arr[0]#*:} | 1 )))
        pack "$ptr16" arr
        call ioctl int:$fd ulong:35092 "$ptr"
        call close int:$fd
    fi
    dlcall free "$ptr"
}

mount_chroot_resolv_conf() {
    local chroot_etc="$FLUFFY/run/.chroot-etc"
    rm -rf "$chroot_etc"
    mkdir -p "$chroot_etc"
    if test -d "$FLUFFY/etc"
    then
        cp -a "$FLUFFY/etc/." "$chroot_etc/"
    fi

    if test -n "${SUDO_UID:-}" && test -n "${SUDO_GID:-}"
    then
        touch "$chroot_etc/passwd" "$chroot_etc/group"
        grep -q '^root:' "$chroot_etc/passwd" || printf 'root:x:0:0:root:/root:/sw/bash/bin/bash\n' >> "$chroot_etc/passwd"
        grep -q '^nobody:' "$chroot_etc/passwd" || printf 'nobody:*:65534:65534:Unprivileged User:/dev/null:/sw/coreutils/bin/false\n' >> "$chroot_etc/passwd"
        if ! awk -F: -v u="$SUDO_UID" '$3 == u { found=1 } END { exit !found }' "$chroot_etc/passwd"
        then
            printf 'builder:*:%s:%s:Builder:/tmp:/sw/bash/bin/bash\n' "$SUDO_UID" "$SUDO_GID" >> "$chroot_etc/passwd"
        fi

        grep -q '^root:' "$chroot_etc/group" || printf 'root:x:0:\n' >> "$chroot_etc/group"
        grep -q '^tty:' "$chroot_etc/group" || printf 'tty:x:5:\n' >> "$chroot_etc/group"
        grep -q '^nogroup:' "$chroot_etc/group" || printf 'nogroup:x:65534:\n' >> "$chroot_etc/group"
        if ! awk -F: -v g="$SUDO_GID" '$3 == g { found=1 } END { exit !found }' "$chroot_etc/group"
        then
            printf 'builder:x:%s:\n' "$SUDO_GID" >> "$chroot_etc/group"
        fi
    fi

    if test -f /etc/resolv.conf
    then
        mkdir -p "$FLUFFY/run/systemd/resolve"
        touch "$FLUFFY/run/systemd/resolve/stub-resolv.conf"
        call mount /etc/resolv.conf "$FLUFFY/run/systemd/resolve/stub-resolv.conf" $NULL $MS_BIND $NULL

        if test ! -L "$chroot_etc/resolv.conf" && test ! -s "$chroot_etc/resolv.conf"
        then
            ln -snf ../run/systemd/resolve/stub-resolv.conf "$chroot_etc/resolv.conf"
        fi
    fi

    call mount "$chroot_etc" "$FLUFFY/etc" $NULL $(( MS_BIND | MS_REC )) $NULL

    if test -f /etc/resolv.conf
    then
        if test -L "$FLUFFY/etc/resolv.conf"
        then
            local resolv_tgt rel_path resolv_dst
            resolv_tgt="$(readlink "$FLUFFY/etc/resolv.conf")"
            if [[ "$resolv_tgt" == /* ]]
            then
                rel_path="$resolv_tgt"
            else
                rel_path="/etc/$resolv_tgt"
            fi
            resolv_dst="$(resolve_in_chroot "$FLUFFY" "$rel_path")"
            if test "$resolv_dst" != "$FLUFFY/run/systemd/resolve/stub-resolv.conf"
            then
                if test -L "$resolv_dst"
                then
                    fatal "refusing to follow nested symlink for resolv.conf target: $resolv_dst"
                fi
                mkdir -p "${resolv_dst%/*}"
                touch "$resolv_dst"
                call mount /etc/resolv.conf "$resolv_dst" $NULL $MS_BIND $NULL
            fi
        else
            call mount /etc/resolv.conf "$FLUFFY/etc/resolv.conf" $NULL $MS_BIND $NULL
        fi
    fi
}

mount_chroot_shm() {
    local chroot_shm="$FLUFFY/dev/shm"
    if test -L "$chroot_shm"
    then
        local shm_tgt rel_shm
        shm_tgt="$(readlink "$chroot_shm")"
        if [[ "$shm_tgt" == /* ]]
        then
            rel_shm="$shm_tgt"
        else
            rel_shm="/dev/$shm_tgt"
        fi
        chroot_shm="$(resolve_in_chroot "$FLUFFY" "$rel_shm")"
    fi
    mkdir -p "$chroot_shm"
    if test -d /dev/shm
    then
        call mount /dev/shm "$chroot_shm" $NULL $MS_BIND $NULL
    else
        call mount tmpfs "$chroot_shm" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
    fi
}

if test -f /sw/util-linux/lib/libmount.so.1
then
    dlopen /sw/util-linux/lib/libmount.so.1
else
    dlopen libmount.so.1
fi

mnt_table="$NULL"

reload_fstab() {
    if test -n "${mnt_table:-}" && test "$mnt_table" != "$NULL"
    then
        dlcall mnt_free_table "$mnt_table"
    fi
    call_ptr mnt_table mnt_new_table
    call mnt_table_set_parser_errcb "$mnt_table" $NULL
    call mnt_table_enable_comments "$mnt_table" "int:1"

    if test -f "$FSTAB"
    then
        call mnt_table_parse_fstab "$mnt_table" "string:$FSTAB"
    fi
}

reload_fstab

fs_str() {
    local __fs="$1" __field="$2"
    local -n __fs_out="$3"
    local __s
    dlcall -r string -n __s "mnt_fs_get_$__field" "$__fs"
    __fs_out="${__s#string:}"
}

get_fs_opt() {
    local __fs="$1" __key="$2"
    local -n __opt_out="$3"
    __opt_out=""
    local __opts="" __val=""
    fs_str "$__fs" options __opts
    __opts=",$__opts,"
    if [[ "$__opts" == *,"$__key=\""* ]]
    then
        __val="${__opts#*,"$__key=\""}"
        __val="${__val%%\"*}"
        __opt_out="$__val"
        return 0
    elif [[ "$__opts" == *,"$__key="* ]]
    then
        __val="${__opts#*,"$__key="}"
        __val="${__val%%,*}"
        __opt_out="$__val"
        return 0
    fi
    return 1
}

src_matches_pkg() {
    local __src="$1" __pkg="$2"
    [[ "$__src" == "/sw/$__pkg-"[0-9]*.squashfs ]] || return 1
    local __ver="${__src#"/sw/$__pkg-"}"
    __ver="${__ver%.squashfs}"
    [[ "$__ver" =~ ^[0-9][^-]*(-fluffy[0-9]+)?$ ]]
}

find_fs_by_pkg() {
    local __query="$1"
    local -n __find_out="$2"
    local __exact="${3:-0}"
    local __query_name="${__query##*/}"
    local __query_base="${__query_name%-pass*}"

    __find_out="$NULL"
    local __fallback="$NULL"

    call_ptr itr mnt_new_iter "int:$MNT_ITER_FORWARD"
    call_ptr p_fs malloc "ulong:8"
    local val=(pointer:0)
    pack "$p_fs" val

    while true
    do
        dlcall -r int -n ret mnt_table_next_fs "$mnt_table" "$itr" "$p_fs"
        if test "$ret" != "int:0"
        then
            break
        fi
        unpack "$p_fs" val
        local curr_fs="${val[0]}" src
        fs_str "$curr_fs" source src

        if src_matches_pkg "$src" "$__query_name"
        then
            __find_out="$curr_fs"
            break
        fi

        if test "$__exact" -eq 0 && test "$__fallback" == "$NULL"
        then
            local tgt
            fs_str "$curr_fs" target tgt
            if test "$tgt" == "/sw/$__query_base" || src_matches_pkg "$src" "$__query_base"
            then
                __fallback="$curr_fs"
            fi
        fi
    done

    dlcall free "$p_fs"
    dlcall mnt_free_iter "$itr"

    if test "$__find_out" == "$NULL" && test "$__fallback" != "$NULL"
    then
        __find_out="$__fallback"
    fi
}


register_entry() {
    local squashfs="$1"
    local pkg_filename="${squashfs##*/}"
    local mountpoint="/sw/$mount_pkg"
    local recipe_checksum="${FLUFFY_RECIPE_CHECKSUM}"
    local needs=""

    if (( ${#NEEDS[@]} > 0 ))
    then
        local old_ifs="$IFS"
        IFS=,
        needs="${NEEDS[*]}"
        IFS="$old_ifs"
    fi

    local mnt_fs="$NULL" old_src="" old_img_chk="" img_chk=""
    find_fs_by_pkg "$pkg" mnt_fs 1
    if test "$mnt_fs" != "$NULL"
    then
        fs_str "$mnt_fs" source old_src
        get_fs_opt "$mnt_fs" "X-fluffy.image-checksum" old_img_chk || true
    fi

    img_chk="$(sha256sum "$squashfs.new" | cut -d' ' -f1)"
    if test -n "$old_src" && test -f "$old_src" && test "$img_chk" == "$old_img_chk"
    then
        if test "$old_src" == "$squashfs"
        then
            rm -f "$squashfs.new"
        else
            mv -f "$squashfs.new" "$squashfs"
            rm -f "$old_src"
        fi
    else
        mv -f "$squashfs.new" "$squashfs"
        if test -n "$old_src" && test "$old_src" != "$squashfs"
        then
            rm -f "$old_src"
        fi
    fi

    if test "$mnt_fs" == "$NULL"
    then
        call_ptr mnt_fs mnt_new_fs
        call mnt_table_add_fs "$mnt_table" "$mnt_fs"
        dlcall mnt_unref_fs "$mnt_fs"
    fi

    local options="X-fluffy.image-checksum=$img_chk"
    if test -n "$needs"
    then
        options="$options,X-fluffy.needs=\"$needs\""
    fi
    options="$options,X-fluffy.recipe-checksum=$recipe_checksum"

    call mnt_fs_set_source "$mnt_fs" "string:/sw/$pkg_filename"
    call mnt_fs_set_target "$mnt_fs" "string:$mountpoint"
    call mnt_fs_set_fstype "$mnt_fs" "string:squashfs"
    call mnt_fs_set_options "$mnt_fs" "string:$options"
}

save_fstab() {
    mkdir -p "${FSTAB%/*}"
    # An fstab from before signing was removed starts with a
    # "# fluffy.signature=" line, which libmount keeps as the intro comment.
    call mnt_table_set_intro_comment "$mnt_table" $NULL
    call mnt_table_replace_file "$mnt_table" "string:$FSTAB"
    chmod 0644 "$FSTAB"
}

dfs() {
    local step_fn="$1"
    shift
    local -A state=()
    local -a call_stack=()
    order=()

    dfs_visit() {
        local raw_node="${1##*/}"
        case "${state[$raw_node]:-0}" in
            2) return 0 ;;
            1) fatal "circular dependency detected: ${call_stack[*]} -> $raw_node" ;;
        esac

        local node_id="$raw_node"
        local -a step_deps=()
        "$step_fn" "$raw_node"

        case "${state[$node_id]:-0}" in
            2) state["$raw_node"]=2; return 0 ;;
            1) fatal "circular dependency detected: ${call_stack[*]} -> $raw_node" ;;
        esac

        state["$raw_node"]=1
        state["$node_id"]=1
        call_stack+=("$raw_node")

        local dep
        for dep in "${step_deps[@]}"
        do
            dfs_visit "$dep"
        done

        call_stack=("${call_stack[@]:0:${#call_stack[@]}-1}")
        state["$raw_node"]=2
        state["$node_id"]=2
        order+=("$node_id")
    }

    local root_node
    for root_node in "$@"
    do
        dfs_visit "$root_node"
    done
}

install_targets() {
    if test $# -eq 0
    then
        fatal "no targets specified to install"
    fi

    local -a order=()

    install_step() {
        local pkg_name="$1" fs="$NULL" src needs_str=""
        validate_pkg_name "$pkg_name"

        find_fs_by_pkg "$pkg_name" fs
        if test "$fs" == "$NULL"
        then
            fatal "package $pkg_name not found in $FSTAB"
        fi

        fs_str "$fs" source src
        if test ! -f "$src"
        then
            fatal "squashfs file not found: $src"
        fi

        node_id="$fs"
        if get_fs_opt "$fs" "X-fluffy.needs" needs_str && test -n "$needs_str"
        then
            local old_ifs="$IFS"
            IFS=,
            read -ra step_deps <<< "$needs_str"
            IFS="$old_ifs"
        fi
    }

    dfs install_step "$@"

    local -A target_fs=() target_is_final=() mounted_tgt=()
    local fs tgt src
    for fs in "${order[@]}"
    do
        fs_str "$fs" target tgt
        fs_str "$fs" source src
        if [[ "$src" != *-pass*.squashfs ]]
        then
            target_fs["$tgt"]="$fs"
            target_is_final["$tgt"]=1
        elif test -z "${target_is_final[$tgt]:-}"
        then
            target_fs["$tgt"]="$fs"
        fi
    done

    call_ptr mtab mnt_new_table
    call mnt_table_parse_mtab "$mtab" $NULL

    for fs in "${order[@]}"
    do
        fs_str "$fs" target tgt
        if test "${target_fs[$tgt]}" != "$fs" || test -n "${mounted_tgt[$tgt]:-}"
        then
            continue
        fi
        mounted_tgt["$tgt"]=1
        fs_str "$fs" source src

        local is_mnt
        dlcall -r pointer -n is_mnt mnt_table_find_target "$mtab" "string:$tgt" "int:0"
        if test "$is_mnt" != "$NULL"
        then
            local mnt_src
            fs_str "$is_mnt" source mnt_src
            local backing_file="/sys/class/block/${mnt_src##*/}/loop/backing_file"
            if test -r "$backing_file" && [[ "$(< "$backing_file")" == *"/sw/${src##*/}" || "$(< "$backing_file")" == "$src" ]]
            then
                continue
            fi
        fi

        # X-mount.mkdir makes $tgt: no external mkdir, which a phase whose
        # /sw holds only its BUILD_NEEDS may not have.
        call_ptr cxt mnt_new_context
        call mnt_context_set_source "$cxt" "string:$src"
        call mnt_context_set_target "$cxt" "string:$tgt"
        call mnt_context_set_fstype "$cxt" "string:squashfs"
        call mnt_context_set_options "$cxt" "string:ro,X-mount.mkdir"

        dlcall -r int -n ret mnt_context_mount "$cxt"
        if test "$ret" != "int:0"
        then
            dlcall -r int -n sys_err mnt_context_get_syscall_errno "$cxt"
            # Show what is already at $tgt: libmount refuses (-EBUSY) to mount
            # an image again where it is already mounted, even under another.
            local mi_line mi_dev mi_bf
            local -a mi_fields
            log "mounts at $tgt:"
            while read -r mi_line
            do
                read -ra mi_fields <<< "$mi_line"
                test "${mi_fields[4]}" == "$tgt" || continue
                mi_dev="${mi_line##* - }"
                read -ra mi_fields <<< "$mi_dev"
                mi_dev="${mi_fields[1]}"
                mi_bf="/sys/class/block/${mi_dev##*/}/loop/backing_file"
                if test -r "$mi_bf"
                then
                    log "  $mi_dev ($(< "$mi_bf"))"
                else
                    log "  $mi_dev (no readable $mi_bf)"
                fi
            done < /proc/self/mountinfo
            fatal "failed to mount $src on $tgt: rc=${ret#*:} errno=${sys_err#*:}"
        fi
        dlcall mnt_free_context "$cxt"
        log "mounted $src on $tgt"
    done
    dlcall mnt_free_table "$mtab"
}

report_phase_err() {
    local rc=$?
    # On Buildkite the output is in the phase's section already, which
    # fatal opens.
    if (( ! bk_log ))
    then
        log ""
        cat "$phase_log" >&2 || true
    fi
    # CHECK's overlay leaves its workdir's "work" directory owned by root
    # with mode 000.  A successful build removes it; after a failure it
    # would stay in the checkout, and on a CI agent the next job's checkout
    # (run as the agent's user) could not clean it and fail before
    # starting.  test-results stays, for looking at the failure.
    if test -n "${work_dir:-}" && test -d "$work_dir/test-work"
    then
        (
            call setresuid 0 0 0
            call setresgid 0 0 0
            rm -rf "$work_dir/test-work"
        ) || true
    fi
    fatal "$phase_name ($pkg) failed with exit code $rc"
}

format_elapsed() {
    local total=$1 h m s out=""
    (( h = total / 3600 )) || true
    (( m = (total % 3600) / 60 )) || true
    (( s = total % 60 )) || true
    (( h > 0 )) && out+="${h}h"
    (( m > 0 )) && out+="${m}m"
    if (( s > 0 )) || test -z "$out"
    then
        out+="${s}s"
    fi
    printf '%s' "$out"
}

run_phase() {
    local phase_name="$1" start_sec=$SECONDS elapsed
    shift
    if (( bk_log ))
    then
        bk_section "$phase_name"
        trap report_phase_err ERR
        (
            "$@"
        ) >&2 2>&1
        trap - ERR
        return 0
    fi
    log -n " $phase_name"
    trap report_phase_err ERR
    (
        "$@"
    ) > "$phase_log" 2>&1
    trap - ERR
    elapsed="$(format_elapsed $(( SECONDS - start_sec )))"
    log -n "($elapsed)"
}

# apply_patch FILE: apply FILE (any patch, such as git format-patch output)
# with patch -Np1 in the current directory, then give every file that was
# already there its old mtime back.  Patching then never makes a source look
# newer than what make generates from it (configure.ac than configure, say),
# without timestamps in the patch.  New files keep the time of patching.
# Recipes call it from their phases.
apply_patch() {
    local -A stamps
    local mtime path marker
    while IFS=$'\t' read -r -d '' mtime path
    do
        stamps["$path"]="$mtime"
    done < <(find . -type f -printf '%T@\t%p\0')
    marker="$(mktemp)"
    patch -Np1 -i "$1"
    while IFS= read -r -d '' path
    do
        if test -n "${stamps[$path]+set}"
        then
            touch -d "@${stamps[$path]}" -- "$path"
        fi
    done < <(find . -type f -newer "$marker" -print0)
    rm -f -- "$marker"
}

# A build phase (MAKE, CHECK, INSTALL) sees only its BUILD_NEEDS under /sw,
# not swctl's own tools (ON's packages, mounted for PREPARE and SQUASHFS and
# by the chroot's setup).  clear_sw unmounts every package under /sw except
# /sw/.build, deepest last-mounted first, lazily: swctl's own bash, ctypes.sh
# and libffi stay mapped in this process.  Nothing after it may run an
# external command the phase's BUILD_NEEDS might not provide.
clear_sw() {
    local line
    local -a fields mps=()
    while read -r line
    do
        read -ra fields <<< "$line"
        case "${fields[4]}" in
            /sw/.build|/sw/.build/*) ;;
            /sw/*) mps+=("${fields[4]}") ;;
        esac
    done < /proc/self/mountinfo
    local i
    for (( i = ${#mps[@]} - 1; i >= 0; i-- ))
    do
        call umount2 "string:${mps[i]}" "int:$MNT_DETACH"
    done
}

# mkdir -p through the C library, for after clear_sw.
make_dirs() {
    local path="" part
    local -a parts
    IFS=/ read -ra parts <<< "${1#/}"
    for part in "${parts[@]}"
    do
        path="$path/$part"
        test -d "$path" || call mkdir "string:$path" "int:493"
    done
}

lockdown_exec() {
    (
        wd="$(pwd)"
        # A phase sees $work_dir/src at /work: the source directory, and
        # beside it ARCHIVES[1..N], which recipes use as ../<file>.
        local src_root="$work_dir/src" sub=""
        if test "$1" != SQUASHFS
        then
            case "$wd" in
                "$src_root") ;;
                "$src_root"/*) sub="${wd#"$src_root"}" ;;
                *) fatal "phase $1 starts outside $src_root: $wd" ;;
            esac
        fi

        case "$1" in
            CHECK)
                mkdir -p "$work_dir/test-results" "$work_dir/test-work"
                ;;
            INSTALL)
                mkdir -p "$work_dir/installed"
                ;;
        esac

        call setresuid 0 0 0
        call setresgid 0 0 0

        call unshare $(( CLONE_NEWNET | CLONE_NEWNS ))
        bring_up_lo

        call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL

        # Every phase, SQUASHFS too, starts from an empty /sw and mounts
        # exactly its own toolset: what it would inherit from the outer
        # namespace can't be recognised reliably (a loop device's backing
        # file reads /<image> when it was set up through a mount this
        # namespace can't see), and mounting an image again where it is
        # already mounted fails with -EBUSY.
        local nproc_val
        nproc_val="$(nproc)"
        clear_sw

        if test "$ON" == host-build
        then
            mkdir -p /sw/bash/bin
            touch /sw/bash/bin/bash
            call mount /bin/bash /sw/bash/bin/bash $NULL $MS_BIND $NULL
        fi

        # SQUASHFS is swctl's own work, with its own tools; a build phase gets
        # exactly its BUILD_NEEDS.
        local -a mount_targets=()
        if test "$1" == SQUASHFS
        then
            if test "$ON" != host-build
            then
                mount_targets+=("$ON")
            fi
        else
            mount_targets+=("${BUILD_NEEDS[@]}")
        fi

        if (( ${#mount_targets[@]} > 0 ))
        then
            install_targets "${mount_targets[@]}"
        fi

        call mount /sw /sw $NULL $(( MS_BIND | MS_REC )) $NULL

        # Hide /sw/.build (keys, fstab) behind an ephemeral tmpfs in all unprivileged phases.
        if test "$1" != SQUASHFS && test -d /sw/.build
        then
            if test "$1" == INSTALL
            then
                call mount tmpfs /sw/.build tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=0755"
            else
                call mount tmpfs /sw/.build tmpfs $(( MS_NOSUID | MS_NODEV | MS_RDONLY )) "mode=0555"
            fi
        fi

        # /work is $work_dir/src, read-only, with only the source directory
        # writable (MAKE, INSTALL) or overlaid (CHECK).  Without an extracted
        # source directory, /work itself is the phase's directory.
        mount_work() {
            local dir=/work
            if test -n "$sub"
            then
                call mount "$src_root" /work $NULL $(( MS_BIND | MS_REC )) $NULL
                call mount none /work $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL
                dir="/work$sub"
            fi
            if test "$1" == CHECK
            then
                # A deferred check's lower layer is the tree's squashfs, on
                # another filesystem than the upper layer, and then only
                # xino makes inode numbers agree: without it, readdir's
                # d_ino and stat's st_ino differ for a new entry in a merged
                # directory (glibc's posix/tst-dir matches by them).  Inline,
                # both layers are on one filesystem and need nothing.
                local xino=""
                test "${ci_mode:-}" != check || xino=",xino=on"
                call mount overlay "$dir" overlay 0 "lowerdir=$wd,upperdir=$work_dir/test-results,workdir=$work_dir/test-work$xino"
            else
                call mount "$wd" "$dir" $NULL $(( MS_BIND | MS_REC )) $NULL
            fi
        }

        case "$1" in
            MAKE|CHECK)
                mount_work "$1"
                ;;
            INSTALL)
                make_dirs "/sw/.build/destdir/sw/$mount_pkg"
                call mount "$work_dir/installed" "/sw/.build/destdir/sw/$mount_pkg" $NULL $(( MS_BIND | MS_REC )) $NULL
                if test -d /sw/.build
                then
                    call mount none /sw/.build $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL
                fi
                mount_work "$1"
                ;;
            SQUASHFS)
                ;;
            *)
                fatal "unknown phase: $1"
                ;;
        esac

        if test "$1" != SQUASHFS
        then
            call mount none /sw $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL
        fi

        call mount / / $NULL $(( MS_BIND | MS_REC )) $NULL
        call chroot /..
        call chdir "$wd"
        call mount none / $NULL $(( MS_BIND | MS_REMOUNT | MS_RDONLY )) $NULL

        if test "$1" == SQUASHFS
        then
            call mount none /sw $NULL $(( MS_BIND | MS_REMOUNT )) $NULL
        fi

        call mount tmpfs /tmp tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
        if test -d /var/tmp
        then
            call mount tmpfs /var/tmp tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
        fi

        if test "$1" != SQUASHFS
        then
            cd "/work$sub"
            call setgroups 0 $NULL
            call setresgid "$SUDO_GID" "$SUDO_GID" "$SUDO_GID"
            call setresuid "$SUDO_UID" "$SUDO_UID" "$SUDO_UID"
        fi

        set +h
        umask 022

        local saved_term="${TERM:-dumb}" saved_fluffy="${FLUFFY:-}"

        for var in $(compgen -e)
        do
            if [[ "$var" != @(PWD|SHLVL|_) ]]
            then
                unset "$var"
            fi
        done

        export HOME=/tmp TERM="$saved_term" LC_ALL=POSIX TZ=UTC0 SOURCE_DATE_EPOCH=0 MAKEFLAGS="-j$nproc_val" TESTSUITEFLAGS="-j$nproc_val"
        if test "$ON" != host-build
        then
            export MAKEFLAGS="$MAKEFLAGS SHELL=/sw/bash/bin/bash"
            export PATH='/sw/*/bin' SHELL=/sw/bash/bin/bash CONFIG_SHELL=/sw/bash/bin/bash
        else
            export PATH=/usr/bin
            if test ! -L /bin
            then
                export PATH="/bin:$PATH"
            fi
            shopt -s nullglob
            for d in /sw/*/bin
            do
                export PATH="$d:$PATH"
            done
            shopt -u nullglob
            local fluffy_tgt
            fluffy_tgt="$(uname -m)-fluffy-linux-gnu"
            export FLUFFY="$saved_fluffy" FLUFFY_TGT="$fluffy_tgt" CONFIG_SITE=/dev/null
        fi

        if test "$1" == INSTALL
        then
            export DESTDIR=/sw/.build/destdir MAKEFLAGS="$MAKEFLAGS DESTDIR=/sw/.build/destdir" PATH="/sw/.build/destdir/sw/$mount_pkg/bin:$PATH"
        fi


        "$1"
    )
}

lockdown() {
    if test "$(type -t "$1")" != function
    then
        return 0
    fi
    run_phase "$1" lockdown_exec "$1"
}

build_single_pkg() {
    local pkg="${1##*/}"
    validate_pkg_name "$pkg"
    local pkg_file="sw/$pkg"

    if test ! -f "$pkg_file"
    then
        fatal "Package not found: $pkg"
    fi

    (
        root="$PWD"
        work_dir="$root/work"
        phase_log="$work_dir/phase.log"
        rm -f "$phase_log"
        tree_file=/sw/.build/tree.squashfs

        # Temporarily drop euid to SUDO_UID while keeping saved-uid=0 only for
        # outer orchestration; PREPARE drops saved-uid=0 permanently in its own subshell.
        call setgroups 0 $NULL
        call setresgid "$SUDO_GID" "$SUDO_GID" 0
        call setresuid "$SUDO_UID" "$SUDO_UID" 0

        mount_pkg="${pkg%-pass*}"

        unset -f MAKE CHECK INSTALL
        unset VERSION
        declare -ga ARCHIVES=() archives=() NEEDS=() BUILD_NEEDS=()

        SQUASHFS() {
            rm -f "$squashfs_file.new"
            mksquashfs "$work_dir/installed" "$squashfs_file.new" -all-root -comp zstd -quiet -no-progress
        }

        if test -v CROSS
        then
            ON=cross-build
        else
            ON=fluffy-build
        fi
        # shellcheck disable=SC1090
        source "$pkg_file"

        if test -z "${VERSION:-}"
        then
            fatal "no VERSION defined in $pkg"
        fi

        if (( ${#ARCHIVES[@]} % 2 != 0 ))
        then
            fatal "Invalid number of items in ARCHIVES for $pkg: ${#ARCHIVES[@]}"
        fi

        case "$ON" in
            host-build)
                if test -z "${FLUFFY:-}"
                then
                    fatal "cannot build ON=host-build natively (FLUFFY is not set)"
                fi
                ;;
            cross-build|fluffy-build)
                ;;
            *)
                fatal "Invalid ON target: $ON"
                ;;
        esac

        if test "$ON" != host-build && test -n "${FLUFFY:-}"
        then
            mkdir -p "$work_dir/archives"
            (
                call setresuid 0 0 0
                call setresgid 0 0 0

                call unshare $CLONE_NEWNS
                call mount none / $NULL $(( MS_REC | MS_PRIVATE )) $NULL

                mkdir -p "$FLUFFY"/{dev/pts,proc,sys,run,dev/shm,etc,tmp,var/tmp,"$root"}
                call mount /dev "$FLUFFY/dev" $NULL $MS_BIND $NULL
                call mount /dev/pts "$FLUFFY/dev/pts" $NULL $MS_BIND $NULL
                call mount proc "$FLUFFY/proc" proc 0 $NULL
                call mount sysfs "$FLUFFY/sys" sysfs 0 $NULL
                call mount tmpfs "$FLUFFY/run" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=0755"
                call mount tmpfs "$FLUFFY/tmp" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
                call mount tmpfs "$FLUFFY/var/tmp" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
                mount_chroot_shm
                mount_chroot_resolv_conf

                call mount "$root" "$FLUFFY$root" $NULL $MS_BIND $NULL

                if ! install_targets "$ON" > "$phase_log" 2>&1
                then
                    cat "$phase_log" >&2 || true
                    rm -f "$phase_log"
                    fatal "chroot mount setup ($pkg) failed"
                fi
                rm -f "$phase_log"

                call mount /sw "$FLUFFY/sw" $NULL $(( MS_BIND | MS_REC )) $NULL
                call chroot "$FLUFFY"
                call chdir "$root"

                unset FLUFFY
                export PATH='/sw/*/bin' FLUFFY_BUILD_SINGLE=1
                local -a cmd=(build)
                case "$ci_mode" in
                    defer) cmd=(build --defer-check) ;;
                    check) cmd=(check) ;;
                esac
                /sw/bash/bin/bash "$root/swctl" "${cmd[@]}" "$pkg"
            )
            exit 0
        fi

        mkdir -p "$work_dir/archives"

        # A git repository is placed as <repo>.tar, from its URL's last part.
        for ((i=0; i<${#ARCHIVES[@]}; i+=2))
        do
            url="${ARCHIVES[i+1]}"
            if is_git_url "$url"
            then
                url="${url%%#*}"
                url="${url##*/}"
                archives+=("${url%.git}.tar")
            else
                archives+=("${url##*/}")
            fi
        done

        # ARCHIVES[0] becomes the source directory if it is a tarball or a
        # git repository.
        src_unpacked=0
        if (( ${#ARCHIVES[@]} > 0 )) && { is_git_url "${ARCHIVES[1]}" || [[ "${archives[0]}" == *.tar.* ]]; }
        then
            src_unpacked=1
        fi

        # The package's line, which its phases continue; on Buildkite each
        # phase gets its own section instead (run_phase).
        (( bk_log )) || log -n "$pkg${FLUFFY_PROGRESS:+ $FLUFFY_PROGRESS}:"

        # `swctl check` (CI): no sources and no build; the tree a deferred
        # build left after MAKE, fetched by the outer swctl, is mounted where
        # PREPARE would have unpacked the sources, so CHECK's overlay has it
        # as its lower layer, read-only, and its upper layer starts empty.
        if test "$ci_mode" == check
        then
            tree_mount_exec() {
                call setresuid 0 0 0
                call setresgid 0 0 0
                rm -rf "$work_dir"/{src,installed,test-results,test-work}
                mkdir -p "$work_dir/src"
                call_ptr cxt mnt_new_context
                call mnt_context_set_source "$cxt" "string:$tree_file"
                call mnt_context_set_target "$cxt" "string:$work_dir/src"
                call mnt_context_set_fstype "$cxt" "string:squashfs"
                call mnt_context_set_options "$cxt" "string:ro,nodev,nosuid"
                dlcall -r int -n ret mnt_context_mount "$cxt"
                test "$ret" == "int:0" || fatal "failed to mount $tree_file on $work_dir/src: rc=${ret#*:}"
                dlcall mnt_free_context "$cxt"
            }
            run_phase TREE tree_mount_exec
            if (( src_unpacked ))
            then
                cd "$work_dir/src/$pkg-$VERSION"
            else
                cd "$work_dir/src"
            fi
            lockdown CHECK
            cd "$root"
            (
                call setresuid 0 0 0
                call setresgid 0 0 0
                call umount2 "string:$work_dir/src" "int:$MNT_DETACH"
                rm -rf "$work_dir"/{src,installed,test-results,test-work}
            )
            rm -f "$phase_log"
            log ""
            exit 0
        fi

        prepare_exec() {
            (
                call setresuid 0 0 0
                call setresgid 0 0 0
                rm -rf "$work_dir"/{src,installed,test-results,test-work}
            )
            mkdir -p "$work_dir/src" "$work_dir/installed"

            # Permanently drop saved-uid/saved-gid 0 before network fetches and tar extraction
            # (supplementary groups were already cleared at the start of build_single_pkg).
            (
                call setresgid "$SUDO_GID" "$SUDO_GID" "$SUDO_GID"
                call setresuid "$SUDO_UID" "$SUDO_UID" "$SUDO_UID"

                for ((i=0; i<${#ARCHIVES[@]}; i+=2))
                do
                    sha256="${ARCHIVES[i]}"
                    url="${ARCHIVES[i+1]}"
                    if is_git_url "$url"
                    then
                        validate_pkg_name "${archives[i/2]}"
                        fetch_git "$sha256" "$url"
                        continue
                    fi
                    filename="${url##*/}"
                    validate_pkg_name "$filename"
                    cached_file="$work_dir/archives/$filename"

                    if ! check_sha256 "$cached_file" "$sha256"
                    then
                        local tmp_dl="$cached_file.part.$$"
                        rm -f "$tmp_dl"
                        [[ "$url" == file://* && "$url" != file:///* ]] && url="file://$PWD/sw/${url#file://}"
                        curl --fail --silent --show-error --location --proto '=https,http,file' --output "$tmp_dl" -- "$url"
                        verify_sha256 "$tmp_dl" "$sha256" "$filename"
                        mv -f "$tmp_dl" "$cached_file"
                    else
                        verify_sha256 "$cached_file" "$sha256" "$filename"
                    fi
                done

                # ARCHIVES[0], if a tarball or a git repository, becomes the
                # source directory the recipe runs in, named
                # <recipe>-<version> whatever the file is called (a GitHub
                # branch archive is named after the branch's last part, such
                # as v1.5.7.tar.gz).  A tarball's single top-level directory
                # is stripped, whatever it is called (a branch archive's is
                # <repo>-<branch>).  Everything else is placed beside it,
                # never unpacked: the recipe uses it as ../<file>, and a git
                # repository as ../<repo>.tar holding <repo>/.  A git
                # repository comes with its submodules.  git archive
                # gives every file the commit's time, so make sees no
                # generated file as stale.
                cd "$work_dir/src"
                for idx in "${!archives[@]}"
                do
                    archive="${archives[idx]}"
                    if is_git_url "${ARCHIVES[2*idx+1]}"
                    then
                        if (( idx == 0 ))
                        then
                            mkdir "$pkg-$VERSION"
                            extract_git "${ARCHIVES[2*idx+1]%%#*}" "${ARCHIVES[2*idx]}" "$pkg-$VERSION"
                        else
                            tar_git "${ARCHIVES[2*idx+1]%%#*}" "${ARCHIVES[2*idx]}" "$archive" "${archive%.tar}"
                        fi
                    elif (( idx == 0 )) && [[ "$archive" == *.tar.* ]]
                    then
                        mkdir "$pkg-$VERSION"
                        tar --no-same-owner --no-same-permissions --strip-components=1 -C "$pkg-$VERSION" -xf "$work_dir/archives/$archive"
                    else
                        cp -- "$work_dir/archives/$archive" .
                    fi
                done
            )
        }
        run_phase PREPARE prepare_exec

        if (( src_unpacked ))
        then
            cd "$work_dir/src/$pkg-$VERSION"
        else
            cd "$work_dir/src"
        fi

        squashfs_file="/sw/$pkg-$VERSION.squashfs"

        lockdown MAKE
        # `build --defer-check` (CI): CHECK runs in its own step, `swctl
        # check`, on a snapshot of the tree as MAKE left it, taken before
        # INSTALL, which can touch it: all of $work_dir/src, so CHECK sees
        # ARCHIVES[1..N] beside the source directory too.  Not -all-root:
        # CHECK runs as the build user and writes through its overlay.
        # Without SOURCE_DATE_EPOCH, to which mksquashfs would clamp every
        # file's time: the tree keeps its times, to the second.
        if test "$ci_mode" != defer
        then
            lockdown CHECK
        elif test "$(type -t CHECK)" == function
        then
            tree_exec() {
                SQUASHFS() {
                    unset SOURCE_DATE_EPOCH
                    rm -f "$tree_file"
                    mksquashfs "$work_dir/src" "$tree_file" -noappend -comp zstd -quiet -no-progress
                }
                lockdown_exec SQUASHFS
            }
            run_phase TREE tree_exec
        fi
        lockdown INSTALL

        package_exec() {
            cd "$root"
            lockdown_exec SQUASHFS
            (
                call setresuid 0 0 0
                call setresgid 0 0 0
                reload_fstab
                register_entry "$squashfs_file"
                save_fstab
                rm -rf "$work_dir"/{src,installed,test-results,test-work}
            )
            rm -f "$phase_log"
        }

        run_phase PACKAGE package_exec
        log ""
    )
}

format_recipe_mime() {
    local pkg="$1"
    local boundary="===============fluffy-build-recipe-boundary==============="

    printf 'MIME-Version: 1.0\r\n'
    printf 'Content-Type: multipart/mixed; boundary="%s"\r\n' "$boundary"
    printf '\r\n'

    # Part 1: Main recipe
    printf -- '--%s\r\n' "$boundary"
    printf 'Content-Type: text/x-shellscript; charset="utf-8"\r\n'
    printf 'Content-Disposition: inline; filename="sw/%s"\r\n' "$pkg"
    printf '\r\n'
    cat "sw/$pkg"
    printf '\r\n'

    # Part 2: Sourced includes (if any)
    if test -n "${pkg_includes[$pkg]:-}"
    then
        local -a raw_incs=()
        local inc
        read -ra raw_incs <<< "${pkg_includes[$pkg]}"
        while IFS= read -r inc
        do
            if test -n "$inc" && test -f "$inc"
            then
                printf -- '--%s\r\n' "$boundary"
                printf 'Content-Type: text/x-shellscript; charset="utf-8"\r\n'
                printf 'Content-Disposition: inline; filename="%s"\r\n' "$inc"
                printf '\r\n'
                cat "$inc"
                printf '\r\n'
            fi
        done < <(printf '%s\n' "${raw_incs[@]}" | LC_ALL=C sort -u)
    fi

    # Part 3: Direct build image manifest
    printf -- '--%s\r\n' "$boundary"
    printf 'Content-Type: text/plain; charset="utf-8"\r\n'
    printf 'Content-Disposition: inline; filename="manifest"\r\n'
    printf '\r\n'
    if test -n "${pkg_bneeds[$pkg]:-}"
    then
        local -a bdeps=()
        local dep
        read -ra bdeps <<< "${pkg_bneeds[$pkg]}"
        for dep in "${bdeps[@]}"
        do
            if test -z "${pkg_img_chk[$dep]:-}"
            then
                fatal "missing image checksum for build dependency: $dep (required by $pkg)"
            fi
            printf '%s:%s\r\n' "$dep" "${pkg_img_chk[$dep]}"
        done | LC_ALL=C sort -u
    fi
    printf -- '--%s--\r\n' "$boundary"
}

plan_pkgs() {
    local plan_mode="$1" tmp_plan
    shift
    tmp_plan="$(mktemp)"
    if ! (
        declare -a order=() root_nodes=()
        declare -A pkg_loaded=() pkg_ver=() pkg_needs=() pkg_bneeds=() pkg_includes=() pkg_has_check=()

        load_pkg_meta() {
            local pkg_name="$1"
            validate_pkg_name "$pkg_name"
            local recipe_file="sw/$pkg_name"

            if test -n "${pkg_loaded[$pkg_name]:-}"
            then
                return 0
            fi

            if test ! -f "$recipe_file"
            then
                fatal "recipe file not found: $recipe_file"
            fi

            if test -v CROSS
            then
                ON=cross-build
            else
                ON=fluffy-build
            fi
            VERSION=""
            ARCHIVES=()
            NEEDS=()
            BUILD_NEEDS=()
            current_eval_pkg="$pkg_name"
            # shellcheck disable=SC1090
            source "$recipe_file"
            unset current_eval_pkg
            local has_check=""
            if test "$(type -t CHECK)" == function
            then
                has_check=1
            fi
            unset -f MAKE CHECK INSTALL

            local need_pkg
            for need_pkg in "${NEEDS[@]}"
            do
                need_pkg="${need_pkg##*/}"
                validate_pkg_name "$need_pkg"
                if test ! -f "sw/$need_pkg"
                then
                    fatal "recipe file not found: sw/$need_pkg (in NEEDS of $pkg_name)"
                fi
            done

            local bneed_pkg
            for bneed_pkg in "${BUILD_NEEDS[@]}"
            do
                bneed_pkg="${bneed_pkg##*/}"
                validate_pkg_name "$bneed_pkg"
                if test ! -f "sw/$bneed_pkg"
                then
                    fatal "recipe file not found: sw/$bneed_pkg (in BUILD_NEEDS of $pkg_name)"
                fi
            done

            pkg_loaded["$pkg_name"]=1
            pkg_ver["$pkg_name"]="$VERSION"
            pkg_needs["$pkg_name"]="${NEEDS[*]}"
            pkg_has_check["$pkg_name"]="$has_check"

            local -a direct_bneeds=()
            if test "$ON" != host-build && test "$ON" != "$pkg_name"
            then
                validate_pkg_name "$ON"
                direct_bneeds+=("$ON")
            fi
            direct_bneeds+=("${BUILD_NEEDS[@]}")
            pkg_bneeds["$pkg_name"]="${direct_bneeds[*]}"

            unset ON VERSION ARCHIVES NEEDS BUILD_NEEDS
        }

        build_step() {
            local mode="${1%%:*}" pkg_name="${1#*:}" dep
            local -a deps_arr=()
            load_pkg_meta "$pkg_name"

            case "$mode" in
                build)
                    if test -n "${pkg_bneeds[$pkg_name]:-}"
                    then
                        read -ra deps_arr <<< "${pkg_bneeds[$pkg_name]}"
                        for dep in "${deps_arr[@]}"
                        do
                            step_deps+=("run:${dep##*/}")
                        done
                    fi
                    ;;
                run)
                    step_deps+=("build:$pkg_name")
                    if test -n "${pkg_needs[$pkg_name]:-}"
                    then
                        read -ra deps_arr <<< "${pkg_needs[$pkg_name]}"
                        for dep in "${deps_arr[@]}"
                        do
                            step_deps+=("run:${dep##*/}")
                        done
                    fi
                    ;;
                *)
                    fatal "unknown plan mode: $mode"
                    ;;
            esac
        }

        local arg
        for arg in "$@"
        do
            root_nodes+=("$plan_mode:${arg##*/}")
        done

        dfs build_step "${root_nodes[@]}"

        local node pkg
        for node in "${order[@]}"
        do
            if [[ "$node" != build:* ]]
            then
                continue
            fi
            pkg="${node#build:}"
            printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$pkg" "${pkg_ver[$pkg]}" "${pkg_bneeds[$pkg]:-}" "${pkg_includes[$pkg]:-}" "${pkg_needs[$pkg]:-}" "${pkg_has_check[$pkg]:-}"
        done
    ) > "$tmp_plan"
    then
        rm -f "$tmp_plan"
        exit 1
    fi

    order=()
    pkg_ver=()
    pkg_bneeds=()
    pkg_img_chk=()
    pkg_includes=()
    pkg_needs=()
    pkg_has_check=()
    local p v b inc n c
    while IFS=$'\x1f' read -r p v b inc n c
    do
        order+=("$p")
        pkg_ver["$p"]="$v"
        pkg_bneeds["$p"]="$b"
        pkg_includes["$p"]="$inc"
        pkg_needs["$p"]="$n"
        pkg_has_check["$p"]="$c"
    done < "$tmp_plan"
    rm -f "$tmp_plan"
}

# The binary cache: an OCI registry package (GitHub's container registry,
# ghcr.io/fluffy-linux/sw) holding each recipe's image under the tag
# <pkg>.<recipe-checksum>.  The tag's manifest has one layer, the squashfs,
# whose digest is the image checksum, so nothing else is published: the
# fstab line's source, target, NEEDS and recipe checksum all come from the
# recipe.
#
# FLUFFY_CACHE_REGISTRY (e.g. ghcr.io/fluffy-linux/sw) turns it on: swctl
# fetches the image of any recipe the registry has instead of building it,
# with plain curl, anonymously (a public package) unless
# FLUFFY_CACHE_TOKEN_FILE names a file holding a token.  With that token
# file swctl also publishes what it builds, with oras (CI only).  Local
# builds without these variables never touch it.  A miss (the registry has
# no such tag) just means building; any other cache failure (network,
# HTTP error, token, a manifest without a layer, an image that doesn't
# match its digest, a failed publish) is fatal.
cache_enabled() {
    test -n "${FLUFFY_CACHE_REGISTRY:-}"
}

cache_publishing() {
    cache_enabled && test -n "${FLUFFY_CACHE_TOKEN_FILE:-}" && test -r "$FLUFFY_CACHE_TOKEN_FILE"
}

# A tag is <pkg>.<recipe-checksum>, with a suffix for CI's other tags:
# .b<build-id> (an image not yet vetted) and .tree (deferred checks).
cache_tag() {
    printf '%s.%s%s' "${1//+/_}" "$2" "${3:+.$3}"
}

cache_bearer=""
cache_auth() {
    test -z "$cache_bearer" || return 0
    local host="${FLUFFY_CACHE_REGISTRY%%/*}" repo="${FLUFFY_CACHE_REGISTRY#*/}" json
    # With a token, curl reads the credentials as a config on stdin, so the
    # token never appears in a command line.
    local auth=""
    if cache_publishing
    then
        auth="user = \"fluffy:$(< "$FLUFFY_CACHE_TOKEN_FILE")\""
    fi
    json="$(printf '%s\n' "$auth" | curl -fsS --retry 3 -K - \
        "https://$host/token?scope=repository:$repo:pull&service=$host")" || return 1
    [[ "$json" =~ \"token\":\"([^\"]+)\" ]] || return 1
    cache_bearer="${BASH_REMATCH[1]}"
}

# cache_image_digest TAG DIGEST_VAR: 0 with the checksum of the tag's
# single layer when the registry has the tag, 1 when it doesn't, 2 on
# failure.
#
# In CI steps, tags found are remembered for the agent's life (a CI agent
# runs one step after another, each resolving much the same plan; each
# lookup is a request): a vetted tag, or this build's, always names the
# same image here, and every image fetched is checked against its digest
# anyway.  A tag not found is never remembered: it may appear later.
cache_seen=/sw/.build/cache-seen
cache_image_digest() {
    local tag="$1" host="${FLUFFY_CACHE_REGISTRY%%/*}" repo="${FLUFFY_CACHE_REGISTRY#*/}" body code seen
    local -n __digest_out="$2"
    if test -n "${ci_mode:-}" && test -f "$cache_seen"
    then
        seen="$(awk -v t="$tag" '$1 == t { print $2; exit }' "$cache_seen")"
        if [[ "$seen" =~ ^[0-9a-f]{64}$ ]]
        then
            __digest_out="$seen"
            return 0
        fi
    fi
    cache_auth || { log "cache: no registry token"; return 2; }
    body="$(mktemp)"
    code="$(curl -sS --retry 3 -o "$body" -w '%{http_code}' \
        -H "Authorization: Bearer $cache_bearer" \
        -H "Accept: application/vnd.oci.image.manifest.v1+json" \
        "https://$host/v2/$repo/manifests/$tag")" || code=000
    local manifest
    manifest="$(< "$body")"
    rm -f "$body"
    case "$code" in
        200) ;;
        404) return 1 ;;
        *) log "cache: GET manifest $tag: HTTP $code"; return 2 ;;
    esac
    manifest="${manifest#*\"layers\"}"
    [[ "$manifest" =~ \"digest\":\"sha256:([0-9a-f]{64})\" ]] || { log "cache: $tag has no layer"; return 2; }
    __digest_out="${BASH_REMATCH[1]}"
    if test -n "${ci_mode:-}"
    then
        printf '%s %s\n' "$tag" "$__digest_out" >> "$cache_seen" || true
    fi
}

# The build scope (CI only): set by `build --defer-check` and `check`, the
# commands of the steps `swctl buildkite` generates when they publish.  An
# image that still has to pass its checks, or whose dependencies do, is
# published as <pkg>.<recipe-checksum>.b<BUILDKITE_BUILD_ID>, which only
# steps of the same Buildkite build look up; its check step promotes it to
# the vetted <pkg>.<recipe-checksum>, the only tag anyone else (other
# builds, local builds) asks for.
cache_build="" ci_mode=""
cache_build_scope() {
    cache_publishing || fatal "$1 is for CI steps: it needs FLUFFY_CACHE_REGISTRY and a readable FLUFFY_CACHE_TOKEN_FILE"
    [[ "${BUILDKITE_BUILD_ID:-}" =~ ^[a-zA-Z0-9-]+$ ]] || fatal "$1 is for CI steps: it needs BUILDKITE_BUILD_ID"
    cache_build="b$BUILDKITE_BUILD_ID"
}

# cache_lookup PKG RECIPE_CHECKSUM DIGEST_VAR TAG_VAR: as
# cache_image_digest, for the vetted tag and then, in the build scope,
# this build's tag; TAG_VAR names the tag found.
cache_lookup() {
    local __lk_tag_name __lk_rc=0
    local -n __lk_tag_out="$4"
    __lk_tag_name="$(cache_tag "$1" "$2")"
    cache_image_digest "$__lk_tag_name" "$3" || __lk_rc=$?
    if (( __lk_rc == 1 )) && test -n "$cache_build"
    then
        __lk_rc=0
        __lk_tag_name="$(cache_tag "$1" "$2" "$cache_build")"
        cache_image_digest "$__lk_tag_name" "$3" || __lk_rc=$?
    fi
    if (( __lk_rc == 0 ))
    then
        __lk_tag_out="$__lk_tag_name"
    fi
    return "$__lk_rc"
}

# cache_blob DIGEST FILE NAME: download the blob DIGEST, NAME in messages,
# as FILE, unless FILE already holds it.
cache_blob() {
    local digest="$1" file="$2" name="$3" host="${FLUFFY_CACHE_REGISTRY%%/*}" repo="${FLUFFY_CACHE_REGISTRY#*/}" code
    check_sha256 "$file" "$digest" && return 0
    cache_auth || fatal "cache: no registry token"
    code="$(curl -sS -L --retry 3 -o "$file.new" -w '%{http_code}' \
        -H "Authorization: Bearer $cache_bearer" \
        "https://$host/v2/$repo/blobs/sha256:$digest")" || code=000
    if test "$code" != 200 || ! check_sha256 "$file.new" "$digest"
    then
        rm -f "$file.new"
        fatal "cache: could not fetch a good $name from $FLUFFY_CACHE_REGISTRY (HTTP $code)"
    fi
    mv -f "$file.new" "$file"
}

# cache_restore PKG RECIPE_CHECKSUM: register the image a CI build of
# exactly this recipe produced, downloading it unless it is already here.
cache_restore() {
    local pkg="$1" recipe_chk="$2" img_chk="" tag="" rc=0
    cache_lookup "$pkg" "$recipe_chk" img_chk tag || rc=$?
    case "$rc" in
        0) ;;
        1) return 1 ;;
        *) fatal "cache: could not look up $(cache_tag "$pkg" "$recipe_chk") in $FLUFFY_CACHE_REGISTRY" ;;
    esac
    cache_fetch "$pkg" "$recipe_chk" "$img_chk"
}

# cache_fetch PKG RECIPE_CHECKSUM IMAGE_CHECKSUM: register the image
# IMAGE_CHECKSUM as PKG's, downloading it unless it is already here.
cache_fetch() {
    local pkg="$1" recipe_chk="$2" img_chk="$3"
    local src="/sw/$pkg-${pkg_ver[$pkg]}.squashfs" tgt="/sw/${pkg%-pass*}"
    cache_blob "$img_chk" "$src" "image for $pkg"

    # The fstab line exactly as register_entry writes it after a build.
    local needs="${pkg_needs[$pkg]:-}" options="X-fluffy.image-checksum=$img_chk"
    if test -n "$needs"
    then
        options="$options,X-fluffy.needs=\"${needs// /,}\""
    fi
    options="$options,X-fluffy.recipe-checksum=$recipe_chk"

    local mnt_fs="$NULL" old_src=""
    reload_fstab
    find_fs_by_pkg "$pkg" mnt_fs 1
    if test "$mnt_fs" == "$NULL"
    then
        call_ptr mnt_fs mnt_new_fs
        call mnt_table_add_fs "$mnt_table" "$mnt_fs"
        dlcall mnt_unref_fs "$mnt_fs"
    else
        fs_str "$mnt_fs" source old_src
    fi
    call mnt_fs_set_source "$mnt_fs" "string:$src"
    call mnt_fs_set_target "$mnt_fs" "string:$tgt"
    call mnt_fs_set_fstype "$mnt_fs" "string:squashfs"
    call mnt_fs_set_options "$mnt_fs" "string:$options"
    save_fstab
    if test -n "$old_src" && test "$old_src" != "$src"
    then
        rm -f "$old_src"
    fi
}

# cache_push FILE TAG ARTIFACT_TYPE: push FILE as the tag's single layer.
cache_push() {
    (
        cd "${1%/*}"
        oras push --no-tty --password-stdin -u fluffy \
            --artifact-type "$3" \
            "$FLUFFY_CACHE_REGISTRY:$2" \
            "${1##*/}:application/vnd.fluffy.squashfs" \
            < "$FLUFFY_CACHE_TOKEN_FILE" > /dev/null
    )
}

# cache_publish PKG RECIPE_CHECKSUM [SUFFIX]: after a build, push its image
# as the tag's single layer, unless the tag exists already (tags can be
# moved; Fluffy never moves one).
cache_publish() {
    local pkg="$1" recipe_chk="$2" fs="$NULL" src existing="" tag
    cache_publishing || return 0
    find_fs_by_pkg "$pkg" fs 1
    test "$fs" != "$NULL" || return 1
    fs_str "$fs" source src
    tag="$(cache_tag "$pkg" "$recipe_chk" "${3:-}")"
    local rc=0
    cache_image_digest "$tag" existing || rc=$?
    case "$rc" in
        0) return 0 ;;
        1) ;;
        *) return 1 ;;
    esac
    cache_push "$src" "$tag" application/vnd.fluffy.image.v1
}

# cache_promote PKG RECIPE_CHECKSUM: tag this build's image of the recipe
# as vetted: the same manifest under the vetted tag, nothing uploaded.
cache_promote() {
    local src dst existing="" rc=0
    src="$(cache_tag "$1" "$2" "$cache_build")"
    dst="$(cache_tag "$1" "$2")"
    cache_image_digest "$dst" existing || rc=$?
    case "$rc" in
        0) return 0 ;;
        1) ;;
        *) return 1 ;;
    esac
    oras tag --password-stdin -u fluffy "$FLUFFY_CACHE_REGISTRY:$src" "$dst" \
        < "$FLUFFY_CACHE_TOKEN_FILE" > /dev/null
}

build_pkgs() {
    local plan_mode=build
    case "${1:-}" in
        --run)
            plan_mode=run
            shift
            ;;
        --defer-check)
            ci_mode=defer
            shift
            ;;
    esac

    case "$ci_mode" in
        defer)
            test $# -eq 1 || fatal "Usage: $0 build --defer-check <package>"
            ;;
        check)
            test $# -eq 1 || fatal "Usage: $0 check <package>"
            ;;
        *)
            test $# -ge 1 || fatal "Usage: $0 build <package...>"
            ;;
    esac

    if test -z "${SUDO_UID:-}" || test -z "${SUDO_GID:-}"
    then
        fatal "must be run via sudo"
    fi
    if test "$SUDO_UID" -eq 0 || test "$SUDO_GID" -eq 0
    then
        fatal "SUDO_UID and SUDO_GID must be unprivileged (non-zero)"
    fi

    # Low priority, so the host stays responsive: CPU nice 9, and the idle
    # I/O class (ioprio_set, IOPRIO_WHO_PROCESS, self, IDLE << 13).  Every
    # build process inherits both.  Not nice 19: glibc's posix/tst-nice needs
    # nice(10) to raise the value by 10, so 9 is the most it can start at.
    dlcall setpriority int:0 int:0 int:9
    dlcall syscall long:251 int:1 int:0 int:24576

    if test "${FLUFFY_BUILD_SINGLE:-0}" -eq 1
    then
        unset FLUFFY_BUILD_SINGLE
        build_single_pkg "$1"
        return 0
    fi

    if test -n "$ci_mode"
    then
        ci_step "$1"
        return 0
    fi

    local -a order=()
    local -A pkg_ver=() pkg_bneeds=() pkg_needs=() pkg_img_chk=() pkg_includes=() pkg_has_check=()
    bk_section PREPARE
    plan_pkgs "$plan_mode" "$@"

    local total="${#order[@]}" idx=0 pkg
    for pkg in "${order[@]}"
    do
        idx=$(( idx + 1 ))
        local sq="/sw/$pkg-${pkg_ver[$pkg]}.squashfs" fs="$NULL"
        dlcall -r pointer -n fs mnt_table_find_source "$mnt_table" "string:$sq" "int:$MNT_ITER_FORWARD"
        if test "$fs" == "$NULL"
        then
            find_fs_by_pkg "$pkg" fs 1
        fi

        local img_chk="" recorded_recipe_chk="" src=""
        if test "$fs" != "$NULL"
        then
            fs_str "$fs" source src
            get_fs_opt "$fs" "X-fluffy.image-checksum" img_chk || true
            get_fs_opt "$fs" "X-fluffy.recipe-checksum" recorded_recipe_chk || true
            pkg_img_chk["$pkg"]="$img_chk"
        fi

        local current_recipe_chk
        current_recipe_chk="$( format_recipe_mime "$pkg" | sha256sum )"
        current_recipe_chk="${current_recipe_chk%% *}"

        if test -n "$src" && test "$src" == "$sq" && test -s "$src" && test -n "$recorded_recipe_chk" && test "$recorded_recipe_chk" == "$current_recipe_chk"
        then
            log "$pkg [$idx/$total]: UP-TO-DATE"
            continue
        fi

        local cache_start=$SECONDS
        if cache_enabled && cache_restore "$pkg" "$current_recipe_chk"
        then
            log "$pkg [$idx/$total]: CACHED($(format_elapsed $(( SECONDS - cache_start ))))"
            reload_fstab
            fs="$NULL"
            find_fs_by_pkg "$pkg" fs 1
            get_fs_opt "$fs" "X-fluffy.image-checksum" img_chk || true
            pkg_img_chk["$pkg"]="$img_chk"
            continue
        fi

        export FLUFFY_PROGRESS="[$idx/$total]" FLUFFY_RECIPE_CHECKSUM="$current_recipe_chk"
        build_single_pkg "$pkg"
        reload_fstab
        if cache_enabled && (( bk_log ))
        then
            bk_section PUBLISH
        fi
        if cache_enabled && ! cache_publish "$pkg" "$current_recipe_chk"
        then
            fatal "cache: could not publish $pkg to $FLUFFY_CACHE_REGISTRY"
        fi

        fs="$NULL"
        dlcall -r pointer -n fs mnt_table_find_source "$mnt_table" "string:$sq" "int:$MNT_ITER_FORWARD"
        if test "$fs" == "$NULL"
        then
            find_fs_by_pkg "$pkg" fs 1
        fi
        if test "$fs" == "$NULL"
        then
            fatal "failed to locate registered fstab entry for $pkg after build"
        fi
        get_fs_opt "$fs" "X-fluffy.image-checksum" img_chk || true
        if test -z "$img_chk"
        then
            fatal "missing X-fluffy.image-checksum for $pkg after build"
        fi
        pkg_img_chk["$pkg"]="$img_chk"
    done
}

# reach_of PKG: set reach[] to what PKG's build mounts: each BUILD_NEEDS
# package (its ON target included) and, as install_targets mounts them, all
# that those NEEDS in turn.
reach_of() {
    local b
    local -a bs=()
    reach=()
    read -ra bs <<< "${pkg_bneeds[$1]:-}"
    for b in "${bs[@]}"
    do
        reach_run "$b"
    done
}

reach_run() {
    local p="${1##*/}" n
    local -a ns=()
    if test -n "${reach[$p]:-}"
    then
        return 0
    fi
    reach["$p"]=1
    read -ra ns <<< "${pkg_needs[$p]:-}"
    for n in "${ns[@]}"
    do
        reach_run "$n"
    done
}

# plan_check_steps: pkg_check_step[PKG] is 1 when PKG's image needs a check
# step before it is vetted: its recipe has a CHECK, or something its build
# mounts needs a check step itself (an image is vetted only once every image
# it was built against is).  Any other image is vetted as it is built.
plan_check_steps() {
    local pkg d
    for pkg in "${order[@]}"
    do
        pkg_check_step["$pkg"]="${pkg_has_check[$pkg]:-}"
        if test -n "${pkg_check_step[$pkg]}"
        then
            continue
        fi
        reach_of "$pkg"
        for d in "${!reach[@]}"
        do
            if test -n "${pkg_check_step[$d]:-}"
            then
                pkg_check_step["$pkg"]=1
                break
            fi
        done
    done
}

# ci_resolve TARGET: the recipe checksum of every package of the plan, in
# order, and the tag its image is under (vetted, else this build's; see
# cache_lookup), from the registry alone: nothing is downloaded.  Only
# TARGET may be missing: every other package's own step built it.
ci_resolve() {
    local target="$1" pkg chk __rs_digest __rs_tag rc
    for pkg in "${order[@]}"
    do
        chk="$(format_recipe_mime "$pkg" | sha256sum)"
        chk="${chk%% *}"
        pkg_recipe_chk["$pkg"]="$chk"
        __rs_digest="" __rs_tag="" rc=0
        cache_lookup "$pkg" "$chk" __rs_digest __rs_tag || rc=$?
        case "$rc" in
            0)
                pkg_img_chk["$pkg"]="$__rs_digest"
                pkg_tag["$pkg"]="$__rs_tag"
                ;;
            1)
                if test "$pkg" != "$target"
                then
                    fatal "cache: $pkg ($(cache_tag "$pkg" "$chk")) is neither vetted nor built by this build: its own step builds it"
                fi
                pkg_tag["$pkg"]=""
                ;;
            *)
                fatal "cache: could not look up $(cache_tag "$pkg" "$chk") in $FLUFFY_CACHE_REGISTRY"
                ;;
        esac
    done
}

# A step of a CI build with deferred checks (see buildkite_pipeline), for
# one package, its dependencies coming from the cache: its own steps
# published them.
#
# `build --defer-check PKG`: unless the cache has PKG's image already
# (vetted, or from this build: a retried step), build it with CHECK
# deferred: after MAKE, the tree is saved as a squashfs and published as
# <pkg>.<recipe-checksum>.tree, before the image.  The image is published
# under this build's tag if it needs a check step (plan_check_steps), else
# as vetted.
#
# `check PKG`: once PKG's image is vetted, nothing.  Otherwise this build
# must have built it, and every image its build mounted must be vetted;
# CHECK, if the recipe has one, runs on the published tree, and the image
# is promoted to vetted.  A retried check mounts the tree again; nothing is
# ever rebuilt.
ci_step() {
    local pkg="${1##*/}"
    validate_pkg_name "$pkg"
    bk_section PREPARE
    if test "$ci_mode" == defer
    then
        cache_build_scope "build --defer-check"
    else
        cache_build_scope check
    fi

    local -a order=()
    local -A pkg_ver=() pkg_bneeds=() pkg_needs=() pkg_img_chk=() pkg_includes=() pkg_has_check=()
    local -A pkg_recipe_chk=() pkg_tag=() pkg_check_step=() reach=()
    plan_pkgs build "$pkg"
    ci_resolve "$pkg"
    plan_check_steps

    local chk="${pkg_recipe_chk[$pkg]}" tag="${pkg_tag[$pkg]}" vetted tree tree_file=/sw/.build/tree.squashfs d
    vetted="$(cache_tag "$pkg" "$chk")"
    tree="$(cache_tag "$pkg" "$chk" tree)"
    reach_of "$pkg"

    if test "$ci_mode" == defer
    then
        if test -n "$tag"
        then
            pkg_log "CACHED($tag)"
            return 0
        fi
        for d in "${order[@]}"
        do
            if test -n "${reach[$d]:-}"
            then
                cache_fetch "$d" "${pkg_recipe_chk[$d]}" "${pkg_img_chk[$d]}"
            fi
        done
        rm -f "$tree_file"
        export FLUFFY_RECIPE_CHECKSUM="$chk"
        build_single_pkg "$pkg"
        reload_fstab
        bk_section PUBLISH
        if test -f "$tree_file"
        then
            local existing="" rc=0
            cache_image_digest "$tree" existing || rc=$?
            case "$rc" in
                0)
                    pkg_log "$tree is published already"
                    ;;
                1)
                    cache_push "$tree_file" "$tree" application/vnd.fluffy.tree.v1 || fatal "cache: could not publish $tree"
                    pkg_log "published $tree"
                    ;;
                *)
                    fatal "cache: could not look up $tree in $FLUFFY_CACHE_REGISTRY"
                    ;;
            esac
            rm -f "$tree_file"
        fi
        tag="$vetted"
        if test -n "${pkg_check_step[$pkg]}"
        then
            tag="$(cache_tag "$pkg" "$chk" "$cache_build")"
            cache_publish "$pkg" "$chk" "$cache_build" || fatal "cache: could not publish $tag"
        else
            cache_publish "$pkg" "$chk" || fatal "cache: could not publish $tag"
        fi
        pkg_log "published $tag"
        return 0
    fi

    if test "$tag" == "$vetted"
    then
        pkg_log "VETTED($vetted)"
        return 0
    fi
    if test -z "$tag"
    then
        fatal "check $pkg: this build has no image of $vetted (build-$pkg publishes it)"
    fi
    for d in "${order[@]}"
    do
        if test -n "${reach[$d]:-}" && test "${pkg_tag[$d]}" != "$(cache_tag "$d" "${pkg_recipe_chk[$d]}")"
        then
            fatal "check $pkg: $d, which $pkg was built against, is not vetted"
        fi
    done

    if test -n "${pkg_has_check[$pkg]}"
    then
        local tree_chk="" rc=0
        cache_image_digest "$tree" tree_chk || rc=$?
        case "$rc" in
            0) ;;
            1) fatal "check $pkg: the cache has no $tree" ;;
            *) fatal "cache: could not look up $tree in $FLUFFY_CACHE_REGISTRY" ;;
        esac
        cache_blob "$tree_chk" "$tree_file" "$tree"
        for d in "${order[@]}"
        do
            if test -n "${reach[$d]:-}"
            then
                cache_fetch "$d" "${pkg_recipe_chk[$d]}" "${pkg_img_chk[$d]}"
            fi
        done
        build_single_pkg "$pkg"
        rm -f "$tree_file"
    fi
    bk_section PUBLISH
    cache_promote "$pkg" "$chk" || fatal "cache: could not promote $tag to $vetted"
    pkg_log "VETTED($vetted)"
}

# Print the build of the given packages as a Buildkite pipeline, to be fed to
# `buildkite-agent pipeline upload`: one step per package, in plan order,
# running `swctl build <pkg>` with this run's FLUFFY and CROSS.  A step
# depends on the steps of everything its build mounts (reach_of).  Every
# step's dependencies are then already built, so its `swctl build` finds
# them up to date and builds only its own package.  Without the binary
# cache, the steps share one machine's /sw and fstab, so they run one at a
# time (a concurrency group per FLUFFY root).  A step whose agent is lost is
# retried.
#
# When steps publish to the cache (CI), each step's agent restores what it
# needs from it, published by the steps it depends on, so steps run in
# parallel on as many agents as there are, and checks are deferred (see
# ci_step): build-<pkg> runs `swctl build --defer-check <pkg>` and depends
# on the build steps of what its build mounts, so builds never wait for
# tests; check-<pkg>, for each package whose image needs a check step
# (plan_check_steps), runs `swctl check <pkg>` and depends on build-<pkg>
# and on the check steps of what its build mounts, so an image is vetted
# only after the images it was built against.  world-check depends on
# every check step: what must wait for a vetted world (the pipeline's
# final steps) waits for it.
buildkite_pipeline() {
    if test $# -lt 1
    then
        fatal "Usage: $0 buildkite <package...>"
    fi

    local -a order=()
    local -A pkg_ver=() pkg_bneeds=() pkg_needs=() pkg_img_chk=() pkg_includes=() pkg_has_check=()
    local -A pkg_check_step=() reach=()
    plan_pkgs build "$@"

    # Buildkite interpolates $ in commands; YAML single quotes double '.
    yaml_str() {
        local s="${1//\$/\$\$}"
        printf "'%s'" "${s//\'/\'\'}"
    }
    step_key() {
        printf '%s' "${1//[^a-zA-Z0-9_-]/_}"
    }

    local env_prefix="" group="fluffy:${FLUFFY:-/}"
    if test -n "${FLUFFY:-}"
    then
        env_prefix+=" FLUFFY=$(printf '%q' "$FLUFFY")"
    fi
    if test -v CROSS
    then
        env_prefix+=" CROSS=$(printf '%q' "$CROSS")"
    fi
    # The agent's own variables that sudo would drop, kept with
    # --preserve-env (passed only when set): BUILDKITE, so swctl and
    # bootstrap.sh log in Buildkite's sections, and the binary cache's
    # settings, when the agent's environment names a cache (CI's do).
    local keep="BUILDKITE" cache_keep=",FLUFFY_CACHE_REGISTRY,FLUFFY_CACHE_TOKEN_FILE"

    # In parallel, a step can land on a fresh agent: bootstrap its root
    # first (bootstrap.sh does only what is not done yet).
    local ci="" boot=""
    if cache_publishing
    then
        ci=1
        boot="sudo --preserve-env=$keep$env_prefix ./bootstrap.sh && "
        cache_keep+=",BUILDKITE_BUILD_ID"
        plan_check_steps
    fi

    # bk_step LABEL KEY COMMAND [DEPENDENCY_KEY...]
    bk_step() {
        local label="$1" key="$2" command="$3" dep
        shift 3
        echo "  - label: $(yaml_str "$label")"
        echo "    key: $(yaml_str "$(step_key "$key")")"
        echo "    command: $(yaml_str "$command")"
        echo "    timeout_in_minutes: 720"
        if test -z "$ci"
        then
            echo "    concurrency: 1"
            echo "    concurrency_group: $(yaml_str "$group")"
        fi
        echo "    retry:"
        echo "      automatic:"
        echo "        - exit_status: -1"
        echo "          limit: 2"
        if (( $# > 0 ))
        then
            echo "    depends_on:"
            for dep
            do
                echo "      - $(yaml_str "$(step_key "$dep")")"
            done
        fi
    }

    echo "steps:"
    local pkg dep swctl
    local -a builds=() checks=() all_checks=()
    for pkg in "${order[@]}"
    do
        reach_of "$pkg"
        swctl="sudo --preserve-env=$keep$cache_keep$env_prefix ./swctl"
        if test -z "$ci"
        then
            builds=()
            for dep in "${order[@]}"
            do
                if test -n "${reach[$dep]:-}"
                then
                    builds+=("$dep")
                fi
            done
            bk_step "$pkg" "$pkg" "$swctl build $(printf '%q' "$pkg")" "${builds[@]}"
            continue
        fi

        builds=() checks=("build-$pkg")
        for dep in "${order[@]}"
        do
            if test -n "${reach[$dep]:-}"
            then
                builds+=("build-$dep")
                if test -n "${pkg_check_step[$dep]}"
                then
                    checks+=("check-$dep")
                fi
            fi
        done
        bk_step "build-$pkg" "build-$pkg" "$boot$swctl build --defer-check $(printf '%q' "$pkg")" "${builds[@]}"
        if test -n "${pkg_check_step[$pkg]}"
        then
            bk_step "check-$pkg" "check-$pkg" "$boot$swctl check $(printf '%q' "$pkg")" "${checks[@]}"
            all_checks+=("check-$pkg")
        fi
    done
    if test -n "$ci"
    then
        bk_step world-check world-check true "${all_checks[@]}"
    fi
}

refresh_recipe_checksums() {
    if test -z "${SUDO_UID:-}" || test -z "${SUDO_GID:-}"
    then
        fatal "must be run via sudo"
    fi

    local -a target_pkgs=("$@")
    if (( ${#target_pkgs[@]} == 0 ))
    then
        call_ptr itr mnt_new_iter "int:$MNT_ITER_FORWARD"
        call_ptr p_fs malloc "ulong:8"
        local val=(pointer:0)
        pack "$p_fs" val

        while true
        do
            dlcall -r int -n ret mnt_table_next_fs "$mnt_table" "$itr" "$p_fs"
            if test "$ret" != "int:0"
            then
                break
            fi
            unpack "$p_fs" val
            local curr_fs="${val[0]}" src
            fs_str "$curr_fs" source src
            local filename="${src##*/}"
            filename="${filename%.squashfs}"
            filename="${filename%-fluffy+([0-9])}"
            local pkg_name="${filename%-[0-9]*}"
            if test -f "sw/$pkg_name" && src_matches_pkg "$src" "$pkg_name"
            then
                target_pkgs+=("$pkg_name")
            fi
        done

        dlcall free "$p_fs"
        dlcall mnt_free_iter "$itr"
    fi

    if (( ${#target_pkgs[@]} == 0 ))
    then
        log "no packages found in $FSTAB to refresh"
        return 0
    fi

    local -a order=()
    local -A pkg_ver=() pkg_bneeds=() pkg_needs=() pkg_img_chk=() pkg_includes=() pkg_has_check=()
    plan_pkgs build "${target_pkgs[@]}"

    local total="${#order[@]}" idx=0 pkg
    for pkg in "${order[@]}"
    do
        idx=$(( idx + 1 ))
        local sq="/sw/$pkg-${pkg_ver[$pkg]}.squashfs" fs="$NULL"
        dlcall -r pointer -n fs mnt_table_find_source "$mnt_table" "string:$sq" "int:$MNT_ITER_FORWARD"
        if test "$fs" == "$NULL"
        then
            find_fs_by_pkg "$pkg" fs 1
        fi

        local img_chk="" recorded_recipe_chk="" needs_str=""
        if test "$fs" != "$NULL"
        then
            get_fs_opt "$fs" "X-fluffy.image-checksum" img_chk || true
            get_fs_opt "$fs" "X-fluffy.recipe-checksum" recorded_recipe_chk || true
            get_fs_opt "$fs" "X-fluffy.needs" needs_str || true
            pkg_img_chk["$pkg"]="$img_chk"
        fi

        local current_recipe_chk
        current_recipe_chk="$( format_recipe_mime "$pkg" | sha256sum )"
        current_recipe_chk="${current_recipe_chk%% *}"

        if test "$fs" != "$NULL"
        then
            local options="X-fluffy.image-checksum=$img_chk"
            if test -n "$needs_str"
            then
                options="$options,X-fluffy.needs=\"$needs_str\""
            fi
            options="$options,X-fluffy.recipe-checksum=$current_recipe_chk"
            call mnt_fs_set_options "$fs" "string:$options"
            log "$pkg [$idx/$total]: refreshed recipe checksum ($current_recipe_chk)"
        fi
    done

    save_fstab
    log "successfully saved $FSTAB"
}

case "$1" in
build)
    shift
    build_pkgs "$@"
    ;;
check)
    shift
    ci_mode=check
    build_pkgs "$@"
    ;;
refresh-checksums)
    shift
    refresh_recipe_checksums "$@"
    ;;
buildkite)
    shift
    buildkite_pipeline "$@"
    ;;
install)
    shift
    install_targets "$@"
    ;;
run)
    shift
    if test $# -lt 2
    then
        fatal "Usage: $0 run <package> <command> [args...]"
    fi
    target="${1##*/}"
    validate_pkg_name "$target"
    shift
    (
        build_pkgs --run bash "$target"
    ) < /dev/null
    reload_fstab
    if test -n "${FLUFFY:-}"
    then
        root="$PWD"
        mkdir -p "$FLUFFY"/{dev/pts,proc,sys,run,dev/shm,etc,tmp,var/tmp,"$root"}
        call mount /dev "$FLUFFY/dev" $NULL $MS_BIND $NULL
        call mount /dev/pts "$FLUFFY/dev/pts" $NULL $MS_BIND $NULL
        call mount proc "$FLUFFY/proc" proc 0 $NULL
        call mount sysfs "$FLUFFY/sys" sysfs 0 $NULL
        call mount tmpfs "$FLUFFY/run" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=0755"
        call mount tmpfs "$FLUFFY/tmp" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
        call mount tmpfs "$FLUFFY/var/tmp" tmpfs $(( MS_NOSUID | MS_NODEV )) "mode=1777"
        mount_chroot_shm
        mount_chroot_resolv_conf
        call mount "$root" "$FLUFFY$root" $NULL $MS_BIND $NULL
        install_targets bash "$target"
        call mount /sw "$FLUFFY/sw" $NULL $(( MS_BIND | MS_REC )) $NULL
        call chroot "$FLUFFY"
        call chdir "$root"
        unset FLUFFY
        export PATH='/sw/*/bin'
        exec /sw/bash/bin/bash -c 'exec "$@"' bash "$@"
    else
        install_targets bash "$target"
        export PATH='/sw/*/bin'
        exec /sw/bash/bin/bash -c 'exec "$@"' bash "$@"
    fi
    ;;
*)
    fatal "unknown command: $1"
    ;;
esac
