#!/bin/bash
set -euo pipefail

dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT

tar -xf "$1" -C "$dir"
src="$(find "$dir" -mindepth 1 -maxdepth 1 -type d)"
cp -a "$src" "$src.orig"

find "$src" -type f -exec sed -E -i 's|/(usr/)?bin/(ba)?sh\b|/sw/bash/bin/bash|g' {} + 2>/dev/null || true
(cd "$src.orig" && find . -type f -exec touch -r {} "$src/{}" \;)

if [ $# -ge 2 ]; then
    (cd "$dir" && TZ=UTC0 LC_ALL=C diff -Naur "$(basename "$src").orig" "$(basename "$src")") > "$2" || true
else
    (cd "$dir" && TZ=UTC0 LC_ALL=C diff -Naur "$(basename "$src").orig" "$(basename "$src")") || true
fi
